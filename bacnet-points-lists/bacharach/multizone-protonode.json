{
 "manufacturer": "Bacharach",
 "manufacturer_slug": "bacharach",
 "model": "MultiZone gas monitor (ProtoNode BACnet Protocol Converter Kit)",
 "model_slug": "multizone-protonode",
 "aliases": [
  "Bacharach MZ",
  "MultiZone MZ",
  "3015-5609",
  "3015-5705",
  "Bacharach BACnet Protocol Converter Kit"
 ],
 "equipment_type": "Refrigerant leak monitor (gas sensor) via BACnet gateway",
 "applies_to": "Bacharach MultiZone (MZ) multi-point refrigerant gas monitors connected through the FieldServer ProtoNode BACnet converter kit.",
 "summary": "A FieldServer ProtoNode reads the MultiZone monitor over Modbus and serves its data as 66 BACnet objects: the active zone, a fault value, and for each of 16 zones the gas reading in ppm, the refrigerant type and an alarm value. Each zone's refrigerant type appears twice, as a read-only AI and a writable AV.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Objects are numbered 1-66 straight through: AI 1-2 are unit-wide, then four objects per zone (zone n starts at 4n-1).",
  "The refrigerant type of a zone is read from the AI and written to the AV with the next instance number.",
  "The manual gives no units column; ppm is implied by the object name.",
  "The kit manual only gives the ProtoNode IP settings; it does not cover BACnet MS/TP."
 ],
 "source": {
  "title": "BACnet Protocol Converter Kit for Use with Bacharach MultiZone Gas Monitors - Installation Manual",
  "doc_number": "3015-5609",
  "revision_date": "Revision 1, June 2012",
  "url": "https://assets.kele.com/Catalog/08%20Gas_Specialty_Sensors/PDFs/3015-5705%20Bacnet%20Manual.pdf",
  "unofficial": true,
  "host": "Kele"
 },
 "integration": {
  "summary": "Read the PPM and Alarm objects for each zone in use and the unit Fault value. The refrigerant type per zone is normally set once during commissioning.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "name": "Active Zone",
    "why": "Zone now being sampled"
   },
   {
    "ref": "AI 3",
    "name": "PPM [1]",
    "why": "Zone 1 refrigerant concentration, ppm"
   },
   {
    "ref": "AI 6",
    "name": "Alarm [1]",
    "why": "Zone 1 alarm status"
   },
   {
    "ref": "AI 2",
    "name": "Fault",
    "why": "Monitor fault"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "ProtoNode default IP address 192.168.1.24, subnet 255.255.255.0.",
   "Power the ProtoNode from 9-30 VDC or 12-24 VAC; wire its RS-485 port to the MZ Modbus bus as shown in the MZ manual."
  ],
  "gotchas": [
   "Write the refrigerant-type AVs only while configuring the monitor; the manual warns against frequent writes.",
   "Only the zones fitted on the monitor carry real readings."
  ]
 },
