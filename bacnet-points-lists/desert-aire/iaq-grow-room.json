 "model_slug": "iaq-grow-room",
 "aliases": [
  "Desert Aire GR",
  "IAQ-GR",
  "GR 3.0.4",
  "Grow Room program",
  "GrowAire"
 ],
 "equipment_type": "Grow room dehumidifier (air handler) controller",
 "applies_to": "Desert Aire grow-room dehumidification units running the IAQ Grow Room program, version GR 3.0.4 and later.",
 "summary": "The grow-room version of Desert Aire's IAQ program uses a lights-on/lights-off signal to switch between day and night temperature and RH setpoints. Over BACnet the BMS can set the lights state, write the four day/night setpoints, tune deadbands, limits and PID terms, and send its own zone temperature and RH. Readbacks cover up to four compressor circuits, EXV positions, water temperatures and a status and alarm code.",
 "bacnet_transport": [],
 "firmware": "GR 3.0.4 and later",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "BV 3 Alarm Active is inverted: 0 = alarm, 1 = normal; BV 17 Alarm Point is also an inverted alarm.",
  "The source lists Digital Input 7 as BV 28 between BV 17 and BV 19; BV 18 is missing, so 28 may be a typo for 18.",
  "BV 19 HPC On carries a copied reset comment in the source; its exact behaviour isn't documented.",
  "The list gives many analog values 'in tenths' (and some integers in thousandths); check whether your BMS reads 72.5 or 725 and scale if needed.",
  "The source lists instances 1001 and up as type \"INT\" and does not say which BACnet object type that is. They are shown here as AV, but Desert Aire does not confirm that; check the actual object type with a device discovery before mapping.",
  "The source does not say whether the unit uses BACnet IP or BACnet MS/TP."
 ],
