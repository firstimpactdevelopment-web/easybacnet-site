 ],
 "equipment_type": "Variable frequency drive (VFD)",
 "applies_to": "Cerus X-Drive variable frequency drives (Franklin Electric) using the built-in BACnet MS/TP port on COM1.",
 "summary": "The Cerus X-Drive has BACnet MS/TP built into its COM1 RS-485 port. The drive exposes only Analog and Binary Values: commandable AVs for the frequency reference and 16 block-transfer slots, read-only AVs for drive measurements and codes, commandable BVs for run, stop, direction and reset, and status BVs for faults, HOA position and pump modes such as pipe fill, sleep and broken pipe.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "[Comm-27] x 1000 + [Comm-26]",
 "access_inferred": false,
 "notes": [
  "The object numbering follows the Delta CP2000 BACnet map (delta-electronics/vfd-cp2000), but Franklin prints its own object names and uses objects the CP2000 leaves reserved or lacks: BV 20-21, BV 24-36 (pump faults, modes, HOA) and AV 70-71.",
  "Reserved objects (AV 0, AV 2-10, AV 27-30, AV 32-34, AV 36-38, AV 40, BV 2, BV 5, BV 8-14, BV 37-39) are left out.",
  "AV 11-26 are printed as one row (Block Transfer, mapping 1 to 16); their units depend on what each slot is mapped to.",
  "The status table prints BV 022 and BV 023 twice (Q-Stop Mode / Power OUT, then Broken Pipe / Pipe Leak); both pairs are kept as printed. Check with a scan.",
  "The commandable sections are marked RW and titled Commandable; they are listed as C."
 ],
 "source": {
  "title": "Cerus X-Drive Communications - BACnet Communication",
  "doc_number": null,
  "revision_date": null,
  "url": "https://fele.widen.net/content/nfq71r6s8h/pdf/BACnet_Communications.pdf?u=bt7ctv"
 },
 "integration": {
  "summary": "Set PLC Com Type to BACnet, the MAC, speed and device ID, then point the HOA source, speed references and run commands at RS485 Serial. Run with BV 7, give speed with AV 1 (with BV 0 set to use it), and read output frequency, current, faults and the HOA state.",
  "minimum_points": [
   {
    "ref": "BV 7",
    "name": "Power Out CMD",
    "why": "Run command (1 = run, 0 = coast stop)"
   },
   {
    "ref": "BV 0",
    "name": "Freq Active CMD",
    "why": "Must be 1 to use the AV 1 frequency reference"
   },
   {
    "ref": "AV 1",
    "name": "FreqRefValue",
    "why": "Frequency reference, Hz"
   },
   {
    "ref": "BV 15",
    "name": "Reset",
    "why": "Fault reset (write 1)"
   },
   {
    "ref": "AV 31",
    "name": "Output Frequency",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 44",
    "name": "Output Current",
    "why": "Motor current, A"
   },
   {
    "ref": "BV 33",
    "name": "HOA in Auto",
    "why": "HOA switch in Auto"
   },
   {
    "ref": "BV 19",
    "name": "Error/Fault",
    "why": "Any error/fault active"
   },
   {
    "ref": "AV 43",
    "name": "Error Code",
    "why": "Fault code"
   }
  ],
  "enable": "Set HOA Mode Source [SET-60] to RS485 Serial, Auto Speed Ref [SET-07] and Hand Speed Ref [SET-09] to RS485 Serial, and Auto/Hand Run Cmd [SET-08]/[SET-10] to RS485 Serial so BACnet can run the drive and set its speed.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "PLC Com Type [PLC-23] = 1_BACnet turns on BACnet on COM1 (8N1) and turns off Modbus and PLC comms on that port.",
   "BACnet MAC ID [Comm-24]: default 10, range 0-127. Speed [Comm-25]: 9600, 19200, 38400 (default) or 76800.",
   "Device instance = [Comm-27] x 1000 + [Comm-26] (0-4194303); Max Address [Comm-28] is the highest master on the trunk.",
   "Enter the BACnet password at [Comm-29]; the keypad shows 8888 when setup is accepted.",
   "COM1 is on terminals SG+/SG- or either RJ45 jack (pins 4 and 5)."
  ],
  "gotchas": [
   "BV 0 must be 1 or the drive runs at 0 Hz regardless of AV 1.",
   "BV 22/23 are printed twice with different meanings; confirm which object holds the pump fault flags before mapping them.",
   "Block transfer AVs (11-26) only carry data once mapped in the drive parameters."
  ]
 },
