 ],
 "equipment_type": "Laboratory room airflow and pressure controller",
 "applies_to": "Laboratory rooms with one supply and one general exhaust damper on slow-acting actuators plus hot water reheat, on the Siemens BACnet LCM-OAVS controller 570-801PA with offboard air modules 550-819B.",
 "summary": "Application 6753 controls a laboratory room with a supply damper and a general exhaust damper on slow-acting actuators, and hot water reheat, on a Siemens BACnet LCM-OAVS controller over BACnet MS/TP. Supply and general exhaust track each other (and the fume hood exhaust on AI 3) to hold a set airflow offset between exhaust and supply; the temperature loop raises supply airflow for cooling and opens the reheat valve for heating.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, cfm, fpm, ft²); the guide also lists SI factory defaults.",
  "VOL DIFFRNC = (HOOD VOL + GEX AIR VOL + OTHER EXH) - (SUP AIR VOL + OTHER SUP); it is positive in a negatively pressurized room.",
  "Application 6759 is the same arrangement with discharge air temperature control (BTU compensation); it is a separate entry.",
  "TRACK MODE (AO 28): 0 = always supply tracks exhaust (default), 1 = STE occupied / ETS unoccupied, 2 = ETS occupied / STE unoccupied, 3 = always exhaust tracks supply.",
  "VOLUME STATE (AO 76): 0 = always constant volume, 1 = VAV occupied / CV unoccupied (default), 2 = CV occupied / VAV unoccupied, 3 = always VAV.",
  "ALARM ENA (AO 17) adds 1 (vent alarm), 2 (alarm switch) and 4 (pressurization alarm) to pick what drives ALARM DO7; OCC ENA (AO 12) enables the room unit button and/or the DI 2 occupancy switch (0 = neither, the default)."
 ],
 "source": {
  "title": "BACnet LCM-OAVS Room Pressurization with Slow-acting Damper Actuation (One Exhaust, One Supply) and Hot Water Reheat, Application 6753, Application Note",
  "doc_number": "140-1334",
  "revision_date": "2015-07-07",
  "url": "https://sid.siemens.com/api/khub/documents/DiiRCw6Qp4kSjX0enf8~zw/content"
 },
 "integration": {
  "summary": "Address the controller on the BACnet MS/TP trunk (manually or with auto addressing) and calibrate the airflow devices. The BMS commands occupancy with NET OCC CMD (BO 29), can adjust the occupied and unoccupied airflow offsets, and reads supply, general exhaust and hood airflows, the airflow difference and the pressurization and ventilation alarms.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "NET OCC CMD",
    "why": "Occupancy command from the BMS (OCC/UNOCC)"
   },
   {
    "ref": "AO 5",
    "name": "OCC DIF STPT",
    "why": "Occupied exhaust-minus-supply offset, cfm"
   },
   {
    "ref": "BO 21",
    "name": "OCC.UNOCC",
    "why": "Resulting occupancy state"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AI 35",
    "name": "SUP AIR VOL",
    "why": "Measured supply airflow, cfm"
   },
   {
    "ref": "AI 30",
    "name": "GEX AIR VOL",
    "why": "Measured general exhaust airflow, cfm"
   },
   {
    "ref": "AI 74",
    "name": "HOOD VOL",
    "why": "Total fume hood exhaust, cfm"
   },
   {
    "ref": "AI 83",
    "name": "VOL DIFFRNC",
    "why": "Exhaust minus supply airflow, cfm"
   },
   {
    "ref": "BO 22",
    "name": "VOL DIF ALM",
    "why": "Room pressurization (offset) alarm"
   },
   {
    "ref": "BO 92",
    "name": "VENT ALM",
    "why": "Ventilation alarm"
   }
  ],
  "enable": "Occupancy comes from NET OCC CMD (BO 29) written by the field panel or BMS, the room occupancy switch on DI 2 or the room unit button, as enabled by OCC ENA (AO 12); the room is unoccupied only when all enabled sources say so. OCC.UNOCC (BO 21) shows the resulting state.",
  "heartbeat": null,
  "remote_sensors": "NET ALM CMD (BO 23) lets the field panel or BMS switch the local alarm output; it is always enabled for local annunciation.",
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the point table lists its factory value as 255.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6792."
  ],
  "gotchas": [
   "DIF ALM DBD (AO 38) must be smaller than the absolute value of VOL DIF STPT, or the pressurization alarm can come too late.",
   "Without fume hoods on AI 3, set MAX HOOD VOL (AO 52) to 0 or the hood signal below 1 V raises an alarm.",
   "Flow limits, gains, duct areas, valve tables and setup codes are commissioning values; don't write them from the BMS routinely."
  ]
 },
