 ],
 "equipment_type": "Dual duct constant volume terminal unit controller",
 "applies_to": "Constant volume dual duct boxes with an air velocity sensor in each inlet and optional hot water or electric reheat on the Siemens BACnet PTEC dual duct controller 550-497P (540-507N with autozero module).",
 "summary": "Application 6565 controls a dual duct box on a Siemens BACnet PTEC controller over BACnet MS/TP, holding a constant total airflow: OCC FLOW when occupied and a lower UNOCC FLOW when unoccupied. In cooling the cold duct damper holds room temperature and the hot duct damper makes up the volume; in heating the hot duct damper holds the volume. An optional hot water valve or up to three electric stages add heat.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, cfm, ft²); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "The point database names the occupancy points OCC.UNOCC, OCC/UOC CLG/HTG STPT and UNOCC OVRD; parts of the guide text still call them DAY.NGT, DAY/NGT setpoints and NGT OVRD.",
  "Auxiliary heat is off unless AUX HTG USED (BO 82) = YES; AUX HTG TYPE (BO 83) picks hot water (VALVE COMD) or electric stages; without it the application runs in cooling mode only."
 ],
 "source": {
  "title": "BACnet PTEC Controller Dual Duct with 2 AVS - Constant Volume with Two Inlet Sensors and Optional Reheat, Application 6565, Application Note",
  "doc_number": "140-0995",
  "revision_date": "2015-04-29",
  "url": "https://sid.siemens.com/api/khub/documents/XS_5yvmQo~5DZ5gkp1LX3w/content"
 },
 "integration": {
  "summary": "Set the MS/TP address and the application number, then release the box to application control. The BMS commands occupancy with OCC.UNOCC (BO 29) and the occupied setpoints, and reads room temperature, the two duct airflows and the error status.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "OCC.UNOCC",
    "why": "OCC = occupied, UNOCC = unoccupied"
   },
   {
    "ref": "AO 6",
    "name": "OCC CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "OCC HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "AO 32",
    "name": "OCC FLOW",
    "why": "Occupied total airflow setpoint, cfm"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AI 35",
    "name": "CLG VOLUME",
    "why": "Cold duct airflow, cfm"
   },
   {
    "ref": "AI 30",
    "name": "HTG VOLUME",
    "why": "Hot duct airflow, cfm"
   },
   {
    "ref": "AO 99",
    "name": "ERROR STATUS",
    "why": "Controller error code"
   }
  ],
  "enable": "Occupancy is OCC.UNOCC (BO 29). With a wall switch on DI 2 and WALL SWITCH (BO 18) = YES, the switch sets it; standalone with no switch the controller stays occupied; on a network the field panel or BMS commands OCC.UNOCC. UNOCC OVRD (BO 21) shows a temporary occupied override from the room unit button.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the point table lists its factory value as 99.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6593."
  ],
  "gotchas": [
   "Digital room units with RH or CO2 sensing keep overriding ROOM TEMP, RM RH and RM CO2, so commands from the BMS or PPCL to those points do not take effect.",
   "Loop gains, motor timing, rotation angles and setup codes are commissioning values; don't write them from the BMS routinely.",
   "Don't set OCC FLOW (AO 32) to 0; it must be at least UNOCC FLOW (AO 31)."
  ]
 },
