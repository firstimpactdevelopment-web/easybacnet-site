 ],
 "equipment_type": "Heat pump unit controller",
 "applies_to": "Water-to-air and other packaged heat pumps with up to three compressors, a reversing valve, optional electric heat and mixed air damper on the Siemens BACnet PTEC heat pump multi-stage controller 550-490PA.",
 "summary": "Application 6673 runs a multi-stage heat pump on a Siemens BACnet PTEC controller over BACnet MS/TP. The cooling and heating loops stage up to three compressors (or compressors plus electric heat) and switch the reversing valve, and an optional mixed air loop drives an outdoor air damper for ventilation and free cooling. It replaces application 2583 of the older Siemens heat pump controller.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, Btu/lb); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "DI 6 (BI 26) can be wired to the heat pump alarm contact for central alarm monitoring; it does not affect control.",
  "Outputs 46 and 47 are shared: electric heat stage 3/2 or compressor 2/3, depending on CMP TOTL and EHTG STG CNT."
 ],
 "source": {
  "title": "BACnet PTEC Controller Heat Pump - Multi-Compressor with Mixed Air and Reversing Valve Control, Application 6673, Application Note",
  "doc_number": "140-1150",
  "revision_date": "2014-07-17",
  "url": "https://sid.siemens.com/api/khub/documents/HepZL2pKvNz58kz_wM7wsw/content"
 },
 "integration": {
  "summary": "Address the controller on the BACnet MS/TP trunk (manually or with auto addressing). The BMS commands occupancy with DAY.NGT (BO 29) and the day setpoints, enables free cooling with FREE CLG (BO 23) when outdoor air is suitable, and reads room temperature, fan and compressor status, the heat pump alarm input and the error status.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "DAY.NGT",
    "why": "DAY = occupied, NIGHT = unoccupied"
   },
   {
    "ref": "BO 23",
    "name": "FREE CLG",
    "why": "Free cooling allowed (outdoor air cool enough)"
   },
   {
    "ref": "AO 6",
    "name": "DAY CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "DAY HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "BO 50",
    "name": "FAN",
    "why": "Fan on/off"
   },
   {
    "ref": "BO 45",
    "name": "COMPRESSOR 1",
    "why": "Compressor 1 on/off"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "BI 26",
    "name": "DI 6",
    "why": "Heat pump alarm input, if wired to DI 6"
   },
   {
    "ref": "AO 99",
    "name": "ERROR STATUS",
    "why": "Controller error code"
   }
  ],
  "enable": "Occupancy is DAY.NGT (BO 29). With a wall switch on DI 2 and WALL SWITCH (BO 18) = YES, the switch sets it; standalone with no switch the controller stays in day mode; on a network the field panel or BMS commands DAY.NGT. NGT OVRD (BO 21) shows a temporary night override from the room unit button.",
  "heartbeat": null,
  "remote_sensors": "FREE CLG (BO 23) is set by the field panel to say whether outdoor air is cool enough for free cooling; with it DISABL the damper stays at minimum (day) or closed (night).",
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the factory value is 255.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6690."
  ],
  "gotchas": [
   "With a digital room unit (revision 26 and later), a command sent through the room unit puts the matching BACnet input Out Of Service.",
   "Loop gains, motor timing, rotation angles and setup codes are commissioning values; don't write them from the BMS routinely.",
   "Fan, compressor and reversing valve outputs ignore BACnet commands at any priority unless HP DO OVRD (BO 69) is ENABLE; direct commands bypass the minimum on/off safeties.",
   "After a power failure compressors and electric heat stay off for RETURN DELAY plus 10 s times CTLR ADDRESS, while the fan runs."
  ]
 },
