 "manufacturer_slug": "siemens",
 "model": "BT300 HVAC drive (BACnet)",
 "model_slug": "bt300",
 "aliases": [
  "BT300",
  "Siemens BT300",
  "BT300 VFD",
  "BT300 frequency converter",
  "BT300 HVAC drive"
 ],
 "equipment_type": "Variable frequency drive (HVAC)",
 "applies_to": "Siemens Building Technologies BT300 HVAC variable frequency drives, all voltage and power ranges, BACnet firmware 1.1.",
 "summary": "The BT300 is Siemens' HVAC drive for fans and pumps, with BACnet MS/TP built in; the PICS also lists BACnet IP. It exposes 133 fixed objects: start/stop, enable, direction and reset commands as Binary Outputs, a speed reference and drive readings as Analog Values, fault history, PID values, bypass status and configurable fieldbus data objects.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": "BACnet application software 1.1, firmware 1.1",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access comes from each object's present-value entry in the PICS; writable objects with a priority array are shown as commandable.",
  "The summary table spells 'Binray Input'; BI 0-5 are the drive's digital inputs.",
  "FBDATAOUT and FB DATA IN objects carry whatever process data the drive is set up to map; the PICS does not say what.",
  "AV 44 CURRENT LMT lists its units as enumeration 3, which is amperes in BACnet.",
  "MS/TP baud rates 9600, 19200, 38400 and 76800; on BACnet IP it can register as a foreign device (it is not a BBMD).",
  "AV 40-50 are drive parameters (limits, ramps, motor nameplate); writing them changes the drive setup."
 ],
 "source": {
  "title": "Siemens BT300 BACnet Protocol Implementation Conformance Statement (PICS)",
  "doc_number": null,
  "revision_date": "2015-12-28",
  "url": "https://www.bacnetinternational.net/catalog/manu/siemens/Siemens_BT300_PICS_20151228.pdf"
 },
 "integration": {
  "summary": "Write BO 4 to start and stop, keep BO 3 run enable on, and send the speed reference to AV 0 in percent. Read BV 2 running status, AV 3 output frequency, AV 5 current and BV 4 fault, and reset trips with BO 6. BV 30 FB CONTROL and BV 31 FB REFERENCE select fieldbus control and reference; check the BT300 manual for how the drive must be set.",
  "minimum_points": [
   {
    "ref": "BO 4",
    "name": "CMD RUN STOP",
    "why": "Start/stop from the BMS"
   },
   {
    "ref": "BO 3",
    "name": "RUN ENABLE",
    "why": "Run enable; must be on to run"
   },
   {
    "ref": "AV 0",
    "name": "SPEED REF",
    "why": "Speed reference in %"
   },
   {
    "ref": "BO 6",
    "name": "FAULT RESET",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 2",
    "name": "RUNSTP STAT",
    "why": "Running status"
   },
   {
    "ref": "AV 3",
    "name": "OUTPUT FREQ",
    "why": "Output frequency in Hz"
   },
   {
    "ref": "AV 5",
    "name": "MOTOR CRRNT",
    "why": "Motor amps"
   },
   {
    "ref": "AV 10",
    "name": "KW HOURS",
    "why": "Energy counter, kWh"
   },
   {
    "ref": "BV 4",
    "name": "FAULT STATUS",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 16",
    "name": "ACTIVE FAULT",
    "why": "Active fault code"
   }
  ],
  "enable": "BO 4 CMD RUN STOP starts and stops the drive and BO 3 RUN ENABLE must be enabled. BV 30 FB CONTROL and BV 31 FB REFERENCE are writable selectors for fieldbus control and reference; the PICS does not explain them, so confirm the control place and reference source settings in the BT300 manual.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP master at 9600, 19200, 38400 or 76800 baud; BACnet IP (with foreign device registration) is also listed in the PICS.",
   "No default device instance is given in the PICS.",
   "Max masters and max info frames exist on MS/TP only."
  ],
  "gotchas": [
   "AV 40-50 change drive limits, ramps and motor data; don't write them cyclically.",
   "FBDATAOUT / FB DATA IN contents depend on the drive's process data mapping.",
   "BO 5 CMD FWD REV active state is REVRSE; leave it off for normal fan and pump rotation."
  ]
 },
