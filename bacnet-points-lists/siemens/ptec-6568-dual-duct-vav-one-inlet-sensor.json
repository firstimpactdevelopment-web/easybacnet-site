{
 "manufacturer": "Siemens",
 "manufacturer_slug": "siemens",
 "model": "BACnet PTEC Dual Duct Controller - Application 6568 (2 Air Velocity Sensors, VAV One Inlet Sensor, Optional Reheat)",
 "model_slug": "ptec-6568-dual-duct-vav-one-inlet-sensor",
 "short_model": "PTEC Dual Duct VAV 6568",
 "aliases": [
  "PTEC 6568",
  "Application 6568",
  "App 6568",
  "550-497P",
  "540-507N",
  "Siemens dual duct VAV"
 ],
 "equipment_type": "Dual duct VAV terminal unit controller",
 "applies_to": "Dual duct VAV boxes with one flow sensor in the cold duct and one in the common discharge, plus optional hot water or electric reheat, on the Siemens BACnet PTEC dual duct controller 550-497P (540-507N with autozero module).",
 "summary": "Application 6568 controls a dual duct VAV box on a Siemens BACnet PTEC controller over BACnet MS/TP, measuring cold duct airflow and total discharge airflow. In cooling the cold duct damper holds room temperature and the hot duct damper keeps the minimum airflow; in heating the hot duct damper holds room temperature and the cold duct damper keeps the minimum. Optional auxiliary heat is a hot water valve or up to three electric stages.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, cfm, ft²); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "Auxiliary heat is off unless AUX HTG USED (BO 82) = YES; AUX HTG TYPE (BO 83) picks hot water (VALVE COMD) or electric stages.",
  "The second flow sensor measures total (discharge) airflow, so the hot duct points are named TOT (TOT VOLUME, TOT FLOW, TOTFLO gains)."
 ],
 "source": {
  "title": "BACnet PTEC Controller Dual Duct 2 AVS - VAV One Inlet Sensor with Optional Reheat, Application 6568, Application Note",
  "doc_number": "140-0998",
  "revision_date": "2014-06-12",
  "url": "https://sid.siemens.com/api/khub/documents/hURUhrSCACwgVlvf~aL9Ig/content"
 },
 "integration": {
  "summary": "Set the MS/TP address and the application number, then release the box to application control. The BMS commands occupancy with DAY.NGT (BO 29) and the day setpoints, and reads room temperature, cold duct and total airflow and the error status.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "DAY.NGT",
    "why": "DAY = occupied, NIGHT = unoccupied"
   },
   {
    "ref": "AO 6",
    "name": "DAY CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "DAY HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AI 35",
    "name": "CLG VOLUME",
    "why": "Cold duct airflow, cfm"
   },
   {
    "ref": "AI 30",
    "name": "TOT VOLUME",
    "why": "Total discharge airflow, cfm"
   },
   {
    "ref": "AO 99",
    "name": "ERROR STATUS",
    "why": "Controller error code"
   }
  ],
  "enable": "Occupancy is DAY.NGT (BO 29). With a wall switch on DI 2 and WALL SWITCH (BO 18) = YES, the switch sets it; standalone with no switch the controller stays in day mode; on a network the field panel or BMS commands DAY.NGT. NGT OVRD (BO 21) shows a temporary night override from the room unit button.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the point table lists its factory value as 99.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6593."
  ],
  "gotchas": [
   "Releasing the controller and its equipment to application control is covered in the Siemens start-up document, not this guide.",
   "Digital room units with RH or CO2 sensing keep overriding ROOM TEMP, RM RH and RM CO2, so commands from the BMS or PPCL to those points do not take effect.",
   "Loop gains, motor timing, rotation angles and setup codes are commissioning values; don't write them from the BMS routinely."
  ]
 },
