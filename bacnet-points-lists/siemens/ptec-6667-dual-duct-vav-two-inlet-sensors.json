{
 "manufacturer": "Siemens",
 "manufacturer_slug": "siemens",
 "model": "BACnet PTEC Dual Duct Controller - Application 6667 (2 Air Velocity Sensors, VAV Two Inlets, Optional Reheat)",
 "model_slug": "ptec-6667-dual-duct-vav-two-inlet-sensors",
 "short_model": "PTEC Dual Duct VAV 6667",
 "aliases": [
  "PTEC 6667",
  "Application 6667",
  "App 6667",
  "550-497PA",
  "Siemens dual duct VAV"
 ],
 "equipment_type": "Dual duct VAV terminal unit controller",
 "applies_to": "Dual duct VAV boxes with an air velocity sensor in each inlet and optional hot water or electric reheat on the Siemens BACnet PTEC dual duct controller 550-497PA.",
 "summary": "Application 6667 controls a dual duct VAV box on a Siemens BACnet PTEC controller over BACnet MS/TP, with a separate airflow loop and damper for the cold and hot duct inlets. In cooling the cold duct damper holds room temperature while the hot duct makes up the minimum total flow; in heating the roles swap. Optional auxiliary heat can be a hot water valve or up to three electric stages.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, cfm, ft²); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "Auxiliary heat is off unless AUX HTG USED (BO 82) = YES; AUX HTG TYPE (BO 83) picks hot water (VALVE COMD) or electric stages.",
  "Do not set CLG FLOW MAX or HTG FLOW MAX to 0; TOT FLOW MIN and VENT DMD MIN must stay below both maximums."
 ],
 "source": {
  "title": "BACnet PTEC Controller Dual Duct 2 AVS - VAV Two Inlet Sensors with Optional Reheat, Application 6667, Application Note",
  "doc_number": "140-1115",
  "revision_date": "2017-05-31",
  "url": "https://sid.siemens.com/api/khub/documents/6H_dTbiNGSAY6cIEDG_wBg/content"
 },
 "integration": {
  "summary": "Address the controller on the BACnet MS/TP trunk (manually or with auto addressing), then release the box to application control. The BMS commands occupancy with DAY.NGT (BO 29) and the day setpoints, and reads room temperature, the two duct airflows and the error status.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "DAY.NGT",
    "why": "DAY = occupied, NIGHT = unoccupied"
   },
   {
    "ref": "AO 6",
    "name": "DAY CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "DAY HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AI 35",
    "name": "CLG VOLUME",
    "why": "Cold duct airflow, cfm"
   },
   {
    "ref": "AI 30",
    "name": "HTG VOLUME",
    "why": "Hot duct airflow, cfm"
   },
   {
    "ref": "AO 99",
    "name": "ERROR STATUS",
    "why": "Controller error code"
   }
  ],
  "enable": "Occupancy is DAY.NGT (BO 29). With a wall switch on DI 2 and WALL SWITCH (BO 18) = YES, the switch sets it; standalone with no switch the controller stays in day mode; on a network the field panel or BMS commands DAY.NGT. NGT OVRD (BO 21) shows a temporary night override from the room unit button.",
  "heartbeat": null,
  "remote_sensors": "VENT DMD MIN (AO 77) can be reset by the field panel (IAQ/DCV programs) or PPCL to raise the occupied minimum total airflow; the larger of it and TOT FLOW MIN is used.",
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the factory value is 255.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6693."
  ],
  "gotchas": [
   "As shipped, the controller keeps all equipment OFF until it is released to application control (see Siemens start-up procedures).",
   "With a digital room unit (revision 26 and later), a command sent through the room unit puts the matching BACnet input Out Of Service.",
   "Loop gains, motor timing, rotation angles and setup codes are commissioning values; don't write them from the BMS routinely.",
   "With electric auxiliary heat, airflow safeties across the coils must be provided by others; keep TOT FLOW MIN above 0 if the box supplies that airflow."
  ]
 },
