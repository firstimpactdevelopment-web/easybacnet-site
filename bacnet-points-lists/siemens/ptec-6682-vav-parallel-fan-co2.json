{
 "manufacturer": "Siemens",
 "manufacturer_slug": "siemens",
 "model": "BACnet PTEC VAV Controller - Application 6682 (Parallel Fan, CO2 Monitoring, AOV or Floating Reheat)",
 "model_slug": "ptec-6682-vav-parallel-fan-co2",
 "short_model": "PTEC Parallel Fan VAV CO2 6682",
 "aliases": [
  "PTEC 6682",
  "Application 6682",
  "App 6682",
  "550-499PA",
  "Siemens parallel fan VAV CO2"
 ],
 "equipment_type": "Fan-powered VAV terminal unit controller",
 "applies_to": "Parallel fan-powered VAV boxes with one or two 0-10 V or floating heating devices and optional room CO2 monitoring on the Siemens BACnet PTEC controller 550-499PA.",
 "summary": "Application 6682 controls a parallel fan-powered VAV box on a Siemens BACnet PTEC controller over BACnet MS/TP. It modulates the primary air damper for cooling and one or two modulating heating devices for heating; the parallel fan runs in heating, either when heat is on and primary airflow is low (FIXED) or on the heating loop (VARIED). It can also monitor room CO2 and a supply air temperature.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F, cfm, ft²); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "The fan is OFF whenever HEAT.COOL = COOL, except briefly after heating to clear heat from the coil (MODHTG TIME).",
  "If the air velocity sensor fails, the controller falls back to pressure-dependent damper control; if the room sensor fails it uses the last good value."
 ],
 "source": {
  "title": "BACnet PTEC Controller VAV with CO2 Monitoring, Parallel Fan and AOV or Floating Point Heating, Application 6682, Application Note",
  "doc_number": "140-1156",
  "revision_date": "2014-07-17",
  "url": "https://sid.siemens.com/api/khub/documents/T61ksFqrEu2X9eIgcczldg/content"
 },
 "integration": {
  "summary": "Address the controller on the BACnet MS/TP trunk (manually or with auto addressing), then release the box to application control. The BMS commands occupancy with DAY.NGT (BO 29) and the day setpoints, and reads room temperature, airflow, damper position, fan status, room CO2 and the error status.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "DAY.NGT",
    "why": "DAY = occupied, NIGHT = unoccupied"
   },
   {
    "ref": "AO 6",
    "name": "DAY CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "DAY HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "BO 89",
    "name": "FAN",
    "why": "Parallel fan on/off"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AI 35",
    "name": "AIR VOLUME",
    "why": "Measured primary airflow, cfm"
   },
   {
    "ref": "AO 49",
    "name": "DMPR POS",
    "why": "Primary air damper position, %"
   },
   {
    "ref": "AI 3",
    "name": "RM CO2",
    "why": "Room CO2, ppm"
   },
   {
    "ref": "AO 99",
    "name": "ERROR STATUS",
    "why": "Controller error code"
   }
  ],
  "enable": "Occupancy is DAY.NGT (BO 29). With a wall switch on DI 2 and WALL SWITCH (BO 18) = YES, the switch sets it; standalone with no switch the controller stays in day mode; on a network the field panel or BMS commands DAY.NGT. NGT OVRD (BO 21) shows a temporary night override from the room unit button.",
  "heartbeat": null,
  "remote_sensors": "VENT DMD MIN (AO 123) can be reset by the field panel (IAQ/DCV programs) or PPCL to raise the occupied minimum airflow. Switchover on supply air temperature needs PPCL to command HEAT.COOL (BO 5).",
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the factory value is 255.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6698."
  ],
  "gotchas": [
   "As shipped, the controller keeps all equipment OFF until it is released to application control (see Siemens start-up procedures).",
   "With a digital room unit (revision 26 and later), a command sent through the room unit puts the matching BACnet input Out Of Service.",
   "Loop gains, motor timing, rotation angles and setup codes are commissioning values; don't write them from the BMS routinely."
  ]
 },
