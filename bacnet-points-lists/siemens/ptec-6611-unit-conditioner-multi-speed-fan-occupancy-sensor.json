 "model_slug": "ptec-6611-unit-conditioner-multi-speed-fan-occupancy-sensor",
 "short_model": "PTEC Unit Conditioner Multi-Speed Fan 6611",
 "aliases": [
  "PTEC 6611",
  "Application 6611",
  "App 6611",
