 ],
 "equipment_type": "Fan coil unit controller",
 "applies_to": "Fan coil and similar unit conditioners with 0-10 V heating and cooling valves, up to three on/off stages or a floating valve, and a three-speed or variable speed fan, on the Siemens BACnet PTEC unit conditioner controller 550-480PA.",
 "summary": "Application 6611 runs a unit conditioner on a Siemens BACnet PTEC controller over BACnet MS/TP. It can drive spring-return 0-10 V heating and cooling valves, up to three on/off heating or cooling stages or one floating valve, and a fan by three speed relays or a 0-10 V drive. It supports an ON/OFF switch, an occupancy sensor (PIR), wall switch or night override button for occupancy, a DI or load-based heat/cool switchover, up to three alarm inputs with three alarm levels, and control from room or auxiliary temperature.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Newer than revision Bx40",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "AI and BI objects are read-only. AO and BO objects are BACnet output objects with a priority array; the guide has no access column, so access is inferred from object type. Many AOs are calculated status values, not commands.",
  "Instances shown in braces in the guide may be unbundled at a field panel; that marking is not reproduced here.",
  "Units are given in US units (°F); the guide also lists SI factory defaults.",
  "The guide covers controllers with firmware newer than revision Bx40; older firmware has separate documentation.",
  "Alarm levels (AO 27): 0 none, 1 monitor only, 2 all controls off except the fan, 3 all controls off including the fan. SAFETY SET 1-3 assign a level to DI 5, DI 2 and DI 6.",
  "This application uses OCC.UNOCC (BO 29) and OCC/UNOCC setpoints (AO 6-9) where other PTEC fan coil apps use DAY.NGT."
 ],
 "source": {
  "title": "BACnet PTEC Controller Unit Conditioner Heating and Cooling Controller with Multi-Speed Fan, ON/OFF Switch, and Occupancy Sensor, Application 6611, Application Note",
  "doc_number": "140-1178",
  "revision_date": "2016-12-22",
  "url": "https://sid.siemens.com/api/khub/documents/Pd3DOqYbXdMQ4ii6GhUhyA/content"
 },
 "integration": {
  "summary": "Address the controller on the BACnet MS/TP trunk. The BMS commands occupancy with OCC.UNOCC (BO 29) and the occupied setpoints, and reads room temperature, the on/off state, fan speed, valve outputs and the alarm level.",
  "minimum_points": [
   {
    "ref": "BO 29",
    "name": "OCC.UNOCC",
    "why": "OCC = occupied, UNOCC = unoccupied"
   },
   {
    "ref": "AO 6",
    "name": "OCC CLG STPT",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AO 7",
    "name": "OCC HTG STPT",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "BO 28",
    "name": "ON.OFF",
    "why": "Controller on/off state"
   },
   {
    "ref": "BO 5",
    "name": "HEAT.COOL",
    "why": "Current mode: HEAT or COOL"
   },
   {
    "ref": "AI 4",
    "name": "ROOM TEMP",
    "why": "Space temperature"
   },
   {
    "ref": "AO 26",
    "name": "FAN SPEED",
    "why": "Fan speed (0 off to 3 high)"
   },
   {
    "ref": "AO 57",
    "name": "HTG AOV 2",
    "why": "Heating valve output, V"
   },
   {
    "ref": "AO 58",
    "name": "CLG AOV 3",
    "why": "Cooling valve output, V"
   },
   {
    "ref": "AO 27",
    "name": "ALARM",
    "why": "Alarm level (0 none to 3 high)"
   }
  ],
  "enable": "Occupancy is OCC.UNOCC (BO 29): a wall switch on DI 2 (DI2 CONFIG = 0 and WALL SWITCH = YES) sets it, otherwise the field panel or BMS commands it. With DI2 CONFIG = 3 an ON/OFF switch on DI 2 sets ON.OFF (BO 28); when off, an occupancy sensor on DI 3 can turn the unit on for PIR TIME (OFF OVRD, BO 25).",
  "heartbeat": null,
  "remote_sensors": "If VALVE TYPE or STAGE TYPE is 3 (one element heats or cools), HEAT.COOL (BO 5) must be set by the field panel unless DI 6 is configured as a heat/cool switch.",
  "setup": [
   "BACnet MS/TP only. CTLR ADDRESS (AO 1) holds the MS/TP address; the point table lists its factory value as 255.",
   "APPLICATION (AO 2) holds the application number; the point table lists its factory default as 6697."
  ],
  "gotchas": [
   "Alarm level 2 or 3 turns the controlled equipment off (level 3 also stops the fan).",
   "Loop gains, valve voltage limits, stage settings and setup codes are commissioning values; don't write them from the BMS routinely."
  ]
 },
