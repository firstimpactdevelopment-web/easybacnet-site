 ],
 "equipment_type": "Variable frequency drive (BACnet MS/TP adapter)",
 "applies_to": "Allen-Bradley PowerFlex 4, 40 and 400 drives fitted with the 22-COMM-B internal BACnet MS/TP adapter.",
 "summary": "The 22-COMM-B adapter puts a PowerFlex 4-class drive on BACnet MS/TP. It exposes a fixed set of objects: drive I/O terminals (AI, AO, BI, BO), drive status and commands as Binary Values, and references, measurements, fault history and a parameter mailbox as Analog Values. Which objects work depends on the drive (some are PowerFlex 40 / 400 only, noted in the descriptions).",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "FRN 1.xxx",
 "default_device_instance": 160000,
 "access_inferred": false,
 "notes": [
  "Table 4.A marks each object for PowerFlex 4, 40 and 400; objects not marked for a drive are noted in the description.",
  "AV 9 and AV 10 are reserved.",
  "AO and BO objects only drive the terminals when the drive output is set to take its value from the network (see the parameter given in the manual).",
  "Copy hosted on archive.org (manualzilla upload), not on rockwellautomation.com."
 ],
 "source": {
  "title": "BACnet MS/TP Adapter 22-COMM-B FRN 1.xxx User Manual",
  "doc_number": "22COMM-UM008B-EN-P",
  "revision_date": "2006-10",
  "url": "https://archive.org/download/manualzilla-id-5728490/5728490.pdf",
  "unofficial": true,
  "host": "archive.org"
 },
 "integration": {
  "summary": "Set the drive's speed reference source to the network (P038 = 5, Comm Port) and its start source as needed, then write a % speed reference to AV 0 and start/stop with BV 10. Read BV 1, AV 2, AV 3 and the fault objects for monitoring; BV 13 clears faults.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "name": "Run/Stop",
    "why": "Run/stop command (1 = run)"
   },
   {
    "ref": "AV 0",
    "name": "Reference 1 (%)",
    "why": "Speed reference, %"
   },
   {
    "ref": "BV 13",
    "name": "Clear Faults",
    "why": "Fault reset (write 1)"
   },
   {
    "ref": "BV 1",
    "name": "Running",
    "why": "Running status"
   },
   {
    "ref": "AV 2",
    "name": "Output Frequency (Hz)",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 3",
    "name": "Output Current (Amps)",
    "why": "Output current, A"
   },
   {
    "ref": "BV 3",
    "name": "Fault",
    "why": "Drive fault"
   },
   {
    "ref": "AV 12",
    "name": "Fault 1",
    "why": "Latest fault code"
   }
  ],
  "enable": "Drive parameter P038 [Speed Reference] = 5 (Comm Port) lets the network reference work; BV 10 then starts and stops the drive.",
  "heartbeat": "Adapter parameter 03 [Comm Loss Time] (default 10 s) sets how long until a network loss is detected; parameter 02 [Comm Loss Action] decides what happens (default: fault the drive; also stop, zero data, hold last or send fault configuration).",
  "remote_sensors": null,
  "setup": [
   "MAC address is set in binary on DIP switches SW1-SW7; the adapter reads it at power-up or after an adapter reset.",
   "Device instance default 160000, entered as parameter 11 [Device Inst Hi] (upper digits) and parameter 12 [Device Inst Lo] (last three digits); reset the adapter to apply.",
   "Baud rate is adapter parameter 06 [Baud Rate Cfg]: Autobaud (default), 9600, 19200, 38400 or 76800; reset the adapter after changes."
  ],
  "gotchas": [
   "Commands written over BACnet are volatile; after an adapter reset or power cycle the BMS must write them again.",
   "AV 6 and AV 11 accept only 0 (reset) when written.",
   "AV 5, AV 6, BI 5-6, BO 1-2 and the AO objects are not supported on a PowerFlex 4; AO 1 and AV 6 are PowerFlex 400 only."
  ]
 },
