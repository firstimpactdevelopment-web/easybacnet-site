 "access_inferred": true,
 "notes": [
  "The guide prints no read/write column; setpoints, timers, settings and command objects are marked writable here and measurements read-only.",
  "Temperatures are mapped twice, in °C and °F objects.",
  "Point names include the explanations in brackets exactly as printed.",
  "AV 47 and AV 49 only apply when AV 36 Legal Hour is set to Custom (-1 = last Sunday, 1 = first Sunday of the month, and so on).",
  "Not the same list as the newer LEGIOMIXevo 6003 or LEGIOMIX 2.0 6002."
 ],
 "integration": {
  "summary": "Add the Legiomix_6000_Series profile and the valve's Modbus Node-ID in the gateway, then read AV 3 mixed temperature, AV 4 recirculation temperature and AV 7 state. Write the mixing and disinfection setpoints (AV 23/24) as needed and use BV 42 to reset alarms.",
  "minimum_points": [
   {
    "ref": "AV 23",
    "name": "Set Reg Deg_C (Set Mix temp)",
