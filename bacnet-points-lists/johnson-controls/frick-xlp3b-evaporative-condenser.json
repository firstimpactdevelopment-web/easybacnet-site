 "integration": {
  "summary": "Enable BMS for BACnet in the HMI communications menu and set the IP address and device instance. Write BMS Enable (BV 2) = 1, then command the fans (BV 3), pump (BV 4) and fan speed (AV 1); read the unit status (MV 1), run status and the unit alarm.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "BMS Enable",
    "why": "Must be 1 for the BMS commands to apply"
   },
   {
    "ref": "BV 3",
    "name": "BMS Fan Run Cmd",
    "why": "Fan run command (1 = enabled)"
   },
   {
    "ref": "BV 4",
    "name": "BMS Pump Run Cmd",
    "why": "Pump run command (1 = enabled)"
   },
   {
    "ref": "AV 1",
    "name": "BMS Fan Speed Cmd",
    "why": "Fan speed setpoint, %"
   },
   {
    "ref": "MV 1",
    "name": "Unit Status",
    "why": "Unit state (running, off by alarm/BMS/DI)"
   },
   {
    "ref": "BV 5",
    "name": "Fan Run Status",
    "why": "Fans running"
   },
   {
    "ref": "BV 6",
    "name": "Pump Run Status",
    "why": "Pump running"
   },
   {
    "ref": "BV 1",
    "name": "Unit Alarm",
    "why": "Any unit alarm"
   }
  ],
  "enable": "BMS Enable (BV 2) hands control to the BMS; Unit Status (MV 1) reads 3 = Off by BMS when the BMS has stopped the unit and 6 = Off by Local Enable when the local enable is off.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "In the HMI Settings > Communications menus: enable BMS for BACnet or Modbus, set DHCP or a static IP, and set the BACnet UDP port, APDU timeout, device instance and BBMD options.",
   "The unit of measure for the BMS lines (USA, SI and others) is set in the UoM menu."
  ],
  "gotchas": [
   "Only IP protocols are supported; there is no BACnet MS/TP.",
   "Setting a fan override (BV n2) to 0 overrides that fan; leave it at 1 for normal control."
  ]
 },
