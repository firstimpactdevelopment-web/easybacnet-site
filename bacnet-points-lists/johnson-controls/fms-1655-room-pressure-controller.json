 "equipment_type": "Room pressure controller (isolation room)",
 "applies_to": "Triatek / Johnson Controls FMS-1655 room pressure controllers for isolation rooms, labs and cleanrooms, with optional anteroom and flow inputs.",
 "summary": "The FMS-1655 holds and monitors room differential pressure by driving a damper, with four configurable analog inputs, two thermistor inputs, four analog outputs, four digital inputs and four relays. It talks BACnet MS/TP or Metasys N2. The BACnet table has 90 objects: I/O, setpoints, alarm and warning limits, network-written values, airflow and volumetric offset, output overrides, deadbands, isolation mode commands and alarm status.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "85000 + MAC address",
 "access_inferred": false,
 "notes": [
  "Object names are the manual's functional descriptions. Multistate objects are printed as MSO (multistate output) and shown here as MO.",
  "MSO 1 is printed \"Primary solation Mode\" (sic).",
  "AV 17/18 and BO 4 are marked 'Not user-selectable'.",
  "Units are not printed in the BACnet table.",
  "The same manual also has a Metasys N2 object table (pages 64-65), not included here.",
  "Source: 'BACnet Objects' table, manual pages 62-63 (PDF pages 65-66), 90 objects."
 ],
 "source": {
  "title": "FMS-1655 Room Pressure Controller Programming Manual",
  "doc_number": "LIT-12013120 Rev. A",
  "revision_date": "2018-08",
  "url": "https://docs.johnsoncontrols.com/bas/api/khub/documents/JIDP3G795sTe0t6ZnGsF2g/content"
 },
 "integration": {
  "summary": "Map the room isolation mode command, the room pressure setpoint, the measured room pressure, the damper output and the primary alarm status. Write network variables (AV 43-46) only if the BAS supplies those values.",
  "minimum_points": [
   {
    "ref": "MO 1",
    "name": "Primary solation Mode",
    "why": "Isolation mode: 1 positive, 2 negative, 3 neutral"
   },
   {
    "ref": "AV 1",
    "name": "AI-1 Setpoint (Room Pressure)",
    "why": "Room pressure setpoint"
   },
   {
    "ref": "AI 1",
    "name": "Analog Input 1 (default: Isolation Pressure)",
    "why": "Room (isolation) pressure"
   },
   {
    "ref": "AO 1",
    "name": "Analog Output 1 (default: Damper Position)",
    "why": "Damper position output"
   },
   {
    "ref": "BI 1",
    "name": "Digital Input 1 (default: Door Switch)",
    "why": "Door switch"
   },
   {
    "ref": "MO 3",
    "name": "Primary Alarm Status",
    "why": "Primary alarm: 1 normal, 2 warning, 3 alarm"
   }
  ],
  "enable": "Primary Isolation Mode (MSO 1) is writable: 1 positive, 2 negative, 3 neutral.",
  "heartbeat": null,
  "remote_sensors": "AV 43-46 are writable network variables for humidity, temperature, air changes and differential pressure sent from the BAS.",
  "setup": [
   "BACnet MS/TP is the default protocol; Metasys N2 is the alternative.",
   "Device instance = Device ID Offset (default 85,000, set in steps of 1,000) + MAC address, e.g. MAC 123 gives 85,123.",
   "MS/TP master MAC range 1-127; Max_Master default 127; baud rate chosen from four standard rates on the Network Setup menu."
  ],
  "gotchas": [
   "Alarm limits, deadbands and setpoints are setup values; don't write them cyclically.",
   "What each analog input measures depends on how it is configured; names give the default use."
  ]
 },
