   {
    "ref": "MV 1",
    "name": "Operating mode",
    "why": "Occupied, unoccupied or standby"
   },
   {
    "ref": "AV 1",
    "name": "AI-1 face velocity setpoint",
    "why": "Face velocity setpoint"
   },
   {
    "ref": "AI 1",
    "name": "Analog input 1, default: face velocity",
    "why": "Measured face velocity"
   },
   {
    "ref": "AI 2",
    "name": "Analog input 2, default: sash postion",
    "why": "Sash position"
   },
   {
    "ref": "AI 4",
    "name": "Analog input 4, exhaust air flow",
    "why": "Hood exhaust airflow"
   },
   {
    "ref": "AO 1",
    "name": "Analog output 1, default: hood exhaust control",
    "why": "Exhaust valve or damper signal"
   },
   {
    "ref": "MV 3",
    "name": "Face velocity alarm status",
    "why": "Face velocity alarm state"
   }
  ],
  "enable": "Operating mode (MV 1) is read/write; the occupancy switch on DI 3 can also switch the hood to occupied. The sash must be below the low alarm mute height before unoccupied mode can be selected.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP only; MAC address 4-127, baud 38.4 kbps by default (76.8k, 19.2k and 9600 also offered).",
   "The default device ID is 85,000 plus the MAC address (for example 85,025 for MAC 25); it can be changed to any value from 0 to 4,194,303.",
   "Reset the controller or cycle power after changing the MAC address or baud rate so it rejoins the trunk."
  ],
  "gotchas": [
   "Alarm limits, deadbands and override levels are setup values; don't write them cyclically.",
   "Enter the alarm limits or the alarm logic and display won't work. The binary objects have no ActiveText/InactiveText, so a non-Metasys BAS may not show their values until those texts are set at the front end."
  ]
 },
