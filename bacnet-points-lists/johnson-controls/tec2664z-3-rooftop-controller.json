   },
   {
    "ref": "AI 1",
    "name": "GUI Discharge Air Temp",
    "why": "Discharge air temperature, °F"
   },
   {
    "ref": "AI 2",
    "name": "GUI Return Air Temp",
    "why": "Return air temperature, °F"
   },
   {
    "ref": "AI 3",
    "name": "GUI Static Pressure",
    "why": "Duct static pressure"
   },
   {
    "ref": "BI 10",
    "name": "Sta Service Alarm",
    "why": "Service alarm"
   },
   {
    "ref": "BI 13",
    "name": "Sta Discharge Temp Alarm",
    "why": "Discharge air temperature alarm"
   }
  ],
  "enable": "GUI System Mode (MV 15) switches the system Off or Auto. GUI Occupancy (MV 14) sets system occupancy (Released, Occupied, Unoccupied or Temporary Occupied). Zones with Default Zone Handle follow the rooftop occupancy, including a Temporary Occupied override from the rooftop keypad.",
  "heartbeat": null,
  "remote_sensors": "The table lists GUI Outdoor Temp Override (BV 6) as writable but GUI Outdoor Temperature (AV 19) as read-only; the zone controllers also carry a writable GUI Outdoor Temperature (AV 22).",
  "setup": [
   "BACnet MS/TP only; set the MS/TP address (4-127) at the rooftop controller.",
   "The controller names itself TEC2664Z-76aaa and picks device instance 76aaa (aaa = MS/TP address); change them before mapping points if needed.",
   "When the schedule is viewed from an NAE, assign ordinal 2 to Occupied and 3 to Unoccupied in the schedule facets."
  ],
  "gotchas": [
   "Rooftop keypad lockout levels 1 and 2 block system mode changes at the keypad; level 2 also blocks the occupancy override.",
   "Configuration values (Cfg points) are writable but are setup values; don't write them cyclically."
  ]
 },
