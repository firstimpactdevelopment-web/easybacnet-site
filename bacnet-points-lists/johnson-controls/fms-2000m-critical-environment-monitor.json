 "equipment_type": "Room pressure monitor (critical environment)",
 "applies_to": "Triatek / Johnson Controls FMS-2000M critical environment monitors with one to four differential pressure sensors (models FMS2M-Bx1x to Bx4x).",
 "summary": "The FMS-2000M is a monitor-only touch display for up to four rooms' differential pressure, with a door switch input per room. On BACnet MS/TP it exposes pressure inputs, door switches, per-room alarm and warning limits, writable network values (temperature, humidity, flow, air changes, CO2) shown on the display, the isolation mode and per-room status.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "85000 + MAC address",
 "access_inferred": false,
 "notes": [
  "Objects for rooms 2-4 only exist on models with that many sensors: Bx1x has room 1 only, Bx2x rooms 1-2, Bx3x rooms 1-3, Bx4x all four.",
  "The read/write column is printed once per table: inputs read-only, analog values read or write, MV 1 read or write, MV 2-5 read-only.",
  "Isolation mode setup applies to the first monitored room only.",
  "Units are not printed in the BACnet tables.",
  "Source: Tables 'BACnet objects' (analog inputs, binary inputs, analog values, multistate objects), pages 19-20 (49 objects)."
 ],
 "source": {
  "title": "FMS-2000M Critical Environment Monitor User Guide",
  "doc_number": "LIT-12013580",
  "revision_date": "2023-07",
  "url": "https://docs.johnsoncontrols.com/bas/api/khub/documents/zvUV8p~wZXi3DJmoW9JqXg/content"
 },
 "integration": {
  "summary": "Read the room pressure (AI 1-4) and status (MV 2-5) for each installed sensor, and the door switches. The BAS can set the isolation mode (MV 1) and push values for display through the network variables.",
  "minimum_points": [
   {
    "ref": "MV 1",
    "name": "Isolation mode",
    "why": "Isolation mode: 1 positive, 2 negative, 3 neutral"
   },
   {
    "ref": "AI 1",
    "name": "Analog input 1, differential pressure",
    "why": "Room 1 differential pressure"
   },
   {
    "ref": "BI 1",
    "name": "Digital input 1, door switch 1",
    "why": "Room 1 door switch"
   },
   {
    "ref": "MV 2",
    "name": "Status 1",
    "why": "Room 1 status: 1 normal, 2 warning, 3 alarm"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": "Network variables for temperature, humidity, flow, air changes and CO2 per room (AV 1, 6, 25-27 for room 1) are writable so the BAS can show those values on the display.",
  "setup": [
   "Default device ID is 85,000 plus the MAC address; it can be changed to 0-4,194,303.",
   "MS/TP master MAC range 4-127. Default baud 38.4 kbps; reboot the monitor after changing baud or MAC."
  ],
  "gotchas": [
   "Alarm and warning limits are setup values; don't write them cyclically.",
   "Room 2-4 objects return nothing on models with fewer sensors."
  ]
 },
