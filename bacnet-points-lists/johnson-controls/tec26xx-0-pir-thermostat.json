 "integration": {
  "summary": "Address the thermostat on the BACnet MS/TP trunk, then command System Mode (MV 16), Occupancy Command (MV 18) and Fan Mode (MV 17) and write the occupied setpoints (AV 39/40). Read Room Temp, Effective Occupancy, Fan Status and the filter and service alarms.",
  "minimum_points": [
   {
    "ref": "MV 16",
    "name": "System Mode",
    "why": "System mode: off, auto, cool or heat"
   },
   {
    "ref": "MV 18",
    "name": "Occupancy Command",
    "why": "Occupancy command from the BAS"
   },
   {
    "ref": "MV 17",
    "name": "Fan Mode",
    "why": "Fan mode; states follow Fan Mode Sequence"
   },
   {
    "ref": "AV 39",
    "name": "Occupied Heat Setpoint",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "AV 40",
    "name": "Occupied Cool Setpoint",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "MV 33",
    "name": "Effective Occupancy",
    "why": "Occupancy state in effect"
   },
   {
    "ref": "AV 7",
    "name": "Room Temp",
    "why": "Room temperature, °F"
   },
   {
    "ref": "MV 28",
    "name": "Fan Status",
    "why": "Fan speed status"
   },
   {
    "ref": "BI 36",
    "name": "Filter Alarm",
    "why": "Filter alarm"
   },
   {
    "ref": "BI 37",
    "name": "Service Alarm",
    "why": "Service alarm"
   }
  ],
  "enable": "Occupancy Command (MV 18) set to Occupied or Unoccupied sets occupancy from the BAS; Local Occupancy hands it back to the thermostat. System Mode (MV 16) can switch the unit off.",
  "heartbeat": null,
  "remote_sensors": "Room Temp Override (BV 8) and Room Humidity Override (BV 11) sit next to Room Temp (AV 7) and Room Humidity (AV 10); on the TEC26x6(H)-4 the override must be set before the value can be written. This table has no notes, so confirm on site.",
  "setup": [
   "BACnet MS/TP only. The bulletin's general section says TEC26xx devices name themselves TEC26xx-aaa, where aaa is the MS/TP address (4 to 127); this table does not give the instance prefix.",
   "Leave the thermostat on automatic baud detection; at least one device on the trunk needs a fixed baud rate."
  ],
  "gotchas": [
   "Writing one setpoint of a heating/cooling pair can make the thermostat move the other one to keep the minimum deadband.",
   "Set the configuration parameters before mapping; the guide recommends re-mapping all objects if configuration changes afterwards.",
   "Fan Mode (MV 17) state text depends on Fan Mode Sequence (the table names it MV 58; the object listed here is MV 57)."
  ]
 },
