 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Objects from Table 11 on pages 44-48 of the technical bulletin. This table has no access footnotes and no device row.",
  "Access is inferred: objects with the same instance as the TEC26x6(H)-4 table take that table's access; the extra configuration objects (MV 82-85, BV 86-87, AV 88-89, MV 90, MV 95) are marked writable and the status objects read-only.",
  "Local Motion (BI 32) has no state text in the table.",
  "Temperatures are listed in °F; the guide also gives the °C range."
 ],
