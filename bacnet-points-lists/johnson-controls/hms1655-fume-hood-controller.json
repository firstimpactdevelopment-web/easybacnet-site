    "why": "Exhaust damper signal"
   },
   {
    "ref": "MO 3",
    "name": "Fume Hood Face Velocity Alarm Status",
    "why": "1 normal, 2 warning, 3 alarm"
   }
  ],
  "enable": "Fume Hood Operating Mode (MSO 1) is read/write: 1 = occupied, 2 = unoccupied, 3 = decommissioned. Emergency Purge (BV 2) drives maximum flow.",
  "heartbeat": null,
  "remote_sensors": "AV 44-47 are writable network variables for humidity, temperature, air changes and differential pressure sent from the BAS.",
  "setup": [
   "BACnet MS/TP only.",
   "Device ID Offset (AV 48) is writable over the network (range 0 to 4,194,000)."
  ],
  "gotchas": [
   "Alarm limits, deadbands and override levels are setup values; don't write them cyclically."
  ]
 },
