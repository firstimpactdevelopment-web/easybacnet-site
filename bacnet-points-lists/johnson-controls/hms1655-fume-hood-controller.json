 "equipment_type": "Laboratory VAV controller (fume hood)",
 "applies_to": "Fume hoods controlled and monitored by the Johnson Controls HMS1655 fume hood controller with face velocity, sash, pressure, airflow and temperature inputs.",
 "summary": "The HMS1655 is a fume hood controller and monitor that holds face velocity by driving the exhaust damper and reports sash, pressure, airflow and temperature inputs. Over BACnet MS/TP it exposes six inputs, four analog outputs and four relays, occupancy and emergency purge commands, setpoints, alarm limits, air change and volumetric offset values, network-written sensor values and multistate operating mode and alarm status objects.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "The guide lists each object with a functional description, not an Object_Name string; that description is used as the point name here.",
  "Multistate objects are printed as MSO (multistate output) and are shown here as MO.",
  "Alarm Relay 4 High/Low Setpoint (AV 18/19) are marked N/A for read/write in the table; they are shown as read-only.",
  "What AI 1-4 measure depends on how each input is configured; the names give the factory default use.",
  "Units are not printed in the BACnet table."
 ],
