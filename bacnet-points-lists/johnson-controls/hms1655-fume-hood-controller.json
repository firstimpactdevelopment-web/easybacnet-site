    "why": "Emergency purge to maximum flow"
   },
   {
    "ref": "AV 1",
    "name": "AI-1 Setpoint. Fume Hood Face Velocity Setpoint",
    "why": "Face velocity setpoint"
   },
   {
    "ref": "BV 1",
    "name": "Occupancy Status",
    "why": "Occupancy status"
   },
   {
    "ref": "AI 1",
    "name": "Analog Input 1. Default: Fume Hood Face Velocity",
    "why": "Measured face velocity"
   },
   {
    "ref": "AI 2",
    "name": "Analog Input 2. Default: Sash Position Sensor)",
    "why": "Sash position"
   },
   {
    "ref": "AO 1",
