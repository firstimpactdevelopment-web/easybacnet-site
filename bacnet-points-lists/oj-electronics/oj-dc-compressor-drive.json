 ],
 "equipment_type": "Compressor frequency drive",
 "applies_to": "OJ Electronics OJ-DC drives for compressors in air handling units, heat pumps and chillers.",
 "summary": "The OJ-DC compressor drive has BACnet MS/TP on its RS-485 terminals and RJ12 ports. Binary Values give run, alarm reset and alarm, warning and compressor-protection flags (lubrication, oil boost, minimum run time); Integer Values carry the speed setpoint, limits, ramps and running data. BACnet MS/TP has to be switched on first, through the OJ PC tool or Modbus.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "AOC 1.00 or later",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Integer Value objects (IV) carry scaled whole numbers; values marked x0.01 have two implied decimals.",
  "BV 2 and BV 24-39 are not in the table.",
  "IV 18, 19 and 20 are all printed as \"Power Consumpt.\" and hold the Wh, kWh and MWh parts of the energy count.",
  "IV 8 RPMOut is printed with the unit Hz.",
  "Writing 0 to BV 4 turns BACnet MS/TP off; it comes back only through Modbus or protocol auto-detect."
 ],
 "source": {
  "title": "OJ DC BACnet MS/TP protocol (application note)",
  "doc_number": "67958B",
  "revision_date": "05/25",
  "url": "https://ojelectronics.com/drives/wp-admin/admin-ajax.php?action=productdownload&media_id=67464802&filename=67958B-05-25-OJ+DC-BACnet-MS-TP-protocol_GB+WEB.pdf&view=true"
 },
 "integration": {
  "summary": "Enable BACnet MS/TP on the drive, write the speed setpoint to IV 0 and set BV 0 to run the compressor. Read IV 7/IV 8 for output and speed and the BV alarm flags; BV 1 resets alarms.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "Motor on/off",
    "why": "Run command (1 = on); clears on any error"
   },
   {
    "ref": "IV 0",
    "name": "Setpoint / PrcSet",
    "why": "Speed setpoint, 0-10000 = 0-100.00 %"
   },
   {
    "ref": "BV 1",
    "name": "Reset Alarms",
    "why": "Alarm reset (1 = reset)"
   },
   {
    "ref": "IV 8",
    "name": "RPMOut",
    "why": "Compressor speed output, Hz"
   },
   {
    "ref": "IV 7",
    "name": "PrcOut",
    "why": "Output level, x0.01 %"
   },
   {
    "ref": "IV 12",
    "name": "Power In (filtered)",
    "why": "Input power, W"
   },
   {
    "ref": "BV 15",
    "name": "Internal Stop",
    "why": "Internal stop alarm"
   },
   {
    "ref": "BV 10",
    "name": "Rotor Blocked",
    "why": "Rotor blocked alarm"
   }
  ],
  "enable": "BACnet MS/TP must be enabled (OJ PC tool or Modbus coils); then BV 0 starts and stops the compressor.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Out of the box the drive talks Modbus (address 70, 38400 baud, no parity, 1 stop bit); BACnet MS/TP is switched on from the OJ PC tool (Alternative device communications) or through Modbus coils.",
   "MS/TP settings: baud 9600-115200, MAC 0-127, Max Master 1-127, device instance 0-4194302 (Modbus holding registers).",
   "OJ publishes an EDE file for the object list on its product page."
  ],
  "gotchas": [
   "BV 0 drops back to 0 on any error, so the BMS has to set it again after the fault is cleared.",
   "Do not write BV 4 = 0: it turns BACnet MS/TP off until it is re-enabled through Modbus.",
   "BV 40-43 flag compressor protection cycles (lubrication, oil boost, minimum run, pressure relax) that can hold the speed."
  ]
 },
