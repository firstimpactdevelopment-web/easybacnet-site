{
 "manufacturer": "Veris",
 "manufacturer_slug": "veris",
 "model": "E71 series energy meter (BACnet IP)",
 "model_slug": "e71-energy-meter",
 "aliases": [
  "E71",
  "E71E3",
  "E71E3A",
  "E71E3X",
  "E71E3AX",
  "Veris E71",
  "E71 Series Energy Meter"
 ],
 "equipment_type": "Power and energy meter",
 "applies_to": "Veris E71 series DIN-rail three-phase energy meters (E71E3, E71E3A, E71E3X, E71E3AX) with dual Ethernet ports.",
 "summary": "The E71 is a compact three-phase DIN-rail meter with two Ethernet ports and native BACnet IP, Modbus TCP and SNMP. Its object list is read-only Analog Inputs for energy (net, import, export, per quadrant and per phase), power, demand, volts, amps, power factor, frequency, pulse counts, input/relay status and four tariff registers, writable Analog Values for setup, and alert Binary Inputs.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Firmware 1.9.0, application 111.241.298 (PICS)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Taken from the E71 PICS, which lists object identifiers and names only; it prints no units or descriptions, so units are left blank and descriptions are our reading of the names.",
  "Reserved objects (AI 25-28, 77, 79, 80, 82; BI 8, 17) are left out.",
  "Access per the PICS: Analog Input and Binary Input present values are read-only; Analog Value present values are writable.",
  "The PICS also lists Trend Log objects without instances or names; they are not listed here.",
  "AV 33 is printed Multi_Tarrif_Control_Mode (spelling as printed)."
 ],
 "source": {
  "title": "E71 - Protocol Implementation Conformance Statement",
  "doc_number": null,
  "revision_date": "2024-08-06",
  "url": "https://www.bacnetinternational.net/catalog/manu/veris%20industries/PICS_e71_pics.pdf",
  "unofficial": true,
  "host": "BACnet International"
 },
 "integration": {
  "summary": "Give the meter an IP address and device instance, set system type, CT and PT values in the AV setup objects (or on the meter), then trend energy and real power and watch the alert BIs or AI 83 Alarm_Bitmap.",
