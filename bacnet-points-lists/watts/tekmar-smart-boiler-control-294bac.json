{
 "manufacturer": "Watts",
 "manufacturer_slug": "watts",
 "model": "tekmar Smart Boiler Control 294BAC",
 "model_slug": "tekmar-smart-boiler-control-294bac",
 "aliases": [
  "tekmar 294BAC",
  "294BAC",
  "tekmar 294",
  "Smart Boiler Control 294",
  "J1308"
 ],
 "equipment_type": "Multi-boiler plant controller",
 "applies_to": "tekmar (Watts) Smart Boiler Control 294BAC, a staging and reset control for plants of up to 16 boilers with DHW, connected natively over BACnet IP or BACnet MS/TP.",
 "summary": "The tekmar 294BAC stages and resets up to 16 boilers and handles domestic hot water. It talks BACnet IP or BACnet MS/TP natively and exposes the plant targets and temperatures, pressure, override state, pump run times, per-boiler firing rate, EMS temperature output, run hours and cycles, per-boiler status and availability, and a large set of writable settings: outdoor temperature from the BAS, room and DHW setpoints, reset curve, boiler limits, staging, alerts and service intervals.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "J1308, firmware 1.14.0 or later (PICS)",
 "default_device_instance": 1,
 "access_inferred": false,
 "notes": [
  "Native BACnet IP and BACnet MS/TP, vendor ID 585 (tekmar Control Systems), protocol revision 18, device profile B-ASC.",
  "Each boiler uses a block of ten instances: boiler n's objects sit at 100 + 10 x (n - 1) onward (boiler 1 = 100-104 AI, 100-101 AV/BI, 100 BV; boiler 16 = 250-254). All 16 blocks are printed and listed.",
  "Wireless (Nexa) sensors add objects that are not listed here: AI 1000 + 100 x (n - 1) temperature, + 1 humidity, + 2 battery, and BI 1000 + 100 x (n - 1) online status, for sensors n = 1-99 (up to AI/BI 10800).",
  "Most AV and BV objects are installer settings (reset curve, staging, DHW and alert setup) that the control stores; change them deliberately.",
  "Error codes 1-154 are listed in the manual (sensor faults, tN4 and Modbus boiler loss, boiler errors, alerts, wireless and BACnet network errors)."
 ],
 "source": {
  "title": "Smart Boiler Control 294BAC - BAS Integration Manual",
  "doc_number": "IS-T-294BAC 2627",
  "revision_date": "2026",
  "url": "https://www.watts.com/dfsmedia/0533dbba17714b1ab581ab07a4cbb521/674967-source/is-t-294bac-2627.pdf"
 },
 "integration": {
  "summary": "Set BAS Type to BACnet IP or BACnet MS/TP in the 294BAC BAS menu, give it a Device ID, and discover it. Turn central heating on with BV 0, set occupied/unoccupied room and DHW targets, optionally feed the outdoor temperature from the BAS (AV 0 with AV 33 = BAS), and monitor the boiler target and supply temperatures, plant output, boiler statuses and the error code.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "Central heating",
    "why": "Central heating on/off"
   },
   {
    "ref": "AV 1",
    "name": "Room occupied",
    "why": "Occupied room target, 34.7-100.4 °F"
   },
   {
    "ref": "AV 11",
    "name": "DHW tank occupied",
    "why": "Occupied DHW tank setpoint, 50-230 °F"
   },
   {
    "ref": "AV 0",
    "name": "Outdoor air temperature",
    "why": "Outdoor temperature from the BAS (when AV 33 = BAS)"
   },
   {
    "ref": "AI 1",
    "name": "Boiler target temperature",
    "why": "Plant supply target"
   },
   {
    "ref": "AI 2",
    "name": "Boiler supply temperature",
    "why": "Plant supply temperature"
   },
   {
    "ref": "AI 3",
    "name": "Plant output",
    "why": "Plant output, 0-100 %"
   },
   {
    "ref": "BI 100",
    "name": "Boiler 1 status",
    "why": "Boiler 1 firing (1 = on)"
   },
   {
    "ref": "AI 0",
    "name": "Error code",
    "why": "Active error code"
   }
  ],
  "enable": "BV 0 Central heating turns space heating on or off; BV 100 + 10 x (n - 1) makes boiler n available.",
  "heartbeat": null,
  "remote_sensors": "Set AV 33 Outdoor sensor to 4 (BAS) and write the outdoor temperature to AV 0. Error 153 flags a BAS outdoor sensor problem; the manual does not give a timeout.",
  "setup": [
   "BAS menu: BAS Type None/BACnet MS/TP/BACnet IP (default None). BACnet IP needs Internet Connection Type set to Ethernet.",
   "Device ID 0-4194302 (default 1); device object name default 'Smart Boiler Control'.",
   "MS/TP: MAC 0-127 (default 1), baud 9600-115200 (default 19200), Max Masters default 127, Max Info Frames default 1.",
   "BACnet IP: UDP port default 47808; optional foreign-device registration to a BBMD (TTL default 30 s).",
   "Reinitialize Device and Device Communication Control password: tekmar1150."
  ],
  "gotchas": [
   "Most writable objects are configuration settings stored by the control; avoid writing them cyclically."
  ]
 },
