 "equipment_type": "Snow melting controller (boiler-fed slab)",
 "applies_to": "tekmar (Watts) Snow Melting Control 680 for hydronic or electric snow melting slabs, with boiler and mixing outputs.",
 "summary": "The tekmar 680 runs an automatic snow melting system: it watches up to two slab and snow/ice sensors, fires a boiler and drives mixing, and talks BACnet IP or BACnet MS/TP natively. The object list gives operation and status codes, melt time remaining, slab, boiler and system temperatures, outputs, flow, pressure, run hours and the error code, plus writable melt/idle/storm setpoints, times, sensitivities and melt/storm requests.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "J1243F (PICS)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Native BACnet, vendor ID 585 (tekmar Control Systems), protocol revision 10, device profile B-ASC.",
  "The manual lists AI 19 twice (System Pressure and Melting Energy, then skips to AI 21). Only System Pressure is listed here because the real instance of Melting Energy is not printed.",
  "Temperatures are in °F.",
  "Source PDF is served from Watts' media server (www.watts.com)."
 ],
 "integration": {
  "summary": "Use Melt/Stop Request to start or stop a melt and Storm/Stop Request for storm mode, and adjust the melt, idle and storm setpoints as needed. Read Operation and Operation Status, slab and boiler temperatures, the snow/ice sensor states and the error code.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "Melt/Stop Request",
    "why": "Start melting from the BMS (1 = Melt)"
   },
   {
    "ref": "BV 2",
    "name": "Storm/Stop Request",
    "why": "Start storm mode from the BMS (1 = Storm)"
   },
   {
    "ref": "AV 1",
    "name": "Melt Setpoint",
    "why": "Slab melting setpoint, 32-95 °F"
   },
   {
    "ref": "AV 0",
    "name": "BAS Outdoor Air Temperature",
    "why": "Outdoor temperature from the BMS (if BV 0 = 1)"
   },
   {
    "ref": "BV 0",
    "name": "Outdoor Sensor Enable",
    "why": "1 = use the BMS outdoor temperature"
   },
   {
    "ref": "AI 0",
    "name": "Operation",
    "why": "0 Off, 1 Idle, 2 Storm, 3 Melt, 4 Manual"
   },
   {
    "ref": "AI 1",
    "name": "Operation Status",
    "why": "Normal, WWSD, CWSD, timed melt, warming up"
   },
   {
    "ref": "AI 7",
    "name": "Coldest Slab Temperature",
    "why": "Coldest slab temperature"
   },
   {
    "ref": "BI 2",
    "name": "Combined Water Status",
    "why": "Combined snow/ice sensor state (1 = wet)"
   },
   {
    "ref": "AI 26",
    "name": "Error Code",
    "why": "Error code; see the error list"
   }
  ],
  "enable": "BV 1 Melt/Stop Request (1 = Melt) and BV 2 Storm/Stop Request (1 = Storm) start a melt or storm cycle from the BMS. BV 3-6 enable or disable idling, storm mode, warm weather shut down and cold weather cut out.",
  "heartbeat": null,
  "remote_sensors": "Set BV 0 Outdoor Sensor Enable = 1 so the 680 uses the BAS outdoor temperature written to AV 0 (-67 to 149 °F); with 0 it measures its own outdoor sensor.",
  "setup": [
   "The 680 supports BACnet IP (RJ45 port) and BACnet MS/TP (RS-485 A, B, Gnd terminals); Modbus RS-485 is the other option.",
   "MS/TP: do not tie Gnd to the enclosure ground screws; with 120 ohm terminators, bias resistors are needed at the BACnet master.",
   "DeviceCommunicationControl password is \"tekmar\" (from the PICS)."
  ],
  "gotchas": [
   "Time values (melt time, storm run time) are in hours with minutes, e.g. 0:30 to 24:00.",
   "Idle Setpoint and Storm Setpoint use 0 = off.",
   "The manual prints Melting Energy with the same ID as System Pressure (AI 19); it is left out here (see notes)."
  ]
 },
