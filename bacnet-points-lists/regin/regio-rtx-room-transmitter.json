{
 "manufacturer": "Regin",
 "manufacturer_slug": "regin",
 "model": "Regio RTX room transmitter (firmware 2.0)",
 "model_slug": "regio-rtx-room-transmitter",
 "aliases": [
  "RTX",
  "Regio RTX",
  "RTX-2.0-1-02",
  "Regin RTX"
 ],
 "equipment_type": "Room sensor / transmitter",
 "applies_to": "Regin Regio RTX room transmitters (temperature, CO2, humidity, VOC, presence) with firmware 2.0.",
 "summary": "Regio RTX is a communicating room transmitter in the Regio family, connected over RS485 with EXOline, Modbus or BACnet MS/TP. The variable list gives 119 BACnet objects: room temperature, CO2, humidity, VOC and presence readings, remote values with enable selectors, per-channel analog/digital input values and overrides, analog outputs with comm-loss defaults, display settings, an extension timer and two custom text rows.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "RTX-2.0-1-02",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Taken from Regin's RTX variable list (xlsx), 'Object type', 'Instance', 'Unit' and 'Writeable' columns; the same file lists the EXOline and Modbus addresses. Names are the variable names in the list's Name column.",
  "6 rows have a BACnet object type but no instance (pulse counters and pulse rate of digital inputs 3 and 4); they are left out.",
  "Regin's combined EDE zip for RCX/RTX/RUX 2.1-1-01 holds only an RCX file, so multistate state texts are not available for the RTX and are left blank.",
  "Which inputs and outputs are wired depends on the RTX variant; the I/O channel objects exist in the list either way."
 ],
 "integration": {
  "summary": "Read AV 10002 room temperature, AV 10011 CO2, AV 10071 humidity, AV 10281 VOC index and BV 10001 presence. Keep BV 9101 RC_OfflineTrigger pulsing if the offline function is used. Values from the BMS can replace the local sensors through the …Remote AVs and their …RemoteSelect BVs.",
  "minimum_points": [
   {
    "ref": "BV 9101",
    "name": "RC_OfflineTrigger",
    "why": "Write 1 periodically to stay in normal mode"
   },
   {
    "ref": "AV 10002",
    "name": "RC_RoomTemp",
    "why": "Room temperature, °C"
   },
   {
    "ref": "AV 10011",
    "name": "RC_CO2Level",
    "why": "Room CO2, ppm"
   },
   {
    "ref": "AV 10071",
    "name": "RC_Humidity",
    "why": "Room relative humidity"
   },
   {
    "ref": "AV 10281",
    "name": "RC_VOC",
    "why": "VOC index"
   },
   {
    "ref": "BV 10001",
    "name": "RC_Presence",
    "why": "Presence indication"
   }
  ],
  "enable": null,
  "heartbeat": "BV 9101 RC_OfflineTrigger must be written to 1 periodically (the application sets it back to 0) within RC_OfflineTimeout, default 10 s (that timeout is not a BACnet object). MV 9301 RC_OfflineFunction sets the offline reaction. Analog outputs fall back to their IoAnaOut_n_default AV when communication is lost.",
  "remote_sensors": "AV 10611 / 10621 / 10681 / 10691 take remote room temperature, CO2, humidity and VOC values, each enabled by its …RemoteSelect BV (10321 / 10331 / 10391 / 10401). BV 10411 with BV 10481 does the same for the presence input.",
  "setup": [
   "Port 1 (RS485) protocol, baud rate and format are MV 9001 / 9101 / 9201; write BV 9001 RC_CommSettingsCommit = 1 to apply them."
  ],
  "gotchas": [
   "The ..._override_en BVs force an input or output to its override value; clear them after testing."
  ]
 },
