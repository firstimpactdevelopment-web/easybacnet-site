 "integration": {
  "summary": "Switch the controller's protocol to BACnet MS/TP in the parameter menu (or Application tool), then set the MAC address and device ID. Command occupancy with RegioRemoteState (MV 5), adjust the comfort setpoints and offset, and read room temperature, unit state, controller state and the alarm objects.",
  "minimum_points": [
   {
    "ref": "MV 5",
    "name": "RC_Setp_X.RegioRemoteState",
    "why": "Occupancy command: off, unoccupied, standby, occupied"
   },
   {
    "ref": "BV 10",
    "name": "RC_Setp_L.RegioShutDown",
    "why": "Force the unit into shutdown"
   },
   {
    "ref": "AV 7",
    "name": "RC_Setp_R.RegioOccSetPHeat",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "AV 8",
    "name": "RC_Setp_R.RegioOccSetPCool",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "MV 2",
    "name": "RC_Setp_X.RegioFanSelect",
    "why": "Fan mode: off, manual speed 1-3 or auto"
   },
   {
    "ref": "MI 1",
    "name": "RC_Actual_X.RegioUnitState",
    "why": "Current unit state"
   },
   {
    "ref": "MI 2",
    "name": "RC_Actual_X.RegioControllerState",
    "why": "Off, heating or cooling"
   },
   {
    "ref": "AI 0",
    "name": "RC_Actual_R.RegioRoomTemp",
    "why": "Room temperature"
   },
   {
    "ref": "AV 3",
    "name": "RC_Actual_R.RegioPIDSetP",
    "why": "Active controller setpoint"
   },
   {
    "ref": "BV 8",
    "name": "RC_Actual_L.RegioRoomTempSensorAlarm",
    "why": "Room sensor fault"
   }
  ],
  "enable": "RegioRemoteState (MV 5) lets the BMS force the unit state (off, unoccupied, standby, occupied); 6 = no remote control hands control back to the local logic. RegioShutDown (BV 10) forces the shutdown state and RegioBypass (BV 9) starts a timed bypass.",
  "heartbeat": null,
  "remote_sensors": "RegioRoomTempRemote (AV 15) lets the BMS supply the room temperature when the controller is configured for an external room sensor; the manual gives -255 as the 'disabled' value.",
  "setup": [
   "BACnet is only on the display models (RC-CDFO, RC-CDTO, RC-C3DOC, RC-C3DFOC, RCC-C3DOCS); set parameter 114 to 1 = BACnet MS/TP.",
   "MAC address (parameter 115): 0-127 runs as MS/TP master, 128-254 as slave.",
   "Device ID is set as low 4 digits (parameter 116) and high 3 digits (parameter 117); the address sticker gives a ready-made default.",
   "Speeds 9600, 19200, 38400 or 76800 bit/s (76800 only for BACnet).",
   "Once switched to BACnet, the protocol can only be switched back to EXOline/Modbus from the display."
  ],
  "gotchas": [
   "Value objects have no priority array; the last write wins and the local display can change the same values.",
