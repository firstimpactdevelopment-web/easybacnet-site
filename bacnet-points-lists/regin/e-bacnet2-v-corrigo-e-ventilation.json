{
 "manufacturer": "Regin",
 "manufacturer_slug": "regin",
 "model": "E-BACNET2-V BACnet IP converter for Corrigo E ventilation controller",
 "model_slug": "e-bacnet2-v-corrigo-e-ventilation",
 "aliases": [
  "E-BACNET2-V",
  "E-BACNET2",
  "EBACNET2V",
  "Corrigo E BACnet",
  "Corrigo E ventilation BACnet",
  "Systemair E-BACNET2-V",
  "E-CABLE-BACNET"
 ],
 "equipment_type": "Air handling unit controller (BACnet converter)",
 "applies_to": "Regin / Systemair Corrigo E controllers running the ventilation application version 3.0 or later.",
 "summary": "Pre-configured converter that connects to a Corrigo E ventilation controller over RS-485 (PLA:ELA 254:254) and publishes it on BACnet IP as 184 fixed objects: 40 AI, 41 AV, 98 BI, 1 BV, 1 MI, 2 MV and the device. Setpoints and alarm limits are writable AVs, alarms are individual BIs (Cor_AlaPt_n), and the unit's run mode is set through two multistate values.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "E-BACNET2-V 2.0-1-09 or later (Corrigo E ventilation application 3.0 or later)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access follows the manual's Adjustable column: AV, BV and MV objects are adjustable, AI, BI and MI are read-only.",
  "Alarm BIs Cor_AlaPt_1 to Cor_AlaPt_66 map to BI 19-84; Cor_AlaPt_77 to 87 follow at BI 85-95 (67-76 are not published).",
  "Cor_AlaPt_49 and Cor_AlaPt_53 are both printed as 'Sensor error supply air temperature'.",
  "Humidity units are printed as RH; flows in m³/h; fan and actuator outputs in volts.",
  "Revision B (Regin, December 2012)."
 ],
 "source": {
  "title": "E-BACNET2-V manual",
  "doc_number": null,
  "revision_date": "Revision B, December 2012",
  "url": "https://www.regincontrols.com/globalassets/pimmediafiles/documents/e-bacnet2-v_manu_en.pdf"
 },
 "integration": {
  "summary": "Wire the converter's S0/P1 port to the Corrigo E terminals 50-52 (B, A, N), leave the Corrigo at PLA:ELA 254:254, and set IP, device ID and name with the E-BACNET2 configuration software. Control the unit through Cor_AirUnitAutoMode and Cor_ExternalControl, adjust setpoints on the AVs, and read Cor_RunMode and the sum alarm BIs.",
  "minimum_points": [
   {
    "ref": "MV 0",
    "name": "Cor_AirUnitAutoMode",
    "why": "Manual off / reduced / normal speed, or 4 = Auto"
   },
   {
    "ref": "MV 1",
    "name": "Cor_ExternalControl",
    "why": "External run or stop command"
   },
   {
    "ref": "AV 0",
    "name": "Cor_SupplySetpoint",
    "why": "Supply air setpoint, °C"
   },
   {
    "ref": "AV 20",
    "name": "Cor_RoomSetP",
    "why": "Room setpoint when room control is used"
   },
   {
    "ref": "BV 0",
    "name": "Cor_AlaAcknowAll",
    "why": "Acknowledge all alarms"
   },
   {
    "ref": "MI 0",
    "name": "Cor_RunMode",
    "why": "Unit running state (stop, starting, normal...)"
   },
   {
    "ref": "AI 0",
    "name": "Cor_SupplyAirTemp",
    "why": "Supply air temperature"
   },
   {
    "ref": "BI 7",
    "name": "Cor_SumAlarm",
    "why": "Any A or B alarm"
   }
  ],
  "enable": "No separate enable point. MV 0 Cor_AirUnitAutoMode selects manual off/reduced/normal or Auto (time schedule); MV 1 Cor_ExternalControl gives external run/stop commands.",
  "heartbeat": null,
  "remote_sensors": "AV 37 Cor_OutDoorTemp is a writable outdoor temperature object.",
  "setup": [
   "Factory IP address is fixed at 192.168.92.92; change it (or enable DHCP) with the E-BACNET2 configuration software.",
   "The Corrigo must have PLA:ELA address 254:254 (the converter's default station address).",
   "BACnet UDP port 47808 by default; a Foreign device option with BBMD address is available.",
   "Ending the device name with $ appends the device ID automatically."
  ],
  "gotchas": [
   "Alarm acknowledge, block and unblock (AV 38-40) take the alarm number, not a 1/0.",
   "Startup takes about one minute; the Ready LED lights when the converter is ready.",
   "Only the Corrigo E ventilation application (3.0 or later) is supported."
  ]
 },
