 },
 "integration": {
  "summary": "Enable BACnet IP on the O3 (it ships on BACnet/Ethernet), discover it, and read the occupant-height temperature and humidity, the combined occupancy signal and light level. Tune occupancy with AV 23-26 if the space needs it.",
  "minimum_points": [
   {
    "ref": "AI 3",
    "name": "Occupant Temperature",
    "why": "Room temperature at occupant height"
   },
   {
    "ref": "AI 6",
    "name": "Occupant Humidity",
    "why": "Room humidity at occupant height, %"
   },
   {
    "ref": "BI 8",
    "name": "Occupancy",
    "why": "Occupied: motion plus sound"
   },
   {
    "ref": "AV 40",
    "name": "Occupancy Estimation",
    "why": "Estimated number of people"
   },
   {
    "ref": "AI 12",
    "name": "Light Level",
    "why": "Ambient light level"
   },
   {
    "ref": "AI 17",
    "name": "Sound Level",
    "why": "Ambient sound level, dB"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet/Ethernet is the default; BACnet IP (UDP 47808 by default) must be enabled, e.g. in Network Port object NP6 or with the Proviso app.",
   "Firmware 4.16+ moves Bluetooth and MQTT settings into Network Port objects NP10 and NP13.",
   "Proprietary objects (SUA, OS, ORS, BDE) need enteliWEB to create or edit."
  ],
  "gotchas": [
   "AI 3 occupant temperature is a composite of the internal and IR sensors; AI 5 is the ceiling-height reading.",
   "BI 8 stays active for AV 26 (default 300 s) after the last motion or sound; AV 25 sets how long sound alone keeps it occupied."
  ]
 },
