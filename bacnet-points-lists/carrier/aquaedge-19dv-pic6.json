 "integration": {
  "summary": "Enable BACnet in the BMS Protocol menu (J8 option for MS/TP or BACnet/IP Enable), set the identifier and network, and enable Network start. The chiller then starts when both BV 66 start/stop and BV 68 occupancy are true; write control point and demand limit through the _wr objects and read status, water temperatures and alarms.",
  "minimum_points": [
   {
    "ref": "BV 66",
    "name": "GENUNIT_CHIL_S_S_wr",
    "why": "Network start/stop command"
   },
   {
    "ref": "BV 68",
    "name": "GENUNIT_CHIL_OCC_wr",
    "why": "Network occupied command"
   },
   {
    "ref": "MV 1",
    "name": "GENUNIT_ctl_mode",
    "why": "Control mode: Local, Network, Remote, Local Sched"
   },
   {
    "ref": "AV 7",
    "name": "GENUNIT_ch_state",
    "why": "Chiller status code"
   },
   {
    "ref": "AV 9",
    "name": "TEMP_LCW",
    "why": "Leaving chilled water"
   },
   {
    "ref": "AV 8",
    "name": "TEMP_ECW",
    "why": "Entering chilled water"
   },
   {
    "ref": "AV 147",
    "name": "GENUNIT_CTRL_PNT_wr",
    "why": "Control point command"
   },
   {
    "ref": "AV 148",
    "name": "GENUNIT_DEM_LIM_wr",
    "why": "Demand limit command"
   },
   {
    "ref": "BV 67",
    "name": "GENUNIT_EMSTOP_wr",
    "why": "Emergency stop command"
   },
   {
    "ref": "AV 85",
    "name": "ALARMRST_alarm_1",
    "why": "Current alarm 1"
   }
  ],
  "enable": "In NETWORK control mode the chiller starts and stops from the CHIL_S_S and CHIL_OCC points written over the network (both must be true). Use EMSTOP for a quick shutdown. A STOP OVERRIDE point in GENUNIT, if enabled, prevents starting.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BMS Protocol menu (CONNECT table): Port J8 option 0=None, 1=BACnet MS/TP, 2=Modbus RTU; BACnet/IP Enable is separate.",
   "Defaults: BACnet identifier 1600001, BACnet network 1600, MS/TP MAC 1, MS/TP baud option 2 (38400), Max Master 3, Max Info Frames 5.",
   "Ethernet: J15 defaults to 169.254.1.1/16, J16 to 192.168.100.100/24; DHCP is not supported.",
   "BACnet MS/TP and BACnet IP cannot both be enabled; Modbus RTU can run with BACnet IP."
  ],
  "gotchas": [
   "Write the _wr objects; the _rd objects only echo the current value.",
   "BV 66 shows multistate text in the guide; it is a two-state start/stop command."
  ]
 },
