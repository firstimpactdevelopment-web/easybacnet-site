 ],
 "equipment_type": "Water-to-water heat pump controller",
 "applies_to": "Carrier water-to-water heat pumps fitted with the W2W Open (OPN-WSHPW2WM) multi-protocol controller.",
 "summary": "W2W Open is Carrier's i-Vu Open controller for water-to-water heat pumps. It heats or cools the load water to a chilled or hot water supply setpoint with up to 4 capacity stages, and DIP switches select BACnet MS/TP (the default), BACnet ARC156, Modbus or N2 (LonWorks by option card). The list has 76 objects: water setpoints and temperatures, compressor capacity and stages, pump status, enables, OA reset and demand-level settings, alarms and the 'system' points a BAS writes.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet ARC156"
 ],
 "firmware": null,
 "default_device_instance": "16101xx (xx = rotary switch address)",
 "access_inferred": false,
 "notes": [
  "System points (system_oat, system_rh, system_t1_temp, system_elwt, system_llwt, system_ecwt) are network inputs; the guide says system points must be written at BACnet priority 16 and no more than once a minute, and -999 means no network value.",
  "The table prints System Mode (run_status, MSV:2002) twice. The first row has the water-to-water states (Safety Shutdown, Dehumidify, Pump Only) and is used here; the repeat on the last page has unit-ventilator style states (Fire Shutdown, Pre-Occ Purge) and was dropped.",
  "Shutdown (BV:9001) and RH Cooling Setpoint Reset (BV:1020) are printed with Normal/Alarm states; kept as printed.",
  "Units 'deg' on the system water temperature inputs are as printed.",
  "Each point also has a Modbus register in the same table (some later rows have none); only the BACnet side is captured here."
 ],
 "source": {
  "title": "W2W Open Integration Guide (Appendix A: Network Points List for W2W Open)",
  "doc_number": "11-808-538-01",
  "revision_date": "2021-06-15",
  "url": "https://www.shareddocs.com/hvac/docs/1000/Public/05/11-808-538-01.pdf"
 },
 "integration": {
  "summary": "Set the controller for BACnet MS/TP with its DIP switches and rotary address. The unit is occupied by default and holds the load water at the chilled or hot water supply setpoint; the BAS commands occupancy through keypad_ovrde and writes the water setpoints. Outdoor air, T1 or water temperatures from the BMS go into the system_* points at priority 16.",
  "minimum_points": [
   {
    "ref": "MV 1001",
    "name": "keypad_ovrde",
    "why": "BAS occupancy command: occupied/unoccupied"
   },
   {
    "ref": "BV 9001",
    "name": "shutdown",
    "why": "Network shutdown command"
   },
   {
    "ref": "AV 3024",
    "name": "chws_setpoint",
    "why": "Chilled water supply setpoint"
   },
   {
    "ref": "AV 3023",
    "name": "hws_setpoint",
    "why": "Hot water supply setpoint"
   },
   {
    "ref": "MV 2002",
    "name": "run_status",
    "why": "Current system mode"
   },
   {
    "ref": "AV 1020",
    "name": "lvg_load_wtr_temp",
    "why": "Leaving load water temperature"
   },
   {
    "ref": "AV 1019",
    "name": "ent_load_wtr_temp",
    "why": "Entering load water temperature"
   },
   {
    "ref": "AV 5002",
    "name": "total_comp_cap",
    "why": "Total compressor capacity, %"
   },
   {
    "ref": "BV 7013",
    "name": "comp_alarm",
    "why": "Compressor status alarm"
   },
   {
    "ref": "BV 7048",
    "name": "equip_alarm",
    "why": "General equipment alarm"
   }
  ],
  "enable": "The controller is occupied by default. A third-party BAS sets occupancy by writing BAS On/Off keypad_ovrde (MSV:1001): 1=Inactive, 2=Occupied, 3=Unoccupied; the sequence says this takes precedence over the other occupancy sources, while the system-point table says occupancy control must be set to 3 (BAS On/Off). No heating or cooling runs while unoccupied. Cool Enable (BV:1011) and Heat Enable (BV:1012) must be Enable; Shutdown (BV:9001) stops the unit.",
  "heartbeat": "No general heartbeat. The guide gives refresh windows for the generic system points (OAT 5 min / 60 min, space RH 5 min / 10 min); a network value is only used while it is refreshed in time.",
  "remote_sensors": "Write system_oat (AV:1901), system_rh (AV:1904), system_t1_temp (AV:1909) or the system water temperatures (AV:1910-1912) at BACnet priority 16, no more than once a minute. The controller clears a system point after processing it, so confirm a write by reading the control point (e.g. oa_temp, space_rh) at least 30 s later. System T1 is needed when Control Mode Selection uses T1 for heat/cool changeover.",
  "setup": [
   "MS/TP MAC address on rotary switches MSB (SW1) and LSB (SW2), 01-99; switch changes take effect after a power cycle.",
   "Device instance is generated as 16101xx (16 = Carrier vendor ID, xx = rotary address).",
   "SW3 DIP switches set protocol and baud (9600/19.2k/38.4k/76.8k, 76.8k default); 8N1 fixed. Network on port J19.",
   "Max Masters defaults to 127 and Max Info Frames to 10 (Equipment Touch). The controller counts as a full load on the MS/TP bus."
  ],
  "gotchas": [
   "System points must be written at priority 16; other priorities are ignored.",
   "Demand levels widen the water setpoints cumulatively (level 3 = level 1 + 2 + 3 adjustments); the demand level points themselves are read-only here.",
   "Only controllers set as MS/TP masters answer Who-Is.",
   "Multi-unit master/slave setups add linkage points (cw_link_status, mr_comm_fail) that only matter in those systems."
  ]
 },
