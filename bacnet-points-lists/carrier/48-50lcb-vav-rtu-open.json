 "equipment_type": "Rooftop unit controller (VAV)",
 "applies_to": "Carrier 48/50LC B 07-26 variable air volume rooftop units with the factory VAV-RTU Open controller.",
 "summary": "The VAV-RTU Open is the factory controller on the 48/50LC B VAV rooftops. It runs as a BACnet MS/TP master, either as the air source for a Carrier VAV zoning system (Airside Linkage) or standalone under a third-party BMS. The points list has about 190 objects: sensor inputs, setpoints, supply-air and static-pressure control, service tests, runtimes and alarms.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Taken from Appendix D, Table C 'VAV-RTU Open Protocol Maps' (pp. 49-52). MSV objects are listed as MV.",
  "Point display names are as printed; four setpoints are all named 'Setpoint' in the table, so the description says which one (from the BACnet object name).",
  "Default values printed in the table are added to the descriptions. Multistate state texts are taken from the units column where printed.",
  "The System Mode states are printed with '8=Shutdow'; kept as printed.",
  "A different controller from the SystemVu control used on the 48/50LC 04-26 units and from the RTU Open controller, which have their own lists."
 ],
 "source": {
  "title": "48/50LCB07-26 with VAV-RTU Open Controller, Controls, Start-Up, Operation and Troubleshooting (Appendix D: BACnet Points List)",
  "doc_number": "48-50LCB-7-26-04T",
  "revision_date": "2022-05",
  "url": "https://brandportal.carrier.com/asset/1d59de26-3b17-4555-8d1e-6f6126a95717/48-50LCB-7-26-04T.pdf"
 },
 "integration": {
  "summary": "Set SW3 to BACnet MS/TP and the baud rate, set the address on SW1/SW2 and cycle power. For standalone use under a third-party BMS, command occupancy with BAS On / Off (MV 1001), write the occupied setpoints and the supply-air and static-pressure setpoints, and read the system mode, fan state, supply air temperature and alarms.",
  "minimum_points": [
   {
    "ref": "MV 1001",
    "name": "keypad_ovrde",
    "why": "BAS occupancy: 1=Inactive, 2=Occupied, 3=Unoccupied"
   },
   {
    "ref": "AV 3001",
    "name": "occ_cl_stpt",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "AV 3002",
    "name": "occ_ht_stpt",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "AV 3029",
    "name": "sat_cl_stpt",
    "why": "Supply air setpoint for cooling (default 53 °F)"
   },
   {
    "ref": "AV 3030",
    "name": "sa_static_stpt",
    "why": "Duct static pressure setpoint"
   },
   {
    "ref": "MV 2002",
    "name": "run_status",
    "why": "Current system mode"
   },
   {
    "ref": "BV 2001",
    "name": "sfan",
    "why": "Supply fan relay on/off"
   },
   {
    "ref": "AV 1008",
    "name": "sa_temp",
    "why": "Supply air temperature"
   },
   {
    "ref": "AV 2028",
    "name": "static_press",
    "why": "Duct static pressure"
   },
   {
    "ref": "BV 7024",
    "name": "safety_alarm",
    "why": "Safety chain alarm"
   }
  ],
  "enable": "BAS On / Off (keypad_ovrde, MV 1001) is the network occupancy input for third-party systems: 1 = Inactive (default), 2 = Occupied (occupied heating and cooling setpoints apply), 3 = Unoccupied (unoccupied setpoints apply). A BACnet schedule from i-Vu or the remote occupancy input can also set occupancy. Shutdown (BV 9001) is a writable shutdown point.",
  "heartbeat": null,
  "remote_sensors": "The System points take network values: System Space Temperature (AV 1902), System Space RH (AV 1904), System Space AQ (AV 1903), System Outdoor Air Temperature (AV 1901), System Outdoor AQ (AV 1908) and System Return Air Temperature (AV 1920). The table prints -999 as their default value. The guide gives no refresh time.",
  "setup": [
   "SW3 DIP switches set the protocol (BACnet MS/TP master) and baud rate (9600, 19200, 38400 or 76800); SW1 and SW2 set the MS/TP address (01-99). Cycle power after changing them.",
   "In a Carrier VAV system the zone controllers and the VAV-RTU Open are linked through a VAV Master zone controller, which must have the highest address on the MS/TP network.",
   "A Field Assistant laptop connects at the J12 local access port; the System Touch wall display connects to the MS/TP network."
  ],
  "gotchas": [
   "Economizer Exists (BV 99001) is set at the factory and is not field configurable.",
   "Several alarm BVs share a display name with the analog value they belong to (e.g. 'Compressor 1 Runtime' is both AV 2017 and BV 7014); go by the object name.",
   "The Service Test and Factory Test points (BV 81000-81008, BV 91001-91008, AV 91001-91002) drive outputs directly; leave them alone in normal operation."
  ]
 },
