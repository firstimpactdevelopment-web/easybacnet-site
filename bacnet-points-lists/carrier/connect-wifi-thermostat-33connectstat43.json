 ],
 "equipment_type": "Networked room thermostat",
 "applies_to": "Carrier Connect Wi-Fi wall thermostats controlling packaged or split AC, heat pump and furnace/air handler systems.",
 "summary": "The 33CONNECTSTAT43 is a Wi-Fi thermostat that also speaks BACnet MS/TP on its A+/B- terminals (B-ASC profile). Its 113 objects cover space temperature and humidity, setpoints, stage output status, fault flags, mode and fan mode, and most installer settings. Installer settings are 'gated' writes that only work when BACnet Config Write is enabled at the thermostat, and BMS occupancy only works when BACnet BMS Occ is enabled.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "16 followed by the last 4 digits of the serial number (range 1-4194302)",
 "access_inferred": false,
 "notes": [
  "The table prints four access levels: READ_ONLY, READ_WRITE, GATED_WRITE and WRITE_WHEN_OOS. GATED_WRITE points are marked W here and noted in the description; the two WRITE_WHEN_OOS inputs (AI:100, AI:101) are marked R.",
  "Some units look like copy errors in the source and are kept as printed: Indoor Equip Stages (AV:500) in %RH and Outdoor Equip Stages (AV:501) in °F.",
  "Fault flag ID TEMP SENSOR HIGH (BV:900) is printed with DISABLED/ENABLED states, unlike the other fault flags; kept as printed.",
  "The Network GP Y3/W2/OB outputs (BV:211-213) only accept writes when their Net GP mode (MSV:509-511) is not Disabled, and they can time out per General Purpose Output Timeout (MSV:508).",
  "Current Fan Mode (MSV:406) is printed with the object name 'FAN MODE' (with a space), unlike the other underscore names."
 ],
 "source": {
  "title": "Carrier Connect Wi-Fi Thermostat 33CONNECTSTAT43 Installation Guide (Appendix: BACnet Points List)",
  "doc_number": "11-808-728-01",
  "revision_date": "2022-12-02",
  "url": "https://www.shareddocs.com/hvac/docs/1000/Public/0C/11-808-728-01.pdf"
 },
 "integration": {
  "summary": "Wire the thermostat to the MS/TP trunk and set MAC address, baud and device ID in its advanced system settings. Turn on BACnet BMS Occ at the thermostat if the BMS should drive occupancy through BMS_OCC, and BACnet Config Write only if the BMS must change installer settings. Write the baseline occupied/unoccupied setpoints for permanent changes; writes to HEAT_SP/COOL_SP are temporary holds.",
  "minimum_points": [
   {
    "ref": "MV 400",
    "name": "USER_MODE",
    "why": "Mode command: off, heat, cool, auto, emergency heat"
   },
   {
    "ref": "BV 405",
    "name": "BMS_OCC",
    "why": "BMS occupancy; needs BACnet BMS Occ enabled locally"
   },
   {
    "ref": "AV 400",
    "name": "OCC_HT_SP",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "AV 401",
    "name": "OCC_CL_SP",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "MV 404",
    "name": "OCC_FAN",
    "why": "Occupied fan mode: auto or on"
   },
   {
    "ref": "MV 300",
    "name": "CURRENT_MODE",
    "why": "Mode now running: off, heat or cool"
   },
   {
    "ref": "AV 104",
    "name": "SP_TEMP_CTRL",
    "why": "Space temperature used for control"
   },
   {
    "ref": "BV 205",
    "name": "G_OUT",
    "why": "Fan output status"
   },
   {
    "ref": "BV 911",
    "name": "OD_TEMP_FAIL",
    "why": "Outdoor sensor failure"
   }
  ],
  "enable": "BACNET BMS OCC (set at the thermostat screen) enables BACnet occupancy control through BMS_OCC (BV:405); setting it to YES forces the thermostat to non-programmable mode and turns off a remote sensor set to Occupancy. BACNET CONFIG WRITE (also local) allows writes to all GATED_WRITE points. USER_MODE (MSV:400) sets the system mode.",
  "heartbeat": "No communication-loss timeout is described. Network general purpose outputs return to inactive if not rewritten within the General Purpose Output Timeout (MSV:508: 2 min, 20 min, 1 h or unlimited).",
  "remote_sensors": "Network Space Temperature (AV:103) and Network Space Humidity (AV:105) are writable, with enables Network Space Temp Enable (BV:407) and Network Space Hum Enable (BV:408). The guide gives no refresh time for them. Read SP_TEMP_CTRL (AV:104) and SP_HUM_CTRL (AV:106) for the values in use.",
  "setup": [
   "MS/TP on terminals A+ and B-; do not terminate the shield at the thermostat. 22 or 24 AWG shielded twisted pair, 2000 ft per segment.",
   "Baud 9600, 19200, 38400, 76800 (default) or 115200; MAC address 1-127 (default 1); Max Masters default 127.",
   "Device ID defaults to Carrier's BACnet identifier 16 plus the last 4 digits of the serial number; device object name up to 16 characters.",
   "BACnet UTC offset is set at the thermostat (-13 to +13 h)."
  ],
  "gotchas": [
   "Writing HEAT_SP (AV:409) or COOL_SP (AV:410) puts the thermostat in a temporary hold until Max Temperature Hold Time (AV:502, default 2 h) expires; write AV:400-403 for lasting changes.",
   "GATED_WRITE points are rejected unless BACnet Config Write is enabled; the guide says the two gate settings are only accessible from the local screen.",
   "BMS occupancy can't be used with programmable mode or a remote occupancy sensor at the same time."
  ]
 },
