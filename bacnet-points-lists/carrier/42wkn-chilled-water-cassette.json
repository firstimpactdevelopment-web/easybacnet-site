 "default_device_instance": "315000 + MAC address",
 "access_inferred": false,
 "notes": [
  "Objects are printed as 'Analog Value #0' style references; the number after # is the object instance.",
  "Mode, fan speed and occupancy points are analog values whose numeric codes are given in the Value column (e.g. 0-Fan only, 1-Cool, 2-Heat, 3-Auto); those codes are kept in the states field.",
  "For analog objects the printed range is kept in the description; temperatures are shown in °F with °C in brackets.",
  "AV 113 ModbusBaudRate is marked not in use."
