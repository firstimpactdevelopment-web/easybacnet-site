 "integration": {
  "summary": "Enable BACnet in HMI Configuration > BACnet Configuration and pick IP or MS/TP as the data link, then set the unit's machine control method to Network. The BMS then starts and stops the unit (BV 4), writes demand limit and setpoints, and reads capacity, control mode and alarm state.",
  "minimum_points": [
   {
    "ref": "BV 4",
    "name": "A_UNIT_CHIL_S_S",
    "why": "Network start/stop command"
   },
   {
    "ref": "AV 2",
    "name": "A_UNIT_DEM_LIM",
    "why": "Demand limit command (%)"
   },
   {
    "ref": "AV 5",
    "name": "A_UNIT_CTRL_PNT",
    "why": "Control point"
   },
   {
    "ref": "BV 6",
    "name": "A_UNIT_EMSTOP",
    "why": "Emergency stop command"
   },
   {
    "ref": "AV 8",
    "name": "A_UNIT_STAT",
    "why": "Control mode / unit status"
   },
   {
    "ref": "AV 3",
    "name": "A_UNIT_CAP_T",
    "why": "Percent total capacity"
   },
   {
    "ref": "AV 1008",
    "name": "A_UNIT_SUPPLY_T",
    "why": "Supply air temperature"
   },
   {
    "ref": "MV 1",
    "name": "A_UNIT_ALM",
    "why": "Alarm state"
   }
  ],
  "enable": "Set the machine control method to Network; the unit then follows CCN, BACnet (if enabled) or Modbus (if enabled) commands and ignores the remote contacts. In Local or Remote control it ignores network commands except Emergency Stop.",
  "heartbeat": null,
  "remote_sensors": "Return air (AV 1010), supply air (AV 1008), outdoor air (AV 1003) and space temperature (AV 2007) are listed as writable, so they can be supplied from the network when the unit is configured to use them.",
  "setup": [
   "BACnet IP uses the ETH0 (J5) port; BACnet MS/TP uses the RS-485 (J8) port.",
   "Path: Configuration Menu > HMI Configuration > BACnet Configuration > BACnet Data Link Layer > IP or MS/TP."
  ],
  "gotchas": [
   "Alarm routing is not supported via BACnet; poll MV 1 (alarm state) instead.",
   "Network commands are ignored unless the control method is Network."
  ]
 },
