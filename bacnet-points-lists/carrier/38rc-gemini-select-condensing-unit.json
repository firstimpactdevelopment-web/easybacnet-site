 "equipment_type": "Condensing unit (split system) controller",
 "applies_to": "Carrier Gemini Select 38RCS025-050 and 38RCD025-130 commercial air-cooled condensing units.",
 "summary": "The 38RC controller has an Ethernet port (BACnet IP, Modbus TCP) and an RS-485 port (BACnet MS/TP, Modbus RTU); BACnet is turned on and the data link chosen in the HMI Configuration > BACnet Configuration menu. The network points list has 136 objects: unit start/stop, emergency stop, demand limit and cooling setpoints, circuit pressures and temperatures, compressor relays and feedback, run hours and starts, plus points for a second air handler (AHU2) on dual-circuit units.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access is from the ACCESS column (RO / RW). The table has no units column; temperatures and pressures follow the controller's unit setting.",
  "Points ending in 2 or labelled AHU2 (e.g. AV 2923 Control Point AHU2) apply to units serving two air handlers.",
  "Multistate values (MV 1, 3, 5, 7, 8) are printed with low/high limits only, no state texts.",
  "Alarm routing is not supported over BACnet according to the manual."
 ],
