 "equipment_type": "Water-cooled centrifugal chiller controller",
 "applies_to": "Carrier AquaEdge 19XR two-stage semi-hermetic centrifugal chillers with PIC 5 controls.",
 "summary": "The PIC 5 controller on the 19XR talks BACnet IP over its Ethernet port once the optional BACnet dongle is fitted and BACnet is enabled in the CONNECT menu. It exposes up to 500 AV and BV objects named <CCN table>_<point>; the published table lists 159. Commands use paired _rd and _wr objects, with the _wr copies marked commandable; setpoints in the SETPOINT table are read/write.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "default_device_instance": 1600001,
 "notes": [
  "This is the older PIC 5 controller generation; the AquaEdge 19DV and 23XRV files cover the PIC6 controller.",
  "BACnet needs the blue BACnet dongle plugged into the PIC 5 board; no BACnet MS/TP option is described.",
  "Objects the table marks CMD are mapped as commandable (C); other RW objects as writable (W).",
  "No units column; values are metric unless BACnet Metric Unit is set to NO.",
  "Several AV objects carry coded values (control mode, valve status, surge region); the codes are in the states field."
 ],
 "source": {
  "title": "AquaEdge 19XR Two-Stage High-Efficiency Semi-Hermetic Centrifugal Liquid Chillers with PIC 5 Controls - Controls Operation and Troubleshooting (Appendix D)",
  "doc_number": "19XR-CLT-3T",
  "revision_date": "2016-11",
  "url": "https://www.shareddocs.com/hvac/docs/1005/Public/05/19XR-CLT-3T.pdf"
 },
 "integration": {
  "summary": "Fit the BACnet dongle, set BACnet Enable, network number and identifier in the CONNECT menu, and put the chiller in NETWORK control mode. It then starts when both BV 40 start/stop and BV 42 occupancy are true; write control point and demand limit through the _wr objects and read status, water temperatures and alarms.",
  "minimum_points": [
   {
    "ref": "BV 40",
    "name": "GENUNIT_CHIL_S_S_wr",
    "why": "Network start/stop command"
   },
   {
    "ref": "BV 42",
    "name": "GENUNIT_CHIL_OCC_wr",
    "why": "Network occupied command"
   },
   {
    "ref": "BV 41",
    "name": "GENUNIT_EMSTOP_wr",
    "why": "Emergency stop command"
   },
   {
    "ref": "AV 114",
    "name": "GENUNIT_CTRL_PNT_wr",
    "why": "Control point command"
   },
   {
    "ref": "AV 115",
    "name": "GENUNIT_DEM_LIM_wr",
    "why": "Demand limit command"
   },
   {
    "ref": "AV 1",
    "name": "GENUNIT_ctl_mode",
    "why": "Control mode: Local, Network, Remote, Local Sched"
   },
   {
    "ref": "AV 7",
    "name": "GENUNIT_ch_state",
    "why": "Chiller status code"
   },
   {
    "ref": "AV 9",
    "name": "TEMP_LCW",
    "why": "Leaving chilled water temperature"
   },
   {
    "ref": "AV 8",
    "name": "TEMP_ECW",
    "why": "Entering chilled water temperature"
   },
   {
    "ref": "AV 68",
    "name": "ALARMRST_alarm_1",
    "why": "Current alarm 1"
   }
  ],
  "enable": "In NETWORK control mode the chiller starts and stops from the CHIL_S_S and CHIL_OCC points written over the network (both must be true). Use EMSTOP or the HMI to shut it down. A STOP OVERRIDE point in GENUNIT, if enabled, prevents starting.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet settings are in Main Menu > Configuration Menu > CONNECT (Advanced User password): BACnet Enable, BACnet Metric Unit, BACnet Network, BACnet Identifier.",
   "Defaults: BACnet identifier 1600001, BACnet network 1601; change both if more than one Carrier chiller is on the network.",
   "Changing a BACnet parameter reboots the board after about a minute; changing the IP address in SETUP needs a manual reboot or power cycle.",
   "Set the unit IP address, mask and gateway on the Setup > Network screen (DHCP can be enabled there).",
   "An IP router between the chiller and the BMS stops it responding; check the dongle shows Yes under Inputs Status."
  ],
  "gotchas": [
   "Write the _wr objects; the _rd objects only echo the current value.",
   "Free cooling start (BV 43) is ignored while the chiller is running.",
   "Object names carry the CCN table prefix (GENUNIT_, TEMP_, SETPOINT_); some descriptions are internal labels such as 'Jbus Current Alarm'."
  ]
 },
