 "equipment_type": "Humidifier controller",
 "applies_to": "Vapor-logic version 6 controller used on DriSteem GTS, STS, XT, Vaporstream, HPS, LMH, Ultra-sorb XV and evaporative (WM) humidification systems.",
 "summary": "Vapor-logic 6 is the DriSteem humidifier control board. Modbus is standard; BACnet MS/TP (terminal P7) or BACnet/IP (Ethernet) is an option enabled with an unlock code matched to the serial number. One shared object table covers all humidifier types, so many objects only apply to a specific product (marked GTS, XT, HPS, LMH, WM, XV or STS in the name).",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 255,
 "access_inferred": false,
 "notes": [
  "Object names prefixed with GTS:, HPS:, XT:, WM:, LMH:, STS: or XV: only apply to that humidifier type; where two types share an instance the names are joined with ' / '.",
  "BACnet must be purchased/unlocked: Setup > Tank Setup > Communication > BACnet, enter the unlock code, choose the comm channel, then cycle power.",
  "Units follow the controller's I-P or SI setting (e.g. lbs/hr or kg/h, °F or °C, psi or bar).",
  "Fault and message BVs (BV 5-70) are listed RW in the manual; see the controller's alarm and diagnostics tables for their meaning."
 ],
 "source": {
  "title": "Vapor-logic Version 6 Installation, Operation, and Maintenance Manual (Table 75-1 Interoperability variable and object names)",
  "doc_number": "VL6-IOM-EN-REVH-0225",
  "revision_date": "2025-02 (Rev H)",
  "url": "https://d2tsmyh31fn7w8.cloudfront.net/public-documents/docs/iom/vapor-logic/VL6-IOM-EN.pdf"
 },
 "integration": {
  "summary": "Unlock and enable BACnet on the keypad, set the device instance and MS/TP station or IP settings, and set 'BACnet controlled' to Yes under Control via BACnet if the BMS will send the demand. Then write the demand to AV 9 (percent) or AV 8 (mass), or let the controller run its own PID on SpaceRHSetPoint (AV 5), and use MSV 1 RunMode for auto/standby/drain.",
  "minimum_points": [
   {
    "ref": "MV 1",
    "name": "RunMode",
    "why": "Run mode: auto, local/system standby, manual drain"
   },
   {
    "ref": "AV 9",
    "name": "FieldbusDemandPcnt",
    "why": "Demand from the BMS in % of capacity"
   },
   {
    "ref": "AV 5",
    "name": "SpaceRHSetPoint",
    "why": "Space RH setpoint when Vapor-logic does the control"
   },
   {
    "ref": "BV 4",
    "name": "ClearAllActiveAlarms",
    "why": "Write 1 to clear all active faults"
   },
   {
    "ref": "AI 1",
    "name": "SpaceRH",
    "why": "Space RH measured by the humidifier"
   },
   {
    "ref": "AV 2",
    "name": "SteamOutputPercent",
    "why": "Estimated steam output %"
   },
   {
    "ref": "AI 5",
    "name": "SteamDemandPercent",
    "why": "Demand the unit is acting on, % of capacity"
   },
   {
    "ref": "BV 60",
    "name": "MainEnableOpen",
    "why": "Main enable input open (demand ignored)"
   },
   {
    "ref": "BV 3",
    "name": "ActiveManualClearAlarmsExist",
    "why": "A manual-clear alarm exists"
   }
  ],
  "enable": "The humidifier must have its Main Enable input (P20) closed or jumpered (J402 shunt), otherwise the demand is ignored (message BV 60). RunMode (MSV 1) switches between Auto, Local standby, System standby and Manual drain; to let BACnet supply the demand, set Setup > Control via BACnet > BACnet controlled = Yes (default No).",
  "heartbeat": null,
  "remote_sensors": "No BMS-writable sensor values are listed: space RH, dew point and duct RH are read-only AIs from the controller's own transmitters. The BMS can instead send a demand (AV 8 FieldbusDemandMass or AV 9 FieldbusDemandPcnt, write-only) and setpoints (AV 5 space RH, AV 6 dew point, AV 7 duct high limit).",
  "setup": [
   "Device instance defaults to 255 (0-4194303); MS/TP station 1, Max masters 127, Max info frames 1.",
   "BACnet comm channel defaults to 19200 MS/TP; options run from BACnet IP up to 76800 MS/TP; MS/TP wiring lands on terminal P7.",
   "BACnet/IP uses UDP 47808 by default (1024-65535); default IP 192.168.1.195/24, gateway 192.168.1.1, DHCP off.",
   "Device instance and comm settings are set from the keypad/display; some items are not available in the web interface."
  ],
  "gotchas": [
   "FieldbusDemandMass/Pcnt are write-only; a request above capacity runs the unit at 100 %.",
   "Many objects only apply to one humidifier type; unused ones may read 0.",
   "WaterUntilADS/WaterUntilService scale differently on Modbus (x100) than on BACnet (1 lb or kg).",
   "Retrofitting BACnet needs a purchased unlock code tied to the unit serial number."
  ]
 },
