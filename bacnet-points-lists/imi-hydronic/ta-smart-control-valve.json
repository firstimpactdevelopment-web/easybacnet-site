 ],
 "equipment_type": "Control valve (pressure-independent, flow and energy measuring)",
 "applies_to": "IMI TA-Smart, TA-Smart-Dp and TA-Smart fail-safe 2-way control valves DN15-150 with ultrasonic flow measurement, BACnet MS/TP or BACnet IP versions.",
 "summary": "TA-Smart is a 2-way control valve with an integrated ultrasonic flow meter and supply/return temperature sensors, so it can control flow, power, differential pressure (Dp version) or position and meter energy. The MS/TP and IP versions publish the same 140 objects: valve data, setpoints and measurements in two selectable unit sets, regime limits, temperature limitation, overrides, status words, error/event logs and integer energy counters.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Taken from the TA-Smart BACnet MS/TP PICS (07.2026); the TA-Smart BACnet IP PICS (https://cdn.tessa.imihy.eimed-project.de/673551/TA-Smart_BACnet_IP_Protocol_Implementation.pdf) prints the identical object table.",
  "Most values come in two unit sets: _unit1/_unit2 objects use the units chosen in MSV 5-10, 15-16 and 18-19 (for example FlowUnit1 = m3/h by default, FlowUnit2 = GPM).",
  "The error and event logs are printed as ranges: AV 50 LastErrors[1] ... AV 59 LastErrors[10] and AV 60 LastEvents[1] ... AV 69 LastEvents[10]; only the first and last of each are listed here.",
  "Footnotes: Dp objects only on TA-Smart-Dp; temperature limitation objects not on the Dp; others need firmware 8.0.0 to 13.0.0 (markers removed from names).",
  "MSI 6-9 are not printed in the table."
 ],
 "source": {
  "title": "TA-Smart BACnet MS/TP Protocol Implementation Conformance Statement - PICS",
  "doc_number": null,
  "revision_date": "07.2026",
  "url": "https://cdn.tessa.imihy.eimed-project.de/673548/TA-Smart_BACnet_MS_TP_Protocol_Implementation.pdf"
 },
 "integration": {
  "summary": "Set ControlSource (MSV 4) to Bus and choose the ControlMode (MSV 2), then write RelativeSetpoint AV 23 as a percentage of the regime maximum. Read measured flow, temperatures, power and energy, and watch StatusSummary MSI 10. Enable the cyclic timeout if the valve should fall back when the BMS goes quiet.",
  "minimum_points": [
   {
    "ref": "MV 4",
    "name": "ControlSource",
    "why": "Must be 2 = Bus for BMS control"
   },
   {
    "ref": "MV 2",
    "name": "ControlMode",
    "why": "1 flow, 2 power, 3 Dp, 4 position"
   },
   {
    "ref": "AV 23",
    "name": "RelativeSetpoint",
    "why": "Setpoint, % of max for the regime"
   },
   {
    "ref": "MV 17",
    "name": "CyclicControlTimeoutEnabled",
    "why": "Fallback timeout: 2 = active"
   },
   {
    "ref": "AV 43",
    "name": "CyclicControlTimeout",
    "why": "Fallback delay, minutes"
   },
   {
    "ref": "AI 20",
    "name": "MeasuredFlow_unit1",
    "why": "Measured flow (FlowUnit1)"
   },
   {
    "ref": "AI 22",
    "name": "MeasuredSupplyTemp_degC",
    "why": "Supply temperature, °C"
   },
   {
    "ref": "AI 24",
    "name": "MeasuredReturnTemp_degC",
    "why": "Return temperature, °C"
   },
   {
    "ref": "AI 29",
    "name": "MeasuredPower_unit1",
    "why": "Measured power (PowerUnit1)"
   },
   {
    "ref": "MI 10",
    "name": "StatusSummary",
    "why": "1 ok, 2 error, 3 warning"
   }
  ],
  "enable": "The valve takes AV 23 only when ControlSource (MSV 4) is Bus; with Analog the bus is monitoring only.",
  "heartbeat": "With CyclicControlTimeoutEnabled (MSV 17) active, the valve starts its fallback (moves to a user-set position) when no bus or analog control signal arrives within CyclicControlTimeout (AV 43, 1-1440 min, default 20).",
  "remote_sensors": null,
  "setup": [
   "MS/TP baud Auto, 9600 (default), 19200-115200.",
   "Device instance defaults to a value computed from the serial number; Object_Name, Location and Max_Master are writable.",
   "The IP version supports BACnet/IP and foreign-device registration."
  ],
  "gotchas": [
   "A bus override (MSV 13 OverrideType) returns to normal after 3 hours by default.",
   "CurrentRegime (MSV 12) can only be written when RegimeSwitching is Bus.",
   "Check the unit objects (MSV 5-10) before scaling _unit1/_unit2 values."
  ]
 },
