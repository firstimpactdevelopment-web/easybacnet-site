 "equipment_type": "Variable frequency drive",
 "applies_to": "TECO-Westinghouse F510 fan and pump inverters using the built-in RS-485 port in BACnet MS/TP mode.",
 "summary": "The F510 is a fan and pump inverter with BACnet MS/TP built into its RS-485 port; no option card is needed. The object list is fixed: analog inputs report terminals, frequency, current, fault code and motor data; analog outputs carry the frequency command, preset speeds, command sources, limits and ramps; binary objects give run, direction, fault, terminal and relay states and the run and direction commands.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "0.14 (Firmware_Revision in the device object table)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Ranges printed in the object tables are given in brackets in each description.",
  "Binary state text is given as printed (for example Close / Open); the tables do not say which value is 0 and which is 1.",
  "The device object prints object name and vendor name 'TECO F510', vendor ID 461, Max_Master 127, Max_Info_Frames 1.",
  "Supported services listed: ReadProperty, WriteProperty and Who-Is."
 ],
 "source": {
  "title": "F510 Communication Addendum (Modbus RTU/ASCII, BACnet, Metasys N2, Profibus)",
  "doc_number": "TECO-F510-AC001",
  "revision_date": "Ver01 2015-03",
  "url": "https://www.tecowestinghouse.com/PDF/F510_comm_addendum.pdf"
 },
 "integration": {
  "summary": "Wire the drive's RS-485 port to the MS/TP trunk and select BACnet as the drive's communication mode. Set the run and frequency command sources to communication (AO 23 / AO 26 mirror those parameters), then write the speed to AO 0 and start/stop with BV 0. Read BI 0, AI 4, AI 5 and BI 2 / AI 2 for status and faults.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "RUN/STOP",
    "why": "Run/stop command"
   },
   {
    "ref": "AO 0",
    "name": "Set frequency",
    "why": "Frequency command, Hz"
   },
   {
    "ref": "BI 0",
    "name": "Run/Stop",
    "why": "Running status"
   },
   {
    "ref": "AI 4",
    "name": "Frequency",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AI 5",
    "name": "Current",
    "why": "Output current, A"
   },
   {
    "ref": "BI 2",
    "name": "status",
    "why": "Drive fault (OK / Fault)"
   },
   {
    "ref": "AI 2",
    "name": "Error code",
    "why": "Latest fault code"
   }
  ],
  "enable": "Set the main run command source (parameter 00-02, also AO 23) and the main frequency command source (00-05, also AO 26) to communication. The addendum's Profibus section gives these as 00-02 = 2 and 00-05 = 3.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Station number, baud rate and BACnet mode selection are drive parameters; the object list only reads them back (AI 12-15).",
   "Max_Master is fixed at 127 and Max_Info_Frames at 1."
  ],
  "gotchas": [
   "AO 3, AO 23-30 and AV 0-2 are drive parameters; avoid cyclic writes.",
   "AO 1 and AO 2 are read-only although typed as Analog Output; they report the terminal output voltage."
  ]
 },
