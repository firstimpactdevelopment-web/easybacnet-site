    "why": "Active zone temperature"
   },
   {
    "ref": "AV 6",
    "name": "AirFlow",
    "why": "Air flow, CFM"
   },
   {
    "ref": "AV 8",
    "name": "Demand",
    "why": "Zone demand, %"
   },
   {
    "ref": "AV 9",
    "name": "DampPos",
    "why": "Damper position, %"
   },
   {
    "ref": "BV 32",
    "name": "FanStatus",
    "why": "Fan status input"
   },
   {
    "ref": "MV 1",
    "name": "DampStat",
    "why": "Damper OK / stalled"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": "Zone temperature (AV 1), outside temperature (AV 7), CO2 (AV 104), supply and slab temperature are writable network variables; AV 116 still shows the local sensor.",
  "setup": [
   "Net port and RJ45 port baud (MV 13/14, default 57600), parity and stop bits are set by objects.",
   "BV 29 selects °C or °F for BACnet temperatures."
  ],
  "gotchas": [
   "Output functions (MV 2-6) decide what AV 10-14 mean.",
   "Output override values (AV 62-66) only act when the matching enable BV 15-19 is on."
  ]
 },
