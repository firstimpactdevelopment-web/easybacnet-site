{
 "manufacturer": "Thermal Solutions",
 "manufacturer_slug": "thermal-solutions",
 "model": "Fireye YB110 flame safeguard (Universal Gateway ProtoAir)",
 "model_slug": "fireye-yb110-universal-gateway-protoair",
 "aliases": [
  "YB110",
  "Fireye YB110",
  "BurnerPRO",
  "Fireye",
  "ProtoAir FPA-W44",
  "Universal Gateway 106417-04"
 ],
 "equipment_type": "Boiler flame safeguard (Fireye YB110) via ProtoAir gateway",
 "applies_to": "Thermal Solutions and Bryan boilers with a Fireye YB110 flame safeguard, connected to the Universal Gateway (ProtoAir FPA-W44).",
 "summary": "The ProtoAir Universal Gateway reads a Fireye YB110 flame safeguard over Modbus and serves it on BACnet IP or BACnet MS/TP. The profile is monitoring only apart from the Com Status object: burner status and message numbers, flame signal, run minutes, cycles, a 10-entry lockout history, and binary objects for the safety relay, valves, ignition, blower, limits and interlocks (water level, oil and gas pressure, air flow).",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "All objects are AI or BI except BV 1 Com Status, which is listed as read; the table has no read/write column.",
  "The lockout history repeats message, module, burner hours and burner cycles for lockouts 1-10 (AI 11-50).",
  "Message and status numbers are Fireye codes; the manual gives no code tables."
 ],
 "source": {
  "title": "Universal Gateway Instruction Manual (ProtoAir): BACnet MS/TP, BACnet IP, N2, Modbus",
  "doc_number": "PN 106417-04 Rev A",
  "revision_date": "2024-05",
  "url": "https://s3-us-west-2.amazonaws.com/catsy.782/Universal+Gateway+ProtoAir+BACnet+Instruction+Manual.pdf"
 },
 "integration": {
  "summary": "Add the YB110 as a profile in the ProtoAir Web Configurator with a unique Node-ID and discover it at 50000 + Node-ID. It is a monitoring profile: read burner status, message number, flame signal, the alarm output and the lockout count and history.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "name": "Status",
    "why": "Burner status code"
   },
   {
    "ref": "AI 2",
    "name": "Msgn",
    "why": "Current Fireye message number"
   },
   {
    "ref": "AI 5",
    "name": "Flame",
    "why": "Flame signal"
   },
   {
    "ref": "BI 20",
    "name": "Main_Valve_Out",
    "why": "Main fuel valve energized"
   },
   {
    "ref": "BI 26",
    "name": "Alarm_Out",
    "why": "Alarm output"
   },
   {
    "ref": "AI 11",
    "name": "Lockout1_Msg",
    "why": "Most recent lockout message"
   },
   {
    "ref": "BV 1",
    "name": "Com Status",
    "why": "Modbus link between ProtoAir and the YB110"
   }
  ],
  "enable": "None: the YB110 profile has no command objects.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance = Node_Offset (default 50,000) + the controller's Node-ID (1-255), so Node-ID 1 gives 50001.",
   "ProtoAir default IP address is 192.168.1.24, mask 255.255.255.0.",
   "Add each controller as a profile in the ProtoAir Web Configurator and give it a unique Node-ID."
  ],
  "gotchas": [
   "Decode Status, Msgn and lockout messages with the Fireye YB110 documentation."
  ]
 },
