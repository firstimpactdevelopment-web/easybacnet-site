    "name": "Supply Temp",
    "why": "Supply water temperature"
   },
   {
    "ref": "AI 6",
    "name": "Firing Rate",
    "why": "Firing rate"
   },
   {
    "ref": "AI 10",
    "name": "Flame Signal",
    "why": "Flame signal; 128 = flame"
   },
   {
    "ref": "AI 20",
    "name": "Error Code",
    "why": "Error code; see the manual notes"
   }
  ],
  "enable": "AV 13 Boiler Operation: 0 = boiler off & pump off, 1 = boiler on & pump auto, 2 = boiler off & pump on, 3 = boiler on & pump on. AV 11/12 are the CH and DHW setpoints; AV 14-19 set the outdoor reset curve and night setback.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "ProtoNode FPC-N34 (BACnet MS/TP, BACnet IP, Metasys N2, Modbus TCP) or FPC-N35 (LonWorks).",
   "Boiler side: Modbus RTU, 9600 baud, 1 stop bit, no parity, 8 data bits; Node-ID 1-255 per boiler. Mixed ENVI/LOVE/NURO networks must run at 9600.",
   "BACnet device instance = Node_Offset (default 50,000) + Modbus Node-ID."
  ],
  "gotchas": [
   "Access is inferred from the N2 types.",
   "Error code meanings differ between ENVI firmware versions (01BD/BD71/49A7 vs 6999/79F2); see the notes under the table.",
   "The ENVI does not bias the RS-485 bus; the ProtoNode must provide bias."
  ]
 },
