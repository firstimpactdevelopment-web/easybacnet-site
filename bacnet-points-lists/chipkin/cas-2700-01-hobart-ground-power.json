 "equipment_type": "Other equipment (ground power unit via BACnet gateway)",
 "applies_to": "Hobart Ground Power (HGP) controllers read by the Chipkin CAS-2700-01 gateway.",
 "summary": "The Chipkin Hobart gateway polls a Hobart Ground Power controller over serial and serves its data on BACnet IP, Modbus and a web page. All 75 objects are read-only Analog Inputs: the raw controller registers (C, D and E blocks: settings, time stamps, status words, phase volts and amps, kW, kWh, frequency) plus seven calculated values such as kVA, kW, average volts and amps and two fault flags.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 389001,
 "access_inferred": true,
 "notes": [
  "From section 6.3 BACnet Objects. AI 0-67 mirror the controller registers in order; AI 71-81 are calculated values (instances as printed, with gaps).",
  "The BACnet list gives no units. The Modbus map in the same manual lists engineering units for the same values (volts, amps, kW, kWh, Hz).",
  "Descriptions for AI 71-81 come from the Modbus map notes.",
  "There is no access column; all objects are Analog Inputs and read-only."
 ],
 "source": {
  "title": "CAS-2700-01 Hobart Ground Power Gateway Manual",
  "doc_number": "CAS-2700-01",
  "revision_date": null,
  "url": "https://cdn.chipkin.com/assets/uploads/2017/mar/09-14-31-31_CAS-2700-01%20-%20Hobart%20to%20Modbus%20and%20BACnet%20Gateway.pdf"
 },
 "integration": {
  "summary": "Give the gateway a unique device instance and an IP on the BAS subnet, then read output volts, amps, kW and the fault flags; the gateway is monitoring only.",
  "minimum_points": [
   {
    "ref": "AI 41",
    "name": "D15_OUTPUT STATUS",
    "why": "Output status (controller code)"
   },
   {
    "ref": "AI 73",
    "name": "kW being delivered",
    "why": "Output real power, kW (from E16)"
   },
   {
    "ref": "AI 71",
    "name": "kVA being delivered",
    "why": "Output apparent power, kVA (calculated)"
   },
   {
    "ref": "AI 75",
    "name": "Average Output Voltage",
    "why": "Mean of phase volts E01-E03"
   },
   {
    "ref": "AI 79",
    "name": "Average Output Current",
    "why": "Mean of output phase amps"
   },
   {
    "ref": "AI 63",
    "name": "E17_OUTPUT FREQUENCY",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AI 62",
    "name": "E16_KILOWATT HOURS",
    "why": "Energy delivered, kWh"
   },
   {
    "ref": "AI 77",
    "name": "fault 1",
    "why": "1 = ADV state above 86 with no fault above 6"
   },
   {
    "ref": "AI 78",
    "name": "fault 2",
    "why": "1 = fault code above 6 present"
   }
  ],
  "enable": null,
  "heartbeat": "If the gateway loses the Hobart controller or a value cannot be read, Out_Of_Service goes true after the timeout and Present_Value keeps the last good value.",
  "remote_sensors": null,
  "setup": [
   "Default BACnet device instance 389001 (configurable); BACnet IP.",
   "BACnet traffic does not cross subnets without a BBMD; easiest is to put the gateway on the BAS subnet."
  ],
  "gotchas": [
   "Watch Out_Of_Service to spot lost communication; the value itself freezes.",
   "Several objects are raw multi-word registers (e.g. total kW accumulator split over C06-C09); use the calculated objects where possible."
  ]
 },
