{
 "manufacturer": "Chipkin Automation Systems",
 "manufacturer_slug": "chipkin",
 "model": "CAS-2700-24 SMA Gateway - Sunny Island objects",
 "short_model": "CAS-2700-24 SMA Sunny Island",
 "short_manufacturer": "Chipkin",
 "model_slug": "cas-2700-24-sma-sunny-island",
 "aliases": [
  "SMA Sunny Island BACnet",
  "Sunny Island battery inverter BACnet",
  "CAS-2700-24",
  "Chipkin SMA gateway"
 ],
 "equipment_type": "Battery inverter (off-grid / backup) via BACnet gateway",
 "applies_to": "SMA Sunny Island battery inverters (with slave units and Sunny Island Chargers) on a Sunny WebBox polled by the Chipkin CAS-2700-24 gateway.",
 "summary": "For an SMA Sunny Island the CAS-2700-24 gateway serves 120 read-only Analog Inputs on BACnet IP, named with SMA's channel codes. They cover battery, generator, external/grid and inverter values for the master and up to three slave units, relay states and Sunny Island Charger PV values.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 389001,
 "access_inferred": true,
 "notes": [
  "All objects are Analog Inputs; the manual gives names only, with no units or descriptions.",
  "Each further SMA device added to the gateway is offset by 100 (second device starts at AI 101, third at AI 201).",
  "The list is what the gateway exposes with its default configuration; the gateway polls the devices through one SMA Sunny WebBox.",
  "Access is inferred: Analog Inputs are read-only.",
  "This list runs to AI 120 but the guide offsets each further device by only 100, so a second device would overlap; check instances on site."
 ],
 "source": {
  "title": "CAS-2700-24 SMA Gateway Manual (Modbus RTU and TCP / BACnet / HTML Gateway)",
  "doc_number": "CAS-2700-24",
  "revision_date": "Doc Rev 0, 12 Feb 2014",
  "url": "https://cdn.chipkin.com/assets/uploads/2017/mar/09-14-31-59_CAS-2700-24%20-%20SMA%20to%20Modbus_RTU%20and%20TCP_%20BACnet%20and%20HTML%20Gateway%20Manual.pdf"
 },
 "integration": {
  "summary": "Add the WebBox and each SMA device on the gateway's configuration page, then read the Analog Inputs; the gateway is monitoring only.",
  "minimum_points": [
   {
    "ref": "AI 82",
    "name": "OpStt",
    "why": "Operating state (OpStt)"
   },
   {
    "ref": "AI 6",
    "name": "BatSoc",
    "why": "Battery state of charge (BatSoc)"
   },
   {
    "ref": "AI 9",
    "name": "BatVtg",
    "why": "Battery voltage"
   },
   {
    "ref": "AI 8",
    "name": "BatTmp",
    "why": "Battery temperature"
   },
   {
    "ref": "AI 55",
    "name": "GnStt",
    "why": "Generator status (GnStt)"
   },
   {
    "ref": "AI 18",
    "name": "Error",
    "why": "Sunny Island error status"
   }
  ],
  "enable": null,
  "heartbeat": "If the gateway loses a device or a value can't be read, the object's Out_Of_Service is set true and the last good value stays in Present_Value.",
  "remote_sensors": null,
  "setup": [
   "Gateway default BACnet device instance 389001, UDP port 47808; give each gateway a unique instance.",
   "Enter the Sunny WebBox IP address and pick the device type (Invertor, SensorBox or Sunny Island) for each device in the gateway's web page.",
   "Only one Sunny WebBox per gateway."
  ],
  "gotchas": [
   "Watch Out_Of_Service rather than the value to spot lost data.",
   "Names are SMA channel codes; see the SMA documentation for scaling and units."
  ]
 },
