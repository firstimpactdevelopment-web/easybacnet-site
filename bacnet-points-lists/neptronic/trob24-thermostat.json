    "why": "User mode: auto, heating, cooling, off"
   },
   {
    "ref": "AV 7",
    "name": "TempSetPointDay",
    "why": "Day temperature setpoint"
   },
   {
    "ref": "MV 9",
    "name": "NightSetBack",
    "why": "Actual state: day, night, override"
   },
   {
    "ref": "AV 1",
    "name": "ControlTemp",
    "why": "Temperature used for control"
   },
   {
