 "model": "SKDESC-xB",
 "model_slug": "skdesc-xb",
 "aliases": [
  "SKDESC",
  "SKDESCxB",
  "ESCJx",
  "ESCMx",
  "Electronic Steam Controller"
 ],
 "equipment_type": "Steam humidifier valve controller",
 "applies_to": "Neptronic SKDESC-xB electronic controllers for steam-to-steam / direct steam injection humidifier valves (ESCJx jacketed, ESCMx models).",
 "summary": "The SKDESC-xB is the electronic controller used on Neptronic steam injection humidifier valves. It communicates over BACnet MS/TP only and exposes setpoints, room and duct RH, PI tuning, high limit, network fallback settings, inputs and relay states.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "153000 + MAC address (153000 by default, MAC 0)",
 "access_inferred": false,
 "notes": [
  "Points marked 'object available as per system configuration' depend on the unit options.",
  "Empty 'W?' entries in the guide are treated as read-only."
 ],
 "source": {
  "title": "SKDESC-xB Series Electronic Steam Controller BACnet Communication Module User Guide",
  "doc_number": "SKDESCXB-BACnet-250905-EUA",
  "revision_date": "2025-09-05",
  "url": "https://www.neptronic.com/Humidifiers/PDF/2025/SKDESCXB-BACnet-250905-EUA.pdf"
 },
 "integration": {
  "summary": "Set MSV 2 Control Mode to Network to drive the valve from the BMS, or feed room RH to AV 2 (after turning on BV 14 NetworkRoomRH) with the internal setpoint AV 1. Configure the network fallback timeout and fallback setpoint, and switch the system with BV 1.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "PowerStatus",
    "why": "System power on/off"
   },
   {
    "ref": "MV 2",
    "name": "ControlMode",
    "why": "Control mode: External, Internal or Network"
   },
   {
    "ref": "AV 2",
    "name": "RoomRH",
    "why": "Room RH (writable when BV 14 = On)"
   },
   {
    "ref": "BV 14",
    "name": "NetworkRoomRH",
    "why": "Enable network room RH"
   },
   {
    "ref": "AV 1",
    "name": "InternalStpnt",
    "why": "Internal RH setpoint"
   },
   {
    "ref": "AV 4",
    "name": "SystemDemand",
    "why": "System demand"
   },
   {
    "ref": "AV 30",
    "name": "FallbackTimeout",
    "why": "Network fallback timeout"
   },
   {
    "ref": "AV 31",
    "name": "FallbackStpnt",
    "why": "Network fallback setpoint"
   },
   {
    "ref": "BV 3",
    "name": "ServiceAlarm",
    "why": "Service alarm"
   }
  ],
  "enable": "BV 1 PowerStatus (0 = Off, 1 = On) is writable; MSV 2 ControlMode selects External, Internal or Network control.",
  "heartbeat": "Network fallback is configured with AV 30 FallbackTimeout (0-900 s), AV 31 FallbackStpnt (0-100 %) and the AV 32 FallbackDownCntr countdown; the guide lists these objects but does not spell out the fallback sequence, so test it on site.",
  "remote_sensors": "Room RH is written to AV 2 only while BV 14 NetworkRoomRH = On; duct RH is written to AV 3 only while MSV 3 HiLimitSensorSrc = Network. BV 15 enables an external RH setpoint.",
  "setup": [
   "MS/TP MAC defaults to 000 (000-254; 128-254 are non-token-passing slaves), baud auto-detects (Auto, 9600, 19200, 38400, 76800), Max_Master 127.",
   "Device instance defaults to 153000 + MAC and can be changed from the menu (password 637) or via Device Object_Identifier.",
   "Reinitialize Device over BACnet uses the password 'nep'."
  ],
  "gotchas": [
   "Out_of_Service automatically returns to False after 15 minutes by default (adjustable 0-120 min via a proprietary device property).",
   "A Copy Config can be run over BACnet, but the BACnet schedule is not copied.",
   "The controller does not send BACnet event notifications; poll alarm objects."
  ]
 },
