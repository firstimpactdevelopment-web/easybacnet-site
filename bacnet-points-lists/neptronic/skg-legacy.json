{
 "manufacturer": "Neptronic",
 "manufacturer_slug": "neptronic",
 "model": "SKG (legacy, pre-SKG4) gas-fired humidifier with NEPICSKG BACnet module",
 "model_slug": "skg-legacy",
 "aliases": [
  "SKG",
  "SKG3",
  "Neptronic SKG",
  "NEPICSKG",
  "SKG-BACNET",
  "SKG gas fired humidifier"
 ],
 "equipment_type": "Gas-fired steam humidifier",
 "applies_to": "Older Neptronic SKG gas-fired steam humidifiers (before the SKG4) with the NEPICSKG BACnet MS/TP module, one to four tanks.",
 "summary": "The NEPICSKG module gives the older SKG gas-fired humidifier a BACnet MS/TP interface (B-ASC). A common block (instances 1-99) carries humidity output, demand, room and duct humidity, setpoints, delays, PID settings, status and alarm flags and the control, operation and source selectors; each tank adds its own block (101-199 for tank 1 up to 401-499 for tank 4) with water and chimney temperatures, water level, burner demand and fan speed, timers, status flags and alarms.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "1.00",
 "default_device_instance": 153000,
 "access_inferred": false,
 "notes": [
  "Objects for tanks 2-4 (instances 201-499) exist only on units with that many tanks; the guide gives 95 objects for one tank up to 200 for four.",
  "The tank 4 table prints OverFlow_DripPan4 as BV 414, the same instance as Tank_Temp_Low4 (it is probably BV 413); both rows are kept as printed.",
  "Typos kept as printed: H3OLvl_Prb_Bad3 / H4OLvl_Prb_Bad4 and the space in \"Modulation Stat1-4\".",
  "MSV 5 Room_Hum_Source is printed without the W flag the other selectors have.",
  "Access is from the W? column; the tank alarm BVs are printed as writable. The module does not send BACnet event notifications."
 ],
 "source": {
  "title": "Gas Fired Humidifier SKG Series - BACnet Communication Module User Guide",
  "doc_number": "SKG-BACNET",
  "revision_date": "Rev 060803",
  "url": "https://www.neptronic.com/Humidifiers/PDF/SKG3000/SKG-bacnet-user-guide.pdf"
 },
 "integration": {
  "summary": "For BMS demand control set MSV 1 Ctl_Mode to 3 and write AV 1 Humidity_Demand; for the internal PID set MSV 1 to 2, choose the setpoint and humidity sources (MSV 4-6) and write AV 16 and AV 2. MSV 2 turns the unit off, on or to drain. Read BI 1, AI 1 and the two summary alarms BI 4 and BI 5.",
  "minimum_points": [
   {
    "ref": "MV 2",
    "name": "Operation_Mode",
    "why": "Unit off, on or drain"
   },
   {
    "ref": "MV 1",
    "name": "Ctl_Mode",
    "why": "Control mode; 3 = demand from BACnet"
   },
   {
    "ref": "AV 1",
    "name": "Humidity_Demand",
    "why": "Humidity demand from the BMS, %"
   },
   {
    "ref": "AV 16",
    "name": "Ctl_SP",
    "why": "Humidity setpoint for internal PID, %RH"
   },
   {
    "ref": "AV 2",
    "name": "Room_Humidity",
    "why": "Room RH from the BMS (remote source)"
   },
   {
    "ref": "BI 1",
    "name": "Power_Status",
    "why": "Unit power on"
   },
   {
    "ref": "AI 1",
    "name": "Humidity_Out",
    "why": "Humidifier output, %"
   },
   {
    "ref": "BI 4",
    "name": "Alrm_Not_Critical",
    "why": "Non-critical alarm, unit still running"
   },
   {
    "ref": "BI 5",
    "name": "Alarm_Critical",
    "why": "Critical alarm, unit stopped"
   }
  ],
  "enable": "MSV 2 Operation_Mode sets the unit off (1), on (2) or to drain (3). MSV 1 Ctl_Mode picks the demand source: 1 = analog input 1, 2 = internal PID, 3 = remote demand over BACnet.",
  "heartbeat": null,
  "remote_sensors": "With MSV 5 Room_Hum_Source = 2 and MSV 6 Duct_Hum_Source = 3 (remote) the BMS writes AV 2 Room_Humidity and AV 4 Duct_Humidity; MSV 4 SP_Source = 3 takes the setpoint from BACnet.",
  "setup": [
   "A configuration DIP switch puts the module in configure mode (MAC 254, wildcard device instance 4194303); two more DIP switches set 9600, 19200, 38400 or 76800 baud.",
   "Defaults: MAC 0, device instance 153000, device name NEPSKGHumidifier153000, Max_Master 127; MAC and device instance can also be set from the unit keypad in configure mode."
  ],
  "gotchas": [
   "Tank objects only respond for tanks that exist on the unit.",
   "Temperatures follow BV 1 Temperature_Unit (Celsius or Fahrenheit)."
  ]
 },
