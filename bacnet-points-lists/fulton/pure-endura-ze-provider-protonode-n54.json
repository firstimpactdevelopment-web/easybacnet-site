 ],
 "equipment_type": "Boiler controller gateway",
 "applies_to": "The Provider (lead) boiler of a Fulton Endura (EDR) ZE lead/lag group with the PURE control, read through the N54 ProtoNode.",
 "summary": "Fulton's N54 ProtoNode publishes 103 objects for the Provider (lead) boiler. Besides its own boiler data it carries the lead/lag view of up to 10 boilers (position, status, firing rate), for Endura (EDR) ZE boilers with the PURE control. It covers burner state, modulation, water temperatures, safety switch states, alarms and pump/isolation valve status. The BMS can enable the boiler, send a water setpoint and a heartbeat, and supply outdoor and header values when the boiler is set up for them.",
 "bacnet_transport": [],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Object IDs are written (X)001-(X)099, where (X) is the boiler's Modbus address on the ProtoNode. This list shows boiler address 1 (1001-1099); boiler 2 uses 2001-2099.",
  "The sheet does not say which BACnet transport the gateway is set to; ProtoNode gateways are normally configured for BACnet IP or BACnet MS/TP.",
  "The BMS Enable point only works after a physical jumper is removed at the boiler.",
  "Outdoor and header AVs marked Note 1 are writable only when the boiler program is set to take that value from the BMS.",
  "Current Alarm Index is decoded with Fulton's alarm chart and is only valid while Active Alarm = 1.",
  "Source is a Word (.docx) file on fulton.com, not a PDF.",
  "On the ZE sheets an alarm index value of 999 means no active alarm.",
  "The ZE sheet adds SCR, heating stage (1-10), stage limit and kW objects at (X)151-(X)165; the number of stages depends on boiler size and setup.",
  "System pump objects (X)131-(X)144 apply only from PURE version 3.3.4.0; System Delta P / Delta T read psi or °F depending on setup.",
  "Stage 2-10 Status rows share one merged range/type cell with Stage 1 in the source table."
 ],
 "integration": {
  "summary": "Remove the BMS enable jumper at the boiler, write BMS Enable = 1, send the water setpoint to BMS Network Setpoint and keep writing 1 to BMS Heartbeat at least every 60 s. Check that Current Setpoint Mode reads BMS Network (3), then read status, outlet temperature, modulation rate and the alarm points.",
  "minimum_points": [
   {
    "ref": "BV 1098",
    "name": "Boiler 1 BMS Enable",
    "why": "Network enable; jumper must be removed first"
   },
   {
    "ref": "AV 1093",
    "name": "Boiler 1 BMS Network Setpoint",
    "why": "Water temperature setpoint, 40-185 °F"
   },
   {
    "ref": "AV 1099",
    "name": "Boiler 1 BMS Heartbeat",
    "why": "Write 1 at least every 60 s for remote operation"
   },
   {
    "ref": "AI 1092",
    "name": "Boiler 1 Current Setpoint Mode",
    "why": "Setpoint source; 3 = BMS Network"
   },
   {
    "ref": "AI 1001",
    "name": "Boiler 1 Status",
    "why": "Boiler state; 60 = modulating, 0 = safety lockout"
   },
   {
    "ref": "AI 1017",
    "name": "Boiler 1 Outlet Temperature",
    "why": "Outlet water temperature, °F"
   },
   {
    "ref": "AI 1005",
    "name": "Boiler 1 Modulation Rate",
    "why": "Actual modulation rate, %"
   },
   {
    "ref": "BI 1061",
    "name": "Lead / Lag Enabled",
    "why": "Lead/lag sequencing on (1 = enabled)"
   },
   {
    "ref": "AI 1044",
    "name": "Boiler 1 Active Alarm",
    "why": "Any alarm active (1 = alarm)"
   },
   {
    "ref": "AI 1043",
    "name": "Boiler 1 Current Alarm Index",
    "why": "Alarm number from Fulton's alarm chart"
   }
  ],
  "enable": "Remove the physical jumper at the boiler, then write BV (X)098 BMS Enable = 1. The setpoint comes from AV (X)093 BMS Network Setpoint (40-185 °F); AI (X)092 Current Setpoint Mode reads 3 when the network setpoint is in use.",
  "heartbeat": "AV (X)099 BMS Heartbeat: the BMS must write 1 at least once every 60 seconds. If it stops, the boiler goes back to local control and shows a BMS Communication Warning.",
  "remote_sensors": "AV (X)025 outdoor air, (X)026 header supply, (X)027 header return and (X)029 DHW temperature are writable only when the boiler program is set to accept that value from the BMS (°F).",
  "setup": [
   "Object ID = boiler Modbus address followed by the three-digit point number: (X)001-(X)099. Boiler 1 = 1001-1099, boiler 2 = 2001-2099.",
   "The sheet gives no device instance, MAC address or baud rate; those are set on the ProtoNode gateway."
  ],
  "gotchas": [
   "BMS Enable does nothing until the physical jumper is removed.",
   "Safety BIs mostly read 0 = Fault, 1 = No Fault; the low water BIs read 1 = Fault.",
   "The Boiler 1-10 LL Position/Status/Firing Rate objects describe the whole lead/lag group as seen by the Provider; they are not per-boiler addresses."
  ]
 },
