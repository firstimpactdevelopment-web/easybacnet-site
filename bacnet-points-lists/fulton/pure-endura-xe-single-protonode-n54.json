 "equipment_type": "Boiler controller gateway",
 "applies_to": "Fulton Endura XE (EXE) 399-750 hydronic boilers with the PURE control, one boiler per address block on the N54 ProtoNode.",
 "summary": "Fulton's N54 ProtoNode publishes 49 objects for each boiler (one block of objects per boiler), for Endura XE (EXE) 399-750 boilers with the PURE control. It covers burner state, modulation, water temperatures, safety switch states, alarms and pump/isolation valve status. The BMS can enable the boiler, send a water setpoint and a heartbeat, and supply outdoor and header values when the boiler is set up for them.",
 "bacnet_transport": [],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Object IDs are written (X)001-(X)058, where (X) is the boiler's Modbus address on the ProtoNode. This list shows boiler address 1 (1001-1058); boiler 2 uses 2001-2058.",
  "The sheet does not say which BACnet transport the gateway is set to; ProtoNode gateways are normally configured for BACnet IP or BACnet MS/TP.",
  "The BMS Enable point only works after a physical jumper is removed at the boiler.",
  "Outdoor and header AVs marked Note 1 are writable only when the boiler program is set to take that value from the BMS.",
  "Current Alarm Index is decoded with Fulton's alarm chart and is only valid while Active Alarm = 1.",
  "Fulton removed some point numbers from this sheet to match the EXE hardware, so IDs are not continuous.",
  "Burner Control Status uses EXE codes (0 Standby ... 3 Run, 5 Lock Out), not the LMV phase codes of the larger Endura models."
 ],
 "integration": {
  "summary": "Remove the BMS enable jumper at the boiler, write BMS Enable = 1, send the water setpoint to BMS Network Setpoint and keep writing 1 to BMS Heartbeat at least every 10 s. Check that Current Setpoint Mode reads BMS Network (2), then read status, outlet temperature, modulation rate and the alarm points.",
  "minimum_points": [
   {
    "ref": "BV 1057",
    "name": "Boiler 1 BMS Enable",
    "why": "Network enable; jumper must be removed first"
   },
   {
    "ref": "AV 1052",
    "name": "Boiler 1 BMS Network Setpoint",
    "why": "Water temperature setpoint, 40-185 °F"
   },
   {
    "ref": "AV 1058",
    "name": "Boiler 1 BMS Heartbeat",
    "why": "Write 1 at least every 10 s for remote operation"
   },
   {
    "ref": "AI 1051",
    "name": "Boiler 1 Current Setpoint Mode",
    "why": "Setpoint source; 2 = BMS Network"
   },
   {
    "ref": "AI 1001",
    "name": "Boiler 1 Burner Control Status",
    "why": "Burner state; 3 = run, 5 = lock out"
   },
   {
    "ref": "AI 1017",
    "name": "Boiler 1 Outlet Temperature",
    "why": "Outlet water temperature, °F"
   },
   {
    "ref": "AI 1005",
    "name": "Boiler 1 Modulation Rate",
    "why": "Actual modulation rate, %"
   },
   {
    "ref": "AI 1044",
    "name": "Boiler 1 Active Alarm",
    "why": "Any alarm active (1 = alarm)"
   },
   {
    "ref": "AI 1043",
    "name": "Boiler 1 Current Alarm Index",
    "why": "Alarm number from Fulton's alarm chart"
   }
  ],
  "enable": "Remove the physical jumper at the boiler, then write BV (X)057 BMS Enable = 1. The setpoint comes from AV (X)052 BMS Network Setpoint (40-185 °F); AI (X)051 Current Setpoint Mode reads 2 when the network setpoint is in use.",
  "heartbeat": "AV (X)058 BMS Heartbeat: the BMS must write 1 at least once every 10 seconds for remote operation. What the boiler does when the heartbeat stops is not stated on this sheet.",
  "remote_sensors": "AV (X)025 outdoor air, (X)026 header supply, (X)027 header return and (X)029 DHW temperature are writable only when the boiler program is set to accept that value from the BMS (°F).",
  "setup": [
   "Object ID = boiler Modbus address followed by the three-digit point number: (X)001-(X)058. Boiler 1 = 1001-1058, boiler 2 = 2001-2058.",
   "The sheet gives no device instance, MAC address or baud rate; those are set on the ProtoNode gateway."
  ],
  "gotchas": [
   "BMS Enable does nothing until the physical jumper is removed.",
   "Safety BIs mostly read 0 = Fault, 1 = No Fault; High Limit Aquastat reads 1 = Fault and Primary Low Water reads 0 = Off, 1 = On on this sheet."
  ]
 },
