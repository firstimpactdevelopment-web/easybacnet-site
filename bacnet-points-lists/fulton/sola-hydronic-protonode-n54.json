 "applies_to": "Fulton hydronic boilers with the SOLA burner control, one block of objects per boiler on the N54 ProtoNode.",
 "summary": "Fulton's N54 ProtoNode publishes 41 objects for each hydronic boiler with the SOLA control. They cover water temperatures, active setpoints and operating points, firing rate, fan speed, flame signal, alarm and lockout data, safety input states and pump outputs. The BMS can enable central heat, DHW and lead/lag, send their setpoints, and force the burner on or off with a remote firing rate.",
 "bacnet_transport": [],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Object IDs are written (X)001-(X)041, where (X) is the boiler's Modbus address on the ProtoNode. This list shows boiler address 1 (1001-1041).",
  "The sheet does not say which BACnet transport the gateway is set to; ProtoNode gateways are normally configured for BACnet IP or BACnet MS/TP.",
  "Fan Speed range depends on user settings.",
  "Burner Demand Source and Burner Status are analog inputs carrying a code; the codes are in the states."
 ],
 "integration": {
  "summary": "Turn central heat on with CH Enable and write the CH setpoint, or let the BMS hold the boiler with Remote Operating Mode and a Remote Firing Rate. Read burner status, outlet temperature, firing rate, the alarm status and the lockout code.",
  "minimum_points": [
   {
    "ref": "BV 1032",
    "name": "Boiler 1 CH Enable",
    "why": "Central heat enable (1 = enable)"
   },
   {
    "ref": "AV 1033",
    "name": "Boiler 1 CH Setpoint Input",
    "why": "Central heat setpoint, °F"
   },
   {
    "ref": "AV 1040",
    "name": "Boiler 1 Remote Operating Mode",
    "why": "0 = Auto, 1 = Remote Off, 2 = Remote On"
   },
   {
    "ref": "AV 1041",
    "name": "Boiler 1 Remote Firing Rate",
    "why": "Firing rate in remote, 0-100 %"
   },
