    "why": "Burner state code; see states"
   },
   {
    "ref": "AI 1001",
    "name": "Boiler 1 Outlet Temperature",
    "why": "Outlet water temperature, °F"
   },
   {
    "ref": "AI 1013",
    "name": "Boiler 1 Firing Rate",
    "why": "Actual firing rate, %"
   },
   {
    "ref": "BI 1016",
    "name": "Boiler 1 Alarm Status",
    "why": "Alarm active (1 = active)"
   },
   {
    "ref": "AI 1017",
    "name": "Boiler 1 Lockout Code",
    "why": "Lockout code; 0 = no lockout"
   }
  ],
  "enable": "BV (X)032 CH Enable turns central heat on; AV (X)033 CH Setpoint Input sets the CH target. AV (X)040 Remote Operating Mode (0 Auto, 1 Remote Off, 2 Remote On) and AV (X)041 Remote Firing Rate let the BMS force the burner. DHW and lead/lag have their own enable and setpoint objects.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Object ID = boiler Modbus address followed by the three-digit point number: (X)001-(X)041. Boiler 1 = 1001-1041, boiler 2 = 2001-2041.",
   "The sheet gives no device instance, MAC address or baud rate; those are set on the ProtoNode gateway."
  ],
  "gotchas": [
   "Lockout codes (1-4096) are decoded with the SOLA control manual.",
   "The safety input BIs report the circuit (0 = open, 1 = made), not a fault flag; check which way each switch fails."
  ]
 },
