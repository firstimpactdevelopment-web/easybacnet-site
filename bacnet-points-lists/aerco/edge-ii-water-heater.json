{
 "manufacturer": "AERCO",
 "manufacturer_slug": "aerco",
 "model": "Edge [ii] water heater controller (standalone / WHM)",
 "model_slug": "edge-ii-water-heater",
 "aliases": [
  "Edge [ii]",
  "Edge ii",
  "Edge 2",
  "WHM",
  "Water Heater Management",
  "Centurion",
  "OMM-0176",
  "Innovation 1600-2000"
 ],
 "equipment_type": "Commercial water heater controller",
 "applies_to": "AERCO Innovation 1600-2000 water heaters with the Edge [ii] controller, run standalone or as a WHM (Water Heater Management) manager or client.",
 "summary": "The Edge [ii] controller on AERCO water heaters talks BACnet IP on its Ethernet port or BACnet MS/TP on the J14 RS-485 terminals. Standalone and client units expose analog inputs for status, temperatures, valve position, O2 and combustion-calibration data plus analog values for setpoints and setup. A WHM manager adds plant values and a read-only block for each of up to 16 units. Only analog inputs and analog values are used.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "Application software 1.0 (PICS dated 2018-09-27)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access is given per table in the manual (AI tables read only, AV tables read/write), not per point; it is applied that way here.",
  "Two tables in the manual give AI 100-122 and AV 53 different meanings. On a WHM manager they are the plant values listed here (AI 100-122) and AV 53 Network Timeout (5-999 s). On a standalone unit or WHM client the same IDs are calibration history instead (AI 99-106 Previous O2 at Cal 1-8, AI 107-114 Previous NOx at Cal 1-8, AI 115-122 Previous CO at Cal 1-8) and AV 53 is FFWD Temp Display.",
  "AI 123-138 (previous calibration points and flame strength) are from the standalone/client table; the manager table marks AI 123-151 Not Used.",
  "The WHM manager repeats a read-only block for each of up to 16 units; only unit 1 (AI 300-319) is listed here. Unit n uses the same names at AI 300 + 100 x (n - 1) to 319 + 100 x (n - 1), so unit 16 = AI 1800-1819.",
  "Objects marked Not Used, Unused or NA for the Edge [ii] are left out.",
  "Temperatures are listed in °F; the BAS Temp Format setting can switch the interface to Celsius. AERCO's BACnet vendor ID is 601."
 ],
 "source": {
  "title": "Edge [ii] Controller Communication Manual",
  "doc_number": "OMM-0162C",
  "revision_date": "2025-10-15",
  "url": "https://www.aerco.com/dfsmedia/0533dbba17714b1ab581ab07a4cbb521/659416-source/omm-0176-aerco-edge-ii-communication-manual-4-1-25.pdf"
 },
 "integration": {
  "summary": "Enable the BAS port under Advanced Setup > Comm & Network > BAS (BACnet IP on the Ethernet port or BACnet MS/TP on J14), set the communication address and node offset, then have the BAS write the setpoint. For a WHM plant connect the BAS to the manager (or backup manager) only; it exposes plant values and a read-only block per unit.",
  "minimum_points": [
   {
    "ref": "AV 80",
    "name": "Remote Disable Code",
    "why": "85 = disable unit, 0 = enable"
   },
   {
    "ref": "AV 12",
    "name": "Operating Mode",
    "why": "Selects constant or remote setpoint"
   },
   {
    "ref": "AV 13",
    "name": "Remote Signal",
    "why": "Set to BAS so the remote setpoint comes from BACnet"
   },
   {
    "ref": "AV 4",
    "name": "Setpoint",
    "why": "Unit temperature setpoint, 20-245 °F"
   },
   {
    "ref": "AV 245",
    "name": "WHM Setpoint",
    "why": "Plant setpoint on a WHM manager"
   },
   {
    "ref": "AI 1",
    "name": "Unit Status",
    "why": "Standby / manual / remote / auto / fault state"
   },
   {
    "ref": "AI 2",
    "name": "Outlet",
    "why": "Outlet water temperature"
   },
   {
    "ref": "AI 8",
    "name": "Current Valve Position",
    "why": "Firing (valve) position, %"
   },
   {
    "ref": "AI 0",
    "name": "Message Code",
    "why": "Active event / fault code"
   },
   {
    "ref": "AI 108",
    "name": "Units Faulted",
    "why": "Units faulted in the WHM plant"
   }
  ],
  "enable": "Under Advanced Setup > Comm & Network > BAS pick BACnet IP or BACnet MSTP (default Off). The BAS controls the unit through AV 12 Operating Mode (1 = Remote Setpt), AV 13 Remote Signal (3 = BAS) and the setpoint (AV 4, or AV 245 on a WHM manager). AV 80 Remote Disable Code (AV 229 for the plant) disables with 85 and enables with 0, but only when Allow System Disable = Yes in the BAS menu.",
  "heartbeat": "The BAS screen has a BAS Comm Timeout setting (range and default not given). On a WHM manager, AV 53 Network Timeout is listed as 5-999 s. AV 24 Unit Failsafe Mode sets what a unit does on lost communication: 0 = Shutdown, 1 = Constant Setpt.",
  "remote_sensors": "On a WHM manager AV 213 Hdr Temp Sensor can be set to 3 = BAS, after which the BAS writes the header temperature to AV 214. AV 215 selects the return header sensor source.",
  "setup": [
   "BACnet MS/TP: baud 9600-115200, address 0-127, 8 data bits, no parity, 1 stop bit; wire to J14 pins 1 (+) and 2 (-), shield to J3 pin 8.",
   "Terminate the BAS RS-485 with SW3 switch 5 ON only at the BAS and the first and last units on the daisy chain; biasing must be supplied externally.",
   "BACnet IP: device instance = Node Offset + Communication Address; UDP port selectable 0xBAC0-0xBACF; DHCP enabled unless turned off in the Ethernet screen.",
   "Each standalone unit or manager needs its own Ethernet connection through a switch; don't daisy-chain them.",
   "AERCO recommends wiring the BAS to the backup manager too, so it can take over BAS communication."
  ],
  "gotchas": [
   "Optional BAS IP/MAC security limits which server can talk to the controller.",
   "Unit blocks repeat every 100 IDs (unit 1 = AI 300-319 ... unit 16 = AI 1800-1819); only unit 1 is listed.",
   "Remote Disable only works with Allow System Disable = Yes.",
   "AI 100-122 and AV 53 mean different things on a WHM manager and on a standalone/client unit; see the notes."
  ]
 },
