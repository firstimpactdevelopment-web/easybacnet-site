 "model_slug": "edge-bst-manager",
 "aliases": [
  "BST Manager",
  "Boiler Sequencing Technology",
  "Edge [i]",
  "Edge [ii]",
  "Benchmark Edge",
  "BMK Edge",
  "Innovation Edge",
