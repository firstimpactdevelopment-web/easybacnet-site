 ],
 "equipment_type": "Boiler plant manager (sequencing controller)",
 "applies_to": "AERCO Benchmark boilers and Innovation water heaters with an Edge [i] or Edge [ii] controller acting as BST Manager for up to 16 units, with optional SmartPlate / SmartPlate EV units.",
 "summary": "When an Edge controller is the BST (Boiler Sequencing Technology) Manager it serves extra BACnet objects for the whole plant on top of its own unit objects: plant status and setpoints as Analog Inputs, plant settings as writable Analog Values, a read-only block for each of up to 16 BST units, and readings from up to 6 SmartPlate water heaters. BACnet IP runs on the Ethernet port and BACnet MS/TP on the RS-485 BAS port.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "From tables 4-3 to 4-6 of the manual (pages 19-22). The manager also serves the stand-alone / client objects of tables 4-1 and 4-2, which match the AERCO Edge [ii] list; they are not repeated here.",
  "Access follows the table type: AI tables are read only, AV tables read/write.",
  "BST unit blocks: unit 1 is AI 300-319 (listed); unit n uses the same names at AI 300 + 100 x (n - 1), up to unit 16 = AI 1800-1819.",
  "SmartPlate blocks: SmartPlate 1 is AI 3500-3507 (listed); SmartPlate n uses AI 3500 + 100 x (n - 1), up to 4000-4007. SP Delta Pres, SP DHW Inlet and SP Flow apply to SmartPlate EV only.",
  "The manual prints DHW Header Temp twice (AI 120 and AI 126) and Rtn Hdr Temp Sensor twice (AV 215 selector, AV 216 temperature); both are kept. AI 134-151 are not used.",
  "Columns mark some objects NA for BMK Edge[ii], BMK Edge[i] or Innovation Edge[i] (mostly DHW, VSP pump and SmartPlate objects); check the manual for your model. Trailing colons on names are dropped."
 ],
 "source": {
  "title": "Edge Communication Manual for Systems Integrators",
  "doc_number": "OMM-0140J",
  "revision_date": "2025-11-04",
  "url": "https://stagesc10.watts.com/dfsmedia/0533dbba17714b1ab581ab07a4cbb521/650538-source",
  "unofficial": true,
  "host": "Watts staging media server"
 },
 "integration": {
  "summary": "Connect the BAS to the BST Manager only. Check Allow BAS to Write (AV 51), then drive the plant with Remote Disable Code (AV 229) and the plant remote setpoint (AV 200); read plant status, header temperature, firing rate and the per-unit blocks.",
  "minimum_points": [
   {
    "ref": "AV 229",
    "why": "0 = enable plant, 85 = disable plant",
    "name": "Remote Disable Code"
   },
   {
    "ref": "AV 200",
    "why": "Plant remote setpoint, 20-245 °F",
    "name": "Plant Remote Setpoint"
   },
   {
    "ref": "AV 51",
    "why": "BAS write permission (0-1)",
    "name": "Allow BAS to Write"
   },
   {
    "ref": "AI 114",
    "why": "Active plant setpoint",
    "name": "Act Setpt"
   },
   {
    "ref": "AI 110",
    "why": "Header temperature",
    "name": "Header Temp"
   },
   {
    "ref": "AI 112",
    "why": "Plant firing rate, %",
    "name": "BST Fire Rate"
   },
   {
    "ref": "AI 113",
    "why": "Units firing",
    "name": "Units Ignited"
   },
   {
    "ref": "AI 108",
    "why": "Number of units in fault",
    "name": "Units Faulted"
   },
   {
    "ref": "AI 301",
    "why": "Unit 1 status (5 = fault)",
    "name": "unit Status"
   }
  ],
  "enable": "Allow BAS to Write (AV 51, 0-1) controls BAS write access. The plant is disabled by writing 85 to Remote Disable Code (AV 229) and enabled with 0; this needs Allow System Disable = Yes under Advanced Setup > Comm & Network > BAS.",
  "heartbeat": "Network Timeout (AV 53) is 5-999 s; the manual lists it but these tables do not describe the fallback action.",
  "remote_sensors": "Header, return header, DHW header and outdoor temperatures can be written by the BAS (AV 214, AV 216, AV 206, AV 218) when their sensor source (AV 213, AV 215, AV 205, AV 217) is set to BAS.",
  "setup": [
   "Choose the BAS protocol (AV 219 or the BAS menu): BACnet IP on the Ethernet port or BACnet MS/TP on RS-485; MS/TP baud 9600-57600 (AV 220)."
  ],
  "gotchas": [
   "Read the per-unit blocks for unit faults; AI 108 only counts faulted units.",
   "Run cycles and run hours are split into upper and lower words."
  ]
 },
