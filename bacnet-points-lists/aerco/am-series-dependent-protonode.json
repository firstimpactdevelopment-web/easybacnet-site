 "applies_to": "AERCO AM Series boilers or water heaters set up as dependent units of a cascade, read through the AERCO ProtoNode FPC-N34 / FPC-N35.",
 "summary": "AERCO's ProtoNode maps each AM Series dependent unit to 49 objects: the unit's state, status, error and warning codes, CH/DHW setpoints, operation and mode settings, temperatures, firing rates, flame current, water pressure, pump states, counters and lockout/blocking history, plus MV 95 Control Register that unlocks writes. Cascade-level objects are on the managing unit's list.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Appendix C-2 of OMM-0107 (pages 61-62). Objects 1-48 and 95 match the first part of the managing-unit list (aerco/am-series-manager-protonode).",
  "Only BACnet objects are listed; the appendix also gives N2, LonWorks and Modbus TCP addresses."
 ],
 "integration": {
  "summary": "A dependent AM unit normally follows its managing unit. From the BMS, read State, Status, supply/return temperatures, firing rate and the error/warning codes; for writes, set MV 95 Control Register bit 0 first.",
  "minimum_points": [
   {
    "ref": "MV 95",
    "name": "Control Register",
    "why": "Write 1 (bit 0) before any write; bit 14 resets"
   },
   {
    "ref": "AV 9",
    "name": "Boiler Operation",
    "why": "Boiler operation command (0..x per AERCO)"
   },
   {
    "ref": "AI 3",
    "name": "State",
    "why": "Unit state; see Appendix I"
   },
   {
    "ref": "AI 4",
    "name": "Status",
    "why": "Unit status; see Appendix I"
   },
   {
    "ref": "AI 13",
    "name": "Supply Temp",
    "why": "Supply water temperature"
   },
   {
    "ref": "AI 18",
    "name": "Firing Rate",
    "why": "Firing rate"
   },
   {
    "ref": "AI 5",
    "name": "Error Code",
    "why": "Error code; see Appendix I"
   },
   {
    "ref": "AI 6",
    "name": "Warning Code",
    "why": "Warning code"
   }
  ],
  "enable": "Writing is a two-step process: write 1 to MV 95 Control Register (bit 0 = write enable), then write the target AV. Bit 14 resets the unit after a lockout.",
  "heartbeat": "The Control Register bits reset when the unit sees no Modbus traffic for more than 4 seconds.",
  "remote_sensors": null,
  "setup": [
   "ProtoNode FPC-N34 (BACnet MS/TP, BACnet IP, N2, Modbus TCP) or FPC-N35 (LonWorks); the BACnet protocol is picked with DIP switches.",
   "Boiler side: Modbus RTU, 9600 baud, no parity, 8 data bits, 1 stop bit; AM units use addresses 1-16.",
   "BACnet device instance = Node_Offset (default 50,000) + Modbus Node-ID."
  ],
  "gotchas": [
   "Writes are two steps: write 1 (bit 0) to MV 95 Control Register, then write the target object; the Control Register bits clear after 4 s without Modbus traffic.",
   "AERCO limits each register to about 10,000 value changes; CH/DHW setpoints are presets (about two changes a day), not for dynamic temperature control.",
   "Access is inferred from the N2 type (AO = writable); the appendix has no read/write column.",
   "State, Status and error codes are decoded with the tables in Appendix I of the manual."
  ]
 },
