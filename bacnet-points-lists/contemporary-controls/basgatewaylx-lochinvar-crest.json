    "why": "Outlet temperature"
   },
   {
    "ref": "AI 34",
    "name": "Inlet Temperature",
    "why": "Inlet temperature"
   },
   {
    "ref": "AI 32",
    "name": "Outlet Setpoint",
    "why": "Outlet setpoint"
   },
   {
    "ref": "AI 36",
    "name": "Firing Rate",
    "why": "Firing rate"
   },
   {
    "ref": "BI 17",
    "name": "Alarm Contacts",
    "why": "Alarm contacts"
   },
   {
    "ref": "AI 40",
    "name": "Boiler Lockout Code",
    "why": "Lockout code"
   }
  ],
  "enable": "Boiler Enable (BO 1) is polled by default. A BMS rate/setpoint command (AO 41) only applies when its configuration bit (BO 49) is set; both are unpolled in the published profile.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
   "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
  ],
  "gotchas": [
   "Unpolled rows do not appear as BACnet objects until enabled in the gateway's device profile page."
  ]
 },
