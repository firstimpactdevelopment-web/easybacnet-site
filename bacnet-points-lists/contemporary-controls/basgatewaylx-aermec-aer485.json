 "equipment_type": "Chiller / heat pump controller",
 "applies_to": "AERMEC chillers and heat pumps fitted with the AER485 RS-485 Modbus interface, read by a BASgatewayLX.",
 "summary": "Gateway profile for AERMEC units with the AER485 interface: 99 objects (21 AI, 9 AO, 61 BI, 8 BO), all polled. Binary outputs switch standby/on, cooling/heating, local/remote and safety reset; analog outputs set cooling and heating setpoints and differentials. Inputs give defrost, alarm and load states per circuit, compressors, pumps and valves, and the water, liquid and outside temperatures.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Built from Contemporary Controls' BASgatewayLX Modbus device profile AERMEC_AER485_a_LX.csv; the profile maps the registers in the AER485 manual (https://www.ccontrols.com/support/dp/AER485%20Manual.pdf).",
  "Object instances are the ones this profile assigns when it is loaded into the gateway. A site that edited or rebuilt the profile may use different instances.",
  "All 99 rows are flagged for polling in the profile, so every object is served to BACnet once the profile is loaded.",
  "The CSV has no read/write column: Analog/Binary Inputs are read-only and Analog/Binary Outputs are commandable (priority array), which is how the gateway maps them (access inferred). Descriptions give the Modbus register each object reads."
 ],
 "source": {
  "title": "BASgatewayLX Modbus device profile AERMEC_AER485_a",
  "doc_number": "AERMEC_AER485_a_LX.csv",
  "revision_date": null,
  "url": "https://www.ccontrols.com/support/dp/AERMEC_AER485_a_LX.zip"
 },
 "integration": {
  "summary": "Put the unit in remote (BO 4), switch it on (BO 1), pick cooling or heating (BO 2) and write the matching setpoint. Read water temperatures, compressor and pump states and the circuit alarms.",
  "minimum_points": [
   {
    "ref": "BO 4",
    "name": "Local/remote command (toggle) 0=LOCAL 1=REMOTE",
    "why": "Local/remote (1 = remote)"
   },
   {
    "ref": "BO 1",
    "name": "Standby/On command (toggle) 0=OFF 1=ON",
    "why": "Standby/on (1 = on)"
   },
   {
    "ref": "BO 2",
    "name": "Cooling/Heating mode command (toggle) 0=COLD 1=HOT",
    "why": "Cooling/heating (0 = cool, 1 = heat)"
   },
   {
    "ref": "AO 70",
    "name": "Cooling mode setting",
    "why": "Cooling setpoint"
   },
   {
    "ref": "AO 71",
    "name": "Heating mode setting",
    "why": "Heating setpoint"
   },
   {
    "ref": "BO 3",
    "name": "Safety reset command 1=RESET",
    "why": "Safety reset (1 = reset)"
   },
   {
    "ref": "AI 77",
    "name": "Water input temperature",
    "why": "Water inlet temperature"
   },
   {
    "ref": "AI 78",
    "name": "Circuit 1 water outlet temperature",
    "why": "Water outlet temperature, circuit 1"
   },
   {
    "ref": "BI 35",
    "name": "Circuit 1 compressor load",
    "why": "Circuit 1 compressor on"
   },
   {
    "ref": "BI 7",
    "name": "Circuit 1 alarm summary condition",
    "why": "Circuit 1 alarm summary"
   }
  ],
  "enable": "The unit takes BMS commands only in remote: set Local/remote (BO 4) to 1 first.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
   "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
  ],
  "gotchas": [
   "The command names say 'toggle'; check the AER485 manual for whether the unit expects a level or a change of state."
  ]
 },
