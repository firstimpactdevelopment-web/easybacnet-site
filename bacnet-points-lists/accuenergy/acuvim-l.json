  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP: default protocol is Modbus RTU; set S38 Protocol 1 = BACnet. Baud default 19200; max info frames default 10 (1-255); device ID on page S52.",
   "BACnet IP (AXM-WEB2): Settings > Communications > BACnet/IP; enable, port default 47808, unique device instance; BBMD foreign registration available; save and reboot.",
   "Acuvim-L-M (no display) from version 6.20: port 1 runs Modbus at 9600 baud for the first 60 s after each power-up, so a mis-set meter can be recovered with Acuview."
  ],
  "gotchas": [
