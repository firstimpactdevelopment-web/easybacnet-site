{
 "manufacturer": "Accuenergy",
 "manufacturer_slug": "accuenergy",
 "model": "AXM-WEB2 Ethernet module for Acuvim II meters (BACnet IP)",
 "model_slug": "axm-web2",
 "aliases": [
  "AXM-WEB2",
  "AXM-WEB2 BACnet",
  "Acuvim II AXM-WEB2"
 ],
 "equipment_type": "Power and energy meter (communication module)",
 "applies_to": "Accuenergy AXM-WEB2 Ethernet / web module fitted to Acuvim II series meters, with optional IO11/12, IO21/22 and IO31/32 modules.",
 "summary": "The AXM-WEB2 module adds BACnet IP to an Acuvim II meter. It serves 119 read-only Analog Inputs (metering, demand, energy, THD, per-channel demand, I/O module analog values at 1001-1008 and DI pulse counters at 2001-2028) and 44 Binary Inputs (DI status 1-28, alarm channel status 29-44).",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "v1.39c",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "AI 1001-1008 exist only with the IO21/IO22 (AO) or IO31/IO32 (AI) modules; their units follow the module mode (mA or V).",
  "AI 2001-2028 exist only when the DI is configured as a pulse counter; BI 1-28 need a DI module.",
  "BI 29-44 (alarm channel status) exist only when the meter supports alarm channel status.",
  "Shares the Acuvim II metering objects (AI 1-71) with the older AXM-BIP module list, with corrected names at AI 5 and AI 51; it adds max-demand objects AI 72-83 and alarm channel status BI 29-44, and AI 1001-1004 are the IO21/IO22 analog outputs.",
  "Source: Accuenergy 'BACnet Points List AXM-WEB2' spreadsheet, firmware v1.39c, generated 2026-10-06."
 ],
 "source": {
  "title": "BACnet Points List AXM-WEB2",
