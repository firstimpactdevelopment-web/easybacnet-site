 "equipment_type": "Thermostat (BACnet MS/TP)",
 "applies_to": "Strato OS537H-EH thermostats controlling electric heat with up to six stages plus an SSR/SCR vernier stage.",
 "summary": "The OS537H-EH controls electric heat with up to six on/off stages and a modulating vernier stage (SSR pulsed or SCR 0-10 V), from room temperature, supply temperature, both, or an external 2-10 V BMS signal. Its BACnet MS/TP objects give setpoints, staging settings, stage demands and statuses, the effective stage count and two PID loops.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
