{
 "manufacturer": "iSMA CONTROLLI",
 "manufacturer_slug": "isma-controlli",
 "model": "MVE-2-RS / MVC-2-RS / EBV-2-RS valve actuators (BACnet MS/TP)",
 "model_slug": "mve-mvc-ebv-2-rs-actuators",
 "aliases": [
  "MVE-2-RS",
  "MVC-2-RS",
  "EBV-2-RS",
  "iC Actuator Configurator",
  "Controlli MVE",
  "Controlli EBV energy valve",
  "VLX energy valve"
 ],
 "equipment_type": "Valve actuator / energy valve",
 "applies_to": "iSMA CONTROLLI (ex Controlli) MVE-2-RS, MVC-2-RS and EBV-2-RS communicating valve actuators, including energy-valve functions with VLX valves.",
 "summary": "These Controlli valve actuators talk BACnet MS/TP (or Modbus RTU). The object list covers control type and valve configuration, flow and position curve points, temperature and delta-T setpoints for the energy-valve functions, supply and return temperatures, flow, power and heating/cooling energy with monthly history, event counters, error flags and the actuator clock. Which objects are active depends on the actuator model and the valve selected.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "iC Actuator Configurator manual V1.3",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Instance numbers restart for each object type. Many objects apply only to some models (MVE/MVC/EBV) or valve types; the description says which when the manual does.",
  "AV 53, AV 54 and AV 68 are each printed twice (LSR and MSR halves of an energy value); both rows are kept as printed.",
  "AV 6 and AV 7 are both printed as \"FULLY OPEN EVENTS\"; AV 33 (VALVE POSITION Y9) and AV 76 are missing from the table.",
  "Network Port objects (MAC address, baud rate) and Device-object clock properties are left out; the clock is also on AV 81-85.",
  "MV states are numbered here in table order; the manual lists the texts without numbers."
 ],
 "source": {
  "title": "iC Actuator Configurator Manual V1.3 - BACnet Object",
  "doc_number": null,
  "revision_date": "V1.3",
  "url": "https://icdocs.ismacontrolli.com/en/ic-actuator-configurator/V1.3/bacnet-object"
 },
 "integration": {
  "summary": "Pick the control type (MV 0) and functions (MV 4), then read flow, supply and return temperature, delta T, power and energy. For energy-valve control write the delta-T or temperature setpoints (AV 37-48) and the design or maximum flow and power.",
  "minimum_points": [
   {
    "ref": "MV 0",
    "name": "TYPE OF CONTROL",
    "why": "Control type, 1 = Modbus/BACnet"
   },
   {
    "ref": "MV 4",
    "name": "FUNCTIONS ENABLE",
    "why": "Function: BMS, temperature, delta T, power ..."
   },
   {
    "ref": "AV 37",
    "name": "SETPOINT DELTA T CONTROL - HEATING",
    "why": "Delta-T setpoint, heating"
   },
   {
    "ref": "AV 13",
    "name": "FEEDBACK",
    "why": "Feedback (valve position)"
   },
   {
    "ref": "AV 36",
    "name": "INDICATED FLOW RATE",
    "why": "Indicated flow rate"
   },
   {
    "ref": "AV 52",
    "name": "INSTANT POWER",
    "why": "Instant power"
   },
   {
    "ref": "MV 7",
    "name": "ACTUATOR OPERATING MODE",
    "why": "Actuator operating mode"
   },
   {
    "ref": "BV 4",
    "name": "ACTUATOR OPERATING MODE (ERROR)",
    "why": "Actuator in error"
   }
  ],
  "enable": "MV 0 TYPE OF CONTROL must be Modbus/BACnet for the actuator to follow network commands.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [],
  "gotchas": [
   "Energy values are split over LSR/MSR rows in the manual; check how the actuator presents them over BACnet.",
   "BV 17/BV 18 force the valve fully closed/open and override control."
  ]
 },
