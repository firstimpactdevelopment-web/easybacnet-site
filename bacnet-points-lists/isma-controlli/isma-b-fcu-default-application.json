{
 "manufacturer": "iSMA CONTROLLI",
 "manufacturer_slug": "isma-controlli",
 "model": "iSMA-B-FCU fan coil controller (default application)",
 "model_slug": "isma-b-fcu-default-application",
 "aliases": [
  "iSMA-B-FCU",
  "iSMA-B-FCU-HH",
  "iSMA-B-FCU-HL",
  "iSMA-B-FCU-LL",
  "DMP241en"
 ],
 "equipment_type": "Fan coil unit controller",
 "applies_to": "iSMA CONTROLLI iSMA-B-FCU fan coil controllers running the factory default FCU application.",
 "summary": "The iSMA-B-FCU ships with a ready-made fan coil application (2- or 4-pipe, digital or analog valve control, 3-speed or analog fan) that exposes a fixed set of BACnet Analog Value and Binary Value objects, the same data as its Modbus registers. The BMS can set occupancy mode, setpoint, fan mode and FCU mode, write the room temperature, and read the effective setpoint, valve and fan outputs and sensor values. Up to five slave FCUs can follow one master over BACnet.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Default application 2.0 (App_version default)",
 "default_device_instance": "826 followed by the 3-digit MAC address (MAC 83 = 826083)",
 "access_inferred": false,
 "notes": [
  "The manual lists App_status (application diagnostics) as BACnet Device object property 5002, not as an object; it is left out here.",
  "Default values in the table look scaled x10 (Setpoint 210 for 21.0 °C; Fan_Scale default 30 while the text says 3 °C). Check whether the live BACnet values are scaled before writing.",
  "AV 29 is printed wrapped as 'Second_Stage_Diff / Binary'; it is listed as Second_Stage_Diff_Binary to match AV 31 Second_Stage_Diff_Analog.",
  "Names are kept as printed, including spelling slips (Coolling_Valve, Visable, Occuapancy, Conntact) and the few names printed with spaces.",
  "The MAC address is set with DIP switches; master/slave grouping works only over BACnet."
 ],
 "source": {
  "title": "iSMA-B-FCU Application User Manual",
  "doc_number": "DMP241en",
  "revision_date": "1st Issue rev. 5, 02/2022",
  "url": "https://downloads.innon.com/hubfs/downloads.innon.com/iSMA/iSMA-B-FCU/Manuals/iSMA_B_FCU_Application_Manual.pdf",
  "unofficial": true,
  "host": "Innon (iSMA distributor)"
 },
 "integration": {
  "summary": "Use the default application as shipped: write Occupancy_Mode, Setpoint, Fan_Mode and FCU_Mode from the BMS, and read Effective Setpoint, Occupancy Status, Fan Status and the valve outputs. If the room temperature comes from the BMS, write it to Net_Temperature. Only the master FCU of a group should be controlled from the BMS; slaves follow it.",
  "minimum_points": [
   {
    "ref": "AV 0",
    "name": "Occupancy_Mode",
    "why": "0 unoccupied, 1 occupied, 2 standby"
   },
   {
    "ref": "AV 4",
    "name": "FCU_Mode",
    "why": "0 off, 1 auto, 2 heat, 3 cool, 4 fan only"
   },
   {
    "ref": "AV 3",
    "name": "Fan_Mode",
    "why": "0 off, 1-3 manual speed, 4 auto"
   },
   {
    "ref": "AV 1",
    "name": "Setpoint",
    "why": "Room temperature setpoint"
   },
   {
    "ref": "AV 100",
    "name": "Effective Setpoint",
    "why": "Setpoint in use after offsets"
   },
   {
    "ref": "AV 101",
    "name": "Occupancy Status",
    "why": "0 unocc, 1 occ, 2 standby, 3 forced occupied"
   },
   {
    "ref": "AV 102",
    "name": "Fan Status",
    "why": "0 off, 1-3 manual speed, 4-6 auto speed"
   },
   {
    "ref": "AV 104",
    "name": "Cv",
    "why": "Room temperature used for control"
   },
   {
    "ref": "AV 110",
    "name": "Heating_Valve",
    "why": "Heating valve output, %"
   },
   {
    "ref": "AV 111",
    "name": "Coolling_Valve",
    "why": "Cooling valve output, %"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": "Net_Temperature (AV 6) takes a room temperature from the network as the control value source.",
  "setup": [
   "The MS/TP MAC address is set on the DIP switches (binary weights).",
   "Device instance = 826 followed by the 3-digit MAC address (MAC 83 gives 826083).",
   "For master/slave rooms, give slaves the BACnet device IDs from the auto-binding table, or set Remote_SlaveN_Device_ID and Local_Remote_Auto_Binding.",
   "Only the master works with the room panel and the BMS; up to 5 slaves follow it."
  ],
  "gotchas": [
   "Manual override objects (valve/fan manual value plus the matching enable BV) take outputs out of automatic control.",
   "Check value scaling: the table defaults look like tenths (210 = 21.0 °C)."
  ]
 },
