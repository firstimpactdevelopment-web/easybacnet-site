    "why": "Digital input 1 state"
   },
   {
    "ref": "AV 1",
    "name": "AI 1 Resistance",
    "why": "Input 1 measured resistance (wiring check)"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The default temperature table is 1 (NTC 10K Type 2, °C); pick 6-10 for °F readings."
  ],
  "gotchas": [
   "Offsets and table numbers are setup values; write them once, not cyclically."
  ]
 },
