  "Johnson Controls EasyIO"
 ],
 "equipment_type": "VAV terminal unit controller",
 "applies_to": "VAV boxes (cooling only, electric or hot water reheat, parallel or series fan) and pressure-dependent VVT zone dampers run by the EasyIO FW-08V with its factory VAV application.",
 "summary": "The EasyIO FW-08V ships with one pre-built VAV application that is set up for cooling-only, staged electric reheat, hot water reheat, parallel fan, series fan or VVT damper boxes by configuration objects. It runs standalone or on BACnet IP over Ethernet or Wi-Fi. The object list covers occupied, standby and unoccupied setpoints, box flow settings, PID tuning, network inputs from the AHU/RTU, measured values, damper and reheat commands, status flags and alarms.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Objects are from the \"BACnet Objects\" list on pages 48-52 of the guide; the device object (EasyIoUnivVAV, device 14) is not listed as a point.",
  "The same objects cover every application type; Config_* objects pick the box type (VVT damper, floating actuators, parallel fan mode, local sensors).",
  "Values in brackets in the guide are metric conversions; the US units are shown here.",
  "The guide is published by EasyIO on the Johnson Controls documentation site."
 ],
 "source": {
  "title": "FW-08V - VAV Application Guide v1.3",
  "doc_number": "v1.3",
  "revision_date": null,
  "url": "https://docs.johnsoncontrols.com/bas/api/khub/documents/VlM5w6lLIWgV3sp5iwjhIg/content"
 },
 "integration": {
  "summary": "Join the FW-08V to the BACnet IP network over Ethernet or Wi-Fi, set the Config_* objects for the box type and airflow limits, then command OccupancyCommand (BV 1) and the occupied setpoints and read room temperature, airflow, damper position and the alarm flags.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "OccupancyCommand",
    "why": "Occupied/unoccupied command"
   },
   {
    "ref": "BV 10",
    "name": "HeatLockoutCmnd",
    "why": "Global heat disable from the BMS"
   },
   {
    "ref": "AV 3",
    "name": "OccCoolSp",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AV 4",
    "name": "OccHeatSp",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "AV 70",
    "name": "RoomTemp",
    "why": "Room temperature, °F"
   },
   {
    "ref": "AV 78",
    "name": "BoxFlow",
    "why": "Measured box airflow, cfm"
   },
   {
    "ref": "AV 79",
    "name": "EffectiveFlowSp",
    "why": "Active airflow setpoint, cfm"
   },
   {
    "ref": "AV 100",
    "name": "Damper",
    "why": "Damper position, %"
   },
   {
    "ref": "BV 52",
    "name": "OccupancyStatus",
    "why": "Occupancy status"
   },
   {
    "ref": "BV 58",
    "name": "LowCfmAlarm",
    "why": "Airflow below setpoint for 30 min"
   }
  ],
  "enable": "OccupancyCommand (BV 1) sets occupied or unoccupied. HeatLockoutCmnd (BV 10) disables heat globally (for example on outdoor temperature or no boiler) and MorningWarmUpCmnd (BV 6) starts morning warm-up from the central AHU/RTU.",
  "heartbeat": null,
  "remote_sensors": "OaTempIn (AV 10) takes outdoor temperature from the network for display only; NetDuctInletIn (AV 37) takes the duct inlet temperature from the AHU/RTU.",
  "setup": [
   "Set Config_MaxFlowSp, Config_MinFlowSp, Config_MaxHeatFlowSp and Config_Box_KFactor (AV 24-28) for the box.",
   "Config_P2P_BaseAddress (AV 42) groups VAV boxes that share an AHU for peer-to-peer data.",
   "BalFlowCommand (AV 36) and Config_BalCfmMaxFlow / Config_BalCfmMinFlow (AV 53/54) are used for air balancing."
  ],
  "gotchas": [
   "Config_* objects are setup values; don't write them cyclically.",
   "Leaving BalFlowCommand away from 1 (Auto) keeps the box in balancing mode and sets ManualFlowAlarm (BV 59)."
  ]
 },
