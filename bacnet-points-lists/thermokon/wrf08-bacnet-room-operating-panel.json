 "equipment_type": "Room operating unit (buttons, LCD, setpoints) / room sensor",
 "applies_to": "Thermokon WRF08 room operating panels with LCD, up to 12 buttons, room temperature sensor and BACnet MS/TP over RS485.",
 "summary": "WRF08 is a room operating panel with LCD and up to 12 buttons. Its BACnet MS/TP interface lists 61 objects: button states, room temperature, four setpoint offsets and effective setpoints, fan stage and occupancy from the panel, plus values the BMS writes for display (outdoor temperature, external values, base setpoints, fan stage, occupancy), LED and symbol control and lock objects. Configuration is done with file objects and Thermokon software.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "Offset_device_id (AV 1) + MAC address",
 "access_inferred": false,
 "notes": [
  "Access follows the specification: section 5.2.2 lists the read-only objects and 5.2.3 the readable and writeable ones; the basic-settings objects are described as writeable.",
  "Units are not printed; temperature and setpoint objects are shown in °C.",
  "Button functions, LED functions, display options and setpoint ranges are configuration registers in the file objects (FI 1-5), not separate BACnet objects.",
  "COV-Mode (MV 1) states are listed as printed, without numbers."
 ],
