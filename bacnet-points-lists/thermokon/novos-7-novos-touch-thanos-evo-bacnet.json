 "integration": {
  "summary": "Set the bus address and baud rate on the unit (or with the NOVOS app), load the configuration with uConfig, then map the room-climate block (occupancy, setpoint, fan stage) and the sensor AIs into the room controller. Light, shade and scene objects carry the user's button actions for the BMS to act on.",
  "minimum_points": [
   {
    "ref": "BV 100",
    "name": "Occupancy",
    "why": "Room occupancy, settable by user or BMS"
   },
   {
    "ref": "BV 101",
    "name": "ECO",
    "why": "ECO (energy-saving) mode"
   },
   {
    "ref": "AV 103",
    "name": "Setpoint",
    "why": "Room setpoint; the BMS may overwrite it"
   },
   {
    "ref": "MV 105",
    "name": "External Fan Stage",
    "why": "Fan stage written back by the BMS"
   },
   {
    "ref": "MI 104",
    "name": "Internal Fan Stage",
    "why": "Fan stage chosen by the user"
   },
   {
    "ref": "AI 500",
    "name": "Temperature",
    "why": "Room temperature"
   },
   {
    "ref": "AI 501",
    "name": "Relative Humidity",
    "why": "Room humidity (rH variants)"
   },
   {
    "ref": "AI 505",
    "name": "CO2",
    "why": "Room CO2 (CO2 variants)"
   },
   {
    "ref": "BI 514",
    "name": "Digital Input",
    "why": "Window or other contact, 1 = closed"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": "AV 106 lets the BMS replace the room temperature shown on the home screen, and AV 509-512 show up to four BMS values in the monitoring menu.",
  "setup": [
   "Bus address 1-247; NOVOS 7 baud 9600-115200, NOVOS Touch/thanos EVO 4800-115200.",
   "Device instance = Device Offset ID (AV 4180) + MAC address.",
   "Configuration (circuits, scenes, setpoint limits) is written by uConfig as config.bin through BACnet file transfer (FILE 0) and stored in EEPROM."
  ],
  "gotchas": [
   "In 'Button' mode the light/shade AVs reset to 110 (no press) after they are read; 'Button (raw)' needs a fast bus or presses are missed.",
   "The State Message text is written into the Description property of BV 400, not its present value."
  ]
 },
 "page": "https://easybacnet.com/bacnet-points-lists/thermokon/novos-7-novos-touch-thanos-evo-bacnet",
