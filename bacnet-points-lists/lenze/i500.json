 "equipment_type": "Variable frequency drive",
 "applies_to": "Lenze i500 series inverters (model I51AExxxx10xxxxxxS) with the BACnet MS/TP network option, firmware V01.04.",
 "summary": "The Lenze i500 inverter talks BACnet MS/TP directly. Its PICS lists 77 fixed objects: 16 binary values that trigger the drive's mappable network functions (run forward, quick stop, reset and so on), status bits from the drive status word, a frequency setpoint and readings as analog values, and a mailbox for reading and writing any drive parameter.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Firmware V01.04, application software V05.02.00.xx",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "BV 0-15 trigger whatever functions drive parameters 0x400E:001-016 are mapped to; names and descriptions are the factory defaults and don't update if the mapping is changed later.",
  "Changing the BV 0-15 mapping raises the device's database revision.",
  "AI 1 is printed with the name 'AI1 terminal %' but reads terminal AI2.",
  "Access 'R/W/C' is shown as commandable and 'R/E' (event notification) as read-only.",
  "AV 29/30 and BV 36/37 are user objects; access and units depend on the parameter mapped into them.",
  "Units for AV 0 are printed as 0.01Hz; AV 13 is listed in Hertz but read from a 0.01 Hz parameter."
 ],
 "source": {
  "title": "Lenze i500 BACnet Protocol Implementation Conformance Statement",
  "doc_number": "PICS V01.04",
  "revision_date": "2018-04-23",
  "url": "https://www.bacnetinternational.net/catalog/manu/lenze%20americas/lenze_i500_bacnet_pics_v01_04.pdf"
 },
 "integration": {
  "summary": "Use AV 9 Network Control to hand control to BACnet, write the frequency setpoint to AV 0 and run with BV 4 Run forward (default mapping). Read BV 22 running, AV 13 frequency, AV 17 current and BV 20 fault, and reset with BV 7. Check the 0x400E mapping on site, since BV 0-15 can be remapped.",
  "minimum_points": [
   {
    "ref": "BV 4",
    "name": "Run forward",
    "why": "Run command (default mapping)"
   },
   {
    "ref": "AV 9",
    "name": "Network Control",
    "why": "Activates network control (0x2631:037)"
   },
   {
    "ref": "AV 0",
    "name": "Net.freq 0.01",
    "why": "Frequency setpoint in 0.01 Hz"
   },
   {
    "ref": "BV 7",
    "name": "Reset error",
    "why": "Reset a tripped drive (default mapping)"
   },
   {
    "ref": "BV 22",
    "name": "E:Running Forward",
    "why": "Running forward status"
   },
   {
    "ref": "BV 25",
    "name": "E:Control from Network",
    "why": "Drive is under network control"
   },
   {
    "ref": "AV 13",
    "name": "Frequency 0.01",
    "why": "Actual output frequency"
   },
   {
    "ref": "AV 17",
    "name": "Motor Current",
    "why": "Motor amps"
   },
   {
    "ref": "BV 20",
    "name": "E:Faulted/Trip",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 14",
    "name": "Error Code",
    "why": "Active error code"
   }
  ],
  "enable": "AV 9 Network Control (0x2631:037) activates network control and AV 8 sets the default setpoint source (0x2860:001); BV 25 and BV 26 show when network control and the network setpoint are active. The PICS gives no values for AV 8 or AV 9; see the i500 manual.",
  "heartbeat": null,
  "remote_sensors": "AV 1 PID Setpoint takes a network PID setpoint (in the PID unit) when the drive's process controller is used.",
  "setup": [
   "MS/TP baud rates 9600 to 115200 are listed in the PICS.",
   "ReinitializeDevice needs a password.",
   "Set the 0x400E function mapping before configuring the BMS, so the BV 0-15 names stay accurate."
  ],
  "gotchas": [
   "BV 0-15 meanings depend on parameters 0x400E:001-016; the defaults are shown.",
   "AV 10 Save Parameters writes the drive's memory; don't write it cyclically.",
   "AI 1 name says AI1 but reads terminal AI2."
  ]
 },
