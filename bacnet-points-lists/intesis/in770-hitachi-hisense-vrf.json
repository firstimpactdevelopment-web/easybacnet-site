    "why": "Setpoint command"
   },
   {
    "ref": "MO 101",
    "name": "OXXUXX_FanSpeed_C",
    "why": "Fan speed command (1 = auto)"
   },
   {
    "ref": "BI 100",
    "name": "OXXUXX_On/Off_S",
    "why": "Run status"
   },
   {
    "ref": "AI 100",
    "name": "OXXUXX_Setpoint_S",
    "why": "Setpoint in use"
   },
   {
    "ref": "AI 102",
    "name": "OXXUXX_Inlet Temp.",
    "why": "Return air temperature"
   },
   {
    "ref": "BI 102",
    "name": "OXXUXX_Communication Status",
    "why": "Unit present on H-Link"
   },
   {
    "ref": "AI 106",
    "name": "OXXUXX_Unit Error code",
    "why": "Fault code"
   }
  ],
  "enable": "No enable point is documented. Remote-controller permissions can be removed per unit with the Allow ... from RC_C objects (BO 102-105).",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP: DHCP for 30 seconds at first start-up, then the default IP 192.168.100.246.",
   "BACnet MS/TP uses the gateway's EIA-485 port.",
   "Units are found with the scan function in Intesis MAPS; send the project to the gateway after changes.",
   "With a Hitachi CSNET Manager on the bus the fan speed list shrinks to Low/Mid/High."
  ],
  "gotchas": [
   "On/Off, Mode, FanSpeed, Vane and Setpoint at instances 0-2 (BO 0, MO 0-2, AO 0) act on all units at once.",
   "Instance numbers follow the IU/OU address, so readdressing a unit changes its instances."
  ]
 },
