  "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-in770hitxxxo000.pdf"
 },
 "integration": {
  "summary": "Wire the H-Link (TB2) bus to Port A (A1/A2), pick BACnet IP or BACnet MS/TP in Intesis MAPS, scan or add the units, send the project, then map each indoor unit's _C commands and _S status objects from its (IU address x 100) block. Instances 0-2 command every unit at once.",
  "minimum_points": [
   {
    "ref": "BO 100",
    "name": "OXXUXX_On/Off_C",
    "why": "Start/stop indoor unit"
   },
   {
    "ref": "MO 100",
    "name": "OXXUXX_Mode_C",
    "why": "Mode command"
   },
   {
    "ref": "AO 100",
