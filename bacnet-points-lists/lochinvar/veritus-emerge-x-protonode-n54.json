    "name": "System Setpoint",
    "why": "Active system setpoint"
   },
   {
    "ref": "AI 15",
    "name": "System Supply Temperature",
    "why": "System supply water temperature"
   },
   {
    "ref": "AI 19",
    "name": "Tank 1 Temperature",
    "why": "Tank 1 temperature"
   },
   {
    "ref": "BI 6",
