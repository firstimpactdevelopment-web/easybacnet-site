 "equipment_type": "Heat pump water heater plant controller",
 "applies_to": "Lochinvar Veritus and Emerge_X heat pump water heater systems (up to 64 units), read through the ProtoNode FPC-N54.",
 "summary": "Lochinvar's ProtoNode FPC-N54 maps the Veritus / Emerge_X heat pump water heater controller to 54 BACnet objects. Binary inputs give thermostat, BMS enable, louver, recirculation pump, runtime, alarm and backup heat relay states; analog inputs give system and tank temperatures, packed per-unit status words, error codes and flow; eight analog values take BMS commands such as demand enable and tank setpoint.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Veritus and Emerge_X share this one table in the guide (section 9.1).",
  "The table has no read/write column; access is inferred from the object type and the N2 type (AO = writable).",
  "Backup Heat 1/2 and their rates appear both as AIs (43-44, read) and as AVs (51-54, write).",
  "The guide gives no units, ranges or state texts."
 ],
 "integration": {
  "summary": "Map the Demand Enable and Tank Setpoint AVs for control, then read system setpoint and temperatures, tank temperatures, the runtime and alarm relays, the packed units-in-run/lockout words and the SCB error and warning codes. The guide gives no command sequence, so check the Veritus/Emerge_X manual before writing Configuration or the backup heat objects.",
  "minimum_points": [
   {
    "ref": "AV 47",
    "name": "Demand Enable",
    "why": "Demand enable command from the BMS"
   },
   {
