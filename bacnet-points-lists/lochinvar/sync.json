{
 "manufacturer": "Lochinvar",
 "manufacturer_slug": "lochinvar",
 "model": "SYNC",
 "model_slug": "sync",
 "aliases": [
  "SYNC 1.0",
  "SYNC 1.3",
  "SYNC 1.5",
  "SYNC-MODB"
 ],
 "equipment_type": "Dual-heat-exchanger condensing boiler controller",
 "applies_to": "SYNC 1.0, 1.3 and 1.5 condensing boilers (two heat exchangers, reported as unit 1 and unit 2).",
 "summary": "The SYNC boiler has two heat exchangers in one cabinet, so its BACnet MS/TP map repeats the flame, switch, temperature and status points for unit 1 and unit 2. Access is through Lochinvar's Modbus/BACnet communication board.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "630000 + MAC address (base is model dependent and can be changed)",
 "notes": [
  "BACnet needs the optional Lochinvar Modbus/BACnet communication board; address and baud rate are set on its dip switches.",
  "The BACnet board is an MS/TP master only, so MAC addresses 0-127 are usable.",
  "AV 0 (Configuration) is a bitmask: set a bit to 1 to make the appliance use the BAS-written value instead of its own input.",
  "BAS-supplied temperatures must be rewritten every few seconds and other commands at least every 4 minutes, or the unit reverts to local control.",
  "Temperatures are in °C on the bus."
 ],
 "integration": {
  "summary": "Pick the BMS control mode at the boiler, then write AV 0 Configuration so the unit knows which values the BAS will supply. After that the BAS sends an enable, a rate command (AV 2), or both, and keeps rewriting them. Status, temperatures and the status, blocking and lockout codes can be read without taking control.",
  "minimum_points": [
   {
    "ref": "AV 0",
    "name": "Configuration",
    "why": "Tells the unit which inputs come from the BAS; resend before commands"
   },
   {
    "ref": "BV 0",
    "name": "Boiler Enable",
    "why": "Enable / call for heat from the BAS"
   },
   {
    "ref": "AV 2",
    "name": "0-10 Volt Input / Rate Command / Setpoint Command",
    "why": "Rate command: firing % or setpoint, per BMS Type"
   },
   {
    "ref": "AI 8",
    "name": "Outlet Temperature 1",
    "why": "Outlet temperature, heat exchanger 1"
   },
   {
    "ref": "AI 17",
    "name": "Outlet Temperature 2",
    "why": "Outlet temperature, heat exchanger 2"
   },
   {
    "ref": "AI 13",
    "name": "Unit 1 Status Code",
    "why": "Unit 1 status code"
   },
   {
    "ref": "AI 22",
    "name": "Unit 2 Status Code",
    "why": "Unit 2 status code"
   },
   {
    "ref": "AV 5",
    "name": "Outdoor Temperature",
    "why": "Outdoor temperature from the BAS, if used"
   }
  ],
  "enable": "Set Demand Configuration 4, 5 or 6 under Main > Setup > Service/Setup > Demand Config. 4: local setpoints plus BV 0 enable. 5: enable plus AV 2 rate command. 6: AV 2 modulation % alone. Set the matching AV 0 bits first. AV 2 means firing % or temperature setpoint depending on the BMS Type setting (Power or Setpoint); as a setpoint it is scaled like a 0-10 V signal between the BMS temperatures at low and high input.",
  "heartbeat": "If BAS-written temperatures or commands stop arriving, the unit reverts to its own readings and controls. The timeout is set under Main > Setup > BMS > Modbus / BACnet Timeout; the manual gives 5-120 s with a 10 s default in one place and 0-120 s in another. Every write resets it, and Lochinvar recommends the shortest value. Commands without temperatures must be refreshed at least every 4 minutes.",
  "remote_sensors": "Set the AV 0 bits for the values the BAS will supply, then write them to the analog values: AV 3 tank setpoint, AV 4 tank temperature, AV 5 outdoor temperature, AV 6 system supply temperature. Values are in °C. Temperatures must be rewritten every few seconds or the unit returns to its own sensors.",
  "setup": [
   "MAC address from dip switches 1-8 (master only, so 0-127); baud from switches 9-10: 9600, 19200, 38400 or 76800.",
   "Device instance = base 630000 + MAC address; the base can be changed."
  ],
  "gotchas": [
   "The manual says to resend the AV 0 configuration bits before each command.",
   "In a cascade only the Leader needs the BACnet board for control; it then reports cascade totals only, so fit a board to every unit to see each one.",
   "Without BMS mode active the board is monitor-only: the read-only points can be polled while the unit runs on its own controls.",
   "Status, temperature and code points come in pairs for heat exchanger 1 and 2."
  ]
 },
 "source": {
  "title": "Modbus and BACnet Communication Instructions (SYNC 1.0 - 1.3 - 1.5)",
  "doc_number": "SYNC-MODB_100161723_2000017706",
  "revision_date": "Rev L, 05/17",
  "url": "https://assets.lochinvar.com/damroot/Original/10014/594260SYNC-MODB_100161723_2000017706__REV%20L_BACNET.pdf"
 },
