  "unofficial": true,
  "host": "SupplyHouse.com"
 },
 "integration": {
  "summary": "Give the ACP BACnet an IP address and Device ID, let it find the AHU on LG-NET, then read the AHU device (Device ID + 2) at 131072 + address x 256. Map on/off, mode and setpoint, then room, supply and outdoor readings and the alarm.",
