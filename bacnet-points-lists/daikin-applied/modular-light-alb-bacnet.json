 "equipment_type": "Air handling unit controller",
 "applies_to": "Daikin Applied Europe Modular Light (ALB) compact air handling units with the MicroTech controller and EvoLVE / Airstream control software.",
 "summary": "The Modular Light (ALB) air handler uses a MicroTech III or MicroTech 4 controller; BACnet IP comes from a POL908 module and BACnet MS/TP from a POL904 module. The short list covers air temperatures, pressures and flows, fan and coil outputs, fan, temperature, humidity and air-quality setpoints, fan and alarm status, operating mode and summer/winter changeover. Object instances are fixed but non-sequential.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 1,
 "access_inferred": false,
 "notes": [
  "Which objects exist depends on the AHU configuration.",
  "The cover names the control software EvoLVE; the page footers say Airstream.",
  "AV 30105 ActMainSpvClg is printed twice; it is listed once.",
  "ScheduleSt (31059) is printed in its own Schedule table with Off/On/Ventilation/Economy states; it is listed as SCH.",
  "The guide also covers connecting a Daikin iTM (intelligent Touch Manager) over BACnet IP.",
  "The ADK digital AHU (DSTREAM) guide uses the same instance numbers for the shared objects and adds many more."
 ],
