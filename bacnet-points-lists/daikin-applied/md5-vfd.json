 "equipment_type": "Variable frequency drive (HVAC)",
 "applies_to": "Daikin Applied MD5 variable frequency drives (Applied Air Systems) on the built-in RS-485 port with native BACnet MS/TP.",
 "summary": "The MD5 VFD speaks native BACnet MS/TP on its built-in RS-485 port (embedded fieldbus). The object list is fixed: relay and digital input status, relay and analog output commands, run/stop, direction, run enable and override commands, two references, drive measurements, energy and run-time counters, fault history and a parameter mailbox (AV25/AV26 with BV15/BV16). Most commands only act when the matching drive parameter is set to COMM.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "MS/TP MAC ID (5302) when 5311 and 5317 are 0",
 "access_inferred": false,
 "notes": [
  "Observation: the object list, instances and drive parameter numbers match the ABB ACH550 BACnet list, and the manual itself uses ACH550 type codes in its ratings tables, so the MD5 looks like an ACH550-based drive. Daikin does not state this directly.",
  "BI3-BI5 and BO3-BO5 (relays 4-6) need the OREL-01 relay extension option.",
  "AV17 INPUT REF 2 is reference 2 or, with 1106 = PID1 OUT and 4010 = COMM, the process PID setpoint.",
  "KWH (R) and RUN TIME (R) are writable so they can be reset to zero."
 ],
 "integration": {
  "summary": "Set 9802 = BACNET (5), the baud in 5303, the device instance in 5311/5317 and the MAC in 5302 (set 5302 last). Set 1001 = COMM and 1103 = COMM, then command BV10 RUN/STOP CMD and AV16 INPUT REF 1. Read BV0, BV2, AV1, AV4 and AV6, and reset faults with BV14. Set 3018/3019 for comm-loss behaviour.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "name": "RUN/STOP CMD",
    "why": "Start/stop from the BMS"
   },
   {
    "ref": "AV 16",
    "name": "INPUT REF 1",
    "why": "Speed reference in %"
   },
   {
    "ref": "BV 14",
    "name": "FAULT RESET",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 0",
    "name": "RUN/STOP ACT",
    "why": "Running status"
   },
   {
    "ref": "BV 4",
    "name": "HAND/AUTO ACT",
    "why": "Shows if the panel has the drive in Hand"
   },
   {
    "ref": "AV 1",
    "name": "OUTPUT FREQ",
    "why": "Output frequency in Hz"
   },
   {
    "ref": "AV 4",
    "name": "CURRENT",
    "why": "Motor amps"
   },
   {
    "ref": "AV 6",
    "name": "POWER",
    "why": "Drive power in kW"
   },
   {
    "ref": "BV 2",
    "name": "FAULT ACT",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 18",
    "name": "LAST FLT",
    "why": "Most recent fault code"
   }
  ],
  "enable": "Start/stop (BV10) needs parameter 1001 = COMM (EXT1) or 1002 = COMM (EXT2); INPUT REF 1 (AV16) needs 1103 = COMM; run enable (BV12) needs 1601 = COMM; fault reset (BV14) needs 1604 = COMM. BV18 CTL OVERRIDE CMD hands drive control to BACnet from its normal source; panel HAND has priority over it.",
  "heartbeat": "3018 COMM FAULT FUNC sets what the drive does on a communication loss (0 not selected, 1 fault, 2 constant speed 7, 3 last speed) and 3019 COMM FAULT TIME sets the delay before it acts.",
  "remote_sensors": "AV27 EXT PID STPT lets the BMS write the external PID setpoint when 4210 = 19 (INTERNAL).",
  "setup": [
   "9802 COMM PROTOCOL SEL = BACNET (5); 5301 should then read x5xx.",
   "Set 5302 EFB STATION ID = 0 to hold the channel in reset, set 5303 baud and 5311/5317 device instance, then set 5302 to the MAC (1-127 for MS/TP master).",
   "Device instance: 1-65535 in 5311 with 5317 = 0; above that, 5311 + 10000 x 5317. With 5311 and 5317 = 0 the MAC is used.",
   "5316 (MS/TP token counter) should keep increasing when communication works; the Device Object Name is the only writable device property."
  ],
  "gotchas": [
   "BI3-BI5 and BO3-BO5 need the OREL-01 relay option.",
   "BV16 MBOX WRITE writes any drive parameter by number; double-check AV25 before using it.",
   "BV17 LOCK PANEL blocks parameter changes at the keypad.",
   "A new MAC in 5302 only takes effect after a power cycle or after setting 5302 to 0 first."
  ]
 },
