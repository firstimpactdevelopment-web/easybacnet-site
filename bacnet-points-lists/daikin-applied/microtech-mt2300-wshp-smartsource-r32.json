 "equipment_type": "Water source heat pump controller",
 "applies_to": "Daikin SmartSource single/two-stage and two-compressor water source heat pumps with R32 refrigerant and the MicroTech MT2300 controller (models SCH/SDH, SMH/SNH, SSH/STH).",
 "summary": "The MicroTech MT2300 is the controller on Daikin's R32 SmartSource heat pumps. It joins BACnet MS/TP through a separate BACnet communication module, and one object list serves both the SmartSource Series2 and the two-compressor SS2C applications. Points cover setpoints, network overrides for occupancy, mode and space temperature, water and refrigerant temperatures, fan speed, the board's configuration switches, A2L refrigerant-leak inputs and alarm codes.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "3101000 + MS/TP MAC address",
 "access_inferred": false,
 "notes": [
  "Configuration objects (names starting with cp) are stored in flash; the guide warns that repeated writes wear it out.",
  "Network override objects (access C) revert to their default (Null) after a controller reboot.",
  "BI 15-34 report the baseboard and I/O expansion module configuration switches; some switches mean different things on Series2 and SS2C units.",
  "AV 411 is named MacAddress (writable) when address switch S3 is at 255, otherwise MacAddressSwitch (read-only).",
  "MV 2 and MV 5 return the alarm numbers from the guide's alarm table (1-28)."
 ],
 "source": {
  "title": "MicroTech SmartSource WSHP BACnet Network Integration Guide (MT2300, R32)",
  "doc_number": "ED 19129-1",
  "revision_date": "2024-05",
  "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/MT%20SmartSource%20WSHP%20BACnet%20Protocol%20Document%20ED%2019129-1.pdf/"
 },
 "integration": {
  "summary": "Commission the BACnet module (baud, MAC and instance) through its serial menu, then run the unit from the BMS with the network override objects: occupancy (MSV 7 or MSV 8), application mode (MSV 10) and compressor enable (MSV 1). Feed space temperature or a setpoint from the network if needed, and set Receive Heartbeat so overrides drop back when the BMS stops writing.",
  "minimum_points": [
   {
    "ref": "MV 7",
    "name": "OccManCmd",
    "why": "Occupancy override from the BMS"
   },
   {
    "ref": "MV 10",
    "name": "ApplicMode",
    "why": "Application mode (Auto/Heat/Cool/Off/Fan Only/Dehumid)"
   },
   {
    "ref": "MV 1",
    "name": "ComprEnable",
    "why": "Compressor enable, usually from loop flow proof"
   },
   {
    "ref": "AV 19",
    "name": "NetworkSetpoint",
    "why": "Network reference setpoint"
   },
   {
    "ref": "BV 1",
    "name": "ClearAlarm",
    "why": "Clear active fault alarms"
   },
   {
    "ref": "MV 4",
    "name": "McQWSHPStatus",
    "why": "Unit operating state"
   },
   {
    "ref": "AV 22",
    "name": "EffectSpaceTemp",
    "why": "Space temperature used for control"
   },
   {
    "ref": "AI 2",
    "name": "LWT",
    "why": "Leaving water temperature"
   },
   {
    "ref": "MV 2",
    "name": "CurrentAlarm",
    "why": "Highest-priority active alarm"
   }
  ],
  "enable": "No local/remote switch. The network override objects act as soon as they are written: Occupancy Override Input (MSV 7) or Occupancy Scheduler (MSV 8) set occupancy, Application Mode (MSV 10) limits the unit to Auto/Heat/Cool/Off/Fan Only/Dehumid and overrides the room sensor mode switch, and Compressor Enable (MSV 1) permits compressor operation. All revert to Null after a controller reboot.",
  "heartbeat": "Receive Heartbeat (AV 20, cpRcvHrtBt, 0-6553.4 s, default 0 = disabled) sets how long a supported network override may go without being rewritten before it reverts to its default; each supported override has its own timer. Send Heartbeat (AV 21) is not supported by the BACnet module; use COV instead.",
  "remote_sensors": "Write space temperature to AV 18 and space humidity to AV 45; a network dewpoint goes to AV 51. AV 19 sets the reference setpoint only after local setpoint adjust is disabled with MSV 14 = 1. AV 35 shifts the occupied/standby setpoints, MSV 9 takes a network occupancy sensor, MSV 16 overrides the humidistat and MSV 3 the fan On/Auto switch.",
  "setup": [
   "Device instance is System Minimum Instance (AV 412, default 3101000) plus the MS/TP MAC address.",
   "Baud (default 38400) and Max Masters are set from the module's serial menu: DB-9 port, 19200 bps 8-N-1, null-modem cable; press S to save.",
   "With address switch S3 at 255 (factory default) the MAC is acquired during commissioning and can then be changed through AV 411; any other S3 value is used as a fixed MAC.",
   "Max APDU length is fixed at 480."
  ],
  "gotchas": [
   "cp... configuration objects are written to flash; do not write them cyclically.",
   "Network overrides revert to Null on reboot, so the BMS must restore them.",
   "Changing Units (MSV 15) from English to Metric changes the temperature values the BMS reads.",
   "An A2L refrigerant leak or loss of A2L board power puts the unit into an alarm state."
  ]
 },
