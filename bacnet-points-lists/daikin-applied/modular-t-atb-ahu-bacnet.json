 "integration": {
  "summary": "Set Ctrl Source to Network at the unit, then use UnitStatusBMS to command the unit and write the main cool/heat, fan flow and humidity setpoints. Read unit status, the run output, supply and return temperatures and the global alarm output.",
  "minimum_points": [
   {
    "ref": "MV 16534",
    "name": "UnitStatusBMS",
    "why": "Unit status command from the BMS"
   },
   {
    "ref": "AV 30058",
    "name": "MainCoolSetp",
    "why": "Main cooling setpoint"
   },
   {
