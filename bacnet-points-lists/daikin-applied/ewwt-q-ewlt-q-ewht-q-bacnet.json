{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "EWWT-Q / EWLT-Q / EWHT-Q water-cooled scroll chiller (Daikin Applied Europe)",
 "model_slug": "ewwt-q-ewlt-q-ewht-q-bacnet",
 "short_model": "EWWT-Q / EWLT-Q / EWHT-Q",
 "aliases": [
  "EWWT-Q",
  "EWLT-Q",
  "EWHT-Q",
  "EWWTQ",
  "PROXIMA",
  "D-EIGOC00106",
  "WCZ"
 ],
 "equipment_type": "Water-cooled scroll chiller controller",
 "applies_to": "Daikin Applied Europe EWWT-Q water-cooled scroll chillers, EWLT-Q condenserless units and EWHT-Q water-to-water heat pumps with the PROXIMA software (POL486.65 controller), including MUSE multi-unit groups of up to 4 units.",
 "summary": "The EWWT-Q, EWLT-Q and EWHT-Q units run Daikin's PROXIMA software on a POL486.65 controller. BACnet IP is a software option on the Ethernet port, enabled with connectivity kit EKRSCBMS. The list covers unit enable, network mode and cool/heat setpoints, water temperatures, pump status, one refrigerant circuit with two compressors, bit-coded unit and circuit alarm words, and MUSE master/slave data for up to four units.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "PROXIMA",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "This is the Daikin Applied Europe guide; it is a different object list from the US MicroTech chiller documents.",
  "Unit and circuit alarms are packed into 32-bit alarm words (AV 296-299, AV 396-399); the bit meanings are in Annex A of the guide.",
  "AV 151 MUSECtrlTemp is printed twice (once read-only, once writable as the MUSE temperature setpoint); it is listed once as W.",
  "BV 502 is printed twice (CommonLWTSenf and CmnLwtSenf) and BV 503 twice (CndLvgTempSensorFail and CommonCondLWTSenf); each is listed once under its first name, with the other name in the description.",
  "MU2-MU4 and MUSE objects only apply to multi-unit (MUSE) installations.",
  "Units shown are metric as printed; MV 47 Units switches the BACnet values between Imperial and Metric."
 ],
 "source": {
  "title": "BAS Integration guide - BACnet protocol (EWWT-Q/EWLT-Q/EWHT-Q)",
  "doc_number": "D-EIGOC00106-24_02EN_WCZ",
  "revision_date": "2024",
  "url": "https://www.daikinapplied.eu/hubfs/portale-documentale/D_EIGOC00106_24_02EN_WCZ.pdf"
 },
 "integration": {
  "summary": "Select network control at the unit (ChillerLocalRemote BI 3 then reads Network), enable the chiller with ChillerEnableStp and write the network mode and cool/heat setpoints. Monitor unit status, leaving water temperature, the general alarm output and the alarm words.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "ChillerEnableStp",
    "why": "Network enable/disable of the chiller"
   },
   {
    "ref": "MV 3",
    "name": "ChillerOperationMode",
    "why": "Ice / cool / heat mode command"
   },
   {
    "ref": "AV 4",
    "name": "NetworkCoolTempSetpoint",
    "why": "Leaving water cool setpoint from the BMS"
   },
   {
    "ref": "AV 6",
    "name": "NetworkHeatTempSetpoint",
    "why": "Leaving water heat setpoint from the BMS"
   },
   {
    "ref": "BV 8",
    "name": "ClearAlarm",
    "why": "Clear alarms from the network"
   },
   {
    "ref": "BI 3",
    "name": "ChillerLocalRemote",
    "why": "Shows whether network control is active"
   },
   {
    "ref": "MV 1",
    "name": "UnitStatus",
    "why": "Unit run state"
   },
   {
    "ref": "AI 2",
    "name": "LvgEvapWaterTempUnit",
    "why": "Leaving evaporator water temperature"
   },
   {
    "ref": "BI 10",
    "name": "AlarmDigitalOutput",
    "why": "Any active alarm"
   },
   {
    "ref": "AV 299",
    "name": "UnitAlarmsWord1",
    "why": "Unit alarm word 1 (bits per Annex A)"
   }
  ],
  "enable": "ChillerLocalRemote (BI 3) reads 0 = Network / 1 = Local and is read-only over BACnet, so network control has to be selected at the unit; the guide does not describe that step. With network control active the BMS writes ChillerEnableStp (BV 2) = Enable, then the mode (MV 3) and network setpoints.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP runs on the controller's Ethernet port as a software option, supplied with connectivity kit EKRSCBMS.",
   "The onboard RS485 port is for Modbus; this guide does not cover BACnet MS/TP."
  ],
  "gotchas": [
   "Compressor and pump run-hour AVs are marked writable; don't write them from the BMS.",
   "Alarms are bit-coded in the unit and circuit alarm words; decode them with Annex A.",
   "MV 47 Units switches metric/imperial for the BACnet values; set it once, not cyclically.",
   "MV 430/435 set each compressor to Off or Auto; leave them on Auto for normal running."
  ]
 },
