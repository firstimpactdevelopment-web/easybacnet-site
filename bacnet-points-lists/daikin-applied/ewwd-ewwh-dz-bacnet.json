 "integration": {
  "summary": "Set ChillerLocalRemote to Remote, enable the chiller with ChillerEnableStp and write the mode, cool setpoint and capacity limit. Monitor unit status, leaving water temperature, the general alarm and the fault code.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "ChillerEnableStp",
    "why": "Network enable/disable of the chiller"
   },
   {
    "ref": "BI 3",
    "name": "ChillerLocalRemote",
    "why": "Local/remote selection (1 = Remote)"
   },
   {
    "ref": "MV 3",
    "name": "ChillerOperationMode",
    "why": "Ice / cool / heat / pursuit mode command"
   },
   {
    "ref": "AV 4",
    "name": "NetworkCoolTempSetpoint",
    "why": "Leaving water cool setpoint from the BMS"
   },
   {
    "ref": "AV 3",
    "name": "NetworkCapacityLimitPct",
    "why": "Capacity limit from the BMS, %"
   },
   {
    "ref": "BV 8",
    "name": "ClearAlarm",
    "why": "Clear alarms from the network"
   },
   {
    "ref": "MV 1",
    "name": "UnitStatus",
    "why": "Chiller run state"
   },
   {
    "ref": "AI 2",
    "name": "LvgEvapWaterTempUnit",
    "why": "Leaving chilled water temperature"
   },
   {
    "ref": "BI 10",
    "name": "AlarmDigitalOutput",
    "why": "Unit general alarm"
   },
   {
    "ref": "AV 905",
    "name": "AVFaultAlarmCode",
    "why": "Active fault alarm code"
   }
  ],
  "enable": "ChillerLocalRemote (BI 3, 0 = Local / 1 = Remote) is marked R/W in this guide; with Remote selected the BMS writes ChillerEnableStp (BV 2) = Enable, then the mode (MV 3) and network setpoints.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP comes from the POL908 module and BACnet MS/TP from the POL904 module.",
   "BACnet IP module defaults: device instance 1, UDP port 47808, DHCP off; set Apply Changes = Yes after editing, which restarts the controller.",
   "BACnet MS/TP module defaults: MAC address 24, 38400 baud, Max Master 127, Max Info Frames 1; the device instance is derived from the production number and date code."
  ],
  "gotchas": [
   "Alarms come as Warning, Problem and Fault index/code AVs (900-905); the fault code table (Annex 1) is in the guide.",
   "AV 175 CurrentLimSetpNtw is a current (A) limit; the main BMS capacity limit is AV 3 (%).",
   "Objects for compressor 3 only apply to three-compressor units."
  ]
 },
