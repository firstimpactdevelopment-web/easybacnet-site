{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "MicroTech Unit Ventilator Controller",
 "model_slug": "microtech-unit-ventilator",
 "aliases": [
  "MicroTech UV",
  "MTUC_UV",
  "Daikin unit ventilator",
  "ED 19110"
 ],
 "equipment_type": "Unit ventilator controller (classroom air handler)",
 "applies_to": "Daikin Applied unit ventilators with the MicroTech UV unit controller and its on-board BACnet MS/TP port.",
 "summary": "The MicroTech UV controller has BACnet MS/TP built in (LonWorks needs an add-on module and is not listed here). Objects cover local and network space, water, discharge and outdoor readings, occupancy setpoints and differentials, compressor, valve, damper, economizer and electric heat tuning, PI loop gains, network inputs for space temperature, setpoint, humidity, CO2 and fan speed, occupancy, application mode and emergency commands, unit state and the current alarm. Many objects only apply to certain unit configurations (compressor, hydronic, electric heat, economizer).",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Application 1.05.00 (PICS)",
 "default_device_instance": "3101120 (System Minimum Instance 3101000 + MAC 120)",
 "access_inferred": false,
 "notes": [
  "BACnet MS/TP only; the same guide also covers an optional LonWorks module, which is not listed here.",
  "Network overrides return to their default (Null/invalid 32767) after a controller reset, so the BMS must write them again.",
  "Points stored in non-volatile memory (setpoints, differentials, gains, enables) have a limited write life; non-volatile values are saved every 20 minutes.",
  "Some AIs and AVs pass whole numbers only; a fractional write is rounded to the nearest integer.",
  "Current Alarm (MV 2) returns the alarm number; the alarm list is in the Alarms section of the guide."
 ],
 "source": {
  "title": "MicroTech Unit Ventilator Unit Controller Protocol Information (BACnet MS/TP, LonWorks)",
  "doc_number": "ED 19110-6",
  "revision_date": "2022-03",
  "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/MicroTech%20UV%20Unit%20Controller%20Protocol%20Information%20ED%2019110-6.pdf/"
 },
 "integration": {
  "summary": "Give the controller a unique MAC address and device instance, then command occupancy, application mode and, if the BMS owns it, the network setpoint. Read Unit State, the effective space temperature and Current Alarm. Network overrides are cleared by a controller reset, so the BMS has to rewrite them.",
  "minimum_points": [
   {
    "ref": "MV 7",
    "name": "OccManCmd",
    "why": "Occupancy override from the BMS"
   },
   {
    "ref": "MV 8",
    "name": "OccSchedule",
    "why": "Occupancy schedule command (Occ/Unocc/Standby)"
   },
   {
    "ref": "MV 21",
    "name": "EmergOverride",
    "why": "Emergency mode (Normal/Shutdown/Purge/Fire...)"
   },
   {
    "ref": "MV 17",
    "name": "NetworkApplicMode",
    "why": "Application mode (Auto/Heat/Cool/Off/Fan_Only/Dehumid)"
   },
   {
    "ref": "AV 19",
    "name": "NetworkSetpoint",
    "why": "Network reference setpoint"
   },
   {
    "ref": "BV 1",
    "name": "ClearAlarm",
    "why": "Clear the current alarm"
   },
   {
    "ref": "MV 42",
    "name": "UnitState",
    "why": "Current operating state"
   },
   {
    "ref": "AV 22",
    "name": "EffectSpaceTemp",
    "why": "Space temperature used for control"
   },
   {
    "ref": "AV 38",
    "name": "FanSpeed",
    "why": "Fan speed output, 0-100 %"
   },
   {
    "ref": "MV 2",
    "name": "CurrentAlarm",
    "why": "Highest-priority active alarm"
   }
  ],
  "enable": "No local/remote switch is described. Network inputs take effect when written: Occupancy Override Input (MV 7) overrides the other occupancy inputs, Occupancy Scheduler Input (MV 8) sets the scheduled mode, Application Mode (MV 17) limits heating/cooling/dehumidification, Emergency Override (MV 21) forces an emergency mode, and Compressor Enable (MV 1) permits compressor operation (Null = enabled). All of these revert to their defaults after a controller reset.",
  "heartbeat": "No BACnet heartbeat. Receive Heartbeat is a LonWorks-only setting. BACnet network overrides stay in place until the controller resets, then revert to their defaults.",
  "remote_sensors": "Network Space Temperature Input (AV 18) replaces the local sensor when valid; Effective Space Temperature (AV 22) shows the value in use. Network Temperature Setpoint Input (AV 19) sets the reference setpoint and AV 35 offsets it; AV 129-132 shift the occupied and standby setpoints. Network inputs also exist for outdoor temperature (AV 45), outdoor and space humidity (AV 48, AV 50), space CO2 (AV 52), entering water temperature (AV 113), minimum OA damper position (AV 70) and fan speed (AV 115).",
  "setup": [
   "Defaults: MAC address 120 (AV 411), device instance 3101120 = System Minimum Instance (AV 412, default 3101000) + MAC, 38400 baud, Max Master 127.",
   "MS/TP baud (9600, 19200, 38400 or 76800) is set from the LUI keypad or ServiceTools; speeds above 38400 need tested wiring.",
   "Device name defaults to MTUC_UV-3101120 and can be set from the BAS, ServiceTools or the keypad.",
   "Set Max Master to the highest MS/TP master address on the segment to cut token traffic."
  ],
  "gotchas": [
   "Non-volatile objects (setpoints, differentials, PI gains, enables) have a limited write life; do not write them cyclically.",
   "Network overrides revert to default (Null or 32767) after a controller reset, so the BMS must restore them.",
   "Some analog objects only hold whole numbers; fractional writes are rounded.",
   "Setpoint Method (MV 44) selects Easy or Advanced setpoint calculation; Advanced is the default and recommended.",
   "Over BACnet, Current Alarm (MV 2) reads 1 when no alarm is active (LonWorks uses 0)."
  ]
 },
