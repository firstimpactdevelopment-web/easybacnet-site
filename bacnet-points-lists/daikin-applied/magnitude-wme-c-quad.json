{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "Magnitude WME-C QUAD Chiller (MicroTech WME controller)",
 "model_slug": "magnitude-wme-c-quad",
 "aliases": [
  "WME-C QUAD",
  "WME QUAD",
  "Magnitude WME",
  "MicroTech WME",
  "ED 19111-4"
 ],
 "equipment_type": "Chiller controller",
 "applies_to": "Magnitude WME-C QUAD magnetic-bearing centrifugal chillers (two circuits, four compressors) with the MicroTech WME unit controller.",
 "summary": "The QUAD version of the Magnitude WME-C has two refrigerant circuits with two compressors each, and its MicroTech unit controller adds circuit 2 compressor objects, per-compressor Off/Auto commands and alarm module objects to the WME BACnet table. It talks BACnet IP, BACnet MS/TP or Modbus through the BAS communication module. Control works the same as the other WME chillers: network enable, mode, cool setpoint and capacity limit, plus water temperatures, flows, refrigerant data, run hours and alarm indices.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "Chiller application 1.0.0 (QUAD) or later",
 "default_device_instance": 9050,
 "access_inferred": false,
 "notes": [
  "ED 19111-4 covers WME C and D vintage and WME-C QUAD in one table. The C/D-vintage subset matches the WME C-vintage list (ED 19111-1); this entry is the QUAD set.",
  "The alarm code objects AV 903 and AV 905 are left out: the doc says WME-C QUAD does not use alarm codes. Use the alarm index and alarm module objects instead.",
  "Per the doc's model table the alarm module objects (AV 909-914) and Compressor Off/Auto (MV 100, 101, 106, 107) apply to QUAD; Off/Auto on a WME-C needs application code 1.2.4 or newer.",
  "Only Cool mode applies even though the mode objects list Ice, Heat and Heat Recovery.",
  "Units (MV 4) switches the values sent to BACnet between English and Metric; English is the default.",
  "Run hours and starts are listed only for circuit 1 compressors; condenser and evaporator pump hours for pumps 1 and 2."
 ],
 "source": {
  "title": "MicroTech Unit Controller Protocol Information - Chiller Model WME, C and D-Vintage, and WME-C QUAD",
  "doc_number": "ED 19111-4",
  "revision_date": "2026-03",
  "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/19111-4.pdf"
 },
 "integration": {
  "summary": "At the chiller HMI set Control Source to BAS (for the network enable) and Remote Enable to Enable (for setpoint, mode and capacity limit). The BMS then writes ChillerEnableStp, the cool setpoint and capacity limit, and reads status, water temperatures and the alarm index objects.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "ChillerEnableStp",
    "why": "Network enable/disable of the chiller"
   },
   {
    "ref": "MV 3",
    "name": "ChillerOperationMode",
    "why": "Mode command; only 2 = Cool applies on WME"
   },
   {
    "ref": "AV 4",
    "name": "NetworkCoolTempSetpoint",
    "why": "Leaving water cool setpoint from the BMS"
   },
   {
    "ref": "AV 3",
    "name": "NetworkCapacityLimitPct",
    "why": "Capacity limit from the BMS"
   },
   {
    "ref": "BV 8",
    "name": "ClearAlarm",
    "why": "Clear alarms from the network"
   },
   {
    "ref": "BI 3",
    "name": "ChillerLocalRemote",
    "why": "Shows whether network control is active"
   },
   {
    "ref": "MV 1",
    "name": "UnitStatus",
    "why": "Chiller run state"
   },
   {
    "ref": "AI 2",
    "name": "LvgEvapWaterTempUnit",
    "why": "Leaving chilled water temperature"
   },
   {
    "ref": "AV 2",
    "name": "ChillerCapacity",
    "why": "Actual capacity in percent"
   },
   {
    "ref": "AV 901",
    "name": "AVFaultAlarm",
    "why": "Active fault alarm index"
   }
  ],
  "enable": "Control Source must be set to BAS at the unit HMI for the controller to use Network Enable (BV 2). For the cool setpoint, mode and capacity limit, Remote Enable must also be set to Enable at the HMI. Writing Enable to BV 2 only allows a start if other conditions are met. Individual compressors can be taken out of service from the network with the Compressor Off/Auto objects (MV 100, 101, 106, 107).",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Default device instance 9050; default device object name Daikin_MicroTech_ plus the instance. Cycle power on the BAS module after changing the instance.",
   "BACnet IP defaults: IP 192.168.1.10, mask 255.255.255.0, gateway 192.168.1.1, UDP port 47808.",
   "BACnet MS/TP defaults: MAC 1, 38400 baud, Max Master 127, Max Info Frames 10.",
   "Network parameters are set at the HMI; see IM 1283 for the communication module."
  ],
  "gotchas": [
   "Only Cool mode applies, although the mode objects list Ice, Heat and Heat Recovery.",
   "Units (MV 4) changes the units sent to BACnet between English and Metric.",
   "Compressor Off/Auto objects return to Auto after a controller power cycle.",
   "WME-C QUAD has no alarm code objects; read the alarm index and alarm module objects.",
   "Some compressor-shutdown and freeze alarms cannot be cleared from the network."
  ]
 },
