{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "Compact air handler, Fujin Comfort software (Daikin Applied Europe)",
 "model_slug": "compact-fujin-comfort-ahu-bacnet",
 "aliases": [
  "Compact",
  "Daikin Compact AHU",
  "Fujin Comfort",
  "D-EIGOC00101-25_00EN"
 ],
 "equipment_type": "Air handling unit controller",
 "applies_to": "Daikin Applied Europe Compact air handling units with the Fujin Comfort controller software, including units with an ERQ condensing unit.",
 "summary": "The Compact air handler (Fujin Comfort software) takes a POL908 module for BACnet IP or a POL904 module for BACnet MS/TP. The list covers temperatures, filter and fan pressures, humidity, CO2 and IEQ sensors, damper, fan, coil and humidifier signals, comfort and economy setpoints for temperature, flow, pressure, humidity and air quality, filter, fan-communication, ERQ and R-32 leak alarms, outputs, a unit status multistate, network on/off and cool/heat commands and alarm classes. Object instances are fixed but non-sequential.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Which objects exist depends on the AHU configuration (optional sensors and filters, pre/post coils, humidifier, ERQ).",
  "UnitStatusMS (MV 58347) is printed with states numbered from 0; numbers marked \"-\" in the guide are left out.",
  "Multistate commands use the printed text order starting at 1 (e.g. NetworkCtrl 1 = Off, 2 = On, 3 = Ventilation, 4 = Economy, 5 = Scheduler).",
  "CoHeSwtc is printed as both BI 54908 and BO 54908.",
  "Daikin France (Easyspec) publishes this guide as a PDF inside a zip together with the Modbus guide."
 ],
 "source": {
  "title": "BAS Integration Guide - BACnet protocol (Compact, Fujin Comfort)",
