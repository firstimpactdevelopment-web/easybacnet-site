 ],
 "equipment_type": "Chiller controller",
 "applies_to": "Magnitude WME C-vintage magnetic-bearing centrifugal chillers with the MicroTech WME unit controller.",
 "summary": "The MicroTech WME chiller unit controller on C-vintage Magnitude chillers supports BACnet MS/TP, BACnet IP and Modbus through its BAS communication module. The BACnet table is short and focused: water temperatures and flows, per-compressor current, power, voltage and refrigerant data for two compressors, alarm codes, run hours and starts, plus network enable, mode, cool setpoint and capacity limit.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "Chiller application 1.1.6, HMI 1.3.10 or later",
 "default_device_instance": 9050,
 "notes": [
  "Default device object name is Daikin_MicroTech_ followed by the device instance.",
  "Network enable, mode and setpoints are only used when the control source is set to BAS at the HMI.",
  "Only Cool mode applies to WME-C even though the mode objects list Ice, Heat and Heat Recovery.",
  "Units (MV 4) switches the values sent to BACnet between English and Metric; English is the default."
 ],
 "source": {
  "title": "MicroTech WME, C-vintage Chiller Unit Controller Protocol Information",
  "doc_number": "ED 19111-1",
  "revision_date": "2020-05",
  "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/MicroTech%20WME%20Chiller%20Unit%20Controller%20Protocol%20Information%20-%20ED%2019111-1.pdf"
 },
 "integration": {
  "summary": "At the chiller HMI set Control Source to BAS (for the network enable) and Remote Enable to Enable (for setpoint, mode and capacity limit). The BMS then writes ChillerEnableStp, the cool setpoint and capacity limit, and reads status, water temperatures and alarm codes.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "ChillerEnableStp",
    "why": "Network enable/disable of the chiller"
   },
   {
    "ref": "MV 3",
    "name": "ChillerOperationMode",
    "why": "Ice / cool / heat / heat recovery mode command"
   },
   {
    "ref": "AV 4",
    "name": "NetworkCoolTempSetpoint",
    "why": "Leaving water cool setpoint from the BMS"
   },
   {
    "ref": "AV 3",
    "name": "NetworkCapacityLimitPct",
    "why": "Capacity limit from the BMS"
   },
   {
    "ref": "BV 8",
    "name": "ClearAlarm",
    "why": "Clear alarms from the network"
   },
   {
    "ref": "BI 3",
    "name": "ChillerLocalRemote",
    "why": "Shows whether network control is active"
   },
   {
    "ref": "MV 1",
    "name": "UnitStatus",
    "why": "Chiller run state"
   },
   {
    "ref": "AI 2",
    "name": "LvgEvapWaterTempUnit",
    "why": "Leaving chilled water temperature"
   },
   {
    "ref": "AV 2",
    "name": "ChillerCapacity",
    "why": "Actual capacity in percent"
   },
   {
    "ref": "AV 905",
    "name": "AVFaultAlarmCode",
    "why": "Active fault alarm code"
   }
  ],
  "enable": "Control Source must be set to BAS at the unit HMI for the controller to use Network Enable (BV 2). For the cool setpoint, mode and capacity limit setpoints, Remote Enable must also be set to Enable at the HMI. Writing Enable to BV 2 only allows a start if other conditions are met.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Default device instance 9050; default device object name Daikin_MicroTech_ plus the instance.",
   "BACnet IP defaults: IP 192.168.1.10, mask 255.255.255.0, gateway 192.168.1.1, UDP port 47808.",
   "BACnet MS/TP default baud 38400.",
   "Network parameters are set at the HMI; see IM 1283 for the communication module."
  ],
  "gotchas": [
   "Only Cool mode applies to WME-C, although the mode objects list Ice, Heat and Heat Recovery.",
   "Units (MV 4) changes the units sent to BACnet between English and Metric.",
   "Some compressor-shutdown alarms cannot be cleared from the network."
  ]
 },
