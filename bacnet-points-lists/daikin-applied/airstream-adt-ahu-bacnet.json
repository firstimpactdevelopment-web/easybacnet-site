{
 "manufacturer": "Daikin Applied",
 "manufacturer_slug": "daikin-applied",
 "model": "Airstream ADT air handler (Daikin Applied Europe)",
 "model_slug": "airstream-adt-ahu-bacnet",
 "aliases": [
  "ADT",
  "Airstream",
  "Daikin ADT AHU",
  "D-EIGOC00104-25_01"
 ],
 "equipment_type": "Air handling unit controller",
 "applies_to": "Daikin Applied Europe ADT air handling units with the MicroTech controller and Airstream software, including units paired with ERQ outdoor condensing units.",
 "summary": "The ADT air handler runs Airstream software on a MicroTech controller; BACnet IP comes from a POL908 module and BACnet MS/TP from a POL904 module. The list covers air temperatures, pressures and flows, fan and coil outputs, fan, temperature, humidity and air-quality setpoints, ERQ condensing-unit load, defrost and R-32 leak status, alarms, operating mode and summer/winter changeover. Object instances are fixed but non-sequential.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Which objects exist depends on the AHU configuration.",
  "Most objects share instance numbers with the Modular Light (ALB) and ADK guides; the ERQ load, defrost, alarm and R-32 leakage objects are specific to this guide.",
  "ScheduleSt (31059) is printed in its own Schedule table; it is listed as SCH.",
  "The MS/TP device instance is derived from the production number and date code.",
  "The guide also covers connecting a Daikin iTM (intelligent Touch Manager) over BACnet IP."
 ],
 "source": {
  "title": "BAS Integration Guide - BACnet protocol (ADT, Airstream)",
