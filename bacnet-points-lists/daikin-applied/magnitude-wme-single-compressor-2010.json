 "equipment_type": "Magnetic bearing centrifugal chiller controller",
 "applies_to": "Daikin McQuay Magnitude WME single-compressor magnetic bearing centrifugal chillers with the original (2010) Magnitude chiller unit controller.",
 "summary": "The 2010 Magnitude chiller unit controller on single-compressor WME chillers exposes 55 BACnet objects through a BACnet IP, BACnet Ethernet or BACnet MS/TP communication module (LonWorks is the other option). The list covers network enable, mode, cool/heat/ice setpoints and capacity limit, water temperatures and flows, compressor current, voltage, power and refrigerant data, pump status and run hours, and three alarm-number values.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 30003,
 "access_inferred": false,
 "notes": [
  "This is the older single-compressor WME document (April 2010). The C-vintage WME list (ED 19111-1) shares 49 of these 55 instances (4 with different names); this one adds heat and ice network setpoints, heat recovery temperatures, outdoor air temperature and a problem-alarm value.",
  "Object names come from the guide's detailed point pages; the summary table lists only property names.",
  "BI 4 (Chiller On Off) and BI 5 (Run Enabled) are both printed with the object name UnitOFF.",
  "The summary table lists the compressor discharge saturated temperature as AV 26; its detail page shows it as an Analog Input.",
  "The alarm section of the guide also mentions a BO 5 alarm output and a BV 42 ClearAlarm; the point table and detail pages use BI 10 AlarmDigitalOutput and BV 8 ClearAlarm, which are listed here.",
  "BACnet Ethernet (ISO 8802-3) is also offered as a module option."
 ],
 "source": {
  "title": "Magnitude Chiller Unit Controller Protocol Information, BACnet Networks (MS/TP, IP, Ethernet), LonWorks Networks",
  "doc_number": "ED 15117",
  "revision_date": "2010-04",
  "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/ED15117.pdf"
 },
 "integration": {
  "summary": "At the chiller touch screen set the BAS protocol and then Control Source to BAS. The BMS enables the chiller with ChillerEnableStp, writes mode, cool setpoint and capacity limit, and reads status, water temperatures, the alarm output and the fault alarm number.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "ChillerEnableStp",
    "why": "Network enable/disable of the chiller"
   },
   {
    "ref": "MV 3",
    "name": "ChillerOperationMode",
    "why": "Ice / cool / heat mode command"
   },
   {
    "ref": "AV 4",
    "name": "NetworkCoolTempSetpoint",
    "why": "Leaving water cool setpoint from the BMS"
   },
   {
    "ref": "AV 3",
    "name": "NetworkCapacityLimitPct",
    "why": "Capacity limit from the BMS"
   },
   {
    "ref": "BV 8",
    "name": "ClearAlarm",
    "why": "Clear alarms from the network"
   },
   {
    "ref": "BI 3",
    "name": "ChillerLocalNetwork",
    "why": "Shows whether network control is active"
   },
   {
    "ref": "MV 1",
    "name": "UnitStatus",
    "why": "Chiller run state"
   },
   {
    "ref": "AI 2",
    "name": "LvgEvapWaterTempUnit",
    "why": "Leaving chilled water temperature"
   },
   {
    "ref": "BI 10",
    "name": "AlarmDigitalOutput",
    "why": "Any active alarm"
   },
   {
    "ref": "AV 901",
    "name": "AVFaultAlarm",
    "why": "Highest active fault alarm number"
   }
  ],
  "enable": "On the OITS panel set Control Source to USER, choose the BAS protocol on the SET/BAS screen, check the chiller runs, then set Control Source to BAS. The BMS then writes ChillerEnableStp (BV 2) and the network mode and setpoints.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP defaults: IP 172.15.5.82, mask 255.255.255.0, UDP port 47808, device instance 30003.",
   "BACnet MS/TP defaults: MAC address 1, 38400 baud, device instance 30003, Max Master 127.",
   "Device instance (0-4194302) and object name are set on the OITS panel; if the stored instance is invalid the module falls back to 3000 + address.",
   "MAC address and baud rate can only be set at the OITS panel and must be set before communication starts."
  ],
  "gotchas": [
   "Alarm values show only the highest-numbered active alarm of each class; 0 means none.",
   "BV 8 ClearAlarm returns to 0 once the alarms clear. Low evaporator pressure, high condenser pressure, freeze protection and high motor temperature alarms can only be cleared at the chiller.",
   "MV 4 Units switches the BACnet values between English and metric; set it once."
  ]
 },
