 "model_slug": "self-cleaning-system-panel",
 "aliases": [
  "CaptiveAire SCS",
  "Self Cleaning System",
  "Hood wash panel",
  "Hot Water Wash",
  "Cold Water Mist",
  "ECPM03",
  "Protocessor"
 ],
 "equipment_type": "Kitchen hood self-cleaning wash system control panel",
 "applies_to": "CaptiveAire Self Cleaning System panels that hot-water wash or cold-water mist kitchen exhaust hoods and plenums, and can also run the hood's fan and light zones.",
 "summary": "The CaptiveAire Self Cleaning System (SCS) is a wall-mounted panel with a water manifold, wash solenoids and a surfactant pump that washes kitchen exhaust hoods (hot water wash) or sprays cold water mist while cooking. Its ECPM03 board can also run two exhaust/supply fan zones and two light zones and monitor fire, kill/tamper switch, overloads and PCU filters. BACnet IP or MS/TP comes from a factory-mounted Protocessor gateway set at the factory for one of the two. The 131 objects are read-only temperatures, 'on by' reason flags, faults and PCU alarms, plus seven button BVs for fans, lights and wash.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "50000 (manual text); 50001 (configuration screenshot)",
 "access_inferred": false,
 "notes": [
  "The manual's text gives device instance 50000 and MS/TP MAC 127, but its configuration screenshot shows 50001 and 51; check the gateway.",
  "The points table lists every object as Monitor; the seven button BVs (125-131) are shown writable here because the manual says fans, lights and wash can be run from the BMS and the LonWorks list has matching nvi inputs.",
  "The table's units column is offset: BIs 44-73 show Hz/Amps/KW, which can't apply to binary objects, so those units are left blank.",
  "AI 39-42 (fan zone 'on by' flags) and BI 97 ModbusFaultCode are typed as printed; the DCV guide lists ModbusFaultCode as an AI.",
  "The manual does not explain the Z1/Z2 suffix on the fault BIs (71-96).",
  "Fan and light control only exist when wash is set to Local; in Remote wash the panel only monitors."
 ],
 "source": {
  "title": "Self Cleaning System Control Panel Installation, Operation, and Maintenance Manual",
  "doc_number": "A0017476",
  "revision_date": "February 2025 Rev. 13",
  "url": "https://www.captiveaire.com/manuals/electrical/scs-oim.pdf"
 },
 "integration": {
  "summary": "Map the fan, light and wash button BVs for control, confirm with the FanZoneONbyBMS and LightONbyBMS flags, and monitor the fire, KTS, overload, surfactant and Modbus faults. A BMS wash runs once at any time, regardless of whether the fans are on, so the BMS should check the fan state first.",
  "minimum_points": [
   {
    "ref": "BV 125",
    "name": "FansONButtonZone1",
    "why": "Zone 1 fans button, BMS fan start"
   },
   {
    "ref": "BV 129",
    "name": "WashButtonZone1",
    "why": "Zone 1 wash button; runs even with fans on"
   },
   {
    "ref": "BI 44",
    "name": "FanZoneONbyBMS1",
    "why": "Confirms zone 1 fans are on by BMS command"
   },
   {
    "ref": "AI 33",
    "name": "Temperature Zone 1",
    "why": "Zone 1 temperature, °F"
   },
   {
    "ref": "BI 71",
    "name": "FaultFireZ1",
    "why": "Fire system tripped"
   },
   {
    "ref": "BI 73",
    "name": "FaultKTSZ1",
    "why": "Kill/tamper switch (KTS) tripped"
   },
   {
    "ref": "BI 74",
    "name": "FaultOverloadZoneOneZ1",
    "why": "Fan zone 1 overload tripped"
   },
   {
    "ref": "BI 76",
    "name": "FaultSurfactantLowZ1",
    "why": "Surfactant tank low"
   },
   {
    "ref": "BI 97",
    "name": "ModbusFaultCode",
    "why": "Modbus fault (typed BI despite 'Code' in the name)"
   }
  ],
  "enable": "Fans may be started via BACnet, LonWorks or CASlink, but fan and light zones only exist when the wash operation is set to Local; in Remote wash the ECPM03 only monitors. With 'Lights With Fan' enabled the lights follow the fans; otherwise the HMI button or BMS can switch them.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Protocessor default device instance 50000 and MS/TP MAC 127 per the text (screenshot shows 50001 / 51), 38400 baud, Max Master 127.",
   "Protocessor default IP 192.168.1.24 /255.255.255.0; web configurator login admin/admin (or the password printed by the Ethernet port).",
   "The gateway is factory set to either BACnet IP or MS/TP for the job; objects are only reachable on that port.",
   "Each changed gateway parameter needs its own Submit and a system restart."
  ],
  "gotchas": [
   "A BMS wash ignores the fan state; scheduled and button washes are skipped while fans run.",
   "A fire condition stops any wash, drops gas and the kill switch output and fires the shunt trip; fans and lights follow the fire settings.",
   "The controller board reboots when some factory settings are changed.",
   "Temperatures are listed in °F."
  ]
 },
