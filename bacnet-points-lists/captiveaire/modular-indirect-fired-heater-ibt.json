 "equipment_type": "Make-up air unit (indirect gas-fired heater)",
 "applies_to": "CaptiveAire modular indirect-fired make-up air heaters, modules and furnace inserts run by the IBT controller with the optional Protocessor BACnet gateway.",
 "summary": "CaptiveAire's modular indirect-fired heaters use an IBT burner board plus a unit controller with HMIs. A factory-wired Protocessor gateway gives BACnet IP or BACnet MS/TP access to heat, cool and fan commands, the occupied/unoccupied setpoints and factory settings, temperatures, VFD data and up to six active alert codes. Setpoints and sensor values are raw integers the BMS must scale.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 50000,
 "access_inferred": true,
 "notes": [
  "The table has a Function column (Control, Monitor/Control, Monitor) instead of read/write; Control and Monitor/Control objects are shown as writable, Monitor objects as read-only.",
  "Temperatures and temperature setpoints are sent as value x10 (450 = 45.0 °F); frequencies x10, volts x100, amps x10, kW x100, as marked in each description. Temperatures are in °F or °C depending on the unit's Temp Units factory setting (°F shown here).",
  "HeatCommand, CoolCommand and FanCommand only work when the heating and/or cooling tempering mode is set to DDC at the unit HMI; heat and cool cannot both be called.",
  "Object 71 is printed as 'AnalogHeatControl 0-10V' (with a space).",
  "Alert codes (0 = no fault) are listed in the manual's IBT DDC fault code table.",
  "Many settings depend on the options built into the unit (evaporative cooler, DX stages, mixing box, ECM or VFD supply fan)."
 ],
 "source": {
  "title": "Modular Indirect Fired Heaters and Inserts - Installation, Operation, and Maintenance Manual (Appendix B - IBT DDC Points)",
  "doc_number": "A0016988",
  "revision_date": "February 2024 Rev. 42",
  "url": "https://www.captiveaire.com/manuals/makeupair/ibt-heater-oim.pdf"
 },
 "integration": {
  "summary": "Set the heating and/or cooling tempering mode to DDC at the unit HMI before using the BMS commands; then write HeatCommand, CoolCommand and FanCommand. Otherwise leave the unit on its own setpoints and use DDCOccupiedOverride to force occupied mode. Scale setpoints x10 when writing and divide sensor values by 10 when reading; watch UnitStatus and the six alert codes.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "HeatCommand",
    "why": "Heat on/off when heat mode is DDC (1 = on)"
   },
   {
    "ref": "BV 2",
    "name": "CoolCommand",
    "why": "Cool on/off when cool mode is DDC (1 = on)"
   },
   {
    "ref": "BV 3",
    "name": "FanCommand",
    "why": "Fan on/off in DDC mode (1 = on)"
   },
   {
    "ref": "BV 60",
    "name": "DDCOccupiedOverride",
    "why": "Occupied override from the BMS (1 = on)"
   },
   {
    "ref": "AV 32",
    "name": "DischHeatOccSP",
    "why": "Occupied discharge heat setpoint, °F x10"
   },
   {
    "ref": "AI 91",
    "name": "UnitStatus",
    "why": "0 idle, 1 heating, 2 cooling, 3 blower only"
   },
   {
    "ref": "AI 76",
    "name": "DischargeTemp",
    "why": "Discharge air temperature"
   },
   {
    "ref": "AI 74",
    "name": "OATemp",
    "why": "Outdoor air temperature, °F x10"
   },
   {
    "ref": "AI 85",
    "name": "AlertCode1",
    "why": "First active alert code (0 = no fault)"
   }
  ],
  "enable": "Set the heating and/or cooling tempering mode to DDC through the unit HMI; this turns off temperature-based activation and lets HeatCommand, CoolCommand and FanCommand run the unit. The fan command only works in DDC mode.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The Protocessor is factory set to one field protocol (BACnet IP or MS/TP); objects are reachable only on that port.",
   "Protocessor defaults: device instance 50000, MS/TP MAC 127, 38400 baud; change them in the Protocessor web configurator (Configure > Profile Configuration).",
   "Protocessor default IP 192.168.1.24; change it under Diagnostics and Debugging > Setup > Network Settings."
  ],
  "gotchas": [
   "All setpoints and temperatures are raw values x10; write 750 for 75.0 °F.",
   "Heating and cooling cannot be commanded at the same time.",
   "The controller board reboots when some factory settings are changed."
  ]
 },
