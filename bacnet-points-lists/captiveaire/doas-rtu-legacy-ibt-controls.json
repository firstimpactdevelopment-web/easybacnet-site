 "equipment_type": "DOAS rooftop unit",
 "applies_to": "CaptiveAire DOAS RTU Series packaged rooftop units built with the older IBT-based unit controls (listed as 'Paragon - IBT Controls (Legacy)').",
 "summary": "This is the BACnet object table for CaptiveAire's earlier DOAS RTU Series controls, read through a factory-wired Protocessor gateway on BACnet IP or BACnet MS/TP. It has heat, cool and fan commands, occupied and unoccupied setpoints, a two-period weekly schedule, sensor and refrigerant readings, VFD data and six active alert codes. Units with the current Paragon MUA controls use a different list.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 50000,
 "access_inferred": true,
 "notes": [
  "The table has a Function column (Monitor/Control or Monitor) instead of read/write; Monitor/Control objects are shown as writable, Monitor objects as read-only.",
  "Temperatures and temperature setpoints are raw values x10 (450 = 45.0 °F); frequencies x10, volts x100, amps and kW as marked in each description. Temperatures are in °F or °C depending on the unit's Temp Units factory setting (°F shown here).",
  "Object 4 AnalogHeatCool is printed as a Binary Value with a 0-1000 range; it is kept as printed.",
  "Object 72 is printed as 'TuesdayStartAB'; it is the Tuesday period B start.",
  "Schedule times are minutes after midnight (480 = 8 AM); 1440 means no schedule for that period.",
  "Alert codes (0 = no fault) are listed in the manual's DDC Faults table."
 ],
 "source": {
  "title": "Packaged Rooftop Unit - DOAS RTU Series - Installation, Operation, and Maintenance Manual (DDC Control Points)",
  "doc_number": "A0026936",
  "revision_date": "March 2021 Rev 18",
  "url": "https://www.captiveaire.com/manuals/makeupair/doas-oim.pdf"
 },
 "integration": {
  "summary": "To run the unit from the BMS, set the heating and/or cooling tempering mode to DDC at the unit HMI, then write HeatCommand, CoolCommand and FanCommand. Otherwise leave the unit on its own setpoints and use DDCOccupiedOverride for occupancy. Scale setpoints x10 when writing and divide temperatures by 10 when reading; watch UnitStatus, OccupancyStatus and the alert codes.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "HeatCommand",
    "why": "Heat on/off when heat mode is DDC (1 = on)"
   },
   {
    "ref": "BV 2",
    "name": "CoolCommand",
    "why": "Cool on/off when cool mode is DDC (1 = on)"
   },
   {
    "ref": "BV 3",
    "name": "FanCommand",
    "why": "Fan on/off in DDC mode (1 = on)"
   },
   {
    "ref": "BV 89",
    "name": "DDCOccupiedOverride",
    "why": "Occupied override from the BMS (1 = on)"
   },
   {
    "ref": "AV 22",
    "name": "DischargeHeatOcc",
    "why": "Occupied discharge heat setpoint, °F x10"
   },
   {
    "ref": "AV 26",
    "name": "DischargeCoolOcc",
    "why": "Occupied discharge cool setpoint, °F x10"
   },
   {
    "ref": "AI 112",
    "name": "UnitStatus",
    "why": "0 idle, 1 heat, 2 cool, 3 blower, 4-6 lockout"
   },
   {
    "ref": "AI 101",
    "name": "DischargeTemp",
    "why": "Discharge air temperature, °F x10"
   },
   {
    "ref": "AI 99",
    "name": "OutsideTemp",
    "why": "Outdoor air temperature, °F x10"
   },
   {
    "ref": "AI 93",
    "name": "AlertCode1",
    "why": "First active alert code (0 = no fault)"
   }
  ],
  "enable": "Set the heating and/or cooling tempering mode to DDC through the unit HMI; this turns off temperature-based activation so HeatCommand, CoolCommand and FanCommand take over. The fan command only works in DDC mode.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Protocessor defaults: device instance 50000, MS/TP MAC 127, 38400 baud; change them in the Protocessor web configurator (Configure > Profile Configuration).",
   "Protocessor default IP 192.168.1.24; change it under Diagnostics and Debugging > Setup > Network Settings.",
   "The Protocessor is factory set to one field protocol; objects are reachable only on that port."
  ],
  "gotchas": [
   "Setpoints and temperatures are raw values x10; write 750 for 75.0 °F.",
   "Heating and cooling cannot be commanded at the same time.",
   "The unit board reboots when some factory settings are changed."
  ]
 },
