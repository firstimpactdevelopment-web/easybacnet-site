 ],
 "equipment_type": "Variable frequency drive BACnet MS/TP option card",
 "applies_to": "Yaskawa V1000 compact drives (CIMR-VA, software VST910120 and later) fitted with the SI-B3/V BACnet MS/TP option.",
 "summary": "The SI-B3/V is the V1000 version of Yaskawa's BACnet MS/TP option card. Its fixed object list mirrors the drive's Modbus registers: analog and digital I/O, run/fault/reset commands, frequency and PI setpoint references, output monitors, fault and status flags, and (on newer option software) energy, run-time and fault-code objects. AV29/AV30 give generic access to any drive parameter.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "PICS lists application software VST80026x, firmware 1.8; AV33 needs VST800265+, AV35-AV42 and BI28-BI29 need VST800266+",
 "default_device_instance": 1,
 "access_inferred": false,
 "notes": [
  "Objects named Not Used (AI3-AI5, AO2, AV31, AV32, AV34, AV41, BI10-BI27, BI30) are left out.",
  "This table differs from the A1000/P1000 SI-B3 list: V1000 names use PI rather than PID, BO2/BO3 drive terminals P1-PC/P2-PC, AO2 is not used, BV42/BV43 show COM/LOCAL the other way round, and BV57 Drive Comms Error is added.",
  "AV1, AV4 and AV5 are packed command words; don't combine them with the single-bit objects they duplicate.",
  "Frequency units follow the drive's o1-03 display setting.",
  "Each description gives the drive Modbus register where the manual lists one (hex)."
 ],
 "source": {
  "title": "YASKAWA AC Drive V1000 Option BACnet MS/TP Installation & Technical Manual, Type SI-B3/V",
  "doc_number": "TOEP YAICOM 19B",
  "revision_date": "2017-12",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=TOEPYAICOM19&cmd=documents&documentName=TOEPYAICOM19.pdf"
 },
 "integration": {
  "summary": "Fit the SI-B3/V, set the MS/TP address in F6-45, the baud rate in F6-46 and the device instance in F6-48/F6-49, and power-cycle. Set b1-01 = 3 and b1-02 = 3 (Option PCB) so BACnet supplies the frequency reference and run command. Write BV1 Run FWD Cmd and AV2 Frequency Cmd, read BV13/BV16 and AV10/AV12/AV13, and reset faults with BV4.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "Run FWD Cmd",
    "why": "Start/stop from the BMS (drive)"
   },
   {
    "ref": "AV 2",
    "name": "Frequency Cmd",
    "why": "Frequency reference, units per o1-03"
   },
   {
    "ref": "BV 4",
    "name": "Fault Reset Cmd",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 13",
    "name": "RUN-STOP",
    "why": "Running status"
   },
   {
    "ref": "BV 15",
    "name": "READY",
    "why": "Drive ready to run"
   },
   {
    "ref": "AV 10",
    "name": "Output Frequency",
    "why": "Output frequency, units per o1-03"
   },
   {
    "ref": "AV 12",
    "name": "Output Current",
    "why": "Motor amps"
   },
   {
    "ref": "AV 13",
    "name": "Output Power",
    "why": "Drive power in kW"
   },
   {
    "ref": "BV 16",
    "name": "FAULT",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 40",
    "name": "Last Drive Fault",
    "why": "Most recent fault code"
   }
  ],
  "enable": "b1-01 Frequency Reference Selection = 3 (Option PCB) and b1-02 Run Command Selection = 3 (Option PCB); both default to 1 (terminals). b1-15/b1-16 = 3 do the same for External Reference 2. Monitoring, parameter access, fault set/reset and the multi-function inputs work at any time.",
  "heartbeat": "The drive raises bUS (Option Communication Error) when the link drops after communication was established, but only when the run command or frequency reference comes from the option (b1-01 = 3 or b1-02 = 3). F6-04 sets the bUS delay (default 2.0 s) and F7-16 a communication-loss timeout (0.0-30.0 s, default 0 = off, option software VST800265+); the fault is sent after F7-16 + F6-04. F6-01 = 3 or higher makes bUS an alarm only; F6-14 = 1 resets the fault when communication returns.",
  "remote_sensors": "AV3 PI Setpoint Cmd lets the BMS write the PI setpoint (0-100 %); BO4 Ref Sel: PI Setpoint (or AV5 bit 1) selects it.",
  "setup": [
   "F6-45 sets the MS/TP MAC address (0-127, default 1).",
   "F6-46 sets the baud rate (default setting 3 = 9600 bps); the PICS lists 9600, 19200, 38400 and 76800 bps.",
   "Device instance = F6-48 (low word) + F6-49 (high word), in hex; default 1. Example: 1234 is F6-48 = 4D2H, F6-49 = 0.",
   "F6-47 sets the drive transmit wait time (5-65 ms, default 5 ms).",
   "Cycle power after changing these settings; the option reads F6-01, F6-04, F6-14 and F7-16 only at power-up.",
   "Up to 127 drives per MS/TP segment; the device object name (20 characters) is writable and takes effect after a power cycle."
  ],
  "gotchas": [
   "F6-01 set to alarm only keeps the drive running after a communication fault.",
   "BV56 Parameter Enter writes EEPROM (rated about 100,000 writes); don't use it cyclically.",
   "Several objects only exist with newer option software (VST800265 / VST800266).",
   "BACnet inputs and the S terminals are ORed together."
  ]
 },
