{
 "manufacturer": "Yaskawa",
 "manufacturer_slug": "yaskawa",
 "model": "Z1000 Bypass (BACnet MS/TP)",
 "model_slug": "z1000-bypass",
 "aliases": [
  "Z1000 Bypass",
  "Z1B1",
  "Z1000 drive bypass",
  "Z1000 bypass controller",
  "SIEP YAIZ1B 01"
 ],
 "equipment_type": "Variable frequency drive with bypass (HVAC)",
 "applies_to": "Yaskawa Z1000 Bypass packages (Z1B1, 208 V and 480 V) connected to BACnet MS/TP at the bypass controller.",
 "summary": "On the Z1000 Bypass the BACnet MS/TP connection is made at the bypass controller, which exposes both drive and bypass data from one address. The list keeps the Z1000 drive objects and adds bypass I/O, bypass run/transfer/smoke-purge commands, HOA and contactor status, bypass fault flags and fault codes. Some objects need newer bypass controller software (VST800298 or VST800400).",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Bypass controller software VST800400 or later for all objects; several need VST800298+",
 "default_device_instance": 1,
 "access_inferred": false,
 "notes": [
  "Objects named Not used/Not Used (AI3-AI5, BV1, BV2, BV5, BV6, BV60, BV68, BV100) are left out.",
  "AV41 is printed twice in the manual with the same data; it is listed once. AV34 is not in the table. The manual prints BO10/BO11 as B010/B011.",
  "AV33 needs bypass software VST800298 or later; AV35-AV42 and BI28-BI30 need VST800400 or later.",
  "BV72-BV79 (network digital inputs) are disabled unless Z3-12 = 1; those inputs are ORed with the physical S1-S8 inputs.",
  "AV29/AV30 with BV55/BV56 read and write drive or bypass parameters by Modbus register number.",
  "Each description gives the Modbus register where the manual lists one."
 ],
 "source": {
  "title": "YASKAWA AC Drive Z1000 Bypass Technical Manual (Appendix C, BACnet Communications)",
  "doc_number": "SIEP YAIZ1B 01F",
  "revision_date": "2018-03",
  "url": "https://www.yaskawa.com/delegate/getAttachment?documentId=SIEPYAIZ1B01&cmd=documents&documentName=SIEPYAIZ1B01.pdf"
 },
 "integration": {
  "summary": "Wire BACnet MS/TP to the bypass controller and set Z3-01 = 3 (BACnet), Z3-02 node, Z3-03 baud and the device instance in Z3-08/Z3-09. Set Z1-07 = 2 and Z1-08 = 2 so the network supplies the speed reference and run command, put the HOA in AUTO, then write BV58 and AV2. Read BV89, BV90 and AV42, and choose the comm-loss action in Z3-05/Z3-06.",
  "minimum_points": [
   {
    "ref": "BV 58",
    "name": "BYP Run Fwd CMD",
    "why": "Start/stop from the BMS (bypass)"
   },
   {
    "ref": "AV 2",
    "name": "Frequency Cmd",
    "why": "Frequency reference, units per o1-03"
   },
   {
    "ref": "BV 70",
    "name": "BYP Fault Reset CMD",
    "why": "Reset a bypass fault"
   },
   {
    "ref": "BV 89",
    "name": "BYP RUN Status",
    "why": "Running status"
   },
   {
    "ref": "BV 82",
    "name": "BYP AUTO Mode Status",
    "why": "HOA in AUTO, so BMS commands apply"
   },
   {
    "ref": "AV 10",
    "name": "Output Frequency",
    "why": "Output frequency, units per o1-03"
   },
   {
    "ref": "AV 31",
    "name": "Motor Current",
    "why": "Motor amps"
   },
   {
    "ref": "AV 13",
    "name": "Output Power",
    "why": "Drive power in kW"
   },
   {
    "ref": "BV 90",
    "name": "BYP Fault Status",
    "why": "Any active bypass fault"
   },
   {
    "ref": "AV 42",
    "name": "Fault Code",
    "why": "Active fault; bypass faults are 10000 + number"
   }
  ],
  "enable": "Table C.1: Z1-07 Speed Reference Select = 2 and Z1-08 Run Command Select = 2 (BACnet / serial) let the network set speed and start the unit; both default to 1 (terminals). BV58/BV59 run the bypass forward/reverse, BV69 selects drive or bypass and BV67 selects AUTO. Monitoring, parameter access, fault set/reset and the multi-function inputs work at any time.",
  "heartbeat": "Z3-05 Serial Communications Fault Select sets the action when nothing is received for Z3-06 (0.0-99.9 s, default 2.0 s; 0.0 never times out): 0 ignore, 1 alarm only (default), 2 EF0 fault to the drive (a unit running in bypass keeps running), 3 EF0 and open the bypass contactor K3, 4 alarm AL14 and run at the Z3-10 preset speed. Z3-13 can make the bypass restore the last BACnet speed and run commands after a power loss (default 0 = off).",
  "remote_sensors": "AV3 PI Setpoint Cmd lets the BMS write the PI setpoint (-100 to 100 %). BV72-BV79 can act as the bypass digital inputs from the network when Z3-12 = 1.",
  "setup": [
   "Z3-01 = 3 selects BACnet (the default); Z3-02 is the MS/TP node (0-127, default 1).",
   "Z3-03 baud: default 9600 bps, up to 115200 bps; 1200-4800 bps give oPE29 with BACnet on software VST800400 and later.",
   "Device instance = Z3-08 (low word) + Z3-09 (high word), in hex; default 1.",
   "Up to 127 bypasses per MS/TP segment."
  ],
  "gotchas": [
   "Z3-05 defaults to Alarm Only, so the unit keeps running when BACnet traffic stops.",
   "Z3-13 settings 2 and 3 let the bypass restart from stored BACnet commands at power-up before any new message arrives.",
   "BV56 Parameter Enter writes EEPROM; don't use it cyclically.",
   "BV72-BV79 do nothing unless Z3-12 = 1, and then they are ORed with the hard-wired inputs.",
   "Several monitors and fault-code objects only exist on newer bypass software (VST800298 / VST800400)."
  ]
 },
