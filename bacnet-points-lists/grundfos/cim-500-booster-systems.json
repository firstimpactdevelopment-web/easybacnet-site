 "equipment_type": "Booster pump system communication module",
 "applies_to": "Grundfos Hydro MPC / Control MPC (CU 35X), Hydro Multi-E and Hydro Multi-B (CU 323) booster systems fitted with a CIM 500 (or CIU 500) BACnet IP module.",
 "summary": "The CIM 500 module gives Grundfos booster systems a BACnet IP interface. The booster object list differs from the single-pump profile: it adds per-subpump presence, communication, auto-mode, fault code, runtime, speed, current, power, motor temperature and start counts for up to six subpumps plus pilot and back-up pumps, tank-filling limits and system pressures, levels and flows. Availability depends on the booster type and fitted sensors.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "CIM 500 V01.05 (PICS)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "For single Grundfos pumps (MAGNA3, E-pumps, CUE) see the CIM 300 / CIM 500 pump profile instead.",
  "Descriptions show which booster types support each point (Hydro Multi-B, Hydro MPC, Hydro Multi-E) and when a sensor is needed.",
  "AI 61-84 are printed with the bare name 'Subpump N'; the description says which value (current, power, motor temperature, starts) each one is.",
  "MI 12 and MI 13 have no access column in the source; they are listed as read-only.",
  "This 2014 PICS (BACnet protocol revision 9) does not list the BACnet watchdog object found in the later CIM functional profile.",
  "Hydro Multi-E always runs in constant pressure mode; MO 0 only applies to Hydro MPC."
 ],
 "source": {
  "title": "BACnet PICS CIM 500 - Protocol Implementation Conformance Statement for Grundfos CIM 500 BACnet IP for Grundfos pumps and booster systems",
  "doc_number": null,
  "revision_date": "2014-04-25",
  "url": "https://www.bacnetinternational.net/catalog/manu/grundfos%20management%20as/BACnet_PICS_CIM500_Print_88363.pdf"
 },
 "integration": {
  "summary": "Take bus control with BO 0 = 1, then start or stop the booster with MO 1 and write the setpoint to AO 0 (and the control mode to MO 0 on Hydro MPC). Read control source, rotation status, actual setpoint and the system fault and warning codes; reset alarms with BO 4.",
  "minimum_points": [
   {
    "ref": "BO 0",
    "name": "Set control source",
    "why": "Takes bus control (1) or gives it back (0)"
   },
   {
    "ref": "MO 1",
    "name": "Set operating mode",
    "why": "Start/stop: 1 = Start, 2 = Stop"
   },
   {
    "ref": "MO 0",
    "name": "Set control mode",
    "why": "Control mode (Hydro MPC only)"
   },
   {
    "ref": "AO 0",
    "name": "Set setpoint",
    "why": "System setpoint in %"
   },
   {
    "ref": "BO 4",
    "name": "Reset fault",
    "why": "Resets an alarm on a 0-to-1 edge (bus control only)"
   },
   {
    "ref": "BI 0",
    "name": "Control source status",
    "why": "Confirms bus control (1) or local (0)"
   },
   {
    "ref": "BI 2",
    "name": "Rotation status",
    "why": "One or more pumps running"
   },
   {
    "ref": "AI 9",
    "name": "Actual setpoint",
    "why": "Setpoint actually in use"
   },
   {
    "ref": "AI 0",
    "name": "Fault code",
    "why": "Active Grundfos alarm code"
   }
  ],
  "enable": "Set control source BO 0 = 1 (bus control); 0 = local control (default). MO 0, MO 1 and AO 0 only act while bus control is enabled; BI 0 confirms the active source.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP only (Annex J); no segmentation.",
   "AV 0 holds a custom device instance (range 0-0x3FFFFE, default 0xE7) that is used together with DIP switch SW3.",
   "MO 2 product simulation lets you commission the BMS side with no booster connected."
  ],
  "gotchas": [
   "A setpoint of 0 on AO 0 does not stop the booster; use MO 1 = 2 (Stop).",
   "MO 3-10 forced start is listed as not available; only automatic or forced stop work.",
   "Many points depend on the booster type and fitted sensors; check the availability note in each description."
  ]
 },
