    "why": "Cooling setpoint in use"
   },
   {
    "ref": "AV 4",
    "name": "ACT HEAT STPT",
    "why": "Heating setpoint in use"
   },
   {
    "ref": "AV 24",
    "name": "PRI ACTUAL FLOW",
    "why": "Measured primary airflow"
   },
   {
