   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance (seven digits), MAC address and baud are entered from the STE-8001W36 sensor: CNFG > COMM > DID, MAC, BAUD.",
   "BACnet MS/TP at up to 76.8 kbaud on EIA-485."
  ],
  "gotchas": [
   "Changing airflow calibration objects (K factor, correction slope/offset) changes measured flow; leave them to the balancer.",
   "Multistate state texts are not printed in the manual; read them from the controller."
  ]
