{
 "manufacturer": "EXHAUSTO",
 "manufacturer_slug": "exhausto",
 "model": "EXact / EXact2 air handling unit control (BACnet program file)",
 "model_slug": "exact2-bacnet",
 "aliases": [
  "EXact",
  "EXact2",
  "EXHAUSTO EXact2",
  "EXHAUSTO VEX",
  "3004402"
 ],
 "equipment_type": "Air handling unit with heat recovery (controller)",
 "applies_to": "EXHAUSTO VEX air handling units with the EXact or EXact2 control and its web server / BACnet module.",
 "summary": "EXact and EXact2 are the controls on EXHAUSTO VEX air handling units with heat recovery. The web server module makes the unit a BACnet IP or BACnet MS/TP device (B-ASC). The object list comes from EXHAUSTO's EDE file: fan outputs, airflows, pressures, filter drops, temperatures, setpoints, hour counters and 16 alarm slots as analog inputs; BMS setpoints (airflow, temperature, balance, fan speeds, filter limits, clock) as analog values; run and compensation states as binary inputs; and control mode, alarm reset and night cooling enable as binary values.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": "Web server software 3.0-xxxx or later",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Object names, types and instances are from the EDE file (09.08.2022); units are from the English register list in the manual's appendix; descriptions are our own short summaries. The appendix prints a few names differently (e.g. AI 79 Temp_Set.Setpoint); the EDE names are used.",
  "The manual gives access only by type (AI and binary inputs read-only, AO and binary outputs read/write) and the EDE has no settable column; the BMSInValue / VEXConfig analog and binary values are shown writable and the BMSOutValue objects (AV 21-22) read-only.",
  "Objects without a unit in the appendix (unit code 95) are left blank; hour counters, alarm codes and state objects carry no unit.",
  "Which objects carry values depends on the unit's options (heating and cooling coils, heat pump, external cooling, sensors).",
  "Alarm codes in AI 53-68 refer to the alarm list in the EXact documentation."
 ],
 "source": {
  "title": "EXact2, BACnet program file (EDE) with manual EXact/EXact2 BACnet protocol",
  "doc_number": "3004402",
  "revision_date": "2022-09 (EDE 09.08.2022)",
  "url": "https://assets2.exhausto.com/docExhaustoCOM/Exhausto-EXact2-EDE_Bacnet-Programfile-Prot-Dan-BD.csv"
 },
 "integration": {
  "summary": "Write the airflow setpoint (AV 6, 0-100 %, 0 stops the unit) and the temperature setpoint (AV 7, 10-35 °C); set BV 0 back to 1 to return the unit to its timer program. Read the operating state, airflows, temperatures and the A/B common alarms; BV 1 resets alarms.",
  "minimum_points": [
   {
    "ref": "AV 6",
    "name": "BMSInValue.AirSP",
    "why": "Airflow setpoint 0-100 %; 0 stops the unit"
   },
   {
    "ref": "AV 7",
    "name": "BMSInValue.TempSP",
    "why": "Temperature setpoint, 10-35 °C"
   },
   {
    "ref": "BV 0",
    "name": "BMSInValue.CtrlMode",
    "why": "1 = return to timer program"
   },
   {
    "ref": "BV 1",
    "name": "BMSInValue.ResetAlarm",
    "why": "Alarm reset"
   },
   {
    "ref": "BI 0",
    "name": "Manager.OnOff",
    "why": "Unit operating"
   },
   {
    "ref": "AI 38",
    "name": "Air_Qv.Sup_Qv",
    "why": "Supply airflow"
   },
   {
    "ref": "AI 36",
    "name": "Air_Qv.Ext_Qv",
    "why": "Extract airflow"
   },
   {
    "ref": "AI 94",
    "name": "Temp_Sensor.Supply",
    "why": "Supply air temperature"
   },
   {
    "ref": "BI 1",
    "name": "Alarm.A_Alarm",
    "why": "Common A alarm"
   },
   {
    "ref": "BI 2",
    "name": "Alarm.B_Alarm",
    "why": "Common B alarm"
   }
  ],
  "enable": "Writing the airflow setpoint (AV 6) runs the unit at that level; 0 % stops it. BV 0 CtrlMode = 1 hands control back to the unit's timer program.",
  "heartbeat": null,
  "remote_sensors": "AV 10 (RH) and AV 11 (CO2) accept values from the BMS for the unit's compensation functions.",
  "setup": [
   "Select BACnet MS/TP or BACnet IP in HMI menu 3.5 (BMS), then set Device ID (0-4194303) in menu 3.5.2; the device name can only be set in the web server.",
   "BACnet MS/TP: CN3 on the main control (A, B, 0 V), address 0-127, baud 9600, 19200 or 115200; fit the 120 ohm terminator with jumper JP2 on the web server at the end of the line.",
   "BACnet IP: UDP port 47808-47823; IP settings (static or DHCP) in menu 3.6."
  ],
  "gotchas": [
   "The temperature setpoint may be limited by other settings and functions in the unit.",
   "AV 19 / AV 20 fan setpoints only apply with air control method 8 (external control of fan speeds).",
   "AV 8 fixed airflow setpoint only applies with air control methods 3 and 4."
  ]
 },
