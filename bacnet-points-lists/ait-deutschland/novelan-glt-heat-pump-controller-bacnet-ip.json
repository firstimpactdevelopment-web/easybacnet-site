 "equipment_type": "Heat pump controller",
 "applies_to": "Novelan heat pumps made by ait-deutschland whose heating and heat pump controller runs software V1.60 or later with the GLT licence enabled.",
 "summary": "The GLT option turns on BACnet IP (or Modbus TCP) on the Ethernet port of the ait-deutschland heating and heat pump controller used in Novelan heat pumps. Every data point is an Analog Input, Multistate Input, Binary Input or Accumulator; the writable ones also appear as Analog Values or Multistate Values with their own instance numbers (outdoor temperature, return and mixing-circuit setpoints, DHW setpoint, heating curves, operating modes, compressor release) and Binary Outputs reset faults or force pumps on. The guide lists data point names in German.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Controller software V1.60 or later (BACnet IP)",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The guide gives one table per object type with an Analog Input / Analog Value (or Multistate Input / Value) instance pair per row; AV and MV objects are the writable copies.",
  "Names are the guide's German data point labels; descriptions are ours in English. Abbreviations follow the guide's list (HUP heating pump, BUP DHW pump, ZWE additional heat generator, EVU utility lock-out).",
  "Points shaded in the guide need a comfort / expansion or ventilation board; points marked * apply to units with LIN or Modbus parts. Values not shown on the controller's display are invalid.",
  "There is no MI 5 / MV 4 or BO 2 in the guide.",
  "Resolution is 0.1 for temperatures, 0.01 for pressures and power.",
  "GLT runs for 4 hours as a test after setup with the Novelan GLT Tool and is enabled permanently with a licence from the supplied USB dongle."
 ],
 "source": {
  "title": "Betriebsanleitung Zubehör für Wärmepumpen - Anbindung an eine Gebäudeleittechnik via BACnet/IP | ModBus/TCP - Novelan GLT",
  "doc_number": "83055703hDE",
  "revision_date": null,
  "url": "https://forum.iobroker.net/assets/uploads/files/1732701258966-83055703hde_novelan_glt.pdf",
  "unofficial": true,
  "host": "ioBroker forum"
 },
 "integration": {
  "summary": "Release the heat pump with MV 1, set the heating and hot water modes (MV 2 / MV 3) and write setpoints such as the DHW setpoint (AV 6) or a mixing circuit flow setpoint. Read the operating state (MI 1), flow and return temperatures, and the two fault BIs; reset latching faults with BO 1.",
  "minimum_points": [
   {
    "ref": "MV 1",
    "name": "Sperre / Freigabe Wärmepumpe",
    "why": "Lock heat pump (1) or release 1 / 2 compressors (2 / 3)"
   },
   {
    "ref": "MV 2",
    "name": "Betriebsart Heizen",
    "why": "Heating mode (1 = Automatik, 5 = Aus)"
   },
   {
    "ref": "MV 3",
    "name": "Betriebsart Trinkwarmwasser",
    "why": "Hot water mode (1 = Automatik, 5 = Aus)"
   },
   {
    "ref": "AV 6",
    "name": "Trinkwarmwasser Wunschwert",
    "why": "Hot water setpoint, °C"
   },
   {
    "ref": "BO 1",
    "name": "Fehlerreset",
    "why": "Fault reset (1 = reset)"
   },
   {
    "ref": "MI 1",
    "name": "Betriebszustand",
    "why": "Operating state (heating, DHW, defrost, off ...)"
   },
   {
    "ref": "AI 1",
    "name": "Vorlauftemperatur",
    "why": "Flow temperature"
   },
   {
    "ref": "AI 2",
    "name": "Rücklauftemperatur",
    "why": "Return temperature"
   },
   {
    "ref": "BI 1",
    "name": "Selbst zurücksetzende Störung",
    "why": "Self-resetting fault active"
   },
   {
    "ref": "BI 2",
    "name": "Nicht selbst zurücksetzende Störung",
    "why": "Latching fault active"
   }
  ],
  "enable": "MV 1 (Sperre / Freigabe Wärmepumpe) locks the heat pump or releases one or two compressors; the operating modes for heating, DHW, mixing circuits, cooling, ventilation and pool are set with MV 2-10.",
  "heartbeat": null,
  "remote_sensors": "The outdoor temperature can be written to AV 1 (Außentemperatur); the guide says to disconnect the heat pump's own outdoor sensor when doing so.",
  "setup": [
   "BACnet IP on UDP 47808 over the controller's Ethernet port; IP settings via DHCP server, DHCP client or manual entry on the controller (Service > Systemsteuerung).",
   "Device name, device ID, model name and location are set with the Novelan GLT Tool; the device ID must be unique on the network.",
   "A wrong broadcast address stops the heat pump being found over BACnet IP."
  ],
  "gotchas": [
   "Software older than V1.74/V2.74/V3.76/V4.76 supports only BACnet IP, not Modbus TCP; switching between them needs the GLT Tool.",
   "BO 1 Fehlerreset returns to 0 by itself after a 1 is written."
  ]
 },
