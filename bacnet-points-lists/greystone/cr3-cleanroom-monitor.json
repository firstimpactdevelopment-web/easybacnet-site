  "setup": [
   "Device instance defaults to 381003 (381000 + MAC); it stops following the MAC once written over BACnet.",
   "MS/TP baud rates 9600-115200 are supported; MAC and baud are set in the local menu."
  ],
  "gotchas": [
   "Alarm setpoints are rejected if they fall outside their Min/Max limit AVs.",
   "Only run DP Auto Zero (BV 3) when the room pressure is near zero; the guide limits it to readings within 20 % of range.",
   "Writing 1 to BV 27 clears all the min/max AIs at once."
