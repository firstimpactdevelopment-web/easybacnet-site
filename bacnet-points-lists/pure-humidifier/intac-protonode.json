 "equipment_type": "Humidifier controller gateway (ProtoNode)",
 "applies_to": "Pure Humidifier steam humidifiers with the Intac controller, connected over Modbus RTU to a ProtoNode gateway.",
 "summary": "A ProtoNode FPC-N34 (BACnet MS/TP or BACnet IP) or FPC-N35 gateway reads the Pure Humidifier Intac controller over Modbus RTU and serves 90 analog value objects per humidifier: setpoints, timers, PID and sensor-scaling settings, configuration values, measured humidity and temperatures, heater power, water level and I/O error flags.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Every object is an analog value; the table gives no units, states or read/write column. Access here is inferred: AV 1-68 (setpoints and settings) writable, AV 69-90 (measured values and status) read-only.",
  "Each description ends with the Intac Modbus register the object maps to.",
  "Device instance = Node_Offset (default 50,000) + the A-bank DIP switch value; further humidifiers on the same ProtoNode get the next instances.",
  "Up to 1,500 registers per ProtoNode at 90 per Intac controller."
 ],
 "source": {
  "title": "ProtoNode FPC-N34 and FPC-N35 Start-up Guide - For Interfacing Pure Humidifier Products: Intac Controller",
  "doc_number": null,
  "revision_date": "Document Revision 4.B",
  "url": "https://www.purehumidifier.com/downloads/O%26M/ProtoNode_O%26M.pdf"
 },
 "integration": {
  "summary": "Set each Intac controller to Modbus RTU 38400 8-N-1 with a unique Node-ID, wire it to the ProtoNode, pick the BACnet profile on the S DIP switches and set the MAC and device instance, then read and write the AV objects.",
  "minimum_points": [
   {
    "ref": "AV 5",
    "name": "Operation Mode",
    "why": "Unit operating mode"
   },
   {
    "ref": "AV 1",
    "name": "RH Set Point",
    "why": "Relative humidity setpoint"
   },
   {
    "ref": "AV 28",
    "name": "Control Source",
    "why": "Control signal source"
   },
   {
    "ref": "AV 69",
