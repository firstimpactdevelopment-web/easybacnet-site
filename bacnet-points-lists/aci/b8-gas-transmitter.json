 "default_device_instance": 4005,
 "access_inferred": false,
 "notes": [
  "Gas readings are listed in parts-per-million for every sensor type; check the actual units on combustible (%LEL) sensors.",
  "Device object name defaults to \"B8-(gastype) MAC: (address)\".",
  "The binary objects carry a priority array (B8 writes at priority 12) but Present_Value is listed as read-only.",
  "MS/TP master or slave; no segmentation."
 ],
