 },
 "integration": {
  "summary": "Choose BACnet on the Ethernet port (the default) or on the RS485 BMS port, set the address and device instance on Dg07, and enable unit on/off and control from supervisor on Dg01/Dg02. The BMS then switches the unit with OnOff_Status.SVOn (BV 44) and either sends a zone request (AV 29/30) or writes the zone set points. Monitor UnitStatus, zone production, the main probe and the alarm BVs.",
  "minimum_points": [
   {
    "ref": "BV 44",
    "name": "OnOff_Status.SVOn",
    "why": "Unit on/off from the BMS"
   },
   {
    "ref": "AV 29",
    "name": "Regulation.SVReq_1",
    "why": "Zone 1 request from the BMS, 0-100 %"
   },
   {
    "ref": "AV 31",
    "name": "RegCfg_1.SetP_hum",
    "why": "Zone 1 humidity set point, %RH"
   },
   {
    "ref": "BV 43",
    "name": "Alarms.AlrmResBySV",
    "why": "Alarm reset from the BMS"
   },
   {
    "ref": "BV 0",
    "name": "UnitOn",
    "why": "Unit on/off status"
   },
   {
    "ref": "PIV 0",
    "name": "UnitStatus",
    "why": "Operating state code (0-12)"
   },
   {
    "ref": "AV 2",
    "name": "Prod_1",
    "why": "Zone 1 production, %"
   },
   {
    "ref": "AV 6",
    "name": "MainPrb_1",
    "why": "Zone 1 main probe reading"
   },
   {
    "ref": "BV 3",
    "name": "Al_HiP.Active",
    "why": "High pressure alarm"
   },
   {
    "ref": "BV 4",
    "name": "Al_LoP.Active",
    "why": "Low pressure alarm"
   }
  ],
  "enable": "On screen Dg01 (single-zone) or Dg02 (two-zone) set the serial address and enable unit on/off and control from supervisor; Dg03 selects the supervisor protocol. Without these settings the unit does not act on the supervisor on/off or request.",
  "heartbeat": null,
  "remote_sensors": "Instead of its own probes the unit can take a 0-100 % request per zone from the BMS on Regulation.SVReq_1/2 (AV 29/30). Up to eight CAREL wireless probes can also be read (AV 13-28, humidity on odd and temperature on even instances).",
  "setup": [
   "Default supervision: Modbus on the RS485 serial port and BACnet on the Ethernet port.",
   "Dg04 sets the BMS port baud rate/stop bits/parity; Dg05 sets DHCP, IP, mask, gateway and DNS for Ethernet.",
   "Dg07 sets the BACnet MS/TP address, max masters, max info frames and the device instance.",
   "BACnet can run on the serial port or on Ethernet, not both at once; Modbus can run on both."
  ],
  "gotchas": [
   "The manual lists no default device instance; set a unique one on Dg07.",
   "Zone 2 objects return data only on two-zone cabinets."
  ]
 },
