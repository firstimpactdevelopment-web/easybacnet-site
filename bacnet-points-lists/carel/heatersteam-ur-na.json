{
 "manufacturer": "CAREL",
 "manufacturer_slug": "carel",
 "model": "heaterSteam UR (2018 manual, before heaterSteam 4)",
 "model_slug": "heatersteam-ur-na",
 "aliases": [
  "heaterSteam",
  "heaterSteam UR",
  "UR002",
  "UR080",
  "CAREL resistance steam humidifier",
  "+0300080EN"
 ],
 "equipment_type": "Electric resistance steam humidifier",
 "applies_to": "CAREL heaterSteam UR electric heater steam humidifiers of the generation before heaterSteam 4, as covered by manual +0300080EN rel. 1.4 (2018).",
 "summary": "heaterSteam UR is CAREL's resistance-heated steam humidifier. This entry covers the earlier heaterSteam UR generation documented in the 2018 manual (rel. 1.4), before heaterSteam 4. Its c.pHC controller speaks BACnet MS/TP on the RS485 BMS port or BACnet IP on the Ethernet port (one at a time) with no extra card. This edition of the object list has 74 positive integer values, 45 analog values and 69 binary values covering status, probes, set points, scheduler settings, network units and alarms.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 77000,
 "access_inferred": false,
 "notes": [
  "Source: section 11.2.3 'Table of BACnet variables', manual pages 52-54 (Tab. 11.a, 11.i, 11.j; 188 objects).",
  "The table has no units column; probe, set point and production values follow the unit-of-measure setting (UoM, PIV 45).",
  "The newer heaterSteam 4 manual (+0300087EN, 2025) lists 248 objects: 179 of these 188 keep the same instance and name, but SV_Command/SV_CommandResult move from PIV 92/93 to PIV 72/73, a few names change (e.g. ManMode, MainPrbCfg.Typ) and 60 objects are added. Check which manual matches the unit before mapping.",
  "NetStatus and Alrm_NetUnit objects only report in Main/Secondary networks; wireless probe objects only with CAREL wireless probes."
 ],
 "source": {
  "title": "heaterSteam - UR Electric resistance humidifier - User manual",
  "doc_number": "+0300080EN rel. 1.4",
  "revision_date": "2018-02-05",
  "url": "https://www.carel.com/documents/10191/0/%2B0300080EN/8e3b3908-4f1c-41c0-8712-bddd86881a07?version=1.12"
 },
 "integration": {
  "summary": "Select BACnet on the BMS port (Eh01, plus MS/TP settings on Eh03) or on the Ethernet port (Eh06), set the device instance on Eh04, and enable 'On/Off from SV' and 'Control from SV'. The BMS then starts the unit with OnBySV (BV 6) and sends a production request on SV_PwrReq (AV 11), or writes the humidity set point (AV 14). Monitor OnOffStatus, UnitStatus, production and the summary alarm BVs.",
  "minimum_points": [
   {
    "ref": "BV 6",
    "name": "OnBySV",
    "why": "Unit on/off from the BMS"
   },
   {
    "ref": "AV 11",
    "name": "SV_PwrReq",
    "why": "Production request from the BMS, %"
   },
   {
    "ref": "AV 14",
    "name": "GlbSetP_Hum",
    "why": "Humidity set point (own probe control)"
   },
   {
    "ref": "BV 5",
    "name": "OnOffStatus",
    "why": "Unit on/off status"
   },
   {
    "ref": "PIV 12",
    "name": "UnitStatus",
    "why": "Operating state code"
   },
   {
    "ref": "AV 0",
    "name": "MainPrb",
    "why": "Main probe reading"
   },
   {
    "ref": "AV 12",
    "name": "CurrProdPh",
    "why": "Current steam production, kg/h or lb/h"
   },
   {
    "ref": "BV 14",
    "name": "CurrBlkAlrm.IsPresent",
    "why": "Resettable alarm active"
   },
   {
    "ref": "BV 13",
    "name": "CurrBlkAlrm.IsBlocker",
    "why": "Shutdown alarm active"
   }
  ],
  "enable": "On screen Eh01 set 'On/Off from SV' and 'Control from SV' to Yes (both default to No); otherwise the unit ignores the supervisor on/off and production request.",
  "heartbeat": null,
  "remote_sensors": "With control from supervisor the BMS sends the production request on SV_PwrReq (AV 11) instead of the unit using its own probe.",
  "setup": [
   "Device instance default 77000 (screen Eh04).",
   "BACnet MS/TP on the BMS port: Eh03 sets the MAC address, max masters and max info frames; Eh02 sets the serial settings.",
   "BACnet on the Ethernet port is selected on Eh06; the Ethernet IP settings are on the Ethernet network screen.",
   "Only one BACnet instance exists, so BACnet cannot run on the BMS port and Ethernet at the same time."
  ],
  "gotchas": [
   "SV_Command (PIV 92) is a one-shot reset (1 = alarms, 2 = hour counter); read the result on PIV 93.",
   "Scheduler and probe configuration values are settings; avoid cyclic writes."
  ]
 },
