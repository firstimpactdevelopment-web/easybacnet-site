 "equipment_type": "Power meter",
 "applies_to": "Eaton Power Xpert Meter 2000 series (PXM 2250, 2260, 2270) base meter data on BACnet IP.",
 "summary": "The PXM 2000 serves its base meter data as a virtual BACnet IP device: volts, currents, power, power factor, energy, demand, THD and frequency as Analog Inputs, plus status, demand settings and nameplate data. Each optional I/O card (2DI/2DO, analog output, 4-channel digital) shows up as its own virtual BACnet device with a separate object list.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "From IB150011EN table 1 (meter data device). The device object itself is not repeated in the points list; the doc prints no instance for it.",
  "Objects marked wye configurations only: AI 205, AI 206, AI 207, AI 208, AI 805, AI 824, AI 830, AI 1400, AI 1401, AI 1402, AI 1450, AI 1451, AI 1452, AI 1510, AI 1511, AI 1512, AI 2403, AI 2404, AI 2405, AI 2410, AI 2411, AI 2412.",
  "Objects only on PXM 2260 or higher: AI 340, AI 342, AI 344, AI 520, AI 2403, AI 2404, AI 2405, AI 2410, AI 2411, AI 2412.",
  "Option card objects are on separate virtual devices; see the PXM 2000 card lists.",
  "The booklet gives no units or access columns; all objects are listed as read-only."
 ],
 "source": {
  "title": "BACnet object list for Power Xpert Meter 2000",
  "doc_number": "IB150011EN",
  "revision_date": "May 2016",
  "url": "https://www.eaton.com/content/dam/eaton/products/low-voltage-power-distribution-controls-systems/power-energy-meters/power-xpert-meter-2000-series/pxm2k-bacnet-object-list-ib150011en.pdf"
 },
 "integration": {
  "summary": "Discover the meter data virtual device over BACnet IP and read total real power, energy, demand, power factor, average volts and currents, and frequency. Use sStatus to check the meter is in normal operation.",
  "minimum_points": [
   {
    "ref": "MI 200",
    "name": "/01/sStatus",
    "why": "Meter status (2 = normal)"
   },
   {
    "ref": "AI 1403",
    "name": "/01/mWtotal",
    "why": "Total real power"
   },
   {
    "ref": "AI 1900",
    "name": "/01/mForwardEnergy",
    "why": "Forward real energy"
   },
   {
    "ref": "AI 1948",
    "name": "/01/mDemandForwardWatts",
    "why": "Present forward watts demand"
   },
   {
    "ref": "AI 1610",
    "name": "/01/mPFapparentTotal",
    "why": "System apparent power factor"
   },
   {
    "ref": "AI 204",
    "name": "/01/mACVavgLL",
    "why": "Average line-to-line volts"
   },
   {
    "ref": "AI 806",
    "name": "/01/mACIavg",
    "why": "Average phase current"
   },
   {
    "ref": "AI 3400",
    "name": "/01/mFreq",
    "why": "Line frequency"
   },
   {
    "ref": "MI 303",
    "name": "/01/sEntAlarmState",
    "why": "Meter alarm state"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP (Annex J); the meter can register as a foreign device for BACnet networks across subnets.",
   "Base meter data and each option card appear as separate virtual BACnet devices."
  ],
  "gotchas": [
   "Line-to-neutral volts and neutral current objects apply to wye wiring only.",
   "Percent THD objects need a PXM 2260 or higher."
  ]
