 },
 "integration": {
  "summary": "Set both SW200 switches ON, F802 to a unique station number, F827 = 0 (no parity) and F829 = 2 (BACnet), then reset with F899. Select RS485/BACnet as the command source (F003) and frequency source (F004), or use BV 22/BV 21 to override them. Write BV 10 Run/Stop Cmd and AV 16 Freq Ref, and read BV 0, AV 1, AV 4 and BV 2.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "name": "Run/Stop Cmd",
    "why": "Start/stop command"
   },
   {
    "ref": "BV 22",
    "name": "Cmd Ovrd",
    "why": "Overrides F003 command source"
   },
   {
    "ref": "AV 16",
    "name": "Freq Ref",
    "why": "Frequency reference, Hz"
   },
   {
    "ref": "BV 21",
    "name": "Freq Ovrd",
    "why": "Overrides F004 frequency source"
   },
   {
    "ref": "BV 14",
    "name": "Fault Reset",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 0",
    "name": "Run/Stop Status",
    "why": "Running status"
   },
   {
    "ref": "AV 1",
    "name": "Output Freq",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 4",
    "name": "Output Current",
    "why": "Motor amps"
   },
   {
    "ref": "BV 2",
    "name": "Fault Status",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 18",
    "name": "Last Flt",
    "why": "Active fault code"
   }
  ],
  "enable": "Run commands follow F003 Command Source (3 = RS485/BACnet) and speed follows F004 Frequency Command Source (6 = RS485/BACnet). BV 22 Cmd Ovrd and BV 21 Freq Ovrd override those selections from the network. BV 4 shows whether the drive is in local control.",
  "heartbeat": "F803 Communications Time-Out (0-100 s, default 0 = off) sets how long the RS-485 link may be idle; F804 Time-Out Action (default Trip/Trip) sets whether the drive does nothing, alarms or trips. Both need a power cycle to take effect.",
  "remote_sensors": null,
  "setup": [
   "Wire to the S4 RJ-45 on the terminal board: pin 4 RS485-A, pin 5 RS485-B, pins 2 and 8 GND. Both SW200 switches must be ON (2-wire).",
   "F802 ASD Number sets the station number (unique on the network; default 0).",
   "F827 = 0 (No Parity), F829 = 2 (BACnet), then F899 to reset the option board and drive.",
   "F820 sets the RS-485 baud rate (9600, 19200 or 38400 bps; default 19200).",
   "Communication parameter changes need a power cycle."
  ],
  "gotchas": [
   "F804 defaults to Trip/Trip, so with a timeout set in F803 the drive trips when the BMS stops talking.",
   "The manual does not list the default device instance or how it is set."
  ]
 },
