 "model": "MyStat thermostat (BACnet MS/TP server)",
 "model_slug": "mystat-thermostat",
 "aliases": [
  "MyStat",
  "75F MyStat",
  "BACnet_Mapping_MyStat"
 ],
 "equipment_type": "Thermostat / fan coil controller",
 "applies_to": "75F MyStat thermostats used as a BACnet MS/TP server over RS-485 for fan coil, heat pump and staged HVAC profiles.",
 "summary": "MyStat can act as a BACnet MS/TP server on its RS-485 port. 75F's mapping sheet lists 117 objects: onboard and sensor-bus temperature, humidity, CO2, pressure and occupancy, relay states, operating and fan status, conditioning mode and fan speed commands, setpoints, deadbands, PI and staging settings, relay/analog output mappings and lock pins.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "From the help-centre article \"MyStat as a BACnet Server\" (updated 2026-09-18) and its attachment BACnet_Mapping_MyStat__.xlsx.",
  "The sheet has no access column; inputs (AI/BI/MI) are listed read-only and values (AV/BV/MV) writable. The article says read/write access depends on the object and configuration.",
  "Many values are scaled integers: temperatures in 1/10 °F, setpoints as 2 x °F (120-180 = 60.0-90.0 °F).",
  "Relay, analog output and universal input mapping MVs list their options without numbers.",
  "BACnet-written values are kept through reboots and power cycles."
 ],
