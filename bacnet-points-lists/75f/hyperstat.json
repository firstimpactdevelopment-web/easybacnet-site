 ],
 "equipment_type": "Smart thermostat and room sensor",
 "applies_to": "75F HyperStat room controllers (CPU, HPU, 2- and 4-pipe FCU and Sense profiles) on BACnet MS/TP.",
 "summary": "The 75F HyperStat is a room thermostat and multi-sensor that can run standalone on BACnet MS/TP. Analog Inputs give room temperature, humidity, CO2, light, UV, VOC, sound and particulates plus its I/O; Analog Values hold heating and cooling setpoints, limits, deadbands and tuning; Binary and Multi-state objects cover relay enables, occupancy, conditioning mode, fan speed, the equipment profile and I/O mappings.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Built from the 75F HyperStat PICS (15 Nov 2022); object names come from the per-object property tables and access from the present-value row.",
  "The PICS prints °F as the unit of every Analog Input, including humidity, CO2 and light; only the temperature AIs keep °F here.",
  "BV 4 and BV 5 are both printed as \"Relay 5 Enable\" (BV 4 is probably Relay 5 and BV 5 Relay 6); kept as printed. AV 5 is printed \"Min Set Temperature Cooing\".",
  "Relay mapping objects MV 4-9 print only \"-\" for their state texts; MV 2 state 1 is printed \"SINLGE SETPOINT\".",
  "AI 0 Room Temperature has a writable present value."
 ],
 "source": {
  "title": "75F HyperStat PICS",
  "doc_number": null,
  "revision_date": "2022-11-15",
  "url": "https://www.bacnetinternational.net/catalog/manu/75f/75F HyperStat PICS November 15 2022.pdf",
  "unofficial": true,
  "host": "BACnet International catalog"
 },
 "integration": {
  "summary": "Write the conditioning mode (MV 0), fan speed (MV 1) and heating / cooling setpoints (AV 0, AV 1); read room temperature, humidity and CO2, the active setpoints and the operating, conditioning, fan and occupancy states.",
