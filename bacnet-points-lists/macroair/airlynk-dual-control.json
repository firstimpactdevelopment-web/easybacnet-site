 "integration": {
  "summary": "Give each fan a unique Modbus node ID (1-30) and document it, then pick BACnet MS/TP or BACnet IP on the AirLynk touch screen (MSTP Setup / IP Setup). Write FanSpeedN (0-100 %) and FanDirN for each fan, read FanRPMN and FanFaultN, and use AllFanReset to clear faults.",
  "minimum_points": [
   {
    "ref": "AV 1",
    "name": "FanSpeed1",
    "why": "Fan 1 speed command, 0-100 %"
   },
   {
    "ref": "AV 31",
    "name": "FanDir1",
    "why": "Fan 1: 0 off, 1 forward, 2 reverse"
   },
   {
    "ref": "AV 0",
    "name": "AllFanReset",
    "why": "Write 1 to reset faults on all fans"
   },
   {
    "ref": "AV 61",
    "name": "FanRPM1",
    "why": "Fan 1 output, 0.1 Hz (AVD) or 0.1 A"
   },
   {
    "ref": "AV 91",
    "name": "FanFault1",
    "why": "Fan 1 fault code"
   }
  ],
  "enable": "FanDirN = 0 turns fan N off; 1 or 2 runs it forward or reverse at the FanSpeedN setting.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: on Main Page 2 > MSTP Setup set Proto = BACn, the address, baud and Dev ID; BMS RS-485 lands on PLC port CN19.",
   "BACnet IP: on Main Page 2 > IP Setup set IP, mask, gateway and port (0 = 47808); MSTP Proto must then be Modb at 19.2k, 8 data bits, no parity, 1 stop bit.",
   "If BACnet MS/TP is used, leave the PLC IP at 192.168.1.100 so the Dual Controller keeps working.",
   "Fan Modbus node IDs must be unique, 1-30."
  ],
  "gotchas": [
   "If MSTP Proto is set to BACn, BACnet IP does not work.",
   "The minimum list shows fan 1; fan N uses instance + (N - 1) in each block.",
   "FanSize writes change the configured blade diameter; don't write them cyclically."
  ]
 },
 "page": "https://easybacnet.com/bacnet-points-lists/macroair/airlynk-dual-control",
