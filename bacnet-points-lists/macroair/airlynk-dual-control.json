 ],
 "equipment_type": "HVLS ceiling fan network controller",
 "applies_to": "MacroAir high-volume low-speed fans (AVD, AVD S, AVDX, AVD 370/2 and others) networked to an AirLynk PLC, with or without the Dual Controller.",
 "summary": "AirLynk is MacroAir's PLC that networks up to 30 HVLS fans over Modbus RTU and presents them to a BMS over BACnet MS/TP or BACnet IP (or Modbus RTU/TCP). Every object is an analog value: speed and direction commands per fan, read-back of each fan's output frequency or current, fault code and fan diameter, plus all-fan and selected-fan commands, motor calibration, a fan-scan flag and one reset-all-faults command.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The appendix has no read/write column: points described as 'Sets' or 'Reset' are shown writable, 'Shows'/'Displays' read-only.",
  "Instances repeat in blocks of 30, one per fan Modbus node ID (1-30): speed AV 1-30, direction AV 31-60, Hz/current AV 61-90, fault AV 91-120, diameter AV 121-150.",
  "FanRPM reads 0.1 Hz on AVD drives or 0.1 A on others, despite its name.",
  "Fault codes are not listed in the appendix; the manual refers to each fan's own manual.",
  "The manual uses 'BACnet' to mean 'Modbus/BACnet' throughout.",
  "Source: Appendix A, Airlynk Modbus + BACnet Control Points, pages 31-36 (160 objects)."
 ],
 "source": {
  "title": "Operation Manual - MacroAir Dual Control (Airlynk Modbus + BACnet Control Points, Appendix A)",
