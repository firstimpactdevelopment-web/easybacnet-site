 "model": "Aircore EC+ BACnet MS/TP module",
 "model_slug": "aircore-ec-plus-bacnet",
 "aliases": [
  "Aircore EC+",
  "Aircore EC Plus",
  "Infinitum Aircore",
  "Infinitum BACnet module",
  "AE catalog option B"
 ],
 "equipment_type": "EC motor with integrated variable frequency drive",
 "applies_to": "Infinitum Aircore EC+ axial-flux motors with integrated drive ordered with the BACnet MS/TP option (catalog VFD/I-O code B), using the BACnet module on the CIM board.",
 "summary": "Aircore EC+ motors get BACnet MS/TP from a BTL-certified plug-in module on the motor's CIM (communication interface module) board. Each Modbus-style register is mirrored as one BACnet object: binary and analog outputs for run/stop, direction, speed command, operating limits, control-source and terminal settings, and analog and binary inputs for bus voltage and current, temperatures, actual speed and run state, I/O states, fault and warning words, motor identity, firmware and run-time counters.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Object list from section 9 of the manual (pages 7-9). Object names here are the 'BACnet point name' column (16 characters max); the descriptions give the register name and number.",
  "The manual's 'BACnet object name' column groups the points (Motor Control, Oper Limits, Operation Type, Fault Reset, Term Setting, Monitor Env, Monitor Temp, Actual, Faults, Parameters, Motor ID, Runtime, Parameter Save).",
  "The manual gives no access or units column: outputs are listed as commandable and inputs as read-only from the object type.",
  "Some point names are printed as placeholders (dummy1-dummy4 on AI 25, AI 26, AI 35, AI 36), and the skip-speed point names (AO 10-13) differ from their register names; all are kept as printed.",
  "A PICS is attached as an appendix image in the manual."
 ],
 "integration": {
  "summary": "Set each motor's device instance and baud rate with Infinitum's NPU tool over the CIM board's micro-USB port, terminate the bus ends with the on-board DIP switch, then command BO 1 run/stop and AO 3 speed command. Read BI 74, AI 76, AI 63 and BI 86/AI 90, and clear faults with BO 88.",
  "minimum_points": [
   {
    "ref": "BO 1",
    "name": "Run/Stop Cmd",
    "why": "Run/stop command"
   },
   {
    "ref": "AO 3",
    "name": "Speed Command",
    "why": "Speed command from the BMS"
   },
   {
    "ref": "BO 88",
    "name": "Clear Faults",
    "why": "Clears active faults"
   },
   {
    "ref": "BI 74",
    "name": "Run/Stop Actual",
    "why": "Actual run state"
   },
   {
    "ref": "AI 76",
    "name": "Speed Actual",
    "why": "Actual motor speed"
   },
   {
    "ref": "AI 63",
    "name": "Avg Current",
    "why": "Average motor current"
   },
   {
    "ref": "BI 86",
    "name": "Active Faults",
    "why": "Any active fault"
   },
   {
    "ref": "AI 90",
    "name": "Fault Word",
    "why": "Bit-coded fault word"
   }
  ],
  "enable": "The list includes source selectors for speed (AO 21 Speed Source), run/stop (AO 22 Run/Stop Source), direction (AO 23) and fault clearing (AO 24); this manual doesn't give their values, so set them per the Aircore EC+ IOM manual before commanding over BACnet MS/TP.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance and baud rate are set with the Infinitum NPU tool (NPU.exe) over a USB to micro-USB cable to the CIM board; don't change the MAC address.",
   "Baud rates 9600 to 115200 bit/s; up to 32 devices per segment, 1000 m maximum cable.",
   "A DIP switch on the CIM board connects a 120 ohm terminating resistor; use it at each end of the bus.",
   "RS-485 is on the CIM terminal strip, shared with Modbus RTU.",
   "BACnet is a factory option (catalog VFD/I-O code B); Infinitum service can add the module in the field."
  ],
  "gotchas": [
   "Operating limits, sources and terminal settings (AO 4-59) are configuration; write them only when needed, not cyclically.",
   "AO 125 Parameter Save stores parameters; use it only after deliberate changes.",
   "The manual gives no units; check speed and current scaling on a live motor.",
   "The BACnet module can be damaged if fitted the wrong way round on the CIM board."
  ]
 },
