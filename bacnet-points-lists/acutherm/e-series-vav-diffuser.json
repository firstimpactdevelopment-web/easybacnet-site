 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The list marks each object as input (i), configuration (c) or output (o); outputs are listed read-only and inputs/configuration writable.",
  "Override inputs are disabled by writing their \"invalid\" value (for example 3276 for iTempSetpt, 327 for iRmTemp).",
  "AV_16-AV_20 are factory calibration values; AI_5-AI_10 are diagnostics.",
  "Object names are the short names printed in brackets (for example cMaxFlow).",
  "This is a different object list from the Acutherm Advantage digital VAV diffuser list.",
  "AV_25 option 6 (damper % open) carries footnote 1 in the document, which makes it print as \"61\"; it applies to motorized diffusers only."
 ],
