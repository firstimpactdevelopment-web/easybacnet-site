 "integration": {
  "summary": "Run the diffuser from the BMS by writing AV_21 iOccMode and AV_23 iTempSetpt (and AV_26 iRmTemp if the BMS supplies room temperature); read AI_0 room temperature, AI_3 effective setpoint, AI_2 airflow and AI_4 terminal load.",
  "minimum_points": [
   {
    "ref": "AV 21",
    "name": "iOccMode",
    "why": "Occupancy override: 0 occupied, 1 unoccupied, 2 standby"
   },
   {
    "ref": "AV 23",
    "name": "iTempSetpt",
    "why": "Occupied room setpoint from BMS (3276 = none)"
   },
   {
    "ref": "AI 0",
    "name": "oRmTemp",
    "why": "Room temperature used for control"
   },
   {
    "ref": "AI 3",
    "name": "oEffectStpt",
    "why": "Effective room setpoint"
   },
   {
    "ref": "AI 1",
    "name": "oSATemp",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 2",
    "name": "oAirFlow",
    "why": "Air flow rate, cfm"
   },
   {
    "ref": "AI 4",
    "name": "oTmnlLoad",
    "why": "Terminal load: + cooling, - heating, %"
   }
  ],
  "enable": "The diffuser defaults to occupied mode; AV_21 iOccMode overrides it to unoccupied or standby. AV_22 iHCMode overrides the heat/cool choice (9 = invalid, ignored).",
  "heartbeat": null,
  "remote_sensors": "AV_26 iRmTemp, AV_27 iSATemp and AV_28 iFlowRate replace the built-in sensors; AV_29 iCO2Level feeds a CO2 value for the purge function. Write the invalid value to go back to the built-in sensor.",
  "setup": [
   "AV_14 cBaudrate selects 38400 (0, default), 9600, 19200 or 57600; cycle power after changing it."
  ],
  "gotchas": [
   "AV_25 iOverride forces the damper; return it to normal for automatic control."
  ]
 },
