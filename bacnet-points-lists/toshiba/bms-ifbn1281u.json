{
 "manufacturer": "Toshiba",
 "manufacturer_slug": "toshiba",
 "model": "BN interface BMS-IFBN1281U",
 "model_slug": "bms-ifbn1281u",
 "aliases": [
  "BMS-IFBN1281U-E",
  "BMS-IFBN1281U-TR",
  "Toshiba BACnet interface",
  "Toshiba Carrier BN interface",
  "TU2C-LINK BACnet"
 ],
 "equipment_type": "VRF BACnet gateway",
 "applies_to": "Toshiba Carrier VRF indoor units, air-to-water heat pumps and RAC interfaces on TU2C-LINK (Uh line) or TCC-LINK.",
 "summary": "The BN interface is a Toshiba Carrier gateway that converts the TU2C-LINK / TCC-LINK central control line to BACnet/IP, serving up to 128 indoor units (64 on TCC-LINK). Every indoor unit gets the same block of objects, with the instance built from the unit's central control address and a fixed per-function code. Objects only exist for units found during the gateway's air conditioner search mode.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 100,
 "access_inferred": false,
 "notes": [
  "Instance formula: equipment number n (central control address, 1-128) x 256 + function code (e.g. ON/OFF status code 0x02 gives n*256+2). This file lists unit n=1.",
  "In object names, *** stands for the air-conditioner number 1-128.",
  "The manual prints the name Notice_Code1/MI_*** for all five notice-code objects; their object IDs differ (codes 0x63-0x67).",
  "ATW (air-to-water), RAC interface and ventilation objects only apply when that equipment is connected; ATW and RAC interfaces cannot be connected at the same time.",
  "Analog values follow the gateway's Celsius/Fahrenheit setting (BMS-IFBN1281U-E/-TR default Celsius).",
  "Output objects expose a Priority_Array; Out_Of_Service is writable on the I/O objects."
 ],
 "source": {
  "title": "BN interface Service Manual, BMS-IFBN1281U-E / BMS-IFBN1281U-TR",
  "doc_number": "A10-2301-3",
  "revision_date": "2024-05 (Revision 3)",
  "url": "https://www.toshiba-airconditioning.eu/@@download-proxy?uid=bfc26091451b41b1814e41f0d95432ab"
 },
 "integration": {
  "summary": "Give every indoor unit a central control address, run the BN interface's air conditioner search mode, then map each unit's block of objects (instance = address x 256 + code). Command through the output objects (start/stop, mode, fan, setpoint) and read the matching input objects back for status. Watch Alarm/BI, Alarm_Code/MI and Indoor_Communication_Failure for faults.",
  "minimum_points": [
   {
    "ref": "BO 386",
    "name": "State/BO_***",
    "why": "Start/stop the indoor unit"
   },
   {
    "ref": "MO 387",
    "name": "Mode/MO_***",
    "why": "Sets heat/cool/fan/dry/auto"
   },
   {
    "ref": "AO 388",
    "name": "Temp/AO_***",
    "why": "Writes the setpoint"
   },
   {
    "ref": "MO 389",
    "name": "Fan/MO_***",
    "why": "Sets fan speed"
   },
   {
    "ref": "MO 393",
    "name": "Inhibit/MO_***",
    "why": "Lock out local remote start/stop, mode or setpoint"
   },
   {
    "ref": "BI 258",
    "name": "State/BI_***",
    "why": "Confirms the unit's on/off state"
   },
   {
    "ref": "AI 264",
    "name": "Room_Temp/AI_***",
    "why": "Room temperature at the unit"
   },
   {
    "ref": "BI 320",
    "name": "Alarm/BI_***",
    "why": "Unit alarm flag"
   },
   {
    "ref": "MI 257",
    "name": "Alarm_Code/MI_***",
    "why": "Check code: 1 = no alarm, other values encode the fault"
   },
   {
    "ref": "BI 321",
    "name": "Indoor_Communication_Failure_***",
    "why": "Lost communication with the indoor unit"
   }
  ],
  "enable": "No enable point is described; units can be commanded once they have a central control address and were found by air conditioner search mode. Inhibit/MO can prohibit local remote-controller changes to start/stop, mode and setpoint.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Factory default IP 192.168.1.100, subnet 255.255.255.0, BACnet/IP on UDP 47808.",
   "Default device instance = last byte of the IP address (100), so changing the IP changes the device instance unless 'User Setting' is chosen in the engineering tool.",
   "IP, device instance and other settings are changed with Toshiba Carrier's Setting File Creation Software2 and uploaded as a DEF file (over the network or by USB flash drive).",
   "Central control addresses must be set on every indoor unit; holding the Shutdown button for 4 s or more starts air conditioner search mode to build the unit list.",
   "When multiple BN interfaces are used, each needs its own IP address and device instance."
  ],
  "gotchas": [
   "Re-run air conditioner search mode after any change to central control, line or unit addresses, or after replacing the microSD card.",
   "Auto cool/heat setpoints are only sent when cool setpoint >= heat setpoint, should be changed while the unit is in Auto, need 10 s between changes, and must not be written together in one WritePropertyMultiple.",
   "Fan speed and louver objects cannot be used on units whose fan speed or louver options are fixed; in Dry mode fan speed is auto only.",
   "Setpoint limits depend on the indoor unit type (18-29 °C standard FCU, 16-27 °C fresh-air intake unit).",
   "Duplicate central control addresses stop the search from completing correctly; check the search results file (SearchObjectLog.tsv)."
  ]
 },
