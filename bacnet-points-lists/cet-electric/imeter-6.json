 "equipment_type": "Energy meter (power quality monitor)",
 "applies_to": "CET Electric Technology iMeter 6 advanced power quality monitors with BACnet IP (firmware V3.01.01, application V3.50.00).",
 "summary": "The iMeter 6 is a three-phase power quality meter with a built-in BACnet IP server (B-ASC, foreign device registration supported). Analog Inputs carry voltages, currents, powers, power factors, sequence and unbalance values, angles, demand and max demand, THD, K-factor, crest factor and energy; Analog Values hold the PT/CT, wiring and demand setup plus clear commands; Binary Inputs and Outputs map the digital I/O; Large Analog Values give the energy registers and pulse counters at full resolution.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Firmware V3.01.01, application V3.50.00",
 "default_device_instance": 26001,
 "access_inferred": true,
 "notes": [
  "The object lists have no access column; Analog Inputs and Binary Inputs are listed read-only, Analog Values, Binary Outputs and Large Analog Values writable (the Supported Object Types table lists Present_Value as writable for AV, BO and LAV).",
  "Large Analog Values are listed as LAV; Out_Of_Service must be set true before writing their Present_Value.",
  "AI 32 is printed with the name \"AI\" and no units; kept as printed.",
  "Network Port objects are not repeated here.",
  "The clear commands (AV 15-23) take the value 0xFF00 to reset."
 ],
 "source": {
  "title": "iMeter 6 BACnet/IP Application Guide",
  "doc_number": "V1.0",
  "revision_date": "2023-05-26",
  "url": "https://www.cet-global.com/uploadfiles/2023/09/iMeter%206%20BACnetIP%20Application%20Guide%20V1.0%20(20230526).pdf"
 },
 "integration": {
  "summary": "Enable BACnet/IP (off by default) and set the device ID from the front panel or web page, reboot, then read power, energy, voltages and currents. Set PT/CT ratios and wiring mode to match the installation.",
  "minimum_points": [
   {
    "ref": "AI 15",
    "name": "P Total",
    "why": "Total active power, W"
   },
