    "name": "SETPT",
    "why": "Steam pressure setpoint, 0-30 psi"
   },
   {
    "ref": "MV 3800",
    "name": "SHIFT",
    "why": "Force day/night: 1 ToDay, 2 ToNight, 3 ExtendDay"
   },
   {
