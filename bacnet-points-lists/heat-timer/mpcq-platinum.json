 "applies_to": "Heat-Timer MPCQ Platinum steam heating and boiler sequencing control (pressure based), with the BACnet IP/MS/TP board.",
 "summary": "The MPCQ Platinum stages up to 32 steam boiler stages on system pressure, in cycle or setpoint mode. Its BACnet board exposes the settings, per-boiler mode, status, lockout and communication-error objects and the sensor readings as Analog, Binary and Multi-state Values with instances in steps of 100.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Objects are Analog, Binary and Multi-state Values only. Rows without a read-only mark in the manual are listed as writable.",
  "Temperature objects use °F or °C depending on the INMODE (sensor type/mode) setting.",
  "Start-up settings can be read but not written over BACnet; Heat-Timer says to set them at the panel first.",
  "The manual prints some rows as ranges (BSTATUS = 400-431 (one name printed for the whole range); COMERR00-31 = 800-831; LOCK00-31 = 1500-1531; MODE00-31 = 1900-1931; SCHEDULES00-55 = 3300-3355). Only the first and last printed objects of each range are listed here; the ones in between follow the same pattern.",
  "Pressure objects are in psi.",
  "Per-boiler objects come in blocks of 32 (00-31); the Lead Boiler coding depends on Boiler Type (table on manual page 15).",
  "Variable list: manual pages 14-15."
 ],
 "integration": {
  "summary": "The MPCQ sequences up to 32 steam boiler stages on system pressure. From the BMS, read system pressure, outdoor temperature, boiler status and lockouts and the system relay; adjust the pressure setpoint, put individual boilers in Auto/Standby/Off/On with MODE, and force a day/night shift if needed.",
  "minimum_points": [
   {
    "ref": "MV 1900",
    "name": "MODE00",
    "why": "Boiler 1 mode: 1 Auto, 2 Standby, 3 Off, 4 On"
   },
