 "model": "H100 drive with CBAC-H100 Ethernet module (BACnet IP)",
 "model_slug": "h100-bacnet-ip-cbac-h100",
 "aliases": [
  "H100",
  "LSLV-H100",
  "CBAC-H100",
  "H100 BACnet IP",
  "H100 Ethernet option",
  "LS H100 BACnet/IP"
 ],
 "equipment_type": "Variable frequency drive (BACnet IP option module)",
 "applies_to": "LS Electric LSLV-H100 HVAC inverters (OS 1.22 or later) fitted with the CBAC-H100 Ethernet communication module set to BACnet IP.",
 "summary": "The CBAC-H100 Ethernet module adds BACnet IP, EtherNet/IP or Modbus TCP to the H100; COM-21 = 0 selects BACnet IP (default). The object list matches the H100+ embedded MS/TP map without the extension I/O objects: AVs for frequency reference, ramps, PID reference/feedback and command timeout, BVs for run/stop/reset and relays, AIs for monitors and trip words, BIs for drive state and terminals.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Needs H100 inverter OS 1.22 or later",
 "default_device_instance": 237000,
 "access_inferred": false,
 "notes": [
  "From the H100 BACnet IP (Ethernet) User Manual EN V1.2, section 11.2.5 (PDF pp33-39).",
  "Compared with the H100+ embedded MS/TP map, this list has no AV 7-9 (comm analog outputs), AI 28 or BI 31-35 (extension I/O).",
  "AV 2, AV 3 and AV 4 can be written in AUTO mode only; AV 4 cannot exceed DRV-20 Max Freq.",
  "To drive relays from BV 6-10, set OUT-31 to OUT-35 to 0 (None).",
  "For priority control, the manual says to write clear (255) to give the priority back.",
  "AI 24 RunTimeMin is printed with units Day though it is run time in minutes. The printed MSI is listed as MI; MSV as MV."
 ],
 "source": {
  "title": "H100 BACnet IP (Ethernet) Communication Module User Manual",
  "doc_number": "V1.2",
  "revision_date": "2026-09-30",
  "url": "https://www.lselectricamerica.com/api/v1/fo/ctpApi/fileDownUrl?filePath=CTP%2FManual%2F790179813%2FH100%20BACNET%20IP(Ethernet)_User%20Manual_EN_V1.2_260930.pdf"
 },
 "integration": {
  "summary": "Install the CBAC-H100 module, set COM-21 = 0 (BACnet IP), the IP address, subnet and gateway in COM-12 to COM-20 and the device instance in COM-84/COM-85, then set COM-94 = Yes to apply. Set DRV-06 Cmd Source and DRV-07 Freq Ref Src to Field Bus, write BV 2 to run, BV 1 to stop and AV 4 for speed, and read BI 2, AI 5, AI 4 and BI 4.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "RunForwardCmd",
    "why": "Run forward command (True = run)"
   },
   {
    "ref": "BV 1",
    "name": "StopCmd",
    "why": "Stop command (True = stop)"
   },
   {
    "ref": "AV 4",
    "name": "CommandFreqSet",
    "why": "Frequency reference, Hz"
   },
   {
    "ref": "BV 4",
    "name": "ResetFaultCmd",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BI 2",
    "name": "RunningForward",
    "why": "Running forward status"
   },
   {
    "ref": "AI 5",
    "name": "OutputFreq",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AI 4",
    "name": "OutputCurrent",
    "why": "Motor amps"
   },
   {
    "ref": "AI 8",
    "name": "OutputPower",
    "why": "Output power, kW"
   },
   {
    "ref": "BI 4",
    "name": "Tripped",
    "why": "Any active trip"
   },
   {
    "ref": "BI 30",
    "name": "Warning",
    "why": "Any active warning"
   }
  ],
  "enable": "DRV-06 Cmd Source = 4 (Field Bus) for run/stop and DRV-07 Freq Ref Src = 7 (Field Bus) for AV 4. AV 2-4 can be written in AUTO mode only.",
  "heartbeat": "PRT-12 Lost Cmd Mode (default None: keep the last state; Free-Run, Dec, Hold Input, Hold Output, Lost Preset) and PRT-13 Lost Cmd Time (0.1-120 s, default 1.0 s) set the action when the network command is lost; PRT-14 is the Lost Preset speed. AV 1 CommTimeoutSet and MV 1 LostCommand have the same range and options.",
  "remote_sensors": "AV 6 PIDFeedbackSet lets the BMS write the PID feedback and AV 5 PIDReferenceSet the PID setpoint.",
  "setup": [
   "COM-21 Opt Parameter-12 = 0 selects BACnet IP (default); 1 EtherNet/IP, 2 Modbus TCP.",
   "COM-10 selects DHCP (1) or static (0); COM-12 to COM-15 IP address, COM-16 subnet as CIDR bits (default 24), COM-17 to COM-20 gateway.",
   "With BACnet IP selected, COM-22 sets the UDP port (default 0xBAC0 = 47808) and COM-23 the Out of Service mode.",
   "Device instance = COM-84 x 1000 + COM-85 (defaults 237 and 0, so 237000). COM-86 password (default 0) protects warm/cold start and the web server.",
   "Set COM-94 Comm Update = 1 (Yes) after changing COM-07 or COM-10 to COM-23; the drive restarts when the IP or option type changes.",
   "CNF-30 shows the installed module as BACnet IP (or Reserved-18/19 on older inverter software)."
  ],
  "gotchas": [
   "BV 1 StopCmd, BV 2 RunForwardCmd and BV 3 RunReverseCmd are separate commands; write the stop BV to stop.",
   "Lost Cmd Mode defaults to None, so the drive keeps its last command when the BMS goes quiet.",
   "ReadPropertyMultiple is not in the listed services; poll with ReadProperty.",
   "The module's web server is monitoring only; it cannot run the drive."
  ]
 },
