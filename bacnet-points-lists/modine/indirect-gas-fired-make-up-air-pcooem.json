 "integration": {
  "summary": "Choose BACnet MSTP or BACnet IP/Eth as the BMS-1 protocol in Service > BMS Config and enable the BACnet plug-in to set the instance and address. Use BMS_OnOff (BV 6) and BMS_Occupied (BV 7) to run the unit, write the occupied space heating setpoint (AV 15) or supply air setpoints, and reset alarms with BV 8. Monitor Unit_Status, supply air temperature, airflow proving and the general alarm BV 1.",
  "minimum_points": [
   {
    "ref": "BV 6",
    "name": "BMS_OnOff",
    "why": "BMS on/off command"
   },
   {
    "ref": "BV 7",
    "name": "BMS_Occupied",
    "why": "BMS occupied command"
   },
   {
    "ref": "AV 15",
    "name": "Space_Heat_SP_Occ_BMS",
    "why": "Occupied space heating setpoint"
   },
   {
    "ref": "AV 20",
    "name": "SA_Heat_Res_SP_Occ_BMS",
    "why": "Occupied supply air heating setpoint"
   },
   {
    "ref": "BV 9",
    "name": "BMS_Heartbeat_In",
    "why": "BMS heartbeat, when enabled in the BMS menu"
   },
   {
    "ref": "BV 8",
    "name": "BMS_Alarm_Reset",
    "why": "Alarm reset command"
   },
   {
    "ref": "AV 1001",
    "name": "Unit_Status",
    "why": "Unit status code"
   },
   {
    "ref": "BV 12",
    "name": "Unit_On_Airflow_Okay",
    "why": "Fan enabled and airflow proven"
   },
   {
    "ref": "AV 1",
    "name": "SA_Temp_BMS",
    "why": "Supply air temperature"
   },
   {
    "ref": "BV 1",
    "name": "Alarm_On",
    "why": "General alarm"
   }
  ],
  "enable": "The unit is first enabled from the display's ON/OFF UNIT menu; On/Off by BMS (BV 6) is one of the secondary sources, available when a BMS interface card is fitted. Occupancy can also come from the BMS (BV 7), a digital input, the clock schedule or the pAD override; occupied/unoccupied setpoints need a space pAD.",
  "heartbeat": "The BMS Config menu has Enable Heartbeat (default No), threshold and timeout settings and 'If BMS Offline Turn Unit' Off/On. The BMS writes BV 9 BMS_Heartbeat_In; when it stops, alarm A032 BMS Offline is raised.",
  "remote_sensors": null,
  "setup": [
   "BMS-1 protocol: BACnet MSTP, BACnet IP/Eth or LON, set in Service > BMS Config; set BACnet PlugIn = Yes to edit the BACnet settings.",
   "Device instance range 0-4194999 in the menu.",
   "BACnet MS/TP: baud 9600-76800, MAC 0-127, Max Masters and Max Info Frames set in the menu.",
   "BACnet IP: IP, subnet, gateway, DNS set in the menu; use Function = Write and Update = Yes to send them to the card."
  ],
  "gotchas": [
   "Integer AVs start at 1001; do not confuse AV 1-51 (analog) with AV 1001+ (integer).",
   "Occupied and unoccupied setpoints only apply when a space pAD is installed.",
   "Furnace 2/3, evaporative cooler, DX/CW and A2L points only carry data when those options are fitted."
  ]
 },
