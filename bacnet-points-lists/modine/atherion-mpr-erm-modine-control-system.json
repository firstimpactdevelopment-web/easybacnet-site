 "integration": {
  "summary": "Select BACnet IP/Ethernet or BACnet MS/TP in the BMS Configuration service menu and set the device instance and address there. Set Enable Unit On/Off to 'By Supervisor' so BV 41 Superv_OnOff starts and stops the unit, then use BV 38 for occupancy and write the supply-air setpoints. Monitor unit status (AV 1023), supply and space temperatures, the general alarm (BV 36) and the alarm codes.",
  "minimum_points": [
   {
    "ref": "BV 41",
    "name": "Superv_OnOff",
    "why": "BMS on/off command (needs On/Off 'By Supervisor')"
   },
   {
    "ref": "BV 38",
    "name": "Occupied_Bms",
    "why": "BMS occupied command"
   },
   {
    "ref": "AV 15",
    "name": "space_cl_sa_sp_oc",
    "why": "Occupied supply air cooling setpoint"
   },
   {
    "ref": "AV 16",
    "name": "space_ht_sa_sp_oc",
    "why": "Occupied supply air heating setpoint"
   },
   {
    "ref": "BV 39",
    "name": "BMS_Reset",
    "why": "Alarm reset command"
   },
   {
    "ref": "AV 1023",
    "name": "UnitStatus",
    "why": "Unit status code (1 = on, 2 = off by alarm, ...)"
   },
   {
    "ref": "BV 3",
    "name": "Supply_fan_sw",
    "why": "Supply fan airflow proving switch"
   },
   {
    "ref": "AV 10",
    "name": "supply_temp",
    "why": "Supply air temperature"
   },
   {
    "ref": "BV 36",
    "name": "General_Alarm",
    "why": "General alarm"
   },
   {
    "ref": "AV 1030",
    "name": "Alarm_Code",
    "why": "Active alarm code (1 of 3)"
   }
  ],
  "enable": "In Service > Service Settings > Control Settings, enable only one Unit On/Off source. 'By Supervisor' lets a BACnet or Lon network variable (BV 41 Superv_OnOff, on = active) cycle the unit; the other sources are digital input ID14, the pAD wall stat (pLAN) and the clock schedule.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Protocol is chosen in Service > BMS Configuration (password PW1): BACnet IP/Eth or BACnet MSTP, with Enable Plugin = Yes.",
   "Device instance range 0-99,000, set from the same menu; use Function = Write and Update = Yes to send settings to the card.",
   "BACnet IP: IP address, subnet, gateway and DNS are set in the menu.",
   "BACnet MS/TP: baud 9600, 19200, 38400 (default) or 76800; MAC 0-127; Max Masters and Max Info Frames are set in the menu."
  ],
  "gotchas": [
   "BV 41 only works when Unit On/Off is set to 'By Supervisor' and the other sources are off.",
   "Integer AVs start at 1001; do not confuse AV 1-39 (analog) with AV 1001+ (integer).",
   "Option-dependent points (ERM, compressors, heat stages) read 0 when the option is not fitted."
  ]
 },
