 "equipment_type": "Air handling unit controller (commercial heat recovery AHU)",
 "applies_to": "Flexit ProNordic commercial air handling units with the CS2500 controller and the SP85 BACnet IP communication module.",
 "summary": "Flexit's overview spreadsheet of the BACnet objects in a ProNordic unit (CS2500 controller with the SP85 BACnet IP module). It has 79 objects: the BMS mode command, operating mode status, temperatures and setpoints, valve and pump outputs, five fan steps per fan, fan readings, filter pressures, fire damper status and A/B/C alarms. Many objects only exist when the matching accessory or configuration is present (marked S, C or A in the list).",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The spreadsheet has no read/write column. Access here is inferred: the BMS mode command, the alarm reset and the setpoint/fan-step AVs are marked W, everything else R.",
  "Printed instance clashes are kept as printed: AI 40895 is listed for both exhaust temperature and return water temperature, and MV 38643 for both B-alarm and C-alarm. AV 30463 and AO 30463 are different object types.",
  "BV 32321 Status AHU is printed as a Binary Value but with 17 state texts (2-18); check the type on the live unit.",
  "State texts follow the Norwegian sheet where the English sheet differs: MV 30094 1=Off/2=On and BO 5714 0=Normal/1=Alarm (the English sheet prints them the other way or 1/2).",
  "Fan step and fan value AVs are in Pa (pressure accessory), m3/h (standard) or l/s (by configuration).",
  "The file also has Norwegian and Swedish sheets with the same instances; names here are from the English sheet, typos included."
 ],
 "source": {
  "title": "Overview Bacnet-object Flexit ProNordic (BACnet Flexit CS2500)",
  "doc_number": null,
  "revision_date": "2024-09",
  "url": "https://flexitwebsiteprodstorage.blob.core.windows.net/product-documents/10670"
 },
 "integration": {
  "summary": "Write MV 32040 BMS Regulation to run the unit from the BMS (Auto, Off, or Economy/Comfort steps 1-3). Adjust the comfort and economy heating setpoints if needed. Read MV 6080 for the actual operating mode, the outdoor/supply/extract temperatures, the fan values and the A/B/C alarm MVs; MV 19 resets alarms.",
  "minimum_points": [
   {
    "ref": "MV 32040",
    "name": "BMS Regulation",
    "why": "Mode command: 1 Auto, 2 Off, 3-8 Economy/Comfort steps"
   },
   {
    "ref": "AV 22817",
    "name": "Setpoint Komfort Heating",
    "why": "Comfort heating setpoint"
   },
   {
    "ref": "AV 35713",
    "name": "Setpoint Economi Heating",
    "why": "Economy heating setpoint"
   },
   {
    "ref": "MV 19",
    "name": "Reset Alarm (A,B,C)",
    "why": "Alarm reset"
   },
   {
    "ref": "MV 6080",
    "name": "Operating mode Operation Aggregate",
    "why": "Actual operating mode (off, comfort, economy, start)"
   },
   {
    "ref": "AI 45150",
    "name": "Supply temperature",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 53218",
    "name": "Outdoor temperature",
    "why": "Outdoor air temperature"
   },
   {
    "ref": "AI 28256",
    "name": "Extract temperature",
    "why": "Extract air temperature"
   },
   {
    "ref": "MV 46769",
    "name": "A-Alarm Danger",
    "why": "A alarm active when 2"
   },
   {
    "ref": "MV 38643",
    "name": "B-Alarm",
    "why": "B alarm active when 2"
   }
  ],
  "enable": "MV 32040 BMS Regulation selects Auto (unit follows its own schedule), Off, or a fixed Economy or Comfort fan step from the BMS.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP needs the SP85 communication module on the CS2500 controller."
  ],
  "gotchas": [
   "MV 56125 temperature regulation mode is status only; Flexit says not to change it.",
   "Several instances are printed twice for different points; confirm against the live unit's object list."
  ]
 },
