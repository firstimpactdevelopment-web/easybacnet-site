 "equipment_type": "Energy recovery ventilation unit (residential AHU)",
 "applies_to": "Flexit Nordic series residential heat recovery ventilation units with the built-in Siemens Climatix S300 controller.",
 "summary": "Flexit Nordic units have BACnet IP built in (Siemens Climatix S300 controller, POS3.6715). Flexit's basic list has 66 rows: ventilation mode commands and status, setpoints, timers for fireplace and rapid ventilation, sensor readings, outputs and A/B alarm handling. Several rows give two or three instance numbers because the object moves with the configured input or output terminal; each printed instance is listed here.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Application APTV 2.419 and above (per the Flexit GO BACnet guide)",
 "default_device_instance": 2,
 "access_inferred": false,
 "notes": [
  "Rows that depend on wiring (DI1, DI2, X8, Q1-Q3, CI79) or on temperature control mode (supply air vs extract air cascade) are listed once per printed instance; the description says which. Instances marked default in the list are noted.",
  "AI 50 is printed twice: extract air humidity or room air quality, depending on what is configured on X3.",
  "Many objects exist only when the matching option is configured (water or electric heating, cooling, duct pressure fan control, wireless room sensors CI75/CI76/CI77).",
  "AI 31 (frost protection temperature) is printed with unit Pa and a -3000 to 3000 range in the source; kept as printed.",
  "The object list is a spreadsheet; it has no document number. Network settings come from Flexit's GO BACnet guide 118278-02 (2025-04)."
 ],
 "source": {
  "title": "BACnet Basic list - Nordic",
  "doc_number": null,
  "revision_date": "2020-10",
  "url": "https://flexitwebsiteprodstorage.blob.core.windows.net/product-documents/2963"
 },
 "integration": {
  "summary": "Set BV 50 Comfort button to 1 so the unit follows MV 42 Room operating mode, then write MV 42 (Stop/Away/Home/High). Write the home and away temperature setpoints (instance depends on supply or extract control). Read MV 361 for the present mode, the temperatures and fan speeds, and the A/B alarm indication points; MV 344 acknowledges or resets A alarms.",
  "minimum_points": [
   {
    "ref": "BV 50",
    "name": "Comfort button",
    "why": "Must be 1 for MV 42 to take effect"
   },
   {
    "ref": "MV 42",
    "name": "Room operating mode",
    "why": "Mode command: 1 Stop, 2 Away, 3 Home, 4 High"
   },
   {
    "ref": "AV 1994",
    "name": "Setpoint temperature when home",
    "why": "Home setpoint (supply air control default)"
   },
   {
    "ref": "MV 344",
    "name": "A-Alarm acknowledgement",
    "why": "Write 2 to acknowledge, 3 to reset A alarms"
   },
   {
    "ref": "MV 361",
    "name": "Heat recovery ventilation state",
    "why": "Present ventilation mode"
   },
   {
    "ref": "AI 4",
    "name": "Supply air temperature",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 1",
    "name": "Outside air temperature",
    "why": "Outdoor air temperature"
   },
   {
    "ref": "AI 59",
    "name": "Extract air temperature",
    "why": "Extract (return) air temperature"
   },
   {
    "ref": "MV 343",
    "name": "A-Alarm indication",
    "why": "A alarm active when 2"
   },
   {
    "ref": "MV 340",
    "name": "B-Alarm indication",
    "why": "B alarm active when 2"
   }
  ],
  "enable": "MV 42 Room operating mode only works when BV 50 Comfort button is 1; with BV 50 at 0 the unit goes to Away after the AWAY delay (PIV 318). A ventilation mode wired to a digital input overrides MV 42.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP is built in; default device ID is 2.",
   "Change BACnet settings in the Flexit GO app as installer (Other > Installer > BACnet settings); the unit restarts to apply them.",
   "Network settings can also be written over BACnet on the network port object (device instance, IP, UDP port); set property 4894 to 1 to save."
  ],
  "gotchas": [
   "Flexit says to write commandable objects at priority 13 only; other priorities can leave the unit out of control.",
   "The home/away setpoint instance depends on temperature control mode: 1994/1985 for supply air control, 2070/1988 for extract air cascade.",
   "Input and output objects change instance with the terminal they are configured on."
  ]
 },
