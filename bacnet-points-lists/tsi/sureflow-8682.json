   },
   {
    "ref": "AI 21",
    "name": "Current Flow Offset",
    "why": "Supply/exhaust offset now in use"
   },
   {
    "ref": "AI 22",
    "name": "Temperature",
    "why": "Room temperature"
   },
   {
    "ref": "MI 1",
    "name": "Status Index",
    "why": "Alarm state; 1 = normal, 9 = emergency"
   }
  ],
  "enable": "Occ/Unocc Mode (BV 1) switches between the occupied and unoccupied flow and temperature setpoints; Remote Mode (BV 2) selects the remote pressure setpoint and alarms (AV 3, AV 6, AV 7); Emergency Mode (MV 2) works like the EMERGENCY key.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP master at 9600, 19.2k, 38.4k or 76.8k baud (PICS).",
   "Set the MS/TP MAC with the MAC ADDRESS menu item (1-127).",
   "The device instance is the MAC ID menu item (0-999, default 868) x 1000 plus the MAC address, so the default with MAC 1 is 868001."
  ],
  "gotchas": [
   "Pressure units change with Units Value (MV 3); check it before scaling pressures in the BMS.",
   "Changing the MAC address or MAC ID changes the device instance.",
   "Setpoints and alarm limits are stored settings; do not write them cyclically."
  ]
