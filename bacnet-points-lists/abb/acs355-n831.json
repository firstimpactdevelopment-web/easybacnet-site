 "equipment_type": "Variable frequency drive (HVAC)",
 "applies_to": "ABB ACS355 machinery drives with the HVAC with BACnet firmware (option +N831, firmware 6502 or later).",
 "summary": "ACS355 drives ordered with option +N831 carry HVAC firmware with BACnet MS/TP on the built-in RS-485 (EFB) port. The object list follows the older ABB ACH550 style: relay and digital I/O status, run/stop, direction, run enable and fault reset commands, two references, PID values, energy, fault history and mailbox access to any parameter.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "HVAC with BACnet firmware 6502 or later (parameter 3301)",
 "default_device_instance": "Equal to the MAC ID while 5311 and 5317 are both 0 (default)",
 "access_inferred": false,
 "notes": [
  "BO 1-3 and BI 1-3 need the MREL-01 relay option; writing BO 1-3 without it returns a value-out-of-range error.",
  "Each command object only works when the matching drive parameter points at COMM (shown in the description).",
  "The manual reuses the AI 0 text (Analog Input 1, parameter 0120) for AI 1 ANALOG INPUT 2; it is taken here as analog input 2.",
  "Gaps in instance numbers (BI 4-5, BI 11, BO 4-5, AV 22) are not in the manual and not listed.",
  "C = commandable (priority array and relinquish default), per the manual."
 ],
 "integration": {
  "summary": "Set 9802 COMM PROT SEL to BACnet, then 5302 station ID (MAC), baud on the EFB baud parameter (default 38400) and the device instance with 5311/5317. Point 1001 (EXT1 commands) and 1103 (REF1 source) at COMM, then write BV 10 and AV 16. Set 3018/3019 for communication loss.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "why": "Start/stop from the BMS",
    "name": "RUN/STOP CMD"
   },
   {
    "ref": "AV 16",
    "why": "Speed reference in %",
    "name": "INPUT REF 1"
   },
   {
    "ref": "BV 14",
    "why": "Reset a tripped drive",
    "name": "FAULT RESET"
   },
   {
    "ref": "BV 0",
    "why": "Running status",
    "name": "RUN/STOP ACT"
   },
   {
    "ref": "BV 4",
    "why": "Shows if the panel has the drive in Hand",
    "name": "HAND/AUTO ACT"
   },
   {
    "ref": "AV 1",
    "why": "Output frequency in Hz",
    "name": "OUTPUT FREQ"
   },
   {
    "ref": "AV 4",
    "why": "Motor amps",
    "name": "CURRENT"
   },
   {
    "ref": "AV 6",
    "why": "Drive power in kW",
    "name": "POWER"
   },
   {
    "ref": "BV 2",
    "why": "Any active drive fault",
    "name": "FAULT ACT"
   },
   {
    "ref": "AV 18",
    "why": "Most recent fault code",
    "name": "LAST FLT"
   }
  ],
  "enable": "Set 1001 EXT1 COMMANDS (and/or 1002 EXT2) = COMM so BV 10 starts and stops the drive; 1003 = REQUEST lets BV 11 change direction. 1103 REF1 SELECT = COMM makes AV 16 the reference; 1106 = COMM uses AV 17 as reference 2 (or as the process PID setpoint with 1106 = PID1 OUT and 4010 = COMM). 1601 = COMM for BV 12 run enable, 1102 = COMM for BV 13 EXT1/EXT2, 1604 = COMM for BV 14 fault reset. BV 18 control override takes control, but panel HAND still wins.",
  "heartbeat": "3018 COMM FAULT FUNC sets the reaction to lost communication (0 not selected, 1 fault, 2 constant speed 7, 3 last speed) and 3019 COMM FAULT TIME the delay (0-600 s, default 10 s).",
  "remote_sensors": "AV 27 EXT PID STPT sets the external PID setpoint (4210 = 19). AO 0 drives analog output 1 when 1501 = 135; BO 0-3 and BO 6 drive the relays/transistor output when their source parameter is COMM.",
  "setup": [
   "9802 COMM PROT SEL = BACnet enables the protocol on the EFB port.",
   "5302 EFB STATION ID sets the MS/TP MAC (default 1); a non-zero value latches the settings.",
   "Baud: default 38400 when BACnet is selected; 9600, 19200, 38400 and 76800 are supported.",
   "Device instance: 5311 alone for 1-65535, or 5311 + 10000 x 5317 for larger IDs; both 0 = instance equals MAC.",
   "5312 Max Info Frames (default 1) and 5313 Max Master (default 127); 5316 counts tokens received.",
   "After changing communication settings cycle power, reset the station ID, or use ReinitializeDevice."
  ],
  "gotchas": [
   "Panel HAND mode beats BACnet control override (BV 18).",
   "BV 14 fault reset is rising-edge triggered.",
   "Last speed and constant speed comm-loss reactions keep the motor running.",
   "No segmentation; services are limited to ReadProperty/WriteProperty (no ReadPropertyMultiple listed)."
  ]
 },
 "source": {
