 },
 "integration": {
  "summary": "Command the drive with BV 10 (run/stop) and AV 16 (speed reference, % of maximum speed). Read BV 0 run status, BV 2 fault status, AV 31 speed and AV 18 active fault; BV 14 resets faults. The drive must be in Auto (BV 4) for BACnet control.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "name": "RUN-STOP-Command",
    "why": "Run/stop command (1 = run)"
   },
   {
    "ref": "AV 16",
    "name": "Input-Reference-1",
    "why": "Speed reference, % of max speed"
   },
   {
    "ref": "BV 14",
    "name": "Fault-Reset-Command",
    "why": "Fault reset"
   },
   {
    "ref": "BV 0",
    "name": "Run / Stop- Monitor",
    "why": "Run status"
   },
   {
    "ref": "AV 31",
    "name": "Output-Speed",
    "why": "Actual speed, % of rated frequency"
   },
   {
    "ref": "AV 6",
    "name": "Output-Power",
    "why": "Output power, kW"
   },
   {
    "ref": "BV 4",
    "name": "HAND-AUTO-Monitor",
    "why": "Hand/Auto mode (Auto needed for BACnet)"
   },
   {
    "ref": "BV 2",
    "name": "OK-FAULT- Monitor",
    "why": "Fault status"
   },
   {
    "ref": "AV 18",
    "name": "Active-Fault",
    "why": "Active fault code"
   }
  ],
  "enable": "BACnet control works in Auto (parameter 1103 not 1 or 2); Hand means keypad control, as BV 4 shows.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP baud rates 9600-115200; BACnet protocol revision 15."
  ],
  "gotchas": [
   "BV 10, BV 11, AV 16 and the BO outputs are commandable (priority array)."
  ]
 },
