 "equipment_type": "Variable frequency drive",
 "applies_to": "Invertek Optidrive Eco (ODV-3) HVAC and pump drives using the built-in BACnet MS/TP port on the RJ45 connector.",
 "summary": "The Optidrive Eco has BACnet MS/TP built in on its RJ45 RS-485 port, enabled by setting P1-12 = 6. It exposes 34 binary values (drive status flags, digital inputs, relay states, and commandable run/stop, fast stop, coast stop, trip reset and relay commands) and 25 analog values (frequency, speed, current, power, bus voltage, temperature, trip code, I/O levels, energy and hour meters, plus writable speed reference, ramp time and PID values).",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "PICS lists application software and firmware 2.00",
 "default_device_instance": "1 (P5-10 x 65536 + P5-09; defaults P5-09 = 1, P5-10 = 0)",
 "access_inferred": false,
 "notes": [
  "Object dictionary from section 10.3.5 of the user guide (pages 73-74); the guide has no other BACnet object types besides the Device object.",
  "Access codes as printed: R read only, W read or write, C commandable.",
  "Relay commands BV 29-33 only act when that relay output is set to be driven by a user value.",
  "AV 4 Motor torque is described as Reserved in the table.",
  "AV 19/AV 20 energy counters can be reset by the user; AV 21/AV 22 meters cannot."
 ],
 "integration": {
  "summary": "Set P1-14 = 101 for the extended parameters, give each drive a MAC address (P5-01), baud rate (P5-03), data format (P5-04) and a unique device instance (P5-09/P5-10), then set P1-12 = 6 for BACnet MS/TP control. Command BV 25 run/stop and write the speed reference to AV 15 (Hz). Read BV 0, AV 0, AV 2 and BV 1/AV 8, and reset trips with BV 27.",
  "minimum_points": [
   {
    "ref": "BV 25",
    "name": "Run/Stop CMD",
    "why": "Run/stop command (1 = run)"
   },
   {
    "ref": "AV 15",
    "name": "Speed Reference",
    "why": "Speed reference in Hz"
   },
   {
    "ref": "BV 27",
    "name": "Trip Reset",
    "why": "Resets a trip on a rising edge"
   },
   {
    "ref": "BV 0",
    "name": "Run/Stop State",
    "why": "Running status"
   },
   {
    "ref": "BV 2",
    "name": "Hand Mode",
    "why": "Hand or auto mode"
   },
   {
    "ref": "AV 0",
    "name": "Motor Frequency",
    "why": "Output frequency in Hz"
   },
   {
    "ref": "AV 2",
    "name": "Motor Current",
    "why": "Motor amps"
   },
   {
    "ref": "BV 1",
    "name": "Trip State",
    "why": "Drive tripped"
   },
   {
    "ref": "AV 8",
    "name": "Trip Code",
    "why": "Active trip code"
   }
  ],
  "enable": "Set P1-12 Primary Command Source = 6 (BACnet MS/TP mode); the drive then takes run/stop and reference from the network. BV 6 Enable State shows whether the hardware enable signal is present, and BV 3 shows a hardware inhibit.",
  "heartbeat": "P5-05 Communications Loss Timeout (0.0-5.0 s, default 1.0 s): if no valid telegram arrives in that time the drive treats it as a comms loss and acts per P5-06: 0 trip and coast to stop (default), 1 ramp to stop then trip, 2 ramp to stop only, 3 run at preset speed 4.",
  "remote_sensors": "AV 17 User PID Reference and AV 18 User PID Feedback take a PID setpoint and feedback from the BMS when the drive's PID controller is set to use them.",
  "setup": [
   "P5-01 sets the MS/TP MAC address (1-63, default 1).",
   "BACnet baud rates 9600, 19200, 38400 or 76800 in P5-03 (factory 115.2 kbps is for Modbus; auto-baud is not supported).",
   "P5-04 data format: n-1 (default), n-2, O-1 or E-1.",
   "Device instance = P5-10 x 65536 + P5-09 (0-4194304); P5-11 max master 1-127 (default 127).",
   "P5-07 = 1 lets the network set the ramp times (AV 16); the guide recommends leaving ramps to P1-03/P1-04.",
   "Wire RS-485+/RS-485- and 0 V common through the RJ45 port; terminate the end of the line with 120 ohm."
  ],
  "gotchas": [
   "AV 15 speed reference is in Hz, not %.",
   "P5-06 default 0 trips the drive on a comms loss; a trip reset (BV 27) is then needed.",
   "BV 28 Coast Stop overrides BV 26 Fast Stop.",
   "Relay commands BV 29-33 need the relay function set to user value first."
  ]
 },
