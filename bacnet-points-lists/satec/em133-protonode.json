 ],
 "equipment_type": "Power meter via BACnet gateway",
 "applies_to": "SATEC EM133 multifunction power meters connected over Modbus RTU to a ProtoNode FPC-N34/N35 gateway.",
 "summary": "The ProtoNode profile for the EM133 publishes 89 analog inputs: voltages, currents, kW, kvar, kVA and power factor per phase and in total, voltage and current THD, K-factor and TDD, averages, neutral current, frequency, unbalance, block and sliding demands and the energy totals by quadrant.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": true,
 "notes": [
  "All objects are read-only analog inputs; the guide gives no units, scaling or Modbus registers for them (the Lon columns read TBD).",
  "The same profile serves BACnet MS/TP, BACnet IP, Metasys N2 and LonWorks; the N2 point addresses match the BACnet instances."
 ],
 "source": {
  "title": "ProtoNode FPC-N34 and ProtoNode FPC-N35 Startup Guide For Interfacing Satec Products: BFM136 and EM133",
  "doc_number": null,
  "revision_date": "Document Revision 1 (effective May 2014)",
  "url": "https://satec-global.com.au/wp-content/uploads/2022/01/ProtoNode-Startup-Guide-for-Satec.Rev-1.pdf"
 },
 "integration": {
  "summary": "Read-only. Give the meter a Modbus Node-ID, add it in the ProtoNode web configurator, then map voltages, currents, total kW and PF, frequency and the energy registers.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "why": "V1/V12 voltage",
    "name": "V1/V12 Voltage"
   },
   {
    "ref": "AI 4",
    "why": "Phase 1 current",
    "name": "I1 Current"
   },
   {
    "ref": "AI 34",
    "why": "Total kW",
    "name": "Total kW"
   },
   {
    "ref": "AI 37",
    "why": "Total power factor",
    "name": "Total PF"
   },
   {
    "ref": "AI 48",
    "why": "Frequency",
    "name": "Frequency"
   },
   {
    "ref": "AI 79",
    "why": "kWh import",
    "name": "kWh import"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Set every meter on the ProtoNode's RS-485 port to Modbus RTU 9600 baud, 8 data bits, no parity, 1 stop bit, with a unique Node-ID (1-255).",
   "Each meter on the ProtoNode is its own BACnet device: Device Instance = the meter's Modbus Node-ID + Node_Offset (default 50,000).",
   "BACnet MS/TP: set the ProtoNode MAC address (1-127) on the A bank DIP switches and the baud rate on the B bank.",
   "BACnet IP: set the ProtoNode IP address in its web GUI (FST Web GUI)."
  ],
  "gotchas": [
   "The devices on one FPC-N34 must not add up to more than 1500 Modbus registers (this profile uses 89)."
  ]
 },
