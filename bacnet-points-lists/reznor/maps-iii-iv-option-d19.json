    "ref": "AV 3",
    "name": "DA_NAClg_SP",
    "why": "Neutral discharge air cooling setpoint, °F"
   },
   {
    "ref": "AV 4",
    "name": "DA_NAHtg_SP",
    "why": "Neutral discharge air heating setpoint, °F"
   },
   {
    "ref": "AV 1002",
    "name": "Duct_Press_SP",
    "why": "Duct static pressure setpoint"
   },
   {
