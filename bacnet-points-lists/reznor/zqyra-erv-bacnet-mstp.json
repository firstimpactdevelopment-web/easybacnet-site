 "integration": {
  "summary": "Fit option BHB8 and set the MS/TP address. Switch the unit with BV 1 BAS_OffOn, write the discharge setpoints, and read UnitMode (AV 1001) and UnitCmd (AV 1002) to see why the unit is on or off. Watch the fan pressure switches and the alarm BVs, and reset with BV 41.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "BAS_OffOn",
    "why": "BAS on/off command"
   },
   {
    "ref": "AV 3",
    "name": "DatSpLoDp",
    "why": "Discharge air setpoint, low dewpoint, 55-75 °F"
   },
   {
    "ref": "BV 41",
    "name": "BAS_AlmRst",
    "why": "Alarm reset"
   },
   {
    "ref": "AV 1001",
    "name": "UnitMode",
    "why": "Unit mode: 0 off, 1 starting, 2 running..."
   },
   {
    "ref": "AV 1002",
    "name": "UnitCmd",
    "why": "Source of the current on/off command"
   },
   {
    "ref": "BV 2",
    "name": "SafStatus",
    "why": "Supply fan pressure switch status"
   },
   {
    "ref": "AV 20",
    "name": "UnitDat",
    "why": "Unit discharge air temperature"
   },
   {
    "ref": "BV 14",
    "name": "AlarmLight",
    "why": "Alarm output relay on"
   },
   {
    "ref": "BV 28",
    "name": "ShutdnAlm",
    "why": "Unit shut down; manual restart needed"
   }
  ],
  "enable": "BV 1 BAS_OffOn turns the unit on or off from the BAS (default off); BV 40 BAS_Shtdwn shuts the unit down. AV 1002 shows which source (DI, BAS, schedule, CO2/VOC, test, alarm, manual) is driving on/off.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP needs the optional communication card (option BHB8).",
   "MSTP SETUP defaults (Table 44): instance 77,000, baud 38,400, MAC 0, Max Masters 127, Max Info Frames 20; press Prg to save to the card, then power cycle."
  ],
  "gotchas": [
   "After a restart alarm the unit restarts itself after 60 minutes; a shutdown alarm needs a manual restart.",
   "Runtime reset BVs clear stored hours; don't write them cyclically."
  ]
 },
