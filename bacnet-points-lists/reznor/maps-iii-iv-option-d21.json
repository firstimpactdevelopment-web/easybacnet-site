 "equipment_type": "Packaged rooftop unit / DOAS controller",
 "applies_to": "Reznor MAPS III and MAPS IV modular air processing units (packaged DX rooftop units) with control option D21 (space temperature control).",
 "summary": "MAPS III and MAPS IV units with control option D21 use a programmable system controller with an optional BMS card for BACnet MS/TP or BACnet IP/Ethernet. The D21 point list has 30 analog variables, 10 integer variables (AV 1001-1010) and 33 digital variables. Unlike D19 it adds space temperature and humidity setpoints, a state select and a BMS occupancy command.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 77000,
 "access_inferred": false,
 "notes": [
  "The point list is the CP-MAPSIII-D21 form (Doc No 303070) reprinted inside the combined MAPS III/IV controls guide (06-26).",
  "Analog variables are AV 1-30, integer variables AV 1001-1010 and digital variables BV 1-33.",
  "Building and duct static pressure points (AV 1001-1003, AV 1010) are integers; the guide says to divide them by 1000 in the BMS.",
  "There is no unit enable point in the D21 list; AV 1006 State_Sel = 5 turns the unit off.",
  "Source: Option D21 BACnet Point List, guide pages 148-149."
 ],
 "source": {
  "title": "Control System Guide for Modular Air Processing System Units, Options D15, D16, D17, D18, D19 and D21 (MAPS III and MAPS IV)",
  "doc_number": "MAPSIII&IV-D15-D16-D17-D18-D19-D21 (06-26) REV-A",
  "revision_date": "2026-06",
  "url": "https://assets.reznorhvac.com/download/bcd1b330-3a4f-11f1-ae67-0016e1e579b9/MAPSIII%26IV-D15-D16-D17-D18-D19-D21%20%2806-26%29%20REV-A.pdf"
 },
 "integration": {
  "summary": "Set the BMS protocol, instance, baud and MAC in the controller's BMS Config screens. Set OccMode_Sel (AV 1007) to 2 and command occupancy with BV 23, choose the state with AV 1006 and write the space temperature setpoint. Monitor supply fan status, space and discharge temperatures and the general alarm relay.",
  "minimum_points": [
   {
    "ref": "BV 23",
    "name": "Occupied_BMS",
    "why": "Occupancy command (needs AV 1007 = 2)"
   },
   {
    "ref": "AV 1007",
    "name": "OccMode_Sel",
    "why": "Occupancy source: 0 schedule, 1 input, 2 BMS"
   },
   {
    "ref": "AV 1006",
    "name": "State_Sel",
    "why": "Unit state: 2 auto, 3 cool, 4 heat, 5 off"
   },
   {
    "ref": "AV 26",
    "name": "SpcTempSP",
    "why": "Space temperature setpoint, 65-85 °F"
   },
   {
    "ref": "BV 22",
    "name": "Occupied",
    "why": "Occupied mode status"
   },
   {
    "ref": "BV 25",
    "name": "SF_Sts",
    "why": "Supply fan status"
   },
   {
    "ref": "AV 25",
    "name": "Spc_Temp",
    "why": "Space temperature"
   },
   {
    "ref": "AV 8",
    "name": "DA_Temp",
    "why": "Discharge air temperature"
   },
   {
    "ref": "BV 1",
    "name": "Alm_Rly_Cmd",
    "why": "General alarm relay on"
   }
  ],
  "enable": "AV 1006 State_Sel picks auto, cool, heat or off. Occupancy comes from the schedule, a digital input or the BMS, chosen with AV 1007 OccMode_Sel; with 2 = BMS, BV 23 Occupied_BMS sets occupancy.",
  "heartbeat": null,
  "remote_sensors": "Set BV 19 OA_Temp_Sel or BV 18 OA_Hum_Sel to 1 (BMS) and write AV 18 OA_Temp_BMS or AV 16 OA_Hum_BMS.",
  "setup": [
   "Default MS/TP instance 77000, baud 38400 (9600, 19200, 38400 or 76800), Max Masters 127, Max Info Frames 20.",
   "Settings: Service > BMS Config; set Protocol to BACnet MSTP or BACnet IP/Eth and Termconf PlugIn to Yes, then Instance, Baudrate and MAC."
  ],
  "gotchas": [
   "BV 23 has no effect unless AV 1007 is set to 2 (BMS).",
   "Static pressure integers are scaled x1000; divide by 1000 in the BMS."
  ]
 },
