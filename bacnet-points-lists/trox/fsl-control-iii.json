 "integration": {
  "summary": "Write MV 0 eInOperatingMode (off/automatic) and MV 1 eInOperatingType (standby/unoccupied/occupied) to run the unit from the BMS, and AV 3 fInSpTempRoom or AV 4 fInSpOffsetRoom for the room setpoint. Feed BV 0 bInFire and BV 1 bInWindow if the BMS handles them. Read MI 0/MI 1 for the actual mode, AI 1 for the operating state, AI 27 room temperature and AI 12/AI 13 for the consolidated alarms.",
  "minimum_points": [
   {
    "ref": "MV 0",
    "name": "eInOperatingMode",
    "why": "Mode preset: 2 off, 3 automatic (1 invalid)"
   },
   {
    "ref": "MV 1",
    "name": "eInOperatingType",
    "why": "Occupancy preset: standby, unoccupied, occupied"
   },
   {
    "ref": "AV 3",
    "name": "fInSpTempRoom",
    "why": "Room temperature setpoint from the BMS, °C"
   },
   {
    "ref": "BV 0",
    "name": "bInFire",
    "why": "Fire emergency stop from the BMS"
   },
   {
    "ref": "MI 0",
    "name": "eOutOperatingMode",
    "why": "Actual mode: off, automatic, manual"
   },
   {
    "ref": "AI 1",
    "name": "fOutOperatingState",
    "why": "Operating state code (standby, control, fire...)"
   },
   {
    "ref": "AI 27",
    "name": "fOutTempRoom",
    "why": "Room temperature"
   },
   {
    "ref": "AI 29",
    "name": "fOutTempSupply",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 13",
    "name": "fOutAlarmA",
    "why": "Consolidated alarm A"
   },
   {
    "ref": "AI 12",
    "name": "fOutAlarmB",
    "why": "Consolidated alarm B"
   }
  ],
  "enable": "MV 0 eInOperatingMode presets off (2) or automatic (3); 1 = invalid (no preset). MV 1 eInOperatingType presets standby, unoccupied or occupied.",
  "heartbeat": null,
  "remote_sensors": "AV 2 fInPvTempRoom, AV 7 fInPvHumidityRoom, AV 9/AV 10 air quality and AV 13 fInPvTempOda accept values from the BMS.",
  "setup": [
   "Device Object_Identifier = BACnet subnet x 65536 + BACnet identifier; default object name \"FSL-CONTROL III\".",
   "BACnet MS/TP or BACnet IP needs the matching interface card on the master controller.",
   "Max_Master default 127, Max_Info_Frames default 1."
  ],
  "gotchas": [
   "MV 3 eInCovMode is stored in EEPROM (RW-E); set it once rather than writing it repeatedly.",
   "AI 0, AI 1 and AI 2 carry state codes as numbers, not engineering values."
  ]
 },
