{
 "manufacturer": "Heatcraft",
 "manufacturer_slug": "heatcraft",
 "model": "intelliGen Integration Card (iIC) for the intelliGen Refrigeration Controller",
 "model_slug": "intelligen-iic",
 "aliases": [
  "intelliGen iIC",
  "intelliGen Integration Card",
  "iIC",
  "intelliGen Refrigeration Controller",
  "iRC",
  "25011901"
 ],
 "equipment_type": "Walk-in cooler / freezer refrigeration controller",
 "applies_to": "Heatcraft intelliGen Refrigeration Controller (iRC) systems of up to 8 evaporators, fitted with the intelliGen Integration Card.",
 "summary": "The iIC is an add-on card for the intelliGen walk-in refrigeration controller that connects it to a BMS over RS-485 using BACnet MS/TP or Modbus RTU. System-wide (global) objects cover box temperature, operating mode, alarms, setpoints, defrost settings and schedules. Per-evaporator (local) objects come in blocks of 8, one per evaporator, for sensor values, EXV position, fan settings, alarms and refrigerant-detection (RDS) data.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Standard BACnet objects need iRC firmware 01.03.xxxx or later",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Per-evaporator objects are printed as 8-instance blocks (for example AI 16-23 = Box Temperature Sensor Calibration for evaporators 1-8). Only the first object of each block (evaporator 1) is listed here; evaporator n is the first instance + (n - 1).",
  "The RDS sensor blocks are 24 instances (8 units x 3 sensors); the manual does not say whether they run by unit or by sensor, so only the first object is listed.",
  "The Short Unit Name block is printed as CSV 5-13 (9 instances) although it is marked 8x.",
  "Writing a local object for an evaporator that is not installed does nothing; it reads back a default value.",
  "System Alarms (AI 3) and Local Alarms (AI 160 block) are 32-bit bit maps; the manual has bit tables. The proprietary object types and property IDs in the manual are left out.",
  "Several writes are conditional (for example force defrost not in service mode, low superheat setpoint not with a TXV); see the manual's read/write special cases."
 ],
 "source": {
  "title": "intelliGen Integration Card (iIC) Installation & Operation Manual",
  "doc_number": "Part No. 25011901",
  "revision_date": "September 2026",
  "url": "https://www.heatcraftrpd.com/dA/0784ac1446/intelliGen%20iIC%20I&O%20Manual%202023.pdf"
 },
 "integration": {
  "summary": "Select BACnet on the controller (Connectivity menu or the web page) with the external Modbus address set to 0, give the card an MS/TP address 1-127 and baud rate, then read box temperature, operating mode and alarms, and write the box setpoint if the BMS should own it.",
  "minimum_points": [
   {
    "ref": "AV 48",
    "name": "Box Temperature Setpoint",
    "why": "Box temperature setpoint"
   },
   {
    "ref": "AV 40",
    "name": "Force Defrost",
    "why": "Write 1 to start a defrost"
   },
   {
    "ref": "AI 5",
    "name": "Box temperature",
    "why": "Box temperature"
   },
   {
    "ref": "AI 4",
    "name": "Operating mode",
    "why": "Operating mode: off, cooling, defrost, drain..."
   },
   {
    "ref": "AI 3",
    "name": "System Alarms",
    "why": "System alarm bits, 0 = clear"
   },
   {
    "ref": "AI 160",
    "name": "Local Alarms",
    "why": "Evaporator 1 alarm bits"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Protocol is chosen on the iRC (Connectivity menu) or the intelliGen web page; for BACnet the external Modbus address must be 0.",
   "MS/TP address 1-127; baud 9600, 19200 or 38400. Number MS/TP devices consecutively from 1 with no gaps.",
   "If a webserver (iWC) or multi-system (MSC) card is used, fit the iIC on the same evaporator board.",
   "Temperatures read in the unit chosen by AV 36 (°F or °C)."
  ],
  "gotchas": [
   "Local objects exist for 8 evaporators even when fewer are installed; check AI 2 / AI 136 block for which are present.",
   "Defrost schedules (AV 10-21) can only be written up to the number of defrosts in AV 9, and two defrosts cannot share a time."
  ]
 },
