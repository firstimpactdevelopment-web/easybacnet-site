 ],
 "equipment_type": "Boiler controller gateway",
 "applies_to": "Raypak boilers and water heaters with the VERSA IC control platform, connected through the ProtoNode RER (B-85) or LER (B-86) gateway.",
 "summary": "The ProtoNode RER reads one or more Raypak VERSA IC controls over Modbus RTU and makes each one a separate BACnet IP or BACnet MS/TP device. The Master profile used for single boilers and cascade masters has 173 objects: system temperatures and calls, a 29-point block for each of up to 4 boilers, writable setpoint, outdoor reset, DHW, tank and pool settings, and on/off commands per boiler. Cascade followers use a smaller Follower profile.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + VERSA IC Modbus node ID (BN_Node_Offset default 50000)",
 "access_inferred": true,
 "notes": [
  "Each VERSA IC unit is its own BACnet device: device instance = BN_Node_Offset (default 50000) + its Modbus node ID. Object IDs below are the same on every device.",
  "No read/write column is given. AVs and BVs map to LonWorks input variables and are marked writable; AIs and BIs are read-only.",
  "Object ID 133 is not used.",
  "Follower profile (cascade followers only): BI 1 Blr 1 detected, AI 2-29 the same Blr 1 values as AI 18-45 here, BV 30 Blr 1 On/Off, AI 31 Blr 1 Flow Sensor, AI 32 Blr 1 Flame Current.",
  "No units or state texts are given in the object table.",
  "The object table in the manual is not selectable text; it was keyed in by hand."
 ],
 "integration": {
  "summary": "Add a Master profile in the ProtoNode Web Configurator for each VERSA IC (Follower profile for cascade followers) with its Modbus node ID, then find each one as its own BACnet device. Turn boilers on with the Blr On/Off BVs and set the target with Target Mode plus Setpoint Target or Target Mod Rate; read supply temperature, boiler outlet temperature, modulation rate, ignition status and error code.",
  "minimum_points": [
   {
    "ref": "BV 162",
    "name": "Blr 1 On/Off",
    "why": "Boiler 1 on/off command (BV 163-165 for 2-4)"
   },
   {
    "ref": "BV 134",
    "name": "Target Mode",
    "why": "Selects which target applies (values not documented)"
   },
   {
    "ref": "AV 135",
    "name": "Setpoint Target",
    "why": "Target water setpoint"
   },
   {
    "ref": "AV 160",
    "name": "Target Mod Rate",
    "why": "Target modulation rate"
   },
   {
    "ref": "AI 25",
    "name": "Blr 1 Ignition Status",
    "why": "Boiler 1 ignition state code"
   },
   {
    "ref": "AI 2",
    "name": "System Supply Temperature",
    "why": "System supply water temperature"
   },
   {
    "ref": "AI 18",
    "name": "Blr 1 Outlet temperature",
    "why": "Boiler 1 outlet water temperature"
   },
   {
    "ref": "AI 23",
    "name": "Blr 1 Mod Rate",
    "why": "Boiler 1 modulation rate"
   },
   {
    "ref": "AI 30",
    "name": "Blr 1 Error Code",
    "why": "Boiler 1 active error code"
   }
  ],
  "enable": "The Master profile has writable on/off BVs per boiler (BV 162-165) and a Target Mode BV with Setpoint Target (AV 135), Target temperature (AV 158) and Target Mod Rate (AV 160). The manual does not explain the Target Mode values or which target applies in each mode.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance = BN_Node_Offset + Modbus node ID; the offset defaults to 50000 and is changed in the Web Configurator (node 10 -> 50010).",
   "S-bank DIP switches pick the protocol: all off = BACnet IP (default), S0 on = BACnet MS/TP.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A-bank switches; baud on B0-B3 (9600, 19200, 38400, 57600 or 76800).",
   "VERSA IC side: Modbus RTU at 19200 baud, each unit with a unique node ID; up to 8 Master units (1400 registers) per ProtoNode RER.",
   "Default ProtoNode IP address 192.168.1.24; the Web Configurator is used to add profiles and set the offset."
  ],
  "gotchas": [
   "Use the Master profile only for single boilers or the cascade master; followers on the Ft-bus/TN-bus need the Follower profile.",
   "The ProtoNode connects only to a master unit, not directly to a follower.",
   "Never set an MS/TP MAC address above 127; 128-255 cannot be auto-discovered.",
   "Writable AVs are boiler settings; avoid rewriting them cyclically."
  ]
 },
