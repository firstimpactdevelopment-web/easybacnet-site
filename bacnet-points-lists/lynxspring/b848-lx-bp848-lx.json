{
 "manufacturer": "Lynxspring",
 "manufacturer_slug": "lynxspring",
 "model": "B848-LX / BP848-LX configurable field controller (Onyxx LX)",
 "model_slug": "b848-lx-bp848-lx",
 "aliases": [
  "B848-LX",
  "BP848-LX",
  "B848",
  "BP848",
  "Onyxx LX B848",
  "Onyxx LX BP848"
 ],
 "equipment_type": "Rooftop / air handling unit controller (configurable)",
 "applies_to": "Lynxspring Onyxx LX B848-LX and BP848-LX configurable MS/TP field controllers (8 UI, 8 BO, 4 AO) set up for RTU, AHU, heat pump or fan coil applications.",
 "summary": "The B848-LX and BP848-LX are configurable Onyxx LX field controllers with eight universal inputs, eight binary and four analog outputs. They run a fixed rooftop/air handler application that is set up through multi-state configuration objects: staging, economizer, power exhaust, humidification, supply pressure, zone averaging from VAV boxes and fan coil options. The BACnet MS/TP map lists the I/O, setpoints, zone data, status flags, PID loops and all configuration MSVs.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Onyxx LX UI software 4.0 or later, firmware 2.224 or later",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The guide has no read/write column; access is inferred from its tags (Status = read-only; Cfg, User and Cmd = writable).",
  "The B848-LX and BP848-LX guides print the same object table (one typo apart: AV 14 tagged \"Staus\"); the BP848-LX guide asks for firmware 2.238 or later.",
  "MSV 4-7 names look shifted by one row in the guide (MSV 4 printed as Units_Type for cooling control type, MSV 5 Clg_Type, MSV 6 ClgBO_Loc, MSV 7 ClgAO_Loc); MSV 17-19 repeat the name as description; kept as printed. BV 7 FreezeCond and BV 15 FanStat print state texts (Night/Day, Continuous/Intermittent) that look copied from other rows; kept as printed.",
  "Some MSV state lists are printed in short form (for example \"AI-1..AI-8\"); those are kept as printed rather than numbered. MSV 33 prints the power exhaust type states.",
  "AV 40 is printed with a gap (\"RTSPclg_STBd t\"); listed as RTSPclg_STBdt to match AV 41.",
  "Temperature units are listed as °F; the guide prints °F and °C ranges and the controller can be set to metric."
 ],
 "source": {
  "title": "B848-LX Installation and Wiring Guide",
  "doc_number": null,
  "revision_date": null,
  "url": "https://www.cochranesupply.com/media/assets/product/documents/Lynxspring/B848%20Installation%20and%20Wiring%20Guide.pdf",
  "unofficial": true,
  "host": "Cochrane Supply"
 },
 "integration": {
  "summary": "Set the address and baud on the DIP switches and configure the application through the MSVs (equipment type, staging, economizer, sensors). Then set system mode and occupied setpoints from the BMS and read return/supply temperatures, fan status, static pressure and the freeze and TZ sensor status.",
  "minimum_points": [
   {
    "ref": "MV 11",
    "name": "Mode",
    "why": "System mode (Off/Auto/Cool/Heat)"
   },
   {
    "ref": "AV 35",
    "name": "RTSPclg_Occ",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "AV 36",
    "name": "RTSPhtg_Occ",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "BV 5",
    "name": "SystemOccSchd",
    "why": "System occupancy schedule state"
   },
   {
    "ref": "AV 14",
    "name": "ReturnT",
    "why": "Return air temperature"
   },
   {
    "ref": "AV 16",
    "name": "SupplyT",
    "why": "Supply air temperature"
   },
   {
    "ref": "BV 15",
    "name": "FanStat",
    "why": "Fan status"
   },
   {
    "ref": "AV 22",
    "name": "SupplyPres",
    "why": "Supply static pressure"
   },
   {
    "ref": "BV 7",
    "name": "FreezeCond",
    "why": "Freeze condition active"
   },
   {
    "ref": "BV 24",
    "name": "TZstatus",
    "why": "TZ room sensor comms status"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP address is set on DIP switch bank DS2 (1-127); baud on DS1: 010 = 9600, 110 = 19200, 001 = 38400, 011 = 76800.",
   "An EOL jumper terminates the MS/TP trunk on the last controller; a second jumper terminates the TZ sensor bus.",
   "Firmware updates use a USB-COM adapter or a USB to MS/TP converter cable."
  ],
  "gotchas": [
   "Most behaviour depends on the configuration MSVs; a missing location setting leaves the matching value unused.",
   "BV 10 saves objects to flash and restarts the controller; do not write it cyclically."
  ]
 },
