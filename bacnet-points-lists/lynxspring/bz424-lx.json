 "equipment_type": "VAV box controller",
 "applies_to": "Lynxspring Onyxx LX BZ424-LX configurable VAV controllers (4 UI, 2 AO, 4 BO, built-in actuator) on BACnet MS/TP.",
 "summary": "The BZ424-LX is the larger configurable VAV controller in the Onyxx LX range, with four universal inputs, two analog and four binary outputs and an integrated damper actuator and airflow sensor. Its fixed BACnet MS/TP map covers airflow and damper control, zone setpoints for up to three zones, humidity, CO2 and dewpoint/condensation logic, five auxiliary outputs, PID loops and configuration multi-states.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The guide has no read/write column; access is inferred from its tags (Status = read-only; Cfg, User and Cmd = writable).",
  "The four binary outputs are printed as AO 3-AO 6 (named BO_1-BO_4); AO 4 is printed as \"A04\".",
  "Some MSV state lists are printed in short form (for example \"AI-1, AI-2, AI-3 or AI-4\"); those are kept as printed rather than numbered.",
  "BV 3 OccSched is tagged \"Clg\" in the guide (likely Cfg); treated as writable.",
  "PID loop objects LOOP0-LOOP9 are listed as LO with their printed action and default gains.",
  "Temperature units are listed as °F; the guide prints °F and °C ranges and the controller can be set to metric."
 ],
 "source": {
  "title": "BZ424-LX Configurable VAV MS/TP - Installation and Wiring Guide",
  "doc_number": null,
  "revision_date": null,
  "url": "https://www.cochranesupply.com/media/assets/product/documents/Lynxspring/BZ424%20Installation%20and%20Wiring%20Guide.pdf",
  "unofficial": true,
  "host": "Cochrane Supply"
 },
 "integration": {
  "summary": "Set the address and baud on the DIP switches, configure box type, airflow limits, inputs and auxiliary outputs, then drive occupancy with BV 3 and set the occupied setpoints. Read room temperature, airflow, damper position, occupancy mode and the condensation status.",
  "minimum_points": [
   {
    "ref": "BV 3",
    "name": "OccSched",
    "why": "Occupancy schedule (Day = occupied)"
   },
   {
    "ref": "AV 12",
    "name": "RTSPclg_Occ",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "AV 13",
    "name": "RTSPhtg_Occ",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "MV 24",
    "name": "OccMode",
    "why": "Occupancy mode"
   },
   {
    "ref": "AV 41",
    "name": "RoomT",
    "why": "Room temperature"
   },
   {
    "ref": "AI 4",
    "name": "zAirFlow",
    "why": "Measured airflow"
   },
   {
    "ref": "AV 2",
    "name": "zActiveFlowSP",
    "why": "Active airflow setpoint"
   },
   {
    "ref": "AO 2",
    "name": "zActMod",
    "why": "Damper position, %"
   },
   {
    "ref": "BV 5",
    "name": "Cond_Status",
    "why": "Condensation detected"
   },
   {
    "ref": "AV 39",
    "name": "ValidationErr",
    "why": "Configuration error code (0 = none)"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP address is set on DIP switch bank DS2 (1-127); baud on DS1: 010 = 9600, 110 = 19200, 001 = 38400, 011 = 76800.",
   "An EOL jumper terminates the MS/TP trunk on the last controller; a second jumper terminates the TZ sensor bus.",
   "Firmware updates use a USB-COM adapter or a USB to MS/TP converter cable."
  ],
  "gotchas": [
   "K-factor (AV 30) and duct area (AV 31) must match the box for airflow to read right.",
   "BV 10 saves objects to flash and restarts the controller; do not write it cyclically."
  ]
 },
