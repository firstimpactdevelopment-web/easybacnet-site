{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "Falcon Hydronic boiler control (ProtoNode)",
 "model_slug": "falcon-hydronic-protonode",
 "aliases": [
  "Falcon Hydronic",
  "ClearFire Falcon",
  "CB Falcon",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Hot water boiler control via BACnet gateway",
 "applies_to": "Cleaver-Brooks hot water boilers with the Falcon hydronic burner control, read through a ProtoNode RER gateway.",
 "summary": "The ProtoNode maps the Falcon hydronic control's Modbus RTU registers to a fixed set of BACnet objects: safety and limit inputs, water and stack temperatures, firing rate, flame signal, burner state, lockout and hold codes, pump status and lead/lag data. The BMS can enable the burner and lead/lag and write the CH and lead/lag setpoints in °F or °C.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "Access follows the guide's write-point stars: the starred AV/BV objects are writable, everything else is read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column.",
  "Temperature setpoints come as separate °F and °C objects (AV 21 / AV 41, AV 31 / AV 51); write one or the other.",
  "The table starts at BI 3; BI 1 and BI 2 are not printed for this control."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Enable the burner, write the CH setpoint (°F or °C object), and use the lead/lag enable and setpoint if the boilers run lead/lag. Read burner state, outlet temperature, firing rate, the alarm input and the lockout code.",
  "minimum_points": [
   {
    "ref": "AV 1",
    "why": "Burner enable from the BMS",
    "name": "BOILER BURNER ENABLE"
   },
   {
    "ref": "AV 21",
    "why": "Central heat setpoint, °F",
    "name": "BOILER CH SETPOINT DEG F"
   },
   {
    "ref": "AV 11",
    "why": "Lead/lag enable",
    "name": "BOILER LEAD/LAG ENABLE"
   },
   {
    "ref": "AV 31",
    "why": "Lead/lag setpoint, °F",
    "name": "BOILER LEAD/LAG SETPOINT DEG F"
   },
   {
    "ref": "AI 16",
    "why": "Burner control state code",
    "name": "BURN_CTL_STATE"
   },
   {
    "ref": "AI 2",
    "why": "Outlet water temperature, °F",
    "name": "OUTLET WATER TEMP DEG F"
   },
   {
    "ref": "AI 74",
    "why": "Firing rate, %",
    "name": "FIRING_RATE_PERCENT"
   },
   {
    "ref": "BI 8",
    "why": "Alarm",
    "name": "Alarm"
   },
   {
    "ref": "AI 17",
    "why": "Lockout code",
    "name": "LOCKOUT_CODE"
   }
  ],
  "enable": "AV 1 BOILER BURNER ENABLE and AV 11 BOILER LEAD/LAG ENABLE are the BMS enables; AV 21 / AV 41 write the CH setpoint in °F / °C.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
