 "equipment_type": "Boiler interface module via BACnet gateway",
 "applies_to": "Cleaver-Brooks HSC boiler interface modules (one boiler each), read through a ProtoNode RER gateway.",
 "summary": "The ProtoNode maps the HSC boiler interface module to BACnet: boiler status, alarm word, hours, cycles, inlet and outlet temperature, firing rate and the module's inputs and outputs. Writable AVs set DHW setpoints and enables, a remote setpoint and enable, and a heartbeat.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": true,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The guide prints no write-point stars for this profile; the AV/BV objects map to Metasys N2 outputs and Modbus output registers or coils, so they are taken as writable. Access is inferred from object type.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
