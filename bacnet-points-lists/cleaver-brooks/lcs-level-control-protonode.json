 "equipment_type": "Boiler water level controller via BACnet gateway",
 "applies_to": "Cleaver-Brooks LCS water level controllers (one or two tanks), read through a ProtoNode RER gateway.",
 "summary": "A read-only ProtoNode profile for the LCS level controller: tank 1 and 2 levels and setpoints, primary and secondary valve positions, alarm word and a common alarm, low-water-cutoff and high/low water alarms and contacts per tank, and the state of each digital input and output.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
