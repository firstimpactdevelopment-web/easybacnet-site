{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "CB120 flame safeguard (ProtoNode)",
 "model_slug": "cb120-protonode",
 "aliases": [
  "CB120",
  "CB 120",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Boiler flame safeguard via BACnet gateway",
 "applies_to": "Cleaver-Brooks boilers with the CB120 flame safeguard, read through a ProtoNode RER gateway.",
 "summary": "A read-only ProtoNode profile for the CB120 flame safeguard: terminal inputs and outputs, status and message codes, flame signal, lockout count, burner minutes and cycles, the last ten lockouts with their burner hours and cycles, and limit/interlock inputs.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Read-only. Map the status code, blower and main valve outputs, flame signal and the alarm output, plus the latest lockout message.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "why": "Burner status code",
    "name": "Status"
   },
   {
    "ref": "BI 17",
    "why": "Blower output on",
    "name": "Blower_Out"
   },
   {
    "ref": "BI 18",
    "why": "Main valve output on",
    "name": "Main_Valve_Out"
   },
   {
    "ref": "AI 5",
    "why": "Flame signal",
    "name": "Flame"
   },
   {
    "ref": "BI 24",
    "why": "Alarm output",
    "name": "Alarm_Out"
   },
   {
    "ref": "AI 11",
    "why": "Lockout 1 message code",
    "name": "LOCKOUT1_MSG"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
