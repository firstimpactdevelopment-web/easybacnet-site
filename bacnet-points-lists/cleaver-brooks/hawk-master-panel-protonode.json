{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "Hawk Master Panel lead/lag (ProtoNode)",
 "model_slug": "hawk-master-panel-protonode",
 "aliases": [
  "Hawk Master Panel",
  "Hawk Master",
  "CB Master Panel",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Boiler lead/lag master panel via BACnet gateway",
 "applies_to": "Cleaver-Brooks Hawk Master Panels sequencing up to eight Hawk boilers (A-H), read through a ProtoNode RER gateway.",
 "summary": "The ProtoNode maps the Hawk master panel to BACnet: per-boiler communication, power, ready and start-output bits, sequence status, run time since last rotation, lead/lag order and control output, plus plant pressure or temperature, on/off points and setpoint limits. Writable AVs set lag start/stop points and timers, the boiler order and the setpoint.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "Access follows the guide's write-point stars: the starred AV/BV objects are writable, everything else is read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column.",
  "Boilers E-H have their own blocks next to A-D; only boiler A objects are in the minimum list.",
  "Objects named N510[..], AMB[..], AMI[..] or AMR[..] are spare tags in the profile with no stated use."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Write the plant setpoint with AV 51 and read operating pressure or temperature, each boiler's sequence status and start output, and the sensor and low pressure alarms.",
  "minimum_points": [
   {
    "ref": "AV 51",
    "why": "Setpoint value written by the BMS",
    "name": "Setpoint Value Write"
   },
   {
    "ref": "AI 404",
    "why": "Operating pressure or temperature",
    "name": "Operating Pressure/Temp"
   },
   {
    "ref": "AI 419",
    "why": "Steam pressure (water temperature) setpoint",
    "name": "Steam Pressure (Water Temp) SP"
   },
   {
    "ref": "AI 614",
    "why": "Boiler A sequence status",
    "name": "Boiler A Sequence Status"
   },
   {
    "ref": "BI 1305",
    "why": "Boiler A start output",
    "name": "Boiler A Start Output"
   },
   {
    "ref": "BI 1291",
    "why": "Steam/water sensor failure",
    "name": "Steam/Water Sensor Fail"
   },
   {
    "ref": "BI 1292",
    "why": "Low steam pressure",
    "name": "Low Steam Pressure"
   },
   {
    "ref": "BI 1323",
    "why": "I/O module failure",
    "name": "I/O Module Failure"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
