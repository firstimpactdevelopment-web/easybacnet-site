 "equipment_type": "Pump interface module (boiler plant pumps) via BACnet gateway",
 "applies_to": "Cleaver-Brooks HSC pump interface modules (up to four system pumps), read through a ProtoNode RER gateway.",
 "summary": "The ProtoNode maps the HSC pump interface module to BACnet: input and output words, pump count, scaled analog inputs, PID process variable, setpoint and output, lead/lag pump numbers and pump run/auto inputs and outputs. Three AVs take a remote setpoint, a modulation override and a heartbeat.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": true,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The guide prints no write-point stars for this profile; the AV/BV objects map to Metasys N2 outputs and Modbus output registers or coils, so they are taken as writable. Access is inferred from object type.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column.",
  "BIs named after a register and bit (e.g. 30021_9) are spare bits in the profile."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Write the remote setpoint (AV 1) and keep the heartbeat (AV 3) updated. Read the run request, pump run outputs, PID process variable and the alarm output.",
  "minimum_points": [
   {
    "ref": "AV 1",
    "why": "Remote setpoint",
    "name": "Remote Setpoint Write"
   },
   {
    "ref": "AV 3",
    "why": "Heartbeat written by the BMS",
    "name": "Heartbeat Write Tag"
   },
   {
    "ref": "BI 9",
    "why": "Pump run request",
    "name": "Pump Run Request"
   },
   {
    "ref": "BI 17",
    "why": "Pump 1 run output",
    "name": "Pump 1 Run Output"
   },
   {
    "ref": "AI 7",
    "why": "PID process variable",
    "name": "PID PV Scaled Value"
   },
   {
    "ref": "BI 21",
    "why": "Alarm output",
    "name": "Alarm Output"
   }
  ],
  "enable": null,
  "heartbeat": "AV 3 Heartbeat Write Tag is written by the BMS; the guide does not state the timeout.",
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
