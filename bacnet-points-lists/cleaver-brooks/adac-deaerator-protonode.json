{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "ADAC deaerator / surge tank control (ProtoNode)",
 "model_slug": "adac-deaerator-protonode",
 "aliases": [
  "ADAC",
  "CB deaerator control",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Boiler feedwater deaerator and surge tank controller via BACnet gateway",
 "applies_to": "Cleaver-Brooks deaerator and surge tank packages with the ADAC control, read through a ProtoNode RER gateway.",
 "summary": "A read-only ProtoNode profile for the ADAC control: deaerator temperature, pressure and level, make-up and steam valve signals, feedwater header pressure, surge tank pressure, temperature and level, feed and transfer pump run times and lead/lag status, pump alarms and stack-light states.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column.",
  "Objects named DAR1[..] or DAI1[..] are spare tags in the profile with no stated use."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Read-only. Map deaerator pressure, level and temperature, feedwater header pressure, surge tank level and the no-alarm relay states.",
  "minimum_points": [
   {
    "ref": "AI 16",
    "why": "Deaerator tank pressure",
    "name": "Deaerator Tank Pressure"
   },
   {
    "ref": "AI 17",
    "why": "Deaerator tank water level",
    "name": "Deaerator Tank Wtr Lvl"
   },
   {
    "ref": "AI 15",
    "why": "Deaerator temperature",
    "name": "Deaerator Temp"
   },
   {
    "ref": "AI 20",
    "why": "Boiler feedwater header pressure",
    "name": "Boiler Feed Wtr Header Pressure"
   },
   {
    "ref": "AI 41",
    "why": "Surge tank water level",
    "name": "Surge Tank Wtr Lvl"
   },
   {
    "ref": "BI 61",
    "why": "Deaerator no-alarms relay OK",
    "name": "Deaerator No Alarms Relay OK"
   },
   {
    "ref": "BI 129",
    "why": "Surge tank no-alarms relay OK",
    "name": "Surge Tank No Alarms Relay OK"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
