{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "Hawk 1000 boiler control (ProtoNode)",
 "model_slug": "hawk-1000-protonode",
 "aliases": [
  "Hawk 1000",
  "CB Hawk 1000",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Steam or hot water boiler control via BACnet gateway",
 "applies_to": "Cleaver-Brooks boilers with the Hawk 1000 PLC boiler control, read through a ProtoNode RER gateway.",
 "summary": "The ProtoNode maps the Hawk 1000 boiler control to BACnet: a long list of alarm and status bits (limits, actuators, sensors, flame safeguard), steam pressure or water temperature, setpoints, firing rate, stack and economizer temperatures, burner control status lines, run time and cycles. The BMS can start the boiler, write a remote setpoint or firing rate, and must keep a heartbeat bit updated.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "Access follows the guide's write-point stars: the starred AV/BV objects are writable, everything else is read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Start the boiler with BV 2 and keep BV 1 heartbeat toggling; write the operating setpoint (AV 1) or a remote firing rate (AV 2). Read load demand, steam pressure or water temperature, firing rate and the alarm output.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "why": "Remote start from the BMS",
    "name": "Remote Start From BMS"
   },
   {
    "ref": "BV 1",
    "why": "Heartbeat written by the BMS",
    "name": "Heart Beat From BMS"
   },
   {
    "ref": "AV 1",
    "why": "Remote operating setpoint",
    "name": "Rem Op SP Boiler"
   },
   {
    "ref": "AV 2",
    "why": "Remote firing rate",
    "name": "Rem Firing Rate"
   },
   {
    "ref": "BI 57",
    "why": "Boiler load demand",
    "name": "Boiler Load Demand"
   },
   {
    "ref": "AI 9",
    "why": "Steam pressure or hot water temperature",
    "name": "Steam Pressure or Hot Wtr Temp"
   },
   {
    "ref": "AI 7",
    "why": "Active setpoint",
    "name": "SP Steam Pressure/Wtr Temp"
   },
   {
    "ref": "AI 5",
    "why": "Firing rate",
    "name": "Firing Rate"
   },
   {
    "ref": "BI 55",
    "why": "Alarm output",
    "name": "Alm Output"
   }
  ],
  "enable": "BV 2 Remote Start From BMS; BI 47 shows the boiler's remote enable input. The firing-rate mode bits (BI 58-60) show whether remote, manual or auto modulation is active.",
  "heartbeat": "BV 1 Heart Beat From BMS is written by the BMS; the guide does not state the timeout.",
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": [
   "Elapsed time and cycle counts appear twice: as two 16-bit word objects and as single objects.",
   "Objects named AWB[..] or AWR[..] are spare tags in the profile with no stated use."
  ]
 },
