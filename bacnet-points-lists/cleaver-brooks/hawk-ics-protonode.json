{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "Hawk ICS boiler control (ProtoNode)",
 "model_slug": "hawk-ics-protonode",
 "aliases": [
  "Hawk ICS",
  "CB ICS",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Steam or hot water boiler control via BACnet gateway",
 "applies_to": "Cleaver-Brooks boilers with the Hawk ICS control, read through a ProtoNode RER gateway.",
 "summary": "A read-only ProtoNode profile for the Hawk ICS boiler control: alarm and status bits (limits, actuators, flame safeguard, O2, sensor failures), firing-rate modes, flame strength, firing rate, O2, setpoints, steam pressure or water temperature, stack and economizer temperatures, burner status lines, run time and cycles.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Read-only. Map load demand, steam pressure or water temperature, setpoint, firing rate and the alarm output.",
  "minimum_points": [
   {
    "ref": "BI 57",
    "why": "Boiler load demand",
    "name": "Boiler Load Demand"
   },
   {
    "ref": "BI 47",
    "why": "Remote enable input",
    "name": "Remote enable input"
   },
   {
    "ref": "AI 9",
    "why": "Steam pressure or hot water temperature",
    "name": "Steam Pressure or HW Temp"
   },
   {
    "ref": "AI 7",
    "why": "Active setpoint",
    "name": "Set Point Steam Pressure/Water Temp"
   },
   {
    "ref": "AI 5",
    "why": "Firing rate",
    "name": "Firing Rate"
   },
   {
    "ref": "BI 42",
    "why": "Main fuel valve open",
    "name": "Main Fuel Valve Open"
   },
   {
    "ref": "BI 55",
    "why": "Alarm output",
    "name": "Alarm Output"
   },
   {
    "ref": "AI 28",
    "why": "Burner control status line 1 (Honeywell)",
    "name": "Brnr Control Status Line 1 Honeywell"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": [
   "Elapsed time and cycle counts appear twice: as two 16-bit word objects and as single objects."
  ]
 },
