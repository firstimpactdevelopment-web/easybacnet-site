{
 "manufacturer": "Cleaver-Brooks",
 "manufacturer_slug": "cleaver-brooks",
 "model": "Hawk 5000 boiler control (ProtoNode)",
 "model_slug": "hawk-5000-protonode",
 "aliases": [
  "Hawk 5000",
  "CB Hawk 5000",
  "ProtoNode RER",
  "750-426"
 ],
 "equipment_type": "Steam boiler control via BACnet gateway",
 "applies_to": "Cleaver-Brooks steam boilers with the Hawk 5000 control, read through a ProtoNode RER gateway.",
 "summary": "A read-only ProtoNode profile for the Hawk 5000 control: burner sequence and limit inputs, transmitter bad-quality and high/low alarm bits, steam pressure, drum level, steam and feedwater flow, stack and economizer temperatures, O2, VSD data, actuator positions, setpoints and burner control status.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + Modbus Node-ID",
 "access_inferred": false,
 "notes": [
  "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
  "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
  "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
  "Where a description is filled in, it gives the register from the guide's Modbus column."
 ],
 "source": {
  "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
  "doc_number": "750-426",
  "revision_date": "03/2018",
  "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
  "unofficial": true,
  "host": "watmfg.com"
 },
 "integration": {
  "summary": "Read-only. Map steam pressure and setpoint, drum level, firing rate, blower running and the burner control fault.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "why": "Steam pressure",
    "name": "Steam Press"
   },
   {
    "ref": "AI 17",
    "why": "Steam pressure setpoint",
    "name": "Steam Press SP"
   },
   {
    "ref": "AI 2",
    "why": "Drum level",
    "name": "Drum Level"
   },
   {
    "ref": "AI 23",
    "why": "Firing rate",
    "name": "Firing Rate"
   },
   {
    "ref": "BI 1",
    "why": "Combustion air blower running",
    "name": "Comb Air Blower Running"
   },
   {
    "ref": "BI 38",
    "why": "Load demand",
    "name": "Load Demand"
   },
   {
    "ref": "BI 148",
    "why": "Burner control fault alarm",
    "name": "Burner Control Fault Alm"
   },
   {
    "ref": "BI 14",
    "why": "Low water cutoff",
    "name": "Lo Water Cutoff (LWCO)"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
   "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
   "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
   "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
  ],
  "gotchas": []
 },
