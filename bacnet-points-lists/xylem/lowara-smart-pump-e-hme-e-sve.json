 "equipment_type": "Multistage smart pump with integrated drive (booster)",
 "applies_to": "Lowara Smart Pump Range multistage pumps e-HME, e-SVE, VME and e-SVIE (firmware 101.10 and later), alone or in a 2-3 pump multi-pump set.",
 "summary": "The Lowara Smart Pump multistage models have BACnet MS/TP built into the drive. Analog Values cover start/stop, control mode, speed and pressure setpoints, ramps, minimum-pressure protection and multi-pump settings; Analog Inputs give speed, pressure, current, power, temperatures, error and alarm codes and an error log.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "101.10 or later (e-HME, e-SVE, VME, e-SVIE)",
 "default_device_instance": 84002,
 "access_inferred": false,
 "notes": [
  "The device instance is 84002 from the factory; change it with parameter P53 (BACnet device ID offset) or by writing the Device object's Object_Identifier.",
  "AV 0 uses inverted logic: 0 = start, 1 = stop.",
  "Setpoint limits and defaults depend on the pump model; speed limits come from P26/P27.",
  "Bit-field AIs (10, 11, 13, 14 and the log bit fields) must be split into bits; the manual lists each bit.",
  "AI 17-32 show one row of the 8-row error log, chosen with AV 8.",
  "Objects the manual marks \"N. A.\" (not used) or \"RESERVED\" are left out.",
  "In a multi-pump booster set every pump with an RS485 Module Smart Pump is its own BACnet device with a unique P51 address and P53 device ID offset."
 ],
 "integration": {
  "summary": "Wire RS-485 to each drive, set a unique P51 MAC address and P53 device ID offset per pump, and pick a baud rate (38400 suggested). Write AV 1 for the control mode and AV 4 (pressure) or AV 2 (speed in ACT mode), then AV 0 = 0 to start.",
  "minimum_points": [
   {
    "ref": "AV 0",
    "why": "Start/stop (0 = start, 1 = stop)",
    "name": "STOP START"
   },
   {
    "ref": "AV 1",
    "why": "Control mode: 0 ACT, 1 HCS, 2 MSE, 3 MSY",
    "name": "CONTROL MODES"
   },
   {
    "ref": "AV 4",
    "why": "Pressure setpoint for HCS / MSE / MSY",
    "name": "HEAD S.P"
   },
   {
    "ref": "AV 2",
    "why": "Speed setpoint in ACT mode, rpm",
    "name": "RPM SETPOINT"
   },
   {
    "ref": "AI 0",
    "why": "Motor speed, rpm",
    "name": "MEASURED RPM"
   },
   {
    "ref": "AI 1",
    "why": "Measured pressure, bar/psi per AV 3",
    "name": "MEASURED HEAD"
   },
   {
    "ref": "AI 4",
    "why": "Input power, W",
    "name": "INPUT POWER"
   },
   {
    "ref": "AI 12",
    "why": "Current alarm code",
    "name": "ALARM CODE"
   },
   {
    "ref": "AI 9",
    "why": "Current error code",
    "name": "ERROR CODE"
   }
  ],
  "enable": "AV 0 STOP START starts (0) or stops (1) the pump; AV 1 picks the control mode. AV 17 AUTOSTART sets whether the pump restarts by itself after power-up.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP master; baud 4800-57600, 38400 suggested (4800 gives frequent timeouts).",
   "MAC address is parameter P51 Address, factory 1.",
   "Device instance factory 84002; set with P53 BACnet device ID offset.",
   "RS-485 on terminals 15 (B1), 16 (A1), 17 (GND) on single-phase drives or 7 (B1), 6 (A1), 5 (GND) on three-phase drives."
  ],
  "gotchas": [
   "While BACnet communication is active most parameters are locked at the drive keypad.",
   "Set P69 Avoid frequent parameters saving = yes (AV 13) if the BMS writes setpoints often, to spare the EEPROM.",
   "AV 9 RESET DEFAULT restores factory values; do not write it routinely.",
   "Multi-pump sets also need a unique P55 Multipump Address on each pump."
  ]
 },
