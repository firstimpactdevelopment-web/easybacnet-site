 "model": "Series RSME / RSMC Room Status Monitor",
 "model_slug": "rsme-rsmc-room-status-monitor",
 "short_model": "RSME / RSMC",
 "aliases": [
  "RSME",
  "RSMC",
  "Series RSME",
  "Series RSMC",
  "DwyerOmega RSME",
  "Dwyer room pressure monitor"
 ],
 "equipment_type": "Room pressure monitor",
 "applies_to": "Dwyer Series RSME/RSMC room status monitors (built-in differential pressure plus universal and external BACnet inputs) for isolation rooms, labs and cleanrooms.",
 "summary": "The RSME/RSMC shows room differential pressure from a built-in sensor and can add two universal inputs (temperature, humidity, pressure or flow), a door/switch input and up to three external BACnet sensors read from other devices. It runs on BACnet MS/TP (or Modbus RTU) and exposes the readings, alarm states, alarm limits, room modes and almost all setup as objects. Up to three rooms can be shown on the display.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "1.2 (application software 1.0.10R)",
 "default_device_instance": 607127,
 "access_inferred": false,
 "notes": [
  "Object names come from Table 1 of the manual; access, units and state texts come from the per-object pages (Present Value property access).",
  "Table 1 and the detail pages disagree on a few names. MSV 16 is printed \"Binary Input Alarm Enable\" in Table 1 but its detail page, states and siblings (MSV 19, MSV 58) make it the input status, so the detail name \"Binary Input Status\" is used. BV 11 (detail: \"Binary Alarm Enable\"), CSV 11 and the MSV 36-38 detail name keep Table 1. The BV 18 text calls Reset Alarms BV21; Table 1 and its own page put it at BV 22.",
  "AV 18 is printed \"U12 Min Scale Value\" and AV 41 \"ES3 Low Limit\"; names are kept as printed.",
  "Units are defaults: pressure objects follow MV 1 Pressure Unit (default inWC); universal and external sensor values follow their media type and unit setting (default °F); AV 6/7 default to volts for UI1 and AV 15/16 to mA for UI2.",
  "Multi-state values are typed MSV in the manual and shown here as MV."
 ],
 "source": {
  "title": "Series RSME/RSMC BACnet/Modbus Operating Instructions",
  "doc_number": null,
  "revision_date": null,
  "url": "https://assets.dwyeromega.com/manuals-do/RSMC_BACnet_and_Modbus_Operation_Instructions.pdf"
 },
 "integration": {
  "summary": "Read the room pressure (AI 1) and its alarm status (MSV 3), plus any universal or external inputs that are in use and their alarm statuses. The BMS can set each room to occupied, unoccupied or cleaning with MSV 36-38, and reset latched alarms with BV 22.",
  "minimum_points": [
   {
    "ref": "MV 36",
    "name": "Room 1 Mode",
    "why": "Room 1 mode: 1 Occupied, 2 Unoccupied, 3 Cleaning"
   },
   {
    "ref": "BV 22",
    "name": "Reset Alarms",
    "why": "Write 1 to reset latched alarms"
   },
   {
    "ref": "AI 1",
    "name": "Pressure",
    "why": "Room differential pressure, inWC by default"
   },
   {
    "ref": "MV 16",
    "name": "Binary Input Status",
    "why": "Door/switch input status (Door Open/Closed)"
   },
   {
    "ref": "BV 16",
    "name": "Relay Status",
    "why": "Alarm relay state"
   },
   {
    "ref": "MV 3",
    "name": "Pressure Alarm Status",
    "why": "Pressure alarm: 1 OK, 2 Warning, 3 Alarm"
   }
  ],
  "enable": "BV 1 Pressure Enable turns monitoring of the built-in sensor on; each universal input and external sensor has its own enable BV.",
  "heartbeat": null,
  "remote_sensors": "Up to three external BACnet analog sensors (ES1-ES3) and three digital points (ED1-ED3) are read by the monitor itself: set the remote device instance and object instance (PIV 12/13 for ES1 and so on), the object type, then enable the sensor. The remote device must answer a directed Who-Is. Values appear in AV 26/32/38 and MSV 58/62/66.",
  "setup": [
   "BACnet MS/TP or Modbus RTU over 2-wire RS485, chosen in the Network menu (Configuration > Network).",
   "Optional 120 ohm termination: jumper terminals 9 and 10.",
   "Default device instance 607127 (vendor ID 607); Max Master default 127.",
   "DeviceCommunicationControl and ReinitializeDevice need the password given in the manual.",
   "Time sync from BACnet must be turned on in Maintenance > Date and time."
  ],
  "gotchas": [
   "No segmentation: the full Object_List cannot be read in one ReadProperty; read it by index.",
   "Changing MV 1 Pressure Unit changes the units of all pressure limits; COV increments are unit-less and may need adjusting.",
   "BV 21 Mute and BV 22 Reset act only on writing 1; writing 0 does nothing.",
   "Most objects are setup values; do not write them cyclically from the BMS."
  ]
 },
