 "integration": {
  "summary": "Command each damper through its relay BO (BO 4, BO 5) and read the end switches, moving flags and MV status per damper. BV 16/17 start a full automatic test and BV 19 clears messages.",
  "minimum_points": [
   {
    "ref": "BO 4",
    "name": "Relay Damper-Damper 1",
    "why": "Damper 1 actuator command (BO 5 for damper 2)"
   },
   {
    "ref": "BV 19",
    "name": "Clear Message- Both Dampers",
    "why": "Clears damper messages"
   },
   {
    "ref": "BV 13",
    "name": "Damper Open-Damper 1",
    "why": "Damper 1 open"
   },
   {
    "ref": "BV 12",
    "name": "Damper Close-Damper 1",
    "why": "Damper 1 closed"
   },
   {
    "ref": "BV 6",
    "name": "ManualOverride_Effective-Damper 1",
    "why": "Local manual override active on damper 1"
   },
   {
    "ref": "MV 1",
    "name": "Status Damper 1",
    "why": "Status; 2 = end position not reached (MV 2 = damper 2)"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Default device instance is 804XXX; it can be changed through AV 11 \"Device Instant\".",
   "Baud rate reads back on MV 0 (9600-76800) and on AV 2 as baud / 10."
  ],
  "gotchas": [
   "Fire-application mode is chosen with DIP switches (read back on BV 2 and BV 3), not over BACnet.",
   "BV 18 restores factory defaults; keep it out of graphics.",
   "MV status states 3 and 4 are printed as not in use."
  ]
 },
