 },
 "integration": {
  "summary": "Use network_UnitEnableCommand (the guide marks it as the point to command the unit on and off) with OFF, ON or AUTO, then set occupancy, HVAC mode and the occupied/unoccupied heat setpoints. If the BMS supplies the space temperature, write network_SpaceTemperatureOverride (255 returns control to the local sensor). Watch fan and burner status and the alarm BVs.",
  "minimum_points": [
   {
    "ref": "MV 11",
    "name": "network_UnitEnableCommand",
    "why": "Unit command: OFF / ON / AUTO"
   },
   {
    "ref": "BV 11",
    "name": "network_OccupancyCommand",
    "why": "0 occupied, 1 unoccupied"
   },
   {
    "ref": "BV 12",
    "name": "network_HVAC_Mode",
    "why": "0 vent, 1 heat"
   },
   {
    "ref": "AV 26",
    "name": "network_OccupiedHeatSetPoint",
    "why": "Occupied heat setpoint, 55-150 °F"
   },
   {
    "ref": "AV 33",
    "name": "network_SpaceTemperatureOverride",
    "why": "Space temp from the BMS; 255 = use local sensor"
   },
   {
    "ref": "BV 1",
    "name": "FanStatus",
    "why": "Fan running status"
   },
   {
    "ref": "BV 23",
    "name": "BurnerStatus",
    "why": "Burner on/off status"
   },
   {
    "ref": "AV 3",
    "name": "DischargeTemperature",
    "why": "Discharge air temperature"
   },
   {
    "ref": "BV 4",
    "name": "BurnerLockoutAlarm",
    "why": "Burner lockout"
   },
   {
    "ref": "BV 8",
    "name": "MotorNotRespondingAlarm",
    "why": "Fan motor did not start"
   }
  ],
  "enable": "network_UnitEnableCommand (MV 11): OFF / ON / AUTO. The guide marks it as the point to command the unit on and off; AUTO cycles the unit per BV 14 and BV 15.",
  "heartbeat": null,
  "remote_sensors": "network_SpaceTemperatureOverride (AV 33) replaces the local space sensor with an averaged or network temperature; write 255 to go back to the local sensor. AV 6 shows the value in use.",
  "setup": [
   "The MS/TP MAC address is set on the controller's DIP switches (switch 1 = least significant bit).",
   "Baud rate is detected automatically after a power cycle.",
   "Device instance = 3640 followed by the MAC address (MAC 25 gives 364025)."
  ],
  "gotchas": [
   "Do not write the hardware I/O or factory configuration objects; the override alarm BVs trip when a hardware output is overridden from the network.",
   "LowDischargeTempAlarm is reset by commanding the unit off and then on.",
   "Burner reset works on a change of state of BV 24."
  ]
 },
