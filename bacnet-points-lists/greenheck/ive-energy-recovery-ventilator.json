 "integration": {
  "summary": "With BACnet licensed and the network set at the controller, the minimum integration is to enable the unit (BV-2) and command occupancy (BV-3). Add alarm reset and global alarm monitoring, plus the temperature setpoint if needed. If the BMS will also drive fan speeds or send sensor values, it must keep writing the BMS watchdog, or the unit alarms and returns to local control.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "System_Enable",
    "why": "Enables or disables the unit"
   },
   {
    "ref": "BV 3",
    "name": "BMS_Occupancy_Command",
    "why": "Occupancy; Active = Unoccupied, Inactive = Occupied"
   },
   {
    "ref": "AV 1",
    "name": "Temperature_Setpoint",
    "why": "Occupied temperature setpoint"
   },
   {
    "ref": "BV 1",
    "name": "BMS_Watchdog",
    "why": "Heartbeat when BMS controls fans or sensors"
   },
   {
    "ref": "BV 4",
    "name": "Reset_All_Alarms",
    "why": "Remote alarm reset"
   },
   {
    "ref": "AV 40",
    "name": "Unit_Status_Mode",
    "why": "Current operating mode code"
   },
   {
    "ref": "AI 2",
    "name": "Supply_Temp_Analog_Input",
    "why": "Supply (discharge) air temperature"
   },
   {
    "ref": "BV 23",
    "name": "Global_Alarm",
    "why": "Any active alarm"
   },
