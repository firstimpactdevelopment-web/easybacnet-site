 "integration": {
  "summary": "With BACnet licensed and the protocol set in Network Settings, enable the unit with BV 2 and command occupancy with BV 3, write the temperature setpoint AV 1 and reset alarms with BV 4. If the BMS sends sensor values or controls fans or the damper, keep the BV 1 watchdog toggling. Monitor Unit_Status_Mode, supply temperature, Global_Alarm and LatestAlm.",
  "minimum_points": [
   {
    "ref": "BV 2",
    "name": "System_Enable",
    "why": "Enables or disables the unit"
   },
   {
    "ref": "BV 3",
    "name": "BMS_Occupancy_Command",
    "why": "Occupancy; Active = Unoccupied, Inactive = Occupied"
   },
   {
    "ref": "AV 1",
    "name": "Temperature_Setpoint",
    "why": "Occupied temperature setpoint"
   },
   {
    "ref": "BV 1",
    "name": "BMS_Watchdog",
    "why": "Heartbeat when BMS controls fans or sensors"
   },
   {
    "ref": "BV 4",
    "name": "Reset_All_Alarms",
    "why": "Remote alarm reset"
   },
   {
    "ref": "AV 40",
    "name": "Unit_Status_Mode",
    "why": "Current operating mode code"
   },
   {
    "ref": "AI 2",
    "name": "Supply_Temp_Analog_Input",
    "why": "Supply (discharge) air temperature"
   },
   {
    "ref": "BV 23",
    "name": "Global_Alarm",
    "why": "Any active alarm"
   },
   {
    "ref": "IV 5",
    "name": "LatestAlm",
    "why": "Most recent alarm code"
   }
  ],
  "enable": "BV 2 System_Enable enables or disables the unit; BV 3 BMS_Occupancy_Command sets occupancy (Active = Unoccupied).",
  "heartbeat": "BV 1 BMS_Watchdog must be toggled by the BMS within the timeout delay whenever the BMS replaces a hardwired sensor (or takes over fan speed or damper control). If the timer expires, the controller alarms (BMS Offline) and falls back to its hardwired sensors and local control until the BMS returns. The watchdog status is shown on a read-only BV.",
  "remote_sensors": "Set the matching source-select BV to BMS, then write the *_from_BMS analog value (e.g. AV 27 outside temperature, AV 35 space temperature). Supply fan, exhaust fan and outdoor air damper are taken over the same way with their control-source BVs. The watchdog must be kept alive.",
  "setup": [
   "BMS protocol (BACnet MS/TP, BACnet IP, Modbus RTU or Modbus TCP) and its settings are in the Network Settings menu; the service password 9998 is needed to change them.",
   "After changing BACnet MS/TP or IP settings, enable 'Save Settings' and reboot the controller (cycle power or hold the main menu button 3 seconds).",
   "BACnet must be licensed on the controller; alarm 82 'BACnet License - Not Installed' means it is not."
  ],
  "gotchas": [
   "Points marked with an asterisk in the manual form a 'BACnet Short List'; the full list is larger.",
   "Status and alarm words (IV and paired AV objects) are bit-packed; decode them with the bit tables in the manual.",
   "Remote sensor values are only used while their source-select BV is set to BMS and the watchdog is alive."
  ]
 },
