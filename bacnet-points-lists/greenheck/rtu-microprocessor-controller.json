 ],
 "equipment_type": "Rooftop unit (RTU) controller",
 "applies_to": "Greenheck (and Valent) packaged rooftop units with the factory microprocessor controller, RTU program v1.4.",
 "summary": "The RTU microprocessor controller (program v1.4) offers BACnet MS/TP, BACnet IP, Modbus RTU and Modbus TCP. The BMS can enable the unit, command occupancy, reset alarms, write temperature, dehumidification, economizer, airflow and static pressure setpoints, take over fans and the outdoor air damper, and replace hardwired sensors with BMS values while a watchdog is kept alive. Read-only objects cover temperatures, humidity, pressures, refrigerant circuit values, outputs, unit status mode, latest alarm and bit-packed status and alarm words.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": "RTU v1.4",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Valent publishes the same guide as document 487426; its points list is identical (167 objects).",
  "The DOAS controller (Valent document 485937) shares most of this list but differs in about 20 objects.",
  "Appendix E prints a Modbus register beside each BACnet object; only the BACnet side is listed here.",
  "Status and alarm words are 32-bit, published as an IV plus two AVs; the bit tables are in the manual.",
  "Source: Appendix E Points List, manual pages 40-46 (167 objects)."
 ],
