 "applies_to": "KMC BAC-7001, BAC-7003, BAC-7051 and BAC-7053 VAV controllers with the factory VAV applications version 2.2 (pressure independent or dependent, with reheat).",
 "summary": "The BAC-7000 series are BACnet MS/TP VAV controllers with a built-in damper actuator and airflow sensor. The factory Control Basic programs run single-duct pressure independent or dependent VAV with modulating or staged reheat. The BMS mostly reads room temperature, airflow and damper position, and writes the occupancy command, setpoints and airflow limits.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Applications version 2.2",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The guide has no read/write column; access is inferred: values marked (auto) or written by the programs are read-only, setpoints, limits and commands writable.",
  "Instances listed as --available-- are unused and left out (AV10, AV14, AV15, AV33-AV35, BV6, BV7).",
  "Program objects 1-4 (SINGLEVAV, SINGLEPRESS, REHEAT, CALIB_UTIL) run the application and are not listed.",
  "The output table prints AO4 with the name 'Damper Motor Drive', description 'MOTOR' and type 'Volts 0-10'; kept as printed.",
  "When a NetSensor is connected its temperature and setpoint go to AV1 / AV2; otherwise AI1 / AI2 are copied there."
 ],
