{
 "manufacturer": "CoolAutomation",
 "manufacturer_slug": "coolautomation",
 "model": "CoolMasterNet Gree GMV5 mini outdoor unit (PRO) objects",
 "model_slug": "coolmasternet-gree-gmv5-mini-outdoor",
 "aliases": [
  "Gree GMV5 mini BACnet",
  "CoolMasterNet Gree",
  "GMV5 mini"
 ],
 "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
 "applies_to": "Gree GMV5 mini VRF outdoor units read through a CoolAutomation gateway with PRO functionality.",
 "summary": "With PRO functionality, CoolAutomation gateways publish service data from Gree GMV5 mini outdoor units over BACnet: rated capacity, protocol versions, outdoor temperature, compressor and fan frequencies, module high and low pressure, discharge, defrost, subcooler and separator temperatures, EXV positions, compressor and valve states and drive currents, voltages and module temperatures, plus compressor drive status, target frequencies and absolute pressures in kPa (48 objects). Monitoring only.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 64,
 "access_inferred": true,
 "notes": [
  "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
  "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
  "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
  "The guide prints Module high/low pressure with a [°C] unit; they are listed as printed.",
  "The VRF Home(S) table in the same guide is almost the same but differs from index 21 on, so it is not covered by this list.",
  "State meanings for coded values (mode, status and similar) are in the guide's PRO Enumerated Parameters tables for this brand and are not repeated here.",
  "The guide lists no error-code object for Gree outdoor units."
 ],
 "source": {
  "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
  "doc_number": null,
  "revision_date": "Rev 1.0.4, 2026-07-06",
  "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
 },
 "integration": {
  "summary": "Use these objects to monitor Gree outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend compressor, pressure and temperature data.",
  "minimum_points": [
   {
    "ref": "BI 272",
    "name": "Comp1",
    "why": "Compressor 1 running"
   },
   {
    "ref": "PIV 262",
    "name": "Comp1OpFreq",
    "why": "Compressor 1 frequency, Hz"
   },
   {
    "ref": "IV 261",
    "name": "AmbT",
    "why": "Outdoor temperature, °C"
   },
   {
    "ref": "IV 263",
    "name": "MdlHiPrs",
    "why": "Module high pressure value"
   },
   {
    "ref": "IV 264",
    "name": "MdlLoPrs",
    "why": "Module low pressure value"
   },
   {
    "ref": "IV 265",
    "name": "Comp1DisT",
    "why": "Compressor 1 discharge temperature, °C"
   },
   {
    "ref": "AI 282",
    "name": "Comp1Cur",
    "why": "Compressor 1 current, A"
   }
  ],
  "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
   "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
   "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
  ],
  "gotchas": [
   "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
  ]
 },
 "covers_brands": [
  "Gree"
 ],
