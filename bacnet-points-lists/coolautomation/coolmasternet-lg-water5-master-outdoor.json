 "model": "CoolMasterNet LG WATER5 master outdoor unit (PRO) objects",
 "model_slug": "coolmasternet-lg-water5-master-outdoor",
 "aliases": [
  "LG Multi V Water 5 BACnet",
  "LG WATER5 BACnet",
  "CoolMasterNet LG",
