{
 "manufacturer": "CoolAutomation",
 "manufacturer_slug": "coolautomation",
 "model": "CoolMasterNet Mitsubishi Electric CAHV heat pump (PRO) objects",
 "model_slug": "coolmasternet-mitsubishi-cahv",
 "aliases": [
  "Mitsubishi CAHV BACnet",
  "CoolMasterNet Mitsubishi Electric",
  "CAHV"
 ],
 "equipment_type": "Air-to-water heat pump monitoring via BACnet gateway",
 "applies_to": "Mitsubishi Electric CAHV units read through a CoolAutomation gateway with PRO functionality.",
 "summary": "With PRO functionality, CoolAutomation gateways publish service data from Mitsubishi Electric CAHV units over BACnet: type, on/off level, setting and control, water temperature control flags, fan mode, hot water, mode, eco and anti-freeze flags, defrost mode, demand, CN142 connector states, thermistors TH1-TH16, HP1/LP1, currents, bus voltage, Ts/Twi/Two/Twg/Tout temperatures, LEV positions, compressor frequencies, X01-X72 and CN52 states, low-noise and demand limits, last error code and total hours (84 objects). Monitoring only.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 64,
 "access_inferred": true,
 "notes": [
  "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how these PRO blocks receive their VA (it only covers indoor units).",
  "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
  "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
  "Table printed on page 126 of the guide (section 3.2.6.1).",
  "The guide prints this table in the ME PRO Indoor Units section, though its first object is called Outdoor Unit Type Name.",
  "OnOffCtrl, WtrTCtrl, FnMdSt and Md values are explained in the guide's ME PRO Enumerated Parameters tables and are not repeated here.",
  "HP1 and LP1 are printed without units; many thermistor and relay objects have no description beyond their names.",
  "The guide also prints a separate 23-object table (Type plus thermistors TH1-TH16 and THc10-THc15) under 'CAHV-P [capacity] YA/YB-HPB' in its outdoor-unit section (page 274); it is not covered here."
 ],
 "source": {
  "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
  "doc_number": null,
  "revision_date": "Rev 1.0.4, 2026-07-06",
  "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
 },
 "integration": {
  "summary": "Use these objects to monitor Mitsubishi Electric CAHV equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the block's VA and trend mode, compressor frequencies, temperatures and the last error code.",
  "minimum_points": [
   {
    "ref": "BI 258",
    "name": "OnOffSet",
    "why": "On/off setting"
   },
   {
    "ref": "PIV 266",
    "name": "Md",
    "why": "Mode code"
   },
   {
    "ref": "PIV 271",
    "name": "DfrMd",
    "why": "Defrost mode code"
   },
   {
    "ref": "PIV 318",
    "name": "COMP1",
    "why": "Compressor 1 frequency, Hz"
   },
   {
    "ref": "PIV 319",
    "name": "COMP2",
    "why": "Compressor 2 frequency, Hz"
   },
   {
    "ref": "PIV 339",
    "name": "TotHr",
    "why": "Total operating hours"
   },
   {
    "ref": "PIV 338",
    "name": "Err",
    "why": "Last error code"
   }
  ],
  "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
   "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
   "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
  ],
  "gotchas": [
   "The guide does not document how VAs are assigned to these units; confirm instances with a BACnet discovery."
  ]
 },
 "covers_brands": [
  "Mitsubishi Electric"
 ],
