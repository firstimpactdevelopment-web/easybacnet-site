 },
 "integration": {
  "summary": "Use these objects to monitor Daikin outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the block's VA and trend operating states, temperatures, compressor data and the error state.",
  "minimum_points": [
   {
    "ref": "BI 264",
    "name": "Comp1Inv",
    "why": "Inverter compressor running"
   },
   {
    "ref": "BI 286",
    "name": "Pump",
    "why": "Pump output (Y2M)"
   },
   {
    "ref": "PIV 294",
    "name": "InvRS",
    "why": "Inverter speed, rps"
   },
   {
    "ref": "IV 291",
    "name": "EvT",
    "why": "Evaporating temperature, °C"
   },
   {
    "ref": "IV 292",
    "name": "CndT",
    "why": "Condensing temperature, °C"
   },
   {
    "ref": "PIV 261",
    "name": "DschTInv",
    "why": "Inverter discharge temperature, °C"
   },
   {
    "ref": "PIV 263",
    "name": "InvCur",
    "why": "Inverter current, A"
   },
   {
    "ref": "BI 270",
    "name": "ErrState",
    "why": "Unit error state"
   }
  ],
  "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
   "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
   "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
  ],
  "gotchas": [
   "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
  ]
 },
