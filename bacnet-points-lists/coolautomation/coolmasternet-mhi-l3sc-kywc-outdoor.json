 ],
 "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
 "applies_to": "Mitsubishi Heavy Industries single-compressor VRF outdoor units of the series CoolAutomation calls L3SC and KYWC, read through a CoolAutomation gateway with PRO functionality.",
 "summary": "With PRO functionality, CoolAutomation gateways publish service data from Mitsubishi Heavy Industries outdoor units of the L3SC and KYWC series over BACnet: outdoor, heat exchanger, discharge, under-dome and suction temperatures, compressor currents, high and low pressure, operation mode, inverter speed, fan speeds, EEV positions, oil return data, relay and solenoid valve states and calculated superheats (47 objects). Monitoring only.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 64,
 "access_inferred": true,
 "notes": [
  "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
  "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
  "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
  "The guide names the series only by these codes (as grouped by CoolAutomation) and does not map them to MHI model numbers; read the Type object (CSV 256) to confirm which series a unit is.",
  "The guide has no PRO Enumerated Parameters table for Mitsubishi Heavy outdoor units, so Operation Mode codes are not explained.",
  "The guide prints identical tables for L3SC and KYWC; this list covers both."
 ],
 "source": {
  "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
  "doc_number": null,
  "revision_date": "Rev 1.0.4, 2026-07-06",
  "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
 },
 "integration": {
  "summary": "Use these objects to monitor Mitsubishi Heavy Industries outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend pressures, compressor speed and discharge temperature (this series has no error output object).",
  "minimum_points": [
   {
    "ref": "PIV 270",
    "name": "OpeMode",
    "why": "Operation mode code"
   },
   {
    "ref": "BI 282",
    "name": "52C1",
    "why": "Compressor 1 contactor (running)"
   },
   {
    "ref": "PIV 271",
    "name": "Inv1Hz",
    "why": "Inverter compressor speed, Hz"
   },
   {
    "ref": "AI 257",
    "name": "ThoA",
    "why": "Outdoor air temperature, °C"
   },
   {
    "ref": "AI 268",
    "name": "HP",
    "why": "High pressure, MPa"
   },
   {
    "ref": "AI 269",
    "name": "LP",
    "why": "Low pressure, MPa"
   },
   {
    "ref": "AI 260",
    "name": "ThoD1",
    "why": "Discharge temperature, °C"
   }
  ],
  "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
   "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
   "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
  ],
  "gotchas": [
   "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
  ]
 },
 "covers_brands": [
  "Mitsubishi Heavy Industries"
 ],
