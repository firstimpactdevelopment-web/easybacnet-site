{
 "manufacturer": "CoolAutomation",
 "manufacturer_slug": "coolautomation",
 "model": "CoolMasterNet LG Multi V III master outdoor unit (PRO) objects",
 "model_slug": "coolmasternet-lg-multiv-iii-master-outdoor",
 "aliases": [
  "LG Multi V III BACnet",
  "CoolMasterNet LG",
  "MultiV III Master",
  "LGMV"
 ],
 "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
 "applies_to": "LG Multi V III VRF outdoor units (master unit) read through a CoolAutomation gateway with PRO functionality (LGMV section of the guide).",
 "summary": "With PRO functionality, CoolAutomation gateways publish service data from LG Multi V III master outdoor units over BACnet: type, operation mode, error code, target and current high and low pressure, compression ratio, superheat and subcooling, compressor and fan speeds, EEV positions, refrigerant and outdoor temperatures, inverter currents, voltages and IPM temperatures, and valve and compressor states, plus constant-speed compressor and oil supply temperatures (68 objects). Monitoring only.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 64,
 "access_inferred": true,
 "notes": [
  "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
  "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
  "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
  "Listed in the guide's LGMV section.",
  "A separate MultiV III Slave table (62 objects) covers slave outdoor units.",
  "State meanings for coded values (mode, status and similar) are in the guide's PRO Enumerated Parameters tables for this brand and are not repeated here."
 ],
 "source": {
  "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
  "doc_number": null,
  "revision_date": "Rev 1.0.4, 2026-07-06",
  "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
 },
 "integration": {
  "summary": "Use these objects to monitor LG outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the master outdoor unit's VA and trend pressures, compressor speed and error code.",
  "minimum_points": [
   {
    "ref": "CSV 257",
    "name": "Mode",
    "why": "Operation mode text"
   },
   {
    "ref": "PIV 271",
    "name": "InvTrcFrq",
    "why": "Inverter compressor frequency, Hz"
   },
   {
    "ref": "AI 280",
    "name": "AirT",
    "why": "Outdoor air temperature, °C"
   },
   {
    "ref": "PIV 263",
    "name": "HiPrsTrc",
    "why": "High pressure, kPa"
   },
   {
    "ref": "PIV 264",
    "name": "LoPrsTrc",
    "why": "Low pressure, kPa"
   },
   {
    "ref": "AI 284",
    "name": "InvDisT",
    "why": "Inverter compressor discharge temp, °C"
   },
   {
    "ref": "PIV 258",
    "name": "Err",
    "why": "Error code"
   }
  ],
  "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
   "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
   "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
  ],
  "gotchas": [
   "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
  ]
 },
 "covers_brands": [
  "LG"
 ],
