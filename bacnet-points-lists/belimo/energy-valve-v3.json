 },
 "integration": {
  "summary": "Set MV 122 SpSource to Bus, pick the control mode in MV 100 (flow control by default) and the flow or power limits, then command AO 1 SpRel. Read flow, temperatures, delta T, power and energy, and watch BI 101 SummaryStatus and AI 100 ErrorState for faults.",
  "minimum_points": [
   {
    "ref": "AO 1",
    "name": "SpRel",
    "why": "Setpoint: position, flow or power per control mode"
   },
   {
    "ref": "MV 122",
    "name": "SpSource",
    "why": "Must be Bus for AO 1 to take effect"
   },
   {
    "ref": "MV 100",
    "name": "ControlMode",
    "why": "Position, flow or power control"
   },
   {
    "ref": "AI 11",
    "name": "AbsFlow_lmin",
    "why": "Measured flow, l/min"
   },
   {
    "ref": "AI 22",
    "name": "DeltaT_K",
    "why": "Coil delta T, K"
   },
   {
    "ref": "AI 30",
    "name": "AbsPower_kW",
    "why": "Thermal power, kW"
   },
   {
    "ref": "AI 31",
    "name": "E_Cooling_kWh",
    "why": "Cooling energy meter, kWh"
   },
   {
    "ref": "AI 32",
    "name": "E_Heating_kWh",
    "why": "Heating energy meter, kWh"
   },
   {
    "ref": "BI 101",
    "name": "SummaryStatus",
    "why": "Overall OK / not OK"
   },
   {
    "ref": "AI 100",
    "name": "ErrorState",
    "why": "Bit-coded error flags"
   }
  ],
  "enable": "Write MV 122 SpSource = 2 (Bus); the default Analog (1) follows the 0-10 V signal on wire 3. MO 1 Override can force close, open, nominal or max flow/power or motor stop and falls back to None after 2 hours.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Default device instance 1 (writable, 0-4194302).",
   "MS/TP: baud 9600-76800, default 38400; address 0-127, default 1; max 32 nodes without repeater; 120 ohm terminator.",
   "BACnet IP: UDP port 47808 by default; foreign device registration supported.",
   "Configure through the valve's built-in web server."
  ],
  "gotchas": [
   "Writable objects with instance 90 or above are stored persistently and should not be written cyclically.",
   "While air bubbles are detected the valve runs in position control regardless of MV 100.",
   "Max 5 active COV subscriptions, lifetime up to 12 hours."
  ]
 },
