 "equipment_type": "VAV box controller (compact, built-in damper drive)",
 "applies_to": "SAUTER ASV305BF7xxxW compact VAV controllers (damper actuator with built-in pressure sensor), optionally with EY-RU305F700xW room units.",
 "summary": "The SAUTER ASV3 is a compact VAV controller: damper actuator, differential pressure sensor and airflow/temperature control in one unit, with BACnet MS/TP. Its object list exposes the hardware I/O, airflow and temperature setpoints and limits, PID tuning, room-unit (HMI) display settings, occupancy and cool/heat mode, plus many internal calculation objects.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "From section 8, BACnet Objects List, tables 1-3 (manual pages 30-45).",
  "Objects printed as \"Not use\" (18 objects) are left out. Objects marked \"Internal Use\" or \"Arithmetic Operation\" are kept but are not meant for BMS use.",
  "Access follows the Read/Write column; rows with \"-\" or no entry are listed as read-only.",
  "AV 47 and AV 90 print \"0\" in the unit column; it is left blank here. Several names are placeholders (AV-103, BV-35) with the meaning in the description.",
  "The note under table 2: AV present values map to Modbus holding registers 40001-40500 as 10x integers; defaults in brackets are fixed and only change in DDC programming."
 ],
 "source": {
  "title": "Manual SAUTER ASV3",
  "doc_number": null,
  "revision_date": null,
  "url": "https://www.sauter-controls.com/wp-content/uploads/2021/08/Manual-SAUTER-ASV3.pdf"
 },
 "integration": {
  "summary": "Command occupancy (BV 1) and cool/heat mode (BV 2), set the cooling and heating setpoints (AV 33, AV 37) or the airflow limits, and read the current airflow, damper position and room temperature. Damper and airflow overrides (BV 5 with AV 6, BV 6 with AV 12) are available for balancing.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "VAV box Occupied/ unoccupied",
    "why": "Occupied/unoccupied: 1 = occupied"
   },
   {
    "ref": "BV 2",
    "name": "Cool/Heat mode",
    "why": "0 = cooling, 1 = heating"
   },
   {
    "ref": "AV 33",
    "name": "Cooling setpoint",
    "why": "Room cooling setpoint"
   },
   {
    "ref": "AV 37",
    "name": "Heating set point",
    "why": "Room heating setpoint"
   },
   {
    "ref": "AV 4",
    "name": "Current VAV airflow",
    "why": "Measured VAV airflow"
   },
   {
    "ref": "AV 5",
    "name": "VAV demand airflow",
    "why": "Airflow demand"
   },
   {
    "ref": "AV 61",
    "name": "Current VAV position feedback (0- 100)",
    "why": "Damper position feedback, 0-100 %"
   },
   {
    "ref": "AV 23",
    "name": "HMI Temperature sensor",
    "why": "Room temperature from the HMI room unit"
   },
   {
    "ref": "BV 10",
    "name": "No Airflow in main duct",
    "why": "Duct airflow alarm, 1 = no airflow"
   }
  ],
  "enable": "Occupancy is BV 1 (VAV box Occupied/unoccupied); Cool/Heat mode is BV 2. Overrides: Override airflow control (BV 5) with Forced airflow control (AV 6), Damper override (BV 6) with AV 12.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP: MAC address on DIP switch SW8 (switches 1-7, binary); baud on SW4 S1/S2: 9600 (off/off), 19200 (on/off), 38400 (off/on), 76800 (on/on).",
   "SW4 S3 is the MS/TP end-of-line terminating resistor (factory off).",
   "Device instance is set from the BMS, the PC tool or an EY-RU305F700xW room unit; AV 0 shows it (default 1000, the PC tool value must be divided by 10).",
   "Sauter suggests no more than 22 controllers per MS/TP segment."
  ],
  "gotchas": [
   "Many objects, mostly from AV 57 and BV 46 upward, are marked Internal use or Arithmetic Operation (calculation buffers); do not write them.",
   "Airflow units follow Airflow display unit select (AV 29).",
   "Cooling and heating airflow limits (AV 7-10) and setpoint limits are stored settings; do not write them cyclically."
  ]
 },
