 },
 "integration": {
  "summary": "Set Ctrl Sig (BV 0) to digital so the bus owns the setpoint, then write the heating or cooling setpoint Y1h/Y1c (0-10) and read flow, climate status, the warning bitfield and energy. With Ctrl Sig analog the valve follows its 0-10 V Y1 input and Y1h/Y1c are read-only.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "Ctrl Sig",
    "why": "Must be digital (1) for bus setpoints"
   },
   {
    "ref": "AV 0",
    "name": "Y1h",
    "why": "Heating setpoint, 0-10"
   },
   {
    "ref": "AV 1",
    "name": "Y1c",
    "why": "Cooling setpoint, 0-10"
   },
   {
    "ref": "MV 1",
    "name": "ClimStatus",
    "why": "Climate status: heating, cooling, error, check flow"
   },
   {
    "ref": "AI 0",
    "name": "Vam",
    "why": "Measured flow"
   },
   {
    "ref": "AV 20",
    "name": "XM",
    "why": "Valve motor position, 0-10"
   },
   {
    "ref": "AV 10",
    "name": "EnerHeat",
    "why": "Heating energy"
   },
   {
    "ref": "AV 11",
    "name": "EnerCool",
    "why": "Cooling energy"
   },
   {
    "ref": "AI 8",
    "name": "Warning",
    "why": "Warning bits: sensor, negative flow, manual"
   },
   {
    "ref": "AI 9",
    "name": "Error",
    "why": "Error code"
   }
  ],
  "enable": "Ctrl Sig (BV 0) selects the setpoint source: analog (the Y1 0-10 V input) or digital (Y1h/Y1c written over the bus). Changing it resets the control loop.",
  "heartbeat": null,
  "remote_sensors": "Room temperature (AV 12 Troom) and setpoint adjustment (AV 13 Tsetadj) are writable for the room control function; external sensors on Text1/Text2 are configured with MV 9/10.",
  "setup": [
   "BACnet MS/TP, 9600, 19200 or 38400 baud; the PICS lists both master and slave operation.",
   "Segmentation is not supported."
  ],
  "gotchas": [
   "Writing the flow setpoints Vsh/Vsc (AV 2/3) directly is meant for troubleshooting only; the handbook warns cyclic writes shorten the internal memory life. Use Y1h/Y1c.",
   "Y1h and Y1c are read-only while Ctrl Sig is analog.",
   "Some objects only exist on certain product types."
  ]
 },
