  "TE Connectivity Integra"
 ],
 "equipment_type": "Power meter (multifunction)",
 "applies_to": "Crompton (TE Connectivity) Integra 1221 and 1222 DIN-rail multifunction meters fitted with the plug-on BACnet MS/TP option module.",
 "summary": "The Integra 1221/1222 is a multifunction electricity meter; a plug-on option module adds BACnet MS/TP. All measurements are read-only Analog Inputs (175 objects: per-phase and system voltage, current, power, VA, VAr, power factor, energy, demand, THD, min/max values and vector angles), and 17 Analog Values hold the meter settings such as demand period, CT and VT ratios and baud rate.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Application software 001.000.016 (PICS dated June 12th 2012)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "In the printed Analog Value table the description column is out of step with the names: the texts for AV 6-10 sit one row low and AV 13's reset text sits on the AV 6 row. The descriptions and access here are paired by content (e.g. the serial-number text goes with Hi Serial, the reset text with Reset Parameter).",
  "AI 32-34 (VAr hours and VA hours) use units the PICS marks as not ASHRAE-defined (enumerations 0xF2 / 0xEF; VA hours is proprietary 257).",
  "AI 110 HRun and AI 111 PFTot are printed with units 'percent'.",
  "AI 159-162 repeat the names VTHDAvg / ATHDAvg for the maximum and minimum values, as printed.",
  "Some Analog Values are protected: write the password to AV 7 first."
 ],
 "source": {
  "title": "Integra INT-1221/1222 BACnet MSTP Communication, Setup and Operation Guide",
  "doc_number": "3L57501 Rev.03",
  "revision_date": null,
  "url": "https://colterlec.com.au/wp-content/uploads/2023/08/3L57501-INT-12xx-BACnet-MSTP-Operating-Manual-_Colterlec.pdf",
  "unofficial": true,
  "host": "Colterlec"
 },
 "integration": {
  "summary": "Set the MS/TP MAC address (1-127) and identity mode on the meter's Comms menu, then read the AI objects. Nothing has to be written for monitoring; settings live in the AV objects.",
  "minimum_points": [
   {
    "ref": "AI 24",
    "name": "PSum",
    "why": "Total active power (sum of phases), W"
   },
   {
    "ref": "AI 30",
    "name": "ImpWh",
    "why": "Import energy, Wh"
   },
   {
    "ref": "AI 35",
    "name": "PSumDmd",
    "why": "Import power demand, W"
   },
   {
    "ref": "AI 21",
    "name": "VLNAvg",
    "why": "Average line-to-neutral voltage"
   },
   {
    "ref": "AI 22",
    "name": "AAvg",
    "why": "Average line current"
   },
   {
    "ref": "AI 27",
    "name": "PFTot",
    "why": "Total system power factor"
   },
   {
    "ref": "AI 29",
    "name": "Frq",
    "why": "Frequency, Hz"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MS/TP, default 38400 baud, no parity, 1 stop bit; MAC address 1-127, default 001.",
   "The Identity setting picks whether the device instance is the MAC address or a 22-bit instance number.",
   "Baud can also be changed through AV 16; power-cycle the meter to apply."
  ],
  "gotchas": [
   "With the BACnet module fitted no other external protocol is available.",
   "Writing 0 to AV 13 resets the energy readings."
  ]
 },
