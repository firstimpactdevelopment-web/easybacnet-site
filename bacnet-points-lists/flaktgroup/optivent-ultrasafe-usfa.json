    "why": "Unit state (normal, damper test, fault, interlock)"
   },
   {
    "ref": "AI 11",
    "name": "Damper position",
    "why": "Damper position, %"
   },
   {
    "ref": "AI 23",
    "name": "Volume flow relative",
    "why": "Relative airflow, %"
   },
   {
    "ref": "MI 2",
    "name": "Smoke detector state",
    "why": "Smoke detector state incl. fire alarm"
   },
   {
    "ref": "BI 4",
    "name": "Damper failure",
    "why": "Damper failure"
   },
   {
    "ref": "BI 1",
    "name": "Service alarm",
    "why": "Service alarm active"
   }
  ],
  "remote_sensors": "BV 8 Air flow setpoint source selects Analog (analog input 1) or Bus; on Bus the BMS writes AV 2 Volume flow setpoint.",
  "gotchas": [
   "BV 3 External Alarm and BV 4 External Interlock act on the damper; map them only if the BMS is meant to drive fire/interlock functions."
  ],
