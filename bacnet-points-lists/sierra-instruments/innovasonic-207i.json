  "setup": [
   "Set the MS/TP baud (9600, 19200 or 38400) and MAC address (1-127) with the 207i SIP software or the meter keypad.",
   "The BACnet module normally sits in slot 12 of the terminal board; RS-485 terminals are A-, B+ and C (isolated ground).",
   "Give every meter a unique MAC address and device instance."
  ],
  "gotchas": [
   "After writing 1, 2 or 3 to AV-1 to reset totals, write 0 again or the totals keep resetting.",
   "Duplicate MAC addresses can lock up the whole MS/TP bus."
  ]
