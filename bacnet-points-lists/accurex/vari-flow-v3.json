{
 "manufacturer": "Accurex",
 "manufacturer_slug": "accurex",
 "model": "Vari-Flow Air Management System v3.00",
 "model_slug": "vari-flow-v3",
 "aliases": [
  "Vari-Flow",
  "Vari-Flow 3.00",
  "Accurex demand-controlled kitchen ventilation"
 ],
 "equipment_type": "Kitchen hood demand-controlled ventilation controls",
 "applies_to": "Accurex Vari-Flow demand-controlled kitchen ventilation systems (hood temperature/optic sensing, exhaust and supply fan VFDs) with a Carel-based controller.",
 "summary": "Vari-Flow is Accurex's demand-controlled kitchen ventilation controller. It modulates exhaust and supply fans from hood temperatures and can talk BACnet MS/TP or BACnet IP through a communication card. The v3.00 points list covers hood control temperatures, fan speeds and status, temperature settings, hood system on/off commands, remote enable, wash and alarm flags.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": "Vari-Flow v3.00",
 "default_device_instance": 77000,
 "access_inferred": false,
 "notes": [
  "The points list states the mapping: Analog and Integer variables are Analog Value objects, Digital variables are Binary Value objects.",
  "The list has objects for up to 10 hood systems, 10 exhaust fans and 4 supply fans; map only the ones the job has.",
  "Access is from the points list's R / R/W column.",
  "Vari-Flow v1.02 and v2.00 controllers use different object lists; check the program version on the controller."
 ],
 "source": {
  "title": "Vari-Flow Air Management System - Installation, Operation and Maintenance Manual, BMS Points List (v3.00)",
  "doc_number": "484565 Rev. 4",
  "revision_date": "2020-06",
  "url": "https://content.accurex.com/accurex-cms-prod/docs/default-source/ioms/document-484565-vari-flow-air-management-system-version-3-0.pdf?sfvrsn=bc5dfb9a_10"
 },
 "integration": {
  "summary": "Enable the system with BV 102 Remote Enable and switch hood systems with BV 11-20. Read hood control temperatures (AV 11-20), fan speeds (AV 1011 up) and fan status BVs, and watch BV 10 Global Alarm and BV 101 fire status.",
  "minimum_points": [
   {
    "ref": "BV 102",
    "why": "Remote enable of the system (1 = on)",
    "name": "Rem_En"
   },
   {
    "ref": "BV 11",
    "why": "Hood system 1 on/off (1 = on)",
    "name": "Sys1_On_Off"
   },
   {
    "ref": "AV 11",
    "why": "Hood 1 control temperature",
    "name": "H1_Ctemp"
   },
   {
    "ref": "AV 1011",
    "why": "Exhaust fan 1 speed, %",
    "name": "Ef1_Speed"
   },
   {
    "ref": "BV 171",
    "why": "Exhaust fan 1 running",
    "name": "Ef1_Status"
   },
   {
    "ref": "BV 181",
    "why": "Supply fan 1 running",
    "name": "Sf1_Status"
   },
   {
    "ref": "BV 101",
    "why": "Fire system active",
    "name": "Fire_Alm"
   },
   {
    "ref": "BV 10",
    "why": "Any active alarm",
    "name": "GLOBAL_ALARM"
   }
  ],
  "enable": "BV 102 Remote Enable (1 = on) and the per-system On/Off BVs (BV 11-20) let the BMS run the hood systems.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP or BACnet IP needs the matching communication card in the controller serial card port, with BACnet Plugin set to YES.",
   "Default device instance is 77000; MS/TP MAC, baud and IP settings are adjusted from the controller display (BACnet IP cards ship in DHCP mode)."
  ],
  "gotchas": [
   "Network settings changed on the display only take effect after a Write on the BACnet Read/Write screen and a power cycle."
  ]
 },
