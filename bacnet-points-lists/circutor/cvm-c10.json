  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Default MAC 2. Default baud: 9600 (CVM-C10, CVM-C11), 19200 (CVM-E3-MINI), 38400 (CVM-B100/B150).",
   "MAC, baud and ID can also be set by writing '#MAC x', '#Baud x' or '#ID x' to the Device object's Object_Name.",
   "CVM-C11 Ethernet model: choose BACnet IP as the Ethernet protocol; default UDP port 47808."
  ],
  "gotchas": [
   "Energy values are three-phase totals; consumed and generated are separate objects.",
   "Voltage objects are named Ph2NU1-3 for all three phases, not Ph1/Ph2/Ph3."
  ]
