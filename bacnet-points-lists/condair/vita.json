{
 "manufacturer": "Condair",
 "manufacturer_slug": "condair",
 "model": "Condair Vita",
 "model_slug": "vita",
 "aliases": [
  "Condair Vita high-pressure",
  "Vita System Master"
 ],
 "equipment_type": "High-pressure nozzle humidification system",
 "applies_to": "Condair Vita high-pressure nozzle humidification systems with up to 50 areas.",
 "summary": "Condair Vita is a high-pressure water atomising system that serves up to 50 humidification areas from one System Master. BACnet on-board reports the reverse osmosis, deionisation and high-pressure stage states, system error category and code, and per-area state, temperature, humidity and a writable per-area humidity setpoint.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 1001,
 "access_inferred": false,
 "notes": [
  "BACnet is built into the Integrated Controller (RJ45 for BACnet IP, RS485 for MS/TP master or slave); it ships with the BACnet protocol set to Off.",
  "Factory Node ID (device instance) is 1001 and the MS/TP MAC is 127; BACnet IP uses UDP 47808 and supports registering with a BBMD.",
  "Per-area objects use instance blocks (e.g. MI 603100-603149, AV 1611600-1611649), one instance per area 1-50; only installed areas are meaningful.",
  "Condair recommends alarming in the BMS only on error category 7 and higher; category 11 (no error) needs software 3.2.0 or later.",
  "Wrong area setpoints or sensor values can cause water damage; the operator is responsible for checking them."
 ],
 "source": {
  "title": "BACnet on-board - Addendum manual for installation and operation (DL II, ME II, RS II, RO-E and Vita)",
  "doc_number": "2603582-F",
  "revision_date": "2026-07",
  "url": "https://www.condair.co.uk/consense/bms-communication-ic-2.0/am_bms_interface_bacnet_on_board_2603582_en.pdf"
 },
 "integration": {
  "summary": "Enable BACnet in the Vita System Master and alarm on error categories 1-7 (1 = most severe) plus the error code. Per-area state, temperature and humidity are read from instance blocks offset by area number, and each area's humidity setpoint can be written.",
  "minimum_points": [
   {
    "ref": "AV 1611600",
    "name": "Area Setpoint 1",
    "why": "Area 1 humidity setpoint"
   },
   {
    "ref": "MI 5035",
    "name": "Pressure Status HP Line",
    "why": "High-pressure stage status"
   },
   {
    "ref": "MI 5033",
    "name": "Reverse Osmosis State",
    "why": "Reverse osmosis stage status"
   },
   {
    "ref": "MI 603100",
    "name": "Area State 1",
    "why": "Area 1 state (one per area)"
   },
   {
    "ref": "AI 1611300",
    "name": "Actual Humidity Area 1",
    "why": "Measured RH in area 1, %"
   },
   {
    "ref": "MI 5055",
    "name": "Error Category",
    "why": "Error severity; alarm on categories 1-7 (11 = no error)"
   },
   {
    "ref": "AI 15232",
    "name": "Error Code",
    "why": "System Master error code"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": "No BMS-fed sensor inputs are listed; the BMS can write each area's humidity setpoint (AV 1611600-1611649, 20-100 %).",
  "setup": [
   "BACnet settings are under Menu > password 8808 > Network > BACnet Settings; the BACnet Protocol parameter ships Off (options MS/TP Master, MS/TP Slave, BACnet/IP) and the controller restarts after changing it.",
   "Node ID (device instance) defaults to 1001 (range 1-4194303); BACnet IP port defaults to 47808.",
   "IP addressing defaults to DHCP; if no DHCP server answers the controller falls back to an APIPA 169.254.x.x address.",
   "Foreign Device registration to a BBMD is Off by default; BBMD port 47808 and re-register time 10 are the factory values."
  ],
  "gotchas": [
   "Condair recommends alarming only on error categories 1-7 (7 = urgent warning or worse) to avoid nuisance alarms; category 11 (no error) needs software 3.2.0 or later.",
   "Wrong area setpoints or bad sensor values can cause water damage; the operator must check them.",
   "Only installed areas (see AI 15112 Number of Areas) return meaningful data.",
   "Timestamp AIs are in seconds since an epoch, not dates."
  ]
 },
