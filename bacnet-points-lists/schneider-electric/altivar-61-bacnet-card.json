 "model": "Altivar 61 BACnet MS/TP card VW3A3319",
 "model_slug": "altivar-61-bacnet-card",
 "aliases": [
  "ATV61 BACnet",
  "VW3A3319",
  "VW3 A3 319",
  "Altivar 61"
 ],
 "equipment_type": "Variable frequency drive (BACnet MS/TP option card)",
 "applies_to": "Schneider Electric Altivar 61 HVAC drives fitted with the VW3A3319 BACnet MS/TP option card.",
 "summary": "The Altivar 61 BACnet card serves a fixed object set on BACnet MS/TP: drive relays, logic and analog I/O (BI, BO, AI, AO, some only with the I/O extension cards), control and status Binary Values, and Analog Values for measurements, fault history, the BACnet speed reference, PID setpoint, a parameter mailbox and eight communication-scanner in/out words.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 1,
 "access_inferred": false,
 "notes": [
  "Objects marked (1) need the VW3A3201 logic I/O card and (2) the VW3A3202 extended I/O card.",
  "BI 9 'DI 4 ACT' is described as 'Value of LI3' in the table, probably a typo for LI4.",
  "The 2006 manual for the older VW3A3315 card has a slightly different table (BV 18/19 named SP1PRESET/SP2PRESET, BV 7 states BUSY/READY, AV 0 in Hz, AV 35 read-only), so this list is for the VW3A3319 only.",
  "COM SCAN OUT/IN AVs (28-43) carry whatever drive parameters are assigned in the communication scanner menu; by default OUT1 = control word, OUT2 = speed reference, IN1 = status word, IN2 = output speed.",
  "AV 0 units are printed as 'rmp' (rpm)."
 ],
 "source": {
  "title": "Altivar 61 BACnet card User's manual VW3 A3 319",
  "doc_number": "1765274",
  "revision_date": "2012-08",
  "url": "https://download.se.com/files?p_Doc_Ref=1765274"
 },
 "integration": {
  "summary": "Set the drive's reference and command channels to the network card ([Ref.1 channel] and [Cmd channel 1] = Com. card), then write AV 16 as the speed reference and BV 10 to start/stop. Read BV 0, AV 1, AV 4 and BV 2 / AV 18 for status and faults; BV 14 resets faults.",
  "minimum_points": [
   {
    "ref": "BV 10",
    "name": "RUN/STOP CMD",
    "why": "Start command (1 = start)"
   },
   {
    "ref": "AV 16",
    "name": "INPUT REF 1",
    "why": "Speed/frequency reference, %"
   },
   {
    "ref": "BV 14",
    "name": "FAULT RESET",
    "why": "Fault reset"
   },
   {
    "ref": "BV 0",
    "name": "RUN/STOP ACT",
    "why": "Running status"
   },
   {
    "ref": "AV 1",
    "name": "OUTPUT FREQ",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 4",
    "name": "CURRENT",
    "why": "Motor current, A"
   },
   {
    "ref": "BV 4",
    "name": "HAND/AUTO ACT",
    "why": "Hand/auto (local control) status"
   },
   {
    "ref": "BV 2",
    "name": "FAULT ACT",
    "why": "Drive fault"
   },
   {
    "ref": "AV 18",
    "name": "LAST FLT",
    "why": "Last fault code"
   }
  ],
  "enable": "Menu 1.6 COMMAND: [Ref.1 channel] (Fr1) and [Cmd channel 1] (Cd1) = [Com. card] (nEt). A logic input can be set to switch command and reference back to the terminals.",
  "heartbeat": "If the card receives no BACnet message for the [Time-out] (tLP) period (set in 0.1 s steps, display 1-600, default 10), a [Com. network] (CnF) fault occurs; [Network fault mgt] (CLL) sets the reaction (freewheel stop by default; ramp, fast or DC stop, ignore, fallback speed or speed hold).",
  "remote_sensors": "AV 27 EXT PID STPT takes the PID setpoint from the BMS when the drive PID uses the network setpoint.",
  "setup": [
   "MS/TP MAC address 1-127 from the card switches; baud AUTO (default), 9600, 19200, 38400 or 76800.",
   "Device instance = InHP x 1000 + InLP (default 1).",
   "Max Master default 127 (must not be below the card address), Max Info Frames default 10.",
   "Communication parameters change only with the motor stopped and take effect after a power cycle."
  ],
  "gotchas": [
   "Write INPUT REF 1 (AV 16) before RUN/STOP CMD (BV 10) when starting the drive.",
   "Parameter changes through the communication scanner must be made with the motor stopped.",
   "BO relay commands only work for relays not assigned to a drive function."
  ]
 },
