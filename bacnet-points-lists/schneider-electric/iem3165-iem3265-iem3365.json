 "equipment_type": "Power and energy meter (BACnet MS/TP)",
 "applies_to": "Schneider Electric iEM3165, iEM3265 and iEM3365 DIN-rail energy meters, the BACnet MS/TP models of the iEM3100/iEM3200/iEM3300 series.",
 "summary": "The BACnet versions of the iEM3000 DIN-rail meters (iEM3165 63 A direct, iEM3265 CT-connected, iEM3365 125 A direct) are BACnet MS/TP B-ASC devices. They serve Analog Inputs for current, voltage, power, power factor, frequency, total, partial, per-phase and per-tariff energy, plus meter and I/O configuration readbacks; one Analog Value for commands; and seven Binary Inputs for I/O and the overload alarm. The iEM3165 and iEM3365 stop at AI 48; AI 49-55 (VT/CT settings) are iEM3265 only.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Configuration readbacks (AI 0-6, AI 44-55) can't be changed over BACnet; set them at the front panel.",
  "Energy values are in Wh and survive power loss.",
  "AV00 Command accepts 20001 (acknowledge overload alarm), 2020 (reset partial energy) and 2023 (reset input metering).",
  "Up to 14 COV subscriptions on AI and BI objects.",
  "Object names follow the manual's 'AIxx - name' form.",
  "Source is user manual DOCA0005EN-16, chapter 'Communications using BACnet'."
 ],
 "source": {
  "title": "iEM3100 / iEM3200 / iEM3300 series User Manual",
  "doc_number": "DOCA0005EN-16",
