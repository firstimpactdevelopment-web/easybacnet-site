 },
 "integration": {
  "summary": "At the front panel set the MS/TP baud rate, MAC address and device ID, then read the energy import total (AI 27), total active power (AI 22), current, voltage and power factor. Read BI 05 if the overload alarm is used. Write AV00 only to reset partial counters or acknowledge alarms.",
  "minimum_points": [
   {
    "ref": "AI 27",
    "name": "AI27 - Total active energy import",
    "why": "Imported active energy, Wh"
   },
   {
    "ref": "AI 22",
    "name": "AI22 - Active Power Total",
    "why": "Total active power, kW"
   },
   {
    "ref": "AI 25",
    "name": "AI25 - Power Factor Total",
    "why": "Total power factor"
   },
   {
    "ref": "AI 10",
    "name": "AI10 - Current Average",
    "why": "Average phase current, A"
   },
   {
    "ref": "AI 18",
    "name": "AI18 - Voltage Average L-N",
    "why": "Average line-to-neutral voltage"
   },
   {
    "ref": "AI 26",
    "name": "AI26 - Frequency",
    "why": "Supply frequency"
   },
   {
    "ref": "BI 5",
    "name": "BI05 - Alarm Status",
    "why": "Overload alarm active"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Set baud (9600, 19200, 38400, 57600 or 76800), MAC address (1-127) and device ID (0-4194303) at the front panel.",
   "The device ID can only be set at the front panel; Object_Name, Description and Location are writable over BACnet.",
   "Max_Master and Max_Info_Frames are writable; APDU timeout 1000-30000 ms.",
   "No segmentation; max APDU 480 bytes."
  ],
  "gotchas": [
   "Energy is reported in Wh, not kWh.",
   "AI 49-55 exist only on the CT-connected iEM3265.",
   "The comms LED flashes even when there is a communication error."
  ]
 },
