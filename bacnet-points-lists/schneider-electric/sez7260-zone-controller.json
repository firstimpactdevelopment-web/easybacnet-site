 "integration": {
  "summary": "The zone runs with its SEZ7656 without any BMS. To command it, set MV 7 Cfg Network Handle to 2 or 3, then write occupancy MV 9 and the occupied setpoints AV 11 / AV 12. Read room temperature AV 21, damper position AI 1 and the PI demands AV 24 / AV 25.",
  "minimum_points": [
   {
    "ref": "MV 9",
    "why": "Occupancy command (needs MV 7 set to 2 or 3)",
    "name": "GUI Occupancy"
   },
   {
    "ref": "AV 11",
    "why": "Occupied heating setpoint",
    "name": "GUI Occupied Heat Spt"
   },
   {
    "ref": "AV 12",
    "why": "Occupied cooling setpoint",
    "name": "GUI Occupied Cool Spt"
   },
   {
    "ref": "MV 11",
    "why": "Occupied / unoccupied / temporary / stand-by",
    "name": "GUI Effective Occupancy"
   },
   {
    "ref": "AV 21",
    "why": "Room temperature",
    "name": "GUI Room Temperature"
   },
   {
    "ref": "AI 1",
    "why": "Zone damper position, % (F models)",
    "name": "GUI Damper Position"
   },
   {
    "ref": "AV 24",
    "why": "PI heating demand, %",
    "name": "GUI PI Heat Demand"
   },
   {
    "ref": "AV 25",
    "why": "PI cooling demand, %",
    "name": "GUI PI Cool Demand"
   }
  ],
  "enable": "MV 7 Cfg Network Handle: 1 = default (occupancy, mode and outdoor temperature come from the SEZ7656), 2 = zone handling minus occupancy, 3 = full release (zone runs without the SEZ7656). The BMS can hold occupancy MV 9 only at 2 or 3.",
  "heartbeat": null,
  "remote_sensors": "Room temperature AV 21 can be written only while BV 10 Room Temp Override is on. Outdoor temperature AV 22 normally comes from the SEZ7656. Room CO2 AV 32 is writable.",
  "setup": [
   "Each zone controller has a zone MAC (AV 1) and points to its rooftop controller MAC (AV 2).",
   "Default device instance is 72000 + MAC (AV 23)."
  ],
  "gotchas": [
   "If the controller goes offline, BMS-written room temperature, outdoor temperature and occupancy are released.",
   "Schneider recommends removing configuration (Cfg) objects from the BAS after setup to cut polling."
  ]
 },
