    "why": "System frequency"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP only (no MS/TP); dual Ethernet ports allow daisy-chaining.",
   "Device Object_Identifier, Object_Name and Location are writable.",
   "No segmentation."
  ],
  "gotchas": [
   "Out_Of_Service is writable on AIs and BIs; leave it false."
  ]
 },
