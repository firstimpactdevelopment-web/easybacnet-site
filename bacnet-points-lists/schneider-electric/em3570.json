 "equipment_type": "Power and energy meter (BACnet IP)",
 "applies_to": "Schneider Electric EM3570 series three-phase DIN-rail Ethernet energy meters (LVCT or Rogowski inputs, with or without power supply module), firmware 1.9.0.",
 "summary": "The EM3570 is a compact three-phase DIN meter with two Ethernet ports, BACnet IP, Modbus TCP and SNMP. Its BACnet object list is read-only: Analog Inputs for current, voltage, per-phase and total power, power factor, frequency, delivered and received energy, and present and peak demand, plus Binary Inputs for its two status inputs and alarm relay. Object instances follow the Modbus register numbers.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "1.9.0 (application 111.241.298)",
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "The PICS lists only object identifiers and names; it gives no units, so units are left blank here.",
  "Only Out_Of_Service and COV_Increment are writable on the AIs, so all objects are read-only data.",
  "Instance numbers match the PowerLogic meter register scheme (e.g. AI 3060 Active Power - Total).",
  "The demand peak current objects are printed as 'Dmd - Active Current Ph x Peak'."
 ],
 "integration": {
  "summary": "Give the meter an IP address and device ID, then read total power, delivered energy, demand, power factor, voltage and current. Nothing is controlled over BACnet.",
