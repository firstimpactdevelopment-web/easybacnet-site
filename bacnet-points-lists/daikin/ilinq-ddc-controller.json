{
 "manufacturer": "Daikin",
 "manufacturer_slug": "daikin",
 "model": "Daikin iLINQ DDC Controller (BACnet MS/TP and BACnet IP)",
 "model_slug": "ilinq-ddc-controller",
 "short_model": "Daikin iLINQ Controller",
 "aliases": [
  "iLINQ",
  "Daikin iLINQ",
  "BDG-ILINQA",
  "iLINQ DDC controller"
 ],
 "equipment_type": "Rooftop unit controller (light commercial packaged units and heat pumps)",
 "applies_to": "Daikin light commercial packaged rooftop units (AC with electric or gas heat, or heat pump) fitted with the iLINQ DDC controller.",
 "summary": "The iLINQ DDC controller on Daikin light commercial packaged units talks BACnet MS/TP (port J25 BMS2) or BACnet IP (Ethernet) without extra hardware. Its object list covers space, supply and outdoor conditions, refrigerant pressures, setpoints, blower and economizer settings, network sensor inputs, relay status, individual alarm flags and multistate schedule, mode and configuration objects.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 15000,
 "access_inferred": false,
 "notes": [
  "Access is from the R/W column. Many writable AVs are setup values (offsets, bands, delays, calibration).",
  "Temperature offsets, bands and calibration values are temperature differences (printed as ∆°F); they are shown here as °F.",
  "AV 93-100 mirror the software revision and installed equipment counts.",
  "Binary values 27-68 are individual alarm flags; AlarmDO (BV 20) is true when any alarm is active.",
  "The sensor source selectors (MV 9-13) are read-only over BACnet; set them at the LCD or web interface.",
  "The table prints state 7 of HVACMode_BacMsv as \"Force\"; the rest of the text is not shown."
 ],
 "source": {
  "title": "Daikin iLINQ BACnet Design Guide",
  "doc_number": "BDG-ILINQA",
  "revision_date": null,
  "url": "https://daikincomfort.com/docs/default-source/daikin-ilinq-controller/bdg-ilinq.pdf"
 },
 "integration": {
  "summary": "Pick MS/TP or IP in the communication settings, set the instance ID (and MAC/baud for MS/TP) and set Update to Yes. Command occupancy by writing ScheduleSource (MV 0) and write OccCoolSP / OccHeatSP; read space and supply air temperature, HVAC mode, blower status and AlarmDO.",
  "minimum_points": [
   {
    "ref": "MV 0",
    "name": "ScheduleSource",
    "why": "3 = Force Occupied, 4 = Force Unoccupied from the BAS"
   },
   {
    "ref": "AV 17",
    "name": "OccCoolSP",
    "why": "Occupied cooling setpoint, °F"
   },
   {
    "ref": "AV 18",
    "name": "OccHeatSP",
    "why": "Occupied heating setpoint, °F"
   },
   {
    "ref": "MV 2",
    "name": "HVACMode_BacMsv",
    "why": "Current HVAC mode"
   },
   {
    "ref": "BV 6",
    "name": "BlowerStage1",
    "why": "Blower stage 1 relay on/off"
   },
   {
    "ref": "AI 0",
    "name": "SpaceTemp",
    "why": "Space temperature, °F"
   },
   {
    "ref": "AI 1",
    "name": "SupplyAirTemp",
    "why": "Supply air temperature, °F"
   },
   {
    "ref": "BV 20",
    "name": "AlarmDO",
    "why": "Any alarm active"
   }
  ],
  "enable": "To schedule from the BAS, write 3 (Force Occupied) or 4 (Force Unoccupied) to ScheduleSource (MV 0); the onboard schedule and optimal start/stop are then ignored. If PushButtonOvrDuration (AV 79) is above 0, the space sensor button or the Remote Start Stop input can still give a temporary override.",
  "heartbeat": null,
  "remote_sensors": "Space temperature, space humidity, outdoor temperature, outdoor humidity and space CO2 can come from the BAS through AV 12-16 once each source is set to Network at the LCD or web interface (the source objects MV 9-13 are read-only over BACnet).",
  "setup": [
   "Communication type defaults to BACnet MS/TP; MS/TP wires to terminal J25 BMS2, BACnet IP uses either Ethernet port.",
   "Defaults: instance ID 15000, baud 38400 (9600-76800), MAC address 1, Max Master 127.",
   "Settings take effect when Update is set to Yes, which restarts the controller.",
   "COV subscriptions are supported; COV increments of AIs and AVs can be changed from the BACnet client."
  ],
  "gotchas": [
   "The active setpoints (AV 6/7) are read-only and include local adjustment, load shedding and unoccupied offsets; write OccCoolSP / OccHeatSP instead.",
   "UnitOccupiedStartDelay (AV 78) can stagger start-up when many units are commanded occupied together.",
   "Offsets, bands, delays and calibration AVs are setup values; don't write them cyclically."
  ]
 },
