{
 "manufacturer": "Daikin",
 "manufacturer_slug": "daikin",
 "model": "DZK BACnet Interface (DZK-BACNET-HUB4) for the Daikin Zoning Kit",
 "model_slug": "dzk-bacnet-hub4-zoning-kit",
 "short_model": "DZK BACnet HUB4",
 "aliases": [
  "DZK-BACNET-HUB4",
  "DZK-4",
  "Daikin Zoning Kit BACnet",
  "DZK BACnet Interface"
 ],
 "equipment_type": "Zoning system / zone thermostat BACnet interface",
 "applies_to": "Daikin Zoning Kit (DZK) systems on a Daikin indoor unit (the manual's layouts show VRV), with objects for up to six zones, through the DZK BACnet interface board.",
 "summary": "The DZK BACnet Interface plugs onto the DZK main control board and exposes the zoning system on BACnet IP (Ethernet or Wi-Fi) or BACnet MS/TP. The object list is fixed for six zones: per-zone on/off, heat and cool setpoints, room temperature, humidity, demands and damper step, plus the system mode, user mode and indoor unit status. One interface is needed per DZK system.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": 1000,
 "access_inferred": false,
 "notes": [
  "Objects for zones that do not exist report Out_Of_Service TRUE; only use values where Out_Of_Service is FALSE.",
  "Z1 local ventilation is printed 'Z1 Local Ventilation'; zones 2-6 use 'Local ventilation'.",
  "Temperature ranges are printed in both °F and °C; the unit follows the system setting.",
  "IU errors (MI 1): convert the value to hex 0xXY, row = X-1, column = Y, then look up the Daikin malfunction code table in the manual.",
  "The DZK error states are printed as display codes 1-3 mapping to errors 9, 10 and 11; the detailed text also lists 0 for normal operation.",
  "Values are refreshed every second; COV subscriptions are supported."
 ],
 "source": {
  "title": "DZK-4 Integration manual (DZK BACnet Interface)",
  "doc_number": null,
  "revision_date": "Rev. 1",
  "url": "https://daikincomfort.com/docs/default-source/dzk-zoning-kit/um-dzk-bacnet-hub4.pdf"
 },
 "integration": {
  "summary": "Set BACnet IP or MS/TP and the device ID in the configuration app, then use DZK operation mode (MO 0) and user mode (MO 1) for the system, and Zx ON/OFF plus the zone heat and cool setpoints per zone. Read zone temperatures, IU status, IU speed and the error objects for monitoring.",
  "minimum_points": [
   {
    "ref": "MO 1",
    "name": "DZK user mode",
    "why": "1 stop, 2 comfort, 3 unoccupied, 5 eco, 6 vacation"
   },
   {
    "ref": "MO 0",
    "name": "DZK operation mode",
    "why": "1 auto, 2 cool, 3 heat, 4 dry, 5 emergency heat"
   },
   {
    "ref": "BV 3",
    "name": "Z1 ON/OFF",
    "why": "Zone 1 on/off (repeat for zones 2-6)"
   },
   {
    "ref": "AV 1",
    "name": "Z1 Heat Set point",
    "why": "Zone 1 heating setpoint"
   },
   {
    "ref": "AV 2",
    "name": "Z1 Cool Set point",
    "why": "Zone 1 cooling setpoint"
   },
   {
    "ref": "BI 0",
    "name": "IU Status ON/OFF",
    "why": "Indoor unit running"
   },
   {
    "ref": "AI 0",
    "name": "Z1 Room Temperature",
    "why": "Zone 1 room temperature"
   },
   {
    "ref": "MI 0",
    "name": "IU speed",
    "why": "Indoor unit fan step: low, medium, high"
   },
   {
    "ref": "MI 1",
    "name": "IU errors",
    "why": "Indoor unit error; hex value = Daikin code"
   },
   {
    "ref": "MI 2",
    "name": "DZK error",
    "why": "Zoning system error (bus, interface, P1P2)"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP defaults: device ID 1000, UDP port 47808, DHCP (static default 192.168.0.100).",
   "BACnet MS/TP: MAC 0-127, device ID 0-4194302 and baud rate are set in the app; select the MS/TP integration port.",
   "One DZK BACnet interface per DZK control board."
  ],
  "gotchas": [
   "In VRV heat pump systems the operating mode of a DZK on a slave indoor unit can be limited by the master indoor unit's mode.",
   "The DZK address and group address (AV 13, 14) are learned at indoor unit start-up; if the DZK powers up after the indoor unit they may need a refresh from the controller.",
   "IU Set Point (AV 0) is calculated by the zoning system and is read only; change the zone setpoints instead."
  ]
 },
