 "equipment_type": "Chilled water precision cooling unit (computer room air handler)",
 "applies_to": "Liebert DCL chilled-water cooling units with the iCOM controller.",
 "summary": "The Liebert iCOM DCL chilled water cooling reports to a BMS through a Liebert IntelliSlot card (IS-UNITY-DP, for BACnet IP or BACnet MS/TP). The object list has Binary Values for events, Analog Values for temperatures, humidity, setpoints and run hours, and Multi-state Values for states and control modes. Objects are created on the card when it discovers the unit, so only options fitted to the unit appear.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Tables 5.52, 5.53, 5.54, pdf pages 1529-1538 of the 2024 guide (printed page numbers are 4 lower).",
  "Object names are Vertiv data IDs (e.g. 5331_1); the description holds the guide's data label. Labels repeated for different sensors or circuits get the group name in brackets."
 ],
 "source": {
  "title": "Liebert IntelliSlot Modbus/BACnet Reference Guide (Modbus RTU and TCP, BACnet MSTP and IP)",
  "doc_number": "SL-28170",
  "revision_date": "2024-04 (Rev 29)",
  "url": "https://www.vertiv.com/49fb41/globalassets/shared/liebert-intellislot-modbus-rtu-reference-guide-SL-28170_0.pdf"
 },
 "integration": {
  "summary": "Fit a Liebert IntelliSlot BACnet card (IS-UNITY-DP for BACnet IP or MS/TP), give it a unique device instance and let it discover the unit; the objects are then created automatically. Map the on/off and setpoint objects if the BMS controls the unit, and the status, main measurements and event objects for monitoring.",
  "minimum_points": [
   {
    "ref": "MV 121",
    "name": "5143_1",
    "why": "On/off command (1=off, 2=on)"
   },
   {
    "ref": "MV 133",
    "name": "4717_1",
    "why": "Acknowledge / reset events"
   },
   {
    "ref": "MV 108",
    "name": "4706_1",
    "why": "Run / standby / off state"
   },
   {
    "ref": "MV 107",
    "name": "4123_1",
    "why": "Normal, warning or alarm state"
   },
   {
    "ref": "BV 150",
    "name": "5113_1",
    "why": "Unit shut down by an event"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The card needs a unique Device Instance Number; the device object represents the card, not the unit.",
   "The cards have no BBMD; IS-UNITY-DP and IS-IPBML support foreign device registration (BBMD address and time-to-live).",
   "IS-UNITY-DP adds BACnet MS/TP; IS-WEBADPT and IS-IPBML are BACnet IP only. Check the compatibility table (guide section 1.1.3) for the card your unit supports."
  ],
  "gotchas": [
   "Vertiv asks for no more than about two writes and two reads per second on average; do not rewrite setpoints continuously.",
   "No segmented responses: large ReadPropertyMultiple requests can fail, so split them.",
   "Only data the managed unit actually has is created on the card, so object counts vary by model and options."
  ]
 },
