 "equipment_type": "Power distribution unit (PDU) monitoring",
 "applies_to": "Liebert FDC, FPC, PPC and RDC power distribution units with the CPM controller.",
 "summary": "The Liebert FDC / FPC / PPC / RDC power distribution reports to a BMS through a Liebert IntelliSlot card (BACnet IP or BACnet MS/TP). Analog Values carry input, output, panel and branch circuit electrical data, Binary Values carry events and Multi-state Values carry status, breaker states and resets. Panel and branch objects repeat per panel and branch, so the list is long.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Tables 5.92, 5.93, 5.94, pdf pages 1781-1785 of the 2024 guide (printed page numbers are 4 lower).",
  "Object names are Vertiv data IDs (e.g. 5331_1); the description holds the guide's data label. Labels repeated for different sensors or circuits get the group name in brackets.",
  "The same guide section has three tables for three PDU controllers (LDMF, CPM, VPMP); this file is the CPM one."
 ],
 "source": {
  "title": "Liebert IntelliSlot Modbus/BACnet Reference Guide (Modbus RTU and TCP, BACnet MSTP and IP)",
  "doc_number": "SL-28170",
  "revision_date": "2024-04 (Rev 29)",
  "url": "https://www.vertiv.com/49fb41/globalassets/shared/liebert-intellislot-modbus-rtu-reference-guide-SL-28170_0.pdf"
 },
 "integration": {
  "summary": "Fit a Liebert IntelliSlot BACnet card (IS-UNITY-DP for BACnet IP or MS/TP), give it a unique device instance and let it discover the equipment; the objects are then created automatically. Map the status, main measurements and event objects for monitoring.",
