 "equipment_type": "Thermostat / room controller",
 "applies_to": "Vector Controls X2 family controllers (TCX2, TCI2, SxC2, TRI2 and others) fitted with the CS1-BAC-002 BACnet MS/TP plug-in module.",
 "summary": "The X2 BACnet MS/TP module maps the X2 operating system into a fixed set of objects: controller state and access locks, universal and virtual inputs with offsets, up to four control loops, analog and digital outputs (with override values and state), fan stages and eight alarms. Objects only appear for the I/O the specific X2 product has.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Objects are created only for the inputs, outputs, loops and alarms the X2 product actually has; the datasheet scope table says which exist.",
  "Digital output objects depend on how each output is configured (fan, 3-point floating, PWM or binary); the same instance can appear in several of these tables, listed here once.",
  "Alarm MVs (601-608) can only be written to Not Active when the alarm is waiting for confirmation.",
  "Other controller parameters are reached through ParAdd/ParValue (an address + value pair), not as separate objects.",
  "Controller information AVs 0-11 report how many loops, inputs, outputs, alarms and schedules the controller has."
 ],
 "source": {
  "title": "X2-BACnet MS/TP",
  "doc_number": "70-00-0218D V1.4",
  "revision_date": "2026-08-26",
  "url": "https://vectorcontrols.com/application/files/1517/8775/5952/70-00-0218D_X2-BACnet_V1_4.pdf"
 },
 "integration": {
  "summary": "Use BV 0 for on/off and MV 0 for occupied/unoccupied, write loop set points (AV 211 for loop 1) and feed sensor values through the virtual inputs if needed. Read the universal inputs, loop outputs and the alarm MVs.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "OpStOo",
    "why": "Controller on/off"
   },
   {
    "ref": "MV 0",
    "name": "OpStCoSt",
    "why": "Occupied / unoccupied"
   },
   {
    "ref": "MV 1",
    "name": "OpStHeCo",
    "why": "Cool / heat mode"
   },
   {
    "ref": "AV 211",
    "name": "LP-01-SSP",
    "why": "Loop 1 set point"
   },
   {
    "ref": "AI 101",
    "name": "UI-01",
    "why": "Universal input 1 (e.g. room temperature)"
   },
   {
    "ref": "MV 211",
    "name": "LP-01-ST",
    "why": "Loop 1 state"
   },
   {
    "ref": "AV 213",
    "name": "LP-01-PROP",
    "why": "Loop 1 output, %"
   },
   {
    "ref": "MV 601",
    "name": "AL-01",
    "why": "Alarm 1 state"
   }
  ],
  "enable": "BV 3-7 lock or unlock local access to modes, set points, manual control, heat/cool change and time programs.",
  "heartbeat": "Virtual inputs (AV 109-116) set to the communication module must be rewritten within the controller's timeout, or the input and its functions are disabled and Err 4 shows.",
  "remote_sensors": "Write sensor values from the BMS to the virtual inputs VI-01..VI-04 (AV 109, 111, 113, 115) when they are set to the communication module.",
  "setup": [
   "MS/TP MAC (CO03, default 3), baud (CO04, 0 = auto-detect, 9600-115200), max master (CO05) and device ID (CO06-CO09) are set in the controller's COM parameters (login code 241).",
   "Device object name auto-builds as AEX-BAC-<device ID> when CO15 = 2 or 3."
  ],
  "gotchas": [
   "Vector does not recommend changing parameters through ParAdd/ParValue (AV 12/AV 13); use it only as a workaround.",
   "Temperature units follow MV 2 (Celsius/Fahrenheit)."
  ]
 },
