  "unofficial": true,
  "host": "BACnet International"
 },
 "integration": {
  "summary": "Command BV 3 Drive Run Fwrd and AV 1 Speed Ref, reset trips with BV 6, and read output frequency, current, power, BV 4 Drive Healthy, MV 1 Drive Status and AV 15 Last Trip.",
  "minimum_points": [
   {
    "ref": "BV 3",
    "name": "#BV_03 Drive Run Fwrd",
    "why": "Run forward command"
   },
   {
    "ref": "AV 1",
    "name": "#AV_01 Speed Ref",
    "why": "Speed reference, Hz"
   },
   {
    "ref": "BV 6",
    "name": "#BV_06 Drive Reset",
    "why": "Trip reset (write active)"
   },
   {
    "ref": "BI 7",
    "name": "#BI_07 Drive Binary IP7",
    "why": "Drive enable input state"
   },
   {
    "ref": "AV 10",
    "name": "#AV_10 Output Frequency",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 9",
    "name": "#AV_09 Output Current",
    "why": "Motor current, A"
   },
   {
    "ref": "AV 11",
    "name": "#AV_11 Output Power",
    "why": "Output power, kW"
   },
   {
    "ref": "BV 4",
    "name": "#BV_04 Drive Healthy",
    "why": "Drive healthy (no trip)"
   },
   {
    "ref": "MV 1",
    "name": "#MSV_01 Drive Status",
    "why": "Drive health and trip state"
   },
   {
    "ref": "AV 15",
    "name": "#AV_15 Last Trip",
    "why": "Last trip code"
   }
  ],
  "setup": [
   "Network Port objects: only foreign-device (BBMD registration) properties are writable."
  ],
  "gotchas": [
   "BV 6 Drive Reset can only be written active from inactive; BV 2 can only be written inactive."
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null
 },
