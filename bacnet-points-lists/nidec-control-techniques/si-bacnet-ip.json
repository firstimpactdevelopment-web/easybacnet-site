 ],
 "equipment_type": "Variable frequency drive BACnet IP option module",
 "applies_to": "Control Techniques SI-BACnet IP option module (part 82400000022600) fitted to a compatible Control Techniques drive.",
 "summary": "The SI-BACnet IP is a plug-in option that puts a Control Techniques drive on BACnet IP. It exposes the same kinds of objects as the H300 onboard port (I/O, speed reference, run and reset, output values, PID loops, filter timers, energy meter, ten user-configurable AVs) but numbers the Analog Values differently and adds a multistate drive-status object and two network port objects.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "01.00.02.06 (PICS)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Object names are listed as printed, including the #AI_01-style prefix.",
  "AV numbering differs from the H300 onboard MS/TP list: Speed Ref is AV 1 here and AV 4 on the H300.",
  "Read-only analog objects are printed R*: only COV-related properties are writable.",
  "AV 25-34 map any drive parameter; access follows the mapped parameter (printed R/W).",
  "The PICS also lists Network Port objects #NP_01 and #NP_02; they are not listed as points.",
  "The PICS gives no state texts for MV 1 Drive Status.",
  "The PICS says the module only shows the objects the host drive supports, so some objects may be missing on a given drive."
 ],
 "source": {
  "title": "SI-BACnet IP PICS",
