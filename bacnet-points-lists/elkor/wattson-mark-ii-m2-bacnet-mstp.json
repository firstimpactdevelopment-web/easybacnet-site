{
 "manufacturer": "Elkor",
 "manufacturer_slug": "elkor",
 "model": "WattsOn-Mark II -M2 power meter (BACnet MS/TP)",
 "model_slug": "wattson-mark-ii-m2-bacnet-mstp",
 "aliases": [
  "WattsOn-Mark II",
  "W2-M2",
  "WattsOn Mk II BACnet MS/TP",
  "Elkor WattsOn BACnet MS/TP"
 ],
 "equipment_type": "Power and energy meter (submeter)",
 "applies_to": "Elkor WattsOn-Mark II three-phase power meters ordered with the -M2 BACnet MS/TP output.",
 "summary": "The -M2 version of the WattsOn-Mark II replaces the Modbus/RTU port with native BACnet MS/TP. It exposes 87 read-only Analog Inputs (totals and per-phase power, voltage, current, power factor, angles, energy by quadrant and device info) and 42 writable Analog Values for CT/PT ratios, demand window, relay alarms, locking and energy reset. The instance scheme is not the same as the -E4 BACnet IP version.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Firmware V10.60, application V1.300 (PICS, November 2015)",
 "default_device_instance": "28xxxxx (xxxxx = serial number)",
 "access_inferred": false,
 "notes": [
  "AI 19 is not used; Volts_AC is AI 20.",
  "Energy objects are printed with the kWh unit code, but the table says the real units of the kVAh and kVARh objects are kVAh and kVARh; those units are used here.",
  "The unit text for kVAR and kVA is swapped in the table; units here follow the BACnet unit codes (12 = kvar, 9 = kVA).",
  "In this -M2 list all settings (including Lock, Freq_Auto and the relay trigger/mode settings) are Analog Values; the -E4 BACnet IP list uses other types and instances.",
  "Source: WattsOn-Mark II BACnet MS/TP (-M2) Addendum, Revision 1 (November 2015), section 4."
 ],
 "source": {
  "title": "WattsOn-Mark II BACnet MS/TP (-M2) Addendum",
  "doc_number": null,
  "revision_date": "2015-11 (Revision 1)",
  "url": "https://www.elkor.net/pdfs/W2-BACnet_MSTP_Guide.pdf"
 },
 "integration": {
  "summary": "Set the MAC, baud and device instance, then write the CT and PT ratios (AV 0-15) to match the installation. Read total kW, imported kWh, demand, power factor, average current and voltage.",
  "minimum_points": [
   {
    "ref": "AI 4",
    "name": "kW_Total",
    "why": "Total real power, kW"
   },
   {
    "ref": "AI 45",
    "name": "kWh_Import_Ttl",
    "why": "Imported energy total, kWh"
   },
   {
    "ref": "AI 43",
    "name": "kWh_Net_Ttl",
    "why": "Net energy total, kWh"
   },
   {
    "ref": "AI 42",
    "name": "kW_Demand",
    "why": "Sliding-window kW demand"
   },
   {
    "ref": "AI 10",
    "name": "PF_Total",
    "why": "Total power factor"
   },
   {
    "ref": "AI 9",
    "name": "Current_Avg",
    "why": "Average current, A"
   },
   {
    "ref": "AI 7",
    "name": "Volts_LN_Avg",
    "why": "Average line-to-neutral voltage, V"
   },
   {
    "ref": "AI 11",
    "name": "Frequency",
    "why": "Line frequency, Hz"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Baud 9600-115200, default 76800; no parity, 1 stop bit.",
   "MAC 1-15 on the address switch, or 0-127 set in software with the switch on 'F'; default 1. Switch position 0 is invalid.",
   "Device instance 0-4,194,302, default 28 followed by the serial number; Max Master default 127; device name up to 16 characters.",
   "Settings are changed on the optional display (then Commit) or with Elkor's configuration utility over the expansion bus; a reset applies them.",
   "Segmentation is not supported."
  ],
  "gotchas": [
   "Reset_Energy only acts on 42405 (0xA5A5); Reboot_Device only on 43605 (0xAA55).",
   "An invalid baud, MAC or instance written through the configuration registers stops the MS/TP port at start-up; there is no error check.",
   "Object instances differ from the -E4 BACnet IP model; don't reuse a -E4 mapping."
  ]
 },
