 "manufacturer_slug": "bosch",
 "model": "Buderus SSB800 / SSB1000 / SSB1000TL boiler (ProtoNode FPC-N38)",
 "model_slug": "ssb-boiler-protonode",
 "aliases": [
  "SSB800",
