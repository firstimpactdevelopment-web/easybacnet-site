{
 "manufacturer": "Bosch",
 "manufacturer_slug": "bosch",
 "model": "REGO 5200 heat pump controller (Supraeco T)",
 "model_slug": "rego-5200-heat-pump-controller",
 "aliases": [
  "REGO 5200",
  "REGO5200",
  "Supraeco T",
  "Bosch Supraeco T BACnet",
  "6 720 821 165",
  "Bosch ground source heat pump BACnet"
 ],
 "equipment_type": "Heat pump controller",
 "applies_to": "Bosch REGO 5200 controller used in Bosch Supraeco T ground-source / water heat pumps, program 1.3-0-00 and later.",
 "summary": "The REGO 5200 heat pump controller publishes one BACnet device (instance 2001) with about 250 objects: heat curve and DHW settings, communicated (override) sensor values and setpoints as AVs, sensor readings and run-time meters as AVs, compressor and pump commands/statuses and I/O as BVs, and one Multi-state Value per alarm. The same data is also on Modbus.",
 "bacnet_transport": [],
 "firmware": "Program 1.3-0-00 and later (document 1.3.1-01)",
 "default_device_instance": 2001,
 "access_inferred": false,
 "notes": [
  "The manual does not say which BACnet data link (IP or MS/TP) the controller uses; the Modbus side is Modbus TCP.",
  "Object types are printed as BACnet type numbers (2 = AV, 5 = BV, 19 = MSV).",
  "Access comes from the printed 'settable' column (Y = writable).",
  "Units are not printed; temperatures and setpoints follow the controller's units.",
  "Each alarm (Alarm1-Alarm105) is its own MSV (instances 19-123); alarm numbers are not continuous (e.g. no Alarm92).",
  "Instance gaps (AV 46-63, AV 66, MSV 4-9) are as printed."
 ],
 "source": {
  "title": "Modbus/ Bacnet protocol REGO 5200",
  "doc_number": "6 720 821 165",
  "revision_date": "2016/11",
  "url": "https://www.bosch-homecomfort.com/ocsmedia/optimized/full/o451341v272_Modbus-Protokoll_Supraeco_T-2.pdf"
 },
 "integration": {
  "summary": "Keep the third-party watchdog alive with BV 4, use BV 1-3 to allow or force the compressors, and write the communicated flow setpoint or sensor values when override mode is used. Read sensor values, compressor run states and the summary alarms.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "externalCompressorStartEnable",
    "why": "Third-party compressor start (0 Auto, 1 Run)"
   },
   {
    "ref": "BV 2",
    "name": "externalStartCompressor1",
    "why": "Compressor 1 allow (0 Stop, 1 Auto)"
   },
   {
    "ref": "AV 35",
    "name": "flowTemperatureSetpointCom",
    "why": "Flow temperature setpoint, communicated mode"
   },
   {
    "ref": "BV 4",
    "name": "resetWatchdog",
    "why": "Third-party watchdog reset (5 min)"
   },
   {
    "ref": "MV 16",
    "name": "compressor1RunState",
    "why": "Compressor 1 run state"
   },
   {
    "ref": "AV 70",
    "name": "sensorT0",
    "why": "Heating system temperature T0"
   },
   {
    "ref": "AV 72",
    "name": "sensorTL1",
    "why": "Outdoor temperature (damped)"
   },
   {
    "ref": "BV 10",
    "name": "sumAlarmA",
    "why": "Summary alarm A"
   },
   {
    "ref": "BV 11",
    "name": "sumAlarmB",
    "why": "Summary alarm B"
   }
  ],
  "enable": "BV 1 (externalCompressorStartEnable) and BV 2/BV 3 (allow per compressor) let a third-party system start or block the compressors.",
  "heartbeat": "BV 4 resetWatchdog is the third-party watchdog reset (5 minutes); the Modbus part of the manual says watchdog-dependent settings are ignored unless the watchdog has been reset.",
  "remote_sensors": "BV 5 (CommunicatedSensors) switches T0 and TL1 to the values written to AV 3/AV 4; TW1 uses AV 5 when the TW1 sensor setting is Communicated. BV 6 (communicatedFlowTempSetpoint) makes the controller use the flow setpoint written to AV 35.",
  "setup": [
   "BACnet device instance is printed as 2001."
  ],
  "gotchas": [
   "MV 2 (AlaAcknow) and AV 2 (alarmAcknowledge) acknowledge alarms by writing the alarm number."
  ]
 },
