 "equipment_type": "Boiler plant (multi-boiler) controller",
 "applies_to": "Bosch Heatronic 4000 control that runs up to four boilers for heating and DHW loads (product now discontinued).",
 "summary": "The Heatronic 4000 controls up to four boilers and talks native BACnet IP (or Modbus RS-485). It exposes 72 objects: primary and DHW temperatures, flow, energy, pressure, pump run times, the error code and per-boiler type, outlet temperature, modulation, run time, cycles and pump time, plus BMS-writable setpoint, room and design temperatures, outdoor temperature, heat call, pump requests and per-boiler enable.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Application software J1229A, firmware revision 33 (PICS)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Native BACnet IP, vendor ID 744, BACnet protocol revision 10, device profile B-ASC.",
  "Per-boiler objects are printed with (n) = boiler 1-4 and explicit IDs; they are listed here for all four boilers.",
  "What the BMS can command depends on the Application Mode: full control only in BAS mode, monitoring and selected settings in the other modes with BAS Monitor ON.",
  "Error codes (0 = no error, sensor and tN4 bus errors, etc.) are listed on page 12 of the manual.",
  "The object list closely matches the tekmar Boiler Control 284 BAS manual (watts/tekmar-boiler-control-284); the two appear to share the same control platform, with small differences in object names."
 ],
 "integration": {
  "summary": "For control, set Application Mode to BAS: the BMS then writes BAS Heat Call, the setpoint and the pump requests, and can enable or disable each boiler. In the other modes (RSET, SETP, DDHW, EMS) turn BAS Monitor ON to read values and adjust selected settings. Read primary target and supply temperature, boiler modulation, the alert relay and the error code.",
  "minimum_points": [
   {
    "ref": "BV 0",
    "name": "BAS HEAT CALL",
    "why": "Heat call from the BMS (APP MODE = BAS)"
   },
   {
    "ref": "AV 0",
    "name": "SETPOINT",
    "why": "Primary setpoint from the BMS, 60-225 °F"
   },
   {
    "ref": "BV 1",
    "name": "BAS PRIM PMP REQ",
    "why": "Primary pump request from the BMS"
   },
   {
    "ref": "BO 0",
    "name": "DHW PUMP",
    "why": "DHW tank pump request from the BMS"
   },
   {
    "ref": "AI 0",
    "name": "PRIM TARG",
    "why": "Primary target temperature in use"
   },
   {
    "ref": "AI 3",
    "name": "PRIM SUP",
    "why": "Primary supply water temperature"
   },
   {
    "ref": "AI 18",
    "name": "Boil 1 MOD",
    "why": "Boiler 1 modulation, % (repeat per boiler)"
   },
   {
    "ref": "BI 0",
    "name": "PRIM P1",
    "why": "Primary pump 1 running"
   },
   {
    "ref": "BI 5",
    "name": "ALERT RLY",
    "why": "Alert dry relay energized"
   },
   {
    "ref": "AI 15",
    "name": "ERROR",
    "why": "Active error code; see the error list"
   }
  ],
  "enable": "Set the Heatronic 4000 Application Mode to BAS for BMS control: the BAS then sends the setpoint (AV 0) and heat call (BV 0), plus primary pump (BV 1) and DHW pump (BO 0) requests. BV 2-5 enable (0) or disable (1) boilers 1-4. In RSET, SETP, DDHW or EMS mode, set BAS Monitor = ON for monitoring and adjusting selected settings only.",
  "heartbeat": null,
  "remote_sensors": "AV 5 BAS Outdoor Air Temperature takes an outdoor temperature from the BMS (-85 to 149 °F); -85 °F means invalid / no BAS sensor.",
  "setup": [
   "BAS Type must be BACn (BACnet IP over the RJ45 port); MODB selects Modbus RS-485 instead.",
   "Device ID is entered at the control as four number sets (0-4, 0-99, 0-99, 0-99), default 0,0,0,0.",
   "UDP port default 0xBAC0 (47808); DHCP is ON by default, static default 192.168.0.200 with gateway 192.168.0.1.",
   "Foreign device registration: set BBMD TIME (30-65535 s), BBMD IP and BBMD port.",
   "The BAS menu items need the Advanced access level (unlock switch beside the display)."
  ],
  "gotchas": [
   "ENABLE B1-B4 use 0 = Enable, 1 = Disable.",
   "Only BACnet IP is supported (no MS/TP); Modbus uses RS-485.",
   "DeviceCommunicationControl password is \"Bosch\" (from the PICS)."
  ]
 },
