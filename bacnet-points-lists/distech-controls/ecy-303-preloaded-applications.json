{
 "manufacturer": "Distech Controls",
 "manufacturer_slug": "distech-controls",
 "model": "ECY-303 preloaded applications (rooftop unit)",
 "model_slug": "ecy-303-preloaded-applications",
 "aliases": [
  "ECY-303",
  "Eclypse Connected Equipment Controller",
  "ECY-303 Roof Top Unit"
 ],
 "equipment_type": "Rooftop unit controller (preloaded application)",
 "applies_to": "Packaged rooftop units (staged cooling and heating, heat pump, economizer, humidity) run by an Eclypse ECY-303 with its factory application.",
 "summary": "The ECY-303 is a Distech Controls Eclypse connected equipment controller that ships with preloaded, configurable rooftop unit applications (cooling and heating stages, heat pump reversing valve, economizer, humidification and dehumidification). The program exposes a fixed set of input, output and value objects. The wiring diagrams show it on Ethernet or on a BACnet MS/TP network.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": true,
 "notes": [
  "Objects are documented one per section in the guide's Variables chapter, including the universal inputs (AI 1-8) and analog outputs (AO 6-8). The digital outputs DO1-DO5 are shown only as DO1-DO5 with no BACnet object type, so they are not listed.",
  "The guide has no read/write column, so access is inferred: inputs and values the guide describes as displayed (measured or calculated) are read-only; setpoints, commands, configuration values and the analog outputs are marked writable.",
  "This is the imperial-units (IMP) edition; the separate SI edition lists the same objects with metric units.",
  "PID loop objects (loop 1-8) are named in the guide but not listed here.",
  "AI 5001-5003 and BI 5004 carry readings from an Allure EC-Smart-Vue sensor when one is connected."
 ],
 "source": {
  "title": "ECY-303 Preloaded Applications User Guide",
  "doc_number": "ECY-303 Preloaded Apps_UG_11_EN",
  "revision_date": "2017-06 (version 1.1)",
  "url": "https://docs.distech-controls.com/api/khub/documents/VnZEPpKpBFqw7fCM8XowKw/content"
 },
 "integration": {
  "summary": "Command occupancy with MV 1 and the mode with MV 2, write the occupied setpoints AV 40 and AV 41, and read back MV 15, MV 14, AV 1 and the fan status BV 12. Watch BV 17 for the discharge low-limit alarm.",
  "minimum_points": [
   {
    "ref": "MV 1",
    "name": "OccupancyCmd",
    "why": "Occupancy command from the BMS"
   },
   {
    "ref": "MV 2",
    "name": "HvacModeCmd",
    "why": "HVAC mode command"
   },
   {
    "ref": "MV 3",
    "name": "FanModeCmd",
    "why": "Fan mode (on when occupied, or auto)"
   },
   {
    "ref": "AV 40",
    "name": "OccCoolSp",
    "why": "Occupied cooling setpoint"
   },
   {
    "ref": "AV 41",
    "name": "OccHeatSp",
    "why": "Occupied heating setpoint"
   },
   {
    "ref": "MV 15",
    "name": "OccupancyStatus",
    "why": "Effective occupancy state"
   },
   {
    "ref": "MV 14",
    "name": "HvacModeStatus",
    "why": "Actual HVAC mode"
   },
   {
    "ref": "AV 1",
    "name": "SpaceTemp",
    "why": "Space temperature used for control"
   },
   {
    "ref": "BV 12",
    "name": "FanStatus",
    "why": "Supply fan status"
   },
   {
    "ref": "BV 17",
    "name": "LowLimitAlarm",
    "why": "Discharge air low-limit alarm"
   }
  ],
  "enable": "MV 1 OccupancyCmd takes occupancy from the BMS and is combined with local occupancy detection into MV 15 OccupancyStatus. MV 2 HvacModeCmd forces the mode when it is not Auto.",
  "heartbeat": null,
  "remote_sensors": "The guide says the measured values can be overridden through the BACnet priority array for testing.",
  "setup": [
   "The configuration pages are reached through the controller's IP address or factory host name."
  ],
  "gotchas": [
   "Units in this edition are imperial (°F); use the SI edition for metric sites.",
   "Configuration objects (input types, output assignment) are commissioning settings; don't write them cyclically."
  ]
 },
