  "setup": [
   "MS/TP MAC by DIP switch; default MAC range 1-30, Max Master 35.",
   "Device instance defaults to the MAC address; set a unique instance after discovery.",
   "Auto baud for the first 4 minutes after power-up (9600-115200); falls back to the last found rate, else 38400."
  ],
  "gotchas": [
   "Allow at least 3 minutes between two CO2 offset writes (cfgCO2SensorOffset).",
   "The out-of-range multistates (MV 1-5) are listed as R/W but report the alarm state; treat them as status."
  ]
