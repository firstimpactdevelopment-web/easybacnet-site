   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Each load device has its own object list; the CT 2 and CT 3 blocks use the reserved instances AI 60-82 and AI 90-112."
  ],
  "gotchas": [
   "Use the Large Analog Value totals where the BMS supports them; they keep resolution on big kWh counts."
  ]
 },
