 ],
 "equipment_type": "Variable frequency drive (HVAC)",
 "applies_to": "WEG CFW701 HVAC-R frequency inverters using BACnet MS/TP on the RS-485 port.",
 "summary": "The CFW701 is WEG's HVAC-R drive with BACnet MS/TP on its RS-485 port. Drive parameters map to fixed objects: AVs for readings, ramps, three PID loops and the network speed reference, BVs for the status word (P0680) and control word (P0682), plus digital and analog I/O. A mailbox (AV 100/101, BV 100/101) reads or writes any parameter by number.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "359000 + serial address (P0308) when P0760 and P0761 are 0",
 "access_inferred": false,
 "notes": [
  "Source is the Spanish edition of the BACnet manual; object names are in English, and 'Reservado' rows are reserved objects.",
  "The manual calls the object types ANI, ANO, ANV, BIN and BOUT; they are standard AI, AO, AV, BI and BO objects.",
  "AV 11 kWh Output Energy is printed with unit 'H'; it is an energy counter.",
  "PID setpoint and feedback units (AV 21, 23, 25, 27, 29, 31) are user-set; the manual shows examples (bar, °C, %) only.",
  "BI 11 is missing from the binary input table; BI 8-15 are reserved.",
  "Mailbox: write the parameter number to AV 100, then 1 to BV 100 to read it into AV 101, or set AV 101 and write 1 to BV 101."
 ],
 "source": {
  "title": "CFW701 Manual del Usuario BACnet",
  "doc_number": "10001538519 / 01",
  "revision_date": "2016-09",
  "url": "https://static.weg.net/medias/downloadcenter/h65/h01/WEG-cfw701-manual-bacnet-10001538519-es.pdf"
 },
 "integration": {
  "summary": "Set P0312 = 3 (BACnet MS/TP), the address in P0308 and the baud rate in P0310, then set P0220-P0228 so run/stop, direction and reference come from the serial port. Write BV 16 start/stop with BV 17 general enable and the speed reference to AV 17 (8192 = synchronous speed). Read BV 8, AV 3, AV 1 and BV 15, and reset faults with BV 23.",
  "minimum_points": [
   {
    "ref": "BV 16",
    "name": "Start/Stop",
    "why": "Start/stop from the BMS"
   },
   {
    "ref": "BV 17",
    "name": "General Enabling",
    "why": "General enable; must be on to run"
   },
   {
    "ref": "BV 20",
    "name": "LOC/REM",
    "why": "Remote mode when P0220 selects serial"
   },
   {
    "ref": "AV 17",
    "name": "Serial/USB Speed Ref.",
    "why": "Speed reference, 8192 = synchronous speed"
   },
   {
    "ref": "BV 23",
    "name": "Fault reset",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 8",
    "name": "Ramp Enabled (RUN)",
    "why": "Running status"
   },
   {
    "ref": "AV 3",
    "name": "Motor Frequency",
    "why": "Output frequency in Hz"
   },
   {
    "ref": "AV 1",
    "name": "Motor Current",
    "why": "Motor amps"
   },
   {
    "ref": "BV 15",
    "name": "Fault condition",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 13",
    "name": "Present Fault",
    "why": "Active fault number"
   }
  ],
  "enable": "The drive only obeys the network when P0220-P0228 select a serial option for local/remote, reference, direction and run/stop. It needs both BV 17 General Enabling and BV 16 Start/Stop; BV 20 LOC/REM switches to remote when P0220 takes local/remote from the serial control word.",
  "heartbeat": "P0314 Serial Watchdog (0.0-999.0 s, 0 = off, factory 0.0): if no valid telegram arrives within that time the drive shows alarm A128 (or fault F228) and runs the P0313 action: 0 none, 1 ramp stop (factory), 2 general disable, 3 go to local, 4 local keeping commands, 5 fault. Timing starts at the first valid telegram after power-up.",
  "remote_sensors": "The BMS can write the main PID automatic setpoint (AV 21) and the external PID 1 and 2 setpoints (AV 25, AV 29) when the drive's PID loops are used; their units follow the drive's PID setup.",
  "setup": [
   "P0312 = 3 (BACnet MS/TP); P0308 MS/TP address 0-254 (factory 1); reinitialize after changing the address.",
   "P0310 baud 9600, 19200 (factory), 38400 or 57600; P0311 must be 0 (8 bits, no parity, 1 stop).",
   "Device instance: P0760 x 10000 + P0761; with both at 0 the drive uses 359000 + P0308 (WEG vendor ID 359).",
   "P0762 max master, P0763 max info frames, P0764 I-Am at power-up or continuously."
  ],
  "gotchas": [
   "Speed reference AV 17 is a 13-bit value, not Hz or %: 8192 = motor synchronous speed; negative values reverse.",
   "Ramp times AV 14/15 and the mailbox write change drive parameters; don't write them cyclically.",
   "P0313 = 0 keeps the drive running at the last command after a comm loss.",
   "PID units are user-defined; set them in the drive and the BMS to match."
  ]
 },
