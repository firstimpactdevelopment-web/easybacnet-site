 "equipment_type": "Variable frequency drive",
 "applies_to": "WEG CFW300 micro frequency inverters using BACnet MS/TP on the RS-485 port (plug-in communication module).",
 "summary": "The CFW300 runs BACnet MS/TP on its RS-485 port and maps drive parameters to fixed objects: AVs for speed, current, voltage, frequency, torque, heatsink temperature, alarm/fault numbers, ramps and the network speed reference; BVs for the status word (P0680) and control word (P0682); plus digital inputs DI1-DI8, digital outputs DO1-DO4 and two analog outputs. A mailbox (AV 100/101, BV 100/101) reads or writes any parameter by number.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "359000 + serial address (P0308) when P0760 and P0761 are 0",
 "access_inferred": false,
 "notes": [
  "Reserved status-word bits are listed as printed (no state or access given).",
  "BI 0-7 are DI1-DI8 and BO 0-3 are DO1-DO4, as printed.",
  "AV 11 Speed in 13 bits and AV 12 Serial/USB Speed Ref. use a 13-bit scale: 8192 = motor rated frequency.",
  "Mailbox: write the parameter number to AV 100, then 1 to BV 100 to read it into AV 101, or set AV 101 and write 1 to BV 101."
 ],
 "integration": {
  "summary": "Set P0312 = 3 (BACnet MS/TP), the address in P0308 and the baud rate in P0310, then set P0220-P0228 so run/stop, direction and reference come from the serial port. Write BV 16 ramp enable (run/stop) with BV 17 general enable and the speed reference to AV 12 (8192 = rated frequency). Read BV 8, AV 3, AV 1 and BV 15, and reset faults with BV 23.",
  "minimum_points": [
   {
    "ref": "BV 16",
    "name": "Ramp Enable",
    "why": "Start/stop from the BMS (1 = run)"
   },
   {
    "ref": "BV 17",
    "name": "General Enable",
    "why": "General enable; must be on to run"
   },
   {
    "ref": "BV 20",
    "name": "Remote",
    "why": "Remote mode when P0220 selects serial"
   },
   {
    "ref": "AV 12",
    "name": "Serial/USB Speed Ref.",
    "why": "Speed reference, 8192 = rated frequency"
   },
   {
    "ref": "BV 23",
    "name": "Fault Reset",
    "why": "Reset a tripped drive"
   },
   {
    "ref": "BV 8",
    "name": "Running",
    "why": "Running status"
   },
   {
    "ref": "AV 3",
    "name": "Motor Frequency",
    "why": "Output frequency in Hz"
   },
   {
    "ref": "AV 1",
    "name": "Motor Current",
    "why": "Motor amps"
   },
   {
    "ref": "BV 15",
    "name": "Fault",
    "why": "Any active drive fault"
   },
   {
    "ref": "AV 8",
    "name": "Present Fault",
    "why": "Active fault number"
   }
  ],
  "enable": "The drive only obeys the network when P0220-P0228 select the serial option for local/remote, reference, direction and run/stop. It needs both BV 17 General Enable and BV 16 Ramp Enable; BV 20 Remote switches to remote when P0220 takes local/remote from the serial control word.",
  "heartbeat": "P0314 Serial Watchdog (0.0-999.0 s, 0 = off, factory 0.0): if no valid telegram arrives within that time the drive shows alarm A128 (or fault F228) and runs the P0313 action: 0 none, 1 ramp stop (factory), 2 general disable, 3 go to local, 4 local keeping commands, 5 fault. Timing starts at the first valid telegram after power-up.",
  "remote_sensors": null,
  "setup": [
   "P0312 = 3 (BACnet MS/TP); P0308 MS/TP address 0-254.",
   "P0310 baud 9600, 19200, 38400, 57600 or 76800; P0311 must be 0 (8 bits, no parity, 1 stop).",
   "Device instance: P0760 x 10000 + P0761; with both at 0 the drive uses 359000 + P0308 (WEG vendor ID 359).",
   "P0762 max master (factory 127), P0763 max info frames, P0764 I-Am at power-up (factory) or continuously."
  ],
  "gotchas": [
   "Speed reference AV 12 is a 13-bit value, not Hz or %: 8192 = motor rated frequency; negative values reverse.",
   "Ramp times AV 9/10 and the mailbox write change drive parameters; don't write them cyclically.",
   "P0313 = 0 keeps the drive running at the last command after a comm loss.",
   "P0311 factory value is 1 (even parity); BACnet needs 0."
  ]
 },
 "source": {
