 ],
 "equipment_type": "Power and energy meter (BACnet MS/TP)",
 "applies_to": "Leviton VerifEye Series 4100 bi-directional compact three-phase meters with BACnet MS/TP: 4DUBM (DIN meter) and 41OUB (outdoor NEMA 4X kit).",
 "summary": "The Series 4100 is a compact DIN-rail three-phase meter that measures power and energy in both directions (import and export), for example on sites with solar. Over BACnet MS/TP it serves 83 Analog Inputs for net, import and export energy (total and per phase, real, reactive by quadrant and apparent), power, power factor, voltage, current, frequency and demand, 11 writable Analog Values for setup and commands, and 15 Binary Input alerts.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "Application S4100-C",
 "default_device_instance": "Pseudo-random, 1,000,000-3,097,151",
 "access_inferred": false,
 "notes": [
  "AI4-AI10 report kWh in their Units property because BACnet has no kVARh/kVAh unit; the real unit is shown here.",
  "Accumulated values (AI1-AI10, AI22-AI27, AI31-AI54, AI76-AI78) are kept through power loss.",
  "BI4-BI6 are all printed with the name 'Current_Error_A'; they are phases A, B and C.",
  "Writes to AVs take up to about 2 s to store; check Reliability before reading back.",
  "The meter also has three Trend Log objects (TL1-TL3); this guide doesn't list their names, so they are not included.",
  "AI28, AI30, AI77, AI79, AI80 and BI8 are reserved."
 ],
 "integration": {
  "summary": "Set the MAC address and baud at the meter display, write AV2 System_Type, AV3/AV4 CT settings, AV5 PT ratio and AV6 system voltage, then read net and import/export energy, total power, demand and voltage/current. Read AI83 Alarm_Bitmap (or the BIs) for alerts.",
  "minimum_points": [
   {
    "ref": "AI 1",
    "name": "KWh_Net",
    "why": "Net energy (import minus export), kWh"
   },
   {
    "ref": "AI 2",
    "name": "KWh_Import",
    "why": "Imported energy, kWh"
   },
   {
    "ref": "AI 3",
    "name": "KWh_Export",
    "why": "Exported energy, kWh"
   },
   {
    "ref": "AI 11",
    "name": "KW_Total",
    "why": "Total real power, kW"
   },
   {
    "ref": "AI 19",
    "name": "KW_Present_Demand",
    "why": "Present real power demand, kW"
   },
   {
    "ref": "AI 14",
    "name": "PF_Total",
    "why": "Total power factor"
   },
   {
    "ref": "AI 15",
    "name": "Volts_LL_Avg",
    "why": "Average line-to-line voltage"
   },
   {
    "ref": "AI 17",
    "name": "Current Average",
    "why": "Average phase current, A"
   },
   {
    "ref": "AI 83",
    "name": "Alarm_Bitmap",
    "why": "Alert bits BI1-BI15 as one number"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "MAC address 0-127 (default 1) and baud 9600-115200 (default 76800) are set on the meter display.",
   "Device ID defaults to a pseudo-random 1,000,000-3,097,151; set it on the display or by writing Object_Identifier.",
   "Max_Master default 127.",
   "Set AV5 PT_Ratio before AV6 System_Voltage; System_Voltage must stay within 82-660 V times the PT ratio.",
   "Use 120 Ω termination at both ends of the RS-485 daisy chain."
  ],
  "gotchas": [
   "Alerts are not latched; a cleared condition disappears before it is read.",
   "Writing AV1 = 30078 clears all energy accumulators.",
   "Factory defaults can't be restored automatically; reset each setting by hand."
  ]
 },
 "source": {
  "title": "Series 4100 Bi-Directional Compact Power and Energy Meter, BACnet MS/TP Support - Installation Guide",
