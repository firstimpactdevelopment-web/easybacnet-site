 "equipment_type": "Power and energy meter (three-phase submeter)",
 "applies_to": "DENT PowerScout 3037 three-phase revenue-grade meters: PS3037-S (RS-485, BACnet MS/TP) and PS3037-E (Ethernet, BACnet IP).",
 "summary": "The PowerScout 3037 serves its data as Analog Value objects. Measurements cover system and per-phase power, energy (absolute, net, positive and negative), voltage, current, reactive and apparent power and energy, power factor, demand and frequency. Configuration AVs set CT values and types, multipliers, service type, demand window, serial settings, the pulse output and BBMD registration.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": "PICS: firmware 4.33, application 0.5.9",
 "default_device_instance": "From the address switches (PS3037-S) or the Ethernet MAC address (PS3037-E)",
 "access_inferred": true,
 "notes": [
  "The manual's object tables give the identifier, name and description only. Types are Analog Value: the manual's glossary says PowerScout measurements are Analog Values and DENT's PowerScout series PICS lists only the Device and Analog Value object types.",
  "Access is not in the table. The PICS lists Present_Value as writable for Analog Values; configuration objects (10140 and 12xxx-14xxx) are marked W here and measurements R.",
  "Object 6010 is printed twice: 'kVARh System' in the absolute table and again, signed net, in the positive table. It is listed once.",
  "BACnet IP is on the Ethernet model (PS3037-E) only.",
  "Source: PS3037 manual, 'All Things BACnet' chapter; object type from the PowerScout series PICS (August 28, 2014)."
 ],
 "source": {
  "title": "PowerScout 3037 Operator's Guide (All Things BACnet)",
  "doc_number": null,
  "revision_date": null,
  "url": "https://www.dentinstruments.com/wp-content/uploads/2022/04/PS3037_Manual.pdf"
 },
 "integration": {
  "summary": "Set the address switches (BACnet MS/TP MAC 1-127), put the meter in BACnet mode (ViewPoint, or write 1833 to Modbus register 44612), set the service type and CT values, then read system kW, kWh, demand, power factor, current, voltage and frequency.",
  "minimum_points": [
   {
    "ref": "AV 1030",
    "name": "kW System",
    "why": "Total real power, kW"
   },
   {
    "ref": "AV 2000",
    "name": "kWh System Total",
    "why": "Total real energy, kWh"
   },
   {
