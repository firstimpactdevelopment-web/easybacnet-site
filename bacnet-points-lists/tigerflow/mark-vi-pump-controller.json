 },
 "integration": {
  "summary": "Write BV 41 to disable or release the system and the zone differential pressure setpoints AV 41-43 if the BMS owns the setpoint. Read zone pressures, flow, pump run and fault flags and the general alarm.",
  "minimum_points": [
   {
    "ref": "BV 41",
    "name": "Remote System Disable - BAS Signal",
    "why": "System disable from the BMS"
   },
   {
    "ref": "AV 41",
    "name": "Remote BAS Zone 1 Setpoint",
    "why": "Zone 1 differential pressure setpoint, psi"
   },
   {
    "ref": "AV 60",
    "name": "Zone 1 Differential Pressure",
    "why": "Zone 1 differential pressure, psi"
   },
   {
    "ref": "AV 64",
    "name": "Flow Rate",
    "why": "System flow, gpm"
   },
   {
    "ref": "BV 21",
    "name": "Pump 1 Run Command",
    "why": "Pump 1 called to run (repeat for pumps 2-3)"
   },
   {
    "ref": "AV 65",
    "name": "Pump 1 Speed Signal (%)",
    "why": "Pump 1 speed signal, % (repeat for pumps 2-3)"
   },
   {
    "ref": "BV 71",
    "name": "Pump 1 Fault",
    "why": "Pump 1 fault (repeat for pumps 2-3)"
   },
   {
    "ref": "BV 86",
    "name": "General/Fatal Alarm",
    "why": "Any general or fatal alarm"
   }
  ],
  "enable": "BV 41 Remote System Disable - BAS Signal is the only writable binary; the list gives 1 = ON but does not say how it combines with the hard-wired disable input.",
  "remote_sensors": "AV 41-43 accept zone differential pressure setpoints from the BAS; the list does not say how the controller chooses between local and BAS setpoints.",
  "gotchas": [
   "The list does not describe BAS-setpoint selection or comm-loss behaviour; confirm on site before relying on AV 41-43."
  ],
  "heartbeat": null,
  "setup": []
 },
