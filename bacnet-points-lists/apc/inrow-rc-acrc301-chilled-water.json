 "equipment_type": "In-row precision cooling unit (chilled water computer room air handler)",
 "applies_to": "APC / Schneider Electric InRow RC 300 mm chilled water in-row coolers ACRC301S and ACRC301H with application firmware v6.0.0 or later.",
 "summary": "The InRow RC 300 mm chilled water units serve BACnet IP from their network management card. The map has Multi-state Values for on/standby, operating mode, airflow and delta-T setpoint selections and configuration, Binary Values for each alarm (active = alarm), Analog Values for temperatures, flows, demand, power, energy and run hours, and Character String Values for identity.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Application firmware v6.0.0 or later (v2.4.2.1 and later support BACnet IP only)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "The page titled 'Analog Value Objects' actually lists the Multi-state Values (its object IDs are type 19); they are listed here as MV.",
  "The Analog Value table page is blank in this release (07/2023). The AV names and instances come from the document's index (BACnet Name, Object Type, BACnet Index); units and read/write access are not printed for them, so they are shown as read-only.",
  "MV 32 Circulation Pump Model is printed between MV 9 and MV 10 in the table; it is listed here in instance order.",
  "Alarm Binary Values are named by alarm code (BN3902 and so on); the description holds the printed alarm text.",
  "The ID column is the full object identifier (type x 4194304 + instance) and agrees with the Index column for every row."
 ],
 "source": {
  "title": "BACnet Application Map - InRow RC Chilled Water Air Conditioners, 300 mm",
  "doc_number": "TME27091",
  "revision_date": "2023-07",
  "url": "https://download.se.com/files?p_Doc_Ref=TME27091"
 },
 "integration": {
  "summary": "Enable BACnet on the unit's Network Management Card 2 (see the NMC 2 user guide) and give it a unique device instance. Use MV 0 On or Standby to start and stop the unit and read MV 2 Operating Mode for its state. Map supply and return air temperatures, cool output, fan speed and the alarm Binary Values for monitoring; MV 25 clears active alarms.",
  "minimum_points": [
   {
    "ref": "MV 0",
    "name": "On or Standby",
    "why": "Unit on/standby command (1=Standby, 2=On)"
   },
   {
    "ref": "MV 25",
    "name": "Clear Active Alarms",
    "why": "Write 2=Yes to clear active alarms"
   },
   {
    "ref": "MV 2",
    "name": "Operating Mode",
    "why": "Standby, on, idle or maintenance"
   },
   {
    "ref": "AV 10",
    "name": "Supply Air Temperature",
    "why": "Air leaving the unit"
   },
   {
    "ref": "AV 11",
    "name": "Return Air Temperature",
    "why": "Air entering the unit"
   },
   {
    "ref": "AV 53",
    "name": "Supply Air Setpoint",
    "why": "Supply air temperature setpoint"
   },
   {
    "ref": "AV 26",
    "name": "Cool Output",
    "why": "Cooling delivered by the unit"
   },
   {
    "ref": "AV 28",
    "name": "Fan Speed",
    "why": "Current fan speed"
   },
   {
    "ref": "BV 2",
    "name": "BN3906",
    "why": "Cool Fail alarm"
   },
   {
    "ref": "BV 22",
    "name": "BN392E",
    "why": "Water Detected Fault alarm"
   }
  ],
  "enable": "MV 0 On or Standby (writable) switches the unit between standby and on.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP only (application firmware v2.4.2.1 and later).",
   "The map refers to the Network Management Card 2 User Guide for configuring BACnet.",
   "The map lists one Notification Class object, NC 0 DefaultNotifier."
  ],
  "gotchas": [
   "The map does not print access or units for the Analog Values; check on the unit before writing setpoints such as AV 53 or AV 52.",
   "Many Multi-state Values are configuration settings (power source, filter type, configuration type); do not write them cyclically."
  ]
 },
