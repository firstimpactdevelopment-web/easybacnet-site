 "equipment_type": "Burner management / boiler control",
 "applies_to": "Fireye Nexus NX6100 and PPC6000 integrated burner/boiler controls connected through an NXTSD104 or NX6330 touchscreen (firmware 2.200 or later), including twin-burner and 62xx expansion units.",
 "summary": "The NXTSD104/NX6330 touchscreen acts as a BACnet IP router for the Fireye 6000-series burner control. A Who-Is finds three devices: the router device (the main or left-hand burner control) and devices +1 (right-hand burner on twin-fired boilers) and +2 (62xx water-level expansion unit) on virtual network 2709. Each device has the same object set: 60 read-only AVs of main values, 16 selectable AIs, override AOs and BOs.",
 "bacnet_transport": [
  "BACnet IP"
 ],
 "firmware": "Touchscreen 2.200 or later",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "AV rows printed as Spare or \"Do not use\" (AV 10-11, 24-26, 28-29, 33-34, 41-49, 55-59) are left out; not every listed value exists on every system configuration.",
  "The 16 analog inputs (AI 0-15) have no fixed meaning: write proprietary property 9999 with an engineer's-key (EK) number to choose what each one reads. They are not listed.",
  "AO 7-15, BO 9-10 and BO 15 are reserved. AOs and BOs start Out_Of_Service; clear that flag before writing. They use a priority array, and the control must be in AUTO and REMOTE for overrides to act.",
  "The same objects repeat on device instance +1 (right-hand burner) and +2 (expansion unit); those devices are present even when nothing is connected.",
  "BACnet must be enabled and the device instance set on the touchscreen (Configuration - Ethernet); changes reboot the touchscreen. Version 1 touchscreens cannot be updated to BACnet IP."
 ],
 "source": {
  "title": "MOD-6001 Nexus NX6100 / PPC6000 Modbus and BACnet Communications (chapter 6 BACNET/IP interface)",
  "doc_number": "MOD-6001",
  "revision_date": "2018-09-24",
  "url": "https://www.fireye.com/wp-content/uploads/sites/10/2025/04/MOD-6001-Nexus_NX6100_PPC6000_Modbus_BACnet_Communications_English_2018-09-24.pdf"
 },
 "integration": {
  "summary": "Enable BACnet and set the device instance on the touchscreen, discover the router device, then read the AVs (status, setpoint, measured value, fault number, flame signal). To control, clear Out_Of_Service on the AO/BO you need and write it; Burner ON/OFF (BO 7) and Setpoint 1 Control Value (AO 0) are the usual commands.",
  "minimum_points": [
   {
    "ref": "BO 7",
    "name": "Burner ON/OFF",
    "why": "Write 0 to hold the burner off"
   },
   {
    "ref": "BO 1",
    "name": "Release to Ignite",
    "why": "Must be 1 to allow ignition (if used)"
   },
   {
    "ref": "AO 0",
    "name": "Setpoint 1 Control Value",
    "why": "Setpoint 1 override"
   },
   {
    "ref": "BO 4",
    "name": "Mute / Reset",
    "why": "Fault reset: 1 for ~5 s, then 0"
   },
   {
    "ref": "AV 19",
    "name": "Burner Status",
    "why": "Burner status"
   },
   {
    "ref": "AV 12",
    "name": "Measured Value",
    "why": "Measured pressure/temperature"
   },
   {
    "ref": "AV 21",
    "name": "Setpoint",
    "why": "Setpoint in use"
   },
   {
    "ref": "AV 30",
    "name": "Modulation Rate",
    "why": "Firing rate"
   },
   {
    "ref": "AV 37",
    "name": "Flame Signal",
    "why": "Flame signal"
   },
   {
    "ref": "AV 23",
    "name": "Fault Number",
    "why": "Active fault number"
   }
  ],
  "enable": "AOs and BOs are Out_Of_Service by default; clear the flag, then writes override the control as long as it is in AUTO and REMOTE. BO 1 Release to Ignite, if used, must be 1 for the burner to light.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet IP on the NXTSD104/NX6330 touchscreen, firmware 2.200+; enable it and set the device instance on the Ethernet tab (reboot follows).",
   "Devices: router = instance N (main/LHS burner), N+1 = RHS burner, N+2 = expansion unit, on virtual network 2709."
  ],
  "gotchas": [
   "Do not pulse BO 4 Mute / Reset when there is no alarm: repeated resets cause an F36 lockout that cannot be reset remotely.",
   "Do not write BO 0 Setpoint Select when the built-in boiler sequencing is used.",
   "Selectable AIs may read 0 or stale data right after property 9999 is changed."
  ]
 },
