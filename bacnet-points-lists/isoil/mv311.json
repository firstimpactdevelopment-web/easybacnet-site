  "unofficial": true,
  "host": "BACnet International"
 },
 "integration": {
  "summary": "Read the heating and cooling energy totals, thermal power, flow and the two temperatures, plus the global alarm. Writing is only needed to reset the partial counters or to select heating/cooling if the meter is set for remote plant-type control.",
