 "integration": {
  "summary": "The BAS can run this heat pump in two ways: command occupancy (MO1) and let the FX10 hold its occupied/unoccupied setpoints, or act as the thermostat and send fan, Y1, Y2 and O calls (MO2-MO5). Space temperature and humidity can be overridden on AO2 and AO3, and MO6 forces an emergency shutdown. Keep frequent writes on the volatile AO/MO points, not the flash-backed AV/MV setpoints.",
  "minimum_points": [
   {
    "ref": "MO 1",
    "name": "Occupancy Command",
    "why": "Occupied/unoccupied/bypass/standby command"
   },
   {
    "ref": "MO 6",
    "name": "Emergency Override",
    "why": "Network emergency shutdown (1 = shutdown)"
   },
   {
    "ref": "AV 1",
    "name": "Occupied Cool",
    "why": "Occupied cooling setpoint (flash; write rarely)"
   },
   {
    "ref": "AV 2",
    "name": "Occupied Heat",
    "why": "Occupied heating setpoint (flash; write rarely)"
   },
   {
    "ref": "AV 5",
    "name": "Dehum Setpt",
    "why": "Dehumidification setpoint for reheat (flash)"
   },
   {
    "ref": "MO 7",
    "name": "Alarm Reset",
    "why": "Reset manual-reset alarms"
   },
   {
    "ref": "MI 2",
    "name": "Mode",
    "why": "Current unit mode (auto, heat, cool, shutdown...)"
   },
   {
    "ref": "MI 5",
    "name": "Comp1 Cmd Status",
    "why": "Compressor 1 commanded on/off"
   },
   {
    "ref": "AI 1",
    "name": "Space Temp",
    "why": "Space sensor temperature (terminals RS/AIC)"
   },
   {
    "ref": "AI 8",
    "name": "Alarms Enumerated",
    "why": "Active alarm code"
   }
  ],
  "enable": "The sheet has no separate BAS-enable point. MO6 Emergency Override puts the unit in shutdown (1) or back to auto (2). MO2-MO5 let the BAS send fan, compressor and reversing-valve calls directly.",
  "heartbeat": null,
  "remote_sensors": "AO2 Space Temp Ovrd and AO3 Space RH Ovrd replace the space temperature and humidity readings from the network. MO14 DHStat Cmd drives the dehumidistat input. All are volatile outputs and revert to uncommanded after a power cycle.",
  "setup": [],
  "gotchas": [
   "AV/MV points are stored in flash (about 2,000,000 writes); write them only manually or by schedule, never from automatic reset logic.",
   "Output points (AO/MO) are volatile and go back to uncommanded after a power cycle, so rewrite them after power returns.",
   "If the BAS shows 254 as uncommanded instead of 255, every multistate value is one lower.",
   "Alarm Reset needs a write of 2 followed by 1."
  ]
 },
