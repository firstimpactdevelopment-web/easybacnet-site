 "integration": {
  "summary": "Enable the unit with BV 1 Unit_Enable and write the space-mode discharge air setpoints. Where the unit is set for BMS source, the BMS also writes supply fan speed (AV 32) and damper position (AV 16). Read discharge air temperature, supply fan status, mode flags and the general alarm.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "Unit_Enable",
    "why": "Unit enable command"
   },
   {
    "ref": "AV 7",
    "name": "DA_SpcClg_SP",
    "why": "Discharge air setpoint in space cooling"
   },
   {
    "ref": "AV 8",
    "name": "DA_SpcHtg_SP",
    "why": "Discharge air setpoint in space heating"
   },
   {
    "ref": "AV 32",
    "name": "SF_BMS",
    "why": "Supply fan speed, % (BMS source units)"
   },
   {
    "ref": "AV 16",
    "name": "Damper_BMS",
    "why": "Damper position, % (BMS source units)"
   },
   {
    "ref": "BV 35",
    "name": "SF_Sts",
    "why": "Supply fan proven on"
   },
   {
    "ref": "AV 9",
    "name": "DA_Temp",
    "why": "Discharge air temperature"
   },
   {
    "ref": "AV 1004",
    "name": "Spc_CO2",
    "why": "Space CO2, ppm"
   },
   {
    "ref": "BV 2",
    "name": "Alm_Rly_Cmd",
    "why": "Unit general alarm"
   },
   {
    "ref": "BV 33",
    "name": "Safety_Sts",
    "why": "Safety input (1 = alarm)"
   }
  ],
  "enable": "BV 1 Unit_Enable sets the unit enabled and available for operation. Heating, cooling and fan calls come from the external Y1/W1/G inputs (BV 10-13 show them). Supply fan speed and damper position follow AV 32 SF_BMS and AV 16 Damper_BMS only when the unit is configured for BMS source.",
  "heartbeat": null,
  "remote_sensors": "Set BV 29 OA_Temp_Sel and BV 28 OA_Hum_Sel to BMS (1), then write AV 24 OA_Temp_BMS and AV 22 OA_Hum_BMS.",
  "setup": [
   "BMS Config menu (Service > h): Protocol BACnet MSTP (or BACnet IP/Eth); Instance default 77000, Baudrate 9600/19200/38400/76800 (default 38400), MAC address 0-127.",
   "Set Termconf PlugIn to Yes, then on screen E.h.7 set Function to Write and Update to Yes to save; power cycle the controller afterwards.",
   "BACnet MS/TP needs the optional BMS communication card (option BHB8)."
  ],
  "gotchas": [
   "The pressure objects in the integer block (AV 1001-1003 and AV 1006) are scaled: divide by 1000 for in. WC.",
   "Outdoor temperature and humidity from the BMS are used only when OA_Temp_Sel / OA_Hum_Sel are set to BMS."
  ]
 },
