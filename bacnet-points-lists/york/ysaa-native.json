    "ref": "BV 1",
    "name": "START_STOP",
    "why": "Remote start/stop (1 = run)"
   },
   {
    "ref": "AV 1",
    "name": "REM_SETP",
    "why": "Remote leaving chilled liquid setpoint"
   },
   {
    "ref": "AI 21",
    "name": "S1_OP_CODE",
    "why": "Sys 1 operational code"
   },
   {
    "ref": "BI 6",
    "name": "S1_C_RUN",
    "why": "Sys 1 compressor running"
   },
   {
    "ref": "BI 10",
    "name": "S2_C_RUN",
    "why": "Sys 2 compressor running"
   },
   {
    "ref": "BI 16",
    "name": "CNTL_MODE",
    "why": "Local/remote control mode (1 = Auto)"
   },
   {
    "ref": "AI 1",
    "name": "LCHLT",
    "why": "Leaving chilled liquid temperature"
   },
   {
    "ref": "BI 1",
    "name": "S1_ALARM",
    "why": "System 1 alarm"
   },
   {
    "ref": "BI 2",
    "name": "S2_ALARM",
    "why": "System 2 alarm"
   }
  ],
  "enable": "BI 16 shows the local/remote control mode (0 = Manual, 1 = Auto). The sheet gives no point to change it and no write-enable point.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP, Modbus RTU and N2 are native on the board; a gateway is only needed for Connected Services.",
   "The sheet gives no default MAC address, baud rate or device instance."
  ],
  "gotchas": [
   "Most data are AI/BI objects, not AV/BV; only AV 1 and BV 1 are writable.",
   "Fault codes are per system (AI 22, AI 24); there is no single unit fault code, so alarm on BI 1 and BI 2."
  ]
 },
