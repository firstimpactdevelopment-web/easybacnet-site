 "equipment_type": "Rooftop unit controller",
 "applies_to": "YORK Millennium (Series 40) 25, 30 and 40 ton packaged rooftop units with the IPU control, constant volume, VAV and FlexSys versions.",
 "summary": "The IPU controller in YORK Millennium / Series 40 25-40 ton rooftop units serves BACnet MS/TP (BACnet IP through an optional FieldServer gateway) and Modbus. The BAS can command occupancy, unit stop, fan, ventilation, heating and the Y1/Y2/W1/W2 calls, and write zone, supply air, duct static, building pressure and economizer setpoints and a BAS zone temperature. Read-only points cover temperatures, humidity, CO2, static pressures, damper and VFD outputs, compressor and heat stage status, run hours, faults and the unit mode.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": "23000 + MAC address",
 "access_inferred": false,
 "notes": [
  "Access is from the READ/WRITE column; descriptions are the user interface names from the table. Points marked FlexSys, VAV or CV only exist on those units.",
  "Rows the table marks \"this feature is not available on this unit\" (43 objects, for example 3rd-stage compressors, condenser fans and suction sensors) are left out.",
  "Fifteen on/off BAS commands (comfort and continuous ventilation, fan G, heating enable and valve action, morning warm-up, smoke purge 1-3, ventilation control, W1/W2 and Y1/Y2 calls) are printed as AV(BV) nn; they are listed here as AV nn.",
  "The smoke purge BAS commands (AV 90-92) are described as 0 = off, 1 = off in the table; the state text is left blank.",
  "The Series 40 IOM (LD14136) prints the same table; both documents point to this list.",
  "Same IPU object map as the Series 100 YPAL lists in this library: every instance here also appears there, but this table drops the objects not available on 25-40 ton units and spells some names differently (for example C02_INSIDE, ZONE_TMP_BAS)."
 ],
 "source": {
  "title": "Millenium Packaged Rooftop Units 25-40 Tons with IPU Control - Installation, Operation and Maintenance (Table 6-12, BACnet MS/TP, Modbus, BACnet IP)",
  "doc_number": "Form 100.50-NOM8 (409)",
  "revision_date": "2009-04",
  "url": "https://docs.johnsoncontrols.com/ductedsystems/api/khub/documents/jHl7DLBfzBwL8EpKbeMhag/content"
 },
 "integration": {
  "summary": "Set the MAC address on the IPU (the device instance follows as 23000 + MAC), then command occupancy (AV 88) and write the zone or supply air setpoints. Use UNIT_STOP (AV 93) for a BAS shutdown, and read supply fan status, supply and zone temperatures, the unit mode and the fault flags.",
  "minimum_points": [
   {
    "ref": "AV 88",
    "name": "OCCUPNCY_CMD",
    "why": "Occupancy command (1 = occupied)"
   },
   {
    "ref": "AV 93",
    "name": "UNIT_STOP",
    "why": "Unit stop (1 = stopped, 0 = normal)"
   },
   {
    "ref": "AV 21",
    "name": "OCC_ZN_COOL",
    "why": "Occupied zone cooling setpoint"
   },
   {
    "ref": "AV 22",
    "name": "OCC_ZN_HEAT",
    "why": "Occupied zone heating setpoint"
   },
   {
    "ref": "AI 58",
    "name": "UNIT_MODE",
    "why": "Unit mode index"
   },
   {
    "ref": "BI 59",
    "name": "SUPPLY_FAN",
    "why": "Supply fan on/off"
   },
   {
    "ref": "AI 46",
    "name": "SUP_AIR_TEMP",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 60",
    "name": "ZONE_TEMP",
    "why": "Zone temperature"
   },
   {
    "ref": "BI 2",
    "name": "COL_HEAT_FLT",
    "why": "Cooling/heating fault (1 = faulted)"
   },
   {
    "ref": "BI 54",
    "name": "SEN_MSC_FLT",
    "why": "Sensor/misc fault (1 = fault)"
   }
  ],
  "enable": "OCCUPNCY_CMD (AV 88) sets occupied/unoccupied from the BAS and UNIT_STOP (AV 93) shuts the unit down (0 = normal, 1 = stopped). OCC_MODE (BI 35) shows the resulting occupancy.",
  "heartbeat": null,
  "remote_sensors": "ZONE_TMP_BAS (AV 40) takes the zone temperature from the BAS when the control method is set to Comm Zone Temp. CO2 inside (AV 43), under-floor temperature and humidity (AV 36/37) and the duct static and supply air resets (AV 5, AV 28) are also BAS inputs; several must be enabled with the Service key first.",
  "setup": [
   "The default device instance is 23000 plus the MAC address (MAC 10 gives 23010); a DE modifier address and offset can set another instance.",
   "The MAC address is set with the IPU MAC switches or the P1 Manual MAC Address parameter (0-127); P1 baud rate 1200 to 76800.",
   "BACnet IP needs the FieldServer FS-B2010-02-01Y gateway."
  ],
  "gotchas": [
   "BAS-enabled inputs such as CO2 inside and under-floor values only take effect after they are enabled with the Service key.",
   "HEAT_ENABLE (AV 83) is inverted: 0 = enabled, 1 = disabled."
  ]
 },
