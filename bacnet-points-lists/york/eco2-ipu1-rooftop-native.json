 ],
 "equipment_type": "Packaged rooftop unit controller (ECO2, 50-130 ton)",
 "applies_to": "YORK ECO2 Mod D and Mod E packaged rooftop units, 50 to 130 tons, with the IPU 1 microboard.",
 "summary": "The ECO2 controller's IPU 1 microboard speaks BACnet MS/TP and Modbus RTU natively (LON and N2 need an E-Link gateway). The list has read-only analog inputs for air temperatures, static and building pressures, airflows, CO2, refrigerant pressures and the unit mode; binary inputs for compressors, fans, heat stages and faults; and writable analog values for setpoints, limits, BAS reset and sensor inputs, occupancy, unit stop and enable commands.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access comes from the sheet's Read/Write column. Binary commands (occupancy, unit stop, morning warm-up and so on) are analog values that take 0 or 1.",
  "Availability is Standard or Optional (see the sales order); optional points only report when the option is fitted.",
  "BACnet values are always in imperial units, whatever the ECO2 display is set to.",
  "Rows with no BACnet object (gas heat stages, gas furnace names that share the electric heat BIs, OAT/RAT setpoints for high/low SAT, fan speed setpoints for high/low SAT) are left out; BI 26-32 carry the electric heat or gas furnace stage outputs.",
  "The AV 35 System Stop comment is cut off in the sheet after 0 = all compressors OK to run; the other values stop compressor systems. The AI 15 condenser fan speed units are printed as hrs.",
  "The Johnson Controls document portal files this sheet as Series 100 IPU 1 Native BACnet and Modbus."
 ],
 "source": {
  "title": "ECO 2 Mod-D,E 50-130 Ton Rooftop Native BACnet & Modbus Object Listings (Microboard IPU 1)",
  "doc_number": null,
  "revision_date": "ver J.02",
  "url": "https://docs.johnsoncontrols.com/chillers/api/khub/documents/q6LHnNOzMSDLOmZUbI44Ug/content"
 },
 "integration": {
  "summary": "Connect to the IPU 1 board on BACnet MS/TP (default 38.4K baud). Command occupancy with AV 88, stop or release the unit with AV 93 and write the occupied zone setpoints; feed zone temperature through AV 40 if the control method is set to comm zone temp. Read supply and return air temperatures, the supply fan status, unit mode and the fault inputs.",
  "minimum_points": [
   {
    "ref": "AV 88",
    "name": "OCCUPNCY_CMD",
    "why": "Occupancy command (1 = occupied)"
   },
   {
    "ref": "AV 93",
    "name": "UNIT_STOP",
    "why": "Unit stop (1 = stopped, 0 = normal)"
   },
   {
    "ref": "AV 21",
    "name": "OCC_ZN_COOL",
    "why": "Occupied zone cooling setpoint"
   },
   {
    "ref": "AV 22",
    "name": "OCC_ZN_HEAT",
    "why": "Occupied zone heating setpoint"
   },
   {
    "ref": "AI 58",
    "name": "UNIT_MODE",
    "why": "Unit mode index, 0-20"
   },
   {
    "ref": "BI 59",
    "name": "SUPPLY_FAN",
    "why": "Supply fan on/off"
   },
   {
    "ref": "AI 46",
    "name": "SUP_AIR_TEMP",
    "why": "Supply air temperature"
   },
   {
    "ref": "AI 60",
    "name": "ZONE_TEMP",
    "why": "Zone temperature"
   },
   {
    "ref": "BI 2",
    "name": "COL/HEAT_FLT",
    "why": "Cooling/heating fault (1 = faulted)"
   },
   {
    "ref": "BI 54",
    "name": "SEN/MSC_FLT",
    "why": "Sensor/misc fault (1 = fault)"
   }
  ],
  "enable": "AV 88 is the occupancy command (0 = unoccupied, 1 = occupied) and AV 93 the unit stop (0 = normal operation, 1 = stopped). BAS reset and BAS sensor inputs (AV 5, AV 28, AV 36, AV 37) must first be enabled at the unit with the service key; AV 40 zone temperature needs the control method set to comm zone temp.",
  "heartbeat": null,
  "remote_sensors": "AV 40 ZONE_TMP_BAS feeds zone temperature when the control method is set to comm zone temp. AV 36 and AV 37 feed under-floor humidity and temperature, and AV 5 and AV 28 give BAS duct static and supply air reset; these need enabling with the service key.",
  "setup": [
   "BACnet MS/TP default baud rate is 38.4K. Modbus RTU defaults to 9600 and can be set to 19.2K, 38.4K or 57.6K at the keypad.",
   "LON and N2 need an E-Link gateway; BACnet MS/TP and Modbus RTU are native on the IPU 1.",
   "See the ECO2 installation and operation manual (form 100.50-NOM3) for setup details."
  ],
  "gotchas": [
   "Binary commands are AVs that take 0 or 1, not BVs.",
   "Optional points report only when the option is fitted (see the sales order)."
  ]
 },
