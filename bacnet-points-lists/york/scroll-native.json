 "equipment_type": "Scroll chiller / heat pump / condensing unit",
 "applies_to": "YORK by Johnson Controls scroll-compressor chillers, heat pumps and condensing units (including YCWL and YLAE) with the 031-02550 board and its native BAS port.",
 "summary": "YORK scroll chillers, heat pumps and condensing units with the 031-02550 board have BACnet MS/TP, Modbus RTU and N2 built in. The BAS writes the remote setpoint, load limit stage, cooling range, heating setpoint, heat pump mode and start/stop (AV 1-7, BV 1). Everything else is read-only AI and BI objects: liquid and ambient temperatures, per-system suction and discharge values, EEV output, timers, cutouts and setpoints, compressor run status, operational and fault codes, and system alarms.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "C.MMC.13.11 / 14.11 / 16.12 to C.MMC.13.23 / 14.23 / 16.23 (031-02755)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "Access follows the sheet's sections: analog and binary write points (AV, BV) and read-only points (AI, BI).",
  "The sheet marks every point Standard, Optional or Not available for three firmware ranges. The points marked Not available on all of them (per-system start/stops BV 2-3 and the debug codes AI 29 and AI 31) are left out.",
  "Optional points depend on the unit: suction-pressure (SP) or discharge-air (DAT) condensing units, heat pumps (HP), YCWL, EEV and refrigerant type. Values that don't apply are sent as zero.",
  "Operational and fault codes are numeric AIs; the states list the code values from the sheet's code tables.",
  "Units shown are imperial; SI units are in the sheet."
 ],
 "source": {
  "title": "Scroll Chiller/Heatpump/Condensing Unit Modbus RTU, BACnet MS/TP, N2 Data Map (SCROLL Native Comms)",
  "doc_number": null,
  "revision_date": "2020-02-11",
  "url": "https://docs.johnsoncontrols.com/chillers/api/khub/documents/PqH6~F3kNniq~6xHrGxQAQ/content"
 },
 "integration": {
  "summary": "Put the unit in automatic/remote control (BI 20 reads Auto), then start/stop it with BV 1 and write the remote setpoint (AV 1) and, if needed, the load limit stage (AV 3). Read the leaving chilled liquid temperature, compressor run status, each system's operational code and the two system alarms.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "START_STOP",
    "why": "Remote start/stop (1 = run)"
   },
   {
    "ref": "AV 1",
    "name": "REM_SETP",
    "why": "Remote leaving chilled liquid setpoint"
   },
   {
    "ref": "AV 3",
    "name": "LOAD_LIMIT",
    "why": "Load limit stage (0, 1, 2)"
   },
   {
    "ref": "AI 25",
    "name": "S1_OP_CODE",
    "why": "Sys 1 operational code"
   },
   {
    "ref": "BI 5",
    "name": "S1_C1_RUN",
    "why": "Sys 1 compressor 1 running"
   },
   {
    "ref": "BI 20",
    "name": "CNTL_MODE",
    "why": "Local/remote control mode (1 = Auto)"
   },
   {
    "ref": "AI 1",
    "name": "LCHLT",
    "why": "Leaving chilled liquid temperature"
   },
   {
    "ref": "BI 1",
    "name": "S1_ALARM",
    "why": "System 1 alarm"
   },
   {
    "ref": "BI 2",
    "name": "S2_ALARM",
    "why": "System 2 alarm"
   },
   {
    "ref": "AI 26",
    "name": "S1_FLT_CODE",
    "why": "Sys 1 fault code (0 = none)"
   }
  ],
  "enable": "BI 20 shows the local/remote control mode (0 = Manual, 1 = Auto). The sheet gives no point to change it and no write-enable point. On heat pumps AV 7 selects panel, cool or heat.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP, Modbus RTU and N2 are native on the board.",
   "The sheet gives no default MAC address, baud rate or device instance."
  ],
  "gotchas": [
   "Most data are AI/BI objects, not AV/BV; only AV 1-7 and BV 1 are writable.",
   "Several write points are optional and only act on matching units (SP/DAT condensing units, heat pumps, YCWL HP)."
  ]
 },
