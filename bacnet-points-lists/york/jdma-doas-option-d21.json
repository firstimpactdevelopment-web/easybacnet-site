 "equipment_type": "Make-up air unit / DOAS controller",
 "applies_to": "YORK JDMA dedicated outdoor air units with the Option D21 makeup air control program and the BHB8 BACnet card.",
 "summary": "JDMA DOAS units with the D21 makeup air program expose 80 objects through the optional BACnet MS/TP card: unit state and occupancy-source selectors, a BMS occupancy command, space temperature, humidity and CO2 setpoints, discharge air setpoints, air temperatures, damper, fan, compressor and heat outputs, pressures, mode flags and alarms.",
 "bacnet_transport": [
  "BACnet MS/TP",
  "BACnet IP"
 ],
 "firmware": null,
 "default_device_instance": 77000,
 "access_inferred": false,
 "notes": [
  "Access is from the R/W column. Binary states are shown from the Min/Max columns (Off/On, Normal/Alarm).",
  "Pressure objects in the integer variable block are printed with the note to divide by 1000 in the supervisory system.",
  "The same manual has a LonWorks point list (option BHB7), not reproduced here.",
  "Compared with the D19 list this program adds State_Sel, OccMode_Sel, Occupied_BMS, space temperature and humidity setpoints and has no Unit_Enable object; instance numbers differ between the two lists.",
  "AV 1006 State_Sel (2=Auto, 3=Cool, 4=Heat, 5=Off) and AV 1007 OccMode_Sel (0=Schedule, 1=Digital Input, 2=BMS) carry their codes in the description."
 ],
 "source": {
  "title": "Dedicated Outside Air Systems (DOAS) Operations Manual, Model JDMA - Manual for Makeup Air Control, Option D21 (Option D21 BACnet Point List)",
  "doc_number": "100.55-O2 (1015)",
  "revision_date": "2015-10",
  "url": "https://docs.johnsoncontrols.com/ductedsystems/api/khub/documents/GKywNRPcbHXBg1PrW2~4wQ/content"
 },
 "integration": {
  "summary": "Set AV 1007 OccMode_Sel to 2 (BMS) and command occupancy with BV 26 Occupied_BMS; AV 1006 State_Sel picks Auto, Cool, Heat or Off. Write the space temperature setpoint and, for BMS source units, supply fan speed and damper position. Read occupied status, supply fan status, discharge and space temperatures and the general alarm.",
  "minimum_points": [
   {
    "ref": "AV 1006",
    "name": "State_Sel",
    "why": "Unit state: 2 Auto, 3 Cool, 4 Heat, 5 Off"
   },
   {
    "ref": "BV 26",
    "name": "Occupied_BMS",
    "why": "Occupancy command from the BMS"
   },
   {
    "ref": "AV 1007",
    "name": "OccMode_Sel",
    "why": "Occupancy source; 2 = BMS"
   },
   {
    "ref": "AV 28",
    "name": "SpcTempSP",
    "why": "Space temperature setpoint"
   },
   {
    "ref": "AV 33",
    "name": "SF_BMS",
    "why": "Supply fan speed, % (BMS source units)"
   },
   {
    "ref": "BV 25",
    "name": "Occupied",
    "why": "Occupied mode in effect"
   },
   {
    "ref": "BV 32",
    "name": "SF_Sts",
    "why": "Supply fan proven on"
   },
   {
    "ref": "AV 9",
    "name": "DA_Temp",
    "why": "Discharge air temperature"
   },
   {
    "ref": "AV 25",
    "name": "Spc_Temp",
    "why": "Space temperature"
   },
   {
    "ref": "BV 1",
    "name": "Alm_Rly_Cmd",
    "why": "Unit general alarm"
   }
  ],
  "enable": "AV 1006 State_Sel sets Auto, Cool, Heat or Off (default 5 = Off). Occupancy comes from the schedule, a digital input or the BMS as chosen by AV 1007 OccMode_Sel; with 2 = BMS the unit follows BV 26 Occupied_BMS.",
  "heartbeat": null,
  "remote_sensors": "Set BV 24 OA_Temp_Sel and BV 23 OA_Hum_Sel to BMS (1), then write AV 20 OA_Temp_BMS and AV 18 OA_Hum_BMS.",
  "setup": [
   "BMS Config menu (Service > h): Protocol BACnet MSTP (or BACnet IP/Eth); Instance default 77000, Baudrate 9600/19200/38400/76800 (default 38400), MAC address 0-127.",
   "Set Termconf PlugIn to Yes, then on screen E.h.7 set Function to Write and Update to Yes to save; power cycle the controller afterwards.",
   "BACnet MS/TP needs the optional BMS communication card (option BHB8)."
  ],
  "gotchas": [
   "The pressure objects in the integer block (AV 1001-1003 and AV 1010) are scaled: divide by 1000 for in. WC.",
   "Outdoor temperature and humidity from the BMS are used only when OA_Temp_Sel / OA_Hum_Sel are set to BMS.",
   "State_Sel defaults to 5 (Off); set it before expecting the unit to run."
  ]
 },
