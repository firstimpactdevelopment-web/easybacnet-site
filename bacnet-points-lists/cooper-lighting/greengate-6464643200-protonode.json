 },
 "integration": {
  "summary": "Command lighting relays through the Relay BVs, use the Remote BVs as the panel's remote inputs, and read the switch input BIs for local switch states.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "Relay01",
    "why": "Relay 1 on/off command"
   },
   {
    "ref": "BV 101",
    "name": "Remote01",
    "why": "Remote point 1 (panel remote input)"
   },
   {
    "ref": "BI 1",
    "name": "Switch01",
    "why": "Switch input 1 status"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "The Greengate panel must be on the same IP subnet as the ProtoNode; record its IP address, port and panel address for the Web Configurator.",
   "Device instance = Node_Offset + Greengate Node-ID; Node_Offset defaults to 50,000. The ProtoNode default IP is 192.168.1.24."
  ],
  "gotchas": [
   "Map only the relays and switches that are wired; the profile lists every channel the panel model supports."
  ]
 },
