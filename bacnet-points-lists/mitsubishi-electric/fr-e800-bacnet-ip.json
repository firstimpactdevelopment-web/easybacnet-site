 },
 "integration": {
  "summary": "Put the inverter in Network operation mode with the Ethernet connector as command source, then write AV 300 Speed scale as the speed command and start/stop with BV 400. Read BV 0, AV 1, AV 2, AV 14 and the fault objects; BV 402 resets a fault.",
  "minimum_points": [
   {
    "ref": "BV 400",
    "name": "Run/Stop",
    "why": "Start/stop command (1 = start)"
   },
   {
    "ref": "AV 300",
    "name": "Speed scale",
    "why": "Speed command as % ratio (speed scale)"
   },
   {
    "ref": "BV 402",
    "name": "Fault reset",
    "why": "Fault reset"
   },
   {
    "ref": "BV 0",
    "name": "Inverter running",
    "why": "Running status"
   },
   {
    "ref": "AV 1",
    "name": "Output frequency",
    "why": "Output frequency, Hz"
   },
   {
    "ref": "AV 2",
    "name": "Output current",
    "why": "Output current, A"
   },
   {
    "ref": "AV 14",
    "name": "Output power",
    "why": "Output power, kW"
   },
   {
    "ref": "BV 99",
    "name": "Fault output",
    "why": "Inverter fault"
   },
   {
    "ref": "AV 200",
    "name": "Alarm history 1",
    "why": "Latest fault record"
   }
  ],
  "enable": "The inverter must be in Network (NET) operation mode with the Ethernet port as command and speed source; otherwise writes are stored but not applied.",
  "heartbeat": "Pr.1432 Ethernet communication check time interval (0.1-999.8 s) trips the inverter with E.EHR if no allowed device talks to it; 9999 disables the check. Command devices are limited to the IP range in Pr.1449-Pr.1454.",
  "remote_sensors": "AV 311 PID measured value CMD can feed the PID loop from the BMS when Pr.128 and Pr.610 select the network value.",
  "setup": [
   "Device instance = Pr.728 x 10000 + Pr.729 (both default 0).",
   "Set the command-source IP range (Pr.1449-Pr.1454) to include the BMS; at the default of 0 no device can send run or speed commands over Ethernet."
  ],
  "gotchas": [
   "Commandable values are cleared at power-on or inverter reset; rewrite them after a restart.",
   "Speed scale is a % of Pr.390 % setting reference frequency (default 60 Hz), not a frequency in Hz."
  ]
 },
