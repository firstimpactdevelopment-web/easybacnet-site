  "SOLA",
  "ProtoNode FPC-N34",
  "ProtoNode FPC-N35",
  "ProtoNode"
 ],
 "equipment_type": "Boiler controller gateway",
 "applies_to": "Weil-McLain SlimFit 1000-2000 Series 1 boilers with the Honeywell SOLA control, read through a ProtoNode FPC-N34 gateway.",
 "summary": "A ProtoNode FPC-N34 reads the SlimFit Series 1 SOLA control over Modbus RTU and presents it as a BACnet IP or BACnet MS/TP device with 124 analog values and 20 binary values. Most objects are status readbacks; points marked (W) take writes, including CH enable, the remote thermostat call, the CH and lead-lag setpoints and the outdoor reset curve values.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "This supplement only lists the objects; device instance, MAC address and baud rate are set on the ProtoNode as described in its start-up guide, which is a separate document.",
  "The same object list is served over BACnet IP or BACnet MS/TP, depending on how the ProtoNode is set up.",
  "No units or state texts are given. The LonWorks types in the source show which values are temperatures, percentages or hours.",
  "Writable objects are the ones the supplement marks (W); every other object is a readback.",
  "Most writable settings have a matching '... Status' readback object.",
  "Evergreen, SlimFit 550-750 and SlimFit 1000-2000 Series 2 and SVF boilers use a different object list."
 ],
 "integration": {
  "summary": "Write CH Enable and the remote thermostat call, set the CH setpoint (or the lead-lag setpoint on a lead-lag master), then read back CH status, burner state, outlet temperature, firing rate and the lockout code. Writable objects carry (W) in their name.",
  "minimum_points": [
   {
    "ref": "BV 1",
    "name": "CH Enable (W)",
    "why": "Central heat enable"
   },
   {
    "ref": "BV 7",
    "name": "CH Remote Stat (W)",
    "why": "Call for heat from the BMS"
   },
   {
    "ref": "AV 37",
    "name": "CH Setpoint (W)",
    "why": "Central heat water setpoint"
   },
   {
    "ref": "AV 84",
    "name": "Lead Lag Setpoint (W)",
    "why": "Setpoint for a lead-lag (cascade) master"
   },
   {
    "ref": "AV 40",
    "name": "CH Status",
    "why": "Central heat status code"
   },
   {
    "ref": "AV 20",
    "name": "Burner Control State Status",
    "why": "Burner sequence state"
   },
   {
    "ref": "AV 100",
    "name": "Outlet Sensor Status",
    "why": "Outlet water temperature"
   },
   {
    "ref": "AV 60",
    "name": "Firing Rate Status",
    "why": "Burner firing rate"
   },
   {
    "ref": "AV 90",
    "name": "Lockout Status",
    "why": "Lockout status code"
   }
  ],
  "enable": "BV 1 CH Enable (W) and BV 7 CH Remote Stat (W) are the writable enable and call-for-heat objects. The supplement does not explain how they interact with the boiler's local enable settings.",
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance, MAC address and baud rate are set on the ProtoNode (see the ProtoNode start-up guide); this supplement does not list them.",
   "All analog objects are AVs; readback-only ones carry 'Status' in their name."
  ],
  "gotchas": [
   "No units or state texts are given; temperatures, percentages and codes must be checked against the boiler display.",
   "AV 101 Password (W) and AV 102 PSWD Status exist, but the supplement does not explain them."
  ]
 },
