{
 "manufacturer": "Laars",
 "manufacturer_slug": "laars",
 "model": "SV2 gas valve - ProtoNode",
 "model_slug": "sv2-protonode",
 "aliases": [
  "SV2",
  "Laars SV2",
  "ProtoNode FPC-N34",
  "ProtoNode FPC-N35",
  "FPC-N34-0701",
  "Laars ProtoNode"
 ],
 "equipment_type": "Gas valve gateway",
 "applies_to": "The SV2 device on Laars equipment, read through a ProtoNode FPC-N34 gateway. The document does not describe the SV2; its point names cover a gas valve with VPS tests and pressure and fuel/air modules.",
 "summary": "The ProtoNode reads the SV2 over Modbus RTU and serves 82 objects per device. Most are read-only: valve open states, VPS test results, pressure module readings and status, gas pressure limit setup, active alarm count, the last two fault codes and accumulated hours and cycles. Only the four unit-selection objects are writable.",
 "bacnet_transport": [
  "BACnet IP",
  "BACnet MS/TP"
 ],
 "firmware": null,
 "default_device_instance": "50000 + device Node-ID",
 "access_inferred": true,
 "notes": [
  "Each device on the ProtoNode's RS-485 bus shows up as its own BACnet device, and every one uses the same object IDs. The device instance is Node_Offset (default 50000) plus the device's Node-ID, so Node-ID 1 = device 50001.",
  "The mapping has no read/write column. AV, BV and MV objects are mapped to Metasys N2 outputs and LonWorks input variables, so they are listed here as writable; AI, BI and MI objects are read-only.",
  "No units or state texts are given for the multistate inputs.",
  "Several objects span more than one Modbus register (e.g. the user-entered valve name, 40255-40259), and some multistate inputs are two-bit fields inside one register.",
  "Remote Reset Command is mapped as a read-only AI."
 ],
 "integration": {
  "summary": "Monitoring only: read the valve system state, MV1/MV2 open status and the pressure module reading, then watch the lockout flag, the active alarm count and the most recent fault code. The only writable objects are the unit selections.",
  "minimum_points": [
   {
    "ref": "MI 54",
    "name": "Valve System States",
    "why": "Valve system state code"
   },
   {
    "ref": "BI 26",
    "name": "MV1 Open",
    "why": "Main valve 1 open"
   },
   {
    "ref": "BI 27",
    "name": "MV2 Open",
    "why": "Main valve 2 open"
   },
   {
    "ref": "AI 36",
    "name": "Current Pressure Mod Press Reading",
    "why": "Current pressure module reading"
   },
   {
    "ref": "MI 37",
    "name": "Pressure Module Status",
    "why": "Pressure module status code"
   },
   {
    "ref": "BI 32",
    "name": "Lockout",
    "why": "Valve in lockout"
   },
   {
    "ref": "AI 24",
    "name": "Num of Currently Active Alarms",
    "why": "Number of active alarms"
   },
   {
    "ref": "AI 64",
    "name": "Fault Code Of Most Recent Fault",
    "why": "Fault code of the latest fault"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "Device instance = Node_Offset + device Node-ID. Node_Offset defaults to 50000 and is changed in the ProtoNode web configurator; Node-IDs must be unique, 1-255.",
   "Device to ProtoNode: Modbus RTU, 38400 baud, 8 data bits, no parity, 1 stop bit.",
   "Default ProtoNode IP address 192.168.1.24, mask 255.255.255.0. Choose BACnet IP or BACnet MS/TP with the Protocol Selector, then add one profile per device with its Node-ID.",
   "With more than one device on a ProtoNode, set BACnet Virtual Server Nodes to Yes. For BACnet MS/TP also set MAC address, baud rate and Max Master.",
   "Two or more ProtoNodes on the same subnet need different BACnet Network Numbers (default 50).",
   "A ProtoNode handles 1,500 registers in total; this profile uses 75 per device."
  ],
  "gotchas": [
   "BV 1, MV 2, MV 3 and BV 4 set the units the valve reports in; set them once, not from a schedule.",
   "Remote Reset Command (AI 5) is read-only in this mapping, so a remote reset can't be written through it."
  ]
 },
