    "why": "Accumulated volume"
   },
   {
    "ref": "PIV 0",
    "name": "Info code",
    "why": "Meter status/error code"
   }
  ],
  "enable": null,
  "heartbeat": null,
  "remote_sensors": null,
  "setup": [
   "BACnet MS/TP over RS-485, as master or slave; 9600, 19200, 38400, 57600, 76800 or 115200 baud.",
   "Device instance defaults to the last 5 digits of the meter number; Object_Identifier and Object_Name are writable.",
   "Max_Master defaults to 127 (writable only when the module runs as master); Max_Info_Frames defaults to 2.",
   "COV, Who-Is and Who-Has only work when the module is a master.",
   "No segmentation; max APDU 480 bytes."
  ],
  "gotchas": [
   "Many AIs list several possible units, some including 'No Units'; the PICS does not say which applies.",
   "Energy registers list Wh, kWh or MWh as possible units; check the Units property before trending."
  ]
 },
