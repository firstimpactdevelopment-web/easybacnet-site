 "equipment_type": "Heat and cooling energy meter (BACnet MS/TP module)",
 "applies_to": "Kamstrup MULTICAL 403 and MULTICAL 603 heat, cooling and water meters fitted with the HC-003-66 BACnet MS/TP module.",
 "summary": "The HC-003-66 plug-in module puts a MULTICAL 403 or 603 meter on BACnet MS/TP as a B-ASC device. It serves 41 read-only Analog Inputs (flows, temperatures, power, energy and volume registers, pulse inputs, mass) and 12 Positive Integer Values (info code, hour counters, configuration and meter numbers). The PICS units column is headed 'Most often used units' and often lists several options per object; read each object's Units property for the one in use.",
 "bacnet_transport": [
  "BACnet MS/TP"
 ],
 "firmware": "E1 (application software 1.0)",
 "default_device_instance": null,
 "access_inferred": false,
 "notes": [
  "The device instance defaults to the last 5 digits of the meter number.",
  "The units column ('Most often used units') is kept as printed, with every listed option; some objects include 'No Units' among them.",
  "Every object is read-only in the object table.",
  "The PICS is dated 2018-04-12 (document 55122063_F1_GB_04.2018)."
 ],
