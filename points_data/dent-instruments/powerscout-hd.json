{
  "manufacturer": "DENT Instruments",
  "manufacturer_slug": "dent-instruments",
  "model": "PowerScout HD (PS12HD / PS24HD / PS48HD) multi-circuit power meter",
  "model_slug": "powerscout-hd",
  "aliases": [
    "PowerScout HD",
    "PS12HD",
    "PS24HD",
    "PS48HD",
    "PowerScout 12HD",
    "PowerScout 48HD",
    "PSHD"
  ],
  "equipment_type": "Multi-circuit power and energy meter (submeter)",
  "applies_to": "DENT PowerScout HD series multi-circuit meters (12, 24 or 48 CT inputs, up to 16 three-channel elements) on BACnet MS/TP or BACnet IP.",
  "summary": "The PowerScout HD master register list maps every Modbus register to its BACnet object. System objects cover network settings, reset commands, demand window, snap thresholds, pulse inputs, voltage alarms and the clock. Each metering element (three CT channels) repeats a block of Analog Inputs (current, voltage, power, VA, VAR, power factors, THD, demand, energy by direction and quadrant, phase angles) plus per-CT configuration objects; element A is listed here and each later element adds 10000.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Element objects: element A instances are listed; element B adds 10000, C 20000 ... P 150000 (the 'BACnet object floor' in the workbook). System objects keep the same instance on every sheet.",
    "The workbook has one sheet per element A-P; the PS12HD has fewer elements than the PS48HD, so higher element blocks only exist on larger models.",
    "Some objects exist only on certain models (noted in the description, e.g. pulse inputs 3-4 on PS12HD only, Vin2 objects on PS24HD/PS48HD).",
    "Phase Check and voltage alarm masks/status are BitString Value objects (listed as type Other).",
    "Communications Mode (MV 2214) and Time Since CAM (AI 2368) have no R/W entry in the workbook and are listed as read-only.",
    "Source: DENT PowerScout HD master register list (xlsx), BACnet Object / Object Type / Object Name columns."
  ],
  "source": {
    "title": "PowerScout HD Master Register List",
    "doc_number": null,
    "revision_date": null,
    "url": "https://www.dentinstruments.com/wp-content/uploads/2022/04/PSHD_MASTER_REGISTER_LIST_current-1.xlsx"
  },
  "integration": {
    "summary": "Set the serial address/baud or IP settings, then configure each element's service type and CT ratings. Read each element's power sum, energy, demand, current and voltage at the element A instance plus 10000 x (element index - 1).",
    "minimum_points": [
      {
        "ref": "AI 1167",
        "name": "Power Sum Element",
        "why": "Element real power, kW (+10000 per element)"
      },
      {
        "ref": "AI 1207",
        "name": "Imported Energy Sum Element",
        "why": "Element imported energy, kWh"
      },
      {
        "ref": "AI 2344",
        "name": "Energy Net Sum Element",
        "why": "Element net energy, kWh"
      },
      {
        "ref": "AI 2334",
        "name": "Power Demand This Interval Element",
        "why": "Element kW demand, current interval"
      },
      {
        "ref": "AI 1191",
        "name": "Apparent PF Avg Element",
        "why": "Element apparent power factor"
      },
      {
        "ref": "AI 1141",
        "name": "Current Avg Element",
        "why": "Element average current, A"
      },
      {
        "ref": "AI 1149",
        "name": "Voltage L to N Avg Element",
        "why": "Element average L-N voltage, V"
      },
      {
        "ref": "AI 1165",
        "name": "Line Frequency",
        "why": "Line frequency, Hz"
      },
      {
        "ref": "BV 2451",
        "name": "Alarm Output Status",
        "why": "Alarm output state"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Serial address (PIV 1069, 1-245) and baud (PIV 1131, 9600-115k) set the RS-485 port; IP address, netmask, gateway and DHCP/static are CSV 1079-1095 and BV 1077.",
      "BACnet IP UDP port is PIV 2250; BBMD IP address is CSV 2264.",
      "Demand window type and length are MV 2201 / PIV 2202 (15 min default)."
    ],
    "gotchas": [
      "Reset and clear BVs (2100-2105, 12102, 12103) act on writes of 1 or 1234; Clear Accumulated Measurements All zeroes every energy total.",
      "Element blocks repeat every 10000; map by instance, since names are the same in each element.",
      "Set each element's Service Type and CT full-scale ratings before trusting readings."
    ]
  },
