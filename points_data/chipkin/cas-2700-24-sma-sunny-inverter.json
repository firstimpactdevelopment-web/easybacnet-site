        "why": "Grid voltage (Vac)"
      },
      {
        "ref": "AI 4",
        "name": "Error",
        "why": "Inverter error status"
      }
    ],
    "enable": null,
    "heartbeat": "If the gateway loses a device or a value can't be read, the object's Out_Of_Service is set true and the last good value stays in Present_Value.",
    "remote_sensors": null,
    "setup": [
      "Gateway default BACnet device instance 389001, UDP port 47808; give each gateway a unique instance.",
      "Enter the Sunny WebBox IP address and pick the device type (Invertor, SensorBox or Sunny Island) for each device in the gateway's web page.",
      "Only one Sunny WebBox per gateway."
    ],
    "gotchas": [
      "Watch Out_Of_Service rather than the value to spot lost data.",
      "Names are SMA channel codes; see the SMA documentation for scaling and units."
    ]
  },
