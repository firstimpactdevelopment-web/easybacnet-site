{
  "manufacturer": "iSMA CONTROLLI",
  "manufacturer_slug": "isma-controlli",
  "model": "iSMA-B-LP room panel (BACnet MS/TP)",
  "model_slug": "isma-b-lp-room-panel",
  "aliases": [
    "iSMA-B-LP",
    "iSMA-B-LP-H",
