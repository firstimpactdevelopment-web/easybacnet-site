  "equipment_type": "Gas-fired steam humidifier",
  "applies_to": "Condair GS II gas-fired steam humidifiers with the Integrated Controller (software 5.10.1.14 or later).",
  "summary": "The Condair GS II is a natural-gas or propane fired steam humidifier. With Integrated Controller software 5.10.1.14 or later it exposes BACnet IP and MS/TP on-board. Points cover operating and service status, channel 1/2 signals, capacity, exhaust service hours, float levels and inlet valves, plus writable setpoints, P-band and demand inputs.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": "Integrated Controller 5.10.1.14 or later",
  "default_device_instance": 1001,
  "access_inferred": false,
  "notes": [
    "BACnet is built into the Integrated Controller (RJ45 for BACnet IP, RS485 for MS/TP); no gateway card is needed.",
    "To command the unit set the controller's signal source to BACnet; the demand AO must be refreshed within the signal timeout or the unit stops.",
    "Channel 2 is a limiter (high-limit) signal.",
    "Capacity units follow the controller's Metric/Imperial setting."
  ],
  "source": {
    "title": "BACnet on-board - Supplemental Installation and Operation Manual (RS, GS II, DL, ME and RO-A)",
    "doc_number": "2595492-C",
    "revision_date": "2022-12",
    "url": "https://www.condair.com/consense/bms-communication-ic-1.0/am_bms_interface_bacnet_on_board_2595492_en_condairltd.pdf"
  },
  "integration": {
    "summary": "Turn on BACnet in the Communication menu, set the control signal source to BACnet, and write demand or RH to AO 10044 (and a limiter value to AO 10045) within the BMS timeout. Read the operating and service status, error code and actual output.",
    "minimum_points": [
      {
        "ref": "AO 10044",
        "name": "Digital RH/Demand A1",
        "why": "Demand or measured RH from the BMS"
      },
      {
        "ref": "AO 10045",
        "name": "Digital RH/Demand A2",
        "why": "Limiter (channel 2) signal from the BMS"
      },
      {
        "ref": "AV 10010",
        "name": "Setpoint Channel 1",
        "why": "Channel 1 humidity setpoint used in RH P/PI mode"
      },
      {
        "ref": "AV 10008",
        "name": "Manual Capacity",
        "why": "Manual capacity limit"
      },
      {
        "ref": "MI 614",
        "name": "Status",
        "why": "Operating status"
      },
      {
        "ref": "MI 549",
        "name": "Service Status",
        "why": "Service/fault status"
      },
      {
        "ref": "AI 10730",
        "name": "Error Code",
        "why": "Active error code"
      },
      {
        "ref": "AI 10103",
        "name": "Output",
        "why": "Actual steam output"
      }
    ],
    "enable": "Set Configuration > Control Settings > Source to BACnet (and the BACnet interface to MSTP or BACnet/IP); otherwise control values from BACnet are ignored and the unit follows its driver-board analog input.",
    "heartbeat": "BMS Timeout tab (1-300 s, default 300 s): if no valid control signal arrives from the BMS within this time, warning W35 BMS Timeout is raised and the unit stops until a valid signal returns. Only evaluated when the control signal source is not Analog, so keep rewriting the demand AO.",
    "remote_sensors": "Control Mode Demand uses the AO as an output demand; RH P / RH PI modes use it as a measured humidity and the controller's setpoint/P-band AVs do the control. Setpoint and humidity can only be monitored through the controller in RH P/PI mode.",
    "setup": [
      "Communication settings are in the Communication submenu (password 0335): BACnet = Off (factory), MSTP or BACnet/IP; some changes reboot the controller.",
      "Node ID defaults to 1001 (range 1-4194303); BACnet IP port 47808; Foreign Device (BBMD) registration Off by default.",
      "IP type defaults to DHCP and reverts to fixed addressing after 5 failed DHCP attempts.",
      "MS/TP: Master by default, MAC 127 (0-127 master, 0-254 slave), baud 9600 (9600-76800)."
    ],
    "gotchas": [
      "Requires Integrated Controller software 5.10.1.14 or later for BACnet on-board.",
      "Capacity units follow the Metric/Imperial setting."
    ]
  },
