{
  "manufacturer": "Armstrong Fluid Technology",
  "manufacturer_slug": "armstrong-fluid-technology",
  "model": "Design Envelope Integrated Tower Controller (ITC 9521)",
  "model_slug": "design-envelope-itc-9521",
  "aliases": [
    "ITC 9521",
