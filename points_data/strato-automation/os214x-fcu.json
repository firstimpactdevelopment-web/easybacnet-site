        "why": "Fan speed status"
      },
      {
        "ref": "BV 40",
        "name": "Ch_Over",
        "why": "Changeover: cool / heat"
      }
    ],
    "enable": "MSV-18 Occ_Cmd (tagged Cmd) sets occupancy from the BMS: Loc_Occ, Occupied or Unoccup.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MS/TP address and baud are set in the thermostat's MSTP Config menu.",
      "Strato recommends writing MSVs and AVs at the default priority (16) and everything else at priority 8 down to 3."
    ],
    "gotchas": [
      "MSV-14 (valve N.C./N.O.), MSV-15 (sequence) and MSV-58 (fan sequence) are commissioning settings."
    ]
