  ],
  "equipment_type": "Thermostat (BACnet MS/TP)",
  "applies_to": "Strato OS537 temperature/humidity thermostats running the rooftop unit, heat pump and small AHU applications of the universal firmware.",
  "summary": "The OS537 is a larger BACnet MS/TP thermostat with 5 universal inputs, 3 analog outputs and 7 binary outputs, plus humidity and (C models) CO2 sensing. Its RTU application covers up to four cooling and four heating stages, economizer with enthalpy and mixed air control, power exhaust, humidification and dehumidification, selected with the MSV-127 preset. The list also includes the radar presence sensor settings.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Universal firmware 1.2.6 and later",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The guide has no read/write column. Access here follows its tags: Cfg, User and Cmd objects are shown writable, Status objects read-only, and BO/AO objects commandable (the guide lists them for output overrides). BV-5 (Occ_Sch) is tagged Status but shown writable because the guide says it can be written for occupancy.",
    "AI-8 RoomCO2 exists only on C models such as the OS537MHC.",
    "BO and AO descriptions are generated from the MSV-127 preset when BV-4 is On.",
    "Multistate state numbers follow the order the states are printed, starting at 1; MSV-223 and MSV-235 print a range.",
    "AV-35 and AV-36 (occupied setpoints) are tagged Status in this guide."
  ],
  "source": {
    "title": "OS537 (Universal Firmware) User Guide, Rooftop Unit (RTU) - BACnet Objects",
    "doc_number": null,
    "revision_date": "July 2026 rev 0",
    "url": "https://stratoautomation.com/wp-content/uploads/2025/08/OS537-User-Guide-July-2026-rev-0.pdf"
  },
  "integration": {
    "summary": "Select the application with MSV-127, then command system mode (MSV-3), fan mode (MSV-4) and occupancy (BV-5 or MSV-6) and write the room setpoint (AV-1). Read room temperature and humidity, demands, supply and outdoor temperatures and the help message (MSV-100) for alarms.",
    "minimum_points": [
      {
        "ref": "MV 3",
        "name": "MODE",
        "why": "System mode: Off, Auto, Cool, Heat"
      },
      {
        "ref": "MV 4",
        "name": "FAN",
        "why": "Fan mode: On / Auto"
      },
      {
        "ref": "BV 5",
        "name": "Occ_Sch",
        "why": "Occupancy schedule; BMS can write On/Off"
      },
      {
        "ref": "AV 1",
        "name": "RoomTSP",
        "why": "Room temperature setpoint"
      },
      {
        "ref": "AI 6",
        "name": "RoomT",
        "why": "Room temperature"
      },
      {
        "ref": "AI 7",
        "name": "RoomRH",
        "why": "Room humidity"
      },
      {
        "ref": "AV 6",
        "name": "HTG_Dem",
        "why": "Heating demand, %"
      },
      {
        "ref": "AV 7",
        "name": "CLG_Dem",
        "why": "Cooling demand, %"
      },
      {
        "ref": "AV 16",
        "name": "SATemp",
        "why": "Supply air temperature"
      },
      {
        "ref": "MV 100",
        "name": "HELP_mess",
        "why": "Alarm / help message"
      }
    ],
    "enable": "Occupancy can be written to BV-5; MSV-45 selects the schedule source and MSV-6 forces local, occupied or unoccupied.",
    "heartbeat": null,
    "remote_sensors": "Sensor location MSVs (MSV-2, 27, 28, 52, 54, 57, 58) can be set to 'External' to take the value from the network.",
    "setup": [
      "MS/TP is the default network; address and baud are set in the MSTP Config menu. A Wi-Fi option is described in a separate Strato guide.",
      "Strato recommends writing MSVs and AVs at the default priority (16) and everything else at priority 8 down to 3."
    ],
    "gotchas": [
      "Most MSVs are commissioning settings; changing a custom output MSV switches MSV-127 to Custom."
    ]
  },
