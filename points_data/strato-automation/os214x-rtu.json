{
  "manufacturer": "Strato Automation",
  "manufacturer_slug": "strato-automation",
  "model": "OPENSTAT OS214 / OS214x thermostat, RTU firmware",
  "model_slug": "os214x-rtu",
  "aliases": [
    "OS214",
    "OS214W",
    "OS214x",
    "OpenStat OS214",
    "OS214-RTU",
    "Strato OS214"
  ],
  "equipment_type": "Thermostat (BACnet MS/TP)",
  "applies_to": "Strato OS214 / OS214W (Wi-Fi) room thermostats running the rooftop-unit / heat-pump application of the universal firmware.",
  "summary": "The OS214 is a BACnet MS/TP room thermostat with 2 inputs, 1 analog output and 4 binary outputs. In its rooftop unit (RTU) application it runs single-stage RTU, heat pump, economizer and ECM fan presets selected with MSV-127. Setpoints, modes and occupancy are writable; demands, effective setpoints, supply and outdoor temperatures and the PID loops are readable.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Universal firmware 1.0.4 and later",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The guide has no read/write column. Access here follows its tags: Cfg, User and Cmd objects are shown writable, Status objects read-only, and BO/AO objects commandable (the guide lists them for output overrides). BV-5 (Occ_Sch) is tagged Status but shown writable because the guide says it can be written for occupancy.",
    "BO and AO descriptions are generated from the MSV-127 preset when BV-4 (Autogenerate I/O descriptions) is On.",
    "Changing any of MSV-7, 8, 16, 17, 23, 27, 28, 30, 44, 45 or 65 switches MSV-127 to Custom.",
    "Multistate state numbers follow the order the states are printed, starting at 1.",
    "The same guide has a separate FCU object list (see the OS214x FCU entry)."
  ],
  "source": {
    "title": "OS214x (Universal Firmware) User Guide, Rooftop Unit (RTU) - BACnet Objects",
    "doc_number": null,
    "revision_date": "Sept 2025 rev 5",
    "url": "https://stratoautomation.com/wp-content/uploads/2026/01/OS214x-Universal-Firmware-User-Guide-Sept-2025-rev-5.pdf"
  },
  "integration": {
    "summary": "Pick the application with MSV-127, then run the unit from the BMS with the system mode (MSV-3), fan mode (MSV-4), occupancy (BV-5 or MSV-6) and the room setpoint (AV-1). Monitor room temperature, heating and cooling demand and the help message (MSV-100) for alarms.",
    "minimum_points": [
      {
        "ref": "MV 3",
        "name": "MODE",
        "why": "System mode: Off, Auto, Cool, Heat"
      },
      {
        "ref": "MV 4",
        "name": "FAN",
        "why": "Fan mode: On / Auto"
      },
      {
        "ref": "BV 5",
        "name": "Occ_Sch",
        "why": "Occupancy schedule; BMS can write On/Off"
      },
      {
        "ref": "AV 1",
        "name": "RoomTSP",
        "why": "Room temperature setpoint"
      },
      {
        "ref": "AI 6",
        "name": "RoomT",
        "why": "Room temperature"
      },
      {
        "ref": "AV 9",
        "name": "Eff_T",
        "why": "Effective temperature used for control"
      },
      {
        "ref": "AV 6",
        "name": "HTG_Dem",
        "why": "Heating demand, %"
      },
      {
        "ref": "AV 7",
        "name": "CLG_Dem",
        "why": "Cooling demand, %"
      },
      {
        "ref": "AV 16",
        "name": "SATemp",
        "why": "Supply air temperature"
      },
      {
        "ref": "MV 100",
        "name": "HELP_mess",
        "why": "Alarm message (Normal / SupplyFrozen)"
      }
    ],
    "enable": "Occupancy can be written to BV-5 (system occupancy schedule); MSV-45 selects where the schedule comes from and MSV-6 forces local, occupied or unoccupied.",
    "heartbeat": null,
    "remote_sensors": "MSV-2 and MSV-27/28 select room, outdoor and supply sensor locations; 'External' lets a value come from the network.",
    "setup": [
      "MS/TP address and baud are set in the thermostat's MSTP Config menu (setup menu: hold the two left buttons, then the PIN sequence).",
      "Strato recommends writing MSVs and AVs at the default priority (16) and everything else at priority 8 down to 3."
    ],
    "gotchas": [
      "Most MSVs are commissioning settings; avoid cyclic writes.",
      "Changing a custom output MSV switches MSV-127 to Custom."
    ]
  },
