  ],
  "equipment_type": "Variable frequency drive via BACnet gateway",
  "applies_to": "ABB ACS800 drives (6-pulse or active front end, standard firmware) fitted with an RMBA-01 Modbus adapter and an FPC-N54 ProtoNode.",
  "summary": "The ProtoNode FPC-N54 reads an ACS800 drive over Modbus RTU and serves 50 BACnet objects: references, ramp times and PID tuning as AVs, drive measurements and I/O status as AIs and BIs, and start/stop, alarm reset, EXT1/EXT2 select and relay commands as BVs. Select profile 1 (ACS800) in the gateway's web configurator.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The ACS800 table lists only object IDs and names; access is inferred (AV/BV writable, AI/BI read-only).",
    "No units, ranges or state texts are printed for this profile.",
    "Object names keep the guide's spelling (REFERNECE, FREQUENCEY, STAUTS, KWN).",
    "Direction control is not offered over BACnet; wire it to the drive if needed."
  ],
  "source": {
    "title": "ProtoNode FPC-N54 Start-up Guide For Interfacing ABB Products: ACS800, ACS880, ACS880-CTDD",
    "doc_number": null,
    "revision_date": "Document Revision 3.C, February 2020 (Web Configurator Template Revision 4)",
    "url": "https://baltimoreaircoil.com/download_api_endpoint/1089/gatewaybacnetacs880protonodefpc-n54startupguide_20200709.pdf",
    "unofficial": true,
    "host": "Baltimore Aircoil Company"
  },
  "integration": {
    "summary": "Set the drive to take start/stop and reference 1 from the fieldbus, then write START/STOP and REFERENCE 1 COMMAND and read speed, current, ready and tripped status.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "START/STOP",
        "why": "Start/stop command"
      },
      {
        "ref": "AV 1",
        "name": "REFERENCE 1 COMMAND",
        "why": "Speed reference 1"
      },
      {
        "ref": "BV 2",
        "name": "ALARM RESET",
        "why": "Fault reset"
      },
      {
        "ref": "BI 2",
        "name": "RUN ENABLED",
        "why": "Run enabled status"
      },
      {
        "ref": "AI 1",
        "name": "MOTOR SPEED",
        "why": "Motor speed"
      },
      {
        "ref": "AI 3",
        "name": "CURRENT",
        "why": "Motor current"
      },
      {
        "ref": "AI 21",
        "name": "POWER",
        "why": "Drive power"
      },
      {
        "ref": "BI 3",
        "name": "TRIPPED",
        "why": "Drive tripped (fault)"
      },
      {
        "ref": "BI 4",
        "name": "ALARM",
        "why": "Drive alarm"
      }
    ],
    "enable": "For BACnet control set parameter 10.01 EXT1 STRT/STP/DIR = COMM.CW and 11.03 EXT REF1 SELECT = COMM.REF; for monitoring only, skip these.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Drive Modbus via RMBA-01: 98.02 = STD Modbus, 52.01 = 1, 52.02 = 19.2 kbps, 52.03 = NONE1STOPBIT, then power-cycle the drive.",
      "Choose profile 1 (ACS800) in the ProtoNode web configurator.",
      "ProtoNode default IP address 192.168.1.24, subnet 255.255.255.0; it serves BACnet IP or BACnet MS/TP."
    ],
    "gotchas": [
      "Direction control is not available over BACnet.",
      "Access is not printed for this profile; confirm writes on site."
    ]
  },
