{
  "manufacturer": "ABB",
  "manufacturer_slug": "abb",
  "model": "ACH550 HVAC drive (embedded BACnet MS/TP)",
  "model_slug": "ach550",
  "aliases": [
    "ACH550",
    "ACH550-01",
    "ACH550-UH",
    "ACH550 E-Clipse"
  ],
  "equipment_type": "Variable frequency drive (HVAC)",
  "applies_to": "ABB ACH550 HVAC drives using the built-in RS-485 port with native BACnet MS/TP.",
  "summary": "The ACH550 talks native BACnet MS/TP on its built-in RS-485 port, as master or slave at up to 76.8 kbps. The object list is static: relay and digital input status, relay commands, run/stop and direction commands, two speed references, drive measurements, energy meters, fault history and a parameter mailbox (AV25/AV26 with BV15/BV16). It predates the ACH580 list, which reuses many of the same instance numbers.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "0511",
  "default_device_instance": null,
  "notes": [
    "Commandable run, direction and reference objects only work when the drive is configured for BACnet control.",
    "BI3-BI5 and BO3-BO5 (relays 4-6) need the OREL-01 relay extension option.",
    "BACnet protocol revision 7; B-ASC device profile; no segmentation.",
    "The mailbox objects let you read or write any drive parameter by number."
  ],
  "source": {
    "title": "BACnet Protocol Implementation Conformance Statement - ACH550",
    "doc_number": null,
    "revision_date": "2015-03-10",
    "url": "https://library.e.abb.com/public/e5f255b16dbb950fc1257e04002a0f78/ACH550_PICS_10_03_2015.pdf"
  },
  "integration": {
    "summary": "Wire the drive to the MS/TP trunk, then command BV10 RUN/STOP CMD and AV16 INPUT REF 1 once the drive is configured for BACnet control. Read BV0, BV2, AV1, AV4 and AV6 for run status, fault, frequency, current and power, and reset faults with BV14. BV18 gives the BMS override control when the normal source is not BACnet.",
    "minimum_points": [
      {
        "ref": "BV 10",
        "name": "RUN/STOP CMD",
        "why": "Start/stop from the BMS"
      },
      {
        "ref": "AV 16",
        "name": "INPUT REF 1",
        "why": "Speed reference in %"
      },
      {
        "ref": "BV 14",
        "name": "FAULT RESET",
        "why": "Reset a tripped drive"
      },
      {
        "ref": "BV 0",
        "name": "RUN/STOP ACT",
        "why": "Running status"
      },
      {
        "ref": "BV 2",
        "name": "FAULT ACT",
        "why": "Fault status"
      },
      {
        "ref": "BV 4",
        "name": "HAND/AUTO ACT",
        "why": "Shows if the panel has the drive in Hand"
      },
      {
        "ref": "AV 1",
        "name": "OUTPUT FREQ",
        "why": "Output frequency"
      },
      {
        "ref": "AV 4",
        "name": "CURRENT",
        "why": "Motor amps"
      },
      {
        "ref": "AV 6",
        "name": "POWER",
        "why": "Drive power in kW"
      },
      {
        "ref": "AV 18",
        "name": "LAST FLT",
        "why": "Most recent fault code"
      }
    ],
    "enable": "The PICS says command objects only work when the drive is configured for BACnet control, but does not name the parameters. BV18 CTL OVERRIDE CMD hands drive control to BACnet from its normal source; panel HAND has priority over it.",
    "heartbeat": null,
    "remote_sensors": "AV27 EXT PID STPT lets the BMS write the external PID setpoint (drive must be configured for BACnet control).",
    "setup": [
      "Native BACnet MS/TP, master or slave, at 9600, 19200, 38400 or 76800 baud.",
      "B-ASC device profile, BACnet protocol revision 7, no segmentation.",
      "Static device binding is not supported.",
      "The PICS does not name the parameters for MAC address, baud or device instance."
    ],
    "gotchas": [
      "BI3-BI5 and BO3-BO5 need the OREL-01 relay option.",
      "BV16 MBOX WRITE writes any drive parameter by number; double-check AV25 before using it.",
      "BV17 LOCK PANEL blocks parameter changes at the keypad."
    ]
  },
