  "equipment_type": "Variable frequency drive via BACnet gateway",
  "applies_to": "ABB ACS880 drives with standard firmware (6-pulse or active front end) wired to an FPC-N54 ProtoNode over embedded Modbus RTU.",
  "summary": "The FPC-N54 profile 2 serves an ACS880 as 32 BACnet objects: relay and digital-input states, run, fault, warning, ready and local/remote status bits, a commandable run/stop BV, analog input readbacks, and speed, frequency, current, power, energy, temperature and fault-code AVs plus a commandable speed reference.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": "Standard ACS880 firmware",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Instances are not contiguous (no BI 3-5, BV 3/6, AV 5/8/10-13/15/17).",
    "Output-Power reads in kW or HP depending on the drive's unit setting.",
    "Heatsink-Temperature is a percentage of the fault limit (about 94 % = warning, 100 % = trip), not degrees.",
    "Direction control is not available over BACnet; wire it to a digital input if needed."
  ],
  "source": {
    "title": "ProtoNode FPC-N54 Start-up Guide For Interfacing ABB Products: ACS800, ACS880, ACS880-CTDD",
    "doc_number": null,
    "revision_date": "Document Revision 3.C, February 2020 (Web Configurator Template Revision 4)",
    "url": "https://baltimoreaircoil.com/download_api_endpoint/1089/gatewaybacnetacs880protonodefpc-n54startupguide_20200709.pdf",
    "unofficial": true,
    "host": "Baltimore Aircoil Company"
  },
  "integration": {
    "summary": "Point the drive's run/stop and reference 1 at the embedded fieldbus, then command BV 10 and AV 16 from the BMS and read run, fault and speed feedback.",
    "minimum_points": [
      {
        "ref": "BV 10",
        "name": "Run-Stop Command",
        "why": "Run/stop command (1 = run)"
      },
      {
        "ref": "AV 16",
        "name": "Input-Reference-1",
        "why": "Speed reference, 0-100 %"
      },
      {
        "ref": "BV 0",
        "name": "RUN-STOP MONITOR",
        "why": "Running status"
      },
      {
        "ref": "BV 4",
        "name": "Local-Remote",
        "why": "Remote control active (1 = remote)"
      },
      {
        "ref": "AV 0",
        "name": "Output-RPM",
        "why": "Motor speed, RPM"
      },
      {
        "ref": "AV 4",
        "name": "Output-Current",
        "why": "Output current"
      },
      {
        "ref": "AV 6",
        "name": "Output-Power",
        "why": "Output power"
      },
      {
        "ref": "BV 2",
        "name": "OK-Fault-Monitor",
        "why": "Drive fault (1 = fault)"
      },
      {
        "ref": "AV 18",
        "name": "Active-Fault-Code",
        "why": "Active fault code"
      }
    ],
    "enable": "Set the run/stop source to the embedded fieldbus and the speed reference to EFB ref1 (parameter 28.11 in scalar mode, 22.11 in DTC mode); skip this for monitoring only.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Drive embedded fieldbus: 58.01 = Modbus RTU, 58.03 = 1, 58.04 = 19.2 kbps, 58.05 = 8 None 1, then power-cycle the drive.",
      "Choose profile 2 (ACS880) in the ProtoNode web configurator.",
      "ProtoNode default IP address 192.168.1.24, subnet 255.255.255.0; it serves BACnet IP or BACnet MS/TP."
    ],
    "gotchas": [
      "Direction cannot be commanded over BACnet.",
      "AV 7 is percent of the trip limit, not a temperature."
    ]
  },
