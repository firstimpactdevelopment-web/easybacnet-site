  "manufacturer": "LS Electric",
  "manufacturer_slug": "ls-electric",
  "model": "H100+ (H100 Plus) HVAC drive, embedded BACnet MS/TP",
  "model_slug": "h100-plus",
  "aliases": [
    "H100+",
