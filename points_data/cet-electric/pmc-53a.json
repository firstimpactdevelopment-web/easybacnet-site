{
  "manufacturer": "CET Electric",
  "manufacturer_slug": "cet-electric",
  "model": "PMC-53A multifunction panel meter, BACnet MS/TP",
  "model_slug": "pmc-53a",
  "aliases": [
    "PMC-53A",
    "PMC53A",
    "CET PMC-53A"
  ],
  "equipment_type": "Energy meter (multifunction panel meter)",
  "applies_to": "CET Electric Technology PMC-53A multifunction panel meters (serial model) with BACnet MS/TP from firmware V1.00.03.",
  "summary": "The PMC-53A is the serial-port multifunction panel meter in CET's PMC-53A family, with BACnet MS/TP from firmware V1.00.03. It uses the same register-number instance scheme as the PMC-53A-E but prints different object names (Uan, Ubn, Ucn ...) and adds DI5-DI6, DO3-DO4 and their counters.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "V1.00.03 or later",
  "default_device_instance": 26001,
  "access_inferred": false,
  "notes": [
    "Object instances equal the meter's Modbus register numbers, so they are not consecutive.",
    "Units are taken from the table where printed; rows that share a merged units cell were filled from the measurement type. BACnet has no kvarh/kVAh units, so those registers report in kWh units per the manual.",
    "The Clear AVs take 65280 (0xFF00) to run the action.",
    "Superscript note markers printed after some names (1, 2, 3 for 3P3W behaviour, * for kvarh/kVAh units) are dropped from the names.",
    "In 3P3W wiring the per-phase line-to-neutral values have no meaning, and Uan/Ubn/Ucn THD and angle report the line-to-line values.",
    "The table lists AO1 and AO2 at AI 90 and AI 92; RTD3 is not printed."
  ],
  "source": {
    "title": "PMC-53A User Manual, Appendix C BACnet MS/TP Implementation",
    "doc_number": "V2.2",
    "revision_date": "2026-02-04",
    "url": "https://www.cet-global.com/uploadfiles/2026/02/PMC-53A%20User%20Manual%20V2.2%20(20260204).pdf"
  },
  "integration": {
    "summary": "Set the PMC-53A protocol to BACnet MS/TP with a MAC address and baud rate, then read power, energy, voltages and currents. Set PT/CT ratios and wiring mode first if the BMS manages setup.",
    "minimum_points": [
      {
        "ref": "AI 30",
        "name": "P Total",
        "why": "Total active power, kW"
      },
      {
        "ref": "AI 500",
        "name": "kWh Import",
        "why": "Energy imported, kWh"
      },
      {
        "ref": "AI 502",
        "name": "kWh Export",
        "why": "Energy exported, kWh"
      },
      {
        "ref": "AI 14",
        "name": "ULL average",
        "why": "Average line-line voltage, V"
      },
      {
        "ref": "AI 22",
        "name": "I average",
        "why": "Average current, A"
      },
      {
        "ref": "AI 54",
        "name": "PF Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 56",
        "name": "Frequency",
        "why": "Frequency, Hz"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP master at 9600, 19200 or 38400 baud; device instance defaults to 26001.",
      "Analog Values 6000-6047 hold PT/CT ratios, wiring mode and demand settings."
    ],
    "gotchas": [
      "Writing 65280 to AV 9601 clears all energy registers."
    ]
  },
