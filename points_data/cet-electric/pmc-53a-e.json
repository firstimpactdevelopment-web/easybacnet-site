{
  "manufacturer": "CET Electric",
  "manufacturer_slug": "cet-electric",
  "model": "PMC-53A-E multifunction panel meter, BACnet MS/TP",
  "model_slug": "pmc-53a-e",
  "aliases": [
    "PMC-53A-E",
    "PMC53A-E",
    "CET PMC-53A-E"
  ],
  "equipment_type": "Energy meter (multifunction panel meter)",
  "applies_to": "CET Electric Technology PMC-53A-E multifunction panel meters (application V2.00.00, firmware V1.00.00) on BACnet MS/TP.",
  "summary": "The PMC-53A-E is a multifunction panel power meter that acts as a BACnet MS/TP smart actuator (B-SA). Its Analog Inputs carry voltages, currents, power, power factor, energy, demand, THD, K-factor, angles, unbalance and pulse counters, with object instances matching its Modbus register numbers; Analog Values hold PT/CT and wiring setup plus clear commands; four DIs and two DOs are Binary Inputs and Outputs.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Application V2.00.00, firmware V1.00.00",
  "default_device_instance": 26001,
  "access_inferred": false,
  "notes": [
    "Object instances equal the meter's Modbus register numbers, so they are not consecutive.",
    "Units are taken from the table where printed; rows that share a merged units cell were filled from the measurement type. BACnet has no kvarh/kVAh units, so those registers report in kWh units per the manual.",
    "The Clear AVs take 65280 (0xFF00) to run the action.",
    "Optional measurement objects (I4, AI, Ir, RTD1-3, AO1-2) only report when the matching option is fitted.",
    "The printed table gives AI 40 (Sa) the unit kvar; it is listed as kVA here like Sb and Sc."
  ],
  "source": {
    "title": "PMC-53A-E User Manual, Appendix C BACnet MS/TP Implementation",
    "doc_number": "V2.2",
    "revision_date": "2026-04-01",
    "url": "https://www.cet-global.com/uploadfiles/2026/04/PMC-53A-E%20User%20Manual%20V2.2%20(20260401).pdf"
  },
  "integration": {
    "summary": "Set the PMC-53A-E protocol to BACnet MS/TP with a MAC address and baud rate, then read power, energy, voltages and currents. Set PT/CT ratios and wiring mode first if the BMS manages setup.",
    "minimum_points": [
      {
        "ref": "AI 30",
        "name": "P Total",
        "why": "Total active power, kW"
      },
      {
        "ref": "AI 500",
        "name": "kWh Import",
        "why": "Energy imported, kWh"
      },
      {
        "ref": "AI 502",
        "name": "kWh Export",
        "why": "Energy exported, kWh"
      },
      {
        "ref": "AI 14",
        "name": "ULL Average",
        "why": "Average line-line voltage, V"
      },
      {
        "ref": "AI 22",
        "name": "I Average",
        "why": "Average current, A"
      },
      {
        "ref": "AI 54",
        "name": "PF Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 56",
        "name": "Freq.",
        "why": "Frequency, Hz"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP master at 9600, 19200 or 38400 baud; device instance defaults to 26001.",
      "Analog Values 6000-6047 hold PT/CT ratios, wiring mode and demand settings."
    ],
    "gotchas": [
      "Writing 65280 to AV 9601 clears all energy registers."
    ]
  },
