    "enable": null,
    "heartbeat": null,
    "remote_sensors": "With BV 1 Outdoor Sensor Enable at 0, the 681 uses the outdoor temperature the BAS writes to AV 1; at 1 it uses its own outdoor sensor.",
    "setup": [
      "MS/TP MAC address 0-127, default 60.",
      "Baud 9600-115200, default 76800; even parity, 1 stop bit.",
      "Wire A, B and Ref to the BACnet A, B and ground; do not connect the BACnet ground to the 681 ground screws.",
      "Device Communication Control password is tekmar1151."
    ],
    "gotchas": [
      "The 681 only senses and reports; the BAS must run the boiler, pumps or electric heat.",
      "Reset Snow Detection Request (BV 4) clears a detected snow condition."
    ]
