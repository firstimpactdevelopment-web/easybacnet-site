  "manufacturer_slug": "accuenergy",
  "model": "Acuvim II with AXM-BMS BACnet MS/TP module",
  "model_slug": "acuvim-ii-axm-bms",
  "aliases": [
    "Acuvim II",
    "Acuvim IIR",
    "Acuvim IIE",
    "Acuvim IIW",
    "AXM-BMS",
    "Acuvim II BACnet MS/TP",
    "1040E2102"
  ],
  "equipment_type": "Power and energy meter (BACnet MS/TP module)",
  "applies_to": "Accuenergy Acuvim II series power meters fitted with the AXM-BMS BACnet MS/TP communication module.",
  "summary": "The AXM-BMS clips onto an Acuvim II power meter and serves 56 fixed Analog Value objects over BACnet MS/TP: frequency, voltages, currents, power per phase and total, power factor, unbalance, demand, energy totals and THD. No mapping is needed. The manual lists object names and data types but no units.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "All objects are Analog Values; the manual has no access column and they are listed here as read-only measurements.",
    "The object table gives no engineering units; the manual's worked example says P_rms (AV 17) reads in watts. Check the units property on site.",
    "Energy objects (AV 39-47) and THD objects (AV 48-55) are integer data types (UINT32/SINT32) in the manual.",
    "Object names are short codes (e.g. P_rms, Ulavg_rms); each description gives the meter parameter it carries.",
    "AV 46 is printed as 'Reactive_Energy_NET S' in the table."
  ],
  "source": {
    "title": "BACnet for Acuvim II Series Power Meter, User's Manual",
    "doc_number": "1040E2102 (V2.0.1)",
    "revision_date": "2023-08",
    "url": "https://www.accuenergy.com/wp-content/uploads/Acuvim-II-Power-Meter-BACnet-User-Manual-EN.pdf"
  },
  "integration": {
    "summary": "Set the meter's second port protocol to BACNET, then set the module's MS/TP MAC address, baud rate and max info frames from the meter's NET pages and reset the module. Read total power, imported energy, demand, power factor, current and voltage.",
    "minimum_points": [
      {
        "ref": "AV 17",
        "name": "P_rms",
        "why": "Total active power, W"
      },
      {
        "ref": "AV 39",
        "name": "Active_Energy_IMP",
        "why": "Imported active energy total"
      },
      {
        "ref": "AV 33",
        "name": "P_dema",
        "why": "Active power demand"
      },
      {
        "ref": "AV 25",
        "name": "S_rms",
        "why": "Total apparent power"
      },
      {
        "ref": "AV 29",
        "name": "PF_rms",
        "why": "Total power factor"
      },
      {
        "ref": "AV 12",
        "name": "Iavg_rms",
        "why": "Average phase current"
      },
      {
        "ref": "AV 8",
        "name": "Ulavg_rms",
        "why": "Average line-to-line voltage"
      },
      {
        "ref": "AV 0",
        "name": "Freq_rms",
        "why": "Supply frequency"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Module defaults: MS/TP MAC 0, 9600 baud, max info frames 1.",
      "On the meter set S34 Protocol 2 = BACNET, then use the NET pages to set the MAC address (0-127), baud rate (9600, 19200, 38400 or 76800) and max info frames (1-255).",
      "Reset the module from the fourth NET page after any change.",
      "Up to 127 MS/TP masters; frames up to 480 bytes."
    ],
    "gotchas": [
      "Default MAC is 0; give each module a unique MS/TP address before connecting.",
      "No units are documented; check energy and THD scaling against the meter display."
    ]
  },
