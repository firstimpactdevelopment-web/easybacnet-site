  "equipment_type": "Pressurisation pump / degassing station controller",
  "applies_to": "Reflex Control Touch controllers on Variomat, Variomat Giga, Reflexomat, Servitec and Servimat pressurisation, make-up and degassing units, fitted with the Anybus CompactCom M30 BACnet MS/TP module (software V1.02).",
  "summary": "Reflex pressurisation, make-up and vacuum degassing units use the Control Touch controller. With the plug-in Anybus BACnet MS/TP module it publishes system pressure, vessel level, valve positions, run hours, make-up volume, output and input states, operating mode and a long list of fault and warning flags as Binary and Analog Values. The BMS can switch pumps or compressors and valves on and off and set the minimum operating pressure p0.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Control Touch software V1.02",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "The source is in German; object names are as printed (English abbreviations) and descriptions are translated.",
    "Many objects apply only to one unit type (Servitec, Servimat or CT-MK200); the unit type is shown in AV 8.",
    "Commands BV 0-9 and BV 95-98 are separate ON and OFF objects (write 1 to act).",
    "On Servitec units with 2x2-way ball valves, BV 6-9 and BV 12-13 drive the PV and CD valves instead.",
    "BV 14 is printed 'BO relplen. valve'."
  ],
  "integration": {
    "summary": "Set the device number, MAC address and baud in the Control Touch service menu. Read AV 0 system pressure, AV 1 level, the mode BVs and the ER fault and warning flags. Remote commands work only when remote control is enabled in the controller and the unit is in AUTO.",
    "minimum_points": [
      {
        "ref": "AV 9",
        "name": "SET value p0 (mbar)",
        "why": "Minimum operating pressure p0, mbar (if > 0)"
      },
      {
        "ref": "BV 24",
        "name": "Mode: AUTO",
        "why": "Unit in AUTO mode"
      },
      {
        "ref": "AV 0",
        "name": "AI sys. pressure (mbar)",
        "why": "System pressure, mbar"
      },
      {
        "ref": "AV 1",
        "name": "AI water level (%)",
        "why": "Vessel level, %"
      },
      {
        "ref": "BV 10",
        "name": "BO pump/compr. 1",
        "why": "Pump/compressor 1 output on"
      },
      {
        "ref": "BV 18",
        "name": "BI FB pump/comp. 1",
        "why": "Pump/compressor 1 run feedback"
      },
      {
        "ref": "BV 16",
        "name": "BO coll. fault",
        "why": "Common fault output"
      },
      {
        "ref": "BV 28",
        "name": "ER 01 min. press.",
        "why": "Fault: below minimum pressure"
      },
      {
        "ref": "BV 29",
        "name": "ER 02.1 low water",
        "why": "Fault: low water"
      }
    ],
    "enable": "Remote control from the BACnet master must be enabled in the Control Touch; binary commands are only taken over in AUTO mode.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Settings > Service > Anybus module (shown only when a module is detected).",
      "Device number (instance) 1-4194302, MAC address 0-127.",
      "Baud 9600, 19200, 38400 or 76800.",
      "5-pin connector: 1 common, 2 Data-, 3 shield, 4 Data+."
    ],
    "gotchas": [
      "Fit or remove the module only with the controller powered off.",
      "The network LED flashes red on a BACnet timeout (no new message within the set time)."
    ]
  },
