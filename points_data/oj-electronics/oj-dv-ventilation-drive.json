  "equipment_type": "EC/PM fan motor frequency drive",
  "applies_to": "OJ Electronics OJ-DV ventilation drives for EC/PM fan motors, first generation and GEN II.",
  "summary": "The OJ-DV fan drive has BACnet MS/TP on its RS-485 terminals and RJ12 ports. A short list of Binary Values gives run, alarm reset, fire mode and the alarm and warning flags; Integer Values carry the speed setpoint, speed limits, ramps and running data. BACnet MS/TP has to be switched on first, through the OJ PC tool or Modbus.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "AOC 2.50 or later",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Integer Value objects (IV) carry scaled whole numbers; values marked x0.01 have two implied decimals (IV 0 = 10000 means 100.00 %).",
    "The first-generation OJ-DV note (67855 10/20) lists BV 0-22 and IV 0-20 with the same names; BV 23-24 (STO) and IV 21-27 come from the GEN II note only.",
    "The GEN II table also prints a CurrentTimeHigh1 row with no object ID; it is left out here.",
    "Writing 0 to BV 4 turns BACnet MS/TP off; it comes back only through Modbus or protocol auto-detect."
  ],
  "source": {
    "title": "DV GEN II BACnet application note (OJ DV BACnet MS/TP protocol)",
    "doc_number": "670092",
    "revision_date": "05/24",
    "url": "https://ojelectronics.com/drives/wp-admin/admin-ajax.php?action=productdownload&media_id=63476983&filename=670092-05-24-DV+GEN+II+BACNET+APPLICATION+NOTE_GB_Web.pdf&view=true"
  },
  "integration": {
    "summary": "Enable BACnet MS/TP on the drive, then write the speed setpoint to IV 0 and set BV 0 to run. Read IV 8 and IV 7 for actual speed and output, and the BV alarm flags for faults; BV 1 resets alarms.",
    "minimum_points": [
      {
        "ref": "BV 0",
        "name": "Motor ON/OFF",
        "why": "Run command (1 = on); clears on any error"
      },
      {
        "ref": "IV 0",
        "name": "Prc Set",
        "why": "Speed setpoint, 0-10000 = 0-100.00 %"
      },
      {
        "ref": "BV 1",
        "name": "Reset Alarms",
        "why": "Alarm reset (1 = reset)"
      },
      {
        "ref": "IV 8",
        "name": "RPM Out",
        "why": "Motor speed, rpm"
      },
      {
        "ref": "IV 7",
        "name": "Prc Out",
        "why": "Output level, x0.01 %"
      },
      {
        "ref": "IV 12",
        "name": "Power In (Filtered)",
        "why": "Input power, W"
      },
      {
        "ref": "BV 15",
        "name": "Internal Stop",
        "why": "Internal stop alarm"
      },
      {
        "ref": "BV 10",
        "name": "Rotor Blocked",
        "why": "Rotor blocked alarm"
      }
    ],
    "enable": "BACnet MS/TP must be enabled (OJ PC tool or Modbus coils); then BV 0 starts and stops the motor.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Out of the box the drive talks Modbus (address 54, 38400 baud, no parity, 1 stop bit); BACnet MS/TP is switched on from the OJ PC tool (Alternative device communications) or through Modbus coils.",
      "MS/TP settings: baud 9600-115200, MAC 0-127, Max Master 1-127, device instance 0-4194302 (Modbus holding registers).",
      "OJ publishes an EDE file for the object list on its product page."
    ],
    "gotchas": [
      "BV 0 drops back to 0 on any error, so the BMS has to set it again after the fault is cleared.",
      "Do not write BV 4 = 0: it turns BACnet MS/TP off until it is re-enabled through Modbus.",
      "IV 0 reflects the actual setpoint when analog control is active."
    ]
  },
