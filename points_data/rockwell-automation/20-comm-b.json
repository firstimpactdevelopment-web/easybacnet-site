  "equipment_type": "Variable frequency drive (BACnet MS/TP adapter)",
  "applies_to": "Allen-Bradley PowerFlex 70 (Standard and Enhanced Control), 700, 700VC and 700H drives fitted with the 20-COMM-B BACnet MS/TP adapter.",
  "summary": "The 20-COMM-B is the BACnet MS/TP communication adapter for PowerFlex 7-Class drives. It exposes a fixed object set: drive I/O terminals as AI, AO, BI and BO objects; references, measurements, fault history, ramp times and a parameter mailbox as Analog Values; and drive status and commands as Binary Values. A few output objects are only supported on some drives, noted in the descriptions.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "FRN 1.xxx",
  "default_device_instance": 160000,
  "access_inferred": false,
  "notes": [
    "Table 4.A marks each object for PowerFlex 70 Standard, 70 Enhanced Control, 700 Standard, 700 Vector Control and 700H; unsupported objects are noted in the descriptions.",
    "AO and BO objects only drive the terminals when the drive output select parameter is set to Param Cntl (value given in the description).",
    "AV 6 and AV 11 accept only 0 (reset) when written.",
    "Object instance gaps (BI 6-9, BV 6-9) are not used.",
    "Source copy is hosted on a reseller CDN; the manual is Rockwell publication 20COMM-UM013C-EN-P."
  ],
  "source": {
    "title": "BACnet MS/TP Adapter 20-COMM-B FRN 1.xxx User Manual",
    "doc_number": "20COMM-UM013C-EN-P",
    "revision_date": "2006-10",
    "url": "https://d14aeh40s5zf9b.cloudfront.net/userfiles/productdocuments/ALBR20COMMK/SPEC_47784925_SpecificationSheet.pdf",
    "unofficial": true,
    "host": "reseller CDN (cloudfront)"
  },
  "integration": {
    "summary": "Set drive parameter 90 [Speed Ref A Sel] to 22 (DPI Port 5) so the network reference works, write a % speed reference to AV 0 and start/stop with BV 10. Read BV 1, AV 2, AV 3, BV 3 and the fault codes for monitoring; BV 13 clears faults.",
    "minimum_points": [
      {
        "ref": "BV 10",
        "name": "Run/Stop",
        "why": "Run/stop command (1 = run)"
      },
      {
        "ref": "AV 0",
        "name": "Reference 1 (%)",
        "why": "Speed reference, %"
      },
      {
        "ref": "BV 13",
        "name": "Clear Faults",
        "why": "Fault reset (write 1)"
      },
      {
        "ref": "BV 1",
        "name": "Running",
        "why": "Running status"
      },
      {
        "ref": "AV 2",
        "name": "Output Frequency (Hz)",
        "why": "Output frequency, Hz"
      },
      {
        "ref": "AV 3",
        "name": "Output Current (Amps)",
        "why": "Output current, A"
      },
      {
        "ref": "BV 3",
        "name": "Fault",
        "why": "Drive fault"
      },
      {
        "ref": "AV 12",
        "name": "Fault 1",
        "why": "Latest fault code"
      }
    ],
    "enable": "Drive parameter 90 [Speed Ref A Sel] = 22 (DPI Port 5) makes the drive follow the network reference; BV 10 then starts and stops it.",
    "heartbeat": "Adapter parameter 03 [Comm Loss Time] (default 10 s, 0-180 s, 0 = off) sets when a network loss is detected; parameter 02 [Comm Loss Action] decides the response (default fault; also stop, zero data, hold last or send fault configuration from parameters 04/05).",
    "remote_sensors": null,
    "setup": [
      "MAC address is set in binary on DIP switches SW1-SW7 before power-up; reset or power-cycle the adapter after changing it.",
      "Device instance default 160000, set with adapter parameter 11 [Device Instance]; reset the adapter to apply.",
      "Baud rate is adapter parameter 06 [Baud Rate Cfg]: Autobaud (default), 9600, 19200, 38400 or 76800; reset after a change."
    ],
    "gotchas": [
      "Commands written over BACnet are volatile; after an adapter reset or power cycle the BMS must write them again.",
      "AO 1, BI 12 and BO 2 exist only on PowerFlex 700VC and 700H; AO 0, BO 0 and BO 1 are not supported on PowerFlex 70 Standard and 700 Standard."
    ]
  },
