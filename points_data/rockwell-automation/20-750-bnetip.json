  ],
  "equipment_type": "Variable frequency drive (BACnet IP option module)",
  "applies_to": "Allen-Bradley PowerFlex 753 and 755 drives fitted with the 20-750-BNETIP BACnet/IP option module.",
  "summary": "The 20-750-BNETIP option module serves a fixed object set from a PowerFlex 753 or 755 over BACnet IP: drive status and commands as Binary Values, references, measurements, fault history and eight parameter mailboxes as Analog Values, plus a few I/O terminal objects that exist on the 753 only.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": "FRN 1.xxx",
  "default_device_instance": 100,
  "access_inferred": false,
  "notes": [
    "Table 3 marks each object for the 753 and 755; 753-only objects are noted in the description. The drive parameter number is given where the table prints one.",
    "BI 1 is printed as 'B11' in the table; it sits between BI 0 and BI 2.",
    "AV 10 is reserved.",
    "Copy hosted on archive.org (manualzilla upload), not on rockwellautomation.com."
  ],
  "source": {
    "title": "PowerFlex 750-Series BACnet/IP Option Module 20-750-BNETIP User Manual",
    "doc_number": "750COM-UM005B-EN-P",
    "revision_date": "2014-06",
    "url": "https://archive.org/download/manualzilla-id-5928861/5928861.pdf",
    "unofficial": true,
    "host": "archive.org"
  },
  "integration": {
    "summary": "Write a % speed reference to AV 0 (the manual's basic-control steps) and start/stop with BV 10; BV 12 picks reference 2. Read BV 1, AV 2, AV 3, BV 3 and the fault codes for monitoring; BV 13 clears faults.",
    "minimum_points": [
      {
        "ref": "BV 10",
        "name": "Run/Stop",
        "why": "Run/stop command (1 = run)"
      },
      {
        "ref": "AV 0",
        "name": "Speed Reference A",
        "why": "Speed reference (basic-control reference, %)"
      },
      {
        "ref": "BV 13",
        "name": "Clear Faults",
        "why": "Fault reset (write 1)"
      },
      {
        "ref": "BV 1",
        "name": "Active",
        "why": "Running status"
      },
      {
        "ref": "AV 2",
        "name": "Output Frequency (Hz)",
        "why": "Output frequency, Hz"
      },
      {
        "ref": "AV 3",
        "name": "Output Current (Amps)",
        "why": "Output current, A"
      },
      {
        "ref": "BV 3",
        "name": "Fault",
        "why": "Drive fault"
      },
      {
        "ref": "AV 12",
        "name": "Fault 1",
        "why": "Latest fault code"
      }
    ],
    "enable": "The drive's speed reference and start sources must be assigned to the option module's port; BV 10 then starts and stops the drive.",
    "heartbeat": "Device parameter 17 [Comm Loss Time] (default 10 s, 0 disables) sets the network-loss timeout; host parameters 33 [Comm Flt Action] and 34 [Idle Flt Action] set the response (default: fault the drive).",
    "remote_sensors": null,
    "setup": [
      "An IP address jumper picks the address source: on pins 2-3 (default) with parameter 16 [DHCP] disabled it uses 192.168.0.1 / 255.255.255.0; on pins 1-2 it uses DHCP or the address parameters.",
      "Default device instance 100 (parameter 18 [Device Instnc]); reset the module after changing it.",
      "BACnet IP UDP port is parameter 19 [Device Port], default 47808.",
      "Read/WriteProperty(Multiple), Who-Is/I-Am and Who-Has/I-Have are supported."
    ],
    "gotchas": [
      "Commands written over BACnet are volatile; after a module reset or power cycle the BMS must write them again.",
      "The manual's basic-control steps use AV 0 'Speed Reference A' as the % reference, while AV 19/20 map to drive parameters 545/550; check which one the drive uses.",
      "AV 6, AV 7 and AV 11 accept only 0 (reset) when written."
    ]
  },
