      },
      {
        "ref": "AI 2",
        "name": "Unknown Alarm Category",
        "why": "Alarm category from an unknown device"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Console port settings: V-R interface, 9600 baud, odd parity, 7 data bits, 1 stop bit.",
      "Bac_device_id defaults to 50,000 (range 1-4,194,303); set it in the QuickServer web configurator.",
      "Node IDs must start at 1 and run in sequence; the node ID becomes the leading digits of that device's object instances, and the profile's address must match the tank, sensor or input number in the console."
    ],
    "gotchas": [
      "Tank and sensor points use X001-style instances where X is the node ID; build them per site from the guide's tables."
    ]
  },
