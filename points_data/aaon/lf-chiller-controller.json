{
  "manufacturer": "AAON",
  "manufacturer_slug": "aaon",
  "model": "LF Chiller Controller",
  "model_slug": "lf-chiller-controller",
  "aliases": [
    "AAON LF Chiller",
    "LF Chiller Main Controller",
    "G059100",
    "SS1131",
    "DT005683-001",
    "LF chiller BACnet"
  ],
  "equipment_type": "DX chiller controller",
  "applies_to": "AAON LF series one- or two-circuit DX chillers with the LF Chiller Main Controller, optional pumping package and waterside economizer.",
  "summary": "The LF Chiller Main Controller runs one- or two-circuit AAON DX chillers, with optional pumping and waterside economizer, and has an on-board BACnet MS/TP port. The object map has 52 read-only analog inputs, 34 analog values (setpoints, reset limits, run command and relay enables), 112 read-only binary inputs for status, faults, warnings and lockouts, and a multistate input for the unit mode.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "DT005683-001/SS1131 v1.00 and later",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The guide gives no read/write column; AI, BI and MI are shown read-only and AV writable from the object types and the limit ranges.",
    "Analog value limits are printed as bare numbers; ranges are shown as printed, without units.",
    "Several binary inputs are marked For Future Use.",
    "Source: Appendix D BACnet parameters, guide pages 58-63."
  ],
  "source": {
    "title": "LF Chiller Controller Technical Guide",
    "doc_number": "G059100 Rev. 01D",
    "revision_date": "2020-11",
    "url": "https://www.aaon.com/hubfs/Controls%20Literature/G059100-LFCHILLER-01C-201106.pdf"
  },
  "integration": {
    "summary": "Connect the on-board MS/TP port and set MAC address, device ID and baud on the LCD. The BAS runs the chiller with AV 31 Auto/Run/Off; AV 1-4 set the leaving water setpoint range and its reset signal limits, and AI 4 shows the setpoint in use. Monitor the operating status MI, leaving water temperature and the fault BIs.",
    "minimum_points": [
      {
        "ref": "AV 31",
        "name": "Auto/Run/Off Command",
        "why": "Chiller command: 0 auto, 1 run, 2 off"
      },
      {
        "ref": "AV 30",
        "name": "Reset Unit Lockout {1 = Reset }",
        "why": "Write 1 to reset a unit lockout"
      },
      {
        "ref": "MI 1",
        "name": "Operating Status",
        "why": "Current unit mode"
      },
      {
        "ref": "AI 4",
        "name": "Active Leaving Water Setpoint",
        "why": "Leaving water setpoint in use"
      },
      {
        "ref": "AI 2",
        "name": "Entering Water Temperature",
        "why": "Entering water temperature"
      },
      {
        "ref": "AI 3",
        "name": "Leaving Water Temperature",
        "why": "Leaving water temperature"
      },
      {
        "ref": "BI 2",
        "name": "Proof of Water Flow",
        "why": "Water flow switch made"
      },
      {
        "ref": "BI 3",
        "name": "Emergency Shutdown",
        "why": "Emergency shutdown input"
      }
    ],
    "enable": "AV 31 Auto/Run/Off Command (0 = Auto, 1 = Run, 2 = Off) runs the chiller from the BAS; BI 1 shows the Run/Stop input. AV 30 resets a unit lockout.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MAC address, device ID (up to seven digits) and MS/TP baud rate are set on the controller's LCD BACnet screens."
    ],
    "gotchas": [
      "There is no single leaving water setpoint AV; AV 1-4 set the max/min temperatures and the reset voltages that map to them."
    ]
  },
