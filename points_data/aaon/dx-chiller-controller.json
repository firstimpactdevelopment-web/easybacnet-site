{
  "manufacturer": "AAON",
  "manufacturer_slug": "aaon",
  "model": "DX Chiller Controller",
  "model_slug": "dx-chiller-controller",
  "aliases": [
    "AAON DX Chiller Controller",
    "Main DX Chiller Controller",
    "G054280",
    "SS1149",
    "AAON DX chiller BACnet"
  ],
  "equipment_type": "DX chiller controller",
  "applies_to": "AAON packaged DX chillers (non-Turbocor compressors) with the Main DX Chiller Controller, refrigerant modules and optional waterside economizer and evaporative condenser modules.",
  "summary": "The Main DX Chiller Controller controls leaving water temperature on AAON DX chillers and has an on-board BACnet MS/TP port. The object map has 54 read-only analog inputs (water and refrigerant temperatures and pressures for circuits A and B, WSE and evaporative condenser data), 39 analog values (setpoints, run command, relay enables) and 86 read-only binary inputs for status, faults, warnings and lockouts, plus one multistate input for the unit mode.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Controller code version 1.00 and later",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The guide gives no read/write column; AI, BI and MI are shown read-only and AV writable from the object types and the limit ranges.",
    "Circuit A and B points (prefix A- / B-) and the WSE and evaporative condenser (EVAP) points report only when those modules are fitted.",
    "Binary input descriptions are the guide's value type column (Status, Alarm, Fault, Warning, Lockout).",
    "Source: Appendix F BACnet parameters, guide pages 63-68."
  ],
  "source": {
    "title": "DX Chiller Controller Technical Guide",
    "doc_number": "G054280 Rev. 01B",
    "revision_date": "2020-02",
    "url": "https://www.aaon.com/hubfs/Controls%20Literature/G054280-DXCHILLER-01B-200203.pdf"
  },
  "integration": {
    "summary": "Connect the on-board MS/TP port and set MAC address, device ID and baud on the LCD. The BAS starts and stops the chiller with AV 34 Auto/Run/Off and sets the leaving water target with AV 1. Monitor the operating status MI, the water temperatures and the system alarm BI.",
    "minimum_points": [
      {
        "ref": "AV 34",
        "name": "Auto/Run/Off Command",
        "why": "Chiller command: 0 auto, 1 run, 2 off"
      },
      {
        "ref": "AV 1",
        "name": "Chilled Water Target Temperature",
        "why": "Chilled water target, 35-75 °F"
      },
      {
        "ref": "AV 33",
        "name": "Reset Unit Lockout { 1 = Reset }",
        "why": "Write 1 to reset a unit lockout"
      },
      {
        "ref": "MI 1",
        "name": "Operating Status",
        "why": "Current unit mode"
      },
      {
        "ref": "AI 2",
        "name": "Chilled Water In Temperature",
        "why": "Entering chilled water temperature"
      },
      {
        "ref": "AI 3",
        "name": "Chilled Water Out Temperature",
        "why": "Leaving chilled water temperature"
      },
      {
        "ref": "BI 2",
        "name": "Proof of Water Flow",
        "why": "Water flow switch made"
      },
      {
        "ref": "BI 6",
        "name": "Active System Alarm Status",
        "why": "Active system alarm"
      }
    ],
    "enable": "AV 34 Auto/Run/Off Command (0 = Auto, 1 = Run, 2 = Off) runs the chiller from the BAS; BI 1 shows the Run/Stop input. AV 33 resets a unit lockout.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MAC address, device ID (up to seven digits) and MS/TP baud rate are set on the controller's LCD BACnet screens."
    ],
    "gotchas": [
      "AV 35-39 switch the EVAP drain valve and main board relays 5-8 on or off directly."
    ]
  },
