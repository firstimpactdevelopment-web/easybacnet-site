{
  "manufacturer": "Schneider Electric",
  "manufacturer_slug": "schneider-electric",
  "model": "PowerLogic PM5300 power meter (BACnet IP)",
  "model_slug": "powerlogic-pm5300",
  "aliases": [
    "PM5300",
    "PM5320",
    "PM5340",
    "PM5341",
    "PowerLogic PM5320 BACnet",
    "METSEPM5320",
    "METSEPM5340"
  ],
  "equipment_type": "Power and energy meter (BACnet IP)",
  "applies_to": "Schneider Electric PowerLogic PM5300 series power meters with the Ethernet port (PM5320, PM5340, PM5341) using BACnet IP.",
  "summary": "The PM5300 Ethernet models have a fixed, read-only BACnet IP object list: about 110 Analog Inputs for current, voltage, unbalance, power, power factor, energy (including 4 tariffs), demand, THD and meter setup values, plus Binary Inputs for two digital inputs and outputs and Multi-State Inputs for power system type, VT connection, demand methods and I/O modes. Object instances match the meter register numbers.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": "2.00 or later (BACnet IP support)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Points from the BACnet objects section (pages 50-57) of user manual EAV15107-EN11.",
    "BACnet IP is only on the models with an Ethernet port (PM5320, PM5340, PM5341).",
    "Compared with the PM5500 list, the PM5300 has 4 tariffs instead of 8, no per-phase demand objects and two digital inputs.",
    "Each AI has a default COV increment in the manual (e.g. 50 A for currents, 10 kW for power, 100 kWh for energy).",
    "The object list is fixed; nothing is writable except Out_Of_Service and COV_Increment."
  ],
  "source": {
    "title": "PowerLogic PM5300 series User manual (BACnet objects section)",
    "doc_number": "EAV15107-EN11",
    "revision_date": "10/2023",
    "url": "https://download.se.com/files?p_Doc_Ref=EAV15107-EN"
  },
  "integration": {
    "summary": "Enable BACnet IP on the meter and set a unique Device ID, then read total power, energy, demand, power factor, average voltage and current. The meter is monitoring-only over BACnet.",
    "minimum_points": [
      {
        "ref": "AI 3060",
        "name": "Active Power - Total",
        "why": "Total active power, kW"
      },
      {
        "ref": "AI 2700",
        "name": "Active Energy Delvd",
        "why": "Active energy delivered, kWh"
      },
      {
        "ref": "AI 3766",
        "name": "Dmd - Active Power Present",
        "why": "Present active power demand, kW"
      },
      {
        "ref": "AI 3084",
        "name": "Power Factor - Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 3026",
        "name": "Voltage - Avg L-L",
        "why": "Average line-to-line voltage"
      },
      {
        "ref": "AI 3010",
        "name": "Current - Avg",
        "why": "Average phase current"
      },
      {
        "ref": "AI 3110",
        "name": "Frequency",
        "why": "System frequency, Hz"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Enable BACnet IP and set the Device ID, UDP port (default 47808) and BBMD/foreign-device settings on the display (Maint > Setup > Comm > BACnet) or the meter webpages.",
      "The Device ID ships as the last 6 digits of the serial number; it must be unique on the network.",
      "Up to 20 COV subscriptions are supported on AI, BI and MSI objects; no segmentation, max APDU 1476 bytes."
    ],
    "gotchas": [
      "All configuration objects are read-only over BACnet; change meter settings on the display, webpages or ION Setup.",
      "Out_Of_Service is writable for testing; set it back to false or the BMS sees the test value instead of the measurement.",
      "Digital input and output status BIs read 0 = on, 1 = off as printed in the manual; check the polarity on site."
    ]
  },
