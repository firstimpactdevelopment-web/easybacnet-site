  "equipment_type": "Fan coil thermostat",
  "applies_to": "Schneider Electric SpaceLogic TC903 and TC907 Protocol Series fan coil thermostats (on/off or proportional valves, 3-speed or EC fan, 2-pipe or 4-pipe).",
  "summary": "The TC900 Protocol Series are wall thermostats for 2-pipe and 4-pipe fan coils that talk BACnet MS/TP or Modbus RTU on one RS-485 port. Over BACnet MS/TP the BMS can switch the thermostat on and off, set the mode, fan speed, setpoints and occupancy override, and read room temperature, valve outputs, fan speed and sensor faults. A room temperature can also be written from the BMS.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Temperature objects follow the unit chosen in BO 14: values are sent in °C or °F.",
    "AO 20-22 apply to EC fan models; AO 24 is TC907 only. Objects for features a model lacks can be ignored.",
    "The guide marks AO, BO and MSO Present_Value as writable; AI, BI and MSI are read-only.",
    "Setpoint ranges are bounded by AO 1, AO 2, AO 6, AO 7 and the operation mode; MO 3 limits the modes MO 0 can select.",
    "A Warm Start restarts the thermostat; a Cold Start resets it to factory settings."
  ],
  "integration": {
    "summary": "Select BACnet as the protocol, set the MS/TP address and baud at the thermostat, then use BO 0 for on/off, MO 0 for mode, MO 1 for fan speed and AO 0 for the setpoint. Read AI 2 room temperature, the fan speed and valve status BIs, and BI 5/BI 6 for sensor faults.",
    "minimum_points": [
      {
        "ref": "BO 0",
        "name": "Thermostat on or off",
        "why": "Thermostat on/off"
      },
      {
        "ref": "MO 0",
        "name": "Operation mode",
        "why": "Mode: 1 cool, 2 heat, 3 vent, 4 auto"
      },
      {
        "ref": "MO 1",
        "name": "Fan mode",
        "why": "Fan speed: 1 high, 2 med, 3 low, 4 auto"
      },
      {
        "ref": "MO 7",
        "name": "Occupancy override",
        "why": "Occupancy override: 2 occ, 3 unocc"
      },
      {
        "ref": "AO 0",
        "name": "Set-point",
        "why": "Room setpoint"
      },
      {
        "ref": "AI 2",
        "name": "Actual room temperature",
        "why": "Room temperature"
      },
      {
        "ref": "BI 7",
        "name": "Occupancy status",
        "why": "Occupied / unoccupied state"
      },
      {
        "ref": "BI 0",
        "name": "Cooling valve (4-pipe)",
        "why": "Cooling valve output state"
      },
      {
        "ref": "BI 4",
        "name": "Heating valve (4-pipe)",
        "why": "Heating valve output state"
      },
      {
        "ref": "BI 5",
        "name": "Temp sensor, short circuit",
        "why": "Temperature sensor short-circuit fault"
      }
    ],
    "enable": "BACnet and Modbus share the RS-485 port; BACnet must be selected (parameter setting or BO 8 = 0).",
    "heartbeat": null,
    "remote_sensors": "Set BO 12 = 1 (BACnet input) and write the room temperature to AO 14 Temp. input; otherwise the thermostat uses its own or the external sensor chosen in BO 7.",
    "setup": [
      "MS/TP master, baud 9600, 19200, 38400 or 76800 (38400 recommended).",
      "MAC address 0-127, set at the thermostat (menu items 13, 15, 16) or AO 23.",
      "Device instance 0-4,194,302 is writable.",
      "Wiring on terminals A (+) and B (-); the RS-485 port is not isolated."
    ],
    "gotchas": [
      "Changing BO 8 to Modbus drops BACnet communication.",
      "Don't change the baud rate while the network is running.",
      "Temperature values switch between °C and °F with BO 14; set the BMS units to match.",
      "A Cold Start clears all settings to factory defaults."
    ]
  },
