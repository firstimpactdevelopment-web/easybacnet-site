{
  "manufacturer": "Schneider Electric",
  "manufacturer_slug": "schneider-electric",
  "model": "SEZ7656 Zoning System Rooftop Unit Controller",
  "model_slug": "sez7656-zoning-rtu-controller",
  "aliases": [
    "SEZ7656",
    "SEZ7656R1045B",
    "SEZ7656H1045B",
    "SEZ7656F1045B",
    "SEZ7656E1045B"
  ],
  "equipment_type": "Rooftop unit controller for zoning systems",
  "applies_to": "Schneider Electric SEZ7656 rooftop controllers (R conventional, H heat pump, F modulating heat, E economizer) that run a rooftop unit for a group of SEZ7260 zone controllers.",
  "summary": "The SEZ7656 is the rooftop unit controller of the Schneider Electric SEZ7000 zoning system. It reads PI demands from its SEZ7260 zones over the shared BACnet MS/TP network and stages the rooftop unit, with bypass damper or VFD static pressure control and, on some models, economizer and CO2 functions. No BMS bindings are needed for the system to run.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "76000 + MAC address (e.g. 76063 at MAC 63)",
  "access_inferred": false,
  "notes": [
    "The guide marks each object for the R, H, F and E models; objects on only some models say so in the description.",
    "Ranges and state texts come from the guide's SEZ7656 range and enumeration tables (matched by type and instance).",
    "Access is from the guide's R / R/W column (R/W shown as W); the guide does not mention a priority array."
  ],
  "source": {
    "title": "BACnet Integration Manual - Zoning Product Series SEZ7260 & SEZ7656 Series",
    "doc_number": "IG-SE7000-BNETSEZ7XXX-US.EN.4.2013.v1",
    "revision_date": "2013-04",
    "url": "https://download.se.com/files?p_Doc_Ref=IG-SE7000-BNETSEZ7XXX-A4"
  },
  "integration": {
    "summary": "Command occupancy with MV 14 and system mode with MV 15 (MV 17 on heat pump models). Read discharge and return air temperatures (AI 1, AI 2), the highest zone demands AV 17 / AV 18, fan status BI 1 and the bypass damper or VFD output AI 4. The BMS can supply outdoor temperature on AV 19.",
    "minimum_points": [
      {
        "ref": "MV 14",
        "why": "BMS occupancy command",
        "name": "GUI Occupancy"
      },
      {
        "ref": "MV 15",
        "why": "System mode: off / auto (non heat pump models)",
        "name": "GUI System Mode"
      },
      {
        "ref": "MV 17",
        "why": "Off / auto / cool / heat / emergency heat",
        "name": "GUI System Mode HP"
      },
      {
        "ref": "BI 1",
        "why": "Supply fan (G) output on / off",
        "name": "GUI G Fan"
      },
      {
        "ref": "AI 1",
        "why": "Discharge air temperature",
        "name": "GUI Discharge Air Temp"
      },
      {
        "ref": "AI 2",
        "why": "Return air temperature",
        "name": "GUI Return Air Temp"
      },
      {
        "ref": "AV 17",
        "why": "Highest zone PI heating demand",
        "name": "GUI Highest PI Heat Demand"
      },
      {
        "ref": "AV 18",
        "why": "Highest zone PI cooling demand",
        "name": "GUI Highest PI Cool Demand"
      },
      {
        "ref": "AI 4",
        "why": "Bypass damper / VFD output",
        "name": "GUI By-Pass Damper / VFD"
      },
      {
        "ref": "BV 3",
        "why": "Communication status: Down / Up",
        "name": "Sta Comm Lost Status"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "The BMS can write outdoor temperature (AV 19); BV 6 Outdoor Temp Override selects it.",
    "setup": [
      "Default device instance 76000 + MAC; default device name is the model number plus MAC. Both are writable.",
      "Baud rate auto-detects at power-up; after a network speed change the device keeps the old speed for 2.5 minutes unless re-powered.",
      "Each SEZ7260 zone points to its SEZ7656 by the RTC MAC address."
    ],
    "gotchas": [
      "If the controller goes offline, values the BMS wrote to room temperature, outdoor temperature and occupancy are released.",
      "Schneider recommends removing configuration (Cfg) objects from the BAS after setup to cut polling."
    ]
  },
