{
  "manufacturer": "Schneider Electric",
  "manufacturer_slug": "schneider-electric",
  "model": "PowerLogic EM4200 energy meter (BACnet MS/TP)",
  "model_slug": "powerlogic-em4200",
  "aliases": [
    "EM4200",
    "EM42xx",
    "PowerLogic EM4200",
    "EM4200 BACnet",
    "EM4200 BACnet object list",
    "Schneider energy meter BACnet MS/TP"
  ],
  "equipment_type": "Power and energy meter (BACnet MS/TP)",
  "applies_to": "Schneider Electric PowerLogic EM4200 series (EM42xx) power and energy meters with BACnet MS/TP.",
  "summary": "The EM4200 meter has a fixed BACnet MS/TP object list: 103 Analog Inputs for energy, power, demand, power factor, voltage, current and frequency (totals, per phase, and import/export), 26 Analog Values for commands and setup (system type, CT and PT settings, demand intervals, pulse output, MS/TP address and baud), and 22 Binary Inputs that flag voltage, current, frequency, phase-loss, power-factor and configuration errors.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "OS 1.00.20, RS 1.00.07 (device object values in the list)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Energy totals, max demands and most setup values are kept in non-volatile memory.",
    "AV 1 Command takes one of four codes: 30078 clears energy accumulators, 21212 resets max demand, 21211 starts a new demand sub-interval, 16498 clears pulse counters. It always reads 0.",
    "BI 17-22 flag that control of a setting (CT size, pulse weight, address, meter mode, analog output, CT interface) is overridden; they are not measurement faults.",
    "The device object instance defaults to a pseudo-random value; Object_Name, Location and Max_Master are writable.",
    "Source is Schneider's Excel object list (EM4200_BACnet_ObjectList.xlsx); the file prints no revision or date."
  ],
  "source": {
    "title": "EM4200 BACnet object list (Excel version)",
    "doc_number": "EM4200_BACnet_ObjectList",
    "revision_date": null,
    "url": "https://download.schneider-electric.com/files?p_Doc_Ref=EM4200_BACnet_ObjectList"
  },
  "integration": {
    "summary": "Set the MS/TP MAC address and baud rate and a unique device instance, then read energy (AI 1), total power (AI 4), demand (AI 12), power factor (AI 7), average voltage and current. Use AV 1 Command only when you need to reset energy or demand. Watch the phase-loss and range-error BIs for wiring or supply problems.",
    "minimum_points": [
      {
        "ref": "AI 1",
        "name": "kWh",
        "why": "Active energy total, kWh"
      },
      {
        "ref": "AI 4",
        "name": "kW_Total",
        "why": "Total active power, kW"
      },
      {
        "ref": "AI 12",
        "name": "kW_Present_Demand",
        "why": "Present active power demand, kW"
      },
      {
        "ref": "AI 7",
        "name": "PF_Avg",
        "why": "Average power factor"
      },
      {
        "ref": "AI 8",
        "name": "Voltage_LL_Avg",
        "why": "Average line-to-line voltage"
      },
      {
        "ref": "AI 10",
        "name": "Current_Avg",
        "why": "Average phase current"
      },
      {
        "ref": "BI 9",
        "name": "Phase_Loss_L1",
        "why": "Phase loss on L1"
      },
      {
        "ref": "BI 10",
        "name": "Phase_Loss_L2",
        "why": "Phase loss on L2"
      },
      {
        "ref": "BI 11",
        "name": "Phase_Loss_L3",
        "why": "Phase loss on L3"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MS/TP MAC address 1-127 (AV 19) and baud 9600, 19200, 38400, 76800 or 115200 (AV 20).",
      "The device instance is pseudo-random out of the box; set a unique one before adding the meter.",
      "Max_Master defaults to 127 and is writable (1-127); Max_Info_Frames is 1.",
      "System type (AV 2), CT size and type (AV 3-5) and PT ratio (AV 6) must match the installation or all readings are wrong.",
      "No segmentation; max APDU 480 bytes; APDU timeout 3000 ms with 3 retries."
    ],
    "gotchas": [
      "Writing AV 1 with 30078 clears the energy accumulators; use it with care.",
      "Setup AVs are stored in non-volatile memory; don't write them cyclically.",
      "BI 17-22 report overridden control of CT size, pulse weight, address, meter mode, analog output and CT interface."
    ]
  },
