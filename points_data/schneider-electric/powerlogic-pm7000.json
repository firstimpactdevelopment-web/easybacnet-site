{
  "manufacturer": "Schneider Electric",
  "manufacturer_slug": "schneider-electric",
  "model": "PowerLogic PM7000 series power and energy meter (BACnet IP)",
  "model_slug": "powerlogic-pm7000",
  "aliases": [
    "PM7000",
    "PM7351DUW",
    "PM7252DUW",
    "PM7151DUW",
    "PM7142DUW",
    "PM7351",
    "PM7252",
    "PM7151",
    "PM7142",
    "PowerLogic Intuitive PM7000"
  ],
  "equipment_type": "Power and energy meter (BACnet IP)",
  "applies_to": "Schneider Electric PowerLogic PM7000 series panel meters PM7351DUW, PM7252DUW, PM7151DUW and PM7142DUW with BACnet IP, firmware 1.0.1.",
  "summary": "The PM7000 series are panel-mount three-phase power and energy meters with Modbus Ethernet and BACnet IP. The BACnet object list is read-only: Analog Inputs for meter setup, energy (delivered, received, net and up to 16 tariffs), current, voltage, unbalance, power, power factor, frequency, demand (last, present, predicted, peak) and harmonic distortion, plus Binary and Multi-state Inputs for the digital I/O, relays and their modes. Instances follow the meter's register numbers.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": "1.0.1 (application 1.0.31)",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The PICS has a column per model; objects not on every model are marked in the description. PM7142 has no second digital input/output, no relays and only tariffs 1-2; tariffs 5-16 are PM7351 only.",
    "No units are printed in the PICS, so units are left blank.",
    "Only Out_Of_Service and COV_Increment are writable on the objects, so the list is read-only data.",
    "Instance numbers match the PowerLogic register scheme used on the PM5300/PM5500 lists (e.g. AI 3060 Active Power - Total).",
    "The PICS lists 'THD' and 'thd' harmonic objects separately; it doesn't define the difference."
  ],
  "integration": {
    "summary": "Enable BACnet IP on the meter with a unique device ID, then read total power, delivered energy, demand, power factor, voltage and current. The meter is monitoring-only over BACnet.",
    "minimum_points": [
      {
        "ref": "AI 3060",
        "name": "Active Power - Total",
        "why": "Total active power"
      },
      {
        "ref": "AI 2700",
        "name": "Active Energy Delvd",
        "why": "Active energy delivered"
      },
      {
        "ref": "AI 3766",
        "name": "Dmd - Active Power Pres",
        "why": "Present active power demand"
      },
      {
        "ref": "AI 3084",
        "name": "Power Factor - Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 3026",
        "name": "Voltage - Avg L-L",
        "why": "Average line-to-line voltage"
      },
      {
        "ref": "AI 3010",
        "name": "Current - Avg",
        "why": "Average phase current"
      },
      {
        "ref": "AI 3110",
        "name": "Frequency",
        "why": "System frequency"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet IP only; the Network Port object allows foreign-device registration (FD_BBMD_Address and FD_Subscription_Lifetime are writable).",
      "Device Object_Identifier, Object_Name, Location, Description, APDU timeout and retries are writable.",
      "No segmentation."
    ],
    "gotchas": [
      "Out_Of_Service is writable on every object; leave it false."
    ]
  },
