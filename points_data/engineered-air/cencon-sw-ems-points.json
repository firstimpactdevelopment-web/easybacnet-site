  "integration": {
    "summary": "Set the Gateway ID, MAC and baud (MS/TP) or IP settings on the CenCon service display, save and cycle power. On the CenCon_SW device (Gateway ID + 55) write EMS_Fan_Enable to start the unit and Discharge_Air_Setpoint in tenths of °F, at priority 3-7. Read the demand AIs here and the sensors, fan and alarm status from the CenCon device.",
    "minimum_points": [
      {
        "ref": "BO 0",
        "name": "EMS_Fan_Enable",
        "why": "Start/enable command"
      },
      {
        "ref": "AO 0",
        "name": "Discharge_Air_Setpoint",
        "why": "Discharge air setpoint, tenths of °F (780 = 78 °F)"
      },
      {
        "ref": "AO 1",
        "name": "Damper_Minimum_Position",
        "why": "OA damper minimum position, mV"
      },
      {
        "ref": "AI 0",
        "name": "Heating_Demand",
        "why": "Heating demand, %"
      },
      {
        "ref": "AI 1",
        "name": "Cooling_Demand",
        "why": "Cooling demand, %"
      }
    ],
    "enable": "EMS_Fan_Enable (BO 0) is the BMS start enable. Separate binaries enable each expansion module (cooling, gas heat, humidifier, electric heat, energy recovery), dehumidification, maximum reheat and pre-cool; EMS_Economizer_Disable turns off the economizer.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Defaults: Gateway ID 270000, MAC 3, Max Master 127, Max Info Frames 20, MS/TP DNET 2707; BACnet IP 192.168.0.10/24, UDP 47808, IP DNET 2708.",
      "MS/TP baud 19200 or 38400; terminals BnA/BnB for BACnet, SmA/SmB for Modbus; a 120 ohm EOL resistor and bias resistors are built in.",
      "With several CenCons on one network the Gateway ID, MAC, MS/TP DNET, IP address and IP DNET must be unique; keep Gateway IDs at least 100 apart.",
      "Save settings on the Communication tab and cycle power for changes to take effect."
    ],
    "gotchas": [
      "Writes must use priority 3 to 7.",
      "No decimals: send 78.5 °F as 785.",
      "Damper minimum position is a raw signal in mV; on a 2-10 V actuator 6000 mV = 50 %."
    ]
  }
}
