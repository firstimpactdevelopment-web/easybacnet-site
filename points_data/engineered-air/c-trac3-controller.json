  "integration": {
    "summary": "Set the BACnet MS/TP or IP parameters on the PGD1 display (Networking > BMS Configurations) and cycle power. Command the unit with BV 42, write the discharge setpoint to AV 25 and the minimum damper position to AV 66, and read back AV 26 and the actual setpoint AV 14. Monitor blower status, discharge temperature, heating and cooling status and the alarm BVs.",
    "minimum_points": [
      {
        "ref": "BV 42",
        "name": "EMS Unit Command On/Off",
        "why": "Unit on/off command (1 = on)"
      },
      {
        "ref": "AV 25",
        "name": "EMS Discharge Air Setpoint",
        "why": "Discharge air setpoint (write-only), 0-255 °F"
      },
      {
        "ref": "AV 66",
        "name": "EMS Damper Minimum Position Setpoint",
        "why": "Minimum OA damper position, 0-100 %"
      },
      {
        "ref": "AV 1044",
        "name": "Unit On/Off Status",
        "why": "Unit on/off status"
      },
      {
        "ref": "BV 10",
        "name": "Blower Status",
        "why": "Blower running"
      },
      {
        "ref": "AV 12",
        "name": "Discharge Air Temperature",
        "why": "Discharge air temperature"
      },
      {
        "ref": "AV 14",
        "name": "Discharge Air Temperature Setpoint",
        "why": "Active discharge setpoint"
      },
      {
        "ref": "BV 36",
        "name": "Air Flow Problem",
        "why": "Airflow alarm"
      },
      {
        "ref": "BV 35",
        "name": "Sensor Failure Alarm",
        "why": "Any temperature sensor failed"
      },
      {
        "ref": "BV 41",
        "name": "Heat Fail Lockout",
        "why": "Heating failure lockout"
      }
    ],
    "enable": "BV 42 EMS Unit Command On/Off switches the unit (0 = off, 1 = on). With EMS control enabled the discharge setpoint equals the EMS setpoint. For night heat or morning warm-up the manual has the head end disable the economizer, set minimum position 0 %, set the discharge setpoint and enable the unit.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Defaults: device instance 77077; MS/TP baud 38400, address 77, Max Master 127, Max Info Frames 20.",
      "BACnet IP defaults: IP 172.16.0.1, UDP port 47808 (fixed).",
      "Settings are on the PGD1 display under Networking > BMS Configurations (password); change No to Yes to update, then cycle power.",
      "Connect the network before powering the controller so the network card comes up."
    ],
    "gotchas": [
      "Writes are held in RAM and lost on power loss unless saved with BV 49 Write to Flash; flash has limited write cycles, so don't save cyclically.",
      "Economizer, cooling and heating enables are inverted: Off = enabled.",
      "Read the setpoint back on AV 26, not AV 25."
    ]
  }
