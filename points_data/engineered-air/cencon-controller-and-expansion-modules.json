  "integration": {
    "summary": "These devices are read-only: start the unit and write setpoints on CenCon_SW. From the CenCon device read the supply fan and alarm relays, air proving, discharge, return and ambient temperatures, and the module devices for staging and flame/safety status.",
    "minimum_points": [
      {
        "ref": "BO 2",
        "name": "SA",
        "why": "Supply fan output on"
      },
      {
        "ref": "BI 2",
        "name": "FbB",
        "why": "Air proving switch"
      },
      {
        "ref": "BI 5",
        "name": "OCC",
        "why": "Occupied/unoccupied input"
      },
      {
        "ref": "AI 20",
        "name": "DA",
        "why": "Discharge air temperature, tenths of °F"
      },
      {
        "ref": "AI 16",
        "name": "RA",
        "why": "Return/room temperature, tenths of °F"
      },
      {
        "ref": "AI 19",
        "name": "AA",
        "why": "Ambient air temperature, tenths of °F"
      },
      {
        "ref": "BO 4",
        "name": "AL",
        "why": "Alarm output"
      }
    ],
    "enable": "Commands are not on these devices; use EMS_Fan_Enable and the module enables on the CenCon_SW device (Gateway ID + 55).",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Defaults: Gateway ID 270000, MAC 3, Max Master 127, Max Info Frames 20, MS/TP DNET 2707; BACnet IP 192.168.0.10/24, UDP 47808, IP DNET 2708.",
      "MS/TP baud 19200 or 38400; terminals BnA/BnB for BACnet, SmA/SmB for Modbus; a 120 ohm EOL resistor and bias resistors are built in.",
      "With several CenCons on one network the Gateway ID, MAC, MS/TP DNET, IP address and IP DNET must be unique; keep Gateway IDs at least 100 apart.",
      "Save settings on the Communication tab and cycle power for changes to take effect."
    ],
    "gotchas": [
      "Same instance numbers appear on different virtual devices; map by device instance as well as object.",
      "No decimals: temperatures are tenths of °F.",
      "Only fitted modules appear."
    ]
  }
}
