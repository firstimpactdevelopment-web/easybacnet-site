{
  "manufacturer": "Opera Electronics",
  "manufacturer_slug": "opera-electronics",
  "model": "Opera 6000 gas detector",
  "model_slug": "opera-6000",
  "aliases": [
    "Opera 6000",
    "Opera6000",
    "Opera 6000 gas detector",
    "LC30001"
  ],
  "equipment_type": "Gas detection sensor / monitor",
  "applies_to": "Opera Electronics Opera 6000 family of gas and indoor air quality detectors (A and B hardware), firmware 2x28.",
  "summary": "The Opera 6000 is a gas detector with one or two sensors, relays and an alarm output. On BACnet MS/TP it serves its own gas readings, ambient temperature, an input and the relay/alarm outputs. With BACnet enable P46 = 2 it also publishes the readings of up to 32 remote detectors (sensors A and B) on its local network.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "2x28 (x = A or B hardware), application BB4",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "AV 0 and AV 1 exist only with P46 = 1; AV 1 also needs a second sensor fitted.",
    "AV 100-131 and AV 200-231 exist only with P46 = 2; instance = 100 + remote number (sensor A) or 200 + remote number (sensor B).",
    "BO 1 is Relay 2 on A hardware and Alarm L2 on B hardware.",
    "A hardware has 2 relays; B hardware has 1 relay, 2 analog outputs and a binary input.",
    "Object types used: Analog Value, Binary Input, Binary Output and Device."
  ],
  "integration": {
    "summary": "Set P46 to 1 for the local readings or 2 to add remote detectors, then read the gas readings and the relay/alarm objects. The relay and alarm BOs can also be written from the BMS.",
    "minimum_points": [
      {
        "ref": "AV 0",
        "name": "Gas Reading 1",
        "why": "Gas reading, local sensor A"
      },
      {
        "ref": "AV 1",
        "name": "Gas Reading 2",
        "why": "Gas reading, local sensor B"
      },
      {
        "ref": "BO 0",
        "name": "Relay 1",
        "why": "Relay 1 state"
      },
      {
        "ref": "BO 1",
        "name": "Relay 2",
        "why": "Relay 2 / alarm L2 state"
      },
      {
        "ref": "BO 2",
        "name": "Alarm L3",
        "why": "Alarm 3 indication"
      }
    ],
    "enable": "Parameter P46 enables BACnet: 1 = local readings, 2 = local plus remote detectors.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MS/TP master at 9600, 19200, 38400 or 76800 baud.",
      "Device object name is limited to 22 characters."
    ],
    "gotchas": [
      "The gas reading objects change with P46, so rediscover the device after changing it."
    ]
  },
  "source": {
    "title": "BACnet Protocol Implementation Conformance Statement, Opera 6000 (PICS V1.6)",
    "doc_number": "LC30001",
    "revision_date": "2016-12-06 (rev 1.4)",
