  "integration": {
    "summary": "The BAS can run this heat pump in two ways: command occupancy (MO1) and let the controller hold its occupied/unoccupied setpoints, or act as the thermostat and send fan, Y1, Y2 and O calls directly (MO2-MO5). Space temperature can be overridden from the network on AO4, and MO6 forces an emergency shutdown.",
    "minimum_points": [
      {
        "ref": "MO 1",
        "name": "Occupancy Command",
        "why": "Occupied/unoccupied/bypass command"
      },
      {
        "ref": "MO 6",
        "name": "Emergency Overide",
        "why": "Network emergency shutdown"
      },
      {
        "ref": "AV 1",
        "name": "Occupied Cool",
        "why": "Occupied cooling setpoint (write rarely)"
      },
      {
        "ref": "AV 3",
        "name": "Occupied Heat",
        "why": "Occupied heating setpoint (write rarely)"
      },
      {
        "ref": "MO 7",
        "name": "Alarm Reset",
        "why": "Reset manual-reset alarms"
      },
      {
        "ref": "MI 2",
        "name": "Mode Status",
        "why": "Auto or shutdown status"
      },
      {
        "ref": "BI 2",
        "name": "Comp Cmd Status",
        "why": "Compressor commanded on/off"
      },
      {
        "ref": "AI 1",
        "name": "Space Temp",
        "why": "Space temperature"
      },
      {
        "ref": "AI 2",
        "name": "Discharge Air Temp",
        "why": "Discharge (supply) air temperature"
      },
      {
        "ref": "AI 9",
        "name": "Alarms Enumerated",
        "why": "Active alarm code"
      }
    ],
    "enable": "The sheet has no separate BAS-enable point. MO6 Emergency Overide puts the unit in shutdown (5) or back to normal (1). MO2-MO5 let the BAS send fan, compressor and reversing-valve calls directly.",
    "heartbeat": null,
    "remote_sensors": "AO4 Space temp Ovrd sends the space temperature from the network and supersedes the wired sensor. It is volatile and reverts to uncommanded after a power outage.",
    "setup": [
      "Set MV5 SensorSel to match the zone sensor (1=TAXXJ02, 2=TAXXA01)."
    ],
    "gotchas": [
      "AO points are volatile and revert to uncommanded after a power outage, so rewrite them after power is restored.",
      "To set ECM fan speeds, select the switch with MV1-MV3 (write 2), then set the speed in AV11-AV13.",
      "Alarm Reset only works once the alarm condition has cleared; hold it On for 20 seconds, then return it to Off.",
      "Treat the AV/MV setpoints as configuration and avoid cyclic writes; on other FX10 sheets these are flash-backed."
    ]
  }
