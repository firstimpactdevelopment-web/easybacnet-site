        "name": "SHIFT",
        "why": "Force day/night: 1 ToDay, 2 ToNight, 3 ExtendDay"
      },
      {
        "ref": "AV 1500",
        "name": "OFFSET",
        "why": "Shift of the reset curve, °F or °C"
      },
