  "equipment_type": "Water-cooled centrifugal chiller (via E-Link gateway)",
  "applies_to": "YORK YK centrifugal chillers with OptiView panel and an electro-mechanical or solid-state starter, connected through a YORK E-Link gateway over YorkTalk 3.",
  "summary": "The E-Link gateway reads the YK OptiView microboard over YorkTalk 3 and serves BACnet, N2, LON and Modbus objects. The EM/SSS sheet covers remote setpoint, current limit and run/stop, water temperatures and pressures, motor phase currents and voltages (solid-state starter), input power and energy, and the operation, safety, cycling and warning codes.",
  "bacnet_transport": [],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Every YorkTalk 3 E-Link sheet uses the same slot skeleton (P03 = AV 1 and so on); only the slots this chiller populates are listed, and slots marked not available on every program version are left out.",
    "Object names are the E-Link names printed on the sheet; the sheet also gives LON, N2 and Modbus addresses, not reproduced here.",
    "Access follows the sheet's Modbus function note: the remote slots AV 1-4 and BV 1-4 accept writes; the rest are read-only.",
    "Status code objects (MV) use the code tables in the sheet; it notes that BACnet multistate values are the printed code + 1. Printed states are shown from 0.",
    "The VSD sheet uses some slots for different values, so it is a separate entry."
  ],
  "source": {
    "title": "YK OptiView BAS E-Link points list, tab YK EM or SSS",
    "doc_number": null,
    "revision_date": "2019-04-12 (Rev K_04d)",
    "url": "https://docs.johnsoncontrols.com/chillers/api/khub/documents/9K1_I8TTfuZWaiBiiZxM8w/content"
  },
  "integration": {
    "summary": "Put the chiller in remote/ISN control at the panel, then start and stop it with the E-Link remote run/stop object and write the remote setpoint and current limit. Read the operating, safety and warning codes, run status and water temperatures.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "REM RUN STOP CMD",
        "why": "Remote start/stop (1 = run)"
      },
      {
        "ref": "AV 1",
        "name": "REM LEAVING CH LIQ TEMP SP",
        "why": "Remote leaving chilled liquid setpoint"
      },
      {
        "ref": "AV 2",
        "name": "REM MOTOR CURRENT SP",
        "why": "Remote current limit, %"
      },
      {
        "ref": "MV 5",
        "name": "UNIT CONTROL SOURCE",
        "why": "Must read ISN (BAS) for BMS control"
      },
      {
        "ref": "MV 1",
        "name": "UNIT OPERATION CODE",
        "why": "Unit operating status code"
      },
      {
        "ref": "BV 5",
        "name": "COMPR MOTOR STATUS",
        "why": "Chiller running"
      },
      {
        "ref": "AV 5",
        "name": "LEAVING CH LIQ TEMP",
        "why": "Leaving chilled liquid temperature"
      },
      {
        "ref": "AV 6",
        "name": "ENTERING CH LIQ TEMP",
        "why": "Entering chilled liquid temperature"
      },
      {
        "ref": "MV 2",
        "name": "UNIT SAFETY FAULT CODE",
        "why": "Safety (shutdown) fault code"
      },
      {
        "ref": "MV 4",
        "name": "UNIT WARNING CODE",
        "why": "Active warning code"
      }
    ],
    "enable": "The E-Link remote slots (AV 1-4, BV 1-4) are the BMS commands; the chiller panel must be set for remote (ISN/BAS) control for them to take effect.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The E-Link gateway talks to the chiller microboard over YorkTalk 3 and serves BACnet, N2, LON and Modbus; BACnet addressing is set on the E-Link.",
      "Check the chiller program version against the sheet's version table; availability codes (S/O/N) are per version."
    ],
    "gotchas": [
      "Status codes are multistate values offset by 1 from the printed code tables.",
      "Points marked optional (O) on the sheet report only on units with that option or program version."
    ]
  },
