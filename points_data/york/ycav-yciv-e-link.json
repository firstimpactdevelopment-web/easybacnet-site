  "equipment_type": "Air-cooled variable-speed screw chiller (via E-Link gateway)",
  "applies_to": "YORK YCAV and YCIV air-cooled screw chillers (1/2 and 3/4 compressor sections, microboard 031-02478), connected through a YORK E-Link gateway over YorkTalk 2.",
  "summary": "The E-Link gateway reads the YCAV/YCIV microboard over YorkTalk 2 (4800 baud) and serves BACnet, N2, LON and Modbus objects named by YorkTalk page: remote setpoint, ISN current and sound limits, start/stop, chilled liquid temperatures, per-system pressures, temperatures, run hours and starts, VSD values and status codes.",
  "bacnet_transport": [],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "This is a YorkTalk 2 E-Link sheet; objects are named by YorkTalk page (YT2_S01_P03 and so on), and only populated slots not marked unavailable on every version are listed.",
    "Access follows the sheet's Modbus function note: the remote slots AV 1-4 and BV 1-4 accept writes; the rest are read-only.",
    "Multistate states are shown as printed (from 0); this sheet does not say whether the BACnet value adds 1, so confirm by discovery (read the state text)."
  ],
  "source": {
    "title": "YCAV_YCIV BAS E-Link points list",
    "doc_number": null,
    "revision_date": "2014-08-25 (Rev K_03g)",
    "url": "https://docs.johnsoncontrols.com/chillers/api/khub/documents/F5MxE~19WRFrMvSKgqKvYA/content"
  },
  "integration": {
    "summary": "Put the chiller in remote/ISN control at the panel, then start and stop it with the E-Link remote run/stop object and write the remote setpoint and current limit. Read the operating, safety and warning codes, run status and water temperatures.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "YT2_S01_P07",
        "why": "Remote start/stop (1 = run)"
      },
      {
        "ref": "AV 1",
        "name": "YT2_S01_P03",
        "why": "Remote leaving chilled liquid setpoint"
      },
      {
        "ref": "AV 2",
        "name": "YT2_S01_P04",
        "why": "Remote current limit, %"
      },
      {
