  ],
  "equipment_type": "VRF BACnet gateway (up to 64 indoor units, H-Link)",
  "applies_to": "Hisense VRF systems on the H-Link (TB2) bus, up to 64 indoor units depending on version.",
  "summary": "Intesis-made BACnet server for Hisense VRF, published by Hisense Italy. It connects to the H-Link bus at the outdoor unit and serves BACnet IP and BACnet MS/TP: gateway-wide commands, an outdoor-unit block at (OU address x 25) + 1000 and one indoor-unit block per MAPS index at (index x 100) with on/off, mode, setpoint, fan, vane, air and coil temperatures, error code, filter, remote-controller permissions and dehumidification.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 246,
  "access_inferred": true,
  "notes": [
    "Indoor unit instance = (xxx x 100) + offset, xxx = unit index in Intesis MAPS; index 1 shown (100-111).",
    "Outdoor unit instance = (xx x 25) + 1000 + offset, xx = outdoor address 1-64; address 1 shown (1025-1031).",
    "Made by Intesis (HMS); the object table is the same as the Intesis Hitachi VRF BACnet server INBACHIT016O000/064O000 (listed separately), as Hisense VRF uses the same H-Link bus.",
    "The member table has no read/write column; access is inferred (outputs commandable, inputs read-only).",
    "Communication Status states are printed as 0-Not Exit, 1-Exist."
  ],
  "source": {
    "title": "Intesis BACnet Server - Hisense VRF User's Manual (HS-AC-BAC)",
    "doc_number": null,
    "revision_date": "04/2018 r1.0",
    "url": "https://www.hisense.it/wp-content/uploads/2022/08/UM_bacnet-intesis_201804.pdf"
  },
  "integration": {
    "summary": "Wire the H-Link (TB2) terminals of the outdoor unit to Port A (A3/A4, no polarity), configure the units in Intesis MAPS, send the project, then map each indoor unit's _C commands and _S status objects from its (index x 100) block.",
    "minimum_points": [
      {
        "ref": "BO 100",
        "name": "OxxUxxOn/Off_C",
        "why": "Start/stop indoor unit"
      },
      {
        "ref": "MO 100",
        "name": "OxxUxxMode_C",
        "why": "Mode command"
      },
      {
        "ref": "AO 100",
        "name": "OxxUxxSetpoint_C",
        "why": "Setpoint command"
      },
      {
        "ref": "MO 101",
        "name": "OxxUxxFanSpeed_C",
        "why": "Fan speed command (1 = auto)"
      },
      {
        "ref": "BI 100",
        "name": "OxxUxxOn/Off_S",
        "why": "Run status"
      },
      {
        "ref": "AI 100",
        "name": "OxxUxxSetpoint_S",
        "why": "Setpoint in use"
      },
      {
        "ref": "AI 102",
        "name": "OxxUxxInlet Temp.",
        "why": "Return air temperature"
      },
      {
        "ref": "BI 102",
        "name": "OxxUxxCommunication Status",
        "why": "Unit present on H-Link"
      },
      {
        "ref": "AI 106",
        "name": "OxxUxxUnit Error code",
        "why": "Fault code"
      }
    ],
    "enable": "No enable point is documented. Remote-controller permissions can be removed per unit with the Allow ... from RC_C objects (BO 102-105).",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Default device instance 246; change it in Intesis MAPS.",
      "BACnet IP: default IP 192.168.100.246, DHCP enabled by default. BACnet MS/TP uses Port B.",
      "Indoor unit index (xxx) is the unit's index in MAPS, not its H-Link address."
    ],
    "gotchas": [
      "On/Off, Mode, FanSpeed, Vane and Setpoint at instances 0-2 act on all units at once."
    ]
  },
