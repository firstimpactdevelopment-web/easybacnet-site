        "why": "Measured value PV"
      },
      {
        "ref": "AI 31",
        "name": "Current set point value SP",
        "why": "Current set point in use"
      },
      {
        "ref": "AO 32",
        "name": "Control signal of loop 1 [% x10] 2)",
        "why": "Loop 1 control signal, % x10"
      },
      {
        "ref": "BI 11",
        "name": "Automatic control/manual: 0 – auto 1 – manual",
        "why": "Auto (0) / manual (1)"
      },
      {
        "ref": "BI 17",
        "name": "Controller error – check the error register",
        "why": "Controller error"
      },
      {
        "ref": "BI 18",
        "name": "State of alarm 1.:1 – active 0 – inactive",
        "why": "Alarm 1 active"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
      "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
    ],
    "gotchas": [
      "Most outputs are configuration parameters stored in the controller; don't write them cyclically."
    ]
  },
