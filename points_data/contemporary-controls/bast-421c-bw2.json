  "equipment_type": "Thermostat for modulating 4-pipe FCUs (Wi-Fi BACnet IP)",
  "applies_to": "Contemporary Controls BAST-421C-BW2 Wi-Fi thermostats for 4-pipe fan coils with modulating or floating valves.",
  "summary": "The BAST-421C-BW2 is a Wi-Fi BACnet IP thermostat for 4-pipe fan coil units with modulating or floating cooling and heating valves and a multi-speed fan. It exposes temperatures, valve outputs, setpoints, system and fan modes, occupancy and setup values as BACnet objects.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": 700001,
  "access_inferred": false,
  "notes": [
    "From the BACnet Object Table (manual pages 30-37). The table is shared across the BASstat family; rows printed in grey (objects this model does not use) are left out.",
    "Access is from the Readable/Writable column; R/W objects are shown as writable.",
    "Temperature objects follow the Temperature Scale object (BV 6: 0 = °C, 1 = °F).",
    "Fan Speed Status (MV 5) states are printed starting at 0 (0 = Stop); Control Type (MV 7) lists only states 2 and 3 for this 4-pipe model."
  ],
  "source": {
    "title": "BAST-421C-BW2 Wireless Modulating Fan Coil Thermostat User Manual",
    "doc_number": "UM-15093500-AA2",
    "revision_date": null,
    "url": "https://www.ccontrols.com/pdf/um/BAST-421C-BW2-UserManual.pdf"
  },
  "integration": {
    "summary": "Turn the thermostat outputs on with On-Off Control (BV 5), set occupancy with Occupancy Command (BV 14), and write the system mode, cooling and heating setpoints and fan mode. Read the space temperature, occupancy status, output status and fan speed.",
    "minimum_points": [
      {
        "ref": "BV 5",
        "name": "On-Off Control",
        "why": "Thermostat outputs on/off (1 = on)"
      },
      {
        "ref": "BV 14",
        "name": "Occupancy Command",
        "why": "0 = occupied, 1 = unoccupied"
      },
      {
        "ref": "MV 1",
        "name": "System Mode",
        "why": "Cool, heat or ventilation mode"
      },
      {
        "ref": "AV 0",
        "name": "Cooling Temperature Setpoint",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 3",
        "name": "Heating Temperature Setpoint",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "MV 0",
        "name": "Fan Mode",
        "why": "1 = auto, then fan speeds"
      },
      {
        "ref": "AI 0",
        "name": "Current Temperature",
        "why": "Space temperature in use"
      },
      {
        "ref": "BI 0",
        "name": "Occupancy Status",
        "why": "0 = occupied, 1 = unoccupied"
      },
      {
        "ref": "BI 2",
        "name": "Cooling-heating Status",
        "why": "Heating/cooling output active"
      },
      {
        "ref": "MV 5",
        "name": "Fan Speed Status",
        "why": "Current fan speed, 0 = stop"
      }
    ],
    "enable": "On-Off Control (BV 5) switches the thermostat outputs. Occupancy Command (BV 14) only takes effect when the ESI contact is disabled in Lock (AV 18 bit value 64); by default occupancy comes from the ESI dry contact.",
    "heartbeat": "A space temperature written to Temperature Assigned Via BACnet (AV 1) is only used while the BMS keeps toggling Heartbeat (BV 16) within the Heartbeat Rate (AV 29) period, in seconds; otherwise the thermostat reverts to its own sensor.",
    "remote_sensors": "Set Temperature Source (MV 3) to 3 (Assigned through BACnet) and write the space temperature to AV 1, toggling BV 16 as a heartbeat.",
    "setup": [
      "BACnet IP over Wi-Fi; the UDP port defaults to 47808 (BAC0) and can be set in the Engineering menu (UdP) or by writing UDP Port No (AV 21).",
      "Device instance = devH x 1000 + devL in the Engineering menu, or write Device Instance (AV 20) once online.",
      "DHCP or static IP addressing is set from the thermostat's Wi-Fi setup pages.",
      "The manual gives 700001 as the default device instance."
    ],
    "gotchas": [
      "Lock (AV 18) is bit-coded: add the bit values to lock buttons, ignore the ESI or door contact, block changes to the comms settings or hand the relays to BACnet (512).",
      "The manual text calls the Lock object AV17 in places and the heartbeat rate AV-29; the object table numbers are used here.",
      "Relay control BVs only drive the relays when Lock bit 9 (512) hands the outputs to the BACnet supervisor."
    ]
  },
