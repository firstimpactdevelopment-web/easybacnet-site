        "why": "System overview word (bit-coded)"
      },
      {
        "ref": "AI 35",
        "name": "Transition Mode_Mode of Operation_Switch Position",
        "why": "Transition mode, mode and switch position"
      },
      {
        "ref": "AI 8",
        "name": "Source N Line Voltage LI -L2",
        "why": "Normal source voltage L1-L2"
      },
      {
        "ref": "AI 11",
        "name": "Source E Line Voltage L1-L2",
        "why": "Emergency source voltage L1-L2"
      },
      {
        "ref": "AI 14",
        "name": "Source N Frequency",
        "why": "Normal source frequency"
      },
      {
        "ref": "AI 15",
        "name": "Source E Frequency",
        "why": "Emergency source frequency"
      },
      {
        "ref": "AI 16",
        "name": "Current LI",
        "why": "Load current L1"
      },
      {
        "ref": "AI 51",
        "name": "Active Time Delay #",
        "why": "Active time delay number"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
      "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
    ],
    "gotchas": [
      "Time delay and voltage/frequency settings are writable here; changing them alters transfer behaviour.",
      "Unpolled rows do not appear as BACnet objects until enabled in the gateway's device profile page."
    ]
  },
