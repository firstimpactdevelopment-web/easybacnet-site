      {
        "ref": "AI 24",
        "name": "Watts Sum",
        "why": "Total active power (W sum)"
      },
      {
        "ref": "AI 30",
        "name": "Wh Import",
        "why": "Imported energy (Wh)"
      },
      {
        "ref": "AI 21",
        "name": "Volts Ave",
        "why": "Average voltage"
      },
      {
        "ref": "AI 42",
        "name": "Average Line to Line Volts",
        "why": "Average line-line voltage"
      },
      {
        "ref": "AI 22",
        "name": "Current Ave",
        "why": "Average current"
      },
      {
        "ref": "AI 27",
        "name": "Power Factor Ave",
        "why": "Average power factor"
      },
      {
        "ref": "AI 29",
        "name": "Freguency",
        "why": "Frequency"
      },
      {
        "ref": "AI 35",
        "name": "W Demand Import",
        "why": "Import power demand"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
      "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
    ],
    "gotchas": [
      "Setup outputs (system type, CT ratio, energy reset, node address) change meter configuration; leave them unpolled.",
      "Unpolled rows do not appear as BACnet objects until enabled in the gateway's device profile page."
    ]
  },
