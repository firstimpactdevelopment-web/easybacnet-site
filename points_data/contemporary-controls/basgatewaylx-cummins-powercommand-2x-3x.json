      {
        "ref": "BI 7",
        "name": "Genset Running",
        "why": "Genset running"
      },
      {
        "ref": "BI 6",
        "name": "Genset Supplying Load",
        "why": "Genset supplying load"
      },
      {
        "ref": "BI 8",
        "name": "Not in Auto",
        "why": "Control not in auto"
      },
      {
        "ref": "AI 1",
        "name": "Control Switch Position",
        "why": "Control switch position"
      },
      {
        "ref": "AI 52",
        "name": "Genset Total kW",
        "why": "Genset total kW"
      },
      {
        "ref": "AI 43",
        "name": "Genset LL Average Voltage",
        "why": "Average line-line voltage"
      },
      {
        "ref": "AI 47",
        "name": "Genset Average Current",
        "why": "Average current"
      },
      {
        "ref": "BI 5",
        "name": "Common Alarm",
        "why": "Common alarm"
      },
      {
        "ref": "AI 2",
        "name": "Most Recent Fault or Warning",
        "why": "Latest fault/warning code"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The BASgatewayLX presents each Modbus device as its own virtual BACnet device on BACnet IP; give it a unique device instance and Modbus address (serial) or IP address (Modbus TCP) when you add it with this profile.",
      "One BASgatewayLX handles up to 100 Modbus devices and 1000 polled points in total, so leave unneeded rows unpolled."
    ],
    "gotchas": []
  },
