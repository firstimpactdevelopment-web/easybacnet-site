  "integration": {
    "summary": "Connect the thermostat on MS/TP or IP, then drive it with the user mode (MV 400), heat/cool setpoints and the BMS occupancy point (BV 405, enabled by BV 507). Read current mode, space temperature for control and the stage output BVs. Turn on BV 511 only when you need to change gated configuration objects.",
    "minimum_points": [
      {
        "ref": "MV 400",
        "name": "USER_MODE",
        "why": "System mode: Off, Heat, Cool, Auto, E-Heat"
      },
      {
        "ref": "BV 405",
        "name": "BMS_OCC",
        "why": "BMS occupancy command (needs BV 507 enabled)"
      },
      {
        "ref": "AV 400",
        "name": "OCC_HT_SP",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "AV 401",
        "name": "OCC_CL_SP",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 103",
        "name": "NET_SP_TEMP",
        "why": "Network space temperature (with BV 407 enabled)"
      },
      {
        "ref": "MV 300",
        "name": "CURRENT_MODE",
        "why": "Current mode status: Off, Heat, Cool"
      },
      {
        "ref": "AV 104",
        "name": "SP_TEMP_CTRL",
        "why": "Space temperature used for control"
      },
      {
        "ref": "BV 205",
        "name": "G_OUT",
        "why": "Fan output status"
      },
      {
        "ref": "BV 200",
        "name": "Y1_OUT",
        "why": "First stage cooling output status"
      },
      {
        "ref": "BV 203",
        "name": "W1_OUT",
        "why": "First stage heating output status"
      }
    ],
    "enable": "BMS occupancy is used only when BMS Occupancy Enable (BV 507) is enabled; the BMS then writes BACnet BMS Occupancy (BV 405). Gated configuration objects need BACnet Config Write Enable (BV 511).",
    "heartbeat": "Network Space Temperature (AV 103) and Network Space Humidity (AV 105) must be rewritten at least every 5 minutes; if not, the control value falls back to the thermostat's own sensor (AI 100 / AI 101).",
    "remote_sensors": "Network Space Temperature (AV 103) and Network Space Humidity (AV 105) are written by the BMS and take effect only when BV 407 / BV 408 are enabled and the value was written within the last 5 minutes. AV 104 and AV 106 show the values the control logic actually uses.",
    "setup": [
      "Network port objects: MSTP_PORT (500) for MS/TP and IP_PORT (501) for BACnet IP, including BBMD foreign device settings.",
      "Up to 7 concurrent COV subscriptions, for BV and MV objects only, lifetime 1 s to 8 h."
    ],
    "gotchas": [
      "The BACnet Reliability property is used to flag objects that the current configuration does not use (e.g. no-sensor, no-output).",
      "Leave CFG_WR_EN (BV 511) disabled in normal operation so gated settings cannot be changed by accident."
    ]
  }
