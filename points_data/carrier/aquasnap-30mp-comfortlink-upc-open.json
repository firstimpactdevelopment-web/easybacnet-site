{
  "manufacturer": "Carrier",
  "manufacturer_slug": "carrier",
  "model": "AquaSnap 30MPA/30MPW 016-071 (ComfortLink, UPC Open BACnet option)",
  "model_slug": "aquasnap-30mp-comfortlink-upc-open",
  "aliases": [
    "30MP",
    "30MPA",
    "30MPW",
    "30MPA016-071",
    "30MPW016-071",
    "AquaSnap 30MP",
