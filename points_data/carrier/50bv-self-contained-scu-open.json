  "integration": {
    "summary": "Address the UC Open XP with its two rotary switches, set the MS/TP baud rate with the DIP switches, then command occupancy through BAS On/Off (MV 1001) and read System Mode, temperatures and alarms. Setpoints and enables are writable AVs and BVs.",
    "minimum_points": [
      {
        "ref": "MV 1001",
        "name": "keypad_ovrde",
        "why": "BAS occupancy: 1=Inactive (schedule), 2=Occ, 3=Unocc"
      },
      {
        "ref": "AV 3001",
        "name": "occ_cl_stpt",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 3002",
        "name": "occ_ht_stpt",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "AV 3029",
        "name": "sat_cl_stpt",
        "why": "Supply air setpoint (VAV units)"
      },
      {
        "ref": "MV 2002",
        "name": "run_status",
        "why": "System mode (cooling, heating, economize, shutdown...)"
      },
      {
        "ref": "BV 2008",
        "name": "occ_status",
        "why": "Current occupancy status"
      },
      {
        "ref": "AV 2035",
        "name": "ctrl_temp",
        "why": "Controlling temperature"
      },
      {
        "ref": "AV 1008",
        "name": "sa_temp",
        "why": "Supply air temperature"
      },
      {
        "ref": "BV 1003",
        "name": "sfan_status",
        "why": "Supply fan status"
      },
      {
        "ref": "BV 7013",
        "name": "comp_alarm",
        "why": "Compressor status alarm"
      }
    ],
    "enable": "BAS On/Off (MV 1001) sets occupancy from the network: state 1 (default, Inactive) follows the schedule, 2 forces occupied, 3 forces unoccupied. Forcing occupied or unoccupied disables Optimal Start. For BAS scheduling through BAS On/Off, the local Occupancy Schedules must be set to Disable.",
    "heartbeat": null,
    "remote_sensors": "The controller can take space temperature, setpoint adjustment, RH, CO2, outdoor air temperature, demand level and occupancy from the network (System Space Temperature AV 1902, System Setpoint Adjustment AV 1913, System Supply Air Temperature AV 1906 and the System network points). A BACnet network occupancy input can also be configured, but local occupancy schedules must be disabled to use it.",
    "setup": [
      "MAC address is set with the Tens and Ones rotary switches on the UC Open XP.",
      "DIP switches 1-2 set the MS/TP baud rate (9600 to 76.8 kbps); 3-4 select MS/TP or ARC156.",
      "The controller accepts three demand limit levels from the network, widening heating and cooling setpoints."
    ],
    "gotchas": [
      "Scheduling should come from one source only; an i-Vu download overwrites a local schedule set from an Equipment Touch or Field Assistant.",
      "Most VAV points (static pressure, SAT reset) only matter on VAV configurations; single-zone units control to space temperature."
    ]
  }
}
