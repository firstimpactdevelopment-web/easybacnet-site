  "integration": {
    "summary": "Put the thermostat on BACnet MS/TP, then command it like a wall stat: turn it on/off with OnOff, pick the mode and fan speed, and write the cooling and heating setpoints. Read back the effective setpoint, mode, fan and occupancy to confirm what the thermostat is actually doing. The points list gives no network timeout and no network space-temperature input.",
    "minimum_points": [
      {
        "ref": "BV 0",
        "name": "OnOff",
        "why": "Turns the thermostat on or off"
      },
      {
        "ref": "AV 4",
        "name": "Mode",
        "why": "Selects fan only, cool, heat or auto"
      },
      {
        "ref": "BV 28",
        "name": "UnoccupiedByNetwork",
        "why": "Occupancy command; 1 = unoccupied, 0 = occupied"
      },
      {
        "ref": "AV 0",
        "name": "SetPoint_SetPointCool",
        "why": "Cooling setpoint, 5-35 °C (41-95 °F)"
      },
      {
        "ref": "AV 1",
        "name": "SetPointHeat",
        "why": "Heating setpoint, 5-35 °C (41-95 °F)"
      },
      {
        "ref": "AV 6",
        "name": "FanSpeed",
        "why": "Fan auto/low/medium/high"
      },
      {
        "ref": "AV 5",
        "name": "ModeEffective",
        "why": "Mode actually running"
      },
      {
        "ref": "AV 13",
        "name": "OccupancyEffectiveHVAC",
        "why": "Resulting occupancy state"
      },
      {
        "ref": "AV 3",
        "name": "ReturnAirSensorEffective",
        "why": "Temperature the thermostat controls to"
      }
    ],
    "enable": "BV0 OnOff turns the thermostat on/off over the network. BI10 S1_8_UseBacnet shows whether the DIP switch has it set to BACnet (1) or Modbus (0).",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MS/TP at 9600, 19200, 38400 or 76800 baud, no parity, 8 data bits, 1 stop bit.",
      "A DIP switch selects BACnet or Modbus; read it back on BI10 S1_8_UseBacnet.",
      "The device instance is AV42 BacnetDeviceInstanceNumber, writable, range 10000 to 4000193.",
      "DIP switches also set AC vs fan coil (FC) system type, which changes which objects exist."
    ],
    "gotchas": [
      "Mode, fan speed and occupancy are integer-coded Analog Values, not Multistate objects.",
      "Several instances are reused: the same BI/BO number has an AC name and an FC name, and only one applies.",
      "Many writable AVs are the thermostat's technician (P) settings, so writing them changes the installer configuration."
    ]
  }
}
