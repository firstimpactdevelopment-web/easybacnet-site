{
  "manufacturer": "Eurotherm (Schneider Electric)",
  "manufacturer_slug": "eurotherm",
  "model": "nanodac recorder / controller",
  "model_slug": "nanodac",
  "aliases": [
    "nanodac",
    "Eurotherm nanodac",
    "nanodac recorder",
    "HA033110"
  ],
  "equipment_type": "Other equipment (process recorder / PID controller)",
  "applies_to": "Eurotherm nanodac graphical recorders and two-loop PID controllers with BACnet enabled.",
  "summary": "The nanodac is a compact paperless recorder with up to two PID loops, steam calculations and 30 virtual channels. Its BACnet object list is fixed: measured channels, loop setpoints and outputs, steam values and virtual channels as analog inputs; alarm thresholds, loop PV, setpoint, auto/manual, manual output and PID terms as writable analog values; alarm states as multistate inputs; and 30 user parameter address/value pairs that give indirect access to any other numeric parameter.",
  "bacnet_transport": [],
  "firmware": "V8.09",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Units are not printed (shown as a dash) for every analog object; they follow the channel and loop configuration.",
    "AV 53-112 are 30 UserParameter Address/Value pairs: write a parameter's Modbus address to the Address object, then read or write its value in the Value object. 32-bit integers cannot be reached this way; integers read with a resolution of 1.0.",
    "The Out_Of_Service property is writable on the BI, AI, AV and multistate objects.",
    "AI 20 and AI 21 (DigitalIO.2A2B.PV, DigitalIO.3A3B.PV) are both described as '1A1B PV' in the PICS; AV 16-22 (loop 2) are described as loop 1. The object names are given as printed.",
    "AI 14 is printed as 'Steam1.MassFlow' and AV 9 as 'Loop1.Main.PV' (no dot), unlike their neighbours.",
    "The PICS does not name the data link; vendor ID 10 (Schneider Electric), protocol revision 14, B-ASC."
  ],
  "source": {
    "title": "nanodac Recorder / Controller Protocol Implementation Conformance Statement",
    "doc_number": "HA033110 Issue 1",
    "revision_date": "2017-09-12",
    "url": "https://www.bacnetinternational.net/catalog/manu/eurotherm%20by%20schneider%20electric/HA033110_1_nanodac_BACnet_PICS_document.pdf",
    "unofficial": true,
    "host": "BACnet International product catalog"
  },
  "integration": {
    "summary": "Read the channel PVs (AI 1-8) and alarm states (MI 1-8) for monitoring. For control, write the loop target setpoint (AV 10), auto/manual (AV 11) and manual output (AV 12) for loop 1, or AV 17-19 for loop 2. Anything not in the list can be reached with the UserParameter address/value pairs.",
    "minimum_points": [
      {
        "ref": "AV 10",
        "name": "Loop.1.Main.TargetSP",
        "why": "Loop 1 target setpoint"
      },
      {
        "ref": "AV 11",
        "name": "Loop.1.Main.AutoMan",
        "why": "Loop 1 auto / manual select"
      },
      {
        "ref": "AV 12",
        "name": "Loop.1.OP.ManualOutVal",
        "why": "Loop 1 output in manual"
      },
      {
        "ref": "AI 1",
        "name": "Channel.1.Main.PV",
        "why": "Channel 1 measured value"
      },
      {
        "ref": "AI 2",
        "name": "Channel.2.Main.PV",
        "why": "Channel 2 measured value"
      },
      {
        "ref": "AI 9",
        "name": "Loop.1.Main.TargetSP",
        "why": "Loop 1 working setpoint"
      },
      {
        "ref": "AI 10",
        "name": "Loop.1.Main.ActiveOP",
        "why": "Loop 1 active output"
      },
      {
        "ref": "MI 1",
        "name": "Channel.1.Alarm1.Status",
        "why": "Channel 1 alarm 1 state"
      },
      {
        "ref": "MI 2",
        "name": "Channel.1.Alarm2.Status",
        "why": "Channel 1 alarm 2 state"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Up to 30 extra numeric parameters can be mapped through the UserParameter pairs (AV 53-112) using the parameter's Modbus address from the nanodac manual."
    ],
    "gotchas": [
      "AI 9 and AV 10 carry the same object name text (Loop.1.Main.TargetSP); AI 9 is the read-only working setpoint, AV 10 the writable target setpoint.",
      "Loop and alarm settings written over BACnet are instrument parameters; avoid cyclic writes."
    ]
  },
