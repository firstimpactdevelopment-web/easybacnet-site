{
  "manufacturer": "Eurotherm (Schneider Electric)",
  "manufacturer_slug": "eurotherm",
  "model": "EPC3000 programmable controller (EPC3004 / EPC3008 / EPC3016)",
  "model_slug": "epc3000",
  "aliases": [
    "EPC3000",
    "EPC3004",
    "EPC3008",
    "EPC3016",
    "Eurotherm EPC3000",
    "HA033299"
  ],
  "equipment_type": "Other equipment (single-loop process / temperature controller)",
  "applies_to": "Eurotherm EPC3004, EPC3008 and EPC3016 single-loop programmable controllers with BACnet.",
  "summary": "The EPC3000 range is a family of single-loop process and temperature controllers with a setpoint programmer. The BACnet object list is fixed: input PVs, alarm inputs, loop working setpoint and output, programmer status and maths outputs as analog inputs; alarm settings, loop PV, target setpoint, auto/manual, manual output, PID terms, I/O values, a remote input and the programmer controls as writable analog values; output, alarm and programmer event states as binary inputs; input and alarm status as multistate inputs.",
  "bacnet_transport": [],
  "firmware": "V3.02",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "The Notes column marks objects that are not in service on the EPC3016, need hardware fitted, need configuring or need a feature enabled; this is added to the descriptions.",
    "Units are printed only for AI 10 (%) and the programmer times AI 14-15 (ms).",
    "AV 54-113 are 30 UserParameter Address/Value pairs for indirect access to other operator parameters by Modbus address (no configuration parameters, no 32-bit integers).",
    "AV 17 is printed as Alarm.4.Inhibit although its position belongs to alarm 3; Alarm.4.Inhibit appears again as AV 23. Names are given as printed.",
    "The device Object_Name is built from the controller's Type and CustomerID parameters and can only be changed through iTools or the HMI.",
    "The PICS does not name the data link; vendor ID 10 (Schneider Electric), protocol revision 14, B-ASC."
  ],
  "source": {
    "title": "EPC3000 Programmable Controller Protocol Implementation Conformance Statement",
    "doc_number": "HA033299 Issue 2",
    "revision_date": "2018-10-09",
    "url": "https://www.bacnetinternational.net/catalog/manu/eurotherm%20by%20schneider%20electric/epc3000_controller_pic_issue_2.pdf",
    "unofficial": true,
    "host": "BACnet International product catalog"
  },
  "integration": {
    "summary": "Write the loop target setpoint (AV 38), auto/manual (AV 39) and manual output (AV 40). Read the process value (AI 1), working setpoint (AI 9), working output (AI 10) and the alarm states (BI 9-14 / MI 3-8). A BMS value can be fed to the controller through AV 53 RemoteInput.Input.",
    "minimum_points": [
      {
        "ref": "AV 38",
        "name": "Loop.Main.TargetSP",
        "why": "Loop target setpoint"
      },
      {
        "ref": "AV 39",
        "name": "Loop.Main.AutoMan",
        "why": "Loop auto / manual select"
      },
      {
        "ref": "AV 40",
        "name": "Loop.OP.ManualOP",
        "why": "Loop output in manual"
      },
      {
        "ref": "AI 1",
        "name": "AI.1.Main.PV",
        "why": "Input 1 process value"
      },
      {
        "ref": "AI 9",
        "name": "Loop.Main.WorkingSP",
        "why": "Loop working setpoint"
      },
      {
        "ref": "AI 10",
        "name": "Loop.Main.WorkingOutput",
        "why": "Loop working output, %"
      },
      {
        "ref": "MI 1",
        "name": "AI.1.PVStatus",
        "why": "Input 1 status"
      },
      {
        "ref": "BI 9",
        "name": "Alarm.1.Output",
        "why": "Alarm 1 active"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "AV 53 RemoteInput.Input accepts a value written over BACnet; how the controller uses it depends on its configuration.",
    "setup": [
      "The Modbus addresses used with the UserParameter pairs are in the iTools help (Device Help > Scada)."
    ],
    "gotchas": [
      "Configuration parameters cannot be written over BACnet, and the controller cannot be put into configuration mode from BACnet.",
      "Alarm and PID settings are instrument parameters; avoid cyclic writes."
    ]
  },
