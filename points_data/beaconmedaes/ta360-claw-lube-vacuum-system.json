      },
      {
        "ref": "AV 2",
        "name": "System Vacuum",
        "why": "Plant vacuum level"
      },
      {
        "ref": "IV 0",
        "name": "VSD Speed",
        "why": "VSD speed, Hz"
      },
      {
        "ref": "MV 0",
