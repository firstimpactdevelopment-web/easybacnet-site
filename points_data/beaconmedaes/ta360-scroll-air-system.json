{
  "manufacturer": "BeaconMedaes",
  "manufacturer_slug": "beaconmedaes",
  "model": "TotalAlert 360 (TA360-S) controller - scroll medical air systems",
  "model_slug": "ta360-scroll-air-system",
  "aliases": [
    "TA360",
    "TotalAlert 360",
    "TA360-S",
    "TA360 Source Controller",
    "BeaconMedaes TA360",
    "Beacon Medaes"
  ],
  "equipment_type": "Medical gas source plant controller (monitoring only)",
  "applies_to": "BeaconMedaes scroll air systems SAS and LAS with the TA360 source controller TA360-S (firmware 4107600055 Rev07 and above).",
  "summary": "The TA360 source controller runs BeaconMedaes medical air and vacuum source plants and serves BACnet IP as a BACnet Smart Sensor. For scroll air systems the map has 103 read-only objects: system pressure, ambient temperature, dew point and CO, running hours per unit (up to 6) and per dryer, dryer cycles, system and per-unit alarm/service/shutdown flags, individual alarms, and running, sequence and operation modes for units and dryers.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": "4107600055 Rev07 and above",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "From the PICS object mapping tables (object name, instance, present value, units / state description). All objects are read-only (B-SS profile); the PICS lists no write access.",
    "Every possible object is listed; objects for units, dryers or sensors that are not installed should be ignored. Reading the device Object_List shows only the objects relevant to the system.",
    "Multistate values start at 1 (as corrected in Rev 1 of the PICS).",
    "The same TA360-S controller covers scroll air and claw/lube vacuum plants; the two plant types have separate object maps.",
    "Dew point is printed in degC while the other temperatures are degF; system pressure units follow the controller setting (PSI, kPa, bar, inHg or mmHg)."
  ],
  "source": {
    "title": "BACnet Protocol Implementation Conformance Statement - TA360 Systems (Object Mapping for TA360 Systems)",
    "doc_number": "4107 9010 48 Rev02",
    "revision_date": "2025-07-16",
    "url": "https://www.bacnetinternational.net/catalog/manu/beaconmedaes/PICS%20TA360%20Systems.pdf",
    "unofficial": true,
    "host": "BACnet International"
  },
  "integration": {
    "summary": "Discover the TA360 controller over BACnet IP and read its Object_List to see which objects apply to the installed plant. Map the system alarm, shutdown and service flags and the main pressure or vacuum value first; the BMS cannot command the plant.",
    "minimum_points": [
      {
        "ref": "BV 0",
        "name": "Any System Alarms",
        "why": "Any system alarm"
      },
      {
        "ref": "BV 2",
        "name": "Any System Shutdowns",
        "why": "Any shutdown active"
      },
      {
        "ref": "BV 1",
        "name": "Any System Service",
        "why": "Service due"
      },
      {
        "ref": "AV 0",
        "name": "System Pressure",
        "why": "Plant outlet pressure"
      },
      {
        "ref": "AV 4",
        "name": "Dew Point",
        "why": "Medical air dew point"
      },
      {
        "ref": "AV 6",
        "name": "CO Level",
        "why": "CO level, ppm"
      },
      {
        "ref": "MV 0",
        "name": "Unit 1 Running Mode",
        "why": "Unit 1 running state"
      },
      {
        "ref": "BV 200",
        "name": "Unit 1 Alarms",
        "why": "Unit 1 alarm"
      }
    ],
    "enable": "Monitoring only: the PICS lists no writable objects.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet IP (ISO 8802-3 / Annex J); B-SS profile; max APDU 1456."
    ],
    "gotchas": [
      "Objects for units 1-6, dryers and optional sensors exist even when that equipment is not installed; ignore them.",
      "Multistate values start at 1."
    ]
  },
