{
  "manufacturer": "Wildeboer",
  "manufacturer_slug": "wildeboer",
  "model": "WiVent-B decentralised ventilation unit, BACnet IP",
  "model_slug": "wivent-b",
  "aliases": [
    "WiVent-B",
    "WiVent",
    "WiVent B",
    "Wildeboer WiVent",
    "WiVent dezentrales Lüftungsgerät"
  ],
  "equipment_type": "Decentralised ventilation unit (energy recovery)",
  "applies_to": "Wildeboer WiVent-B decentralised facade ventilation units (one master with up to five slaves) with the BACnet IP interface on the Beckhoff CX9020 controller.",
  "summary": "The WiVent-B is a decentralised facade ventilation unit for classrooms and offices. Its Beckhoff CX9020 controller runs TwinCAT BACnet over BACnet IP and publishes a schedule and holiday calendar, command switches and push buttons as Binary Values, status and alarm flags as Binary Inputs, airflow and temperature settings as Analog Values, measurements for the master and up to five slave units as Analog Inputs, and operating mode, faults and warnings as multi-state objects.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": "TwinCAT BACnet 4.0.1 (PICS)",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The interface description is in German; object names, state texts and Active/Inactive texts are kept as printed and descriptions are translated.",
    "The table has no read/write column; Binary Values, Analog Values, the schedule, calendar and MSV 400 are listed as writable (settings, switches and buttons), inputs and status/fault multi-states as read-only.",
    "Some names are printed in quotes (\"WiVent_Betriebsart\"); the quotes are dropped here.",
    "Defaults and limits printed for the Analog Values can differ after system parameterisation.",
    "Slave objects only report when slave units are connected (AI 378 = number of active slaves)."
  ],
  "source": {
    "title": "BACnet - Schnittstellenbeschreibung WiVent-B Dezentrales Lüftungsgerät",
    "doc_number": "c6584.408.005-00_wivent_bacnet_pics_de_00-00",
    "revision_date": "2019-03-04",
    "url": "https://wildeboer.de/dokumente/produkte/luftverteilung/wivent-b/sprachuebergreifend/wivent-bac-net-ip-schnittstellenbeschreibung.pdf"
  },
  "integration": {
    "summary": "Command the operating mode with MSV 400 (or let the internal schedule run), keep the watchdog alive if it is enabled, and read the operating mode status, room temperature, CO2 and the fault and warning flags.",
    "minimum_points": [
      {
        "ref": "MV 400",
        "name": "WiVent_Betriebsart",
        "why": "Operating mode command"
      },
      {
        "ref": "BV 201",
        "name": "WiVent_Takt_Watchdog",
        "why": "Watchdog pulse, toggle faster than every 10 s"
      },
      {
        "ref": "BV 209",
        "name": "WiVent_Externe_Fehlerquittierung",
        "why": "Fault acknowledge"
      },
      {
        "ref": "MI 450",
        "name": "WiVent_Betriebsart_Status",
        "why": "Current operating mode"
      },
      {
        "ref": "AI 352",
        "name": "WiVent_Temperatur_IDA",
        "why": "Room temperature, °C"
      },
      {
        "ref": "AI 353",
        "name": "WiVent_Luftqualität_IDA",
        "why": "Room CO2, ppm"
      },
      {
        "ref": "AI 355",
        "name": "WiVent_Temperatur_SUP_Master",
        "why": "Supply air temperature, °C"
      },
      {
        "ref": "BI 262",
        "name": "WiVent_Störung_1",
        "why": "Master fault"
      },
      {
        "ref": "BI 260",
        "name": "WiVent_Warnung_1B",
        "why": "Warning with unit shutdown"
      },
      {
        "ref": "MV 460",
        "name": "WiVent_Warnung_System",
        "why": "System warning code (filters, schedule)"
      }
    ],
    "enable": "MSV 400 sets the operating mode; BV 204 (external release) and BV 205 (external fault shutdown) put the unit into protection mode.",
    "heartbeat": "BV 200 enables a connection watchdog; BV 201 is the watchdog pulse and must change faster than every 10 s. The document does not say what the unit does when the pulse stops.",
    "remote_sensors": null,
    "setup": [
      "BACnet IP on the Beckhoff CX9020 (TwinCAT BACnet, vendor ID 415); the PICS also lists MS/TP via an EL6861 terminal.",
      "The full set of objects for a given installation is defined in its EDE files."
    ],
    "gotchas": [
      "Filter test, filter drying, presence and fault acknowledge are push-button Binary Values; write active, not a held state.",
      "State texts of the multi-states are German."
    ]
  },
