  "equipment_type": "Circulator pump gateway",
  "applies_to": "KSB Calio circulator pumps connected one-to-one to the KSB BACnet MS/TP gateway over the pump's Modbus port.",
  "summary": "A DIN-rail gateway that reads one Calio pump over Modbus RTU and serves it on BACnet MS/TP as a master node. It exposes head, flow, speed, hours, power and load, the setpoint, start/stop and operating mode, and one fault object per pump error code. File and program objects hold the gateway's own configuration.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "P-BASIC program V20150805",
  "default_device_instance": "247000 + last 3 digits of the gateway serial number",
  "access_inferred": false,
  "notes": [
    "Only one Calio pump can be connected to each gateway.",
    "The table's object type 'PRG' (Program) is listed here as Other; FI objects are BACnet File objects.",
    "AV 1, BV 1 and MV 1 only reach the pump while the PRG-1 program shows Running and the pump's Modbus is active; the gateway checks this every 3 minutes.",
    "Writable properties other than Present_Value are stored in the gateway's flash memory.",
    "Source is the German edition of the manual; the object list itself is printed in English."
  ],
  "source": {
    "title": "BACnet MS/TP Gateway für Calio, Zusatzbetriebsanleitung",
    "doc_number": "1157.87/04-DE",
    "revision_date": "2018-04-06",
    "url": "https://www.haustechnikmarkt24.de/media/pdf/buderus-7738320843-betriebsanleitungzubehuer2-pumpe-ksb-calio-80-80-pn6-heizungsumwaelzpumpe-haustechnikmarkt24.pdf",
    "unofficial": true,
    "host": "haustechnikmarkt24.de"
  },
  "integration": {
    "summary": "Set the MS/TP MAC address and baud rate on the gateway DIP switches, leave the pump's Modbus settings at factory defaults and wire one pump point-to-point. Start/stop the pump with BV 1, write the setpoint to AV 1 and pick the control mode with MV 1; read run status, flow, head and the fault objects.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "Calio_StartStop",
        "why": "Start/stop command"
      },
      {
        "ref": "MV 1",
        "name": "Calio_OpMode",
        "why": "Control mode: Eco, constant, proportional, boost"
      },
      {
        "ref": "AV 1",
        "name": "Calio_Setpoint",
        "why": "Setpoint, 0-100 %"
      },
      {
        "ref": "BI 8",
        "name": "Calio_PumpStatus",
        "why": "Operate/stop status"
      },
      {
        "ref": "AI 3",
        "name": "Calio_Flow",
        "why": "Flow, m³/h"
      },
      {
        "ref": "AI 2",
        "name": "Calio_Head",
        "why": "Head, m"
      },
      {
        "ref": "AI 6",
        "name": "Calio_Power",
        "why": "Power, W"
      },
      {
        "ref": "MI 1",
        "name": "Modbus_Status",
        "why": "Gateway to pump link (online/error)"
      },
      {
        "ref": "BI 3",
        "name": "Calio_FaultE03",
        "why": "E03 internal fault"
      },
      {
        "ref": "BI 4",
        "name": "Calio_FaultE04",
        "why": "E04 rotor locked"
      }
    ],
    "enable": "BV 1 Calio_StartStop starts and stops the pump. Writes only reach the pump when PRG-1 shows Running and the pump's Modbus interface is active.",
    "heartbeat": "If Modbus to the pump drops, the gateway retries the connection every 3 minutes; MI 1 shows online/error.",
    "remote_sensors": null,
    "setup": [
      "Default device instance = 247000 + the last three digits of the gateway serial number (e.g. SN ...010 gives 247010); it can be changed over BACnet.",
      "DIP switches 1-7 set the MS/TP MAC address (1-127; 0 is invalid and clears the configuration); switches 8-10 set the baud rate, factory 38400.",
      "Factory master node address is 1. Fit jumper 1 to terminate the MS/TP bus if needed.",
      "Keep the CR2032 backup battery fitted; AI 1 shows its voltage (replace below 2.0 V)."
    ],
    "gotchas": [
      "One pump per gateway, point-to-point Modbus wiring.",
      "Leave the Calio's own Modbus settings at factory values.",
      "Red LED blink codes show no BACnet traffic, Modbus errors, or no valid configuration."
    ]
  },
