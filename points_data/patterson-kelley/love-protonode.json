  "notes": [
    "Appendix B.2 LOVE of the guide (pages 41-42).",
    "The table has no read/write column; access is inferred from the N2 type (AO/DO = writable).",
    "The guide is hosted on weil-mclain.com and prints no boiler brand (only the ProtoNode vendor code Harsco12); ENVI, LOVE and NURO are listed here under Patterson-Kelley.",
    "State texts come from the notes under the table."
  ],
  "integration": {
    "summary": "Use Control RUN/STOP (BV 27) and the Setpoint (AV 2). Read the process value and output value, and watch the error objects.",
    "minimum_points": [
      {
        "ref": "BV 27",
        "name": "Control RUN/STOP Setting",
        "why": "Control run command: 0 = STOP, 1 = RUN"
      },
      {
        "ref": "AV 2",
        "name": "Setpoint",
        "why": "Temperature setpoint"
      },
      {
        "ref": "AI 25",
        "name": "Communication Write-in Selection",
        "why": "Comms write-in must be 1 = enabled to write"
      },
      {
        "ref": "AI 1",
        "name": "Process Value",
        "why": "Process value (measured temperature)"
      },
      {
        "ref": "AV 9",
        "name": "Output Value",
        "why": "Control output value"
      },
      {
        "ref": "AI 33",
        "name": "Input Sensor Did Not Connect",
        "why": "Input sensor not connected"
      }
    ],
    "enable": "BV 27 Control RUN/STOP Setting (0 = STOP, 1 = RUN) and AV 2 Setpoint. AI 25 Communication Write-in Selection must read 1 (enabled) for network writes; AV 24 Setting Lock Status can lock settings.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "ProtoNode FPC-N34 (BACnet MS/TP, BACnet IP, Metasys N2, Modbus TCP) or FPC-N35 (LonWorks).",
      "Boiler side: Modbus RTU, 9600, 19200 or 38400 baud, 1 or 2 stop bits, no parity, 8 data bits; Node-ID 1-255 per boiler. Mixed ENVI/LOVE/NURO networks must run at 9600.",
      "BACnet device instance = Node_Offset (default 50,000) + Modbus Node-ID."
    ],
    "gotchas": [
      "Access is inferred from the N2 types; tuning and alarm objects (AV 5-24) are writable but are controller configuration.",
      "Process value codes 8002H-8007H mean sensor or memory errors, not temperatures."
    ]
  },
