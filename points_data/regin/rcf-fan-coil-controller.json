  "integration": {
    "summary": "Set parameter 57 to BACnet MS/TP, then the MAC address and device ID (parameters 58-60). Command the unit state with RegioRemoteState (MV 5), adjust the basic setpoint (AV 33) and fan mode, and read room temperature, running mode, control mode and fan speed.",
    "minimum_points": [
      {
        "ref": "MV 5",
        "name": "RC_Setp_X.RegioRemoteState",
        "why": "Unit state command: off, economy/standby or comfort"
      },
      {
        "ref": "BV 10",
        "name": "RC_Setp_L.RegioShutDown",
        "why": "Force the unit into shutdown"
      },
      {
        "ref": "AV 33",
        "name": "RC_SetpExt_R.RegioRCFSetPoint",
        "why": "Basic room setpoint"
      },
      {
        "ref": "MV 2",
        "name": "RC_Setp_X.RegioFanSelect",
        "why": "Fan mode: off, manual speed 1-3 or auto"
      },
      {
        "ref": "MI 1",
        "name": "RC_Actual_X.RegioUnitState",
        "why": "Current running mode"
      },
      {
        "ref": "MI 2",
        "name": "RC_Actual_X.RegioControllerState",
        "why": "Off, heating or cooling"
      },
      {
        "ref": "MI 3",
        "name": "RC_Actual_X.RegioFanSpeed",
        "why": "Current fan speed"
      },
      {
        "ref": "AI 0",
        "name": "RC_Actual_R.RegioRoomTemp",
        "why": "Room temperature"
      },
      {
        "ref": "AV 3",
        "name": "RC_Actual_R.RegioPIDSetP",
        "why": "Active controller setpoint"
      }
    ],
    "enable": "RegioRemoteState (MV 5) forces off, economy/standby or comfort; 6 = no remote control returns control to the buttons. RegioShutDown (BV 10) forces shutdown, and RegioFireAlarmStop (BV 9) blocks the unit until it is written back to 0.",
    "heartbeat": null,
    "remote_sensors": "RegioRoomTempRemote (AV 15) takes the room temperature from the network when the controller is configured for remote room temperature.",
    "setup": [
      "Parameter 57 = 1 selects BACnet MS/TP (0 = automatic EXOline/Modbus).",
      "MAC address 0-127 (parameter 58); device ID is set as the 4 lowest digits (59) and 3 highest digits (60). Max master is parameter 61 (default 127).",
      "Speeds 9600, 19200, 38400 or 76800 bit/s (76800 only for BACnet).",
      "Once switched to BACnet, the protocol can only be switched back from the display."
    ],
    "gotchas": [
      "RegioFireAlarmStop (BV 9) keeps the unit off and locks the On/Off button until the BMS writes 0.",
      "RegioBlockConfig (BV 12) locks the parameter menu and can only be released over the network.",
      "Value objects have no priority array; the last write wins."
    ]
  }
}
