  "integration": {
    "summary": "Read AV 10002 room temperature, AV 10011 CO2, AV 10071 humidity and AV 10081 active setpoint; write the state setpoints or AV 10401 offset if the BMS manages them. Keep BV 9101 HeartbeatTrigger pulsing if the offline function is used.",
    "minimum_points": [
      {
        "ref": "AV 10401",
        "name": "RC_RoomSetpointOffset",
        "why": "Setpoint offset, °C"
      },
      {
        "ref": "BV 9101",
        "name": "HeartbeatTrigger",
        "why": "Write 1 periodically to stay in normal mode"
      },
      {
        "ref": "AV 10002",
        "name": "RC_RoomTemp",
        "why": "Room temperature, °C"
      },
      {
        "ref": "AV 10011",
        "name": "RC_CO2Level",
        "why": "Room CO2, ppm"
      },
      {
        "ref": "AV 10071",
        "name": "RC_Humidity",
        "why": "Room relative humidity"
      },
      {
        "ref": "AV 10081",
        "name": "RC_RoomActiveSetpoint",
        "why": "Active room setpoint, °C"
      },
      {
        "ref": "MV 10031",
        "name": "RC_FanSelect",
        "why": "Fan speed selected on the unit"
      }
    ],
    "enable": null,
    "heartbeat": "BV 9101 HeartbeatTrigger must be written to 1 periodically (the unit resets it to 0); MV 9301 RC_OfflineFunction sets the reaction when it stops. No timeout is given.",
    "remote_sensors": "AV 10611 / 10621 / 10681 / 10691 take remote room temperature, CO2, humidity and VOC values, each enabled by its …RemoteSelect BV.",
    "setup": [
      "Port 1 (RS485) protocol, baud rate and format are MV 9001 / 9101 / 9201; write BV 9001 CommCommit = 1 to apply them."
    ],
    "gotchas": []
  }
}
