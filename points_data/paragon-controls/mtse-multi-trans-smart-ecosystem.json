{
  "manufacturer": "Paragon Controls",
  "manufacturer_slug": "paragon-controls",
  "model": "MTSE Multi-Trans Smart Ecosystem flow / pressure station (BACnet MS/TP)",
  "model_slug": "mtse-multi-trans-smart-ecosystem",
  "aliases": [
    "MTSE",
    "Multi-Trans Smart Ecosystem",
    "Paragon MTSE"
  ],
  "equipment_type": "Airflow measuring station (multi-system)",
  "applies_to": "Paragon Controls MTSE multi-sensor flow and pressure stations with up to three systems plus a sub system.",
  "summary": "The MTSE collects several airflow or pressure sensors into up to three systems plus a sub system and reports them on BACnet MS/TP. Per system it gives total flow, temperature, operating range, alarm limits, units, temperature source and process type; it also has four controller outputs, two digital inputs and outputs, and per-sensor flow, pressure and status objects.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "V5.1.7 (BTL listing)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Per-sensor objects are numbered in order: System 1 sensors first, then System 2, System 3, Sub System, then differential pressure; the Sub System follows the last system in use. Only the printed examples (AI 21-24, MSI 11-12, AI 39-40, MSI 20) are listed here; numbering on a real unit depends on how many sensors each system has.",
    "The temperature AIs 5-8 are writable only when the matching temperature source multistate is set to Network. The PICS pairs AI 5 with MSV 6, but MSV 5-8 are named System 1 to Sub System Temperature Source.",
    "AV operating range and alarm limits run from 0 to a value that depends on the sensor; controller outputs AV 13-16 are 0-100.",
    "Binary Value alarm enables use 1 = Off, 2 = On as printed."
  ],
  "source": {
    "title": "MTSE Unit BACnet Protocol Implementation Conformance Statement (MTSE BACnet PIC V5.1.7)",
    "doc_number": null,
    "revision_date": "Rev 6, 6/14/2021",
    "url": "https://www.bacnetinternational.net/catalog/manu/paragon%20controls%20inc./MTSE%20BACnet%20PIC%20V5.1.7%20BTL%20Cert.pdf",
    "unofficial": true,
    "host": "BACnet International"
  },
  "integration": {
    "summary": "Read the system total flows (AI 1-4) and the per-sensor status multistates. If temperature compensation should use a BMS value, set the system's temperature source to Network and write the matching temperature AI.",
    "minimum_points": [
      {
        "ref": "AI 1",
        "name": "System 1 Total Flow",
        "why": "System 1 total flow"
      },
      {
        "ref": "AI 2",
        "name": "System 2 Total Flow",
        "why": "System 2 total flow"
      },
      {
        "ref": "AI 3",
        "name": "System 3 Total Flow",
        "why": "System 3 total flow"
      },
      {
        "ref": "AI 4",
        "name": "Sub System Flow",
        "why": "Sub system flow"
      },
      {
        "ref": "AI 5",
        "name": "System 1 Temperature",
        "why": "System 1 temperature; BMS writes it when source = Network"
      },
      {
        "ref": "MI 11",
        "name": "System 1 Sensor 1 Status",
        "why": "Sensor status: 1 normal, 2 alarm, 3 failure"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "Each system's temperature can come from the BMS: set its Temperature Source multistate (MSV 5-8) to 3 (Network) and write the matching temperature AI (AI 5-8).",
    "setup": [
      "BACnet MS/TP master at 9600, 19200, 38400 or 76800 baud.",
      "No segmentation."
    ],
    "gotchas": [
      "Per-sensor AI / MSI numbers shift with the number of sensors in each system; scan the device to get the real list.",
      "MSV 1-3 unit state lists change with the system's process type (MSV 9-11)."
    ]
  },
