    "enable": "Run/stop comes from the hard-wired system start input; BI 1 only reports it.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MS/TP MAC address 2-127, unique on each trunk; set at the device (see the device O&M).",
      "Baud 9600, 19200, 38400 or 76800; the SPM-3000 section gives 38400 as the default.",
      "Turn the BACnet terminator switch ON only on the two end devices of the trunk.",
      "Device instance 1,002 to 65,535."
    ],
    "gotchas": [
      "AV 25 is the front-panel password; leave it alone unless asked.",
      "The negative-mode setpoints are AV 12 (loop 1) and AV 18 (loop 2)."
    ]
