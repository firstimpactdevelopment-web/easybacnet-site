{
  "manufacturer": "Distech Controls",
  "manufacturer_slug": "distech-controls",
  "model": "ECY-PTU-107 preloaded applications",
  "model_slug": "ecy-ptu-107-preloaded-applications",
  "aliases": [
    "ECY-PTU-107",
    "Eclypse ECY-PTU-107"
  ],
  "equipment_type": "Fan coil / terminal unit controller (preloaded application)",
  "applies_to": "Fan coil, chilled beam/ceiling and heat pump terminal units run by an Eclypse ECY-PTU-107 with its factory application.",
  "summary": "The ECY-PTU-107 is a Distech Controls Eclypse terminal unit controller on BACnet IP that ships with preloaded fan coil, chilled beam/ceiling and heat pump applications, plus lighting and sunblind control. The preloaded program exposes a fixed set of value objects for setpoints, occupancy, mode, fan, valve, light and blind control. It is configured from the controller's web pages or the EC-gfxProgram Configuration Assistant.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "Objects are documented one per section in the guide's Variables chapter; hardware inputs and outputs are described there too but are not listed here.",
    "The guide has no read/write column, so access is inferred from each object's description: values the guide says are set, configured or received from the BMS are marked writable; values it describes as displayed (measured or calculated) are read-only, although the guide allows overriding some of them for testing.",
    "Which objects are used depends on the configured system type, fan type, valve types and input configuration.",
    "Left out because the guide prints two different instance numbers for them (section heading vs table row): UnoccOccDelay (AV 32), Light2Room (AV 72), Light3Room (AV 73), AppVersion (AV 100), SendAutoLightBlind (AV 103), RulesNumber (MV 8)."
  ],
  "source": {
    "title": "ECY-PTU-107 Preloaded Applications User Guide",
    "doc_number": "ECY-PTU-107 Preloaded_UG_10_EN",
    "revision_date": "2016-11 (version 1.0)",
    "url": "https://docs.distech-controls.com/api/khub/documents/e_61tL2Fod11LBZ3m1MTDw/content"
  },
  "integration": {
    "summary": "Command occupancy with MV 2 and the mode with MV 1, write the occupied setpoints AV 40 and AV 41, and read back MV 14, MV 11, AV 1 and MV 16. Leave MV 3 at Auto unless the BMS should pick the fan speed.",
    "minimum_points": [
      {
        "ref": "MV 2",
        "name": "OccupancyCmd",
        "why": "Occupancy command from the BMS"
      },
      {
        "ref": "MV 1",
        "name": "HvacModeCmd",
        "why": "HVAC mode command (auto, heat, cool, off)"
      },
      {
        "ref": "MV 3",
        "name": "FanSpeedCmd",
        "why": "Fan speed command (auto, off, low, med, high)"
      },
      {
        "ref": "AV 40",
        "name": "OccCoolSp",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 41",
        "name": "OccHeatSp",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "MV 14",
        "name": "OccupancyStatus",
        "why": "Effective occupancy state"
      },
      {
        "ref": "MV 11",
        "name": "HvacModeStatus",
        "why": "Actual HVAC mode"
      },
      {
        "ref": "AV 1",
        "name": "SpaceTemp",
        "why": "Space temperature used for control"
      },
      {
        "ref": "MV 16",
        "name": "FanSpeedSt",
        "why": "Actual fan speed"
      },
      {
        "ref": "BV 2",
        "name": "CondSensorSt",
        "why": "Condensation alarm; cooling valve closes"
      }
    ],
    "enable": "Write MV 2 OccupancyCmd for occupancy and MV 1 HvacModeCmd for the mode; any value other than Auto forces the unit into that mode. MV 3 FanSpeedCmd set to Auto leaves the fan to the control loop.",
    "heartbeat": null,
    "remote_sensors": "The guide says AV 1 SpaceTemp and other measured values can be overridden through the BACnet priority array (it calls this a testing feature). MV 5 MotionSensor can be written from the network; the guide says to use a priority lower than 14 to override local control.",
    "setup": [
      "Eclypse controllers connect over Ethernet; the guide reaches the configuration pages through the controller's IP address or factory host name.",
      "Master/slave and remote light/blind groups use room numbers (AV 81 CtrlRoom and the light/blind room values)."
    ],
    "gotchas": [
      "Temperatures are in °C in this guide.",
      "Configuration values (system type, valve and fan types) are commissioning settings; don't write them cyclically."
    ]
  },
