  "model": "MPC Multi-Protocol DDC Controller - Water-to-Air (Gen 7 and newer)",
  "model_slug": "mpc-water-to-air",
  "aliases": [
    "MPC",
    "ClimateMaster MPC",
    "97B0031N01",
    "Multi-Protocol Controller",
    "CXM2",
    "DXM2.6"
  ],
  "equipment_type": "Water-source heat pump controller",
  "applies_to": "ClimateMaster water-to-air (water-source) heat pumps with the MPC controller, Gen 7 and newer.",
  "summary": "The MPC is ClimateMaster's add-on DDC controller for water-source heat pumps. It sits on top of the CXM2/DXM2.6 unit board, acts as a thermostat with a wall sensor, and talks BACnet MS/TP, BACnet over ARC156, N2 or Modbus. The BMS commands occupancy, writes occupied and unoccupied heating and cooling setpoints (in °F or °C objects), can shut the unit down, and reads compressor, fan and temperature status plus fault counters and the lockout state. Units can share one wall sensor in a leader/follower setup.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet ARC156"
  ],
  "firmware": "Gen 7 and newer (some points Gen 8 only)",
  "default_device_instance": "Auto-generated; last two digits = rotary address",
  "access_inferred": false,
  "notes": [
    "Points list from the MPC manual's points matrix; the same table also gives Modbus registers and N2 IDs.",
    "Temperatures follow BV 39 Metric (OFF = °F); some setpoints have separate °F and °C objects.",
    "Heating setpoints AV 21-24 apply when DB Mode (BV 48) is OFF; with DB Mode ON the heating setpoint is the cooling setpoint minus the deadband (AV 5/40/45/46).",
    "Several points are obsolete (AV 8, BV 33) or only for older generations (AV 32, BV 9).",
    "BV 9 and BV 59 have no access marked in the source; they are listed here as read-only."
  ],
  "source": {
    "title": "MPC Multi-Protocol DDC Controls - Application, Operation & Maintenance Manual",
    "doc_number": "97B0031N01",
    "revision_date": "2025-12-11",
    "url": "https://files.climatemaster.com/97b0031n01-climatemaster-mpc-multiprotocol-ddc-controls-water-source-heat-pump-application-manual.pdf"
