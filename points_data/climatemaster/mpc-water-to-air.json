  "integration": {
    "summary": "Address the MPC with the rotary switches and set the MS/TP baud with the DIP switches. Command occupancy with BV 12 (or a BMS schedule on BV 14) and write the occupied cooling and heating setpoints. Use BV 8 for an emergency stop and BV 4 to clear a lockout. Monitor fan and compressor status, space temperature, the Alarm State and the Fault text.",
    "minimum_points": [
      {
        "ref": "BV 12",
        "name": "Occupied Mode",
        "why": "Occupancy command (ON = occupied)"
      },
      {
        "ref": "BV 8",
        "name": "Emergency Shutdown",
        "why": "Emergency stop; ON turns Y1, Y2, G and W off"
      },
      {
        "ref": "AV 3",
        "name": "Occupied CL SP/ Fahrenheit",
        "why": "Occupied cooling setpoint, °F"
      },
      {
        "ref": "AV 21",
        "name": "Occupied HT Setpoint",
        "why": "Occupied heating setpoint, °F (DB Mode off)"
      },
      {
        "ref": "BV 4",
        "name": "System Reset",
        "why": "Lockout reset; set ON then back OFF"
      },
      {
        "ref": "BV 10",
        "name": "SF Status",
        "why": "Supply fan running"
      },
      {
        "ref": "BV 3",
        "name": "C1 Status",
        "why": "Compressor 1 running"
      },
      {
        "ref": "AV 34",
        "name": "Zone Temp Status",
        "why": "Space temperature"
      },
      {
        "ref": "BV 1",
        "name": "Alarm State",
        "why": "Lockout condition (ON = lockout)"
      },
      {
        "ref": "MV 1",
        "name": "Fault",
        "why": "Current alarm as text"
      }
    ],
    "enable": "Stand-alone, the MPC defaults to occupied. BV 12 Occupied Mode (default ON) sets occupied/unoccupied from the BMS; BV 14 Work Schedule can take a BMS schedule instead. BV 8 Emergency Shutdown turns the Y1, Y2, G and W outputs off. BV 53 Compressor Shutdown disables both compressors, and BV 61/BV 54 disable heating or cooling.",
    "heartbeat": null,
    "remote_sensors": "For units sharing one wall sensor, set BV 16 M/S Switch ON on each follower and map the leader's Zone Temp Status (AV 34), Actual HT/CL setpoints (AV 2, AV 1) and Occupied Status (BV 11) to the follower's Master ZT (AV 4), Subordinate HT/CL SP (AV 9, AV 10) and Occupied Mode (BV 12).",
    "setup": [
      "MAC address comes from two rotary switches (00-99); ClimateMaster suggests 02 for heat pump 1 and HP number + 1 for the rest.",
      "BACnet MS/TP on RS-485 at 9.6, 19.2, 38.4 or 76.8 kbps is set with DIP switches SW1-SW4; the Communications Selection jumper picks RS-485 or BACnet over ARC156 (156 kbps).",
      "The device instance is auto-generated with the address as its last two digits; for more than 99 units turn off 'Auto Generate Device ID' in the Equipment Touch tool and enter it there.",
      "The same port can run N2 or Modbus instead of BACnet; the protocol is chosen with the same switches."
    ],
    "gotchas": [
      "Heating setpoint objects (AV 21-24) only apply with DB Mode (BV 48) OFF.",
      "System Reset (BV 4) is not momentary; write ON, then OFF.",
      "Manual BVs (28-32) only act while Test Mode (BV 34) is on, which times out after 60 minutes.",
      "RNet Mode (BV 44) must match the wall sensor type and the W3 jumper."
    ]
  }
}
