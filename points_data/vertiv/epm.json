  "model_slug": "epm",
  "aliases": [
    "Liebert EPM",
    "EPM",
    "SL-28170"
  ],
  "equipment_type": "UPS (uninterruptible power supply)",
  "applies_to": "Liebert EPM UPS systems.",
  "summary": "The Liebert EPM UPS reports to a BMS through a Liebert IntelliSlot card (BACnet IP or BACnet MS/TP). Analog Values carry input, bypass, output and battery measurements, Binary Values carry UPS events, and Multi-state Values carry system status, output source and settings. Objects are created when the card discovers the UPS.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Tables 5.126, 5.127, 5.128, pdf pages 1996-2002 of the 2024 guide (printed page numbers are 4 lower).",
    "Object names are Vertiv data IDs (e.g. 5331_1); the description holds the guide's data label. Labels repeated for different sensors or circuits get the group name in brackets.",
    "Most temperature objects come in pairs: a °C object and a °F object (name ending _deg_F), usually at instance + 10000."
  ],
  "source": {
    "title": "Liebert IntelliSlot Modbus/BACnet Reference Guide (Modbus RTU and TCP, BACnet MSTP and IP)",
    "doc_number": "SL-28170",
    "revision_date": "2024-04 (Rev 29)",
    "url": "https://www.vertiv.com/49fb41/globalassets/shared/liebert-intellislot-modbus-rtu-reference-guide-SL-28170_0.pdf"
  },
  "integration": {
    "summary": "Fit a Liebert IntelliSlot BACnet card (IS-UNITY-DP for BACnet IP or MS/TP), give it a unique device instance and let it discover the equipment; the objects are then created automatically. Map the status, main measurements and event objects for monitoring.",
    "minimum_points": [
      {
        "ref": "MV 15",
        "name": "4123_1",
        "why": "Normal, warning or alarm state"
      },
      {
        "ref": "MV 14",
        "name": "4872_1",
        "why": "Load on inverter, bypass or battery"
      },
      {
