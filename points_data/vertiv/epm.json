      },
      {
        "ref": "AV 82",
        "name": "4208_1",
        "why": "Output power, kW"
      },
      {
        "ref": "AV 1",
        "name": "4097_1",
        "why": "Input voltage, V"
      },
      {
        "ref": "AV 55",
        "name": "4385_1",
        "why": "Output voltage, V"
      },
      {
        "ref": "AV 58",
