{
  "manufacturer": "Vertiv",
  "manufacturer_slug": "vertiv",
  "model": "Liebert MTP UPS",
  "model_slug": "mtp",
  "aliases": [
    "Liebert MTP",
    "MTP",
    "SL-28170"
  ],
  "equipment_type": "UPS (uninterruptible power supply)",
  "applies_to": "Liebert MTP UPS systems.",
  "summary": "The Liebert MTP UPS reports to a BMS through a Liebert IntelliSlot card (BACnet IP or BACnet MS/TP). Analog Values carry input, bypass, output and battery measurements, Binary Values carry UPS events, and Multi-state Values carry system status, output source and settings. Objects are created when the card discovers the UPS.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Tables 5.158, 5.159, 5.160, pdf pages 2150-2155 of the 2024 guide (printed page numbers are 4 lower).",
    "Object names are Vertiv data IDs (e.g. 5331_1); the description holds the guide's data label. Labels repeated for different sensors or circuits get the group name in brackets.",
    "Most temperature objects come in pairs: a °C object and a °F object (name ending _deg_F), usually at instance + 10000."
  ],
  "source": {
    "title": "Liebert IntelliSlot Modbus/BACnet Reference Guide (Modbus RTU and TCP, BACnet MSTP and IP)",
    "doc_number": "SL-28170",
    "revision_date": "2024-04 (Rev 29)",
    "url": "https://www.vertiv.com/49fb41/globalassets/shared/liebert-intellislot-modbus-rtu-reference-guide-SL-28170_0.pdf"
  },
  "integration": {
    "summary": "Fit a Liebert IntelliSlot BACnet card (IS-UNITY-DP for BACnet IP or MS/TP), give it a unique device instance and let it discover the equipment; the objects are then created automatically. Map the status, main measurements and event objects for monitoring.",
    "minimum_points": [
      {
        "ref": "MV 38",
        "name": "4123_1",
        "why": "Normal, warning or alarm state"
      },
      {
        "ref": "MV 39",
        "name": "4872_1",
        "why": "Load on inverter, bypass or battery"
      },
      {
        "ref": "AV 48",
        "name": "4150_1",
        "why": "Estimated battery runtime, min"
      },
      {
        "ref": "AV 88",
        "name": "4208_1",
        "why": "Output power, kW"
      },
      {
        "ref": "AV 1",
        "name": "4096_1",
        "why": "Input voltage, V"
      },
      {
        "ref": "AV 74",
        "name": "4385_1",
        "why": "Output voltage, V"
      },
      {
        "ref": "AV 81",
        "name": "4204_1",
        "why": "Output current, A"
      },
      {
        "ref": "BV 32",
        "name": "4168_1",
        "why": "Load is on battery"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "The card needs a unique Device Instance Number; the device object represents the card, not the unit.",
      "The cards have no BBMD; IS-UNITY-DP and IS-IPBML support foreign device registration (BBMD address and time-to-live).",
      "IS-UNITY-DP adds BACnet MS/TP; IS-WEBADPT and IS-IPBML are BACnet IP only. Check the compatibility table (guide section 1.1.3) for the card your unit supports."
    ],
    "gotchas": [
      "Vertiv asks for no more than about two writes and two reads per second on average; do not rewrite setpoints continuously.",
      "No segmented responses: large ReadPropertyMultiple requests can fail, so split them.",
      "Only data the managed unit actually has is created on the card, so object counts vary by model and options."
    ]
  },
