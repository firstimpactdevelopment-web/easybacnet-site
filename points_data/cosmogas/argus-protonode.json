        "why": "Set to 1 before any write"
      },
      {
        "ref": "AI 2",
        "name": "State",
        "why": "Burner state"
      },
      {
        "ref": "AI 9",
        "name": "Supply Temp",
        "why": "Supply water temperature"
      },
      {
        "ref": "AI 10",
        "name": "Return Temp",
        "why": "Return water temperature"
      },
      {
        "ref": "AI 14",
        "name": "Firing Rate",
        "why": "Firing rate, %"
      },
      {
        "ref": "AI 4",
        "name": "Error Code",
        "why": "Fault code (255 = no error)"
      }
    ],
    "enable": "MV 95 Control Register must be written to 1 before any value change is accepted.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Boiler serial settings: Modbus RTU, 9600 baud, no parity, 8 data bits, 1 stop bit; unique Node-ID per boiler.",
      "BACnet MS/TP MAC address on DIP bank A, baud rate on bank B (B0-B3); profile and auto-discovery on bank S.",
      "Device instance = Node_Offset (default 50,000) + Modbus Node-ID; BACnet IP network number default 50."
    ],
    "gotchas": [
      "Single-burner values (State, Status, Error Code, Firing Rate) apply to one-burner appliances; multi-burner units report per burner in the Dependent_n objects."
    ]
  },
