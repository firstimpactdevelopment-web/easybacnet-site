{
  "manufacturer": "MSA Safety",
  "manufacturer_slug": "msa-safety",
  "model": "Chillgard 5000 refrigerant monitor (BACnet MS/TP)",
  "model_slug": "chillgard-5000-refrigerant-monitor",
  "aliases": [
    "Chillgard 5000",
    "Chillgard 5000 BACnet",
    "MSA Chillgard",
    "10178535"
  ],
  "equipment_type": "Refrigerant leak monitor (gas sensor)",
  "applies_to": "MSA Chillgard 5000 photoacoustic refrigerant monitors with 1 to 16 sample points, on the RS-485 BACnet MS/TP output.",
  "summary": "The Chillgard 5000 samples up to 16 points for refrigerant (or ammonia) and reports over Modbus RTU or BACnet MS/TP. Every BACnet object is an Analog Input: unit status and firmware, then four objects per channel (gas code, concentration in ppm, status flags, reserved) and calibration dates. Acknowledge and reset are done by writing to two of the Analog Inputs.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "From Appendix E \"BACnet Objects\" (manual pages 78-83). Channel objects run from AI 9 (channel 1) to AI 72 (channel 16), four per channel.",
    "Unit Status (AI 6) bits: 0x0001 warm-up, 0x0002 operating, 0x0004 calibration, 0x0008 fault, 0x0010 alarm.",
    "Channel Status bits: 0x0001 caution, 0x0002 warning, 0x0004 alarm, 0x0008 beacon, 0x0010 horn, 0x0020 new (unacknowledged), 0x0040 hold, 0x0080 fault.",
    "Gas Number codes are listed in section 18.5 (0 = R-11 ... 26 = Ammonia ... 46 = R-515B); the Span Cal Time objects follow the same order (#00 = R-11).",
    "ACK button (AI 7) and RESET button (AI 8) are Analog Inputs marked Write in the table.",
    "Channels that are not installed still occupy their object numbers."
  ],
  "source": {
    "title": "Chillgard 5000 Refrigerant Monitor Operating Manual",
    "doc_number": "10178535/06",
    "revision_date": null,
    "url": "https://docs.msasafety.com/chillgard5000/en-us/Chillgard%205000/PDF/Chillgard5000_10178535.pdf"
  },
  "integration": {
    "summary": "Select BACnet on the Outputs > Digital screen and set the MAC address, instance number and baud. Read the unit status and, for each sample point in use, the gas concentration and channel status; write the ACK and RESET objects to acknowledge or clear alarms from the BMS.",
    "minimum_points": [
      {
        "ref": "AI 7",
        "why": "Write 1 to acknowledge alarms",
        "name": "ACK button"
      },
      {
        "ref": "AI 8",
        "why": "Reset code: HiByte action, LoByte channel",
        "name": "RESET button"
      },
      {
        "ref": "AI 6",
        "why": "Unit status bits (operating, fault, alarm)",
        "name": "Unit Status"
      },
      {
        "ref": "AI 10",
        "why": "Channel 1 refrigerant level, ppm",
        "name": "1 Gas Conc."
      },
      {
        "ref": "AI 11",
        "why": "Channel 1 status bits (caution/warning/alarm)",
        "name": "1 Status"
      },
      {
        "ref": "AI 9",
        "why": "Channel 1 gas type code",
        "name": "1 Gas Number"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP over RS-485: choose BACnet on the Outputs > Digital tab, then set MAC Address, Instance Number and baud rate on the unit.",
      "Digital output is either Modbus RTU or BACnet MS/TP, not both."
    ],
    "gotchas": [
      "RESET button (AI 8) takes a two-byte code: HiByte 0 = alarms, 1 = faults, 2 = common faults, 3 = all; LoByte = channel 0-15 or 255 for all.",
      "Status values are bit-coded; decode them in the BMS rather than treating them as a single state.",
      "Calibration times are day counts since 1 January 1970."
    ]
  },
