{
  "manufacturer": "Cleaver-Brooks",
  "manufacturer_slug": "cleaver-brooks",
  "model": "FARC with CB780 / CB783 burner control (ProtoNode)",
  "model_slug": "farc-cb780-cb783-protonode",
  "aliases": [
    "FARC",
    "CB 780/783",
    "CB783",
    "ProtoNode RER",
    "750-426"
  ],
  "equipment_type": "Boiler flame safeguard and fuel-air ratio control via BACnet gateway",
  "applies_to": "Cleaver-Brooks boilers with a CB780/CB783 burner control and FARC fuel-air ratio control, read through a ProtoNode RER gateway.",
  "summary": "A read-only ProtoNode profile combining the CB780/CB783 burner control (sequence state, run mode, flame signal, alarm, lockout, fault history, annunciator inputs) with the FARC fuel-air ratio control (program mode, fault code, operating status, air, fuel and FGR positions and endpoints, firing rate input and fault info words).",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": "50000 + Modbus Node-ID",
  "access_inferred": false,
  "notes": [
    "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
    "The profile has only AI and BI objects and the guide marks none as write points, so all are read-only.",
    "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
    "Where a description is filled in, it gives the register from the guide's Modbus column."
  ],
  "source": {
    "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
    "doc_number": "750-426",
    "revision_date": "03/2018",
    "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
    "unofficial": true,
    "host": "watmfg.com"
  },
  "integration": {
    "summary": "Read-only. Map burner sequence state, run mode, firing rate input, air and fuel positions, and the alarm, lockout and fault codes.",
    "minimum_points": [
      {
        "ref": "AI 3",
        "why": "Burner sequence state",
        "name": "BC_Sequence_State"
      },
      {
        "ref": "BI 6",
        "why": "Burner in run",
        "name": "BC_Run_Mode"
      },
      {
        "ref": "AI 73",
        "why": "Firing rate input",
        "name": "Firing Rate Input"
      },
      {
        "ref": "AI 68",
        "why": "Air actuator position",
        "name": "Air Position"
      },
      {
        "ref": "AI 69",
        "why": "Active fuel actuator position",
        "name": "Active Fuel Position"
      },
      {
        "ref": "BI 9",
        "why": "Alarm output",
        "name": "BC_Alarm_Out"
      },
      {
        "ref": "BI 10",
        "why": "Lockout",
        "name": "BC_Lockout"
      },
      {
        "ref": "AI 1",
        "why": "Burner control fault code",
        "name": "BC_Fault_Code"
      },
      {
        "ref": "AI 66",
        "why": "FARC fault code",
        "name": "Fault Code"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
      "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
      "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
      "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
    ],
    "gotchas": []
  },
