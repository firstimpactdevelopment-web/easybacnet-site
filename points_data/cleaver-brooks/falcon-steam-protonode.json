{
  "manufacturer": "Cleaver-Brooks",
  "manufacturer_slug": "cleaver-brooks",
  "model": "Falcon Steam boiler control (ProtoNode)",
  "model_slug": "falcon-steam-protonode",
  "aliases": [
    "Falcon Steam",
    "CB Falcon steam",
    "ProtoNode RER",
    "750-426"
  ],
  "equipment_type": "Steam boiler control via BACnet gateway",
  "applies_to": "Cleaver-Brooks steam boilers with the Falcon steam burner control, read through a ProtoNode RER gateway.",
  "summary": "The ProtoNode maps the Falcon steam control's Modbus RTU registers to a fixed set of BACnet objects: safety and limit inputs, steam pressure and setpoints, firing rate, flame signal, burner state, lockout and hold codes and lead/lag data. The BMS can enable the burner and lead/lag and write the steam pressure and lead/lag setpoints.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": "50000 + Modbus Node-ID",
  "access_inferred": false,
  "notes": [
    "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
    "Access follows the guide's write-point stars: the starred AV/BV objects are writable, everything else is read-only.",
    "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
    "Where a description is filled in, it gives the register from the guide's Modbus column.",
    "The source prints the PumpA row (BI 1) twice; it is listed once here."
  ],
  "source": {
    "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
    "doc_number": "750-426",
    "revision_date": "03/2018",
    "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
    "unofficial": true,
    "host": "watmfg.com"
  },
  "integration": {
    "summary": "Enable the burner and write the steam pressure setpoint; use the lead/lag enable and setpoint if the boilers run lead/lag. Read burner state, steam pressure, firing rate, the alarm input and the lockout code.",
    "minimum_points": [
      {
        "ref": "AV 1",
        "why": "Burner enable from the BMS",
        "name": "BURNER ENABLE"
      },
      {
        "ref": "AV 21",
        "why": "Steam pressure setpoint",
        "name": "STEAM_PRESSURE_SETPOINT"
      },
      {
        "ref": "AV 11",
        "why": "Lead/lag enable",
        "name": "LEAD/LAG_ENABLE"
      },
      {
        "ref": "AV 31",
        "why": "Lead/lag setpoint",
        "name": "LEAD/LAG_SETPOINT"
      },
      {
        "ref": "AI 9",
        "why": "Burner control state code",
        "name": "BURN_CTL_STATE"
      },
      {
        "ref": "AI 5",
        "why": "Steam pressure",
        "name": "STEAM_PRESSURE"
      },
      {
        "ref": "AI 20",
        "why": "Firing rate, %",
        "name": "FIRING_RATE_PERCENT"
      },
      {
        "ref": "BI 8",
        "why": "Alarm",
        "name": "Alarm"
      },
      {
        "ref": "AI 10",
        "why": "Lockout code",
        "name": "LOCKOUT_CODE"
      }
    ],
    "enable": "AV 1 BURNER ENABLE and AV 11 LEAD/LAG_ENABLE are the BMS enables; AV 21 writes the steam pressure setpoint.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
      "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
      "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
      "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
    ],
    "gotchas": []
  },
