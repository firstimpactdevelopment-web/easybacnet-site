{
  "manufacturer": "Cleaver-Brooks",
  "manufacturer_slug": "cleaver-brooks",
  "model": "CB780 flame safeguard with expanded annunciator (ProtoNode)",
  "model_slug": "cb780-protonode",
  "aliases": [
    "CB780",
    "CB 780",
    "CB780E",
    "ProtoNode RER",
    "750-426"
  ],
  "equipment_type": "Boiler flame safeguard via BACnet gateway",
  "applies_to": "Cleaver-Brooks boilers with the CB780 burner management control and expanded annunciator, read through a ProtoNode RER gateway.",
  "summary": "The ProtoNode maps the CB780 burner control to BACnet: sequence state and status strings, run mode, flame signal, alarm and lockout, the fault code, six fault history records, cycle and hour totals and the expanded annunciator limit inputs. One AV (BC_Rem_Command) is writable.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": "50000 + Modbus Node-ID",
  "access_inferred": false,
  "notes": [
    "Each Cleaver-Brooks controller on the ProtoNode is its own BACnet device; the object instances below are the same on every device.",
    "Access follows the guide's write-point stars: the starred AV/BV objects are writable, everything else is read-only.",
    "The guide gives no engineering units or state texts; units appear only where the object name carries them (DEG F / DEG C).",
    "Where a description is filled in, it gives the register from the guide's Modbus column."
  ],
  "source": {
    "title": "Cloud Enabled ProtoNode Gateway Startup Guide (RER/LER) for interfacing Cleaver-Brooks products",
    "doc_number": "750-426",
    "revision_date": "03/2018",
    "url": "https://watmfg.com/watmfg23082016/wp-content/uploads/2016/09/750-426-ProtoNode-Cloud.pdf",
    "unofficial": true,
    "host": "watmfg.com"
  },
  "integration": {
    "summary": "Mostly a monitoring profile: read sequence state, run mode, flame signal, alarm, lockout and the fault and first-out codes. BC_Rem_Command is the one writable object.",
    "minimum_points": [
      {
        "ref": "AV 1",
        "why": "Remote command register",
        "name": "BC_Rem_Command"
      },
      {
        "ref": "AI 3",
        "why": "Burner sequence state",
        "name": "BC_Sequence_State"
      },
      {
        "ref": "BI 6",
        "why": "Burner in run",
        "name": "BC_Run_Mode"
      },
      {
        "ref": "AI 7",
        "why": "Flame signal strength",
        "name": "BC_Flame_Signal_Strength"
      },
      {
        "ref": "BI 9",
        "why": "Alarm output",
        "name": "BC_Alarm_Out"
      },
      {
        "ref": "BI 10",
        "why": "Lockout",
        "name": "BC_Lockout"
      },
      {
        "ref": "AI 1",
        "why": "Fault code",
        "name": "BC_Fault_Code"
      },
      {
        "ref": "AI 49",
        "why": "Annunciator first-out code",
        "name": "ExpAnn_First_Out_Code"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet Device Instance = the controller's Modbus Node-ID + Node_Offset (default 50,000), so Node-ID 1 = 50001. Change Node_Offset in the ProtoNode web configurator to pick other instances.",
      "The ProtoNode RER does BACnet MS/TP or BACnet IP, selected on its S bank DIP switches.",
      "BACnet MS/TP: one MAC address (1-127) for the whole ProtoNode on the A bank DIP switches; baud on B0-B3 (38400 factory default).",
      "BACnet IP: default ProtoNode address 192.168.1.24; change it in the web configurator."
    ],
    "gotchas": []
  },
