{
  "manufacturer": "Neptronic",
  "manufacturer_slug": "neptronic",
  "model": "TFxB Series Thermostat Controller",
  "model_slug": "tfxb-thermostat",
  "aliases": [
    "TFCB24F3XYZ1",
    "TFCB24F3XY2",
    "TFHB24F3XYZ1",
    "TFHB24F3XYZ2",
    "TFCB24P3-OE1",
    "TFHB24P3-OE1",
    "TFHB24P3-OE2",
    "TFxB24"
  ],
  "equipment_type": "Fan coil / zone thermostat controller",
  "applies_to": "Neptronic TFxB24 communicating thermostats for 2-pipe and 4-pipe fan coils and zone heating/cooling, including the humidity (TFHB) and OE variants.",
  "summary": "The TFxB24 is a wall thermostat-controller that speaks BACnet MS/TP as a fixed table of AI/AV/BI/BV/MSV objects plus the Device object. Each object is only present on some of the seven model variants (the PDF marks applicability per model), and several multistate objects change their state list depending on how BV.5 (2-pipe/4-pipe) and other settings are configured. It does not issue BACnet event notifications; alarms show only as value changes.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Firmware 1.17 / application 1.20 (as printed)",
  "default_device_instance": "153000 + MAC address",
  "access_inferred": false,
  "notes": [
    "Object availability differs by model (TFCB/TFHB, F3 vs P3-OE); the source marks each object per model.",
    "Multistate state lists depend on configuration (e.g. BV.5 2-pipe/4-pipe, BV.4 fan auto enable); read State_Text from the device.",
    "The Object_List cannot be read in one request; the controller requires reading it one element at a time.",
    "Temperatures follow BV.1 Temper.Unit (Celsius or Fahrenheit)."
  ],
  "source": {
    "title": "TFxB Series Thermostat Controller BACnet Communication Module User Guide",
    "doc_number": "TFxB24-Bacnet-121026-EUA",
    "revision_date": "2012-10-26",
    "url": "https://www.neptronic.com/controls/PDF/TFxB24-CMUG.pdf"
  },
  "integration": {
    "summary": "Map the space temperature, setpoint and demands, then command occupancy through MSV.13 and the user mode through MSV.3. There is no BMS temperature-feed object; to substitute a value the integrator can only use Out_of_Service, which times out. Setpoints and configuration live in writable AVs.",
    "minimum_points": [
      {
        "ref": "AV 1",
        "name": "ControlTemper.",
        "why": "Temperature the thermostat is controlling to"
      },
      {
        "ref": "AV 7",
        "name": "Temper.SetPointOcc.",
        "why": "Occupied setpoint (writable)"
      },
      {
        "ref": "MV 13",
        "name": "OccupancyMode",
        "why": "BMS occupancy command: local, occupied or unoccupied"
      },
      {
        "ref": "MV 14",
        "name": "OccupancyStatus",
        "why": "Actual occupancy state including override"
      },
      {
        "ref": "MV 3",
        "name": "UserControlMode",
        "why": "Auto/heat/cool/off mode"
      },
      {
        "ref": "AV 2",
        "name": "HeatingDemand",
        "why": "Heating output demand %"
      },
      {
        "ref": "AV 3",
        "name": "CoolingDemand",
        "why": "Cooling output demand %"
      },
      {
        "ref": "AV 4",
        "name": "FanDemand",
        "why": "Fan demand %"
      }
    ],
    "enable": "Occupancy is forced from the BMS with MSV.13 OccupancyMode (Occ.Locally lets the thermostat decide; the other two states force occupied or unoccupied). Mode is set with MSV.3; BV.3 decides whether Off is offered.",
    "heartbeat": null,
    "remote_sensors": "No dedicated network-temperature object is listed. Values can be overridden by setting Out_of_Service on an input object and writing Present_Value, but the controller returns the object to normal after the Out-of-Service timeout (default 15 minutes).",
    "setup": [
      "BACnet MS/TP, full master; MAC defaults to 1 (000-254, 128-254 are non-token slaves), set from the thermostat menu (password 637).",
      "Device instance auto-configures to 153000 + MAC address; can be changed from the menu or by writing Object_Identifier.",
      "Baud rate auto-detects (auto detection needs firmware 1.17+), or write Device proprietary property 1001 (9600-76800).",
      "Max_Master defaults to 127; set it to the highest MAC on the trunk."
    ],
    "gotchas": [
      "Object names in the source carry footnote numbers (e.g. ControlMode13); the real names are shown here without them.",
      "Out_of_Service on read-only objects is writable for testing, but it reverts automatically after 15 minutes (Device proprietary property 1002, 0-120 min, 0 = never).",
      "AV.1-AV.4, AV.28, AV.36, AV.41, AV.42, BV.7 and MSV.14 are read-only; all other AV/BV/MSV present values are writable.",
      "MSV.4 ControlMode restricts what MSV.3 UserControlMode can be set to."
    ]
  },
