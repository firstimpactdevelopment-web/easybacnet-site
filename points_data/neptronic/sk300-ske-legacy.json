  "manufacturer": "Neptronic",
  "manufacturer_slug": "neptronic",
  "model": "SK300 / SKE (legacy) Steam Humidifier with NEPIC BACnet module",
  "model_slug": "sk300-ske-legacy",
  "short_model": "SK300 / SKE (legacy)",
  "aliases": [
    "SK300",
    "SKE",
    "Neptronic SK300",
    "Neptronic SKE",
    "NEPIC",
    "SK300-BACNET",
    "SKE-BACNET"
  ],
  "equipment_type": "Electric steam humidifier",
  "applies_to": "Legacy Neptronic SK300 and SKE electric steam humidifiers fitted with the NEPIC BACnet MS/TP communication module.",
  "summary": "The NEPIC module gives older SK300 and SKE steam humidifiers a BACnet MS/TP interface (B-ASC). It serves 83 objects: humidity, water level and temperature readings, writable demand, setpoint, delay, PID and offset values, operating and input status, alarm flags, input type options and control, operation and source selectors.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "1.00",
  "default_device_instance": 153000,
  "access_inferred": false,
  "notes": [
    "The SK300 and SKE guides (SK300-BACNET Rev 060606 and SKE-BACNET Rev 081104) print identical object tables; one list covers both. These are the older models, separate from the SKE4/SKG4 lists.",
    "Access is from the W? column. The alarm BVs are printed as writable.",
    "Temperature values follow BV 27 Temp_Units (Celsius or Fahrenheit).",
    "The module does not send BACnet event notifications; alarms are read from the BI/BV objects."
  ],
  "source": {
    "title": "SK300 Steam Humidifier BACnet Communication Module User Guide (SK300 Humidifier Object Table)",
    "doc_number": "SK300-BACNET",
    "revision_date": "Rev 060606",
    "url": "https://www.neptronic.com/humidifiers/PDF/SK300/SK300-bacnet-user-guide.pdf"
  },
  "integration": {
    "summary": "Set the baud with DIP switches 2-3 and give the module a unique MAC and device instance. For BMS demand control set MSV 1 Ctl_Mode to 3 (remote) and write AV 1 Humidity_Demand; for internal PID set MSV 1 to 2, choose the setpoint and humidity sources (MSV 4, MSV 5) and write AV 11 and AV 2. MSV 2 turns the unit on, off or to drain.",
    "minimum_points": [
      {
        "ref": "MV 2",
        "name": "Operation_Mode",
        "why": "Unit off, on or drain"
      },
      {
        "ref": "MV 1",
        "name": "Ctl_Mode",
        "why": "Control mode; 3 = demand from BACnet"
      },
      {
        "ref": "AV 1",
        "name": "Humidity_Demand",
        "why": "Humidity demand from the BMS, %"
      },
      {
        "ref": "AV 11",
        "name": "Ctl_SP",
        "why": "Humidity setpoint for internal PID, %RH"
      },
      {
        "ref": "AV 2",
        "name": "Room_Humidity",
        "why": "Room RH from the BMS (remote source)"
      },
      {
        "ref": "BI 1",
        "name": "Power_Status",
        "why": "Unit power on"
      },
      {
        "ref": "AI 1",
        "name": "Humidity_Out",
        "why": "Humidifier output, %"
      },
      {
        "ref": "BI 5",
        "name": "Alrm_Not_Critical",
        "why": "Non-critical alarm, unit still running"
      },
      {
        "ref": "BI 6",
        "name": "Alarm_Critical",
        "why": "Critical alarm, unit stopped"
      }
    ],
    "enable": "MSV 2 Operation_Mode sets the unit off (1), on (2) or to drain (3). MSV 1 Ctl_Mode picks the demand source: 1 = local analog input, 2 = internal PID, 3 = remote demand over BACnet.",
    "heartbeat": null,
    "remote_sensors": "With MSV 5 Room_Hum_Source = 2 (remote) and MSV 6 Duct_Hum_Source = 3 (remote) the BMS writes AV 2 Room_Humidity and AV 3 Duct_Humidity; MSV 4 SP_Source = 3 takes the setpoint from BACnet.",
    "setup": [
      "DIP switch 1 selects operational (OFF) or configuration (ON) mode; switches 2 and 3 set 9600, 19200, 38400 or 76800 baud (restart after a change).",
      "Factory settings: MAC 0, device instance 153000, Max_Master 127; configuration mode uses MAC 254 as a non-token-passing slave.",
      "Device instance, object name, Max_Master and MAC (proprietary property 1000) can be written to the Device object at any time."
    ],
    "gotchas": [
      "Two modules left at the factory MAC 0 / instance 153000 will clash; configure each before connecting.",
      "BV 30 Reload_Factory restores factory values."
    ]
  },
