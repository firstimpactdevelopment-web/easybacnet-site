{
  "manufacturer": "Veris",
  "manufacturer_slug": "veris",
  "model": "E51H2 / E51H5 bi-directional compact power and energy meter (BACnet MS/TP)",
  "model_slug": "e51h2-e51h5",
  "aliases": [
    "E51H2",
    "E51H5",
    "Veris E51",
    "E51Hx",
    "E51 Series",
    "ZL0109"
  ],
  "equipment_type": "Power and energy meter (bi-directional)",
  "applies_to": "Veris E51H2 and E51H5 DIN-rail three-phase meters with BACnet MS/TP that measure import and export energy; the E51H5 adds data logging.",
  "summary": "The E51H2 and E51H5 are DIN-rail three-phase meters with a BACnet MS/TP port that measure energy in both directions. Measurements are 79 Analog Inputs (net, import and export energy per quadrant and per phase, power, demand, volts, amps, power factor, frequency, pulse counts), setup is in eleven writable Analog Values, and alerts are Binary Inputs that also roll up into AI 83. The E51H5 also has three Trend_Log objects.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Different object list from the E50H2/E50H5 (import/export and per-quadrant objects); do not reuse an E50 map.",
    "Reserved objects AI 28, 77, 79, 80 and BI 8 are left out.",
    "BI 5 and BI 6 are printed with the name Current_Error_A; kept as printed. AI 29/30 use the E51H5 names; on the E51H2 AI 29 is Pulse Count and AI 30 is reserved.",
    "kVARh and kVAh objects report kWh in their Units property because BACnet has no such unit.",
    "AV 2 System_Type: 10 single-phase A+N, 11 single-phase A+B, 12 split-phase A+B+N, 31 3-phase delta, 40 3-phase wye.",
    "AV 1 Config: write 30078 to clear energy, 21211 to start a demand sub-interval (sync-to-comms), 21212 to reset max demand, 16498 to clear pulse counters. E51H5 Trend_Log TL1-TL3 default to AI 2, AI 3 and AI 19."
  ],
  "source": {
    "title": "E51H2, E51H5 Power Monitoring Installation Guide",
    "doc_number": "ZL0109-0B",
    "revision_date": "2013-06",
    "url": "https://assets.kele.com/Catalog/17%20Power%20Monitoring/PDFs/E51H2,%20E51H5%20Install%20Guide.pdf",
    "unofficial": true,
    "host": "Kele"
  },
  "integration": {
    "summary": "Set the MS/TP address, baud and device ID on the meter screens, then set system type (AV 2), CT size (AV 3) and system voltage (AV 6). Trend import and export energy (AI 2, AI 3) and real power (AI 11), and watch the alert BIs or AI 83.",
    "minimum_points": [
      {
        "ref": "AI 2",
        "name": "KWh_Import",
        "why": "Real energy import, kWh"
      },
      {
        "ref": "AI 3",
        "name": "KWh_Export",
        "why": "Real energy export, kWh"
      },
      {
        "ref": "AI 1",
        "name": "KWh_Net",
        "why": "Net real energy (import minus export), kWh"
      },
      {
        "ref": "AI 11",
        "name": "KW_Total",
        "why": "Total real power, kW"
      },
      {
        "ref": "AI 19",
        "name": "KW_Present_Demand",
        "why": "Present real power demand, kW"
      },
      {
        "ref": "AI 14",
        "name": "PF_Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 15",
        "name": "Volts_LL_Avg",
        "why": "Average line-line voltage"
      },
      {
        "ref": "AI 17",
        "name": "Current_Average",
        "why": "Average current, A"
      },
      {
        "ref": "AI 18",
        "name": "Frequency",
        "why": "Frequency, Hz"
      },
      {
        "ref": "AI 83",
        "name": "Alarm_Bitmap",
        "why": "All alert bits as one number"
      }
    ],
    "setup": [
      "Device ID 1-4,193,999, set on the meter screens or via Object_Identifier; factory default is a pseudo-random number 1,000,000-3,097,151.",
      "Max_Master writable 1-127 (default 127); Max_Info_Frames is 1.",
      "Set AV 5 PT ratio before AV 6 system voltage."
    ],
    "gotchas": [
      "Writes to AVs take up to about two seconds to validate; check Reliability before reading back.",
      "Alerts are not latched and generate no events; poll the BIs or AI 83.",
      "Local date/time reset to 1 Jan 2000 on power loss; the E51H5 needs BACnet time sync for correct log timestamps."
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null
  },
