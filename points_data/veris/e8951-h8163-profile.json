  ],
  "equipment_type": "Power and energy meter (via E8951 BACnet gateway)",
  "applies_to": "Veris H8163 series energy meters fitted with the H8163-CB Modbus communication board, read through a Veris E8951 Modbus-to-BACnet protocol converter.",
  "summary": "The Veris E8951 discovers supported Veris Modbus RTU meters and presents each one as its own BACnet device on BACnet MS/TP or BACnet IP, with a fixed object profile per meter type. The H8163 profile gives energy, power, PF, voltage and current, real and reactive demand and peak demand, reset counters, phase-loss and restart timestamps, and the demand interval, reset command and clock as AVs.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": "50000 + Modbus address",
  "access_inferred": false,
  "notes": [
    "Objects as printed in the E8951 Appendix 1 profile table; names are the table's Data Variable column (the guide does not spell out the BACnet Object_Name).",
    "The E8951 creates one virtual BACnet device per discovered Modbus meter; default device instance = 50000 + Modbus address, default device name = meter series abbreviation + \"_\" + Modbus address.",
    "Date/time values (AI 39-47, AV 5-7) are floats holding two packed bytes (MSB/LSB); decode them outside BACnet.",
    "H8163 meters run at 9600 or 19200 baud."
  ],
  "source": {
    "title": "E8951 Modbus-to-BACnet Protocol Converter Installation Guide",
    "doc_number": "ZL0135-0A",
    "revision_date": "2015-06",
    "url": "https://www.cochranesupply.com/media/assets/product/documents/Veris/e8951_full_i0a2.pdf",
    "unofficial": true,
    "host": "Cochrane Supply"
  },
  "integration": {
    "summary": "Wire the meters to the E8951 downstream port at one baud rate with no parity, power up in Discovery mode and wait 2-3 minutes; each meter then shows up as a device behind the E8951's virtual network. Read the energy, power and alarm objects; AVs and AOs are meter set-up and reset registers.",
    "minimum_points": [
      {
        "ref": "AI 1",
        "name": "kWh Energy: Total",
        "why": "Total real energy, kWh"
      },
      {
        "ref": "AI 2",
        "name": "kW: Total",
        "why": "Total real power, kW"
      },
      {
        "ref": "AI 5",
        "name": "PF: Total",
        "why": "Total power factor"
      },
      {
        "ref": "AI 6",
        "name": "Volts: L-L Avg",
        "why": "Average line-to-line voltage"
      },
      {
        "ref": "AI 8",
        "name": "Amps: Avg",
        "why": "Average current"
      },
      {
        "ref": "AI 25",
        "name": "Present Real Energy Demand (kW)",
        "why": "Present real power demand, kW"
      },
      {
        "ref": "AV 4",
        "name": "Phase Loss; Latching Register (bitmap):",
        "why": "Phase-loss latching register (bitmap)"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "E8951 converts Modbus RTU (downstream RS-485) to BACnet MS/TP (up to 76.8 kbps) or BACnet IP; DIP switches A6/A7 pick the protocol, A0-A6 set the MS/TP MAC.",
      "Meters sit behind a virtual router network (default network number 50); change it in the web GUI if 50 is in use.",
      "Device ID offset (default 50000) is set in the GUI; written device instances and names stick even in Discovery mode.",
      "Set S3 to Discovery to find meters on power-up (2-3 minutes), then Locked to skip rediscovery; all meters need the same baud and no parity.",
      "Limits: 32 meters and 10,000 BACnet points per E8951; BBMD via an uploaded bdt.ini."
    ],
    "gotchas": [
      "Invalid AV writes are not rejected over BACnet; read the value back after the next scan.",
      "COV increments revert to their defaults and subscriptions are lost after a power cycle."
    ]
  },
