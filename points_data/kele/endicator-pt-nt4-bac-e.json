{
  "manufacturer": "Kele",
  "manufacturer_slug": "kele",
  "model": "endicator PT-NT4-BAC-E power meter (BACnet MS/TP)",
  "model_slug": "endicator-pt-nt4-bac-e",
  "aliases": [
    "endicator",
    "PT-NT4-BAC-E",
    "PT-NT4-BAC",
    "Kele endicator power meter"
  ],
  "equipment_type": "Power meter",
  "applies_to": "Kele endicator PT-NT4-BAC-E power and energy meter (single- or three-phase systems) with BACnet MS/TP.",
  "summary": "The endicator (PT-NT4-BAC-E) is a power and energy meter with a BACnet MS/TP interface. Analog Inputs carry power, power factor, volts, amps, frequency and import/export energy totals per phase; Analog Values hold the meter set-up (system type, CT type and pairing, pulse contacts, alarms, display); two AO/BO pairs clear the totalizers and the peak demand.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "Object names are the printed descriptions; the mapping has no separate object-name column.",
    "All Analog Inputs are read-only. AVs are set-up values; access for AV/AO/BO is not printed and is taken as writable from the notes and object type.",
    "Dates and times (clear totalizers, peak window, meter clock) are packed: low byte day or minutes, next byte month or hours.",
    "AV 20-25 hold the meter's name tag as pairs of ASCII characters; AV 26-29 are bit flags choosing what the display shows."
  ],
  "source": {
    "title": "BACnet MS/TP Point Mapping for the endicator Power Meter",
    "doc_number": null,
    "revision_date": null,
