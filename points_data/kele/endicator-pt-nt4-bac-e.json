    "setup": [
      "Set AV 1 (power system type), AV 2/AV 3 (full-scale volts/amps) and AV 4 (CT type) to match the installation."
    ],
    "gotchas": [
      "AO 1 / BO 1 clear all energy totalizers; don't write them from routine logic."
    ]
  },
