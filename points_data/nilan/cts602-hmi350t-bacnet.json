  "integration": {
    "summary": "Connect the spaceLYnk gateway to the BACnet IP network, set its IP address and a unique Device ID and enable its BACnet server. Run the unit with Control.RunSet (BV 2481), set Control.ModeSet, Control.VentSet and Control.TempSet, and read back the actual state, temperatures and the alarm status and codes.",
    "minimum_points": [
      {
        "ref": "BV 2481",
        "name": "Control.RunSet",
        "why": "Unit on/off (same as the ON/OFF keys)"
      },
      {
        "ref": "AV 2482",
        "name": "Control.ModeSet",
        "why": "Mode: 0 off, 1 heat, 2 cool, 3 auto"
      },
      {
        "ref": "AV 2483",
        "name": "Control.VentSet",
        "why": "Ventilation step: 0 off, 1-4"
      },
      {
        "ref": "AV 2484",
        "name": "Control.TempSet",
        "why": "Room temperature setpoint, °C"
      },
      {
        "ref": "AV 2465",
        "name": "Alarm.Reset",
        "why": "255 clears all alarms; 101-199 clears one code"
      },
      {
        "ref": "BV 2361",
        "name": "Control.RunAct",
        "why": "Actual on/off state"
      },
      {
        "ref": "AV 2363",
        "name": "Control.StateDisplay",
        "why": "Actual control state code"
      },
      {
        "ref": "AV 2335",
        "name": "Input.T7_Inlet",
        "why": "Supply (inlet) air temperature after heater"
      },
      {
        "ref": "AV 2351",
        "name": "Alarm.Status",
        "why": "Alarm bit mask: 0x80 = alarm(s) active"
      },
      {
        "ref": "AV 2352",
        "name": "Alarm.List_1_ID",
        "why": "First active alarm display code"
      }
    ],
    "enable": "Control.RunSet (BV 2481) works like the panel ON/OFF keys; with it off, user input functions can still start the unit.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "spaceLYnk default IP 192.168.0.10/24; web login on that address (credentials in the manual).",
      "BACnet server, Device ID, write priority, port (default 47808) and BBMD are set under Configurator > Utilities > System > Network > BACnet settings.",
      "IP settings are under Configurator > Utilities > System > Network > Interfaces; the gateway reboots after Apply Changes.",
      "Disable the KNX connection under Network > KNX connection."
    ],
    "gotchas": [
      "The spaceLYnk takes the Relinquish Default from the first read of each object; it cannot be changed later.",
      "Only a selected subset of the CTS602 Modbus list is published as BACnet objects.",
      "Once a weekly damper self-test day is set (AV 2490) it cannot be switched off.",
      "Some points apply only to Comfort, VPR or VPM models (see brackets)."
    ]
  }
}
