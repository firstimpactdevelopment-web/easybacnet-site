  "integration": {
    "summary": "Write MV 2 Mode to preset the operating mode (1 = no preset, so the local panel or switch contacts decide); set BV 4 ManOP_Disable to 1 if BMS presets must win over manual control on the panel; write AV 80 VolflowSet_R / AV 81 PressSetpoint for the setpoint. Read MV 4 RoomModeAct, AV 2 VolflowAct, AV 3 VolTotalExh, AV 6 PressAct, BV 1 LocalAlarm, BV 2 SummaryAlarm.",
    "minimum_points": [
      {
        "ref": "MV 2",
        "name": "Mode",
        "why": "Mode preset: standard, low, high, shut-off or open"
      },
      {
        "ref": "BV 4",
        "name": "ManOP_Disable",
        "why": "1 = panel manual control off, BMS presets win"
      },
      {
        "ref": "AV 80",
        "name": "VolflowSet_R",
        "why": "Room airflow setpoint for standard mode, l/s"
      },
      {
        "ref": "AV 81",
        "name": "PressSetpoint",
        "why": "Room or duct pressure setpoint, Pa"
      },
      {
        "ref": "MV 4",
        "name": "RoomModeAct",
        "why": "Current operating mode of the room"
      },
      {
        "ref": "AV 2",
        "name": "VolflowAct",
        "why": "Measured airflow, l/s"
      },
      {
        "ref": "AV 6",
        "name": "PressAct",
        "why": "Measured room or duct pressure, Pa"
      },
      {
        "ref": "BV 2",
        "name": "SummaryAlarm",
        "why": "Summary alarm of the room system"
      },
      {
        "ref": "BV 1",
        "name": "LocalAlarm",
        "why": "Alarm on this controller"
      },
      {
        "ref": "BV 3",
        "name": "PressAlarm",
        "why": "Pressure alarm"
      }
    ],
    "enable": "MV 2 Mode presets the mode (2 standard, 3 low, 4 high, 5 shut-off, 6 open; 1 = no preset, the controller then uses its local setting or standard mode). BV 4 ManOP_Disable = 1 disables manual control on the panel, so BMS presets have the highest priority.",
    "heartbeat": null,
    "remote_sensors": "AV 22 VolflowExh and AV 23 VolflowSup let the BMS feed extract and supply airflows of other equipment into the room balance.",
    "setup": [
      "EM-IP default IP address is 169.254.0.1/16; its DHCP server is off at delivery and is switched on with the Reset push button.",
      "BACnet UDP port defaults to 47808; the module can act as BBMD or foreign device (default Normal).",
      "Default device instance 17493, device name Device17493; both can be changed on the module's web server."
    ],
    "gotchas": [
      "If the network interface fails the airflow controller keeps controlling; only data exchange with the BMS stops.",
      "Change the web server's default passwords at commissioning."
    ]
  }
