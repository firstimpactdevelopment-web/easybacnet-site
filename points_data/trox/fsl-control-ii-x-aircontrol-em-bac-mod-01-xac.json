  "integration": {
    "summary": "Preset the operating mode with MV 4 Mode (occupied/unoccupied/boost/standby) or MV 2 ApplicMode, set the fan stage with MV 8 and the heat/cool changeover with MV 7, and feed BV 2 Fire and BV 3 Window if the BMS handles them. Read MV 5 ActMode, AV 7 ActRoomTemp, AV 14 EffectSetpt and the alarm BVs (BV 7, BV 8, BV 11-17).",
    "minimum_points": [
      {
        "ref": "MV 4",
        "name": "Mode",
        "why": "Occupancy preset: occupied, unoccupied, boost, standby"
      },
      {
        "ref": "MV 8",
        "name": "FanSpeed",
        "why": "Fan stage preset: off, level 1-5 or auto"
      },
      {
        "ref": "AV 5",
        "name": "TempOffset",
        "why": "Relative room setpoint offset, °C"
      },
      {
        "ref": "BV 2",
        "name": "Fire",
        "why": "Fire protection switch-off from the BMS"
      },
      {
        "ref": "MV 5",
        "name": "ActMode",
        "why": "Actual operating mode"
      },
      {
        "ref": "AV 7",
        "name": "ActRoomTemp",
        "why": "Room air temperature"
      },
      {
        "ref": "AV 14",
        "name": "EffectSetpt",
        "why": "Effective room temperature setpoint"
      },
      {
        "ref": "BV 7",
        "name": "FAlarm",
        "why": "Frost protection alarm"
      },
      {
        "ref": "BV 8",
        "name": "Alarm1",
        "why": "Alarm/error message"
      }
    ],
    "enable": "MV 4 Mode is the operating mode default from the central BMS; 5 = NUL means no preset. MV 2 ApplicMode presets the HVAC mode (1 = HVAC_NUL, inactive).",
    "heartbeat": null,
    "remote_sensors": "AV 1 OutsideTemp, AV 6 RoomTemp, AV 8 RelHumid, AV 10 VOC_Room and AV 12 VOC_Outside take values written by the BMS; the Act* objects show what the controller uses.",
    "setup": [
      "Default device instance 32900 + the network address on hex switches X/Y.",
      "Baud rate 9600, 19200, 38400 or 76800 on DIP switches 2 and 3; select BACnet or Modbus with the slide switch on the interface card.",
      "Max_Master default 127, Max_Info_Frames default 1."
    ],
    "gotchas": [
      "BV 7, BV 8, BV 9 and BV 11-17 support unsolicited COV, set by MV 1 COV-Mode.",
      "A written temperature of 327.67 is treated as invalid."
    ]
  }
