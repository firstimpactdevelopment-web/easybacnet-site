  "integration": {
    "summary": "Write MV 2 Mode to preset the operating mode (1 = no preset, so the local panel or switch contacts decide); set BV 4 ManOP_Disable to 1 if BMS presets must win over manual control on the panel; write AV 32 VolflowSet_R for the setpoint. Read MV 4 RoomModeAct, AV 2 VolflowAct, AV 3 VolTotalExh, BV 1 LocalAlarm, BV 2 SummaryAlarm.",
    "minimum_points": [
      {
        "ref": "MV 2",
        "name": "Mode",
        "why": "Mode preset: standard, low, high, shut-off or open"
      },
      {
        "ref": "BV 4",
        "name": "ManOP_Disable",
        "why": "1 = panel manual control off, BMS presets win"
      },
      {
        "ref": "AV 32",
        "name": "VolflowSet_R",
        "why": "Room airflow setpoint for standard mode, l/s"
      },
      {
        "ref": "MV 4",
        "name": "RoomModeAct",
        "why": "Current operating mode of the room"
      },
      {
        "ref": "AV 2",
        "name": "VolflowAct",
        "why": "Measured airflow, l/s"
      },
      {
        "ref": "AV 10",
        "name": "DampPos",
        "why": "Damper position, %"
      },
      {
        "ref": "BV 2",
        "name": "SummaryAlarm",
        "why": "Summary alarm of the room system"
      },
      {
        "ref": "BV 1",
        "name": "LocalAlarm",
        "why": "Alarm on this controller"
      }
    ],
    "enable": "MV 2 Mode presets the mode (2 standard, 3 low, 4 high, 5 shut-off, 6 open; 1 = no preset, the controller then uses its local setting or standard mode). BV 4 ManOP_Disable = 1 disables manual control on the panel, so BMS presets have the highest priority.",
    "heartbeat": null,
    "remote_sensors": "AV 22 VolflowExh and AV 23 VolflowSup let the BMS feed extract and supply airflows of other equipment into the room balance.",
    "setup": [
      "Default device instance is 32900 plus the network address set on hex switches X/Y.",
      "MS/TP baud rate (9600, 19200, 38400 or 76800) is set on DIP switches 2 and 3; DIP 1 selects EASYLAB TCU3 or another controller.",
      "Max_Master defaults to 127 and Max_Info_Frames to 1."
    ],
    "gotchas": [
      "If the network interface fails the airflow controller keeps controlling; only data exchange with the BMS stops."
    ]
  }
}
