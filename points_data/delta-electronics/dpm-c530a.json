{
  "manufacturer": "Delta Electronics",
  "manufacturer_slug": "delta-electronics",
  "model": "DPM-C530A power meter (BACnet MS/TP)",
  "model_slug": "dpm-c530a",
  "aliases": [
    "DPM-C530A",
    "Delta DPM-C530",
    "Delta multifunction power meter BACnet"
  ],
  "equipment_type": "Power and energy meter (panel meter)",
  "applies_to": "Delta Electronics DPM-C530A multifunction power meters on BACnet MS/TP.",
  "summary": "The DPM-C530A serves its measurements as Analog Values on BACnet MS/TP. AV 0-10 are commandable setup objects (wiring system, CT and PT ratios, demand settings, language, energy reset); AV 11-85 are read-only voltage, current, unbalance, power factor, power, energy, THD and demand values.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Ver 01.1820",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "AV 11-14 are reserved.",
    "Reactive and apparent energy (AV 63-66) report the unit kWh because BACnet has no kvarh / kVAh unit; the values are kvarh and kVAh.",
    "The PICS prints AV 64 as 'AV_064Reactive_Energy-received' (no underscore after the number); kept as printed.",
    "Device Object_Identifier and Object_Name are writable.",
    "Source: BACnet International catalog copy of Delta's PICS dated 2016-01-07."
  ],
  "source": {
    "title": "DPM-C530A BACnet Protocol Implementation Conformance Statement",
    "doc_number": null,
    "revision_date": "2016-01-07",
    "url": "https://www.bacnetinternational.net/catalog/manu/delta%20electronics,%20inc./DPM-C530A_BACnet_PICS_20160107.pdf",
    "unofficial": true,
    "host": "BACnet International catalog"
  },
  "integration": {
    "summary": "Set CT/PT ratios and the wiring system at the meter (or AV 0-5) once, then read the read-only power, energy, demand, PF, current and voltage AVs.",
    "minimum_points": [
      {
        "ref": "AV 49",
        "name": "AV_049_Active_Power_Total",
        "why": "Total real power, kW"
      },
      {
        "ref": "AV 61",
        "name": "AV_061_Active_Energy-delivered",
        "why": "Delivered energy, kWh"
      },
      {
        "ref": "AV 80",
        "name": "AV_080_Present_Demand_Active_Power",
        "why": "Present real power demand, kW"
      },
      {
        "ref": "AV 40",
        "name": "AV_040_Power_Factor_Total",
        "why": "Total power factor (sign = lead/lag)"
      },
      {
        "ref": "AV 34",
        "name": "AV_034_Current_AVG",
        "why": "Average current, A"
      },
      {
        "ref": "AV 18",
        "name": "AV_018_Voltage_L-N_AVG",
        "why": "Average L-N voltage, V"
      },
      {
        "ref": "AV 48",
        "name": "AV_048_Frequency",
        "why": "Frequency, Hz"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP master at 9600, 19200 or 38400 baud.",
      "Device object instance and name are writable over BACnet."
    ],
    "gotchas": [
      "AV 0-10 are configuration values (commandable); don't write them cyclically from the BMS.",
      "AV 10 Reset_Parameter resets energy when written with 0x5768."
    ]
  },
