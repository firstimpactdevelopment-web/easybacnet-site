  "equipment_type": "Packaged rooftop unit controller",
  "applies_to": "Reznor R7DA packaged rooftop units and Y series packaged rooftop equipment with control option D19, D21, D22 or D23 and a BACnet MS/TP (BHB8) or BACnet IP/Ethernet (BHB9) card.",
  "summary": "R7DA and Y series packaged rooftop units with controls D19, D21, D22 or D23 use a programmable system controller that accepts a BACnet MS/TP card (option BHB8) or a BACnet IP/Ethernet card (option BHB9). The point list has 42 analog variables (AV 1-42), 19 integer variables (AV 1001-1019) and 47 digital variables (BV 1-48). The BMS can enable the unit, set occupancy and state, write discharge and space setpoints, send fan/heat/cool/dehumidify calls, share outdoor temperature and humidity, and command damper and fan outputs.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": 77000,
  "access_inferred": false,
  "notes": [
    "Analog variables are AV 1-42, integer variables AV 1001-1019 and digital variables BV 1-48; BV 9 is not listed.",
    "Building and duct static pressure (AV 1001-1003, AV 1010) must be divided by 1000 in the BMS.",
    "Defaults and min/max are shown as printed; binary min/max columns give the off/on state text.",
    "Source: Table 30 BACnet Points List, guide pages 50-52."
  ],
  "source": {
    "title": "Control System Guide for R7DA and Y Series, Options D19, D21, D22 and D23",
    "doc_number": "R7DA-Y-D19-D21-D22-D23 (05-26) 1024315-C",
    "revision_date": "2026-05",
    "url": "https://assets.reznorhvac.com/download/DA4B0977-C1A0-4675-A665-3DCFC911F756/R7DA-Y-D19-D21-D22-D23%20%2805-26%29%201024315-C.pdf"
  },
  "integration": {
    "summary": "Fit the BHB8 MS/TP or BHB9 IP/Ethernet card and set the BACnet ID (default 77000), baud/MAC or IP settings from the controller's PCOWEB / NET CONFIG menu, then cycle power. Enable the unit with BV 39, set OccMode_Sel (AV 1007) to 2 and command occupancy with BV 26, pick the state with AV 1006 and write the setpoints. Monitor supply fan status, discharge temperature and the general alarm relay.",
    "minimum_points": [
      {
        "ref": "BV 39",
        "name": "Unit_Enable",
        "why": "Unit enable"
      },
      {
        "ref": "BV 26",
        "name": "Occupied_BMS",
        "why": "Occupancy command (needs AV 1007 = 2)"
      },
      {
        "ref": "AV 1007",
        "name": "OccMode_Sel",
        "why": "Occupancy source: 0 schedule, 1 input, 2 BMS"
      },
      {
        "ref": "AV 1006",
        "name": "State_Sel",
        "why": "Unit state: 2 auto, 3 cool, 4 heat, 5 off"
      },
      {
        "ref": "AV 28",
        "name": "SpcTempSP",
        "why": "Space temperature setpoint, 65-85 °F"
      },
      {
        "ref": "AV 40",
        "name": "DA_BMS_SP",
        "why": "Discharge air setpoint from the BMS (D22)"
      },
      {
        "ref": "BV 38",
        "name": "BMS_Alm_Rst",
        "why": "Alarm reset"
      },
      {
        "ref": "BV 32",
        "name": "SF_Sts",
        "why": "Supply fan status"
      },
      {
        "ref": "AV 9",
        "name": "DA_Temp",
        "why": "Discharge air temperature"
      },
      {
        "ref": "BV 1",
        "name": "Alm_Rly_Cmd",
        "why": "General alarm relay on"
      }
    ],
    "enable": "BV 39 Unit_Enable enables the unit. Occupancy comes from the schedule, a digital input or the BMS, chosen with AV 1007 OccMode_Sel; with 2 = BMS, BV 26 Occupied_BMS sets occupancy. AV 1006 State_Sel picks auto, cool, heat or off. BV 44-47 are BMS fan, heat, cool and dehumidify calls, and on D22 AV 40 DA_BMS_SP is the BMS discharge air setpoint.",
    "heartbeat": null,
    "remote_sensors": "Set BV 24 OA_Temp_Sel or BV 23 OA_Hum_Sel to 1 (BMS) and write AV 20 OA_Temp_BMS or AV 18 OA_Hum_BMS.",
    "setup": [
      "Default BACnet ID 77000; MS/TP default 38400 baud, Max Masters 127, Max Frames 20.",
      "Settings: hold Alarm and Enter > OTHER INFORMATION > PCOWEB / NET CONFIG > PCONET Settings (MS/TP) or PCOWEB Settings (IP/Ethernet).",
      "Save with Update pCOnet/pCOWeb = Yes, then cycle power to the controller."
    ],
    "gotchas": [
      "Static pressure integers are scaled x1000.",
      "BV 26 has no effect unless AV 1007 is set to 2 (BMS)."
    ]
  },
