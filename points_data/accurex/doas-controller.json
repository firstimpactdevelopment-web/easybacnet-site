  ],
  "equipment_type": "DOAS unit controller (dedicated outdoor air system)",
  "applies_to": "Accurex dedicated outdoor air systems with the factory microprocessor controller (program DOAS_08.000) and the BACnet license enabled.",
  "summary": "Accurex DOAS units use a c.pCO-family controller that offers BACnet IP or BACnet MS/TP once the BACnet license is installed. The points list is fixed for every configuration, so some points do not apply to a given unit. The BMS enables the unit, commands occupancy and setpoints, and can take over fans, damper and sensor inputs while it keeps writing a watchdog.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": "DOAS_08.000 Rev 2",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "This is Accurex's integration guide list, not every object in the controller; the guide refers to the unit's full BMS points list for detailed alarms.",
    "The guide has no read/write column; access is inferred from the guide text (commands, setpoints and BMS inputs writable, the rest read-only).",
    "IV 6-11 are 32-bit words with one status or alarm per bit (bit 0 = lowest); the states field lists every bit the guide prints for each word (unlisted bits are unused). The guide also prints some bits as separate rows, e.g. IV-11 bit 20 Cooling_is_On, bit 21 Heating_is_On, IV-10 bit 13 Filter_Alarm_Digital_Input.",
    "AV 40 shows a numeric mode from the status mode table (e.g. 10 System On, 21 Cooling, 22 Heating); values can rotate every 3 seconds.",
    "IV 5 returns a numeric code from the alarm table (0 = no active alarm, 79 = BMS offline).",
    "Setpoint ranges shown are typical defaults; the guide says to check each point's min/max properties."
  ],
  "integration": {
    "summary": "With the BACnet license installed, set the BACnet IP or MS/TP settings in the controller's Network Settings menu. Write BV 2 to enable the unit and BV 3 for occupancy; setpoints such as AV 1 can be adjusted. To command fans, damper or sensor values, set the matching BMS-source BV and write BV 1 watchdog repeatedly.",
    "minimum_points": [
      {
        "ref": "BV 2",
        "why": "Unit enable (1 = enabled)",
        "name": "System_Enable"
      },
      {
        "ref": "BV 3",
        "why": "Occupancy: 0 = occupied, 1 = unoccupied",
        "name": "BMS_Occupancy_Command"
      },
      {
        "ref": "AV 1",
        "why": "Occupied temperature setpoint, °F",
        "name": "Temperature_Setpoint"
      },
      {
        "ref": "BV 1",
        "why": "Watchdog; write 1 regularly when BMS commands",
        "name": "BMS_Watchdog"
      },
      {
        "ref": "BV 4",
        "why": "Resets alarms",
        "name": "Reset_All_Alarms"
      },
      {
        "ref": "AV 40",
        "why": "Unit mode number (status mode table)",
        "name": "Unit_Status_Mode"
      },
      {
        "ref": "AI 2",
        "why": "Supply air temperature, °F",
        "name": "Supply_Temp_Analog_Input"
      },
      {
        "ref": "BI 2",
        "why": "Supply fan running",
        "name": "Supply_Fan_1_Status_Digital_Input"
      },
      {
        "ref": "BV 23",
        "why": "Any active alarm",
        "name": "Global_Alarm"
      },
      {
        "ref": "IV 5",
        "why": "Latest alarm code; 0 = none",
        "name": "LatestAlm"
      }
    ],
    "enable": "BV 2 System_Enable enables or disables the unit, and BV 3 BMS_Occupancy_Command sets occupancy (the default occupancy mode expects the BMS command; a schedule, digital input or fixed mode can be chosen at the controller instead).",
    "heartbeat": "BV 1 BMS_Watchdog must be written True regularly whenever the BMS commands fans, damper or sensor values. If it stays False longer than the timeout (default 15 min, adjustable), alarm 79 is raised and the controller goes back to local control and sensors. With Enable Relinquish Default on, commandable points are cleared to relinquish defaults 5 minutes after the watchdog drops.",
    "remote_sensors": "Set the source BV to BMS (BV 7-16) and write the value to the matching AV 26-35 (outside/return RH and temperature, space/return CO2, space RH, static and temperature). The watchdog must be kept alive or the controller falls back to the local sensor.",
    "setup": [
      "BACnet needs a license on the controller; contact the rep if it is not enabled.",
      "Network settings are under Main Menu > Ctrl Variables > Advanced > Login > Network Settings (user password required).",
      "BBMD, foreign device, COV increments and relinquish default options are in the Advanced Settings menu."
    ],
    "gotchas": [
      "BV 3 is 1 = Unoccupied, 0 = Occupied.",
      "For BMS supply temperature reset, set IV 1 to No Reset and write AV 1.",
      "Integer words must be unpacked bit by bit in the BMS.",
      "Some points do not apply to every unit configuration."
    ]
  },
  "source": {
    "title": "BACnet Integration Guide for Dedicated Outdoor Air Systems",
    "doc_number": "485940 (DOAS_08.000 Rev 2)",
    "revision_date": "01/2023",
