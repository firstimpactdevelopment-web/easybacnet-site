        "why": "Fan did not start within 2 min of a run command"
      },
      {
        "ref": "MV 7",
        "name": "PreheatBurnerLockoutAlarm",
        "why": "Preheat burner lockout"
      },
      {
        "ref": "MV 2",
        "name": "LowTempAlarm",
        "why": "Low temperature alarm"
      }
    ],
    "enable": "network_FanCommand (BV 22) turns the unit on and off from the BMS.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "MAC address: DIP switches 1-8 on the controller, switch 1 = least significant bit.",
      "Baud rate is detected automatically after a power cycle.",
      "Device instance = 3640 followed by the MAC address (MAC 25 gives 364025); change the MAC to fix a duplicate instance."
    ],
    "gotchas": [
      "Write null to network_VFD_Econ_SetPoint to return the VFD to automatic control.",
      "Burner reset objects are toggled to reset a locked-out burner."
    ]
  },
