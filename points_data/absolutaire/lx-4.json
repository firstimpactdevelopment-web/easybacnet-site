  "equipment_type": "Make-up air unit controls (heating, ventilating, optional cooling)",
  "applies_to": "AbsolutAire heating, ventilating and make-up air units built with the LX-4 control option (Edge534 controller and touch-screen HMI).",
  "summary": "The LX-4 option runs AbsolutAire units on a JENEsys Edge534 Niagara controller with a touch-screen HMI. It offers BACnet IP, BACnet MS/TP and Modbus TCP as standard. The BMS can run the unit, pick heat/vent/cool/auto, override occupancy, write heating and cooling setpoints, discharge limits and economizer/VFD settings, and read temperatures, airflow, energy and alarm objects.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": "Niagara 4.7 (as described in the guide)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "The points list (guide pages 25-26) is printed as a rotated image; values were keyed by hand from the rendered page and checked row by row.",
    "Writable AV, BV and MV objects list priority levels 1-16, so they are shown as commandable; inputs list none.",
    "The guide covers standard features only; custom-built units can differ, and objects for options a unit does not have (cooling, mixed air, filter transmitters, power exhaust) carry no meaning.",
    "Units are only partly printed in the table; °F, %, CFM and hours here follow the descriptions.",
    "MaintenanceMessage is an enumerated multistate input over BACnet; the guide does not list its states."
  ],
  "source": {
    "title": "LX-4 User Guide - points list",
    "doc_number": "LX-4 User Guide 072020",
    "revision_date": null,
    "url": "https://www.absolutaire.com/wp-content/uploads/lx-4_user_guide.pdf"
  },
  "integration": {
    "summary": "Command the unit with UnitRunCommand (1 off, 2 on) and OperationMode, and use OccupancyOverride to force occupied or unoccupied or follow the schedule. Write the occupied heating (and cooling) setpoints and read Fan_ON, BurnerOn, temperatures and the alarm BIs. All writable objects are commandable with a priority array.",
    "minimum_points": [
      {
        "ref": "MV 0",
        "name": "UnitRunCommand",
        "why": "Unit run: 1 off, 2 on"
      },
      {
        "ref": "MV 1",
        "name": "OperationMode",
        "why": "1 heat, 2 vent, 3 cool, 4 auto"
      },
      {
        "ref": "MV 2",
        "name": "OccupancyOverride",
        "why": "1 manual unocc, 2 manual occ, 3 follow schedule"
      },
      {
        "ref": "AV 7",
        "name": "OccupiedHeatSetPoint",
        "why": "Occupied heating setpoint, °F"
      },
      {
        "ref": "AV 9",
        "name": "OccupiedCoolSetPoint",
        "why": "Occupied cooling setpoint, °F (if cooling)"
      },
      {
        "ref": "BI 13",
        "name": "Fan_ON",
        "why": "Fan running status"
      },
      {
        "ref": "BI 14",
        "name": "BurnerOn",
        "why": "Burner on status"
      },
      {
        "ref": "AI 23",
        "name": "DischargeTemperature",
        "why": "Discharge air temperature"
      },
      {
        "ref": "BI 7",
        "name": "BurnerLockoutAlarm",
        "why": "Burner lockout (1 = alarm)"
      },
      {
        "ref": "BI 6",
        "name": "MotorNotRespondingAlarm",
        "why": "Fan motor not responding (1 = alarm)"
      }
    ],
    "enable": "UnitRunCommand (MV 0): 1 = off, 2 = on.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet IP, BACnet MS/TP and Modbus TCP are standard on the Edge534 controller (2 Ethernet and 2 RS-485 ports)."
    ],
    "gotchas": [
      "Burner reset and maintenance run-time reset act on a toggle (1 to 2 or 2 to 1).",
      "PID tuning MVs take 1 (most aggressive) to 11 (least); 6 is the default."
    ]
  },
