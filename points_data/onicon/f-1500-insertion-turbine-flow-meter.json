    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Factory menu password 16363. Set Diagnostics > Config Code > comm type to BACnet, then Output menu > Baud Rate and MAC address.",
      "Baud 9600, 19200, 38400 or 76800; MAC 0-127 (MS/TP master only).",
      "Device object default instance 7; Max Master 127; Max Info Frames 1; no segmentation; max APDU 300.",
      "Device Communication Control password: vortek.",
      "Power-cycle the meter after changing settings."
    ],
    "gotchas": [
      "The manual's setup steps end by switching comm type back to HART after setting baud/MAC; check the comm type reads BACnet before commissioning.",
      "Max Info Frames is 1 and Max Master 127; neither is writable over BACnet."
    ]
  },
