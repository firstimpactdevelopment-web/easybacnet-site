  ],
  "equipment_type": "BTU (energy) meter, clamp-on ultrasonic",
  "applies_to": "ONICON System-40 BTU measurement systems (clamp-on ultrasonic flow plus supply/return temperature) with the BACnet MS/TP interface.",
  "summary": "The System-40 measures flow with clamp-on ultrasonic transducers and pairs it with supply and return temperature sensors to calculate thermal energy. Over BACnet MS/TP it exposes energy and flow rates, temperatures, ultrasonic signal diagnostics, energy and volume totals, auxiliary pulse totals and a meter status code. Mode 1 and mode 2 totals are kept separately when the meter runs in dual mode.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 57017,
  "access_inferred": true,
  "notes": [
    "The manual gives each object by identifier and function; Object_Name is shown only as \"Various\" (except MV 1 and TL 1). Names here are the dual mode function text; the description gives the single mode meaning.",
    "In single mode both objects of each mode 1/mode 2 pair are listed with the same single mode function (for example AV 1 and AV 2 \"Energy total\").",
    "Units shown are factory defaults and can be changed: energy kBtu, MBtu, ton-hours, kJ, MJ, kWh or MWh; volume gallons, liters, ft3 or m3; temperature °F or °C; speed of sound ft/s or m/s.",
    "There is no per-object read/write column. The reset BVs are marked W because writing 1 resets the total; the rest are shown as read-only."
  ],
  "source": {
    "title": "System-40 BTU Measurement System Installation and Operation Guide",
    "doc_number": "DOC-0002831",
    "revision_date": "Rev.H",
    "url": "https://www.onicon.com/wp-content/uploads/system-40-btu-measurement-system-manual-doc-0002831.pdf"
  },
  "integration": {
    "summary": "Read the energy rate, flow and both temperatures for live data and the energy and volume totals for billing or trending. Map the signal quality AI and MV 1 Meter Status to catch transducer or sensor problems. Only the total resets are written from the BMS.",
    "minimum_points": [
      {
        "ref": "AI 1",
        "name": "Energy rate",
        "why": "Energy rate, kBtu/h by default"
      },
      {
        "ref": "AI 2",
        "name": "Volume rate",
        "why": "Flow rate, gpm by default"
      },
      {
        "ref": "AI 3",
        "name": "Supply temperature",
        "why": "Supply water temperature"
      },
      {
        "ref": "AI 4",
        "name": "Return temperature",
        "why": "Return water temperature"
      },
      {
        "ref": "AV 1",
        "name": "Mode 1 energy total",
        "why": "Energy total (mode 1 total in dual mode)"
      },
      {
        "ref": "AV 9",
        "name": "Mode 1 volume total",
        "why": "Volume total (mode 1 total in dual mode)"
      },
      {
        "ref": "AI 7",
        "name": "Signal quality",
        "why": "Ultrasonic signal quality, 3 = best"
      },
      {
        "ref": "MV 1",
        "name": "Meter Status",
        "why": "Meter status; 1 = Normal, 11 = System Fault"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP on terminal block TB4, 2-wire half duplex, 1/4 unit load.",
      "MAC address 1-127, default 17. Device instance 0-4,194,302, default 57017.",
      "Baud 9600, 19200, 38400 or 76800; default 38400. 120 ohm termination selectable, default off; no biasing."
    ],
    "gotchas": [
      "In dual mode read both the mode 1 and mode 2 totals (for example AV 1 and AV 2).",
      "The trend log multiple holds 120 records and rolls over; interval 30 s to 1 h, default 15 min.",
      "Meter Status 8 (Low Signal Quality) means a weak transducer signal; the manual says to check for air trapped in the piping."
    ]
  },
