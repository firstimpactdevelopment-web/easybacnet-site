  "integration": {
    "summary": "Set the gateway IP, device instance and LON unit address with the Fujitsu configuration tool, scan the VRF network for units, and download the configuration. Each indoor unit then appears as a block of IU_rr_uu objects; map on/off, mode, setpoint, room temp and the error status first.",
    "minimum_points": [
      {
        "ref": "BO 100101",
        "name": "IU_rr_uu_Operation_Setting",
        "why": "Start/stop the indoor unit"
      },
      {
        "ref": "MO 100101",
        "name": "IU_rr_uu_OperationMode_Setting",
        "why": "Command the operating mode"
      },
      {
        "ref": "AO 100101",
        "name": "IU_rr_uu_SetTemp_Setting",
        "why": "Setpoint command"
      },
      {
        "ref": "MO 110101",
        "name": "IU_rr_uu_FanSpeed_Setting",
        "why": "Fan speed command"
      },
      {
        "ref": "BI 110101",
        "name": "IU_rr_uu_Operation_Status",
        "why": "Confirm run status"
      },
      {
        "ref": "MI 100101",
        "name": "IU_rr_uu_OperationMode_Status",
        "why": "Read back the mode"
      },
      {
        "ref": "AI 110101",
        "name": "IU_rr_uu_SpaceTemp_Status",
        "why": "Room temperature"
      },
      {
        "ref": "BI 100101",
        "name": "IU_rr_uu_Exists_Status",
        "why": "Shows whether the unit is present"
      },
      {
        "ref": "BI 150101",
        "name": "IU_rr_uu_Error_Status",
        "why": "Indoor unit fault"
      },
      {
        "ref": "MI 150101",
        "name": "IU_rr_uu_ErrorCode_Status",
        "why": "Error code (1-255) when a fault is active"
      }
    ],
    "enable": "No enable point is described. Remote controller prohibition is a 65-state multistate (IU_rr_uu_RC_Prohibit_Setting, or Batch_RC_Prohibition_Setting for all units) whose states combine filter reset, start, start/stop, mode, setpoint and timer lockouts, plus All. Outdoor units have a ForcedOff setting.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Default IP 192.168.100.144, mask 255.255.255.0, configuration password 'admin'.",
      "Default device instance 144 in the configuration tool (the object table shows 144000); give each gateway a unique value.",
      "UDP port 47808 by default; network role can be disabled, foreign device or BBMD.",
      "LON unit address of the gateway must be 92-95 and unique on the VRF network; temperature units (C/F) are chosen in the tool.",
      "A unit scan takes about 5-6 minutes; units can also be added manually."
    ],
    "gotchas": [
      "Outputs keep Priority_Array slots 1-15 empty and put the value in slot 16, so priority-based commanding may not behave as expected.",
      "State_Text cannot be read as a whole array; read each index separately.",
      "Input objects list Reliability as NO_FAULT_DETECTED or UNRELIABLE_OTHER; the manual does not say exactly when UNRELIABLE_OTHER is set.",
      "Error code meanings come from the manual's error tables for each series and may be added without notice."
    ]
  }
}
