  ],
  "equipment_type": "Boiler plant sequencer",
  "applies_to": "Fulton ModSync SE hydronic boiler sequencer (software 6.6.1.X) managing up to 8 boilers, read through the N54 ProtoNode.",
  "summary": "The ModSync SE sequences up to eight hydronic boilers, and Fulton's N54 ProtoNode publishes its data as one flat list of 164 objects. Plant points cover enable, setpoint source and value, supply/return temperatures and the alarm code; each boiler then has a 12-point block of status, temperature and firing rate, followed by optional valve, pump and pressure points.",
  "bacnet_transport": [],
  "firmware": "ModSync SE 6.6.1.X",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Object IDs are fixed (1-164) and do not depend on boiler addresses.",
    "The sheet does not say which BACnet transport the gateway is set to; ProtoNode gateways are normally configured for BACnet IP or BACnet MS/TP.",
    "Points marked (Note 2) only work if the matching option is enabled at the ModSync.",
    "Current Fuel points apply only to boilers with LMV burner controls.",
    "Differential Setpoint is a temperature or a pressure, depending on the selection at the ModSync.",
    "Per-boiler blocks: boiler 1 = 13-24, boiler 2 = 25-36 ... boiler 8 = 97-108."
  ],
  "integration": {
    "summary": "Enable the plant with Remote Enable/Disable, set ModSync Setpoint Mode to BMS and write the supply setpoint to BMS Setpoint Input. Read back the active ModSync setpoint, supply temperature, each boiler's run and alarm status and the ModSync alarm code.",
    "minimum_points": [
      {
        "ref": "BV 7",
        "name": "Remote Enable/Disable",
        "why": "Plant enable (1 = enable)"
      },
      {
        "ref": "AV 9",
        "name": "BMS Setpoint Input (Note 2)",
        "why": "Supply setpoint from the BMS, °F"
      },
      {
        "ref": "AV 10",
        "name": "ModSync Setpoint Mode",
        "why": "Must be 2 = BMS to use the BMS setpoint"
      },
      {
        "ref": "BI 16",
        "name": "Boiler 1 Run Status",
        "why": "Boiler 1 running (repeat per boiler)"
      },
      {
        "ref": "AI 11",
        "name": "ModSync Setpoint",
        "why": "Active plant setpoint, °F"
      },
      {
        "ref": "AV 3",
        "name": "Supply Temperature",
        "why": "System supply water temperature, °F"
      },
      {
        "ref": "AI 22",
        "name": "Boiler 1 Firing Rate",
        "why": "Boiler 1 firing rate, % (repeat per boiler)"
      },
      {
        "ref": "BI 17",
        "name": "Boiler 1 Alarm Status",
        "why": "Boiler 1 alarm (repeat per boiler)"
      },
      {
        "ref": "AI 12",
        "name": "ModSync Alarm Code",
        "why": "Plant alarm code from Fulton's alarm chart"
      }
    ],
    "enable": "BV 7 Remote Enable/Disable enables the plant from the BMS. For a BMS setpoint, set AV 10 ModSync Setpoint Mode = 2 (BMS) and write AV 9 BMS Setpoint Input; AV 9 is an optional point that has to be enabled at the ModSync.",
    "heartbeat": null,
    "remote_sensors": "Outdoor air (AV 2), return (AV 4), differential (AV 5) and the system pressures (AV 149-151) are read/write analog values, available when the matching option is enabled at the ModSync. The sheet does not say when the BMS must write them.",
    "setup": [
      "Object IDs 1-164 are fixed; boiler 1 data is 13-24, each further boiler adds 12 (boiler 8 = 97-108).",
      "The sheet gives no device instance, MAC address or baud rate; those are set on the ProtoNode gateway."
    ],
    "gotchas": [
      "Points marked (Note 2) stay inactive unless the option is enabled at the ModSync.",
      "Status, Lead Lag Position and alarm codes are analog values carrying a code; see the states."
    ]
  },
