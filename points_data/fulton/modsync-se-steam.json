{
  "manufacturer": "Fulton",
  "manufacturer_slug": "fulton",
  "model": "Steam ModSync SE v6.6.1.0 (ProtoNode)",
  "model_slug": "modsync-se-steam",
  "aliases": [
    "ModSync SE",
    "ModSync",
    "Fulton ModSync steam",
    "ProtoNode"
  ],
  "equipment_type": "Steam boiler plant sequencer",
  "applies_to": "Fulton ModSync SE steam boiler sequencer (version 6.6.1.0) managing up to 8 steam boilers, read through a Sierra Monitor ProtoNode.",
  "summary": "The steam version of the ModSync SE sequences up to eight steam boilers, and a Sierra Monitor ProtoNode publishes its data as 104 objects (IDs 1-108). Plant objects cover lead boiler, header pressure, building mode, remote enable, setpoint source and value and the alarm code; each boiler then has a 12-object block of local/remote, enable, demand, run, alarm, status, lead/lag position, outlet pressure, firing rate, cycles and run hours.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Fulton's file name marks this as the steam version of the manual; the manual itself shows pressures in psi and does not repeat the word steam.",
    "Object IDs 1-108 are fixed and do not depend on boiler addresses; IDs 2, 4, 5 and 8 are not used on the steam version.",
    "Per-boiler blocks: boiler 1 = 13-24, boiler 2 = 25-36 ... boiler 8 = 97-108.",
    "The manual's alarm chart (pages 11-14) decodes the ModSync Alarm Code.",
    "Pressure ranges depend on the sensor selected at the ModSync.",
    "Hydronic sister product: fulton/modsync-se-hydronic."
  ],
  "integration": {
    "summary": "Enable the plant with Remote Enable/Disable, set ModSync Setpoint Mode to BMS and write the steam pressure setpoint to BMS Setpoint Input. Read back the active ModSync setpoint, header pressure, each boiler's run and alarm status and the ModSync alarm code.",
    "minimum_points": [
      {
        "ref": "BV 7",
        "name": "Remote Enable/Disable",
        "why": "Plant enable (1 = enable)"
      },
      {
        "ref": "AV 9",
        "name": "BMS Setpoint Input (Note 2)",
        "why": "Steam pressure setpoint from the BMS, psi"
      },
      {
        "ref": "AV 10",
        "name": "ModSync Setpoint Mode",
        "why": "Must be 2 = BMS to use the BMS setpoint"
      },
      {
        "ref": "BI 16",
        "name": "Boiler 1 Run Status",
        "why": "Boiler 1 running (repeat per boiler)"
      },
      {
        "ref": "AI 11",
        "name": "ModSync Setpoint",
        "why": "Active plant setpoint, psi"
      },
      {
        "ref": "AV 3",
        "name": "Supply Header Pressure",
        "why": "Supply header steam pressure, psi"
      },
      {
        "ref": "AI 22",
        "name": "Boiler 1 Firing Rate",
        "why": "Boiler 1 firing rate, % (repeat per boiler)"
      },
      {
        "ref": "BI 17",
        "name": "Boiler 1 Alarm Status",
        "why": "Boiler 1 alarm (repeat per boiler)"
      },
      {
        "ref": "AI 12",
        "name": "ModSync Alarm Code",
        "why": "Plant alarm code from Fulton's alarm chart"
      }
    ],
    "enable": "BV 7 Remote Enable/Disable enables the plant from the BMS. For a BMS setpoint, set AV 10 ModSync Setpoint Mode = 2 (BMS) and write AV 9 BMS Setpoint Input; AV 9 only works if that option is enabled at the ModSync.",
    "heartbeat": null,
    "remote_sensors": "AV 3 Supply Header Pressure is a read/write analog value (0-200 psi, range depends on the sensor). The manual does not say when the BMS must write it.",
    "setup": [
      "The ProtoNode offers BACnet MS/TP on its RS-485 terminals (+, -, G) and BACnet IP on its Ethernet port; the port you connect to picks the protocol.",
      "Object IDs 1-108 are fixed; boiler 1 data is 13-24, each further boiler adds 12 (boiler 8 = 97-108).",
      "The manual gives no device instance, MAC address or baud rate."
    ],
    "gotchas": [
      "Points marked Note 2 stay inactive unless the option is enabled at the ModSync.",
      "Current Fuel applies only to Fulton Vantage boilers.",
      "Status, Lead Lag Position and alarm codes are analog inputs carrying a code; see the states."
    ]
  },
  "source": {
    "title": "ModSync SE BACnet Interface Manual, Version 6.6.1.0",
    "doc_number": null,
    "revision_date": null,
    "url": "https://fulton.com/app/uploads/2021/07/ModSync-SE-Steam-v6610-BACnet-260611.pdf"
  },
