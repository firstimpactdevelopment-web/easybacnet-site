{
  "manufacturer": "Belimo",
  "manufacturer_slug": "belimo",
  "model": "ZIP Economizer (ECON-ZIP-BASE + ECON-ZIP-COM)",
  "model_slug": "zip-economizer",
  "aliases": [
    "ZIP Economizer",
    "ECON-ZIP-BASE",
    "ECON-ZIP-COM",
    "ECON-ZIP-EM",
    "Belimo economizer controller BACnet",
    "ZIP Economizer BACnet"
  ],
  "equipment_type": "Rooftop unit economizer controller",
  "applies_to": "Belimo ZIP Economizer controllers for packaged rooftop units (ECON-ZIP-BASE) with the ECON-ZIP-COM communication module for BACnet MS/TP.",
  "summary": "The ZIP Economizer is a rooftop unit economizer controller that runs free cooling, integrated cooling, DCV, ventilation, purge and compressor lockouts from thermostat calls. With the ECON-ZIP-COM module it is a BACnet MS/TP device that reports temperatures, humidity, enthalpy, CO2, damper position, run times, thermostat and relay states, operating mode and the active alarm. The BMS can send occupancy, heating and cooling commands, feed network sensor values, and adjust setpoints and changeover limits.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Application 02.01.1003, firmware 08.04.0000",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Many objects need optional parts: the Energy Module (ECON-ZIP-EM) for DCV, exhaust fan, 2-speed fan, purge and remote override; humidity sensors for the enthalpy objects.",
    "Network sensor AOs (AO 1-5) default to 8888, meaning no value.",
    "Writing AO 6 RemoteDmpOverridePos disables free cooling, ventilation, DCV and purge.",
    "High limits marked as climate-zone dependent default from the ZIP code in AV 17.",
    "MI 4 lists 36 zones in the definition table although the value range is printed as 1-34."
  ],
  "integration": {
    "summary": "Select BACnet Active in the Com Interface menu and set baud, device ID and MS/TP address. Command occupancy and the Y1/Y2/W1 calls through MO 1-5, or let the thermostat drive them, and read MI 1 operating mode, AI 1 damper position, SAT/OAT and BI 1 / MI 2 for alarms.",
    "minimum_points": [
      {
        "ref": "MO 1",
        "name": "OccupancyCommand",
        "why": "Occupancy (fan): 1 enabled, 2 disabled"
      },
      {
        "ref": "MO 4",
        "name": "Y1Command",
        "why": "Stage 1 cooling call"
      },
      {
        "ref": "MO 5",
        "name": "Y2Command",
        "why": "Stage 2 cooling call"
      },
      {
        "ref": "MO 3",
        "name": "W1Command",
        "why": "Heating call"
      },
      {
        "ref": "AV 2",
        "name": "SpFreeCoolSAT",
        "why": "Free cooling supply air setpoint"
      },
      {
        "ref": "MI 1",
        "name": "OperationMode",
        "why": "Operating mode (free cooling, DCV, etc.)"
      },
      {
        "ref": "AI 1",
        "name": "RelPosDmpFb",
        "why": "Damper position feedback, %"
      },
      {
        "ref": "AI 2",
        "name": "SAT",
        "why": "Supply air temperature"
      },
      {
        "ref": "AI 3",
        "name": "OAT",
        "why": "Outdoor air temperature"
      },
      {
        "ref": "MI 2",
        "name": "CurrentAlarm",
        "why": "Most recent active alarm"
      }
    ],
    "enable": "Set Com Interface to BACnet Active (default is MP Active); the ECON-ZIP-COM module is required.",
    "heartbeat": "AV 18 BusWatchdog sets a bus timeout of 0-3600 s (0 = off, the default). When it trips, the commandable objects fall back to their relinquish defaults.",
    "remote_sensors": "AO 1-5 accept CO2, outdoor and return humidity and temperature from the network; they read 8888 (no value) until written.",
    "setup": [
      "Com Interface menu: BACnet Active, then baud (9600-115200), BACnet Device ID and MS/TP address.",
      "At least one SAT and one OAT sensor and one compressor are needed for economizer operation.",
      "Attached devices are auto-detected; their settings appear once detected."
    ],
    "gotchas": [
      "MO commands relinquish (value 3) to hand control back to the thermostat inputs.",
      "PurgeCommand works only with BV 1 PurgeOperationEn active.",
      "Remote damper override needs BV 3 RemoteDmpOverrideEn active."
    ]
  },
  "source": {
