{
  "manufacturer": "Belimo",
  "manufacturer_slug": "belimo",
  "model": "ZoneEase VAV zone control actuator (BACnet MS/TP)",
  "model_slug": "zoneease-vav",
  "short_model": "ZoneEase VAV",
  "aliases": [
    "ZoneEase VAV",
    "LMV-BAC-..",
    "NMV-BAC-..",
    "Belimo ZoneEase"
  ],
  "equipment_type": "VAV zone controller / actuator",
  "applies_to": "Belimo ZoneEase VAV actuators LMV-BAC-.. and NMV-BAC-.. with the built-in zone control applications, application software ZoneEase 1.7.",
  "summary": "ZoneEase VAV is a VAV damper actuator with a built-in differential pressure sensor and zone control applications (cooling, changeover, electric or hydronic reheat, parallel or series fan, CO2 and plain VAV). It runs on BACnet MS/TP. The BMS mostly sets the system mode, room setpoint, airflow limits and the heating/cooling changeover, and reads room temperature, airflow and status.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Application ZoneEase 1.7",
  "default_device_instance": 1,
  "access_inferred": false,
  "notes": [
    "The interface description lists every object twice (alphabetical, then grouped); the alphabetical list (pdf pp5-11) was used.",
    "Multi-state state numbers are as printed in the guide.",
    "Many values exist in several units (m³/h, cfm, °C, °F) plus a _UnitSel copy that follows MV 121 / MV 128.",
    "Which objects are used depends on the application chosen in MV 2; CO2 and VAV-only objects are marked in the descriptions.",
    "MI 101 is printed W in the alphabetical list and R in the grouped list; listed as R. MV 4 has no access mark and is listed as R."
  ],
  "source": {
    "title": "BACnet Interface description, ZoneEase VAV (VAV zone control actuator)",
    "doc_number": "V1.7",
    "revision_date": "2025-05",
    "url": "https://www.belimo.com/mam/general-documents/system_integration/BACnet/belimo_BACnet_Interface-description_ZoneEase-VAV_V1_7_en-gb.pdf"
  },
  "integration": {
    "summary": "Pick the application in MV 2 during commissioning, then run the zone from the BMS with MV 1 SystemMode, AV 108 room setpoint and BV 1 changeover (where the application uses it). Read room temperature, airflow and damper position, and watch the status MIs. If a bus fail action is set, keep writing within the watchdog time.",
    "minimum_points": [
      {
        "ref": "MV 1",
        "name": "SystemMode",
        "why": "Off / Active / Eco / Boost"
      },
      {
        "ref": "AV 108",
        "name": "SpRmT_C",
        "why": "Room temperature setpoint, °C"
      },
      {
        "ref": "BV 1",
        "name": "BMS Changeover",
        "why": "Heating or cooling air from the AHU"
      },
      {
        "ref": "AI 20",
        "name": "RmT_C",
        "why": "Room temperature, °C"
      },
      {
        "ref": "AI 12",
        "name": "AbsAirFlow_m3h",
        "why": "Measured airflow, m³/h"
      },
      {
        "ref": "AI 1",
        "name": "RelPosDmp",
        "why": "Damper position, %"
      },
      {
        "ref": "MI 101",
        "name": "StatusSystem",
        "why": "System health: sensor and config faults"
      },
      {
        "ref": "MI 106",
        "name": "StatusActuator",
        "why": "Actuator status and errors"
      }
    ],
    "enable": "MV 1 SystemMode switches the zone between Off, Active, Eco and Boost. In the VAV application (#9 in MV 2) the BMS sets the airflow directly with AV 102-104. MO 1 Override can force the damper or a fixed airflow, temperature or CO2 setpoint (types 8-13 use AO 10).",
    "heartbeat": "AV 130 BusWatchdog, 5-3600 s, default 120 s. If no write arrives within the timeout the actuator runs MV 130 BusFailAction (default None).",
    "remote_sensors": "BV 1 BMS Changeover tells the zone whether the AHU supplies cool or warm air (all applications except #2, #8 and #9). Room temperature, humidity and CO2 come from the connected room operating unit or analog input, not from the BMS.",
    "setup": [
      "MS/TP only: baud 9600-115200, default 38400; address 0-127, default 1; max 32 nodes without repeater.",
      "Device instance 0-4194302, default 1.",
      "Configure with the Belimo ZoneEase VAV app (Android).",
      "AV 200 TrunkNoCloud records the MS/TP trunk for the cloud twin and helps spot MAC collisions."
    ],
    "gotchas": [
      "Persistent writable objects (limits, tuning, configuration) should not be written cyclically.",
      "Airflow and temperature objects come in several unit versions; map one set and stick to it.",
      "Max 5 active COV subscriptions, lifetime up to 8 hours."
    ]
  },
