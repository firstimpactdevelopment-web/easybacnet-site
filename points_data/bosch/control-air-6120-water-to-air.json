{
  "manufacturer": "Bosch",
  "manufacturer_slug": "bosch",
  "model": "Control Air 6120 - Water to Air (WAF software)",
  "model_slug": "control-air-6120-water-to-air",
  "aliases": [
    "Control Air 6120",
    "WAF 1.01",
    "Bosch commercial WSHP DDC",
    "Bosch TT Water to Air"
  ],
  "equipment_type": "Commercial water-source heat pump controller",
  "applies_to": "Bosch commercial water-to-air heat pumps (up to 4 compressor stages) with the Control Air 6120 DDC controller and WAF software.",
  "summary": "The Control Air 6120 is Bosch's DDC controller for larger commercial water-to-air heat pumps, including discharge-air control, VFD fans, economizer/boilerless options, hot gas reheat and auxiliary heat. It is a BACnet Advanced Application Controller on MS/TP, PTP or ARC156 (also Modbus and N2). Many points only apply with the Control Air 6120 Point Expander and the matching options.",
  "bacnet_transport": [
    "BACnet MS/TP",
    "BACnet ARC156",
    "BACnet PTP"
  ],
  "firmware": "WAF.1.01",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Object names end in _1 as printed; the LP3 alarm is printed with the name x_1 (BV 6).",
    "Alarms are reported through current_alarm_1 (AV 17); high-static lockout is reported as code 100 on sys_status_1 (AV 16) and can only be reset from BACview.",
    "Points for compressor stages 3-4, auxiliary heat 2-4 and second UPM only apply to units built with them.",
    "AV 2001-2005 hold factory serial / part number data."
  ],
  "source": {
    "title": "Bosch TT - Water to Air Network Integration Points List",
    "doc_number": "WAF.1.01",
    "revision_date": "2019-08-12",
    "url": "https://www.bosch-homecomfort.com/us/media/country_pool/service/technical_guides/ipl_waf_1_01_us.pdf"
  },
  "integration": {
    "summary": "Command occupancy over the network with occupancy_cmd_1 (Control Source = BAS), write occupied setpoints, and choose the temperature source; supply BAS values (zone temp, DAT, RH, CO2, OAT) if the BMS owns the sensors. Monitor current_alarm_1, alm_status_1 and sys_status_1.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "occupancy_cmd_1",
        "why": "BAS occupied/unoccupied command"
      },
      {
        "ref": "AV 15",
        "name": "ctrl_source_1",
        "why": "Occupancy source; 2 = BAS occupancy command (default)"
      },
      {
        "ref": "AV 4",
        "name": "occ_clg_stpt_1",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 2",
        "name": "occ_htg_stpt_1",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "AV 7",
        "name": "bas_sen_val_1",
        "why": "Zone temperature written by the BMS"
      },
      {
        "ref": "AV 16",
        "name": "sys_status_1",
        "why": "Unoccupied / occupied / fan only / heating / cooling state"
      },
      {
        "ref": "AV 57",
        "name": "eff_zone_temp_1",
        "why": "Zone temperature in use"
      },
      {
        "ref": "AV 17",
        "name": "current_alarm_1",
        "why": "Active alarm code"
      },
      {
        "ref": "BV 24",
        "name": "alm_status_1",
        "why": "Alarm present flag"
      }
    ],
    "enable": "Control Source (ctrl_source_1, AV 15) defaults to 2 = BAS Occupancy Command; write occupancy_cmd_1 (BV 1) to occupy the unit. Alternatives are digital input IN-1, keypad schedule, manual on or the ZS push-button override. loop_enabled_1 (BV 23) must be 1 to allow heating and cooling.",
    "heartbeat": null,
    "remote_sensors": "BMS values can be written to bas_sen_val_1 (AV 7, zone temperature), bas_dat_val_1 (AV 90, discharge air; select with dat_sel_1 AV 81 = 3), bas_rh_sen_val_1 (AV 56), bas_co2_val_1 (AV 49) and bas_oat_1 (AV 29).",
    "setup": [
      "BACnet MS/TP runs on the EIA-485 port; the BAS Port Settings DIP switches select the protocol (BACnet MS/TP, N2, Modbus) and baud rate (9.6 to 76.8 kbps), the same for every controller on the trunk.",
      "The two rotary dials set the MAC address (tens and ones); the controller only reads them at power-up, so change them with power off.",
      "Port 2a is set to EIA-485 or EIA-232 and 2-wire or 4-wire with jumpers; Port 1 is ARC156 only.",
      "The controller is a BACnet Advanced Application Controller (B-AAC)."
    ],
    "gotchas": [
      "High static shutdowns follow a three-strike rule; once locked out (code 100) the unit can only be reset from the BACview terminal, not over BACnet.",
      "Wall-sensor setpoint adjustment is limited to ±3 °F by stpt_adj_lim_1.",
      "Auxiliary heat (and several other options) needs the Control Air 6120 Point Expander.",
      "Configuration AVs (input selectors, unit mode, stages, coil configuration) are commissioning settings; avoid cyclic writes."
    ]
  },
