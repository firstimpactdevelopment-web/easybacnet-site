{
  "manufacturer": "Daikin Applied",
  "manufacturer_slug": "daikin-applied",
  "model": "MicroTech Chiller Controller (Trailblazer AGZ-F, Magnitude WMC-E, WMT)",
  "model_slug": "microtech-agz-f-wmc-wmt",
  "aliases": [
    "AGZ-F",
    "Trailblazer AGZ F-vintage",
    "WMC-E",
    "WMT",
    "Magnitude WMT",
    "ED 19131"
  ],
  "equipment_type": "Chiller controller",
  "applies_to": "Trailblazer AGZ F-vintage air-cooled scroll chillers and Magnitude WMC-E and WMT magnetic-bearing centrifugal chillers.",
  "summary": "This MicroTech controller generation serves the AGZ-F, WMC-E and WMT chillers and talks BACnet MS/TP, BACnet IP or Modbus through its communication module. Besides the usual water temperatures, refrigerant pressures, run hours and network setpoints, it adds alarm module ID, type and payload values for fault, problem and warning alarms, a heat setpoint and a refrigerant type readout.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": "AGZ-F 1.2.0, WMT 1.0.0, WMC-E 1.0.0 application software or later",
  "default_device_instance": 9050,
  "notes": [
    "Point availability depends on chiller model and configuration (for example heat setpoint and heat recovery points).",
    "Starts objects AV 94 and AV 97 are printed with the names C1Comp3Hours and C2Comp3Hours; names kept as printed.",
    "Network setpoints only take effect when the control source is set to BAS at the HMI.",
    "Setpoint ranges differ between AGZ-F and WMT/WMC-E; check the unit before writing."
  ],
  "source": {
    "title": "MicroTech Unit Controller Protocol Information (Chiller Models AGZ-F, WMC-E, and WMT)",
    "doc_number": "ED 19131-1",
    "revision_date": "2026-04",
    "url": "https://tahoeweb.daikinapplied.com/api/general/DownloadDocumentByName/media/ED%2019131-1.pdf/"
  },
  "integration": {
    "summary": "Set Control Source to BAS at the chiller HMI, then use ChillerEnableStp to enable the chiller and write the cool (or heat/ice) setpoint, mode and capacity limit. Monitor unit status, water temperatures, capacity and the alarm index/module objects.",
    "minimum_points": [
      {
        "ref": "BV 2",
        "name": "ChillerEnableStp",
        "why": "Network enable/disable of the chiller"
      },
      {
        "ref": "MV 3",
        "name": "ChillerOperationMode",
        "why": "Ice / cool / heat / heat recovery mode command"
      },
      {
        "ref": "AV 4",
        "name": "NetworkCoolTempSetpoint",
        "why": "Leaving water cool setpoint from the BMS"
      },
      {
        "ref": "AV 3",
        "name": "NetworkCapacityLimitPct",
        "why": "Capacity limit from the BMS"
      },
      {
        "ref": "BV 8",
        "name": "ClearAlarm",
        "why": "Clear alarms from the network"
      },
      {
        "ref": "BI 3",
        "name": "ChillerLocalRemote",
        "why": "Shows whether network control is active"
      },
      {
        "ref": "MV 1",
        "name": "UnitStatus",
        "why": "Chiller run state"
      },
      {
        "ref": "AI 2",
        "name": "LvgEvapWaterTempUnit",
        "why": "Leaving chilled water temperature"
      },
      {
        "ref": "AV 2",
        "name": "ChillerCapacity",
        "why": "Actual capacity in percent"
      },
      {
        "ref": "AV 901",
        "name": "AVFaultAlarm",
        "why": "Active fault alarm index"
      }
    ],
    "enable": "For AGZ-F, WMC-E and WMT, Control Source must be set to BAS at the unit HMI before the controller uses Network Enable (BV 2), the cool/heat/ice setpoints, the mode setpoint and the capacity limit from the BAS.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Default device instance 9050; device object name defaults to Daikin_MicroTech_ plus the instance.",
      "BACnet IP default UDP port 47808.",
      "Network parameters are set at the HMI; see IM 1283 for the communication module."
    ],
    "gotchas": [
      "Setpoint ranges differ between AGZ-F and WMT/WMC-E.",
      "Point availability differs per model (see the AGZ-F/WMT/WMC-E matrix in the guide).",
      "Alarm details come as index, module ID, module type and payload objects per alarm class."
    ]
  },
