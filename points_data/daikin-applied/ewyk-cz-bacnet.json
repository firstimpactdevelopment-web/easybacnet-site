{
  "manufacturer": "Daikin Applied",
  "manufacturer_slug": "daikin-applied",
  "model": "EWAK-CZ / EWYK-CZ air-to-water heat pump and chiller (Daikin Applied Europe)",
  "model_slug": "ewyk-cz-bacnet",
  "short_model": "EWAK-CZ / EWYK-CZ",
  "aliases": [
    "EWYK-CZ",
    "EWAK-CZ",
    "EWYK CZ",
    "EWAK CZ",
    "EWA(Y)K-CZ",
    "ICARO",
    "D-EIGOC00104"
  ],
  "equipment_type": "Air-to-water heat pump / air-cooled chiller controller",
  "applies_to": "Daikin Applied Europe EWAK-CZ air-cooled chillers and EWYK-CZ reversible air-to-water heat pumps running the ICARO control software.",
  "summary": "The EWAK-CZ chillers and EWYK-CZ heat pumps use a MicroTech controller running the ICARO software. BACnet MS/TP comes from a POL904 module and BACnet IP from a POL908 module. The list covers unit enable, cool/heat mode and network setpoints, capacity and current limits, domestic hot water, bivalent (boiler backup) and collective housing functions, variable-flow pump data, per-circuit compressor data, alarm words and master/slave status.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "1 (BACnet IP module); MS/TP module derives it from the production number and date code",
  "access_inferred": false,
  "notes": [
    "Objects marked _red in the guide are 'reduced' objects: no priority array, Present Value only. The type is shown without the suffix and the description ends in (reduced).",
    "Access 'W (Prio 8)' in the guide is shown as C; plain W as W. Units '°Dc' (temperature difference) are shown as dK.",
    "Alarm words (AV 295-299, 396-399, 496-499) are bit fields decoded with Annex A of the guide.",
    "The guide prints the object name UnitAlarmsWord4 for both AV 295 (Unit Alarm Word #5) and AV 296; kept as printed.",
    "Domestic hot water, bivalent, collective housing, variable-flow pump and master/slave objects only apply when those functions are configured.",
    "AI 151 (master/slave leaving water temperature) and AV 151 (pump fixed speed 2) share an instance number but are different object types."
  ],
  "source": {
    "title": "BAS integration guide - BACnet protocol (EWAK-CZ/EWYK-CZ, ICARO)",
    "doc_number": "D-EIGOC00104-26_00EN-EWYK-CZ",
    "revision_date": null,
    "url": "https://www.daikinapplied.uk/hubfs/portale-documentale/D_EIGOC00104_26_00EN_EWYK_CZ.pdf"
  },
  "integration": {
    "summary": "Set the unit to network control, then enable it with ChillerEnableStp (BV 2) and write the operating mode (MV 3) and the cool or heat setpoint at priority 8. Monitor unit status, leaving water temperature, the general alarm and the fault code.",
    "minimum_points": [
      {
        "ref": "BV 2",
        "name": "ChillerEnableStp",
        "why": "Network enable/disable of the unit"
      },
      {
        "ref": "MV 3",
        "name": "ChillerOperationMode",
        "why": "Cool / heat mode command"
      },
      {
        "ref": "AV 4",
        "name": "NetworkCoolTempSetpoint",
        "why": "Leaving water cool setpoint from the BMS"
      },
      {
        "ref": "AV 6",
        "name": "NetworkHeatTempSetpoint",
        "why": "Leaving water heat setpoint from the BMS"
      },
      {
        "ref": "AV 3",
        "name": "CapacityLimitSetpt",
        "why": "Capacity limit from the BMS"
      },
      {
        "ref": "BV 8",
        "name": "ClearAlarm",
        "why": "Clear alarms from the network"
      },
      {
        "ref": "BI 3",
        "name": "ChillerLocalRemote",
        "why": "Shows whether network control is active"
      },
      {
        "ref": "MV 1",
        "name": "UnitStatus",
        "why": "Unit run state"
      },
      {
        "ref": "AI 2",
        "name": "LvgEvapWaterTempUnit",
        "why": "Leaving water temperature"
      },
      {
        "ref": "BI 10",
        "name": "AlarmDigitalOutput",
        "why": "Any active unit alarm"
      }
    ],
    "enable": "ChillerLocalRemote (BI 3) shows 0 = Local / 1 = Network and is read-only; the guide lists no writable local/network selector, so network control is chosen at the unit. With network control active the BMS writes ChillerEnableStp (BV 2) = Enable, then the mode (MV 3) and the network setpoints.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP comes from the POL904 module: MAC address 24, 38400 baud, Max Master 127, Max Info Frames 1 by default; the device instance is derived from the production number and date code. Cycle power after changing the address.",
      "BACnet IP comes from the POL908 module: device instance 1, UDP port 47808, DHCP off by default. Set Apply Changes = Yes after editing, which restarts the controller.",
      "Both are set from the unit keypad under Commissioning > BACnet with the service password."
    ],
    "gotchas": [
      "Write the enable, alarm-reset, mode and main network setpoints at priority 8, as the guide states.",
      "Reduced (_red) objects have no priority array; write Present Value directly.",
      "The guide warns that writing Clear Alarms continuously can be hazardous; send it once.",
      "Compressor starts and run-hour AVs are marked writable; don't write them from the BMS."
    ]
  },
