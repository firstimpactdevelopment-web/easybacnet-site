  "integration": {
    "summary": "Select network control at the unit (ChillerLocalRemote BI 3 then reads Network), enable the unit with ChillerEnableStp and write the mode and cool/heat setpoints. Monitor unit status, leaving water temperature, the general alarm and the fault code.",
    "minimum_points": [
      {
        "ref": "BV 2",
        "name": "ChillerEnableStp",
        "why": "Network enable/disable of the unit"
      },
      {
        "ref": "MV 3",
        "name": "ChillerOperationMode",
        "why": "Ice / cool / heat / pursuit mode command"
      },
      {
        "ref": "AV 4",
        "name": "NetworkCoolTempSetpoint",
        "why": "Cool water setpoint from the BMS"
      },
      {
        "ref": "AV 6",
        "name": "NetworkHeatTempSetpoint",
        "why": "Heat water setpoint from the BMS"
      },
      {
        "ref": "BV 8",
        "name": "ClearAlarm",
        "why": "Clear alarms from the network"
      },
      {
        "ref": "BI 3",
        "name": "ChillerLocalRemote",
        "why": "Shows whether network control is active"
      },
      {
        "ref": "MV 1",
        "name": "UnitStatus",
        "why": "Unit run state"
      },
      {
        "ref": "AI 2",
        "name": "LvgEvapWaterTempUnit",
        "why": "Evaporator leaving water temperature"
      },
      {
        "ref": "BI 10",
        "name": "AlarmDigitalOutput",
        "why": "Any active alarm"
      },
      {
        "ref": "AV 905",
        "name": "AVFaultAlarmCode",
        "why": "Active fault alarm code"
      }
    ],
    "enable": "ChillerLocalRemote (BI 3) reads 0 = Network / 1 = Local and is read-only over BACnet, so network control has to be selected at the unit; the guide does not describe that step. Then write ChillerEnableStp (BV 2) = Enable, the mode (MV 3) and the network setpoints.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet IP runs on the controller Ethernet port as a software option enabled with connectivity kit EKRSCBMS.",
      "The same controller also offers Modbus RTU on its onboard RS485 port (separate guide)."
    ],
    "gotchas": [
      "Pump and compressor run-hour and start-count AVs are marked writable; don't write them from the BMS.",
      "MV 47 Units selects imperial or metric units for the BACnet values; set it once, not cyclically.",
      "MV 330 Disconnect (No/Yes) is writable; the guide does not explain it, so leave it alone unless Daikin says otherwise."
    ]
  }
}
