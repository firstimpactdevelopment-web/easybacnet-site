    "url": "https://www.bacnetinternational.net/catalog/manu/produal%20oy/PICS%20rtx-d_260202_pics_en.pdf",
    "unofficial": true,
    "host": "BACnet International"
  },
  "integration": {
    "summary": "Give the transmitter a unique MS/TP address, then read temperature, humidity, CO2 and VOC. When the RTX-D acts as a controller, write the setpoints (AV 19200-19203) or feed BUS-CONTROLLER inputs; outputs set to bus control follow the BUS-OUTPUTn-POWER values.",
    "minimum_points": [
      {
        "ref": "AV 19200",
        "name": "SETPOINT-TEMPERATURE",
        "why": "Temperature setpoint"
      },
      {
        "ref": "AV 19202",
        "name": "SETPOINT-CO2",
        "why": "CO2 setpoint, ppm"
      },
      {
        "ref": "AI 0",
        "name": "TEMPERATURE",
        "why": "Room temperature"
      },
      {
        "ref": "AI 1",
        "name": "HUMIDITY",
        "why": "Room relative humidity"
      },
      {
        "ref": "AI 2",
        "name": "CO2",
        "why": "Room CO2, ppm"
      },
      {
        "ref": "AI 3",
        "name": "TVOC",
        "why": "Total VOC, µg/m³"
      },
      {
        "ref": "MV 72",
        "name": "VOC-DETAILED-STATUS",
        "why": "VOC sensor status (1 = normal)"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "BUS-CONTROLLER-INPUT-T/-RH/-CO2/-CO2-VOC (AV 1003-1006) and OUTDOOR-TEMPERATURE-BUS-VALUE (AV 19100) take values from the BMS.",
    "setup": [
      "BACnet MS/TP only; baud 9600-115200 bit/s."
    ],
    "gotchas": [
      "Many objects only matter for the variant and configuration in use (outputs, external inputs, buttons)."
    ]
