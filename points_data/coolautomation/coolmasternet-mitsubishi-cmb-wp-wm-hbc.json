{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Mitsubishi Electric CMB-WP/CMB-WM branch controller (PRO) objects",
  "model_slug": "coolmasternet-mitsubishi-cmb-wp-wm-hbc",
  "aliases": [
    "Mitsubishi Hybrid City Multi BACnet",
    "CoolMasterNet Mitsubishi Electric",
    "CMB-WP V-GA1",
    "CMB-WM V-AA"
  ],
  "equipment_type": "VRF branch controller monitoring via BACnet gateway",
  "applies_to": "Mitsubishi Electric CMB-WP [capacity] V-GA1 and CMB-WM [capacity] V-AA branch controllers read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Mitsubishi Electric CMB-WP V-GA1 and CMB-WM V-AA controllers over BACnet: refrigerant, bypass and water outlet temperatures of the heating-main and cooling-main heat exchangers, branch thermistors TH31a-TH31p, high and low pressure, superheat and subcooling, power failure, float switch, debris removal and air vent states, pump speeds, control signals to and from the outdoor unit, total capacities, liquid level controls and 3-way valve positions VB3a-VB3p (70 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how these PRO blocks receive their VA (it only covers indoor units).",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "Table printed on page 275 of the guide (section 3.2.6.2).",
    "Control-signal values (HBSig, OCSig) are explained in the guide's ME PRO Enumerated Parameters tables and are not repeated here.",
    "TH14 is described as 'TH13', and both Float and FlCon as 'Float SW', in the guide; kept as printed.",
    "PS1 and PS3 are printed without units."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Mitsubishi Electric branch controller equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the block's VA and trend water outlet temperatures, pressures and the power-failure and float switch states.",
    "minimum_points": [
      {
        "ref": "AI 273",
        "name": "TH32",
        "why": "Heating-main HX water outlet temperature"
      },
      {
        "ref": "AI 274",
        "name": "TH33",
        "why": "Cooling-main HX water outlet temperature"
      },
      {
        "ref": "AI 277",
        "name": "PS1",
        "why": "High pressure, liquid side"
      },
      {
        "ref": "AI 278",
        "name": "PS3",
        "why": "Low pressure"
      },
      {
        "ref": "IV 305",
        "name": "QjC",
        "why": "Total cooling capacity"
      },
      {
        "ref": "IV 306",
        "name": "QjH",
        "why": "Total heating capacity"
      },
      {
        "ref": "BI 291",
        "name": "PS",
        "why": "Power failure detected"
      },
      {
        "ref": "BI 292",
        "name": "Float",
        "why": "Float switch"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to these units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Mitsubishi Electric"
  ],
