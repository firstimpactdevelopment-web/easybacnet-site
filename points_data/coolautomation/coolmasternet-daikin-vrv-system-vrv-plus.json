{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Daikin outdoor system (PRO) objects - VRV PLUS (RSEYP16-30KJY1)",
  "model_slug": "coolmasternet-daikin-vrv-system-vrv-plus",
  "aliases": [
    "Daikin VRV BACnet",
    "CoolMasterNet Daikin",
    "Daikin outdoor system BACnet",
    "VRV_PLUS",
    "VRV Plus",
    "RSEYP16-30KJY1"
  ],
  "equipment_type": "VRF outdoor system monitoring via BACnet gateway",
  "applies_to": "Daikin VRV PLUS outdoor systems (RSEYP16-30KJY1) read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish system-level service data for Daikin VRV PLUS (RSEYP16-30KJY1) outdoor systems over BACnet: type, AirNet address, error code, ambient, discharge, suction, evaporating, condensing, coil, header and liquid temperatures, inverter frequency, current and temperature, EV openings, operating states, three compressors, valve and fan states, heating-overload and low-ambient flags and HP (70 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "Table printed on page 15 of the guide (section 3.2.1.2).",
    "This system table carries the unit-level temperatures and compressor data; the guide prints no separate outdoor-unit table for VRV PLUS."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Daikin outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the block's VA and trend operating states, temperatures, compressor data and the error state.",
    "minimum_points": [
      {
        "ref": "BI 271",
        "name": "Cool",
        "why": "Cooling"
      },
      {
        "ref": "BI 272",
        "name": "Heat",
        "why": "Heating"
      },
      {
        "ref": "BI 275",
        "name": "TstatOn",
        "why": "Thermostat on"
      },
      {
        "ref": "BI 277",
        "name": "Dfrst",
        "why": "Defrost active"
      },
      {
        "ref": "PIV 266",
        "name": "InvFrq",
        "why": "Inverter frequency, Hz"
      },
      {
        "ref": "IV 259",
        "name": "AmbT",
        "why": "Ambient temperature, °C"
      },
      {
        "ref": "IV 264",
        "name": "EvT",
        "why": "Evaporating temperature, °C"
      },
      {
        "ref": "IV 265",
        "name": "CndT",
        "why": "Condensing temperature, °C"
      },
      {
        "ref": "CSV 258",
        "name": "ErrCode",
        "why": "System error code"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Daikin"
  ],
