{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Gree GMV5 outdoor unit (PRO) objects",
  "short_model": "Gree GMV5 ODU",
  "model_slug": "coolmasternet-gree-gmv5-outdoor",
  "aliases": [
    "Gree GMV5 BACnet",
    "CoolMasterNet Gree",
    "Gree outdoor unit BACnet",
    "GMV5"
  ],
  "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
  "applies_to": "Gree GMV5 VRF outdoor units read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Gree GMV5 outdoor units over BACnet: rated capacity, master/slave status, outdoor temperature, compressor and fan frequencies, module high and low pressure, discharge, shell, defrost, subcooler and separator temperatures, EXV positions, compressor and valve states, and compressor and fan currents, bus voltages and IPM temperatures (42 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Values marked (value x 0.1) or (value x 0.001) are raw and need scaling in the BMS.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions.",
    "The guide prints Module HP and Module LP with a [°C] unit; they are listed as printed.",
    "The guide lists no error-code object for Gree outdoor units."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMasterNet, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 0.5, 2019-04-29",
    "url": "https://coolautomation.com/Lib/doc/CoolMasterNet/manual/CoolMasterNet-BACnet-guidelines.pdf"
  },
  "integration": {
    "summary": "Use these objects to monitor Gree outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend the key temperatures, pressures and compressor data (the guide lists no error object for Gree outdoor units).",
    "minimum_points": [
      {
        "ref": "BI 282",
        "why": "Compressor 1 running",
        "name": "Comp1Stat"
      },
      {
        "ref": "PIV 265",
        "why": "Compressor 1 frequency, Hz",
        "name": "Comp1OpFreq"
      },
      {
        "ref": "IV 264",
        "why": "Outdoor temperature, °C",
        "name": "OutT"
      },
      {
        "ref": "IV 269",
        "why": "Module high pressure value",
        "name": "MdlHp"
      },
      {
        "ref": "IV 270",
        "why": "Module low pressure value",
        "name": "MdlLp"
      },
      {
        "ref": "IV 271",
        "why": "Compressor 1 discharge temperature, °C",
        "name": "Comp1DisT"
      },
      {
        "ref": "AI 286",
        "why": "Compressor 1 current, A",
        "name": "Comp1Cur"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on CoolMasterNet); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
