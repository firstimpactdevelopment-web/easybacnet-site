{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Samsung DVM S Water HR outdoor unit (PRO) objects",
  "model_slug": "coolmasternet-samsung-dvm-s-water-hr-outdoor",
  "aliases": [
    "Samsung DVM S Water BACnet",
    "CoolMasterNet Samsung",
    "DVM-S Water HR"
  ],
  "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
  "applies_to": "Samsung DVM S Water heat recovery (water-source) VRF outdoor units read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Samsung DVM S Water HR outdoor units over BACnet: type, operation mode and status, error code, capacity, compressor target, order and current frequencies, temperatures, compressor current, EEV positions and compressor and valve states, plus water temperature, flow control and flow switch (54 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "State meanings for coded values (mode, status and similar) are in the guide's PRO Enumerated Parameters tables for this brand and are not repeated here."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Samsung outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend water temperature, pressures, compressor frequency and error code.",
    "minimum_points": [
      {
        "ref": "PIV 257",
        "name": "OpMode",
        "why": "Operation mode code"
      },
      {
        "ref": "PIV 258",
        "name": "OpStat",
        "why": "Operation status code"
      },
      {
        "ref": "PIV 263",
        "name": "CurFreq1",
        "why": "Compressor 1 current frequency, Hz"
      },
      {
        "ref": "AI 276",
        "name": "WtrT",
        "why": "Water temperature, °C"
      },
      {
        "ref": "AI 267",
        "name": "HiPrs",
        "why": "High pressure, kg/cm2"
      },
      {
        "ref": "AI 269",
        "name": "LoPrs",
        "why": "Low pressure, kg/cm2"
      },
      {
        "ref": "AI 271",
        "name": "DisT1",
        "why": "Compressor 1 discharge temperature, °C"
      },
      {
        "ref": "PIV 259",
        "name": "ErrCode",
        "why": "Error code"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Samsung"
  ],
