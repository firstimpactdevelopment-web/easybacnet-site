{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Mitsubishi Electric BC controller (JA/KA) (PRO) objects",
  "model_slug": "coolmasternet-mitsubishi-bc-ja-ka",
  "aliases": [
    "Mitsubishi City Multi BC controller BACnet",
    "CoolMasterNet Mitsubishi Electric",
    "BC(JA)",
    "BC(KA)"
  ],
  "equipment_type": "VRF branch controller monitoring via BACnet gateway",
  "applies_to": "Mitsubishi Electric City Multi BC controllers of the types CoolAutomation calls BC(JA) and BC(KA), read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Mitsubishi Electric BC controllers of the JA and KA types over BACnet: temperatures T1, T2, T5, T6, high (P1) and intermediate (P3) pressure, liquid level controls, dPHM, subcooling and superheat, 48 binary objects named 1a to 0c and the operation control signals to and from the outdoor unit (64 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how these PRO blocks receive their VA (it only covers indoor units).",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "Table printed on page 280 of the guide (section 3.2.6.2).",
    "BCSig and OCSig values are explained in the guide's ME PRO Enumerated Parameters tables and are not repeated here.",
    "The binary objects 1a to 0c have no description beyond their names.",
    "The guide prints other BC controller tables under 'BC', 'BC(main)', 'BC(sub)', 'BC(J)' and 'BS(KB)' headings; those are not covered here."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Mitsubishi Electric BC controller equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the block's VA and trend the pressures, subcooling and superheat.",
    "minimum_points": [
      {
        "ref": "AI 261",
        "name": "P1",
        "why": "High pressure, kg/cm2"
      },
      {
        "ref": "AI 262",
        "name": "P3",
        "why": "Intermediate pressure, kg/cm2"
      },
      {
        "ref": "AI 257",
        "name": "T1",
        "why": "BC temperature T1, °C"
      },
      {
        "ref": "AI 267",
        "name": "SC1",
        "why": "Subcooling SC1, °C"
      },
      {
        "ref": "AI 269",
        "name": "SH2",
        "why": "Superheat SH2, °C"
      },
      {
        "ref": "PIV 318",
        "name": "BCSig",
        "why": "BC operation control signal"
      },
      {
        "ref": "PIV 319",
        "name": "OCSig",
        "why": "Control signal from the outdoor unit"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to these units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Mitsubishi Electric"
  ],
