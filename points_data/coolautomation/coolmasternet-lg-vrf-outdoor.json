{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet LG VRF outdoor unit (PRO) objects",
  "model_slug": "coolmasternet-lg-vrf-outdoor",
  "aliases": [
    "LG VRF BACnet",
    "LG BACnet points list",
    "LG outdoor unit BACnet",
    "CoolMasterNet LG"
  ],
  "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
  "applies_to": "LG VRF outdoor units read through a CoolAutomation gateway with PRO (service data) functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways also publish service data from LG VRF outdoor units over BACnet: pressures, superheat/subcooling, inverter and fan data, EEV positions, temperatures and valve states (68 objects). The objects use the same VA x 256 + index instance scheme as the indoor objects. These are monitoring values for commissioning and diagnostics.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Points shown for VA 1 (instances 256-323); the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured values, although the guide's type table lists PIV as read/write.",
    "Many values are scaled; '(value x 0.1)' means divide the raw value by 10.",
    "Object names are the guide's short names."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMasterNet, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 0.5, 2019-04-29",
    "url": "https://coolautomation.com/Lib/doc/CoolMasterNet/manual/CoolMasterNet-BACnet-guidelines.pdf"
  },
  "integration": {
    "summary": "Use these objects for monitoring LG outdoor units only; control stays on the indoor-unit objects. Map the outdoor unit's VA block and trend pressures, superheat, subcooling, compressor frequency and error code.",
    "minimum_points": [
      {
        "ref": "CSV 257",
        "name": "Mode",
        "why": "Outdoor operating mode"
      },
      {
        "ref": "PIV 261",
        "name": "HiPrsTrc",
        "why": "Current high pressure"
      },
      {
        "ref": "PIV 263",
        "name": "LoPrsTrc",
        "why": "Current low pressure"
      },
      {
        "ref": "PIV 271",
        "name": "Inv1TrcFrq",
        "why": "Compressor 1 frequency"
      },
      {
        "ref": "AI 283",
        "name": "AirT",
        "why": "Outdoor air temperature"
      },
      {
        "ref": "PIV 258",
        "name": "Err",
        "why": "Outdoor unit error code"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; the guide lists these objects under its PRO functionality section.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on CoolMasterNet); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "Raw values marked x 0.1 must be scaled in the BMS.",
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
