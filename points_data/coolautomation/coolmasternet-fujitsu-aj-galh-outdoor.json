{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Fujitsu AJ*GALH outdoor unit (PRO) objects",
  "model_slug": "coolmasternet-fujitsu-aj-galh-outdoor",
  "aliases": [
    "Fujitsu VRF BACnet",
    "CoolMasterNet Fujitsu",
    "AJHGALH",
    "AOULBV",
    "AJHGALBH",
    "AJYGALBH",
    "AJQGALAH",
    "AJTGALH",
    "AJTGBLH",
    "AJYGALH",
    "AJYGALDH",
    "AJHGALDH"
  ],
  "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
  "applies_to": "Fujitsu outdoor units AJHuGALH, AJHGALH, AOULBV, AJHGALBH, AJYGALBH, AJQGALAH, AJTuGALH, AJTGALH, AJTGBLH, AJYuGALH, AJYGALH, AJYGALDH and AJHGALDH (model codes exactly as printed by CoolAutomation) read through a CoolAutomation gateway with PRO functionality.",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Fujitsu AJ*GALH outdoor units over BACnet: type, capacity, operation, mode, defrost and oil recovery, compressor, valve, heater and fan states, thermistor temperatures, high and low pressure, compressor drive frequency, inverter temperature, DC voltage and current, fan frequency and EEV positions, plus low-noise, forced-off and capacity-save states (42 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "Table printed on page 315 of the guide (section 3.2.9.2).",
    "Md (Mode) states are from the guide's Fujitsu PRO Enumerated Parameters table.",
    "The guide lists no error-code object for Fujitsu outdoor units.",
    "The heading also lists AOULCV, which the guide repeats under the AJ*LALBH table; for that model compare both tables with a discovery.",
    "Some model codes are printed with a literal 'u' (e.g. AJHuGALH); kept as printed."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Fujitsu outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend operation, mode, compressor frequency and pressures.",
    "minimum_points": [
      {
        "ref": "BI 258",
        "name": "Op",
        "why": "Outdoor unit operating"
      },
      {
        "ref": "PIV 259",
        "name": "Md",
        "why": "Operating mode code"
      },
      {
        "ref": "BI 262",
        "name": "Cmp1",
        "why": "Inverter compressor running"
      },
      {
        "ref": "BI 260",
        "name": "Dfrst",
        "why": "Defrost active"
      },
      {
        "ref": "PIV 290",
        "name": "Cmp1F",
        "why": "Compressor 1 drive frequency, rps"
      },
      {
        "ref": "IV 278",
        "name": "TH2",
        "why": "Outdoor temperature, °C"
      },
      {
        "ref": "AI 288",
        "name": "HPS",
        "why": "High pressure, MPa"
      },
      {
        "ref": "AI 289",
        "name": "LPS",
        "why": "Low pressure, MPa"
      },
      {
        "ref": "IV 277",
        "name": "TH1",
        "why": "Discharge temperature, °C"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Fujitsu"
  ],
