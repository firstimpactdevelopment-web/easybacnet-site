{
  "manufacturer": "CoolAutomation",
  "manufacturer_slug": "coolautomation",
  "model": "CoolMasterNet Toshiba SMMSu outdoor unit (PRO) objects",
  "model_slug": "coolmasternet-toshiba-smmsu-outdoor",
  "aliases": [
    "Toshiba SMMSu BACnet",
    "Toshiba SMMS-u BACnet",
    "CoolMasterNet Toshiba",
    "SMMSu"
  ],
  "equipment_type": "VRF outdoor unit monitoring via BACnet gateway",
  "applies_to": "Toshiba SMMSu (SMMS-u) VRF outdoor units read through a CoolAutomation gateway with PRO functionality (SMMSu outdoor section of the guide).",
  "summary": "With PRO functionality, CoolAutomation gateways publish service data from Toshiba SMMSu outdoor units over BACnet: unit HP, compressor speeds, fan mode, high and low pressure, discharge, heat exchanger, liquid, suction, outdoor and oil and IGBT temperatures, compressor currents, PMV positions and valve states, plus model and serial number, check (text and number), pre-check and notice codes, release and defrost flags, run timers, switch settings and the 7-segment display text (83 objects). Monitoring only.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 64,
  "access_inferred": true,
  "notes": [
    "Instance = VA x 256 + index (object identifier bits 21-8 = VA, 7-0 = index). Points shown for VA 1; the guide does not explain how outdoor units receive their VA.",
    "Access set to read-only: these are measured service values, although the guide's type table lists PIV as read/write.",
    "Object names are the guide's short names; descriptions are the guide's object descriptions with the bracketed unit moved to units.",
    "Two objects are both named ChkCd (CSV 268 text and PIV 269 number) and two are named PreChkCd, as printed.",
    "The guide's general Toshiba outdoor section also has two other SMMSu tables under one heading; this list is the separate 'Toshiba SMMSu PRO Outdoor Units' table.",
    "State meanings for coded values (mode, status and similar) are in the guide's PRO Enumerated Parameters tables for this brand and are not repeated here."
  ],
  "source": {
    "title": "BACnet Integration Guidelines - CoolMaster Product Line, CooLinkNet, CooLinkHub, CooLinkBridge",
    "doc_number": null,
    "revision_date": "Rev 1.0.4, 2026-07-06",
    "url": "https://support.coolautomation.com/hc/en-us/article_attachments/38262832368157"
  },
  "integration": {
    "summary": "Use these objects to monitor Toshiba outdoor equipment only; control stays on the CoolMasterNet indoor-unit objects. Map the outdoor block's VA and trend pressures, compressor speed and check codes.",
    "minimum_points": [
      {
        "ref": "AI 277",
        "name": "Comp1",
        "why": "Compressor 1 speed, Hz"
      },
      {
        "ref": "AI 299",
        "name": "TO",
        "why": "Outdoor air temperature, °C"
      },
      {
        "ref": "AI 280",
        "name": "Pd[psi]",
        "why": "High pressure, psi"
      },
      {
        "ref": "AI 281",
        "name": "Ps[psi]",
        "why": "Low pressure, psi"
      },
      {
        "ref": "AI 284",
        "name": "TD1",
        "why": "Discharge temperature 1, °C"
      },
      {
        "ref": "CSV 268",
        "name": "ChkCd",
        "why": "Check (error) code text"
      }
    ],
    "enable": "BACnet must be enabled on the gateway; these objects belong to its PRO (service data) functionality.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP: activate on line L3 with 'line type L3 BAC' (L4-L7 also possible on the CoolMaster product line); default frame 9600 8N1, change with 'line baud L3 <rate>_8N1'; MAC (TS) default 0x40 = 64, change with 'line myid L3 <hex>'. Reboot after each change.",
      "BACnet IP: enable with 'bacnet IP enable'; UDP port 47808 by default ('bacnet port <n>'). The server starts only once Ethernet is up with an IP address.",
      "Default device instance 64 (0x40); change with 'bacnet instance <n>'."
    ],
    "gotchas": [
      "The guide does not document how VAs are assigned to outdoor units; confirm instances with a BACnet discovery."
    ]
  },
  "covers_brands": [
    "Toshiba"
  ],
