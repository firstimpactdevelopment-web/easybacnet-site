  "integration": {
    "summary": "Give the PRTU a MAC in 101-126 and a unique device instance, keep 76800 baud, and map the rooftop mode command, the standalone setpoints, the rooftop status, discharge/return temperatures and the polling-failed flag. In networked mode the zone controllers drive the rooftop mode by voting, so the BMS mostly monitors.",
    "minimum_points": [
      {
        "ref": "MV 5",
        "name": "Rooftop Mode",
        "why": "Mode: 1 Auto, 2 Cool, 3 Heat, 4 Vent, 5 Off"
      },
      {
        "ref": "AV 1",
        "name": "Standalone Cooling Setpoint",
        "why": "Cooling setpoint in standalone mode"
      },
      {
        "ref": "AV 2",
        "name": "Standalone Heating Setpoint",
        "why": "Heating setpoint in standalone mode"
      },
