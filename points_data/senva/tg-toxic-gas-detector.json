{
  "manufacturer": "Senva",
  "manufacturer_slug": "senva",
  "model": "TG Series toxic gas detector (BACnet MS/TP)",
  "model_slug": "tg-toxic-gas-detector",
  "aliases": [
    "TG",
    "TGX-BXX-XX",
    "Senva TG toxic gas",
    "Senva TG CO NO2 detector"
  ],
  "equipment_type": "Gas detector / sensor (toxic gas, dual sensor)",
  "applies_to": "Senva TG series toxic gas detectors (TGX-BXX-XX) with one or two gas sensors, optional thermistor, fan and alarm relays and buzzer, using BACnet MS/TP.",
  "summary": "The TG is a Senva toxic gas detector with BACnet MS/TP. Each measurement (temperature, gas sensor 1 and 2, supply voltage) has a primary Analog Input plus Smoothed, Minimum, Maximum and Average objects. Analog Values hold the warning and alarm setpoints, hysteresis, sensor life and RS-485 settings; commandable Binary Outputs drive the fan relay, alarm relay and buzzer, and MSV 170 reports the Normal / Warning / Alarm / Extended Alarm state.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "2.0.0 (PICS 2/7/2020)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Points from the object list and object sections of protocol guide 154-0035-0B; it replaces the older TG guide 154-0032-0A.",
    "The secondary analog inputs are printed only as \"Smoothed\", \"Minimum\", \"Maximum\" and \"Average\" under each primary AI (primary + 2, 4, 6, 8); names kept as printed.",
    "Minimum, Maximum and Average reset when 0 is written to them, when AV 192 is written with its key, or on read if BV 195 is active.",
    "Sensor 2 and thermistor objects exist only on models with those features. Gas units are not printed; ppm is assumed from the setpoint text.",
    "Multistate objects are MSV in the guide; listed here as MV. FILE 25000 holds a read-only copy of the configuration."
  ],
  "source": {
    "title": "BACnet Protocol Guide TG",
    "doc_number": "154-0035-0B",
    "revision_date": "2021-03-12",
    "url": "https://www.senvainc.com/catalog/documents/downloadcenter/TG%20BACnet%20Protocol%20Guide%20154-0035-0B.pdf"
  },
  "integration": {
    "summary": "Connect to an active MS/TP network and let the TG auto-detect baud, protocol and address, then read the gas readings and MSV 170. The relays and buzzer run automatically from the setpoints; the BMS can override them through the BO priority array.",
    "minimum_points": [
      {
        "ref": "BO 210",
        "name": "Fan Relay",
        "why": "Fan relay; BMS can override (commandable)"
      },
      {
        "ref": "AI 320",
        "name": "Sensor 1 Gas Concentration",
        "why": "Sensor 1 gas reading"
      },
      {
        "ref": "AI 330",
        "name": "Sensor 2 Gas Concentration",
        "why": "Sensor 2 gas reading"
      },
      {
        "ref": "MV 170",
        "name": "System State",
        "why": "Normal, Warning, Alarm or Extended Alarm"
      },
      {
        "ref": "BO 230",
        "name": "Alarm Relay",
        "why": "Alarm relay state"
      },
      {
        "ref": "AV 158",
        "name": "Sensor 1 Sensor Life",
        "why": "Days of sensor 1 life left"
      }
    ],
    "enable": "The device writes the relays at priority 16 from the system state; commands at priorities 1-5 override immediately, 7-15 respect minimum on/off times. Priority 6 is reserved.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Factory default is automatic baud (9600-115200), protocol and MAC (0-127) detection on an active MS/TP network.",
      "Writing AV 123 or AV 124 turns off the automatic address or baud selection.",
      "Device Max_Master and Max_Info_Frames are writable."
    ],
    "gotchas": [
      "There is no remote way back after changing the baud rate; the device goes silent until the controller matches it.",
      "AV 190 (key 9699690) wipes the configuration, including the RS-485 settings.",
      "With BV 114 Auto Baud active, the TG will not start a token on an idle line."
    ]
  },
