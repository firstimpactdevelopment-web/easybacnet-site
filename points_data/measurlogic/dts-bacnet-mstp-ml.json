{
  "manufacturer": "Measurlogic",
  "manufacturer_slug": "measurlogic",
  "model": "DTS meters with the BACnet MS/TP ML protocol option (DTS 305 / 307 / 310 / SMX / SKT / DC)",
  "model_slug": "dts-bacnet-mstp-ml",
  "aliases": [
    "DTS 305",
    "DTS 307",
    "DTS 310",
    "DTS SMX",
    "DTS SKT",
    "DTS DC",
    "Measurlogic DTS BACnet ML",
    "BACnet MS/TP ML"
  ],
  "equipment_type": "Energy meter (electrical sub-meter)",
  "applies_to": "Measurlogic DTS energy meters whose label shows the 'BACnet MS/TP ML' protocol option.",
  "summary": "Measurlogic DTS meters are DIN-rail, panel and socket energy meters for single-phase, three-phase and DC circuits. Meters ordered with the 'BACnet MS/TP ML' option use this object map: per-phase voltages, currents, frequency, power, power factor, unbalance and demand as analog inputs, net and split energy counters, demand time stamps as DateTime Value objects, and configuration and communication settings as writable analog and binary values. Meters without 'ML' on the label use a different map.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 473001,
  "access_inferred": true,
  "notes": [
    "The map has no read/write column: measurements are shown read-only and the configuration, communication and command objects writable, except BV 8060 Changes_Pending which is marked read-only.",
    "Which objects carry data depends on the meter model and wiring; unused channels stay empty.",
    "The main table lists the maximum demand objects as AI 6229 and AI 6230; the demand section (2.4) prints them as AI 6629 and AI 6630. The main table numbers are used here; check which instance the meter actually returns.",
    "The demand time stamps (DTV 7029 / 7030) are DateTime Value objects, which need BACnet protocol revision 12 support in the front end.",
    "Meters without 'ML' in the protocol description on the label use a different Measurlogic BACnet map."
  ],
  "source": {
    "title": "Measurlogic DTS BACnet MS/TP ML Map",
    "doc_number": null,
    "revision_date": "R23A",
    "url": "https://www.measurlogic.com/wp-content/uploads/2023/11/Measurlogic-DTS-BACnet_MSTP-ML-Map-R23A.pdf"
  },
  "integration": {
    "summary": "Set a unique MAC address and Device ID (default MAC 1, Device ID 473001, 38400 baud), then read total power, energy, voltages, currents and demand. Confirm the energy resolution with AV 8023 EnerPowDivider before trending energy.",
    "minimum_points": [
      {
        "ref": "AI 5528",
        "name": "PowerP_Tot",
        "why": "Total active power, kW"
      },
      {
        "ref": "AI 7004",
        "name": "EnergyP_Total",
        "why": "Net active energy, kWh"
      },
      {
        "ref": "AI 5504",
        "name": "Volt_LN_Ave",
        "why": "Average L-N voltage"
      },
      {
        "ref": "AI 5516",
        "name": "Curr_Ave",
        "why": "Average current, A"
      },
      {
        "ref": "AI 5554",
        "name": "PF_DTS_All",
        "why": "Total power factor (sign = import/export)"
      },
      {
        "ref": "AI 5629",
        "name": "DmdP_Tot",
        "why": "Active demand, kW"
      },
      {
        "ref": "AI 7013",
        "name": "EnergyP_Tot_Imp",
        "why": "Imported active energy, kWh"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Defaults: 38400 baud, Device ID 473001, MAC address 1, Max_Master 127; change them with AV 8060-8065 (Device ID and Max_Master also through the device object). BV 8060 shows pending changes and BV 8059 resets the protocol.",
      "On meters with address switches the MAC address follows the switches and the Device ID is 473000 + MAC; set all switches ON to configure the address over the network instead.",
      "Fit an external 120 ohm terminator where the meter has no Term_Resistor object (BV 8061)."
    ],
    "gotchas": [
      "Energy registers roll over at nine digits; the roll-over point depends on EnerPowDivider (AV 8023, default 10,000 = 10 W resolution).",
      "To reset maximum demand, write 0 to AV 20001 and then 61442 to AV 20101.",
      "Power factor sign shows import/export, not leading/lagging; use the reactive power sign for that."
    ]
  },
