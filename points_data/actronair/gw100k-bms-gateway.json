        "why": "Master setpoint, 16-30 °C"
      },
      {
        "ref": "IV 540",
        "name": "I101",
        "why": "Supply fan: low, medium, high, auto"
      },
      {
        "ref": "AV 869",
        "name": "A115",
        "why": "Room temperature"
      },
      {
        "ref": "AV 885",
        "name": "A135",
        "why": "Running capacity, %"
      },
      {
        "ref": "BV 286",
        "name": "D125",
        "why": "Compressor 1 running"
      },
      {
        "ref": "BV 276",
        "name": "D115",
        "why": "Alarm output"
      },
      {
