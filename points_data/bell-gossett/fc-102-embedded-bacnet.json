{
  "manufacturer": "Bell & Gossett",
  "manufacturer_slug": "bell-gossett",
  "model": "FC-102 Embedded BACnet (pump drive)",
  "model_slug": "fc-102-embedded-bacnet",
  "aliases": [
    "FC-102",
    "FC102",
    "VLT HVAC Drive FC 102"
  ],
  "equipment_type": "Pump variable frequency drive",
  "applies_to": "Bell & Gossett pump packages that use the FC-102 HVAC drive with its built-in BACnet MS/TP (firmware 3.90 and above).",
  "summary": "Bell & Gossett pumps driven by the FC-102 HVAC drive can use the drive's embedded BACnet MS/TP over its RS-485 port. The embedded map covers drive I/O terminals, run/stop and reference commands, setpoints and bus feedback values, drive and motor readings, PID tuning, and bypass (ECB) status. It is shorter than the MCA 109 option map and does not include the individual warning and alarm bits.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "3.90 and above",
  "default_device_instance": null,
  "notes": [
    "The point list prints names as e.g. \"analog_value: 1 (Speed Act Value)\"; the text in brackets is used as the object name here.",
    "Rows the list marks as Reserved or NA are left out.",
    "MO 0 is labelled MSO:0 in the ID column but named multi_state_value in the list; check the object type on site.",
    "Bus commands only take effect when the drive is set to accept bus control."
  ],
  "integration": {
    "summary": "The embedded FC-102 list gives run/stop, reference select and fault reset commands, writable setpoints and bus feedback values, and read-only drive data. A typical integration writes BV 1 and a setpoint, then reads run/fault status, speed, power and fault codes.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "RUN/STOP Command",
        "why": "Start/stop the drive from the BMS"
      },
      {
        "ref": "AV 1",
        "name": "Input Reference 1",
        "why": "Speed reference from the BMS (open-loop control)"
      },
      {
        "ref": "AV 30",
        "name": "Setpoint 1",
        "why": "Process setpoint 1 (when the drive runs its own PID)"
      },
      {
        "ref": "BV 3",
        "name": "Fault Reset Command",
        "why": "Reset a tripped drive"
      },
      {
        "ref": "BV 4",
        "name": "RUN/STOP Monitor",
        "why": "Running status"
      },
      {
        "ref": "BV 32",
        "name": "Bus Control",
        "why": "Drive is under bus control"
      },
      {
        "ref": "AV 3",
        "name": "Output Speed",
        "why": "Actual drive output speed"
      },
      {
        "ref": "AV 6",
        "name": "Power",
        "why": "Drive output power"
      },
      {
        "ref": "BV 5",
        "name": "OK/FAULT Monitor",
        "why": "Any active drive fault"
      },
      {
        "ref": "AV 51",
        "name": "Fault Code",
        "why": "Active fault code number"
      }
    ],
    "enable": "BV 1 RUN/STOP Command starts and stops the drive and BV 2 selects reference 1 or 2; BV 32 shows whether the drive is under bus control. The point list does not explain how bus control is set up on the drive.",
    "heartbeat": null,
    "remote_sensors": "AV 31, AV 36 and AV 41 Bus Feedback 1-3 and AV 1/AV 2 Input Reference are writable; the point list does not describe how the drive uses them.",
    "setup": [
      "The point list applies to drive firmware 3.90 and above."
    ],
    "gotchas": [
      "Many rows in the list are Reserved or NA and are not included here.",
      "MO 0 is labelled MSO:0 but named multi_state_value in the list; check the object type on site."
    ]
  },
  "source": {
    "title": "BacNET Points Firmware 3.90 and above (MCA109 FC-102 Advanced BACnet Option / FC-102 Embedded BACnet)",
