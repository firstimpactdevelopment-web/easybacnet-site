{
  "manufacturer": "Adveco",
  "manufacturer_slug": "adveco",
  "model": "Lincoln L70 BMS Interface (extension board) BACnet MS/TP",
  "model_slug": "lincoln-l70-bms-interface",
  "aliases": [
    "Lincoln",
    "L70",
    "Lincoln L70",
    "Lincoln extension board",
    "Lincoln BMS Interface"
  ],
  "equipment_type": "Air source heat pump (cascade BMS interface)",
  "applies_to": "Adveco Lincoln L70 air source heat pumps (up to 10 units) controlled through the Lincoln BMS Interface extension board.",
  "summary": "The Lincoln BMS Interface is an extension board that runs central heating (CH) and domestic hot water (DHW) control for a group of Adveco Lincoln L70 air source heat pumps and exposes it on BACnet MS/TP. The BMS can pick the CH and DHW control modes, send demand and flow or tank setpoints, run weather compensation and supplementary heating, and read the board's I/O plus inlet, outlet and ambient temperatures, compressor status, alarms and energy for each of up to 10 Lincolns.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 1,
  "access_inferred": false,
  "notes": [
    "The guide gives no units; temperatures are in °C going by the prose (for example ch_master_flow_SP default 35 °C).",
    "Per-heat-pump objects (instances 56-117) carry the Lincoln number as the index in the name. Temperatures, compressor status and energy are printed for Lincolns 1 to 10; the minor and major alarm objects are printed for Lincoln 1 only.",
    "Access comes from the guide's Read/Write Mode column: Writeable / Read_Write = W, NoWrite = R.",
    "ch_bms_demand prose says 1 = ON, 2 = OFF in one place and 0 / 1 in another; the BinaryValue object is 0 = inactive, 1 = active.",
    "BACnet type IntegerValue is listed as IV and PositiveIntegerValue as PIV."
  ],
  "source": {
    "title": "Lincoln L70 BMS Interface BACnet Protocol",
    "doc_number": null,
    "revision_date": "Rev. 1 - 07062023",
    "url": "https://adveco.co/wp-content/uploads/2023/06/L70-Lincoln-Extension-BACnet-Protocol-Rev.1.pdf"
  },
  "integration": {
    "summary": "Set ch_mode_select (IV 49) to 4 (BMS Control), then switch heating with ch_bms_demand (BV 36) and set the flow temperature with ch_master_flow_SP (AV 15). For hot water set dhw_mode_select (IV 53) to 3 and use dhw_bms_demand (BV 44) with dhw_flow_SP (AV 18). Read ch_flow_SP and the fault flags.",
    "minimum_points": [
      {
        "ref": "IV 49",
        "name": "ch_mode_select",
        "why": "CH control mode; 4 = BMS Control"
      },
      {
        "ref": "BV 36",
        "name": "ch_bms_demand",
        "why": "CH demand from the BMS (1 = active)"
      },
      {
        "ref": "IV 53",
        "name": "dhw_mode_select",
        "why": "DHW control mode; 3 = BMS Control"
      },
      {
        "ref": "BV 44",
        "name": "dhw_bms_demand",
        "why": "DHW demand from the BMS"
      },
      {
        "ref": "AV 15",
        "name": "ch_master_flow_SP",
        "why": "CH flow setpoint in DI/BMS mode, °C"
      },
      {
        "ref": "AV 18",
        "name": "dhw_flow_SP",
        "why": "DHW flow setpoint, °C"
      },
      {
        "ref": "AI 13",
        "name": "ch_flow_SP",
        "why": "CH flow setpoint in use"
      },
      {
        "ref": "BI 37",
        "name": "ch_demand",
        "why": "CH demand active"
      },
      {
        "ref": "BI 39",
        "name": "ges_major_fault",
        "why": "Any major fault"
      },
      {
        "ref": "BI 40",
        "name": "ges_minor_fault",
        "why": "Any minor fault"
      }
    ],
    "enable": "ch_mode_select (IV 49) = 4 puts central heating under BMS control, switched by ch_bms_demand (BV 36) to the ch_master_flow_SP setpoint; dhw_mode_select (IV 53) = 3 does the same for hot water with dhw_bms_demand (BV 44).",
    "heartbeat": null,
    "remote_sensors": "ambient_temp_select (IV 48) picks the ambient temperature for weather compensation and low-ambient logic: the average of all active Lincolns, Lincoln 1 only, or the probe wired to the extension board.",
    "setup": [
      "BACnet MS/TP on the BMS2 / Fieldbus 2 port; defaults device instance 1, 9600 baud (1200-375000 selectable).",
      "Device instance and baud rate are set with bacnet_device_instance (PIV 118) and bacnet_baudrate (PIV 119); write Reboot_UPC (BV 120) = 1 to apply."
    ],
    "gotchas": [
      "Weather compensation is ignored while CH runs in 4-20 mA or 0-10 V mode."
    ]
  },
