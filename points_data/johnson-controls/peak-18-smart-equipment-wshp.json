{
  "manufacturer": "Johnson Controls",
  "manufacturer_slug": "johnson-controls",
  "model": "PEAK 18 SMART Equipment Controller - Water-Source Heat Pump (PK-OEM1820)",
  "model_slug": "peak-18-smart-equipment-wshp",
  "short_model": "PEAK 18 SMART Equipment WSHP",
  "aliases": [
    "PEAK 18",
    "PK-OEM1820-0",
    "PK-OEM18x0-0",
    "PEAK OEM 18",
    "SMART Equipment controller",
    "147.00-EG1",
    "Aurora ABC"
  ],
  "equipment_type": "Water-source heat pump controller",
  "applies_to": "Water-source heat pumps with a factory PEAK OEM 18 (24 V) SMART Equipment controller linked over Modbus to one or two Aurora (ABC) unit boards.",
  "summary": "The PEAK 18 is a factory-programmed SMART Equipment controller (BTL-listed B-ASC) that reads the heat pump's Aurora (ABC) board over Modbus and serves the data as BACnet MS/TP objects with IDs 5001 and up. It covers occupancy and setpoints, network override inputs for space temperature, humidity and IAQ, thermostat and stage outputs, Aurora fault code, lockout and pressure switches, plus device and network settings.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "The guide prints two tables: Table 9 for a single-compressor unit (one Aurora board, ABC-1) and Table 10 for a dual-compressor unit, which adds ABC-2 objects 5118-5153. Both are merged here; AV 5013 Number of Heat Pump Stages Installed appears only in Table 9.",
    "Access is from the Writeable column (TRUE = writable).",
    "Multistate objects carry named state sets (Off/On, Occ Override, Effective Input Source, Aurora Fault Names and so on). Two-word sets are shown as states; the other set names are given in the description. The guide does not print the state numbers.",
    "Units are imperial; the guide also lists SI units and limits.",
    "CSV 5104 is a real object named Description, and MV 5103 is named Units."
  ],
  "source": {
    "title": "PEAK 18 24 Volt SMART Equipment Controller Application and Troubleshooting Guide (Tables 9 and 10, BACnet Exposed Objects)",
    "doc_number": "147.00-EG1 (517)",
    "revision_date": "2017-05",
    "url": "https://docs.johnsoncontrols.com/ductedsystems/api/khub/documents/BcW0j0n4dRaKYtNhapJY2w/content"
  },
  "integration": {
    "summary": "Give the controller a unique MS/TP address (4-127) from the local display or MAP Gateway; baud defaults to auto. Command occupancy with MV 5059 Manual Occupancy Mode, write the occupied cooling and heating setpoints, and use the network override inputs if the BMS supplies space temperature. Read operational occupancy and space temperature, the Aurora stage outputs, lockout and fault code.",
    "minimum_points": [
      {
        "ref": "MV 5026",
        "name": "Mode",
        "why": "Unit mode: Shutdown or Enable"
      },
      {
        "ref": "MV 5059",
        "name": "Manual Occupancy Mode",
        "why": "Occupancy override from the BMS"
      },
      {
        "ref": "AV 5053",
        "name": "Occupied Cooling Setpoint",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 5054",
        "name": "Occupied Heating Setpoint",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "BV 5096",
        "name": "ABC-1 Reset Faults",
        "why": "Reset Aurora board faults"
      },
      {
        "ref": "MV 5030",
        "name": "Operational Occupancy",
        "why": "Occupancy in effect"
      },
      {
        "ref": "AV 5032",
        "name": "Operational Space Temperature",
        "why": "Space temperature the unit controls to"
      },
      {
        "ref": "BV 5079",
        "name": "ABC-1 CC - Compressor Contactor Enable",
        "why": "Compressor contactor output"
      },
      {
        "ref": "BV 5078",
        "name": "ABC-1 Unit Lockout Status",
        "why": "Unit locked out"
      },
      {
        "ref": "MV 5076",
        "name": "ABC-1 Active Fault Code",
        "why": "Active Aurora fault"
      }
    ],
    "enable": "The sequence runs when the Mode point is set to Enable. Occupancy follows the local schedule and can be overridden with Manual Occupancy Mode.",
    "heartbeat": "A value written to Network Override Space Temperature becomes the control input and restarts a 15-minute timeout; if the BMS stops writing, the input is treated as unreliable and ignored.",
    "remote_sensors": "AV 5034 Network Override Space Temperature, AV 5042 Network Override Zone Humidity, AV 5039 Network Override Indoor Air Quality and AV 5045 Network Override Space Setpoint Offset accept BMS values; the matching Source objects show which input is in use.",
    "setup": [
      "Valid MS/TP addresses are 4-127; set the address from the local display or MAP Gateway.",
      "Baud defaults to Auto (follows the trunk); 9600, 19200 and 38400 can be set manually.",
      "BACnet MS/TP, N2 or Modbus is chosen from the local display or MAP Gateway.",
      "The application is factory programmed and cannot be changed in the field; configuration and parameter changes are made from the local display or MAP Gateway."
    ],
    "gotchas": [
      "On dual-compressor units the second Aurora board appears as ABC-2 objects (5118-5153); map both boards' lockout and fault points.",
      "Installed-option flags (sensor, damper, economizer installed) are commissioning settings, not commands.",
      "State numbers for the multistate objects are not printed; read the state text from the device."
    ]
  },
