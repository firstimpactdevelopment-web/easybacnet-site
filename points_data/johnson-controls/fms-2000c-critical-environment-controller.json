{
  "manufacturer": "Johnson Controls",
  "manufacturer_slug": "johnson-controls",
  "model": "Triatek FMS-2000C Critical Environment Controller (BACnet MS/TP)",
  "model_slug": "fms-2000c-critical-environment-controller",
  "short_model": "FMS-2000C Critical Environment Controller",
  "aliases": [
    "FMS-2000C",
    "FMS2000C",
    "FMS-2000",
    "Triatek FMS-2000C",
    "LIT-12013504",
    "JCI critical environment controller"
  ],
  "equipment_type": "Room pressure controller (critical environment)",
  "applies_to": "Triatek / Johnson Controls FMS-2000C critical environment controllers for isolation rooms, labs and cleanrooms (successor of the FMS-1655).",
  "summary": "The FMS-2000C controls and monitors room pressure (and optionally flow, temperature and humidity) with a touch display, four analog inputs, two thermistor inputs, four analog outputs, four digital inputs and four relays. It talks BACnet MS/TP. The BACnet table has 93 objects: I/O, setpoints, alarm and warning limits, network-written values, airflow and volumetric offset, output overrides and input override values, deadbands, isolation mode commands and alarm status.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "85000 + MAC address",
  "access_inferred": false,
  "notes": [
    "Object names are the guide's functional descriptions.",
    "Compared with the FMS-1655 list: multistate objects are MV (not MSO), AV 17/18 are alarm relay 4 limits, AV 7-10 are read-only, AV 47 (device ID offset) is not listed, and AV 64-67 input override values are added.",
    "Units are not printed in the BACnet tables.",
    "Source: Tables 6-12 'BACnet objects', pages 22-24 (93 objects)."
  ],
  "source": {
    "title": "FMS-2000C Critical Environment Controller User Guide",
    "doc_number": "LIT-12013504",
    "revision_date": "2025-08",
    "url": "https://docs.johnsoncontrols.com/bas/api/khub/documents/qp2ryilUcG~ViAADcbhQ9g/content"
  },
  "integration": {
    "summary": "Map the primary isolation mode command, the room pressure setpoint, the measured room pressure, the damper output and the primary alarm status. Write network variables (AV 43-46) only if the BAS supplies those values.",
    "minimum_points": [
      {
        "ref": "MV 1",
        "name": "Primary isolation mode",
        "why": "Isolation mode: 1 positive, 2 negative, 3 neutral"
      },
      {
        "ref": "AV 1",
        "name": "AI-1 setpoint for room pressure",
        "why": "Room pressure setpoint"
      },
      {
        "ref": "AI 1",
        "name": "Analog input 1, default: isolation pressure",
        "why": "Room (isolation) pressure"
      },
      {
        "ref": "AO 1",
        "name": "Analog output 1, default: damper position",
        "why": "Damper position output"
      },
      {
        "ref": "BI 1",
        "name": "Digital input 1, default: door switch",
        "why": "Door switch"
      },
      {
        "ref": "MV 3",
        "name": "Primary alarm status",
        "why": "Primary alarm: 1 normal, 2 warning, 3 alarm"
      }
    ],
    "enable": "Primary isolation mode (MV 1) is writable: 1 positive, 2 negative, 3 neutral.",
    "heartbeat": null,
    "remote_sensors": "AV 43-46 are writable network variables for humidity, temperature, air changes and pressure sent from the BAS.",
    "setup": [
      "Default device ID is 85,000 plus the MAC address (MAC 25 gives 85,025); it can be changed to any value 0-4,194,303.",
      "MS/TP master MAC range 4-127. Default baud 38.4 kbps; 76.8, 19.2 and 9.6 kbps also offered. Reboot after changing baud or MAC.",
      "Terminate the MS/TP bus at the FMS-2000 display, not at the controller terminal block."
    ],
    "gotchas": [
      "Alarm limits, deadbands and setpoints are setup values; don't write them cyclically.",
      "What each analog input measures depends on how it is configured; names give the default use."
    ]
  },
