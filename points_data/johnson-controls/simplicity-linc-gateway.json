    "YORK Simplicity BACnet"
  ],
  "equipment_type": "Rooftop unit BACnet gateway",
  "applies_to": "Johnson Controls Unitary Products (YORK, Coleman, Luxaire) packaged rooftop units with Simplicity controls built after 4/2/2008, plus older Simplicity Elite and Simplicity with Intelli-Comfort controls, fitted with the Simplicity LINC gateway.",
  "summary": "The Simplicity LINC is a small gateway mounted in the rooftop unit's control panel. It polls the Simplicity unit controller over Modbus RTU and exposes a fixed set of points on BACnet MS/TP; no configuration is needed. The map has 34 analog inputs, 58 analog values (setpoints, sensor values and settings), 65 binary inputs (outputs, safeties, alarms) and 40 binary values (option and mode enables, comm-value selects, redline/loadshed).",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "ConFig v1.01d",
  "default_device_instance": 23001,
  "access_inferred": false,
  "notes": [
    "Access is from the Read/Write column. The table prefixes each object type with (2) or (5); the guide does not explain the prefix.",
    "Elite (E_) and Intelli-Comfort (I_) points only report on units with those controller generations; expansion board points need the board.",
    "Printed descriptors with a stray space after an underscore (e.g. E_FAN_ OVER) are shown without the space.",
    "The guide prints the list twice (description order and object order); both tables agree, 197 objects.",
    "Source: Simplicity LINC Gateway application guide 1031990-UAD-A-0313, Tables 2 and 3."
  ],
  "source": {
    "title": "Simplicity LINC Gateway Application Guide (ConFig v1.01d)",
    "doc_number": "1031990-UAD-A-0313",
    "revision_date": "2013-03",
    "url": "https://cdn.shopify.com/s/files/1/2139/8037/files/Johnson_Controls_Simplicity_LINC_GATEWAY_ee98fa51-0864-41dc-924a-3e68ee281f71.pdf?788",
    "unofficial": true,
    "host": "Distributor web store (Shopify CDN)"
  },
  "integration": {
    "summary": "Set the MAC address (1-99) on DIP switches A0-A7 and the baud on B0-B3 (default 38400); the device instance combines the DE modifier 230 with the MAC (default 23001). The BAS writes the occupied/unoccupied cooling and heating setpoints and can supply space temperature, outdoor temperature, humidity and IAQ values once the matching COMM_ accept BV is set. Read supply air temperature, the active alarm and the alarm buffers.",
    "minimum_points": [
      {
        "ref": "AV 1",
        "name": "OCC_COOL_SP",
        "why": "Occupied cooling setpoint, 46-99 °F"
      },
      {
        "ref": "AV 50",
        "name": "OCC_HEAT_SP",
        "why": "Occupied heating setpoint, 45-98 °F"
      },
      {
        "ref": "BI 16",
        "name": "AIR_PROOF_SW",
        "why": "Air proving switch (1 = air flow)"
      },
      {
        "ref": "AI 4",
        "name": "SUP_AIR_TEMP",
        "why": "Supply air temperature"
      },
      {
        "ref": "AV 6",
        "name": "SPACE_TEMP",
        "why": "Space temperature (BAS can write it)"
      },
      {
        "ref": "AI 15",
        "name": "ACTIVE_ALARM",
        "why": "Active alarm"
      },
      {
        "ref": "BI 11",
        "name": "MODBUS_ALARM",
        "why": "Gateway lost Modbus link to the unit"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "AV 6 SPACE_TEMP, AV 7 AMB_TEMP, AV 10 AMB_AIR_HUM, AV 12 RET_AIR_HUM and AV 8 IAQ_VALUE are writable; set BV 108 COMM_ST, BV 101 COMM_OAT, BV 100 COMM_OH, BV 99 COMM_RH or BV 109 COMM_IAQ so the controller accepts the BAS value.",
    "setup": [
      "MAC address 1-99 on DIP switches A0-A7 (default 1); baud on B0-B3 (default 38400).",
      "Device instance = DE modifier 230 combined with the MAC address (default 23001); default unit name YORK_RTU.",
      "The Simplicity board must stay at Modbus address 1 to talk to the gateway."
    ],
    "gotchas": [
      "The Simplicity flash memory is rated for 1,000,000 writes; do not write settings more than about once every 10 minutes on average.",
      "New data can take up to two minutes to show."
    ]
  },
