        "why": "Compressor relay state"
      },
      {
        "ref": "BO 10449",
        "name": "Defrost Relay",
        "why": "Defrost relay state"
      },
      {
        "ref": "BO 10452",
        "name": "Fan Relay",
        "why": "Evaporator fan relay state"
      },
      {
        "ref": "BI 10434",
        "name": "Alarm Refrigeration Leak",
        "why": "Refrigerant leak alarm"
      },
      {
        "ref": "BI 10437",
        "name": "Alarm Door Open",
        "why": "Door open alarm"
      },
      {
        "ref": "BO 10440",
        "name": "Alarm Relay",
        "why": "Alarm relay state"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Network needs the ADPT-MR5-RS485 adapter; MR534AFDN models need it bought separately.",
      "Set MS/TP CONNECTIVITY to BAC-NET (or Verasys) in the BACNET setup menu.",
      "Default BACnet device address (MAC) 07 and device ID 1; change both on the BACNET setup screens.",
      "Baud rates 9.6k, 19.2k and 38.4k. The adapter has no EOL switch; fit a 220 ohm resistor across + and - at the trunk ends."
    ],
    "gotchas": [
      "Change the default device ID 1 before adding several MR5s to one site.",
      "Defrost times (TV objects) are read-only over BACnet."
    ]
  },
