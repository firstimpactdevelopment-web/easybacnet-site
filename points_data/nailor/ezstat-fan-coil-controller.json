{
  "manufacturer": "Nailor",
  "manufacturer_slug": "nailor",
  "model": "EZstat Fan Coil Controller (EC-EZstat)",
  "model_slug": "ezstat-fan-coil-controller",
  "aliases": [
    "EZstat",
    "EC-EZstat",
    "Engineered Comfort EZstat"
  ],
  "equipment_type": "Fan coil unit thermostat-controller",
  "applies_to": "Engineered Comfort / Nailor EZstat wall controllers for two-pipe and four-pipe fan coil units with staged or modulating (EC) fans.",
  "summary": "The EZstat is a BACnet MS/TP application-specific controller (built on a KMC platform) that runs fan coil sequences either stand-alone or networked. The manual lists the objects most useful for monitoring: inputs, outputs, setpoint and status values, a schedule object and four PID loops. Output object names change between the two-pipe and four-pipe applications, and not every input object is present in every model.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The manual lists the objects likely needed for monitoring, not necessarily every object in the device.",
    "Output names differ by application: two-pipe names are shown, with the four-pipe name in each description.",
    "Access is inferred from object type; the manual has no read/write column.",
    "Not all input objects are present in every model; only inputs 1-3 are wired externally."
  ],
  "source": {
    "title": "Fan Coil Controller EZstat Installation and Operation Manual",
    "doc_number": "EC-EZstat",
    "revision_date": "2020-11",
    "url": "https://nailor.com/sites/default/files/documents/EC-EZSTATINST.pdf"
  },
  "integration": {
    "summary": "Set device instance, MAC and baud from the COMM menu, then map space temperature, the occupied setpoints, system and occupied modes and the fan points. Occupancy normally follows the internal BACnet schedule (SCHED_1 writing BV5), which a workstation can edit, or another BACnet device can command occupancy directly.",
    "minimum_points": [
      {
        "ref": "MV 2",
        "name": "SYSTEM_MODE",
        "why": "System (control) mode"
      },
      {
        "ref": "BV 5",
        "name": "OCC_SCHEDULE",
        "why": "Occupancy command; the internal schedule also writes it"
      },
      {
        "ref": "MV 1",
        "name": "OCCUPIED_MODE",
        "why": "Occupied mode"
      },
      {
        "ref": "AV 5",
        "name": "OCC_CL_STPT",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 6",
        "name": "OCC_HT_STPT",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "AV 34",
        "name": "FAN_SPEED",
        "why": "Fan speed"
      },
      {
        "ref": "SCH 1",
        "name": "SCHED_1",
        "why": "Internal occupancy schedule"
      },
      {
        "ref": "AV 1",
        "name": "SPACE_TEMP",
        "why": "Space temperature"
      },
      {
        "ref": "BV 14",
        "name": "FAN_STATUS",
        "why": "Fan proof status"
      }
    ],
    "enable": "The EZstat runs stand-alone; occupancy comes from its internal schedule (SCH 1 writing BV5 OCC_SCHEDULE) and can also be commanded by another BACnet device or workstation. Without the schedule enabled it starts occupied.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Set DEVICE ID (1-4,194,302), MAC (1-127) and BAUD (Auto, 9600, 19200, 38400, 76800) in the COMM menu after entering Password 2; the controller resets after a change.",
      "Time and date sync automatically from a BACnet time master on the network.",
      "Up to 128 addressable devices per MS/TP trunk, but the manual recommends no more than 60 controllers."
    ],
    "gotchas": [
      "The manufacturer warns that changing object configuration can cause unpredictable operation; limit BMS writes to setpoints and modes.",
      "Changing a setpoint inside the minimum differential (AV11) makes the controller move the opposite setpoint to keep the gap.",
      "Selecting a manual fan speed overrides auto; AUTO_FAN_RESET (BV16) with the local override timer (AV38, default 60 min) returns it to auto.",
      "Output object names change between two-pipe and four-pipe configurations."
    ]
  },
