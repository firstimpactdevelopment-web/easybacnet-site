  "equipment_type": "Fan coil room thermostat",
  "applies_to": "Siemens RDF400BN, RDF440BN and RDF460BN flush-mount fan coil thermostats (and -BK black versions) with BACnet MS/TP.",
  "summary": "The RDF4..BN thermostats control 2-pipe or 4-pipe fan coils with 1-speed, 3-speed or ECM fans and expose their settings over BACnet MS/TP. The BMS can write the operating mode, Comfort setpoint, fan speed, room temperature, changeover, window and presence values; most other objects are the thermostat's P-parameters.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "V1.0.1, V1.0.2",
  "default_device_instance": 10,
  "access_inferred": false,
  "notes": [
    "Object list from the basic documentation topic \"Description of BACnet communication objects (RDF4..BN..)\", edition 2026-08-19.",
    "The table prints SpTRMinCmf (P20) and SpTRMaxCmf (P21) under the same instance as AV 16 SpCmf; they are the Comfort setpoint limits and are not listed as separate objects.",
    "BV 7 and MV 22 show \"-\" in the writable column; they are listed read-only although they look like commands.",
    "Defaults for P02, P03 and P04 differ by model (RDF400BN, RDF440BN, RDF460BN); MV 24 applies to the RDF440BN only.",
    "The \"1)\" marks after the names of MV 5-8 are footnote markers and are left off."
  ],
  "source": {
    "title": "RDF4..BN.., RDF4..MB.., RDF440, RDF440-BK Room thermostat Basic Documentation",
    "doc_number": "A6V14153583",
    "revision_date": "2026-08-19",
    "url": "https://sid.siemens.com/r/A6V14153583"
  },
  "integration": {
    "summary": "Command the room operating mode through MV 21 and the Comfort setpoint through AV 16, and read the active setpoint, present mode and room temperature back. Fan speed is MV 2. Window, presence, keycard and changeover can be fed from the BMS through BV 6 and BV 8-10.",
    "minimum_points": [
      {
        "ref": "MV 21",
        "name": "ROpModSwi",
        "why": "Operating mode: 1 = Protection, 2 = Economy, 4 = Comfort"
      },
      {
        "ref": "AV 16",
        "name": "SpCmf",
        "why": "Comfort setpoint, °C"
      },
      {
        "ref": "MV 2",
        "name": "FanSpdCmd",
        "why": "Fan speed: 1 = auto, 2-4 = low/med/high"
      },
      {
        "ref": "MV 1",
        "name": "PrOpMod",
        "why": "Present operating mode"
      },
      {
        "ref": "AI 0",
        "name": "TR",
        "why": "Room temperature"
      },
      {
        "ref": "AV 0",
        "name": "SpTR",
        "why": "Active room setpoint"
      },
      {
        "ref": "AV 1",
        "name": "HReq",
        "why": "Heating demand, %"
      },
      {
        "ref": "AV 2",
        "name": "CReq",
        "why": "Cooling demand, %"
      },
      {
        "ref": "MV 23",
        "name": "Flt",
        "why": "Fault, 1 = no fault"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "AV 4 TRBus takes a room temperature from the bus; MV 10 P11 can show it on the display. Window contact, presence and keycard can also be written via BV 8-10.",
    "setup": [
      "Default device instance 10; device name and description are writable.",
      "Max Manager (Max Master) is writable, default 127.",
      "Most P-parameters (application, control sequence, fan type, inputs) are writable over BACnet as well as at the unit."
    ],
    "gotchas": [
      "BV 4 ResetPar (P89) resets the parameters; keep it off graphics.",
      "MV 13 keypad lock and MV 11 temperature unit change what the occupant sees."
    ]
  },
