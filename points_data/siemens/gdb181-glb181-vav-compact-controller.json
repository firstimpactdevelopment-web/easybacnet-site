  "equipment_type": "VAV compact controller (damper drive with flow sensor)",
  "applies_to": "Siemens OpenAir GDB181.1E/BA (5 Nm) and GLB181.1E/BA (10 Nm) VAV compact controllers with BACnet MS/TP.",
  "summary": "The G..B181.1E/BA is a VAV damper actuator with a built-in differential pressure sensor and controller that runs on BACnet MS/TP. The BMS writes a 0-100 % setpoint (relative volume flow in VAV mode, position in Pos mode) and reads actual flow, position and pressure. All VAV, backup and bus settings are BACnet objects too.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "Object list from the basic documentation's BACnet Object List topics (Device object, Process values, Parameters, Communication parameters, Status / statistics), edition 2021-12-20.",
    "Several object names wrap in the source (\"ActualFlow Relative\"); the property-name column gives them without spaces (ActualFlowRelative).",
    "There is no access column; process and status objects are marked R, commands and parameters W, and AO 0 C.",
    "MinPosition and MaxPosition are relative to the adaptation when AdaptiveMode = Adaptive.",
    "The Device object instance comes from DevObj-ID-Base (default 10000); the docs do not spell out whether the MAC address is added."
  ],
  "source": {
    "title": "VAV Compact Controller BACnet MS/TP G..B181.1E/BA - Basic Documentation",
    "doc_number": "A6V10695831",
    "revision_date": "2021-12-20",
    "url": "https://sid.siemens.com/r/A6V10695831"
  },
  "integration": {
    "summary": "Set OperatingMode (MV 3) to VAV and write the volume flow setpoint, 0-100 % of the Vmin-Vmax range, to AO 0. Read AI 1/AI 2 for actual flow and AI 0 for position. Set BackupMode and BackupTimeout so the box goes to a safe position if the BMS stops talking.",
    "minimum_points": [
      {
        "ref": "AO 0",
        "name": "Setpoint",
        "why": "Flow setpoint (VAV) or position (Pos), 0-100 %"
      },
      {
        "ref": "AI 1",
        "name": "ActualFlow Relative",
        "why": "Actual flow, % of Vmax"
      },
      {
        "ref": "AI 2",
        "name": "ActualFlow Absolute",
        "why": "Actual flow, m³/h"
      },
      {
        "ref": "AI 0",
        "name": "ActualPosition",
        "why": "Damper position, %"
      },
      {
        "ref": "BI 1",
        "name": "BackupMode Entered",
        "why": "Backup mode entered (communication lost)"
      },
      {
        "ref": "BI 2",
        "name": "Device Jammed",
        "why": "Actuator jammed"
      }
    ],
    "enable": "MV 3 OperatingMode selects VAV (flow control) or Pos (position control); AO 0 is read in that mode's meaning.",
    "heartbeat": "With BackupMode (MV 5) set to Backup Position or Keep Still, the actuator enters backup mode when no communication arrives within BackupTimeout (PIV 0, default 900 s); BI 1 shows it. Backup is disabled by default.",
    "remote_sensors": null,
    "setup": [
      "MAC address 0-128 (default 1) by push-button or PIV 3; baud auto by default (MV 7); Max Master default 127.",
      "New bus settings written over BACnet must be confirmed with MV 8 = Load within 30 s or they are discarded.",
      "Vnom (AV 4), Vmin/Vmax (AV 5/6) and Vn value (AV 3) must match the box; units by MV 6."
    ],
    "gotchas": [
      "Priorities: manual gear release, adaptation, self-test and local override all beat the setpoint; remote override (MV 0) also overrides AO 0.",
      "A remote override (MV 0) is cleared by a power reset."
    ]
  },
