{
  "manufacturer": "Lynxspring",
  "manufacturer_slug": "lynxspring",
  "model": "BW437-RTU-LX rooftop unit wall controller (Onyxx LX)",
  "model_slug": "bw437-rtu-lx",
  "aliases": [
    "BW437-RTU-LX",
    "BW437-RTU",
    "BW437RTU",
    "Onyxx LX BW437 RTU",
    "Onyxx LX RTU wall controller"
  ],
  "equipment_type": "Rooftop unit controller (wall-mount)",
  "applies_to": "Lynxspring Onyxx LX BW437-RTU-LX wall-mount controllers running packaged rooftop units and heat pumps over BACnet MS/TP.",
  "summary": "The BW437-RTU-LX is a wall-mounted thermostat-style controller with built-in room temperature, humidity, CO2 and motion sensing that runs a rooftop unit or heat pump from preset applications (MSV 127). On BACnet MS/TP it exposes its seven relays, four analog outputs and inputs, setpoints, demands, economizer and humidity settings, and a long list of configuration multi-states.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Onyxx LX UI software 4.0 or later, firmware 1.058 or later",
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "The guide has no read/write column; access is inferred from its tags (Status = read-only; Cfg, User and Cmd = writable).",
    "Binary and analog output descriptions are generated from the application chosen in MSV 127 (refreshed when BV 4 is on).",
    "MSV 7-10, 16-19, 23, 27, 28, 30, 32, 44, 45, 48, 49, 52, 54, 55, 65 and 68 are for custom applications; set MSV 127 to custom before changing them.",
    "A JP2 jumper selects whether the seventh output is BO 7 or AO 1 (ECM fan).",
    "Temperature units are listed as °F; the guide prints °F and °C ranges and the controller can be set to metric."
  ],
  "source": {
    "title": "BW437-RTU-LX Wall Controller Quick Guide",
    "doc_number": null,
    "revision_date": null,
    "url": "https://www.cochranesupply.com/media/assets/product/documents/Lynxspring/BW437-RTU-quick-guide.pdf",
    "unofficial": true,
    "host": "Cochrane Supply"
  },
  "integration": {
    "summary": "Pick the application in MSV 127, then command occupancy (MSV 6), system mode (MSV 3) and fan mode (MSV 4) from the BMS and adjust the occupied setpoints. Read room temperature, effective occupancy, supply air temperature and the help/alarm message.",
    "minimum_points": [
      {
        "ref": "MV 3",
        "name": "MODE",
        "why": "System mode (Off/Auto/Cool/Heat)"
      },
      {
        "ref": "MV 6",
        "name": "Loc-Occ",
        "why": "Occupancy command"
      },
      {
        "ref": "MV 4",
        "name": "FAN",
        "why": "Fan mode (On/Auto)"
      },
      {
        "ref": "AV 35",
        "name": "OccCLSP",
        "why": "Occupied cooling setpoint"
      },
      {
        "ref": "AV 36",
        "name": "OccHTSP",
        "why": "Occupied heating setpoint"
      },
      {
        "ref": "MV 5",
        "name": "Eff_Occ",
        "why": "Effective occupancy mode"
      },
      {
        "ref": "AI 5",
        "name": "RoomT",
        "why": "Room temperature"
      },
      {
        "ref": "AV 16",
        "name": "SATemp",
        "why": "Supply air temperature"
      },
      {
        "ref": "BV 7",
        "name": "Freeze_Status",
        "why": "Freeze condition active"
      },
      {
        "ref": "MV 100",
        "name": "HELP_mess",
        "why": "Help/alarm message (fan lock, frozen, filter)"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Network settings are entered in CONFIG MODE on the controller keypad.",
      "A jumper sets the end-of-line termination on the last MS/TP node.",
      "Firmware updates use the supplied USB-COM adapter or a USB to MS/TP converter cable."
    ],
    "gotchas": [
      "Changing MSV 127 (application preset) reassigns the outputs and their descriptions.",
      "Outdoor air temperature (AV 29) needs a sensor input or external value assigned in MSV 27."
    ]
  },
