{
  "manufacturer": "Quest Controls",
  "manufacturer_slug": "quest-controls",
  "model": "BACnet T-Stat",
  "model_slug": "bacnet-t-stat",
  "aliases": [
    "Quest BACnet T-Stat",
    "Quest Controls T-Stat"
  ],
  "equipment_type": "Thermostat (2-stage heat / cool, heat pump)",
  "applies_to": "Quest Controls BACnet T-Stat programmable thermostat for single or two-stage rooftop and heat pump equipment.",
  "summary": "The Quest Controls BACnet T-Stat is a BACnet MS/TP thermostat with zone and supply air thermistors, fan proving and a built-in weekly schedule of two occupied windows per day. Setpoints, delays, offsets and the schedule are analog values; fan modes and an occupied override are binary values; HVAC type, control mode and operating stage are multistate inputs; the G, Y1, Y2, W1/B, W2 and O outputs are commandable binary outputs.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "MS/TP network (AV 1) x 1000 + MAC address (AV 0)",
  "access_inferred": false,
  "notes": [
    "Access comes from the Writable column. The relay outputs BO 0-5 use the priority array, so they are marked commandable; they also accept 255 to remove the bypass.",
    "The multistate inputs MI 0-2 are listed as writable in the guide.",
    "AV 11 Cool Heat Min Diff is printed with units \"Seconds\" but limits of 2F..9F; it is listed in °F.",
    "Temperature objects follow BV 0 (Fahrenheit or Celsius)."
  ],
  "source": {
    "title": "BACnet T-Stat by Quest Controls User's Manual",
    "doc_number": "Rev 1.1",
    "revision_date": "2011-07-28",
    "url": "https://archive.org/download/manualzilla-id-7322454/7322454.pdf",
    "unofficial": true,
    "host": "Internet Archive (manualzilla)"
  },
  "integration": {
    "summary": "Set the control mode with MI 2, write the occupied and unoccupied setpoints AV 5-8 and use BV 3 to force occupied mode from the BMS (or program the schedule windows AV 25-52). Read AV 19 zone temperature, the active setpoints AV 23 / AV 24, MI 3 operating stage, AV 22 occupancy status and BI 0 fan proof.",
    "minimum_points": [
      {
        "ref": "BV 3",
        "why": "BACnet occupied override (1 = force occupied)",
        "name": "Force Occupied Mode"
      },
      {
        "ref": "MI 2",
        "why": "Mode: 1 auto, 2 cool only, 3 heat only, 4 off",
        "name": "Control Mode"
      },
      {
        "ref": "AV 5",
        "why": "Occupied stage 1 cooling setpoint",
        "name": "Occupied Cool Spt"
      },
      {
        "ref": "AV 7",
        "why": "Occupied stage 1 heating setpoint",
        "name": "Occupied Heat Spt"
      },
      {
        "ref": "AV 19",
        "why": "Zone temperature with offset applied",
        "name": "Zone Reading"
      },
      {
        "ref": "AV 23",
        "why": "Active stage 1 cooling setpoint",
        "name": "Cool Stage 1 Spt"
      },
      {
        "ref": "AV 24",
        "why": "Active stage 1 heating setpoint",
        "name": "Heat Stage 1 Spt"
      },
      {
        "ref": "MI 3",
        "why": "Operating stage: off, cooling or heating stage",
        "name": "Operation Mode Status"
      },
      {
        "ref": "AV 22",
        "why": "Occupied status bits: BACnet, panel, schedule",
        "name": "Occupied Mode Status"
      },
      {
        "ref": "BI 0",
        "why": "Fan proof input",
        "name": "Fan Proof"
      }
    ],
    "enable": "BV 3 Force Occupied Mode puts the thermostat in occupied mode from the BMS; 0 removes the BACnet override. The internal schedule (AV 25-52) runs otherwise.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Set MAC (AV 0, 1-127) and MS/TP network number (AV 1) and restart the thermostat; the device instance becomes network x 1000 + MAC.",
      "MS/TP baud rate is set with MI 0 (default 38400)."
    ],
    "gotchas": [
      "Writing the relay outputs BO 0-5 bypasses the thermostat logic; write 255 to remove the bypass."
    ]
  },
