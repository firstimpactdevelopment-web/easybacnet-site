    "RPC30 PresSura"
  ],
  "equipment_type": "Room pressure controller",
  "applies_to": "TSI PresSura RPC30 controllers that hold one room (optionally with an anteroom) at a set pressure by driving exhaust, supply and reheat outputs.",
  "summary": "The RPC30 measures room pressure and drives the exhaust and supply air valves (and optionally reheat) to keep a room positive, negative or at no isolation. Over BACnet MS/TP it exposes room pressure, flows, temperatures, control outputs, the pressure and temperature setpoints, flow limits, alarm limits, the room mode and a Status Index alarm code.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "From the RPC30 BACnet MS/TP Object Set appendix (manual pages 102-106).",
    "Access follows the Writable Value column; AI 10 and AI 11 have a writable object name (the room label) and are shown here as read-only values.",
    "Units shown are the English set; the table lists Pa, l/s, CMH and °C alternatives, chosen with Units Value (MV 18).",
    "AV 12 and AV 13 (pressure setpoints) and AV 44/45 have no units printed in the table.",
    "The Revision J link for this manual serves the same file (Revision L)."
  ],
  "source": {
    "title": "PresSura Room Pressure Controller Model RPC30 Operation and Service Manual",
    "doc_number": "P/N 6006643",
    "revision_date": "Revision L, February 2023",
    "url": "https://tsi.com/getmedia/a6941791-3bdc-4d01-abe2-b7d1fd9eae4e/RPC30_PresSura_Controller_6006643L-web?ext=.pdf"
  },
  "integration": {
    "summary": "Write the room mode (MV 11) and, if needed, the negative or positive pressure setpoint (AV 12/13). Read room pressure, flows, the control outputs and the Status Index (MV 16) for alarms. Occupancy is a wired input (BI 4) that switches between the occupied and unoccupied flow and temperature setpoints.",
    "minimum_points": [
      {
        "ref": "MV 11",
        "name": "Room 1 Mode",
        "why": "1 = positive, 2 = negative, 3 = no isolation"
      },
      {
        "ref": "AV 12",
        "name": "Room 1 Neg Setpoint",
        "why": "Negative-mode pressure setpoint, in. W.C."
      },
      {
        "ref": "AV 13",
        "name": "Room 1 Pos Setpoint",
        "why": "Positive-mode pressure setpoint, in. W.C."
      },
      {
        "ref": "AI 1",
        "name": "Room1 Pressure",
        "why": "Room differential pressure"
      },
      {
        "ref": "AI 2",
        "name": "Supply Flow Rate",
        "why": "Supply airflow"
      },
      {
        "ref": "AI 6",
        "name": "Exhaust Flow Rate",
        "why": "Exhaust airflow"
      },
      {
        "ref": "AI 5",
        "name": "Room Temperature",
        "why": "Room temperature"
      },
      {
        "ref": "AI 14",
        "name": "Exhaust Control Output",
        "why": "Exhaust valve output, % open"
      },
      {
        "ref": "BI 4",
        "name": "Room 1 Occupancy",
        "why": "0 = occupied, 1 = unoccupied"
      },
      {
        "ref": "MV 16",
        "name": "Status Index",
        "why": "Active alarm code; 1 = normal"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": "Relative humidity can come from the BMS: set BV 10 to Enable and write AV 56.",
    "setup": [
      "Set Comm Type to BACnet in the Interface menu (Modbus is the default); Address (1-127) is the MS/TP MAC and MAC ID is the BACnet device ID.",
      "BACnet MS/TP baud: 9600, 19200, 38400, 76800 or AutoBaud."
    ],
    "gotchas": [
      "Engineering units follow Units Value (MV 18): 1 = in. W.C./cfm/°F (default), 2 = Pa/lps/°C, 3 = Pa/CMH/°C.",
      "In No Isolation mode the controller holds the No Isolation setpoint (AV 14) by position, flow or pressure, per MV 13.",
      "Setpoints, flow limits and alarm limits are stored settings; do not write them cyclically."
    ]
  },
