  },
  "integration": {
    "summary": "Set the device instance, MAC address and baud on the AppStat, then connect it to BACnet MS/TP. Occupancy comes from schedule object SCHED_1 writing BV5 OCC_SCHEDULE, so either use that schedule or write BV5 from the BMS; read space temperature, the active setpoints and fan status.",
    "minimum_points": [
      {
        "ref": "BV 5",
        "name": "OCC_SCHEDULE",
        "why": "Occupancy state, written by schedule SCHED_1"
      },
