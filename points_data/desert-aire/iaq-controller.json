  "integration": {
    "summary": "Command occupancy with BV 1 and adjust the zone air and supply air setpoints (AV 22, AV 21). Monitor Unit Status (AV 1001), supply fan, supply and zone temperatures, and alarms through BV 3 (inverted) and the alarm code (AV 1008). Use BV 16 to reset alarms.",
    "minimum_points": [
      {
        "ref": "BV 1",
        "name": "Network Occupied Input",
        "why": "Occupancy command (1 = occupied)"
      },
      {
        "ref": "AV 22",
        "name": "Zone Air Setpoint",
        "why": "Zone air setpoint, 55.0-95.0 °F"
      },
      {
        "ref": "AV 21",
        "name": "Supply Air Setpoint",
        "why": "Supply air setpoint, 45.0-99.9 °F"
      },
      {
        "ref": "BV 16",
        "name": "Remote Reset",
        "why": "Write 1 to reset"
      },
      {
        "ref": "AV 1001",
        "name": "Unit Status",
        "why": "Operating state code (0-12)"
      },
      {
        "ref": "BV 5",
        "name": "Supply Fan",
        "why": "Supply fan running"
      },
      {
        "ref": "AV 6",
        "name": "Supply Air Temperature",
        "why": "Supply (leaving) air temperature, °F"
      },
      {
        "ref": "AV 7",
        "name": "Zone Air Temperature",
        "why": "Measured zone temperature, °F"
      },
      {
        "ref": "BV 3",
        "name": "Alarm Active",
        "why": "Unit alarm; 0 = alarm, 1 = normal"
      },
      {
        "ref": "AV 1008",
        "name": "Alarm Code",
        "why": "Active alarm code (1-20)"
      }
