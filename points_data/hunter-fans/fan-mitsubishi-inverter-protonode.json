{
  "manufacturer": "Hunter Fans",
  "manufacturer_slug": "hunter-fans",
  "model": "Fan with Mitsubishi inverter (ProtoNode FPC-N64 profile)",
  "model_slug": "fan-mitsubishi-inverter-protonode",
  "aliases": [
    "Hunter Fans ProtoNode",
    "FPC-N64",
    "Hunter Mitsubishi fan BACnet"
  ],
  "equipment_type": "Fan drive (VFD) via BACnet gateway",
  "applies_to": "Hunter Fans fans whose Mitsubishi inverter talks Modbus TCP/IP to a Hunter ProtoNode FPC-N64 gateway.",
  "summary": "Hunter's ProtoNode FPC-N64 profile for fans with a Mitsubishi inverter exposes 57 BACnet objects per fan: inverter reset and parameter clear commands, the inverter status bits (run, direction, fault and terminal states), operation mode and running frequency, output frequency, current, voltage and power, energy and load data, PID values and eight fault history entries.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "50000 + Node-ID",
  "access_inferred": true,
  "notes": [
    "XXX in each object name is replaced by the fan's number on the ProtoNode.",
    "The guide prints the Modbus register for each object but no units, ranges or state texts.",
    "No read/write column: access is inferred (AV/BV writable, AI/BI read-only).",
    "The guide prints the Parameter Clear and All Parameter Clear names twice (AV 2/4 and AV 3/5) with different registers.",
    "Inverter status bits are BV objects in the profile even though they are status; BI 57 is the fault-occurred bit."
  ],
  "source": {
    "title": "ProtoNode FPC-N64 Start-up Guide For Interfacing Hunter Fans Products",
    "doc_number": null,
    "revision_date": "Document Revision 2.B",
    "url": "https://wwcannon.com/wp-content/uploads/2024/11/Hunter-ProtoNode-BMS-Secure-Gateway-Interface-Products.pdf",
    "unofficial": true,
    "host": "W.W. Cannon (manufacturer's rep)"
  },
  "integration": {
    "summary": "Set the running frequency for each fan and read the run status bit, output frequency, current and power, plus the fault bit and fault history.",
    "minimum_points": [
      {
        "ref": "AV 19",
        "why": "Operation mode / inverter setting",
        "name": "InvXXX Op Mode/Inverter Set"
      },
      {
        "ref": "AV 20",
        "why": "Running frequency (RAM, not EEPROM)",
        "name": "InvXXX Running Freq (RAM Value)"
      },
      {
        "ref": "BV 6",
        "why": "Inverter status: running",
        "name": "InvXXX Inverter Status Run/Stop"
      },
      {
        "ref": "AI 22",
        "why": "Output frequency",
        "name": "InvXXX Output Frequency/Speed"
      },
      {
        "ref": "AI 23",
        "why": "Output current",
        "name": "InvXXX Output Current"
      },
      {
        "ref": "AI 33",
        "why": "Output power",
        "name": "InvXXX Output Power"
      },
      {
        "ref": "BI 57",
        "why": "Fault occurred",
        "name": "InvXXX Inverter Status Fault Occur"
      },
      {
        "ref": "AI 49",
        "why": "Latest fault (history 1)",
        "name": "InvXXX Fault History 1"
      }
    ],
    "enable": null,
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Each fan drive is its own BACnet device: Device Instance = Node_Offset (default 50,000) + the drive's Node-ID.",
      "The drives talk Modbus TCP/IP to the ProtoNode; enter each drive's ip_address and tcp_id when adding its profile in the web configurator.",
      "Default ProtoNode IP address 192.168.1.24; the ProtoNode serves BACnet IP or BACnet MS/TP to the BMS."
    ],
    "gotchas": [
      "AV 21 is, by its name, the EEPROM copy of the running frequency; write the RAM object (AV 20) for routine speed changes.",
      "Parameter clear and reset objects (AV 1-5) change the inverter; keep them out of routine BMS logic."
    ]
  },
