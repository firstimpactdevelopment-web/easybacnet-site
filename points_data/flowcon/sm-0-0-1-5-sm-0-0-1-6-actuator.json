  },
  "integration": {
    "summary": "Set MV 13 to BACnet and MV 6 to Serial (BUS), then write the demand to AV 4. Read AV 22 for flow, MV 2 for state and BSV 2 for alarms; PIV 30 sets how long the actuator waits before treating the bus as lost.",
    "minimum_points": [
      {
        "ref": "MV 6",
        "name": "Actuator Control Signal",
        "why": "4 = Serial (BUS) control"
      },
      {
        "ref": "AV 4",
        "name": "Actuator Control Demand",
        "why": "Control demand, 0-100 %"
      },
      {
        "ref": "MV 2",
        "name": "Actuator State",
        "why": "Operating state"
      },
      {
        "ref": "AV 22",
        "name": "Current Flow",
        "why": "Current flow rate"
      },
      {
        "ref": "AV 1",
        "name": "Actuator Position",
        "why": "Current position, degrees"
      },
      {
        "ref": "Other 2",
        "name": "Actuator Alarm Flags",
        "why": "Alarm bits"
      }
    ],
    "enable": "MV 13 selects the communication mode (BACnet) and MV 6 = 4 (Serial) makes the actuator follow AV 4.",
    "heartbeat": "PIV 30 sets the network timeout (1-60 min); BSV 2 bit 12 flags a network timeout. AV 18 sets the position on control signal loss (-1 = stay in place).",
    "remote_sensors": null,
    "setup": [
      "MS/TP MAC (1-127) and baud rate (autobaud or 9600-115200) are set in the Network Port object."
    ],
    "gotchas": [
      "BV 1 resets the actuator to factory settings.",
      "BV 2 and BV 3 clear error codes 2 (over torque) and 7 (lack of valve)."
    ]
  },
