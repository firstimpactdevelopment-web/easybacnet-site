  ],
  "equipment_type": "Valve controller (energy valve interface)",
  "applies_to": "FlowCon FIT intelligent interface (ACC40023) that turns a FlowCon PICV (SM, FN or FH actuator) plus temperature and pressure sensors into an energy valve, BACnet MS/TP.",
  "summary": "The FIT interface sits between the BMS and a FlowCon PICV actuator and adds supply/return temperature (and optional pressure) sensors. It can run as a delta T energy valve, as a comfort (flow) PICV, or in a smart mode that balances room temperature against delta T, and it logs energy use. MV 6 sets which actuator and sensor set is fitted; many objects only work in some configurations.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Firmware 3.0.4, application 1.05",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Several objects only work in certain configurations (MV 6); the PICS marks them \"Works in config. ...\".",
    "AV 138, AV 139, AV 164 and MV 41 are printed as no function.",
    "AV 165-168 are values FIT writes back to the actuator display; FIT overwrites them.",
    "TL 1 is a daily energy trend log with 1200 entries that rolls over."
  ],
  "source": {
    "title": "Protocol Implementation Conformance Statement (PICS) for FlowCon FIT",
    "doc_number": null,
    "revision_date": "2026-06-26",
    "url": "https://flowcon.com/fileadmin/user_upload/Pdf/Certificates/BACnet_PICS/FlowCon-BACnet-PICS-Statement-FlowCon-FIT.pdf"
  },
  "integration": {
    "summary": "Set MV 6 to the fitted actuator/sensor set and MV 5 to the control strategy, then write the delta T target (AV 4) or room values (AV 6/AV 7) or the control signal (AV 141). Read flow, delta T and energy; watch the alarm BVs.",
    "minimum_points": [
      {
        "ref": "MV 5",
        "name": "Flow Control",
        "why": "Control strategy (delta T, comfort, smart)"
      },
      {
        "ref": "AV 141",
        "name": "AnalogControlSignal",
        "why": "Control signal, %"
      },
      {
        "ref": "AV 4",
        "name": "WaterTempDeltaTarget",
        "why": "Delta T target"
      },
      {
        "ref": "AV 7",
        "name": "RoomTargetTemp",
        "why": "Room temperature target"
      },
      {
        "ref": "AV 6",
        "name": "RoomTemperature",
        "why": "Room temperature from the BMS"
      },
      {
        "ref": "AV 68",
        "name": "FlowRate",
        "why": "Current flow rate"
      },
      {
        "ref": "AV 3",
        "name": "WaterTempDelta",
        "why": "Delta T"
      },
      {
        "ref": "AV 10",
        "name": "EnergyConsumption",
        "why": "Current energy rate"
      },
      {
        "ref": "BV 62",
        "name": "BACnetFallback-Alarm",
        "why": "BACnet fallback active"
      },
      {
        "ref": "BV 59",
        "name": "PowerFailAlarm",
        "why": "Power failure alarm"
      }
    ],
    "enable": "MV 5 picks how FIT controls the valve: 1/4 delta T target, 2 comfort (set flow), 3/5 smart (room temperature with delta T).",
    "heartbeat": "AV 143 sets the BACnet control fallback timeout (1-60 min, config 1); MV 43 shows the fallback action and BV 62 flags it.",
    "remote_sensors": "Room temperature AV 6 and its target AV 7 are writable for the comfort and smart modes.",
    "setup": [
      "MS/TP MAC is MV 2 (0-127) and baud rate MV 1 (9600-115200).",
      "Choose units first: MV 3 temperature, MV 4 energy, MV 7 pressure, MV 39 flow."
    ],
    "gotchas": [
      "MV 6 Configuration is flagged in the PICS with \"!!\"; set it once to match the hardware.",
      "BV 4 resets the accumulated energy log."
    ]
  },
