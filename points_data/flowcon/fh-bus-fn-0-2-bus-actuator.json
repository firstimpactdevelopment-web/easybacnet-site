{
  "manufacturer": "FlowCon",
  "manufacturer_slug": "flowcon",
  "model": "FH-BUS / FN.0.2-BUS PICV actuator",
  "model_slug": "fh-bus-fn-0-2-bus-actuator",
  "aliases": [
    "FH-BUS",
    "FN.0.2-BUS",
    "FN02-BUS",
    "FlowCon FH actuator",
    "FlowCon FN actuator",
    "FlowCon Green.3 actuator",
    "FlowCon GreEQ actuator"
  ],
  "equipment_type": "Valve actuator (PICV)",
  "applies_to": "FlowCon FH-BUS actuator (FlowCon Green.3 PICV) and FN.0.2-BUS actuator (FlowCon Green and GreEQ PICVs) with BACnet MS/TP.",
  "summary": "Modulating bus actuators for FlowCon pressure-independent control valves, talking BACnet MS/TP or Modbus. The BMS can drive the valve directly (AV 1 flow set point) or let the actuator run room temperature, thermal power or return temperature control from its own PI loop, with two configurable sensor ports. It also reports flow, delta T, thermal power, energy and several fault flags.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "Software 2.11, protocol revision 1.22",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "The FH-BUS and FN.0.2-BUS PICS print the same 72 objects; they differ only in MV 8 valve choices, the PT100/PT1000 option in MV 2 and the AV 18 range.",
    "Network Port 1 (MS/TP) is listed as Other 1.",
    "AV 4, AV 5 and AV 17 are writable only when MV 5 / MV 10 selects BUS as the source.",
    "Thermal power and energy values (AI 16-18) are only valid on PICVs.",
    "Instance numbers skip AI 14, AV 9, AV 21 and AV 24-27, AV 33-34 as printed."
  ],
  "source": {
    "title": "BACnet PICS for FlowCon FH-BUS",
    "doc_number": null,
    "revision_date": "2026-03-02",
    "url": "https://flowcon.com/fileadmin/user_upload/Pdf/Certificates/BACnet_PICS/FlowCon-BACnet-PICS-Statement-FlowCon-FH-BUS.pdf"
  },
  "integration": {
    "summary": "Set MV 4 to 1 (external control signal) and write the flow demand to AV 1, or pick a local control mode and write its set point. Set MV 6 to choose what the actuator does if the bus goes quiet, and watch BI 3-7 for faults.",
    "minimum_points": [
      {
        "ref": "MV 4",
        "name": "Operating mode",
        "why": "Control mode; 1 = follow AV 1"
      },
      {
        "ref": "AV 1",
        "name": "External control signal",
        "why": "Flow set point, 0-100 %"
      },
      {
        "ref": "MV 9",
        "name": "Choose HVAC mode (Changeover)",
        "why": "Changeover: shut-off, heating, cooling, auto"
      },
      {
        "ref": "AI 6",
        "name": "Actual value control signal",
        "why": "Actual flow, % of max."
      },
      {
        "ref": "AI 7",
        "name": "Actual volume flow rate",
        "why": "Actual flow, l/h"
      },
      {
        "ref": "AI 8",
        "name": "Differential temperature",
        "why": "Water delta T"
      },
      {
        "ref": "BI 3",
        "name": "Actuator is busy",
        "why": "Not following the control signal"
      },
      {
        "ref": "BI 4",
        "name": "Actuator in malfunction",
        "why": "Hardware fault"
      },
      {
        "ref": "BI 6",
        "name": "Error: valve blocking",
        "why": "Valve blocked"
      }
    ],
    "enable": "MV 4 = 1 makes the actuator follow AV 1; other MV 4 values hand control to the built-in room temperature, thermal power or return temperature loop.",
    "heartbeat": "MV 6 sets the action on communication loss: fail in place, or after 120 s close, open or go to the AV 8 position (default 30 %).",
    "remote_sensors": "Supply/return temperatures (AV 4/AV 5) and room temperature (AV 17) can be written by the BMS when MV 5 / MV 10 select BUS as the source.",
    "setup": [
      "MS/TP MAC is AV 28 (1-127), writable only with the DIP switches set to 63.",
      "Baud rate is MV 7 (default 38400); a change needs an actuator restart."
    ],
    "gotchas": [
      "MV 1 service commands include reset to factory settings; write it only on purpose.",
      "AV 2/AV 3 limit the control signal range; AV 22/AV 23 limits can override AV 1 (BI 8 shows when)."
    ]
  },
