  "integration": {
    "summary": "Pick BACnet MSTP or BACnet IP/Eth as the BMS card protocol in Service > BMS Configuration and set the instance and address with the Termconf plug-in screens. Use BV 16 Superv_OnOff to run the unit and BV 27 for occupancy, write the cooling setpoint (AV 9) and heat offset (AV 10), and keep BV 17 heartbeat toggling if the heartbeat is enabled. Watch the general alarm (BV 15) and the individual alarm BVs.",
    "minimum_points": [
      {
        "ref": "BV 16",
        "name": "Superv_OnOff",
        "why": "BMS on/off command"
      },
      {
        "ref": "BV 27",
        "name": "bms_occ",
        "why": "BMS occupied command"
      },
      {
        "ref": "AV 9",
        "name": "pco_temp_setpt",
        "why": "Cooling setpoint"
      },
      {
        "ref": "AV 10",
        "name": "ht_offset",
        "why": "Heating setpoint offset below cooling setpoint"
      },
      {
        "ref": "BV 17",
        "name": "heartbeat",
        "why": "BMS heartbeat, when enabled in the BMS menu"
      },
      {
        "ref": "BV 26",
        "name": "BMS_Reset",
        "why": "Alarm reset command"
      },
      {
        "ref": "BV 6",
        "name": "Supply_fan",
        "why": "Supply fan relay status"
      },
      {
        "ref": "AV 8",
        "name": "cntrl_sensor",
        "why": "Control temperature"
      },
      {
        "ref": "AV 4",
        "name": "sa_temp",
        "why": "Supply air temperature"
      },
      {
        "ref": "BV 15",
        "name": "General_Alarm",
        "why": "General alarm"
      }
    ],
    "enable": "BV 16 Superv_OnOff is the BMS on/off command and BV 27 bms_occ the BMS occupied command; the unit display shows 'OFF by BMS' when the BMS has switched it off.",
    "heartbeat": "The BMS Configuration menu has an 'Enable heartbeat' option (default No), a timeout and an 'If BMS Offline turn unit' On/Off choice; the BMS writes BV 17 heartbeat. When the heartbeat is lost the 'BMS Offline (No Heart Beat)' alarm is raised and, depending on setup, the unit turns off or stays in occupied mode.",
    "remote_sensors": null,
    "setup": [
      "BMS card protocol and BMS port 2 protocol are chosen in Service > BMS Configuration.",
      "Set Termconf PlugIn = Yes to edit the BACnet MS/TP (baud, MAC, Max Masters, Max Info Frames) or BACnet IP (instance, IP, subnet, gateway, DNS) settings.",
      "Use Function = Write and Update = Yes to send the settings to the card."
    ],
    "gotchas": [
      "Integer AVs start at 1001; do not confuse AV 1-24 (analog) with AV 1001+ (integer).",
      "If the heartbeat is enabled and BV 17 stops changing, the unit can shut off.",
      "Geo water, ERM and electric heat points only carry data when those options are fitted."
    ]
  }
}
