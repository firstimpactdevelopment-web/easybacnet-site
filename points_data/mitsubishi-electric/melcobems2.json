{
  "manufacturer": "Mitsubishi Electric",
  "manufacturer_slug": "mitsubishi-electric",
  "model": "Procon MelcoBEMS2 (centralised controller BEMS gateway)",
  "model_slug": "melcobems2",
  "aliases": [
    "MelcoBEMS2",
    "MelcoBEMS",
    "Procon MelcoBEMS",
    "MELCOBEMS"
  ],
  "equipment_type": "VRF central controller gateway",
  "applies_to": "Mitsubishi Electric City Multi and split systems managed by an AE-C400/EW-C50, AE-200/EB50, AG-150A or GB-50ADA centralised controller (up to 50 groups).",
  "summary": "The Procon MelcoBEMS2 connects to a Mitsubishi Electric centralised controller over Ethernet and republishes up to 50 air-conditioning groups on BACnet IP (and Modbus). Each group gets the same block of objects: on/off, mode, fan speed, setpoint, vane, filter sign and inhibit commands with matching states, room temperature, error code, energy and run-time totals, hot-water heat pump values and dual setpoints, plus system objects for M-NET and controller status and a global forced-off.",
  "bacnet_transport": [
    "BACnet IP"
  ],
  "firmware": null,
  "default_device_instance": null,
  "access_inferred": true,
  "notes": [
    "Per-group instance = 1GGGPP: GGG = group number 001-050, PP = point. Group 001 is listed (e.g. 100101). OC/BC Error Code uses 1YYY22 with YYY = unit address 051-100 (105122 shown for 051).",
    "Object names are either generic (listed here, 'nnn' = group number) or the labels read from the centralised controller ('by Aircon'), chosen in the Labels setting.",
    "The guide prints no generic name for points 41-46 and 51-70; their object-list labels are shown instead. It labels AO 1xxx66-70 'Read' although they are output objects.",
    "Access is inferred from object type; the guide has no read/write column.",
    "Only groups configured on the centralised controller appear as BACnet objects. Water, brine and dual-setpoint points apply only to matching unit types.",
    "The older Procon MelcoBEMS (manual 1.05) uses the same numbering but has no points 51-63."
  ],
  "source": {
    "title": "Procon MelcoBEMS2 Installation and Operation Manual (version 1.09)",
    "doc_number": null,
    "revision_date": null,
    "url": "https://library.mitsubishielectric.co.uk/pdf/download_full/5540"
  },
  "integration": {
    "summary": "Point the MelcoBEMS2 at the centralised controller's IP address in its web page, set the BACnet device instance and port, then map each group's on/off, mode, setpoint and fan commands with their state objects, room temperature and error code.",
    "minimum_points": [
      {
        "ref": "BO 100101",
        "name": "Grp nnn On Off Wr",
        "why": "Group on/off command"
      },
      {
        "ref": "MO 100104",
        "name": "Operation Mode Wr",
        "why": "Operation mode command"
      },
      {
        "ref": "AO 100109",
        "name": "Grp nnn Setpoint Temperature Wr",
        "why": "Setpoint command"
      },
      {
        "ref": "MO 100106",
        "name": "Fan Speed Wr",
        "why": "Fan speed command"
      },
      {
        "ref": "BI 100102",
        "name": "Grp nnn On Off Rd",
        "why": "On/off state"
      },
      {
        "ref": "MI 100105",
        "name": "Operation Mode Rd",
        "why": "Current operation mode"
      },
      {
        "ref": "AI 100108",
        "name": "Grp nnn Room Temperature",
        "why": "Room temperature"
      },
      {
        "ref": "AI 100103",
        "name": "Grp nnn (Unit nn) Error Code",
        "why": "4-digit error code, 8000 = no error"
      },
      {
        "ref": "BI 100026",
        "name": "G50 Comms State",
        "why": "Centralised controller link, Active = OK"
      }
    ],
    "enable": "Functions to be inhibited locally (on/off, mode, setpoint, filter reset) must first be set on the centralised controller; Local Inhibit Wr then locks them at the remote controller.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Default web page http://192.168.1.11; the centralised controller IP address is entered there.",
      "Device instance, BACnet IP port, device name and location are set on the web page."
    ],
    "gotchas": [
      "New Setting Compare (BV 100027) set to Write COV makes the gateway ignore repeated identical writes; useful when the BMS writes cyclically.",
      "While M-NET is initialising (BI 100023 inactive) the units are offline to commands."
    ]
  },
