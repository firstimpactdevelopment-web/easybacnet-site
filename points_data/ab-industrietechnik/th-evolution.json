{
  "manufacturer": "AB Industrietechnik",
  "manufacturer_slug": "ab-industrietechnik",
  "model": "TH Evolution room thermostat / fan coil controller, BACnet MS/TP",
  "model_slug": "th-evolution",
  "aliases": [
    "TH Evolution",
    "TH-xBxSx1",
    "Evolution Controller TH",
    "Industrietechnik TH Evolution",
    "AB Industrietechnik TH"
  ],
  "equipment_type": "Fan coil thermostat / room controller",
  "applies_to": "AB Industrietechnik (Bressanone, Italy) TH Evolution wall controllers for fan coils and radiant systems, BACnet MS/TP versions TH-xBxSx1.",
  "summary": "TH Evolution is a wall-mounted room controller for 2- and 4-pipe fan coils (3-speed or EC fans) with relays, 0-10 V outputs and inputs for remote sensors and contacts. The BACnet MS/TP version exposes sensor readings as Analog Inputs, output values, setpoints, offsets and tuning as Analog Values, input and relay states as Binary Inputs and Values, and regulation type, input functions, fan speed mode and display options as Multi-State Values.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": "I63 x 10000 + I62 (parameters)",
  "access_inferred": false,
  "notes": [
    "Names are printed with \"(Note n)\" markers that point to rounding and working-setpoint notes; the markers are dropped here.",
    "Temperature units follow BV 2176 UNIT_C_F; written temperatures are rounded to 0.5 °C or 0.2 °F steps.",
    "AV 3016 WORKING_SET is calculated from the setpoint parameters and is forced to fixed values (for example 70.0 °C) on antifreeze or sensor alarm.",
    "BV 2129, 2130 and 2176 print two value texts (EC / 3-SPEED, STANDARD / WITH AUX RELAY, CELCIUS / FARENHEIT) without saying which is active.",
    "Regulation type abbreviations: H=heating, C=cooling, R=electric heater, c/o=season changeover, auto=water sensor, rem.=remote contact, par.=parameter."
  ],
  "source": {
    "title": "TH Evolution user manual, chapter BACnet signals",
    "doc_number": "th_evolution_manu_en rev 1.1.7",
    "revision_date": "12/03/2025",
    "url": "https://www.industrietechnik.it/globalassets/pimmediafiles/documents/th_evolution_manu_en.pdf"
  },
  "integration": {
    "summary": "Set the device ID with parameters I62/I63 and the MS/TP address, then switch the unit with BV 2189, choose fan speed mode and occupancy settings, and adjust the heating/cooling setpoints. Read room temperature, the working setpoint and relay states.",
    "minimum_points": [
      {
        "ref": "BV 2189",
        "name": "ON_OFF_MANUAL",
        "why": "Manual on/off"
      },
      {
        "ref": "MV 2188",
        "name": "FAN_SPEED_MODE",
        "why": "Fan speed (manual 1-3 or automatic)"
      },
      {
        "ref": "MV 2187",
        "name": "STA_MANUAL",
        "why": "Season, 2-pipe systems (winter/summer)"
      },
      {
        "ref": "AV 2138",
        "name": "BASIC_HEAT_SET",
        "why": "Heating setpoint (non 4-pipe)"
      },
      {
        "ref": "AV 2139",
        "name": "BASIC_COOL_SET",
        "why": "Cooling setpoint (non 4-pipe)"
      },
      {
        "ref": "AI 3002",
        "name": "INT_TEMP_COMP",
        "why": "Room temperature, internal sensor"
      },
      {
        "ref": "AV 3015",
        "name": "WORKING_TEMP",
        "why": "Operating (control) temperature"
      },
      {
        "ref": "AV 3016",
        "name": "WORKING_SET",
        "why": "Working setpoint in use"
      },
      {
        "ref": "BV 3007",
        "name": "STATE_REL1",
        "why": "Relay 1 state"
      }
    ],
    "enable": "BV 2189 ON_OFF_MANUAL switches the controller on or off.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "BACnet device ID = I63 x 10000 + I62, set from the parameter menu.",
      "MS/TP master or slave at 9600, 19200, 38400 or 76800 baud (PICS)."
    ],
    "gotchas": [
      "Use the setpoint AV that matches the regulation type: 2138/2139 for non 4-pipe, 2140 for 4-pipe.",
      "Out-of-scale 0-10 V input reads 32000 (or 3200) on INPUT_AI3."
    ]
  },
