  "equipment_type": "Variable frequency drive",
  "applies_to": "TECO-Westinghouse L510 compact inverters using the built-in RS-485 port in BACnet MS/TP mode.",
  "summary": "The L510 is a compact inverter with BACnet MS/TP built into its RS-485 port. Its object list follows the F510 layout but is smaller: one analog output terminal, eight preset speeds (AO 7-14), five digital inputs and one relay. Analog inputs are scaled in percent and frequencies run to 599 Hz.",
  "bacnet_transport": [
    "BACnet MS/TP"
  ],
  "firmware": "0.14 (Firmware_Revision in the device object table)",
  "default_device_instance": null,
  "access_inferred": false,
  "notes": [
    "Ranges printed in the object tables are given in brackets in each description.",
    "Binary state text is given as printed (for example Close / Open); the tables do not say which value is 0 and which is 1.",
    "The device object prints object name and vendor name 'TECO L510', vendor ID 461, Max_Master 127, Max_Info_Frames 1.",
    "Supported services listed: ReadProperty, WriteProperty and Who-Is.",
    "AO 2 and AO 15-22 do not exist on the L510 (gaps in the printed table)."
  ],
  "source": {
    "title": "L510 Communication Addendum (Modbus RTU/ASCII, BACnet, Metasys N2, Profibus)",
    "doc_number": "TECO-L510-AC001",
    "revision_date": "Ver01 2015-06",
    "url": "https://www.tecowestinghouse.com/PDF/L510_comm_addendum.pdf"
  },
  "integration": {
    "summary": "Wire the drive's RS-485 port to the MS/TP trunk and select BACnet as the drive's communication mode. Set the run and frequency command sources to communication (AO 23 / AO 26 mirror those parameters), then write the speed to AO 0 and start/stop with BV 0. Read BI 0, AI 4, AI 5 and BI 2 / AI 2 for status and faults.",
    "minimum_points": [
      {
        "ref": "BV 0",
        "name": "RUN/STOP",
        "why": "Run/stop command"
      },
      {
        "ref": "AO 0",
        "name": "Set frequency",
        "why": "Frequency command, Hz"
      },
      {
        "ref": "BI 0",
        "name": "Run/Stop",
        "why": "Running status"
      },
      {
        "ref": "AI 4",
        "name": "Frequency",
        "why": "Output frequency, Hz"
      },
      {
        "ref": "AI 5",
        "name": "Current",
        "why": "Output current, A"
      },
      {
        "ref": "BI 2",
        "name": "status",
        "why": "Drive fault (OK / Fault)"
      },
      {
        "ref": "AI 2",
        "name": "Error code",
        "why": "Latest fault code"
      }
    ],
    "enable": "Set the main run command source (AO 23) and main frequency command source (AO 26) to the communication option; the addendum does not print the setting values for the L510.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Station number, baud rate and BACnet mode selection are drive parameters; the object list only reads them back (AI 12-15).",
      "Max_Master is fixed at 127 and Max_Info_Frames at 1."
    ],
    "gotchas": [
      "AO 3, AO 23-30 and AV 0-2 are drive parameters; avoid cyclic writes.",
      "AO 1 is read-only although typed as Analog Output; it reports the terminal output voltage."
    ]
  },
