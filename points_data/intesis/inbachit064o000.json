  "equipment_type": "VRF BACnet gateway (up to 16 or 64 indoor units)",
  "applies_to": "Hitachi VRF systems on the H-Link (TB2) bus: up to 16 (INBACHIT016O000) or 64 (INBACHIT064O000) indoor units.",
  "summary": "An Intesis BACnet server that connects to the Hitachi H-Link bus at the outdoor unit and publishes every configured indoor and outdoor unit as BACnet IP and BACnet MS/TP objects. Each indoor unit gets the same block of objects at a base instance of (unit index x 100); outdoor units get (address x 25) + 1000. Configuration is done with the Intesis MAPS tool.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 246,
  "access_inferred": false,
  "notes": [
    "Points are shown for the gateway-wide 'all units' commands, outdoor unit address 0 and indoor unit index 1 only.",
    "Indoor unit instance = (xxx x 100) + offset, where xxx is the unit index in Intesis MAPS (index 1 gives 100-111 here).",
    "Outdoor unit instance = (xx x 25) + 1000 + offset, where xx is the outdoor unit address (address 0 shown, 1000-1006).",
    "Object names carry the Oxx/Uxx (or OUxx) address prefix, replaced by the real addresses on site.",
    "Vane and Operat. Condition state lists are taken from the object-detail pages (the summary table abbreviates them).",
    "FanSpeed High+ (5) appears in the summary table but not in the object-detail state table, and RC SW Config's detail page prints its states reversed (0=Without RCS, 1=With RCS); verify on site."
  ],
  "source": {
    "title": "Intesis BACnet Server - Hitachi VRF User's Manual",
    "doc_number": null,
    "revision_date": "2022/06 r1.2",
    "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inbachitxxxo000.pdf"
  },
  "integration": {
    "summary": "Wire the gateway's Port A to the H-Link TB2 terminals, scan or enter the indoor/outdoor units in Intesis MAPS, send the configuration, then map each unit's _C command and _S status objects from its instance block. The 'all units' objects at instances 0-2 command every unit at once.",
    "minimum_points": [
      {
        "ref": "BO 100",
        "name": "OxxUxxOn/Off_C",
        "why": "Start/stop indoor unit"
      },
      {
        "ref": "MO 100",
        "name": "OxxUxxMode_C",
        "why": "Mode command"
      },
      {
        "ref": "AO 100",
        "name": "OxxUxxSetpoint_C",
        "why": "Setpoint command"
      },
      {
        "ref": "MO 101",
        "name": "OxxUxxFanSpeed_C",
        "why": "Fan speed command (1 = auto)"
      },
      {
        "ref": "BI 100",
        "name": "OxxUxxOn/Off_S",
        "why": "Run status"
      },
      {
        "ref": "AI 100",
        "name": "OxxUxxSetpoint_S",
        "why": "Setpoint in use"
      },
      {
        "ref": "AI 102",
        "name": "OxxUxxInlet Temp.",
        "why": "Return air temperature"
      },
      {
        "ref": "BI 102",
        "name": "OxxUxxCommunication Status",
        "why": "Unit present on H-Link"
      },
      {
        "ref": "AI 106",
        "name": "OxxUxxUnit Error code",
        "why": "Fault code"
      }
    ],
    "enable": "No enable point is documented. Remote-controller permissions can be removed per unit with the Allow ... from RC_C objects (BO 102-105).",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Default device instance 246; it can be changed in Intesis MAPS.",
      "BACnet IP: default IP 192.168.100.246, DHCP enabled by default; BACnet MS/TP on Port B (B1 -, B2 +, B3 SNGD).",
      "Indoor unit index (xxx) is the unit's index in Intesis MAPS, which is not necessarily its H-Link address.",
      "After any change in MAPS the configuration must be sent to the gateway, which then reboots."
    ],
    "gotchas": [
      "Instance numbers follow the MAPS unit index, so changing a unit's index changes every instance number of that unit.",
      "On/Off, Mode, FanSpeed, Vane and Setpoint at instances 0-2 (BO 0, MO 0-2, AO 0) act on all units at once.",
      "Communication Status (BI 102) shows 0 when the address does not exist on the H-Link bus."
    ]
  },
