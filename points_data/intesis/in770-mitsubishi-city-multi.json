        "why": "Group alarm"
      },
      {
        "ref": "AI 105",
        "name": "CXGX_ErrorCode_S",
        "why": "Fault code (0 = no error)"
      }
    ],
    "enable": "No enable point is documented. The CXGX_Allow_..._Panel_C objects (BO 102-108) block local remote functions per group.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Groups and centralized controllers (up to 2) are set up in Intesis MAPS; send the project after changes.",
      "Fan speed state lists follow the number of fan speeds selected in MAPS."
    ],
    "gotchas": [
      "BI 0 shows loss of communication with the centralized controller; all group data is stale while it is 1.",
      "Global objects (BO 0-1, MO 0-4, AO 0) act on every group of that controller."
    ]
  },
