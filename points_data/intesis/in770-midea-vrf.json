  "integration": {
    "summary": "Connect the Midea bus to the gateway, pick BACnet IP or BACnet MS/TP in Intesis MAPS, configure the units, send the project, then map each indoor unit's _C commands and _S status objects from its (index x 100) block.",
    "minimum_points": [
      {
        "ref": "BO 100",
        "name": "UXX_On/Off_C",
        "why": "Start/stop indoor unit"
      },
      {
        "ref": "MO 100",
        "name": "UXX_Mode_C",
