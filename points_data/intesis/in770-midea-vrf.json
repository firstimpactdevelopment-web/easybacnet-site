        "why": "Setpoint command"
      },
      {
        "ref": "MO 101",
        "name": "UXX_FanSpeed_C",
        "why": "Fan speed command (1 = auto)"
      },
      {
        "ref": "BI 100",
        "name": "UXX_On/Off_S",
        "why": "Run status"
      },
      {
        "ref": "AI 100",
        "name": "UXX_Setpoint_S",
        "why": "Setpoint in use"
      },
      {
        "ref": "AI 101",
        "name": "UXX_Room Temperature",
        "why": "Indoor unit room temperature, °C"
      },
      {
        "ref": "BI 102",
        "name": "UXX_Communication Error IU",
        "why": "Unit offline on the Midea bus"
      },
      {
        "ref": "AI 102",
        "name": "UXX_Unit Error Code",
        "why": "Fault code (0 = no error)"
      }
    ],
    "enable": "No enable point is documented. UXX_Remote control lock_C (BO 102) locks the remote controller of that unit.",
    "heartbeat": null,
    "remote_sensors": null,
    "setup": [
      "Units are indexed in Intesis MAPS; the index (not the Midea address) sets the instance block.",
      "Send the project to the gateway after changes in MAPS."
    ],
    "gotchas": [
      "Global objects (BO 0-3, MO 0-4, AO 0) act on all units at once."
    ]
  },
