  "equipment_type": "VRF BACnet gateway (up to 4, 8, 16 or 64 indoor units)",
  "applies_to": "Samsung air conditioners and heat pumps on the NASA R1/R2 bus, from 4 to 64 indoor units depending on model.",
  "summary": "An Intesis BACnet server on the Samsung NASA R1/R2 bus that serves BACnet IP and BACnet MS/TP. It publishes outdoor-unit communication alarms, gateway-wide commands and one block of objects per indoor unit at (identifier x 100). The manual also defines different object sets for hot-water (HE/HT/EHS), AHU, ERV/ERV+ and chiller unit types; this file shows the standard indoor unit (IU) set.",
  "bacnet_transport": [
    "BACnet IP",
    "BACnet MS/TP"
  ],
  "firmware": null,
  "default_device_instance": 246,
  "access_inferred": false,
  "notes": [
    "Indoor unit instance = (xxx x 100) + offset, xxx = indoor unit identifier 1-64 (identifier 1 shown, 100-108).",
    "Outdoor communication-error objects are BI 0-15 for outdoor addresses 00-15; BI 16 flags an addressing problem.",
    "Hot-water, AHU, ERV, ERV+ and chiller units reuse the same instance block with a different object set (see manual).",
    "WindFree, Air Clean and 360 CST Air Flow objects apply only to indoor units that support them.",
    "Communication Status (MI) states combine NASA flags such as RDY, EXST and DTUP."
  ],
  "source": {
    "title": "Intesis BACnet Server - Samsung NASA AC User's Manual",
    "doc_number": null,
    "revision_date": "01/2022 r1.3",
    "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inbacsamxxxo000.pdf"
  },
  "integration": {
    "summary": "Connect the NASA R1/R2 bus to Port A (A3 R1/+, A4 R2/-), scan the bus in Intesis MAPS, assign each unit an identifier and send the project; then map each indoor unit's objects from its (identifier x 100) block. Gateway-wide objects at low instances command all units.",
    "minimum_points": [
      {
        "ref": "BO 100",
        "name": "OxxUxx_On/Off_C",
        "why": "Start/stop indoor unit"
      },
      {
        "ref": "MO 100",
        "name": "OxxUxx_Mode IU/AHU_C",
        "why": "Mode command"
      },
