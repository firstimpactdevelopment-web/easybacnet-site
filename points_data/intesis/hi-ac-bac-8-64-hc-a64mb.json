  "model": "IntesisBox HI-AC-BAC-8 / HI-AC-BAC-64 (Hitachi HC-A8MB / HC-A64MB adaptor)",
  "model_slug": "hi-ac-bac-8-64-hc-a64mb",
  "aliases": [
