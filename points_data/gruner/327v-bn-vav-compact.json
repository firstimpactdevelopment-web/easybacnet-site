      },
      {
        "ref": "MI 104",
        "name": "StatusActuator",
        "why": "Actuator fault status"
      }
    ],
    "enable": "Set MV 122 SpSource to 2 (Bus); with 1 (Analog) the actuator follows the 0/2-10 V wire and AO 0 is out of service.",
    "heartbeat": "AV 109 BusFailWatchdog (default 120 s, 0 = off). Every write to AO 0 or MO 1 restarts it; if it expires MI 109 shows Bus Watchdog triggered and the relinquish default applies. It also runs from power-up until the first write.",
    "remote_sensors": null,
    "setup": [
      "BACnet MS/TP master; device instance 0-4194302, default 1.",
      "Up to 6 COV subscriptions."
    ],
    "gotchas": [
      "MO 1 Override beats the bus setpoint until set back to 1 (None).",
      "MV 2 commands (adaption, test, reset) return to None by themselves."
    ]
